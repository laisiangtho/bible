      "name": "What is Luke about?",
      "alternateName": [
        "Luke summary",
        "overview of Luke",
        "introduction to Luke"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An orderly account of the life of Jesus for Theophilus, with particular care for the poor, women, outsiders and the work of the Holy Spirit, including parables found only here."
      },
