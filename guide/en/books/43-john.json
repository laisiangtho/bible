      "@type": "Question",
      "name": "What is John about?",
      "alternateName": [
        "John summary",
        "overview of John",
        "introduction to John"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Gospel written \"so that you may believe that Jesus is the Christ, the Son of God\": seven signs, the \"I am\" sayings, long conversations, and the account of Jesus' death and resurrection."
