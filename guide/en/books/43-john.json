      "alternateName": [
        "author of John",
        "John author"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Early tradition names John the apostle, \"the disciple whom Jesus loved\"; the book itself names that disciple as its witness."
      },
