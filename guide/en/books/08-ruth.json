      "@type": "Question",
      "name": "What is Ruth about?",
      "alternateName": [
        "Ruth summary",
        "overview of Ruth",
        "introduction to Ruth"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A Moabite widow, Ruth, stays loyal to her mother-in-law Naomi, comes to Bethlehem and is redeemed by Boaz; she becomes the great-grandmother of King David."
      },
      "potentialAction": {
        "@type": "Action",
        "target": "laisiangtho:passage/8/1"
      }
    },
    {
      "@type": "Question",
      "name": "Who wrote Ruth?",
      "alternateName": [
        "author of Ruth",
        "Ruth author"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The author is not named; Jewish tradition names Samuel."
      },
      "potentialAction": {
        "@type": "Action",
        "target": "laisiangtho:passage/8/1"
      }
    },
    {
      "@type": "Question",
      "name": "When was Ruth written?",
      "alternateName": [
        "date of Ruth",
        "Ruth date"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Set in the time of the judges; scholars date its writing variously, from the monarchy to after the exile."
      },
