      "name": "What is Matthew about?",
      "alternateName": [
        "Matthew summary",
        "overview of Matthew",
        "introduction to Matthew"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Gospel that presents Jesus as the promised Messiah and son of David, fulfilling the Scriptures, with five great blocks of teaching including the Sermon on the Mount."
