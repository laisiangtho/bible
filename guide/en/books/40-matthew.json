      "name": "Who wrote Matthew?",
      "alternateName": [
        "author of Matthew",
        "Matthew author"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The early church attributed it to Matthew, a tax collector and one of the twelve apostles; the book itself does not name its author."
      },
