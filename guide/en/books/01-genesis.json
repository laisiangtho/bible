  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Genesis about?",
      "alternateName": [
        "Genesis summary",
        "overview of Genesis",
        "introduction to Genesis"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The book of beginnings: the creation of the world, the first people and their fall, the flood, and the story of Abraham, Isaac, Jacob and Joseph, through whom God begins to form a people."
      },
      "potentialAction": {
        "@type": "Action",
        "target": "laisiangtho:passage/1/1"
      }
    },
    {
      "@type": "Question",
      "name": "Who wrote Genesis?",
      "alternateName": [
        "author of Genesis",
        "Genesis author"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Jewish and Christian tradition attributes it to Moses. Many scholars see it as drawing together older sources over a long period."
      },
      "potentialAction": {
        "@type": "Action",
        "target": "laisiangtho:passage/1/1"
      }
    },
    {
      "@type": "Question",
      "name": "When was Genesis written?",
      "alternateName": [
        "date of Genesis",
        "Genesis date"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tradition places it in the time of Moses (around the 15th–13th century BC); many scholars date its final form to the 6th–5th century BC."
      },
      "potentialAction": {
        "@type": "Action",
        "target": "laisiangtho:passage/1/1"
      }
    },
    {
      "@type": "Question",
      "name": "What are the main themes of Genesis?",
      "alternateName": [
        "Genesis themes",
        "what does Genesis teach"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Main themes: creation, sin and its spread, covenant, God's promises to Abraham, providence."
      },
      "potentialAction": {
        "@type": "Action",
        "target": "laisiangtho:passage/1/1"
      }
    },
    {
      "@type": "Question",
      "name": "What are key passages in Genesis?",
      "alternateName": [
        "famous verses in Genesis",
        "Genesis key verses"
      ],
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Among the best known: Genesis 1:1; Genesis 3:15; Genesis 12:1–3; Genesis 50:20."
      },
