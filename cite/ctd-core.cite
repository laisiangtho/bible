donsak = (i:1) (t:v) (f:social) (w:raise funds/collect donations/take up a collection) (d:with <sum>, money, or <huhna>, help: have people contribute, collect gifts of money for someone in need; {ki donsak} is be collected) (r:zd:15123/zd:12980) (q:draft)
