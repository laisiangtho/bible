Zongeina = (i:1) (t:n) (f:social) (w:Zo culture/Zomi custom/Zomi tradition) (d:the customs and traditional culture of the Zo people, {Zo} with <ngeina>, custom) (b:ngeina) (r:zd:20999/ts:3508/zd:25628) (q:draft)
zongh = (i:1) (t:adv) (f:everyday) (j:zong) (r:zd:22429/zd:21817/zd:11456) (q:draft)
