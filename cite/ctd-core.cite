suahtaakna = (i:1) (t:n) (f:politics) (j:suahtakna) (r:zd:25712/zd:23488/zd:25678) (q:draft)
suahtak = (i:2) (t:n) (f:politics) (w:independence/freedom) (d:the freedom of a country from foreign rule, used as a noun without the suffix {-na} in {suahtak ni}, Independence Day, and {suahtak ngah}, gain independence) (s:suahtakna) (r:zd:17106/zd:19208) (q:draft)
suahtakna ngah = (i:1) (t:v) (f:politics) (w:gain independence/become free/be released) (d:<suahtakna>, freedom, and <ngah>, get: of a country, gain independence from a ruling power, and of a person, be set free; {suahtakna ngah khit ciang} is after independence) (r:zd:17106/zd:24743/zd:23792) (q:draft)
suahtakpih = (i:1) (t:v) (f:everyday/social) (w:rescue/bring to safety/escape with) (d:<suahtak>, escape, with <pih>, together with: get away taking someone along, set someone free) (j:suahtak/pih) (r:zd:20083/zd:16457) (q:draft)
suahtatak = (i:1) (t:adv) (f:everyday/politics) (j:suaktatak) (r:zd:22683/zd:21327) (q:draft)
suahzawh = (i:2) (t:v) (f:everyday) (w:manage to become/be able to become) (d:<suah> become with <zawh> be able, usually before <nading> or <sawm>: succeed in becoming something, where the other sense counts time since a birth or a becoming) (r:zd:16728/zd:12904) (q:draft)
suai = (i:1) (t:v) (f:media/education) (w:draw/paint/depict) (d:make a picture; {lim suai} is draw or paint a picture) (r:zd:17466/zd:23113) (q:draft)
suai = (i:2) (t:n) (f:politics/work) (w:signature) (d:a signature, said with <kai>, draw: {suai kai} is sign one's name, and {thukimna suai kai} is sign an agreement) (r:ts:12274/zd:17760/zd:21421) (q:draft)
suaih = (i:1) (t:v) (f:education/media) (w:draw/paint/sketch) (d:draw or paint a picture, {lim suaih}; said also of drawing up a budget; also written <suai>) (r:zd:17466/zd:16078/zd:22747) (q:draft)
suaihsak = (i:1) (t:v) (f:education/media) (w:draw for/have drawn/paint for) (d:<suaih>, draw, with <sak>: draw or paint something for someone, or have something drawn, as a plan, a picture or a tattoo) (j:suaih/sak) (r:zd:24649/zd:20317) (q:draft)
suaihsiam = (i:1) (t:adj) (f:media/work) (w:skilled at drawing/good at drawing) (d:<suaih>, draw, and <siam>, skilled, written as one word: good at drawing or painting pictures, and at drawing tattoos) (j:suaih/siam) (r:zd:22116/zd:12980) (q:draft)
suaikai = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature) (d:write one's name on a document or an agreement to approve it; {thukimna suaikai} is sign an agreement) (r:ts:3375/zd:21659/zd:11463) (q:draft)
suaikaih = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature to) (d:<suai>, signature, with <kaih>, draw: sign a document or agreement; the form used before <na> and <lai>, and <suaikaihna> is the signing) (r:ts:12498/zd:17722) (q:draft)
suaikaihna = (i:1) (t:n) (f:politics/work) (w:signing/signature) (d:<suaikaih>, sign, with the noun suffix {-na}: the signing of an agreement, {suaikaihna nei} is hold a signing; also the signature itself) (b:suaikaih) (r:zd:25392/ts:5888/zd:16114) (q:draft)
suaikailo = (i:1) (t:v) (f:politics) (w:not sign/non-signatory) (d:<suaikai>, sign, and <lo>, not, written as one word: not signing; before a noun or <teng>, those who have not signed an agreement) (j:suaikai/lo) (r:zd:24535/zd:14924) (q:draft)
suaikhi = (i:1) (t:n) (f:home) (w:necklace/gold necklace/neck chain) (d:a chain worn round the neck as jewellery, usually of gold; named with <bilbah>, earrings) (s:khamkhi) (r:zd:21121/zd:14941) (q:draft)
suaina = (i:1) (t:n) (f:health/social) (w:addiction/habit) (d:being hooked on something, noun in {-na} from {zu suai}, be addicted to drink; not the sense draw of <suai>) (r:zd:17784/zd:11571) (q:draft, low confidence)
suaisai = (i:1) (t:n) (f:work/everyday) (w:gold shop/jewellery shop/goldsmith's shop) (d:a shop that sells gold and jewellery) (o:Burmese, shwe hsaing) (r:zd:12063/zd:19872) (q:draft)
suaisak = (i:1) (t:v) (f:media/education) (w:have drawn/draw for/have someone draw) (d:<suai>, draw or sign, with <sak>: have a picture drawn or get someone to draw; {lim suaisak} is have a portrait drawn) (j:suai/sak) (r:zd:23201) (q:draft, low confidence)
suaisuai = (i:1) (t:v) (f:media/education) (w:keep painting/draw at length) (d:doubled <suai.1>: paint or draw on and on; after verbs of going and speaking the same form is an adverb whose exact sense is not determined here) (b:suai) (r:zd:15653) (q:draft, low confidence)
suaitawn = (i:1) (t:n) (f:work) (w:gold bar/gold bullion) (d:gold in bars, as stolen by robbers or sold by dealers) (o:Burmese) (r:zd:15419) (q:draft)
suaizuakna = (i:1) (t:n) (f:work) (w:goldsmith shop/jewellery shop) (d:a shop that sells gold and jewellery; the first part is a Burmese loan for gold, joined with <zuakna>, selling) (o:Burmese) (r:zd:12063/zd:19738) (q:draft)
suak = (i:3) (t:v) (f:everyday/family) (w:be born/come out/rise) (d:come out or come forth: of a person, be born in a place, as in {Kawlgam suak}, born in Burma; of the sun or a thought, rise or come up; nothing is named that the subject turns into) (s:piang) (r:zd:24536/zd:24978/zd:25170) (q:draft)
suaka = (i:1) (t:v) (f:everyday/family) (w:be born/become) (d:<suak>, be born or come to be, and the linking <a>, written as one word: was born and, became and; the sentence then goes on) (j:suak/a) (r:zd:9256/zd:22807) (q:draft)
suakbaih = (i:1) (t:v) (f:everyday) (w:become easily/become quickly) (d:<suak>, become, and <baih>, easily or soon, written as one word: easily turn into what is named before it) (j:suak/baih) (r:zd:25516/zd:23653) (q:draft)
suakcil = (i:1) (t:adj) (f:family/health) (w:newborn/just born) (d:<suak>, here be born, with <cil>, at the beginning: just born; {naungek suakcil} is a newborn baby) (r:zd:12014/zd:15984) (q:draft)
suakcilkhat = (i:1) (t:phrase) (f:family/health) (w:a newborn) (d:<suakcil>, newborn, with <khat>, one, written as one word, after <naungek>: a newborn baby) (j:suakcil/khat) (r:zd:16767/zd:14822) (q:draft)
suakden = (i:1) (t:v) (f:everyday/media) (w:keep coming out/keep being born/keep appearing) (d:<suak> and <den> written as one word: come out, appear or be born continually) (j:suak/den) (r:zd:22396/zd:19734) (q:draft)
suakding = (i:1) (t:v) (f:everyday) (w:will become/will turn into/will come out) (d:<suak>, become or come forth, and <ding>, will, written as one word) (j:suak/ding) (r:zd:11373/zd:24570) (q:draft)
suakding = (i:2) (t:v) (f:everyday) (w:will go on/will continue) (d:<suak>, placed after a verb for an action that carries on or is done for good, and <ding>, will, written as one word: {kinei suakding} is will go on being held, {khakcip suakding} is will be closed for good) (j:suak/ding) (r:zd:17549) (q:draft)
suakhi = (i:1) (t:v) (f:everyday) (w:become/turn into) (d:<suak>, become, and the sentence ending <hi> written as one word: became, has become) (j:suak/hi) (r:zd:23797/zd:23356) (q:draft)
suakhi = (i:2) (t:v) (f:family/everyday) (w:be born) (d:<suak>, be born, and the sentence ending <hi> written as one word: was born) (j:suak/hi) (r:zd:20484/zd:22873) (q:draft)
suakin = (i:3) (t:v) (f:family/everyday) (w:being born) (d:<suak> in its meaning be born, with the linking ending <in>: born, and then; brought out by a place with <ah> or a year before it, as in {khua ah suakin}, born in the village) (r:zd:22544/ts:296/zd:13228) (q:draft)
suakkhawm = (i:2) (t:v) (f:everyday) (w:come out together/emerge together/appear together) (d:<suak>, come out or be born, with <khawm>, together: come out, be born or appear at the same place and time as another; with <sak>, make appear together; not {suakkhawm}, become one) (r:zd:24327/zd:20695) (q:draft, low confidence)
suakkhiathei = (i:1) (t:v) (f:everyday/health) (w:can be born/be able to come out) (d:<suakkhia>, come out or be born, and <thei>, able, written as one word: of a child, be born safely; also be able to come forth) (j:suakkhia/thei) (r:zd:12128/zd:17899) (q:draft)
suakkhiavat = (i:1) (t:v) (f:everyday) (w:come out suddenly/appear suddenly/dart out) (d:<suakkhia>, come out, with <vat>, here suddenly, written as one word: come out or appear all at once and unexpectedly) (j:suakkhia/vat) (r:zd:20076/zd:21030/zd:15890) (q:draft)
suakkhinta = (i:1) (t:v) (f:everyday) (w:have become/have already become) (d:<suak>, become, and <khinta>, already done, written as one word: have now become what is named before it; in one sentence, of a person, was already born) (j:suak/khinta) (r:zd:12470/zd:15679) (q:draft)
suakkik = (i:2) (t:v) (f:everyday/nature) (w:come out again/reappear/appear again) (d:<suak>, come out or appear, with <kik>, again: come out or show oneself again, as the sun after cloud; not becoming again what one was) (r:zd:19242) (q:draft)
suaklai = (i:1) (t:v) (f:everyday) (w:still become/still be) (d:<suak>, become or come out, with the word for still, written as one word: is still becoming, even turns into) (j:suak/lai) (r:zd:24749/zd:17872) (q:draft, low confidence)
suaklo = (i:1) (t:v) (f:everyday) (w:not become/not turn out/not appear) (d:<suak> and <lo> written as one word: not become something; also not come out or not show) (j:suak/lo) (r:zd:17577/zd:19997/zd:12794) (q:draft)
suaklu = (i:1) (t:n) (c:plant) (f:food/nature) (w:gooseberry/Indian gooseberry) (d:a sour fruit and its tree; the dictionary data gives gooseberry, and the thought of it is said to make the mouth water) (r:zd:21922) (q:draft, low confidence)
suaklua = (i:2) (t:v) (f:everyday/social) (w:flare up/be furious/well up) (d:of anger or a thought, rise too strongly; after <aheh> it means be furious, mostly followed by <mahmah>) (r:zd:14908/zd:24411) (q:draft)
suakmahmah = (i:1) (t:v) (f:everyday) (w:become very/get very) (d:<suak>, become, and <mahmah>, very, written as one word; in the news mostly {aheh suakmahmah}, became very angry) (j:suak/mahmah) (r:zd:19790/zd:14883) (q:draft)
suakmang = (i:1) (t:v) (f:everyday) (w:turn completely into/be reduced to) (d:<suak>, become, and <mang>, away for good, written as one word: turn wholly into something so that the former thing is gone, as in {vutlehvai suakmang}, be reduced to ashes) (j:suak/mang) (r:zd:11409/zd:25573) (q:draft)
suakna = (i:2) (t:n) (f:everyday) (w:becoming/turning into) (d:<suak>, become, with the noun suffix {-na}: the becoming of what the word before names, as {mihing suakna}, becoming human; with <ding> it gives the aim, so as to become, and with <hang> the cause) (b:suak) (r:zd:21739/zd:22650) (q:draft)
suakpah = (i:2) (t:adv) (f:everyday) (w:straight away/right then/directly) (d:after another verb, as in {kiman suakpah} and {kipuak suakpah}: the action follows at once and goes right through, with no step between; <suak> in its use after a verb, with <pah>, at once) (r:zd:15943/zd:17999/zd:16676) (q:draft)
suakphei = (i:1) (t:v) (f:travel/everyday) (w:come out across/come out onto) (d:<suak> and <phei> written as one word: come out and across to a place, emerge at it) (j:suak/phei) (r:zd:22981) (q:draft, low confidence)
suaksak = (i:2) (t:v) (f:media) (w:publish/put out/release/issue) (d:<suak>, come out, with the causative <sak>: make something come out to the public, as news in a paper, a post on social media or a new song; not make become) (r:zd:16438/zd:18198) (q:draft)
suaksaksawn = (i:1) (t:v) (f:media) (w:republish/pass on/share) (d:<suaksak.2>, publish, and <sawn.1>, onward, written as one word: publish again or pass on to readers what another has written or reported) (j:suaksak/sawn) (r:zd:17279/zd:15693) (q:draft)
suaksuakding = (i:1) (t:v) (f:everyday) (w:will go on and on/should be continued) (d:<suak>, on or through, doubled and written as one word with <ding>, will, placed after a verb: the action will or should carry on without a break) (j:suak/suakding) (r:zd:17432/zd:23878) (q:draft)
suakta takin = (i:1) (t:adv) (f:social/politics) (w:freely/in freedom/at liberty) (d:<suakta>, be free, and <takin>, which makes an adverb: placed before a verb, do it freely, without restraint) (r:zd:23148/zd:22695/zd:21706) (q:draft)
suaktaakna = (i:1) (t:n) (f:politics/social) (j:suaktakna) (r:zd:25569/zd:23488) (q:draft)
suaktading = (i:1) (t:v) (f:politics/everyday) (w:will be released/will be freed) (d:<suakta>, be set free, and <ding> written as one word: will be released, as from prison) (j:suakta/ding) (r:zd:19674/zd:19671) (q:draft)
suaktagam = (i:1) (t:n) (f:politics) (w:independent country/free state) (d:<suakta>, be free, and <gam>, country, written as one word: a country that rules itself) (j:suakta/gam) (r:zd:22540) (q:draft)
suaktakna = (i:1) (t:n) (f:politics/social) (w:freedom/liberty/independence) (d:<suaktak>, be free, with the noun suffix <na>: freedom of a person, or the independence of a country) (s:suahtakna) (b:suaktak) (r:ts:3168/zd:22877) (q:draft)
suaktalo = (i:1) (t:v) (f:politics/everyday) (w:not be released/not get free) (d:<suakta>, be set free, and <lo>, not, written as one word: not be released, not get out) (j:suakta/lo) (r:zd:20418) (q:draft)
suaktatak = (i:1) (t:adv) (f:everyday/politics) (w:freely/at liberty) (d:<suakta>, be free, with <tak>, written as one word: freely, without hindrance; often {suaktatak in}) (j:suakta/tak) (r:zd:17383/zd:11712/ts:2189) (q:draft)
suaktathei = (i:1) (t:v) (f:everyday) (w:manage to escape/get away safely/survive) (d:<suakta> and <thei> written as one word: be able to get away, come out of an accident or attack alive or unhurt) (j:suakta/thei) (r:zd:20663/zd:13138) (q:draft)
suakte = (i:3) (t:n) (f:social/politics) (w:those who become/those who became) (d:<suak> in its meaning become, with the plural <te>: after a word for an office or rank, the people who have become that, as {MP suakte}; not those who are born) (r:zd:24731/zd:16012) (q:draft)
suakthak = (i:1) (t:adj) (f:everyday/family) (w:newborn/newly arisen/new) (d:<suak>, be born or become, with <thak> new: newly born, as {naungek suakthak}, a newborn baby, or newly come into being) (j:suak/thak) (r:zd:19734/zd:25616) (q:draft)
suakto = (i:2) (t:v) (f:everyday/social) (w:grow into/rise to become/become) (d:<suak>, become, with <to>, upward: become something greater step by step, after the words that name what one becomes; not the rising of smoke) (r:zd:22868/zd:19662/zd:11403) (q:draft)
suaktung = (i:1) (t:adj) (f:family) (w:newborn/newly born) (d:<suak>, be born, with <tung> in the sense just now, written as one word and placed after a word for a baby or child: just born) (b:suak) (r:zd:18937/zd:21616) (q:draft)
suakve = (i:1) (t:v) (f:everyday) (w:become/turn out) (d:<suak>, become, and the stressing final <ve> written as one word at the end of a sentence: it does become, it turns out so) (j:suak/ve) (r:zd:21054) (q:draft, low confidence)
suakzaw = (i:1) (t:v) (f:everyday) (w:become rather/turn out more) (d:<suak>, become, and <zaw>, more or rather, written as one word: turn out to be that rather than the other) (j:suak/zaw) (r:zd:23767) (q:draft, low confidence)
suakziau = (i:1) (t:v) (f:everyday) (w:become at once/turn into/end up as) (d:<suak>, become, and <ziau> written as one word: come to be something suddenly or simply as a result) (j:suak/ziau) (r:zd:15727/zd:22830) (q:draft)
suakzolo = (i:1) (t:v) (f:everyday) (w:cannot become/fail to become/cannot come out) (d:<suak>, become or come out, with <zolo>, cannot, written as one word: not manage to become something, or of a voice, not come out properly) (j:suak/zolo) (r:zd:18248/zd:15260) (q:draft)
sual = (i:1) (t:n) (f:home) (w:floor) (d:the floor of a house or room; {sual puan} is a rug spread on the floor) (a:innsun) (r:26.41.16) (q:draft)
suallo = (i:1) (t:adv) (f:everyday) (w:without fail/surely/exactly) (d:used as {suallo in}: without missing, unfailingly, just as expected) (r:zd:25390/zd:19239) (q:draft, low confidence)
sualtung = (i:1) (t:n) (f:home) (w:floor/surface of the floor) (d:<sual> and <tung> written as one word; {sualtung ah} is on the floor) (j:sual/tung) (r:zd:18020/zd:12723) (q:draft)
sualtungah = (i:1) (t:adv) (f:home) (w:on the floor/on the ground) (d:<sualtung> and the place marker <ah> written as one word: on the floor, also on the ground or the road surface) (j:sualtung/ah) (r:zd:11698/zd:17143) (q:draft)
suamlup = (i:1) (t:v) (f:politics/media) (w:assassinate/attack and kill/murder) (d:form of <suamlum>, attack and kill, used before words such as <laitak>, <pen> and <khak>; {aki suamlup} is the one who was assassinated, {ki suamlupna} the assassination) (b:suamlum) (r:zd:19324/zd:15498) (q:draft)
suamlupding = (i:1) (t:v) (f:politics/media) (w:will assassinate/to be assassinated) (d:<suamlup>, attack and kill, with <ding>, will, written as one word; {aki suamlupding} is that he or she will be assassinated) (j:suamlup/ding) (r:zd:11378) (q:draft)
suamlupkhit = (i:1) (t:v) (f:politics/media) (w:after being assassinated/have assassinated) (d:<suamlup> and <khit> written as one word: once the attack and killing was done; after <ki> it is passive, after he was assassinated) (j:suamlup/khit) (r:zd:11627) (q:draft)
suamlupna = (i:1) (t:n) (f:politics/media) (w:assassination/murder/killing) (d:<suamlup>, the form of <suamlum>, attack and kill, used before an ending, with the noun suffix <na>: the killing of a person by an attack, an assassination) (b:suamlum) (r:zd:11433/zd:12171) (q:draft)
suamlupsawm = (i:1) (t:v) (f:politics) (w:try to kill/attempt to assassinate) (d:<suamlup>, the form of <suamlum>, attack and kill, used before <sawm>, intend: try to kill; with <ki> before it, be the target of an attempt on one's life, or try to kill oneself) (b:suamlum) (r:zd:20653/zd:11821) (q:draft)
suamna = (i:1) (t:n) (f:politics/social) (w:attack/assault/raid) (d:<suam>, attack, with the noun suffix {-na}: an armed attack on people or a place; a dictionary also gives robbery) (b:suam) (r:zd:10798/zd:10727) (q:draft)
suamsak = (i:1) (t:v) (f:politics) (w:attack/raid/break into) (d:<suam>, attack, with <sak>: make an attack on what belongs to someone, as a post or a computer system) (j:suam/sak) (r:zd:10740) (q:draft, low confidence)
suanding = (i:1) (t:v) (f:nature/work) (w:will plant/to plant) (d:<suan>, plant, and <ding> written as one word: to plant, to be planted) (j:suan/ding) (r:zd:11909/zd:14652) (q:draft)
suang = (i:3) (t:n) (f:nature/everyday) (w:stone/rock) (d:a stone or rock, the material and a single piece of it; {suang manpha} is a precious stone, {suang tawh deng} is throw stones at, and {suang tunga kilam} is built on rock) (s:suangtum) (r:zd:21551/zd:11508/zd:15847) (q:draft)
suang = (i:4) (t:v) (f:social) (w:rely on/depend on/trust in) (d:lean on something as one’s strength or support, after the thing relied on; {thatang suang} is relying on force, by force) (r:zd:11714) (q:draft, low confidence)
suangbawl = (i:1) (t:n) (f:work) (w:gem trade/gem trader) (d:<suang>, stone, with <bawl>, make: dealing in gems or jade, said beside <sumbawl>, trade; also a person who does so) (r:zd:14604/zd:22396) (q:draft, low confidence)
suangbul = (i:1) (t:n) (f:nature/religion) (w:foot of a rock/rock base) (d:<suang>, rock, with <bul>, base; mostly in the pair {singbul suangbul}, tree stumps and rocks, the things once feared and worshipped as the seat of spirits) (j:suang/bul) (r:ts:3375/zd:9435) (q:draft)
Suangdawh = (i:1) (t:name) (c:khua) (f:travel) (w:Suangdawh) (d:a village of the <Sihzang> area in Chin State) (r:ts:3372) (q:draft)
Suanghoih = (i:1) (t:name) (c:khua) (f:travel) (w:Suanghoih) (d:a village in the Tonzang area of Chin State) (r:zd:19293) (q:draft)
suanglak = (i:1) (t:n) (f:nature) (w:rocky place/among the rocks) (d:the first part of <suangtum>, stone, with <lak>, among: stony ground, a place among rocks, named together with {kenlak}, among cliffs, and <leilak>, on bare earth) (r:zd:23332/zd:17635) (q:draft)
suangmanpha zuakna = (i:1) (t:n) (f:work/everyday) (w:jewellery shop/jeweller's/goldsmith shop) (d:<suangmanpha>, precious stone, and <zuakna>, place of selling: a shop that sells jewellery and gold) (r:zd:16733/zd:17260) (q:draft)
suangmeihol = (i:1) (t:n) (f:nature/work) (w:coal) (d:mineral coal dug from the ground, literally stone charcoal, <meihol>) (r:zd:21605/zd:10990/zd:23016) (q:draft)
suangsi = (i:1) (t:n) (f:work/nature) (w:gravel/crushed stone) (d:small broken stones used with sand and cement in building and for surfacing roads) (r:zd:17000/zd:22479/zd:18121) (q:draft)
suangsite = (i:1) (t:n) (f:nature) (w:small stones/grit/gravel) (d:<suangsi> with the plural <te>: small stones, bits of grit) (b:suangsi) (r:zd:25506) (q:draft)
suangtaat = (i:1) (t:n) (f:home/work) (w:whetstone/grindstone) (d:<suang>, stone, with <taat>, sharpen: a stone for sharpening a knife or blade) (r:zd:24733) (q:draft)
suangtat = (i:1) (t:n) (f:home/work) (w:whetstone/sharpening stone) (d:a stone on which knives and tools are sharpened; in the old saying {suangtat sat ngam}, daring to strike a whetstone, of fearless warriors) (r:ts:4885) (q:draft)
suangtawh = (i:1) (t:phrase) (f:everyday) (w:with stones/with a stone) (d:<suang>, stone, and <tawh>, with, written as one word; {suangtawh deng} is throw stones at, stone) (j:suang/tawh) (r:zd:11936/zd:17517/zd:24224) (q:draft)
suangte = (i:2) (t:n) (f:social) (w:those relied on/supports) (d:<suang>, rely on, with the plural <te>: the people or things that one leans on, as in {ih muang ih suangte}, those we trust and rely on; not stones) (r:zd:20116) (q:draft, low confidence)
suangthem = (i:1) (t:n) (f:nature/everyday) (w:stone fragment/rock debris/rubble) (d:<suang>, stone, with <them>, small piece: bits of broken stone, as thrown out by a volcano or a burst pipe) (r:zd:20023/zd:12772) (q:draft)
Suangthu = (i:1) (t:n) (f:home) (w:hearthstone/trivet stone) (d:one of the three stones set around the fire on which the cooking pot stands; used as a picture of three things that are all needed) (r:zd:24733) (q:draft)
suangzo = (i:1) (t:v) (f:social/everyday) (w:be able to rely on/can depend on) (d:<suang>, rely on, with <zo>, be able, written as one word, after the thing relied on) (j:suang/zo) (r:zd:24320) (q:draft, low confidence)
suanin = (i:4) (t:v) (f:everyday/travel) (w:step/take a step) (d:after <kal> or <kalthak>, a step or a new step: taking a step and then doing the next action, as in {kalthak suanin mainawt}, go forward with new steps) (r:zd:24750/zd:21100) (q:draft)
suanna = (i:3) (t:n) (f:everyday/social) (w:step/taking a step) (d:after <kal>, step: {kal khat suanna} is the taking of one step, also of a step forward in progress; a spaced form of <kalsuanna>, not planting or reliance) (r:zd:21343/zd:17634) (q:draft)
suanpih = (i:1) (t:v) (f:social) (w:step along with/walk with/accompany) (d:{kal suan}, take a step, as in <kalsuan>, with <pih>, together with: take a step with or for someone, usually after <kal>, and so lead or go with them on the way) (r:zd:20018/zd:20587) (q:draft, low confidence)
suansuan = (i:1) (t:v) (f:nature/home) (w:plant/keep planting) (d:<suan>, plant, said twice: go on planting flowers or vegetables) (b:suan) (r:zd:17081) (q:draft, low confidence)
suantaakpi = (i:1) (t:n) (f:social/family) (w:mainstay/something to rely on) (d:what a person can truly count on or build on, apparently {suantaak}, worth relying on, with the ending {-pi}, great; said together with <belhtaak>) (r:zd:17025/zd:17271) (q:draft, low confidence)
suanto = (i:1) (t:v) (f:everyday/social) (w:step forward/advance/move on) (d:move something onward, said with <kal>, step: {kalkhat suanto} is take one step forward; dictionaries also give defer, carry over) (r:zd:20971/zd:23223) (q:draft)
Subang = (i:1) (t:name) (c:city) (f:travel) (w:Subang/Subang Jaya) (d:Subang and Subang Jaya, a town in Selangor, Malaysia, near Kuala Lumpur; one sentence names another Subang in West Java, Indonesia) (r:zd:16235/zd:16660) (q:draft)
subject = (i:1) (t:n) (f:education) (w:subject) (d:a branch of study taught at school or university; in letters also the English heading Subject before the matter of the letter) (o:English) (r:zd:20979/zd:11748/zd:23016) (q:draft)
submarine = (i:1) (t:n) (f:politics/travel) (w:submarine) (d:a warship that travels under water, in Zolai also described as {tuinuai teembaw}) (o:English) (r:zd:10988) (q:draft, low confidence)
submit = (i:1) (t:v) (f:work/it) (w:submit/hand in) (d:hand in a form, a plan or an application; used with <ki> as {ki submit}, be submitted) (o:English) (r:zd:24091/zd:16851) (q:draft, low confidence)
subtitle = (i:1) (t:n) (f:media/it) (w:subtitle) (d:the written words shown under a film or video, in the language named before it) (o:English) (r:zd:23049/zd:20095) (q:draft)
subuai = (i:1) (t:v) (f:social) (w:disturb/bother/interrupt) (d:<su> with <buai>, be troubled: throw a person or a piece of work into trouble or disorder) (s:nawngkaisak) (r:zd:20016/zd:21874) (q:draft)
Sudan = (i:1) (t:name) (c:land) (f:politics) (w:Sudan) (d:country in north-east Africa; {South Sudan} is its southern neighbour) (r:ts:7140/zd:10855) (q:draft)
Suez = (i:1) (t:name) (c:place) (f:travel/politics) (w:Suez) (d:the Suez Canal in Egypt, and the war of 1956 named after it) (r:zd:25109/zd:11697) (q:draft)
suhkhiat = (i:1) (t:v) (f:politics) (w:seize/take by force/overthrow) (d:<suh>, take by force, with <khiat>, away: take something from its holder by force; {ukna suhkhiat} is seize power, said of a military coup) (r:ts:5339/zd:25063/zd:24966) (q:draft)
suhkhiatsak = (i:1) (t:v) (f:politics) (w:seize from/take away by force) (d:<suhkhiat>, seize, with <sak>: take something away from someone by force, as power from the people or a vehicle from an enemy) (j:suhkhiat/sak) (r:ts:9677/zd:23572) (q:draft)
suhsak = (i:1) (t:v) (f:social) (w:rob/snatch/seize from) (d:<suh>, take by force, and <sak> written as one word: take from a person by force what belongs to him) (j:suh/sak) (r:zd:16676/zd:15084/zd:9136) (q:draft)
suhsawm = (i:1) (t:v) (f:politics/media) (w:try to rob/attempt to snatch) (d:<suh>, take by force, with <sawm>, intend or try, written as one word: try to rob someone of something) (j:suh/sawm) (r:zd:12072/zd:21588) (q:draft)
sui = (i:3) (t:v) (f:media/everyday) (w:kick/play) (d:kick with the foot, and so play football or a match, unlike the senses of cutting and of stumbling: {bawlung sui} is play football and {match sui} is play a match) (r:zd:20145/zd:17963/zd:16556) (q:draft)
Suicide = (i:1) (t:n) (f:health/social) (w:suicide) (d:the killing of oneself; the English word is set beside the Zolai {amah leh amah kithat} and stands in {Suicide Bomb}) (o:English) (r:zd:10940/zd:11654) (q:draft, low confidence)
suigawp = (i:1) (t:v) (f:everyday) (w:kick hard/kick repeatedly) (d:<sui>, kick, and <gawp>, severely, written as one word: kick someone hard or again and again) (j:sui/gawp) (r:zd:12255/zd:15606) (q:draft)
suih = (i:3) (t:v) (f:media/everyday) (w:kick/play football) (d:kick with the foot, mostly of a ball: {bawlung suih} or {bawhlung suih} is playing football, and {suih leh bet} is kicks and blows; not carving or stumbling) (r:zd:24119/zd:20486/zd:22967) (q:draft)
suihna = (i:1) (t:n) (f:media) (w:kicking/playing football) (d:the kicking of a ball, almost always in {bawlung suihna}, the playing of football; the noun of <sui> in its sense strike with the foot) (r:zd:16379/zd:23653) (q:draft)
suikhia = (i:1) (t:v) (f:everyday/social) (w:search out/trace/find out) (d:<sui>, here search or trace, with <khia>, out, written as one word: search until something is found or brought to light) (r:zd:23022/zd:17891) (q:draft, low confidence)
suisaikhat = (i:1) (t:n) (f:work/everyday) (w:a gold shop/a jeweller's shop) (d:<sui>, here gold, a loan from Burmese and not the verb kick, with <saikhat>, a shop, written as one word: a gold shop) (o:Burmese) (r:zd:13230) (q:draft, low confidence)
suisui = (i:1) (t:v) (f:work/everyday) (w:keep hewing/keep shaping/carve on and on) (d:<sui>, hew or chisel, said twice: go on shaping something as wood is carved, used of forming a person or a life) (b:sui) (r:zd:22116) (q:draft, low confidence)
suit = (i:1) (t:n) (f:everyday) (w:suit) (d:a set of clothes of jacket and trousers) (o:English) (r:zd:25572/zd:16236) (q:draft)
Suitcase = (i:1) (t:n) (f:travel/home) (w:suitcase) (d:a case with a handle for carrying clothes and goods on a journey) (o:English) (r:zd:15095/zd:15554) (q:draft)
suite = (i:2) (t:n) (f:media) (w:players/footballers) (d:<sui.3>, kick or play, with the plural <te>: those who play football, after <bawllung>, <bawlung> or <bawhlung>, not those who cut) (r:zd:20906/zd:25157) (q:draft)
sukhaloding = (i:1) (t:v) (f:everyday/politics) (w:will not affect/will not harm) (d:<sukha>, touch or affect, and <loding>, will not, written as one word: will not affect) (j:sukha/loding) (r:zd:23569) (q:draft)
sukham = (i:2) (t:v) (f:politics/media) (w:detonate/set off/explode) (d:after the word <bomb>: make a bomb go off; {bomb ki sukham} is a bomb was set off) (r:zd:19851/zd:12759) (q:draft)
sukhamding = (i:1) (t:v) (f:politics/media) (w:will detonate/to set off) (d:<sukham> and <ding> written as one word: going to set off a bomb, in order to detonate) (j:sukham/ding) (r:zd:16130) (q:draft)
sukhampa = (i:1) (t:n) (f:politics/media) (w:bomber) (d:<sukham.2>, set off a bomb, with <pa>, the man who, written as one word: the man who set off the bomb) (j:sukham/pa) (r:zd:12639) (q:draft)
sukhamte = (i:1) (t:n) (f:politics/media) (w:detonations/bombings) (d:<sukham>, detonate, and the plural <te> written as one word, mostly after {Bomb aki}: the bombs that were set off, the bombings) (j:sukham/te) (r:zd:19644) (q:draft)
sukkhakna = (i:2) (t:n) (f:everyday/media) (w:effect/impact/harm/disruption) (d:the harm or disturbance that an event causes to a service, a place or a right; mostly in {bangmah sukkhakna omlo} or {bangmah sukkhakna neilo}, not affected at all; not a bodily touch or blow) (r:zd:12990/zd:17472/zd:19373) (q:draft)
sukkhapna = (i:2) (t:n) (f:politics/media) (w:bombing/bomb attack/blast) (d:in the news, after <bomb>: an attack in which a bomb is set off among people, named beside <kikapna>, shooting; not the battering of a wall) (r:zd:12608/zd:12656) (q:draft)
sukpah = (i:1) (t:adv) (f:everyday/it) (w:down at once/straight down) (d:<suk>, down, and <pah>, at once, written as one word after a verb: do it downward or below right away, as of comments written under a post) (j:suk/pah) (r:zd:12470) (q:draft, low confidence)
suksia = (i:1) (t:v) (f:everyday) (w:do harm/be badly affected/get worse) (d:harm or be harmed badly, grow worse; {a suksia pen} is the one worst affected; compare <susia>, destroy) (r:zd:24469/zd:24271/zd:19662) (q:draft, low confidence)
suksiatding = (i:1) (t:v) (f:politics/everyday) (w:to destroy/to ruin) (d:<suksiat>, destroy, and <ding> written as one word: to destroy, the destroying of something) (j:suksiat/ding) (r:zd:21918/zd:11199) (q:draft)
suksuak = (i:1) (t:adv) (f:everyday) (w:right down/straight away/completely) (d:<suk>, down, and <suak>, right through, written as one word after a verb: the action goes all the way down or follows at once and stays so, as in {ihmu suksuak}, fall straight asleep) (j:suk/suak) (r:zd:10893/zd:14676) (q:draft, low confidence)
suksuk = (i:2) (t:adv) (f:everyday) (w:steadily downward/further and further down/on and on) (d:after a verb, not of generations: going on downward in place or in amount, as in {kiam suksuk} keep decreasing, {kia suksuk} keep falling and {pai suksuk} walk on down) (r:zd:21042/zd:22815/zd:16148) (q:draft)
sukteng = (i:1) (t:adv) (f:body/everyday) (w:all the way down/all down) (d:<suk>, downward, and <teng>, all, written as one word after a noun: the whole of it going down, as {anungzang sukteng}, all down the back) (j:suk/teng) (r:zd:15521/zd:12598) (q:draft, low confidence)
sukziau = (i:1) (t:adv) (f:everyday) (w:straight off/abruptly/just like that) (d:<suk> and <ziau> written as one word after a verb: the action is done at once and without more ado, often to the surprise of others) (j:suk/ziau) (r:zd:20177/zd:15639) (q:draft, low confidence)
Sulawesi = (i:1) (t:name) (c:land) (f:travel) (w:Sulawesi) (d:large island of Indonesia, east of Borneo) (r:zd:20170) (q:draft)
Sule = (i:1) (t:name) (c:place) (f:travel) (w:Sule) (d:the area in the centre of Yangon around the Sule Pagoda) (r:zd:14852) (q:draft, low confidence)
sulnung = (i:1) (t:n) (f:everyday/social) (w:track/trail/footsteps/trace) (d:<sul>, track, with <nung>, behind: the marks or way left behind by someone who has gone; {sulnung zui} is follow in the footsteps of) (r:zd:9427/zd:10681/zd:25927) (q:draft)
Sulu = (i:1) (t:name) (c:place) (f:travel/politics) (w:Sulu) (d:an island group and province in the south of the Philippines) (r:zd:11600/zd:11562) (q:draft)
sulzuihpah = (i:1) (t:v) (f:everyday/politics) (w:follow at once/pursue at once) (d:<sulzuih> and <pah> written as one word: follow after someone at once, of police after a suspect or robbers after a victim) (j:sulzuih/pah) (r:zd:13082/zd:21581) (q:draft)
sulzuihzuih = (i:1) (t:v) (f:everyday/travel) (w:keep following/trail) (d:<sulzuih>, follow after, with <zuih> said twice for an action that goes on: keep following behind) (j:sulzuih/zuih) (r:zd:19180) (q:draft)
sum = (i:1) (t:n) (f:work/everyday) (w:money/wealth) (d:money, and wealth counted in money; {sum hau} is be rich, {sum leh pai} is money and goods) (s:dangka/sumlepai) (q:draft)
sum don = (i:1) (t:v) (f:work/social) (w:pay a contribution/pay in/contribute money) (d:<sum>, money, and <don>, here pay in a share: pay the contribution or premium that every member of a fund owes; {sum don zah} is the amount to be paid, and the name of the fund stands before it) (r:zd:25568/zd:22489) (q:draft, low confidence)
sum khakna = (i:1) (t:n) (f:work) (w:money transfer/remittance/sending money) (d:<sum>, money, and <khakna>, sending, from <khak>, send: the sending of money to someone far away, a remittance, and a service or means by which money is sent) (r:zd:10685/zd:25518) (q:draft)
sum ngahna = (i:1) (t:n) (f:work) (w:income/receipts/earning) (d:<sum>, money, and <ngahna>, getting: money received, or the getting of it; {sum ngahna leh zatna} is income and expenditure in accounts, {huhna sum ngahna} is donations received, and {sum ngahna ding} is in order to earn money) (s:sumlut) (r:zd:24182/zd:21032/zd:21377) (q:draft)
sum thalawh = (i:1) (t:v) (f:work) (w:earn money/work for wages) (d:<sum>, money, and <thalawh>, work for: to earn money by one's labour, to work for a living; often followed by <theihna>, a way of earning, or <dingin>, in order to earn) (r:zd:22755/zd:11409) (q:draft)
Sumatra = (i:1) (t:name) (c:land) (f:travel) (w:Sumatra) (d:large island of Indonesia, with the provinces North, West and South Sumatra) (r:zd:22193/zd:19695) (q:draft)
sumbat = (i:1) (t:n) (f:work) (w:debt/loan) (d:<sum> and <bat> written as one word: money that is owed, a loan taken) (s:leibat) (j:sum/bat) (r:zd:10951/zd:15983) (q:draft)
sumbawl = (i:2) (t:n) (f:work) (w:trader/businessman/merchant) (d:a person who lives by trade, not the trade itself: counted or made plural as a person, {sumbawl khat}, a businessman, {sumbawl te}, the traders) (r:zd:12450/zd:17295) (q:draft)
sumbawlkhat = (i:1) (t:n) (f:work) (w:a businessman/a trader) (d:<sumbawl>, businessman, and <khat>, one, written as one word) (j:sumbawl/khat) (r:zd:19839) (q:draft)
sumbawlmi = (i:1) (t:n) (f:work) (w:trader/businessperson/merchant) (d:<sumbawl>, trade, and <mi>, person, written as one word: a person who lives by trade) (s:sumbawl) (j:sumbawl/mi) (r:zd:23077/zd:15274) (q:draft)
sumbawlsiam = (i:1) (t:adj) (f:work) (w:good at business/skilled in trade) (d:<sumbawl> and <siam> written as one word: skilled at making money, or a person so skilled) (j:sumbawl/siam) (r:zd:21869/zd:24712) (q:draft)
sumbawlzia = (i:1) (t:n) (f:work) (w:way of doing business/business method) (d:<sumbawl>, business, with <zia>, manner: the way of making money or of running a business) (b:sumbawl) (r:zd:23301/zd:21127) (q:draft)
sumbei = (i:1) (t:n) (f:work/everyday) (w:expense/cost/spending) (d:<sum>, money, with <bei>, be used up: money spent, the cost of something; {sumbei lo} is without cost, free) (j:sum/bei) (r:zd:23990/zd:22938/zd:17152) (q:draft)
sumbeilo = (i:1) (t:adv) (f:work) (w:free of charge/without cost) (d:<sum>, money, <bei>, be used up, and <lo>, not, written as one word: without spending money, free) (j:sum/bei/lo) (r:zd:13241/zd:24276) (q:draft)
sumbeizah = (i:1) (t:n) (f:work) (w:amount of cost/expenses/total spent) (d:<sumbei> and <zah> written as one word: the amount of money that is or will be spent) (j:sumbei/zah) (r:zd:15366) (q:draft)
sumbek = (i:1) (t:phrase) (f:work/everyday) (w:only money/money alone) (d:<sum>, money, and <bek>, only, written as one word: money and nothing else) (j:sum/bek) (r:zd:21817) (q:draft)
sumbekbek = (i:1) (t:phrase) (f:work) (w:cash alone/money only) (d:<sum> and <bekbek> written as one word: money and nothing else, in cash alone) (j:sum/bekbek) (r:zd:19725/zd:16608) (q:draft)
sumbuk = (i:1) (t:n) (f:work/social) (w:market/marketplace) (d:place of buying and selling; {sumbuk vante} is merchandise, {sumbuk bawlte} are traders) (s:sumzuakna/vanzuakna) (r:44.17.17) (q:draft)
sumbul = (i:1) (t:n) (f:work) (w:capital/principal/investment) (d:<sum>, money, with <bul>, base: the money with which a business is started, and the sum lent or invested as opposed to its interest) (r:zd:19774/zd:23767/zd:10743) (q:draft)
sumbulpi = (i:1) (t:n) (f:work) (w:capital/main fund/deposit) (d:<sumbul>, capital, with <pi>, great or main: the main sum of money with which a business or a fund is started; glossed as deposit in a fund's rules) (b:sumbul) (r:zd:19774/zd:12769) (q:draft)
sumbung = (i:1) (t:n) (f:work) (w:money box/fund) (d:a box that money is put into, as the fare box beside a driver; {kumpi sumbung} is glossed in one article as the state budget) (r:zd:15834) (q:draft, low confidence)
sumdal = (i:1) (t:n) (f:work) (w:banknote/note/bill) (d:<sum>, money, with <dal>, sheet: a piece of paper money) (r:zd:21586) (q:draft)
sumdalte = (i:1) (t:n) (f:work) (w:banknotes/notes/bills) (d:plural of <sumdal>: pieces of paper money) (b:sumdal) (r:zd:16114) (q:draft)
sumdong = (i:1) (t:v) (f:work/social) (w:ask for money/raise funds/solicit money) (d:<sum>, money, with <dong>, ask, written as one word: go to people and ask them for money for a cause) (j:sum/dong) (r:zd:21400/zd:24074) (q:draft)
sumit = (i:2) (t:v) (f:everyday/travel) (w:switch off/turn off/shut off) (d:stop an engine or cut off the electric current, a present-day use beside putting out a fire; the thing stopped is named before it, as {Engine sumit}) (r:zd:14944/zd:19300) (q:draft, low confidence)
sumkempi = (i:1) (t:n) (f:work/social) (w:treasurer/chief treasurer) (d:<sumkem>, treasurer, with the ending {-pi}, chief: the treasurer of an organisation or church) (b:sumkem) (r:zd:22553) (q:draft)
sumkemte = (i:1) (t:n) (f:work/social) (w:treasurers/keepers of money) (d:<sumkem>, treasurer, with the plural <te>) (b:sumkem) (r:zd:21520/zd:23156) (q:draft)
sumkhak = (i:1) (t:v) (f:work/family) (w:send money/remit) (d:<sum>, money, with <khak>, here in the sense of send, written as one word: send money to someone far away, above all from abroad to the family at home; also as a noun, money sent, a remittance) (j:sum/khak) (r:zd:22984/zd:15902/zd:16813) (q:draft)
sumkhakding = (i:1) (t:v) (f:work/family) (w:to send money/to remit) (d:<sumkhak>, send money, and <ding>, to, written as one word: in order to send or transfer money) (j:sumkhak/ding) (r:zd:15477/zd:14646) (q:draft)
sumkhakna = (i:1) (t:n) (f:work) (j:sum khakna) (r:zd:14921/zd:10762) (q:draft)
sumkhek = (i:2) (t:n) (f:work) (w:exchange rate/rate of exchange) (d:the price of one currency in another, said to fall with <kia> or rise with <khang>, often after <dollar>; not the act of changing money) (r:zd:17162/zd:25346) (q:draft)
sumkhol = (i:1) (t:v) (f:work) (w:save money/save up) (d:<sum>, money, with <khol>, store up: put money aside; also the money saved, savings, as in {a sumkhol te}) (j:sum/khol) (r:zd:22474/zd:21918) (q:draft)
sumkitah = (i:1) (t:n) (f:work/media) (w:bet/wager/betting) (d:money staked on the outcome of a game or a dare, and the betting itself; with <te>, those who bet) (r:zd:20320) (q:draft, low confidence)
sumkoihna = (i:2) (t:n) (f:work/home) (w:cash box/till/safe) (d:a box, drawer or safe in which the money of a shop or bank is kept, mostly followed by its English name, as {sumkoihna Drawer}; smaller than a treasury) (r:zd:20191/zd:16733/zd:20522) (q:draft)
sumkuang = (i:2) (t:n) (f:nature) (w:tortoise/turtle) (d:the slow animal with a hard shell, as in sayings and fables, where it digs its pool and moves on slowly; not the money chest of the Bible sense) (r:zd:22415/zd:24176) (q:draft)
sumkum = (i:1) (t:n) (f:work/politics) (w:budget year/fiscal year/financial year) (d:<sum>, money, and <kum>, year, written as one word: the year for which a government sets its budget) (j:sum/kum) (r:zd:16509) (q:draft)
sumlaidal = (i:1) (t:n) (f:work) (w:banknote/paper money/note) (d:money printed on paper, from <sum>, money, and <laidal>, sheet of paper; set against <sumtang>, coin) (r:zd:11457/zd:11587) (q:draft)
sumle = (i:1) (t:n) (f:work/everyday) (w:money and) (d:<sum>, money, and <le>, and, written as one word in the pair {sumle paii} or {sumle paai}, money and wealth) (j:sum/le) (r:zd:15681/ts:11998) (q:draft)
sumleh = (i:1) (t:phrase) (f:work/everyday) (w:money and) (d:<sum>, money, and <leh>, and, written as one word before a second noun: {sumleh lai} is the money and the letter) (j:sum/leh) (r:zd:11251/zd:21878) (q:draft)
sumlehpaai = (i:1) (t:n) (f:work) (j:sumlepai) (r:zd:20920/zd:24605) (q:draft)
sumlehpai = (i:1) (t:n) (f:work/everyday) (j:sumlepai) (r:zd:23770/zd:24022) (q:draft)
sumlei = (i:1) (t:v) (f:work/everyday) (w:buy) (d:buy with money, mostly in the pair {sumlei sumzuak}, buying and selling) (s:vanlei) (a:sumzuak) of currency
sumlei sumzuakna = (i:1) (t:n) (f:work/politics) (w:trade/commerce/business/economy) (d:<sumlei>, buy, and <sumzuakna>, selling: buying and selling taken as one thing, trade and commerce, and in writing on public affairs the economy of a country) (r:zd:19997/zd:25343) (q:draft)
sumleitawi = (i:1) (t:n) (f:work) (w:loan/borrowed money) (d:<sum> and <leitawi> written as one word: money taken on loan, and the lending and borrowing of money; {sumleitawi la} is take a loan) (j:sum/leitawi) (r:zd:22742/zd:19558) (q:draft)
sumleitawina = (i:1) (t:n) (f:work) (w:loan/money loan/borrowing of money) (d:<sum>, money, and <leitawina>, loan, written as one word) (s:sumleitawi) (j:sum/leitawina) (r:zd:20826/zd:23910) (q:draft)
sumlepaai = (i:1) (t:n) (f:work) (j:sumlepai) (r:zd:24061/zd:22650) (q:draft)
sumlom = (i:1) (t:n) (f:work) (w:sum of money/lump sum/bundle of money) (d:<sum>, money, with <lom>, lump or bundle: a large amount of money in one piece; {sumlom pi} is a big sum) (r:zd:21918/ts:11162) (q:draft)
sumlut = (i:1) (t:n) (f:work) (w:income/revenue/earnings) (d:<sum>, money, with <lut>, come in: the money that a person, a business or a country takes in) (r:zd:24043/zd:22282/zd:21989) (q:draft)
sumlutna = (i:1) (t:n) (f:work) (w:income/revenue/earnings) (d:<sum>, money, with <lutna>, coming in: the money that a person, a business or a government takes in) (r:zd:11401/zd:15234/zd:11852) (q:draft)
sumluut = (i:1) (t:n) (f:work) (j:sumlut) (r:zd:20826/zd:25768) (q:draft)
summeet = (i:2) (t:n) (f:work) (w:interest) (d:money paid on a loan or by a bank on money kept there, as {10% summeet pia}, pay 10% interest, and {bank summeet}, bank interest; the other sense is the profit of trading) (s:meet) (r:zd:17428/zd:23301) (q:draft)
summer = (i:1) (t:n) (f:time/nature) (w:summer) (d:the hot season, mostly of other countries, as in {summer hun sung}, during the summer) (s:khuakhal) (o:English) (r:zd:17060/zd:24067) (q:draft)
summet bawlna = (i:1) (t:n) (f:work) (w:business/profit-making/trade) (d:<summet>, profit, and <bawlna>, doing: the making of profit, a business or trade run for gain; {summet bawlna dingin} is for doing business, and {summet bawlna in zang} is use for profit) (s:sumbawlna) (r:zd:23729/zd:17067) (q:draft)
summuh = (i:1) (t:v) (f:work) (w:earn money/make money/get money) (d:<sum>, money, with <muh>, see or get, written as one word: get money, earn; {summuh na} is a source of income and {summuh nading} is in order to get money) (j:sum/muh) (r:zd:24957/zd:26310) (q:draft)
summuhna = (i:1) (t:n) (f:work) (w:income/earning) (d:<sum>, money, with <muh>, see and so get, and the noun suffix {-na}: the getting of money, what one earns) (r:zd:18104) (q:draft, low confidence)
sumneih = (i:1) (t:n) (f:work/everyday) (w:money one has/having money) (d:<sum>, money, and <neih>, have, written as one word: the money a person has, and the having of money; {sumneih sunsun} is what little money one has) (j:sum/neih) (r:zd:15681/zd:15983) (q:draft)
sumneilo = (i:1) (t:adj) (f:everyday/work) (w:poor/penniless/without money) (d:<sum> and <neilo> written as one word: having no money) (j:sum/neilo) (r:zd:17551/zd:20488) (q:draft)
sumngah = (i:2) (t:n) (f:work) (w:income/earnings) (d:the money that a person or a household gets, {sumngah} used as a noun after a possessive or before <pen> and <vekpi>: {sumngah vekpi} is the total income) (s:sumngahna/sumlut) (r:zd:22157/zd:14742) (q:draft)
sumngahna = (i:1) (t:n) (f:work) (w:income/earnings/money received) (d:<sumngah>, get money, with the noun suffix {-na}: the money that is received or taken in, or the getting of it) (s:sumlut) (b:sumngah) (r:zd:16608/zd:15095) (q:draft)
sumngen = (i:1) (t:v) (f:work/social) (w:ask for money/demand money) (d:<sum>, money, with <ngen>, ask for, written as one word: ask for or demand money, as a child, a beggar or one who charges for a service) (j:sum/ngen) (r:zd:18292/zd:15443) (q:draft)
sumngetna = (i:1) (t:n) (f:work/social) (w:asking for money/begging/demand for money) (d:<sum>, money, and <ngetna>, request, written as one word: asking people for money, as a beggar or street performer does, and also a demand for money) (j:sum/ngetna) (r:zd:22223) (q:draft)
sumngiat = (i:1) (t:n) (f:work) (w:cash/actual money) (d:<sum>, money, and <ngiat>, the very, written as one word: money itself, cash in hand as against goods or electronic payment) (j:sum/ngiat) (r:zd:11527/zd:18044) (q:draft, low confidence)
sumpen = (i:1) (t:n) (f:work) (w:money/the money) (d:<sum>, money, and the topic marker <pen> written as one word: the money, as for the money) (j:sum/pen) (r:zd:22451/zd:11380/zd:16949) (q:draft)
sumpia = (i:1) (t:v) (f:work) (w:pay/give money) (d:<sum> and <pia> written as one word: pay money for something, also pay someone off, bribe; {sumpia in} is by paying) (j:sum/pia) (r:zd:18943/zd:20486/zd:17886) (q:draft)
sumpiak = (i:1) (t:n) (f:work) (w:payment/paying money) (d:<sum>, money, and <piak>, give, written as one word: the paying of money; {sumpiak kullo} is without having to pay, free) (j:sum/piak) (r:zd:19953/zd:16788/zd:12913) (q:draft)
sumpiakding = (i:1) (t:n) (f:work) (w:money to be paid/payment due) (d:<sumpiak>, payment, and <ding> written as one word: money that is to be paid, or to pay money) (j:sumpiak/ding) (r:zd:15598/zd:12470) (q:draft)
sumpiakna = (i:1) (t:n) (f:work) (w:payment/paying) (d:<sumpiak> with the noun suffix <na>: the paying of money, or the place where one pays, the cashier counter) (b:sumpiak) (r:zd:23745/zd:22107) (q:draft)
sumpiakzahding = (i:1) (t:n) (f:work) (w:amount to be paid/amount payable) (d:<sumpiak>, payment, and <zahding>, amount to be, written as one word: the amount of money that is to be paid) (j:sumpiak/zahding) (r:zd:11797/zd:16813) (q:draft)
sumpiang = (i:1) (t:n) (f:nature/work) (w:mineral/natural resource) (d:wealth that comes out of the ground, such as ore, metal and precious stones; mostly in {leisung sumpiang}, minerals under the ground) (r:zd:16455/zd:12279/zd:24495) (q:draft)
sumpiangte = (i:1) (t:n) (f:nature/work) (w:minerals/natural resources) (d:plural of <sumpiang>; mostly in {leisung sumpiangte}, the natural resources in the ground) (b:sumpiang) (r:zd:22785/zd:24658) (q:draft)
sumpite = (i:1) (t:n) (f:work/religion) (w:funds/finances) (d:<sumpi>, fund, with the plural <te>: the funds or money of a church or group) (b:sumpi) (r:zd:15234/zd:24053) (q:draft, low confidence)
sumsak = (i:1) (t:v) (f:everyday/work) (w:cause to lose/make lose/diminish) (d:make someone suffer a loss, or make something be lost or grow less, as jobs or support) (r:zd:19654/zd:21974) (q:draft, low confidence)
sumsazian = (i:1) (t:n) (f:work) (w:accounts/financial record/bank account) (d:<sum> and <sazian> written as one word: the record of money received and spent; {sumsazian laibu} is an account book) (j:sum/sazian) (r:zd:25928/ts:2216) (q:draft)
sumsim = (i:1) (t:v) (f:work) (w:count money) (d:<sum>, money, and <sim>, count, written as one word; {sumsim nading} is for counting money) (j:sum/sim) (r:zd:19863) (q:draft)
sumtampi = (i:1) (t:n) (f:work/everyday) (w:much money/a lot of money/fortune) (d:<sum>, money, and <tampi>, much, written as one word: a large amount of money) (j:sum/tampi) (r:zd:17607/zd:19774/zd:21869) (q:draft)
sumtang = (i:2) (t:n) (f:work/everyday) (w:cash/money) (d:money as a sum that is paid, given or taken, not a single coin; stands before an amount or a currency such as {RM}, {Ks} or {MMK}, and beside the word {cash}) (r:zd:10983/zd:14767/zd:12976) (q:draft)
sumtangin = (i:1) (t:adv) (f:work) (w:in cash/in money) (d:<sumtang> and <in> written as one word: as money, in cash, mostly before an amount) (j:sumtang/in) (r:zd:22019/zd:19569) (q:draft)
sumtawh = (i:1) (t:adv) (f:work/everyday) (w:with money/by money) (d:<sum>, money, and <tawh>, with, written as one word: with money, by means of money) (j:sum/tawh) (r:zd:20747/zd:24089/zd:21869) (q:draft)
sumtawm = (i:1) (t:phrase) (f:work/everyday) (w:little money/low cost) (d:<sum>, money, and <tawm>, little, written as one word: a small sum; {sumtawm bei} is cost little) (j:sum/tawm) (r:zd:19390/zd:22451) (q:draft)
sumtawng = (i:1) (t:n) (f:home) (w:woodshed/front porch) (d:a part at the front of a traditional Zo house, named beside <sumbuk> and {sumtual}, where firewood is kept) (r:zd:19299) (q:draft, low confidence)
sumtha = (i:1) (t:n) (f:work/social) (w:financial strength/financial resources/funds) (d:<sum> money with <tha> strength: the strength that money gives, set beside {mihing tha}, manpower) (r:zd:23496/zd:24750) (q:draft)
sumthalawh = (i:1) (t:v) (f:work) (w:earn money/work for wages) (d:<sum>, money, and <thalawh>, earn, written as one word: work to earn money) (j:sum/thalawh) (r:zd:11744/zd:26310) (q:draft)
sumthoh = (i:1) (t:v) (f:work) (w:withdraw money/collect money) (d:<sum>, money, and <thoh>, draw out, written as one word: withdraw or collect money, as from a bank, a cash machine or a money transfer; also the withdrawing itself) (j:sum/thoh) (r:zd:25068/zd:23863) (q:draft)
sumtuh = (i:1) (t:n) (f:work/politics) (w:counterfeit money/fake money/forged banknotes) (d:<sum>, money, that is <atuh>, fake or imitation: money made to pass as real) (r:zd:11608/zd:12788/zd:12482) (q:draft)
sumvai = (i:1) (t:n) (f:work/politics) (w:finance/money matters/financial affairs) (d:<sum>, money, with <vai>, affair: matters of money, finance or funds) (r:zd:11652/zd:17152) (q:draft)
sumzat = (i:1) (t:n) (f:work) (w:expense/spending/expenditure) (d:<sum>, money, and <zat>, use, written as one word: the money that is spent, and the spending of it) (j:sum/zat) (r:zd:23301/zd:15983/zd:24852) (q:draft)
sumzat = (i:2) (t:n) (f:work) (w:currency) (d:the money in use in a country) (j:sum/zat) (r:zd:22381) (q:draft, low confidence)
sumzatna = (i:1) (t:n) (f:work) (w:expenditure/spending/expenses) (d:<sum>, money, and <zatna>, using, written as one word: the money that is spent, or the way one spends it) (j:sum/zatna) (r:zd:21220/zd:23301/ts:2400) (q:draft)
sumzekna = (i:1) (t:n) (f:work/politics) (w:financial management/budgeting/handling of money) (d:<sum>, money, with <zekna>, managing, from <zek>: the way money is managed and spent, a budget; often paired with <sumzatna>, spending) (r:zd:23904/zd:19993) (q:draft)
sumzian = (i:1) (t:n) (f:work) (w:capital/funds/investment) (d:money put into a business or needed for an undertaking, also the sum spent on it) (r:zd:19829/zd:14665/zd:14551) (q:draft)
sumzon = (i:1) (t:v) (f:work) (w:earn money/make a living) (d:<sum>, money, and <zon>, seek, written as one word: work to earn money; also used as a noun, the earning of money) (j:sum/zon) (r:zd:15941/zd:20443/zd:22464) (q:draft)
Sumzondan = (i:1) (t:n) (f:work) (w:way of earning money/way of making a living) (d:<sumzon>, earn money, and <dan>, way, written as one word; {sumzondan atuamtuam} is the various ways of earning money) (j:sumzon/dan) (r:zd:15274) (q:draft)
sumzong = (i:1) (t:v) (f:work) (w:earn money/make a living/seek money) (d:<sum>, money, and <zong>, seek, written as one word: work to earn money, often of those who go abroad for it) (j:sum/zong) (r:zd:19676/zd:19603) (q:draft)
sumzong = (i:2) (t:phrase) (f:work/everyday) (w:the money also/money too) (d:<sum>, money, and <zong>, also, written as one word) (j:sum/zong) (r:zd:15814) (q:draft, low confidence)
sumzongding = (i:1) (t:phrase) (f:work) (w:to earn money) (d:<sumzong>, earn money, and <ding> written as one word, usually before <in>: in order to earn money) (j:sumzong/ding) (r:zd:17945/zd:18292) (q:draft)
sumzongin = (i:1) (t:adv) (f:work/travel) (w:to earn money/in search of money) (d:<sumzong>, earn money, with <in>: in order to earn money, said of those who leave home for work) (j:sumzong/in) (r:zd:15941/zd:20979) (q:draft)
sumzonna = (i:1) (t:n) (f:work) (w:earning money/livelihood/business) (d:<sum>, money, with <zonna>, seeking: the earning of money, and the work or business by which one earns it) (j:sum/zonna) (r:zd:23301/zd:15276/zd:19145) (q:draft)
sumzonzia = (i:1) (t:n) (f:work) (w:way of earning money/economy) (d:<sum>, money, and <zonzia>, way of seeking, written as one word: the way a person or a country earns money, also used for the economy) (j:sum/zonzia) (r:zd:12785/zd:17822) (q:draft)
sun = (i:1) (t:n) (f:time) (w:day/daytime) (d:the light part of the day, the opposite of <zan>, night; {sun leh zan} is day and night and {sun-in} is by day) (a:zan) as in during sun light
sun an = (i:1) (t:n) (f:food/time) (w:lunch/midday meal) (d:<sun>, daytime, and <an>, food: the midday meal; the other meals are named the same way with the time of day before <an>) (r:zd:19371/zd:17963) (q:draft)
sunan = (i:1) (t:n) (f:food/time) (j:sun an) (r:zd:23886) (q:draft)
Sunday = (i:1) (t:n) (c:ni) (f:time) (w:Sunday) (s:nipi) (o:English) (r:zd:16136/zd:20382/zd:16373) (q:draft)
sung tawntung = (i:1) (t:prep) (f:time) (w:throughout/all through/during the whole of) (d:<sung>, within, and <tawntung>, without stopping: placed after a word for a span of time, through the whole of it, as {a nuntak sung tawntung}, all his life long) (r:zd:9261/zd:25393/zd:19858) (q:draft)
sung vilvel = (i:1) (t:adv) (f:time) (w:for the whole of/all through/for fully) (d:<sung>, during, and <vilvel>, here a word that stresses the full length: placed after a number of days or years, for that whole time without a break) (r:zd:15653/zd:22683) (q:draft)
sungaa = (i:1) (t:prep) (f:everyday) (w:in/inside/within) (d:<sung>, inside, and <aa> written as one word, placed between a noun and what is inside it: {pumpi sungaa}, that is in the body) (j:sung/aa) (r:zd:21006/zd:21085/zd:21918) (q:draft)
sungahbel = (i:1) (t:prep) (f:everyday) (w:as for in/among) (d:<sung>, in, and <ahbel>, as for in, written as one word after a noun: within that one, for its part, set against others) (j:sung/ahbel) (r:zd:11712/zd:13000) (q:draft)
sungahzong = (i:1) (t:adv) (f:everyday) (w:also in/inside too) (d:<sungah> and <zong> written as one word: in it also, inside as well) (j:sungah/zong) (r:zd:16794/zd:11854) (q:draft)
Sungaibuloh = (i:1) (t:name) (c:place) (f:travel) (w:Sungai Buloh) (d:a town in Selangor, Malaysia, known for its prison and its hospital; usually written as two words, Sungai Buloh) (r:zd:15379) (q:draft)
sungaom = (i:1) (t:adj) (f:everyday/travel) (w:located in/in) (d:<sung>, in, with <a> and <om>, be, written as one word: that is in, placed between a place and what is found there) (j:sung/a/om) (r:zd:14995/zd:17647) (q:draft)
sungbang = (i:1) (t:prep) (f:time) (w:for about/within about) (d:<sung> and <bang> written as one word, placed after a length of time or a measure: for about that long, within roughly that much) (j:sung/bang) (r:zd:20946/zd:11058/zd:22894) (q:draft)
sungbek = (i:1) (t:adv) (f:time) (w:only within/only during/only in) (d:<sung> and <bek> written as one word, placed after a word of time or place: only for that length of time, only inside that place) (j:sung/bek) (r:zd:16178/zd:14887/zd:20854) (q:draft)
sungbekbek = (i:1) (t:phrase) (f:everyday) (w:in just/within only/alone) (d:<sung> and <bekbek> written as one word, placed after a place or a length of time: within that alone, in just that) (j:sung/bekbek) (r:zd:11285/zd:23984) (q:draft)
sungh = (i:1) (t:n) (f:family) (w:in-law/wife's family) (d:relatives by marriage on the wife's side, such as her father, {sungh pa}; often named together with <pu>, the mother's side) (r:zd:24188/zd:24072) (q:draft, low confidence)
sungh = (i:2) (t:v) (f:politics/social) (w:submit/propose/put forward) (d:bring a matter or request before a body or a person in authority, usually as {thu sungh}) (r:zd:14755/zd:22411/zd:11463) (q:draft)
sunghnu = (i:1) (t:n) (f:family) (w:mother-in-law) (d:the mother of a man's wife; the father is <sunghpa>) (r:zd:26385/zd:17426) (q:draft)
sunghpa = (i:1) (t:n) (f:family) (w:father-in-law) (d:the father of a man's wife) (r:zd:24320/zd:17332) (q:draft)
sunghte = (i:1) (t:n) (f:family) (w:parents-in-law/in-laws) (d:<sungh>, parent-in-law, with plural <te>: the parents of one's wife or husband and their household; {a sunghte inn} is the house of his in-laws) (r:zd:17341/ts:261/zd:19108) (q:draft)
sungkhak = (i:1) (t:n) (f:health) (w:constipation) (d:<sung>, the inside, with <khak>, shut: blocked bowels, constipation; some sentences write {sungkhak ah} where {sungkhat ah}, in one, seems meant) (r:zd:19593/zd:12996) (q:draft)
sungkhat = (i:1) (t:phrase) (f:everyday) (w:inside a/in one) (d:<sung>, inside, and <khat>, one, written as one word after a noun: the inside of a certain one, as {Hotel sungkhat ah}, in a hotel; {tun sungkhat pan} is from one womb, of the same mother) (j:sung/khat) (r:zd:19790/zd:12132) (q:draft)
sungkhatah = (i:1) (t:adv) (f:everyday/travel) (w:in a/inside a) (d:<sung>, inside, <khat>, one, and <ah> written as one word and placed after a noun: inside one such place, in a hotel, in a car, in a video) (j:sung/khat/ah) (r:zd:15803/zd:15301/zd:18102) (q:draft)
sungkhatpan = (i:1) (t:phrase) (f:everyday) (w:from inside a/from within one) (d:<sungkhat>, inside a, and <pan>, from, written as one word after a noun) (j:sungkhat/pan) (r:zd:17911/zd:11700) (q:draft)
sungkhawng = (i:1) (t:adv) (f:everyday/time) (w:for about/somewhere in/in or around) (d:<sung>, in, and <khawng>, or so, written as one word: after a length of time, for about that long; after a place, with <ah>, somewhere in it) (j:sung/khawng) (r:zd:16164/zd:16885/zd:18286) (q:draft)
sungkhawngbek = (i:1) (t:adv) (f:time/everyday) (w:for only about/just around) (d:<sungkhawng>, for about, and <bek>, only, written as one word after a length of time: for no more than about that long) (j:sungkhawng/bek) (r:zd:19671/zd:13131) (q:draft)
sungkhempeuh = (i:1) (t:adv) (f:everyday) (w:throughout/all through) (d:<sung> and <khempeuh> written as one word: the whole inside of something, everywhere in it) (j:sung/khempeuh) (r:zd:20778/zd:14831) (q:draft)
sungkhia = (i:2) (t:v) (f:media/politics) (w:present/put forward/set out/submit) (d:lay thoughts, points or a proposal before others in speech or writing, as a writer does with {kong sungkhia} or a party with a bill in parliament; the thing set out is <thu>, <ngaihsutna> or <muhna>, not a liquid and not the heart before God) (r:zd:22709/zd:12544/zd:23485) (q:draft)
sunglammi = (i:1) (t:n) (f:religion/social) (w:inner person/inner self) (d:<sunglam> and <mi> written as one word: the unseen person within a human being, the inner self) (j:sunglam/mi) (r:zd:20568/zd:20781) (q:draft)
sunglampan = (i:1) (t:adv) (f:everyday) (w:from inside/from within) (d:<sunglam>, the inside, and <pan>, from, written as one word: from the inside, from within) (j:sunglam/pan) (r:zd:15422) (q:draft)
sunglampilna = (i:1) (t:n) (f:education/health) (w:subconscious mind/inner mind/inner wisdom) (d:<sunglam>, inside, and <pilna>, wisdom, written as one word: the inner or subconscious mind, set against {pualam pilna}, the conscious mind) (j:sunglam/pilna) (r:zd:21876/zd:21869) (q:draft)
sunglamtha = (i:1) (t:n) (f:everyday) (w:inner strength/inner power) (d:<sunglam>, inside, with <tha>, strength: the power within a person, of mind or spirit, as against outward things; also said of the engine that drives a car) (j:sunglam/tha) (r:zd:21389/zd:20829) (q:draft)
sungleh = (i:1) (t:phrase) (f:everyday) (w:in and/inside and) (d:<sung>, in, and <leh>, and, written as one word: placed after the first of two places that are joined, in this and in that) (j:sung/leh) (r:zd:21869/zd:12063) (q:draft)
sunglut = (i:1) (t:v) (f:everyday/social) (w:enter into/go in/join) (d:<sung>, inside, and <lut>, enter, written as one word: go right into something, take part in it from within; of water, soak in) (j:sung/lut) (r:zd:17437/zd:22815) (q:draft, low confidence)
sungmah = (i:1) (t:prep) (f:everyday) (w:right in/within) (d:<sung> and <mah> written as one word: in that very place or time, right inside it; mostly followed by <ah> or <in>) (j:sung/mah) (r:ts:301/zd:24610) (q:draft)
sungmi = (i:1) (t:n) (f:social) (w:insider/member/inner self) (d:<sung>, inside, with <mi>, person: a person who belongs inside a group or area; also said of the inner person, the self within) (r:zd:20695) (q:draft, low confidence)
sungnim = (i:1) (t:n) (f:health) (w:nausea/queasiness) (d:the sick feeling in the stomach that comes before vomiting) (r:zd:19593) (q:draft, low confidence)
sungnimsak = (i:1) (t:v) (f:health) (w:make nauseous/sicken) (d:<sungnim>, nausea, and causative <sak> written as one word: make someone feel sick in the stomach) (j:sungnim/sak) (r:zd:15481/zd:20234) (q:draft)
sungpai = (i:1) (t:n) (f:health/body) (w:diarrhoea/bowel movement) (d:<sung>, inside, with <pai>, go: the emptying of the bowels, and especially loose bowels, diarrhoea; {sungpai natna} is diarrhoeal disease and {sungpai zavat natna} cholera) (r:zd:11617/zd:11020/zd:24276) (q:draft)
sungpen = (i:1) (t:phrase) (f:time/everyday) (w:during/within) (d:<sung>, in, and the topic marker <pen>, written as one word after a time or place: as for the time during, as for the area within) (j:sung/pen) (r:zd:23797/zd:22203) (q:draft)
sungsilh = (i:1) (t:n) (f:home) (w:undergarment/underwear/vest) (d:<sung>, inside, with <silh>, wear: a garment worn under other clothes, often as {puan sungsilh}) (r:zd:23533/zd:12403) (q:draft)
sungsuak = (i:1) (t:adj) (f:family) (w:own/natural-born/begotten) (d:<sung>, inside, with <suak>, come out: born of one's own body, said of one's own child as against a child by marriage or adoption; also of what a place produces itself) (r:zd:23424/zd:22582) (q:draft)
sungta = (i:1) (t:adv) (f:time) (w:for as long as/for each period of) (d:<sung>, during, with <ta>, placed after a length of time: for that long each time or each one, as in {nai 5 sungta}, for five hours each) (j:sung/ta) (r:zd:19213/zd:19826) (q:draft, low confidence)
sungta = (i:2) (t:n) (f:family) (w:in-laws/relatives by marriage) (d:persons related through a marriage, a parent-in-law and a child-in-law taken as a pair; said beside {unau-pata} and <putu>) (r:ts:9672) (q:draft, low confidence)
sungtak = (i:1) (t:adv) (f:time) (w:for a full/as long as) (d:<sung> and <tak> written as one word, placed after a length of time to stress it: for fully that long; {nai 10 sungtak} is for a full ten hours) (j:sung/tak) (r:zd:14839/zd:15659/zd:17450) (q:draft)
sungteen = (i:1) (t:n) (f:home) (w:underwear/undergarment/underpants) (d:a garment worn under the outer clothes; {bombi sungteen} is underpants) (r:zd:14561/zd:16696) (q:draft)
sungten = (i:1) (t:n) (f:home) (w:underwear/underpants/undergarment) (d:clothing worn next to the body under other clothes; {pheituam sungten} is underpants) (r:zd:22499/zd:23131) (q:draft)
sungtengpen = (i:1) (t:phrase) (f:everyday) (w:the whole of/all within/throughout) (d:<sungteng>, all within or throughout, and the topic marker <pen>, written as one word after a place or a length of time: the whole area within it, or all through that time, as the topic of the sentence) (j:sungteng/pen) (r:zd:15382/zd:19563) (q:draft)
sungtengzong = (i:1) (t:adv) (f:everyday/travel) (w:throughout also/all over as well) (d:<sung> and <tengzong> written as one word after a place: the whole of the inside of it too, all through it as well) (j:sung/tengzong) (r:zd:17645/zd:12873) (q:draft)
sungtholh = (i:1) (t:v) (f:health/body) (w:have diarrhoea/have loose bowels/purge) (d:empty the bowels, especially with loose stools; {sungtholh za} is a laxative) (s:sungpai) (r:zd:21826/zd:15270) (q:draft)
sunguh = (i:1) (t:phrase) (f:everyday) (w:in their/within their) (d:<sung>, in, and the plural marker <uh> written as one word: inside something that belongs to them, or during their time of something) (j:sung/uh) (r:zd:21869/zd:10698) (q:draft)
sungzong = (i:1) (t:adv) (f:everyday/time) (w:also in/also during/even within) (d:<sung>, in or during, and <zong>, also, written as one word, placed after a place or a length of time) (j:sung/zong) (r:zd:17595/zd:15417) (q:draft)
sunhun = (i:1) (t:n) (f:time) (w:daytime/midday) (d:<sun> and <hun> written as one word: the daytime, the middle part of the day) (j:sun/hun) (r:zd:16038/zd:24213) (q:draft)
sunin = (i:2) (t:adv) (f:time) (w:by day/in the daytime) (d:<sun>, daytime, with the ending <in>: during the day, set against <zan>, night; not {sunin}, in the likeness of) (r:zd:21268) (q:draft, low confidence)
sunkhat = (i:1) (t:n) (f:time) (w:one day/a whole day) (d:<sun>, daytime, and <khat>, one, written as one word; {sunkhat zankhat} is one day and one night, and also in a single day, overnight) (j:sun/khat) (r:zd:17426/zd:11150) (q:draft)
sunkhiat = (i:1) (t:v) (f:social/religion) (w:pour out/unburden/disclose) (d:pour out what is in the heart, tell one's troubles or private matters to God or to others; compare <sungkhia>, pour out) (r:zd:22775/zd:23556) (q:draft, low confidence)
sunkhiatna = (i:1) (t:n) (f:media/social) (w:expression/setting out/voicing) (d:the act of pouring out or setting out what is in the mind, as thoughts, beliefs or views, before others; compare <sungkhia>) (r:zd:23394/zd:23539) (q:draft)
sunkhua = (i:1) (t:n) (f:time) (w:daytime/all day/whole day) (d:the daytime, the length of the day; {sunkhua-in} is during the day, all day long) (r:zd:25115/zd:9432/zd:10938) (q:draft, low confidence)
sunkim = (i:1) (t:n) (f:time) (w:noon/midday) (d:the middle of the day; {sunkim laipi} is high noon) (s:suntang/suntangpi) (a:zankim) (r:11.18.29) (q:draft)
sunkimpawl = (i:1) (t:adv) (f:time) (w:around noon/about midday) (d:<sunkim>, noon, and <pawl>, about, written as one word: at about noon) (j:sunkim/pawl) (r:zd:15761/zd:15507) (q:draft)
sunlam = (i:1) (t:n) (f:time) (w:daytime/midday) (d:<sun>, day, with <lam>, side: the daytime part of the day, in news the hours around noon, between morning and evening; {Monday sunlam in} is on Monday around midday) (r:zd:19554/zd:15535/zd:22151) (q:draft)
sunlampawl = (i:1) (t:n) (f:time) (w:around midday/about noon) (d:<sunlam>, daytime, and <pawl> written as one word: about the middle of the day; with <in>, at around midday) (j:sunlam/pawl) (r:zd:13213/zd:15019) (q:draft)
sunlehzan = (i:1) (t:adv) (f:time) (w:day and night) (d:<sun>, <leh> and <zan> written as one word: by day and by night, all the time) (j:sun/leh/zan) (r:zd:20568/zd:21037) (q:draft)
sunlezan = (i:1) (t:adv) (f:time) (w:day and night/night and day) (d:<sun>, <le> and <zan> written as one word: by day and by night, all the time) (j:sun/le/zan) (r:zd:24069/zd:21121) (q:draft)
sunmang = (i:1) (t:n) (f:everyday/social) (w:dream/aspiration/vision) (d:what a person or a people hopes and longs to reach, a dream for the future; named together with <lametna>, hope, and <ngimna>, aim) (r:zd:24248/zd:25129/zd:24455) (q:draft)
sunmangte = (i:1) (t:n) (f:everyday/social) (w:dreams/aspirations) (d:<sunmang> with the plural <te>, written as one word: dreams, hopes for the future) (b:sunmang) (j:sunmang/te) (r:zd:10952/zd:14552) (q:draft)
sunna = (i:2) (t:n) (f:politics/social) (w:statement/submission/presentation) (d:after <thu>, matter: the putting forward of a matter in words before a meeting, the same as <thusunna> written as two words; {thu sunna nei} is make a statement or hold a hearing; not the casting mould) (r:zd:25359/zd:24894) (q:draft)
sunni = (i:1) (t:n) (f:nature) (w:sun/sunshine) (d:<sun>, daytime, with <ni>, here the sun: the sun of the day and its light, mostly in songs and elevated speech) (j:sun/ni) (r:zd:23554/zd:19378) (q:draft, low confidence)
sunphuk = (i:1) (t:n) (f:health) (w:smallpox) (d:the disease smallpox, also called {sunphuk natna}) (r:zd:21974) (q:draft)
sunphuk = (i:2) (t:n) (f:health) (w:vaccination/vaccine) (d:an injection given to protect against a disease) (r:zd:23697) (q:draft, low confidence)
Sunroof = (i:1) (t:n) (f:travel) (w:sunroof) (d:the opening panel in the roof of a car, written after {mawtaw ii atungkhuh}, the cover on top of the car) (o:English) (r:zd:16942/zd:21385) (q:draft, low confidence)
sunsiah = (i:1) (t:n) (f:food) (w:lunch/midday meal/packed lunch) (d:food eaten at midday, also the food packed to take along for the day) (r:zd:23616/zd:20946/zd:17963) (q:draft)
sunsung = (i:1) (t:adv) (f:time) (w:during the day/in the daytime) (d:<sun>, daytime, and <sung>, during, written as one word) (j:sun/sung) (r:zd:14985/zd:24089) (q:draft)
sunsunteng = (i:1) (t:pron) (f:everyday) (w:all the little that/whatever little) (d:<sunsun>, what little, and <teng>, all, written as one word after a verb: all of the little that was got or is owned) (j:sunsun/teng) (r:zd:23038/zd:21327) (q:draft, low confidence)
suntawh = (i:1) (t:adv) (f:time) (w:by day/day) (d:<sun>, day, with <tawh>, with, written as one word; used in the pair {suntawh zantawh}, day and night, around the clock) (j:sun/tawh) (r:zd:14652/zd:21869) (q:draft)
sunte = (i:2) (t:n) (f:everyday) (w:the few that/what little) (d:after a verb such as <ngah>, <hau> or <bawl>, the few people or things that have got, become or been made so, as <sunsun> after a noun; without {om lai} it does not mean survivors) (r:zd:23902/zd:12341) (q:draft, low confidence)
Sunway = (i:1) (t:name) (c:place) (f:travel) (w:Sunway/Bandar Sunway) (d:Bandar Sunway, a township near Kuala Lumpur in Malaysia where many Zomi live) (r:zd:16136/zd:17138) (q:draft)
Supermarket = (i:1) (t:n) (f:work/food) (w:supermarket) (d:a large self-service shop for food and household goods) (o:English) (r:zd:12405/zd:19355) (q:draft)
supervisor = (i:1) (t:n) (f:work) (w:supervisor/overseer) (d:person who oversees workers at a place of work) (o:English) (r:zd:9264/zd:20586) (q:draft)
suplawhna = (i:1) (t:n) (f:everyday/work) (w:loss) (d:<suplawh>, lose, with the noun suffix <na>: what is lost, or the fact of losing) (b:suplawh) (r:zd:23268/zd:19425) (q:draft)
support = (i:1) (t:v) (f:social/politics) (w:support/back) (d:give help or backing to a person or cause; also used as a noun, support, as in {support tawh}, with the support of) (s:huh) (o:English) (r:ts:7051) (q:draft)
supporters = (i:1) (t:n) (f:politics/social) (w:supporter/follower) (d:the people who side with a leader, a party or a cause, {a panpihte}; written in the English plural and often followed by <te>) (o:English) (r:zd:19583/zd:16782) (q:draft)
Surabaya = (i:1) (t:name) (c:city) (f:travel) (w:Surabaya) (d:a large city on the island of Java, the second largest city of Indonesia) (r:zd:19644/zd:10670) (q:draft)
surau = (i:1) (t:n) (f:religion) (w:surau/Muslim prayer hall) (d:in Malaysia, a small building where Muslims meet to pray, smaller than a mosque; mostly in names and English sentences) (o:Malay) (r:zd:20732) (q:draft, low confidence)
Surgery = (i:1) (t:n) (f:health) (w:surgery/operation) (d:a medical operation; {surgery bawl} is to perform an operation) (o:English) (r:zd:12600/zd:12094) (q:draft)
Surname = (i:1) (t:n) (f:social/family) (w:surname/family name) (d:the family name of a person, used in news reports where only that part of a name is made public) (o:English) (r:zd:19962/zd:19465) (q:draft, low confidence)
surveillance = (i:1) (t:n) (f:politics/it) (w:surveillance/monitoring) (d:the watching of people or places by police, cameras or aircraft; mostly inside English phrases such as Surveillance Camera) (o:English) (r:zd:20293/zd:13155) (q:draft, low confidence)
survey = (i:1) (t:n) (f:work/education) (w:survey) (d:a survey of land or a route, or a set of questions put to people; {survey bawl} is make a survey) (o:English) (r:zd:24271/zd:20406) (q:draft)
Sushi = (i:1) (t:n) (f:food/work) (w:sushi) (d:the Japanese dish of rice with fish; many Zomi abroad work in or own a sushi shop, {Sushi sai}) (o:Japanese) (r:zd:12794/zd:13192/zd:26097) (q:draft)
susiading = (i:1) (t:v) (f:everyday/social) (w:will destroy/to ruin) (d:<susia> and <ding> written as one word: in order to destroy or ruin, about to destroy) (j:susia/ding) (r:zd:15059) (q:draft)
sut = (i:4) (t:v) (f:health/body) (w:inject/pierce/prick/stab) (d:pierce with something pointed: with <vaccine> or <zatui> it is give or get an injection, and {thal a sut} is an arrow pierces) (r:zd:24276/zd:25231/zd:23022) (q:draft)
sutkik = (i:1) (t:v) (f:social/politics) (w:take back by force/seize back) (d:<sut>, take by force, with <kik>, back, written as one word: take back what others have seized) (j:sut/kik) (r:zd:22650) (q:draft, low confidence)
sutloh = (i:1) (t:v) (f:everyday) (w:not pull out/not inject) (d:<sut> with the negative <loh> written as one word: not doing what <sut> names, as in {asutleh sutloh}, whether he injected or not, and {a khe a sutloh nadingin}, so that he could not get his foot free) (j:sut/loh) (r:zd:9432/zd:12616) (q:draft, low confidence)
sutna = (i:2) (t:n) (f:health) (w:injection/injecting) (d:the giving of medicine or a vaccine through a needle, after <zatui> or <vaccine>; {zatui sutna phim} is the needle of a syringe) (r:zd:21633/zd:24500) (q:draft)
sutna = (i:3) (t:n) (f:religion) (w:likeness/imitation/reflection) (d:the copying or bearing of the likeness of another, said of people who take after God or Christ, as in {Pasian lim le mel sutna}, a bearing of the image of God) (r:zd:23394/zd:23113) (q:draft, low confidence)
sutsuk = (i:1) (t:v) (f:media/education) (w:go through/look into/set out) (d:take up a matter and go through it point by point, said by a writer before a list or an explanation; {sutsuk ni} is let us go through) (r:zd:23880/zd:24455) (q:draft, low confidence)
sutuah = (i:1) (t:v) (f:social) (w:set against each other/stir up conflict/incite) (d:<su>, touch, with <tuah>, bring together: make people clash with one another, stir up a quarrel between them; {ki sutuah} is clash with each other) (r:zd:22586/zd:19150/ts:9808) (q:draft)
suuk = (i:1) (t:v) (f:everyday/health) (w:get worse/worsen/decline) (d:go down, become worse or lower; {suuk zaw} is worse than and {suuk semsem} is worse and worse; a long-vowel form related to <suk>, down) (r:zd:20550/zd:20908) (q:draft)
suuksia = (i:1) (t:v) (f:everyday/health) (w:get worse/deteriorate/be worse) (d:go down and become bad, of a situation or of the condition of a sick person; with <zaw>, worse than) (r:zd:20823/zd:23846) (q:draft)
suukzaw = (i:1) (t:v) (f:everyday) (w:be worse/get worse/decline further) (d:<suuk>, go down or get worse, with the comparative <zaw>, written as one word) (j:suuk/zaw) (r:zd:21690) (q:draft, low confidence)
suulzuih = (i:1) (t:v) (f:everyday/religion) (j:sulzuih) (r:zd:20091/zd:25686) (q:draft)
suun = (i:2) (t:n) (f:time) (w:daytime/day/midday) (d:the light part of the day, another spelling of <sun>; {suun an} is the midday meal; not the verb resemble) (s:sun) (r:zd:25165/zd:20172) (q:draft)
suut = (i:1) (t:v) (f:media/education) (w:recount/relate/trace/go through) (d:tell or go through a matter point by point, as a history, a story or the meaning of something; the same word as <sut.3>, written with a long vowel; also found in personal names) (r:zd:24594/zd:24682/ts:3372) (q:draft)
suutkhia = (i:1) (t:v) (f:media/everyday) (w:recount/relate/bring out/disclose) (d:<suut> and <khia> written as one word: tell a matter out in full, bring it into the open) (j:suut/khia) (r:zd:25572) (q:draft)
suutlo = (i:1) (t:v) (f:media/education) (w:not recount/not go through) (d:<suut>, recount or go through, and <lo>, not, written as one word) (j:suut/lo) (r:zd:25569) (q:draft, low confidence)
suutna = (i:1) (t:n) (f:education/media) (w:study/tracing/examination/exposition) (d:<suut>, go through point by point, with the noun suffix <na>: the tracing or careful examining of a matter; {khanggui suutna} is genealogy, the tracing of descent) (b:suut) (r:zd:24071/zd:23086) (q:draft)
