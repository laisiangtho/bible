townships = (i:1) (t:n) (f:politics) (w:townships) (d:English plural of township, the administrative division below the district in Myanmar, used in Zolai text without the plural <te>) (o:English) (r:zd:25357/zd:21067) (q:draft)
Toyota = (i:1) (t:name) (f:travel) (w:Toyota) (d:a Japanese make of car) (r:zd:17450/zd:12517) (q:draft)
Traffic = (i:1) (t:n) (f:travel) (w:traffic/traffic light) (d:the movement of vehicles on a road; also short for the traffic lights, as in {Traffic khawlna}, the stop at the lights) (o:English) (r:zd:14709/zd:14781/zd:11825) (q:draft, low confidence)
Trailer = (i:1) (t:n) (f:travel) (w:trailer truck/articulated lorry/trailer) (d:a large goods lorry that pulls a trailer, also {Trailer mawtaw}) (o:English) (r:zd:21411/zd:20982) (q:draft)
trailer mawtawpi = (i:1) (t:n) (f:travel) (w:trailer truck/articulated lorry/semi-trailer) (d:{trailer}, the English word, and <mawtawpi>, truck: a large truck that draws a long trailer; the usual name of this vehicle in reports of road accidents) (r:zd:20982/zd:21164) (q:draft)
training = (i:1) (t:n) (f:education/work) (w:training/course) (d:a course of training for a job, a skill or military service) (o:English) (r:zd:20572/ts:6525) (q:draft)
Transavia = (i:1) (t:name) (f:travel) (w:Transavia) (d:Dutch airline; {Transavia Airlines}, {Transavia vanleng}) (r:zd:17846/zd:17796) (q:draft)
transfer = (i:1) (t:v) (f:work) (w:transfer/be transferred) (d:move or be moved to another place of work, or send money through a bank) (o:English) (r:zd:24029/zd:19166/zd:14646) (q:draft)
transgender = (i:1) (t:n) (f:social) (w:transgender person/transgender) (o:English) (r:zd:24913/zd:25323) (q:draft, low confidence)
Transit = (i:1) (t:n) (f:travel) (w:transit) (d:passing through a country or an airport on the way to another place; {Transit ding} is to pass through and {Transit Visa} a visa for passing through) (o:English) (r:zd:11627/zd:11612/zd:25918) (q:draft)
translate = (i:1) (t:v) (f:education/media) (w:translate) (d:the English verb used in Zolai sentences, often with <bawl> or <sak>: put a text into another language; writers also gloss {kaleh} and {kiteisawn} with it) (o:English) (r:zd:17921/ts:7528/zd:12093) (q:draft)
transparency = (i:1) (t:n) (f:politics) (w:transparency/openness) (d:openness of a government or an organisation about what it does, so that the public can see it) (o:English) (r:zd:17826/zd:24305) (q:draft)
Transportation = (i:1) (t:n) (f:travel) (w:transportation/transport) (d:the carrying of people and goods, and the vehicles and roads for it; mostly in {public transportation}) (o:English) (r:zd:22686/zd:21961) (q:draft, low confidence)
Tray = (i:1) (t:n) (f:work/home) (w:tray/display tray) (d:a flat tray, in the articles the trays on which a shop lays out jewellery) (o:English) (r:zd:17647/zd:11352) (q:draft, low confidence)
Treatment = (i:1) (t:n) (f:health) (w:treatment/medical treatment) (d:medical care given to a sick or injured person, used beside {zatui bawl}) (o:English) (r:zd:21067/zd:15123) (q:draft, low confidence)
trial = (i:1) (t:n) (f:health) (w:trial/clinical trial) (d:the testing of a medicine or vaccine on people) (o:English) (r:zd:24369) (q:draft)
trial = (i:2) (t:n) (f:politics) (w:trial/court trial) (d:the hearing of a case in a court of law) (o:English) (r:zd:23513) (q:draft, low confidence)
Tribe = (i:1) (t:n) (f:social/politics) (w:tribe) (d:a tribe, especially as an officially recognised group in India) (s:minam) (o:English) (r:zd:24157/zd:11945) (q:draft)
trillion = (i:1) (t:num) (f:work/education) (w:trillion) (d:the number one million million, mostly of sums of money) (o:English) (r:zd:10984/zd:24955) (q:draft)
trinity = (i:1) (t:n) (f:religion) (w:Trinity) (d:the Christian teaching that God is one in three persons, in Zolai {tothum gawm khat}) (o:English) (r:zd:9239/zd:23943) (q:draft)
Tripura = (i:1) (t:name) (c:land) (f:politics/travel) (w:Tripura) (d:state in the north-east of India) (r:zd:15435/ts:3506) (q:draft)
Trolley = (i:1) (t:n) (f:travel/everyday) (w:trolley/cart) (d:a cart on wheels pushed by hand, for goods in a shop or bags at an airport) (o:English) (r:zd:19197/zd:10821) (q:draft)
Troops = (i:1) (t:n) (f:politics) (w:troops/soldiers) (d:soldiers of an army, mostly written beside or in place of <galkap>) (s:galkap) (o:English) (r:zd:11812) (q:draft, low confidence)
Trophy = (i:1) (t:n) (f:media) (w:trophy/cup) (d:a cup or other prize object given to the winner of a competition) (o:English) (r:zd:14767/zd:20179) (q:draft)
Truck = (i:1) (t:n) (f:travel/work) (w:truck/lorry) (d:a large motor vehicle that carries goods, often written before <mawtawpi>) (o:English) (r:zd:12113/zd:11579) (q:draft)
Tsunami = (i:1) (t:n) (f:nature) (w:tsunami) (d:a great sea wave that floods the coast, usually after an earthquake; also explained as {tuipi zinlin} and <tuihualpi>) (o:English) (r:zd:23784/zd:15089) (q:draft)
tu = (i:2) (t:v) (f:everyday/body) (w:sit) (r:zai:sit) (q:draft)
tu = (i:3) (t:n) (f:family) (w:grandchild) (d:the child of one's son or daughter) (r:zai:grandchild) (q:draft)
tu laitaka = (i:1) (t:adj) (f:time) (w:present/current/of this moment) (d:<tu>, in the sense this or present and not sit, and <laitaka>, at the very time: of right now; stands before a noun or a clause, the present or current one; without the linking <a> the form {tu laitak} is the adverb right now) (s:tuhun) (r:zd:20581/zd:21230) (q:draft)
tu tadih = (i:1) (t:adv) (f:time) (w:for now/for the time being/at present) (d:<tu>, in the sense this or present and not sit, and <tadih>, for now: for the time being, as things stand now; opens a clause, alone or followed by <in>) (r:zd:24573/zd:20358) (q:draft)
tu-in = (i:1) (t:adv) (f:everyday/time) (w:now) (r:zai:now) (q:draft)
tua = (i:1) (t:pron) (f:everyday) (w:that/those) (d:points to a person or thing already mentioned or known; before a noun it means that or those, and {tua ciangin} is then, after that) (a:hih) referring to a specific thing previously mentioned, known, or understood
tua ahihman = (i:1) (t:conj) (f:everyday) (w:therefore/for that reason/so) (d:<tua>, that, and <ahihman>, because it is so: opens a sentence and draws the conclusion from what was said before; it is followed by <in> written apart, {tua ahihman in}) (r:zd:23943/zd:12112) (q:draft)
tua ahihmanin = (i:1) (t:conj) (f:everyday) (w:therefore/for that reason/so) (d:<tua>, that, and <ahihmanin>, because it is so: opens a sentence and draws the conclusion from what was said before) (r:zd:21085/zd:20572) (q:draft)
tua banga = (i:1) (t:adv) (f:everyday) (w:like that/in that way/such) (d:<tua>, that, and <banga>, like: placed before a verb, in that way; before a noun, such, of that kind; it points back to what was just told) (r:zd:20942/zd:9240) (q:draft)
tua bangteng = (i:1) (t:phrase) (f:everyday) (w:all that/all such things) (d:<tua>, that, with <bangteng>, the things of that kind: all those things just described, standing as subject or object or before <tawh>, with all that, amid all that) (r:zd:21869/zd:20117/zd:14824) (q:draft)
tua hikeileh = (i:1) (t:conj) (f:everyday) (w:otherwise/or else/if not) (d:<tua>, that, and <hikeileh>, if it is not: if that is not so; stands at the head of a sentence and says what follows when the thing just named is not done) (r:zd:24276/zd:23985) (q:draft)
tua kawmkal = (i:1) (t:adv) (f:time) (w:meanwhile/in the meantime/during that) (d:<tua>, that, and <kawmkal>, interval: followed by <ah> at the head of a sentence, meanwhile, while that was going on) (r:zd:16157/zd:17067) (q:draft)
tua khitteh = (i:1) (t:conj) (f:everyday/time) (w:after that/then/afterwards) (d:<tua>, that, and <khitteh>, after: after that, then; stands at the start of a sentence and joins it to what was told before) (r:zd:16038/ts:5480) (q:draft)
tuabaanah = (i:1) (t:conj) (f:everyday) (j:tuabanah) (r:zd:22827) (q:draft)
tuaban = (i:1) (t:adv) (f:everyday) (w:besides that/in addition/moreover) (d:<tua> and <ban> written as one word and followed by <ah> or <in>: on top of that, besides that, after that) (j:tua/ban) (r:zd:17542/zd:17689/zd:15467) (q:draft)
tuabanah = (i:1) (t:conj) (f:everyday) (w:besides that/in addition/moreover) (d:<tua>, that, with <banah>, in addition to, written as one word at the head of a sentence) (j:tua/banah) (r:zd:11702/zd:11224) (q:draft)
tuabang = (i:1) (t:adv) (f:everyday) (w:like that/such/in that way) (d:<tua> and <bang> written as one word: like that, of that kind; {tuabang mah} is just the same) (j:tua/bang) (r:zd:24248/zd:18206/zd:19800) (q:draft)
tuabang tengtawh = (i:1) (t:adv) (f:everyday/media) (w:in that state/like that/with all that) (d:<tuabang>, like that, and <tengtawh>, with all of it: in that condition, things being so; opens a sentence that tells what happened next or how long the state lasted) (r:zd:21850/zd:23343) (q:draft)
tuabanga = (i:1) (t:adv) (f:everyday) (w:such/like that/in that way) (d:<tua> and <banga> written as one word: of that kind, in that way, before a noun or a verb) (j:tua/banga) (r:zd:12023/zd:17060) (q:draft)
tuabangaa = (i:1) (t:adv) (f:everyday) (w:in that way/like that/thus) (d:<tua>, <bang.2> and <aa> written as one word, at the start of a clause: in that way, that being so; <aa> here is the linking word that others write <a> or <in>) (j:tua/bang/aa) (r:zd:19166/zd:22827/zd:20627) (q:draft)
tuabangdan = (i:1) (t:det) (f:everyday) (w:such/that kind of/like that) (d:<tua>, that, <bang>, like, and <dan>, manner, written as one word: of that kind, placed before a noun or used alone for such a thing) (j:tua/bang/dan) (r:zd:19239/zd:12115/zd:21389) (q:draft)
tuabanghun = (i:1) (t:adv) (f:time) (w:at such a time/at that time) (d:<tuabang>, such, and <hun>, time, written as one word, usually followed by <ciangin> or {laitak in}: at a time like that) (j:tuabang/hun) (r:zd:24276/zd:18139) (q:draft)
tuabangin = (i:1) (t:adv) (f:everyday) (w:in that way/like that/so) (d:<tua> and <bangin> written as one word: in the way just described) (j:tua/bangin) (r:zd:20092/zd:14824) (q:draft)
tuabangmah = (i:1) (t:adv) (f:everyday) (w:just like that/in the same way/likewise) (d:<tuabang> and <mah> written as one word, mostly with <in>: in just that way, likewise) (j:tuabang/mah) (r:zd:21869/zd:13124) (q:draft)
tuabangte = (i:1) (t:pron) (f:everyday) (w:such ones/such people/such things) (d:<tua> that and <bangte> written as one word: people or things like that) (j:tua/bangte) (r:zd:19166/zd:15946) (q:draft)
tuabek = (i:1) (t:adv) (f:everyday) (w:only that/that alone) (d:<tua> and <bek> written as one word: that alone; {tuabek hilo} and <tuabek thamlo> open a sentence as not only that, moreover) (j:tua/bek) (r:zd:23972/zd:19964/zd:20545) (q:draft)
tuabek thamlo = (i:1) (t:conj) (f:everyday) (w:not only that/moreover/besides) (d:<tuabek>, that alone, and <thamlo>, not only: opens a sentence that adds a further fact to what was just said) (r:zd:13222/zd:12942) (q:draft)
tuaciang = (i:1) (t:adv) (f:everyday/time) (w:then/after that/at that point) (d:<tua> and <ciang> written as one word, mostly followed by <in>: then, when that had happened, the usual way to begin the next step of a report; {tuaciang dong} is up to that point) (j:tua/ciang) (r:zd:15920/zd:16598/zd:15067) (q:draft)
tuaciangin = (i:1) (t:conj) (f:everyday/time) (w:then/after that/and then) (d:<tua> and <ciangin> written as one word: after that, then; it opens a sentence that tells what happened next) (j:tua/ciangin) (r:zd:20755/zd:24276/zd:21015) (q:draft)
tuadan = (i:1) (t:adv) (f:everyday) (w:like that/that way/such) (d:<tua> and <dan> written as one word: in that way, in that manner; before a noun, that kind of) (j:tua/dan) (r:zd:18206/zd:17599/zd:20834) (q:draft)
tuagam = (i:1) (t:n) (f:social/travel) (w:that country) (d:<tua> and <gam> written as one word: that country, those countries with <te>) (j:tua/gam) (r:zd:25319/zd:17309) (q:draft)
tuahang = (i:1) (t:conj) (f:everyday) (w:therefore/because of that/for that reason) (d:<tua> and <hang> written as one word, that reason; it begins a sentence, mostly as {tuahang in}, because of that) (j:tua/hang) (r:zd:15928/zd:20663/zd:14770) (q:draft)
tuahangin = (i:1) (t:conj) (f:everyday) (w:because of that/therefore/for that reason) (d:<tua>, that, and <hangin>, because of, written as one word at the start of a sentence: because of that) (s:tuahang) (j:tua/hangin) (r:zd:21092/zd:13076) (q:draft)
tuahciangin = (i:1) (t:v) (f:everyday) (w:when meeting with/when encountering) (d:<tuah>, meet with, and <ciangin>, when, written as one word: when one meets with something, mostly trouble) (j:tuah/ciangin) (r:zd:21529/zd:23443) (q:draft)
tuahding = (i:1) (t:v) (f:everyday) (w:will meet/to be placed/to meet with) (d:<tuah> and <ding> written as one word: will meet, or will meet with a sentence of law; of an office or a court hearing, to be set in a place) (j:tuah/ding) (r:zd:19435/zd:14507) (q:draft, low confidence)
tuahi = (i:1) (t:conj) (f:everyday) (w:therefore/that being so/so) (d:<tua>, that, and <hi>, be, written as one word and followed by <a> or <in>: that being so, opening a sentence that draws a conclusion; {tuahi leh} is if so) (j:tua/hi) (r:zd:17822/zd:24420/zd:19556) (q:draft)
tuahiaa = (i:1) (t:conj) (f:everyday) (w:therefore/so) (d:<tua>, <hi> and <a> written as one word at the head of a sentence, that being so: therefore) (j:tua/hi/a) (r:zd:20896/zd:23888) (q:draft)
tuahileh = (i:1) (t:conj) (f:everyday) (w:then/in that case/if so) (d:<tua>, that, with <hileh>, if it is, written as one word: if that is so, then; opens a sentence that tells what follows) (j:tua/hileh) (r:zd:14826/zd:20657/zd:22740) (q:draft)
tuahkhak thu = (i:1) (t:n) (f:everyday) (w:experience/what one has met with) (d:<tuahkhak>, happen to meet, and <thu>, matter: a thing that has happened to someone, an experience; the one who had it stands before, as in {ka tuahkhak thu}, my experience) (r:zd:20264/zd:16148/zd:23901) (q:draft)
tuahkhakna = (i:1) (t:n) (f:everyday/social) (w:experience/encounter) (d:<tuahkhak>, meet with, with the noun suffix <na>: what a person has gone through, experience of life) (b:tuahkhak) (r:zd:25148/zd:21083) (q:draft)
tuahkhia = (i:1) (t:v) (f:everyday/travel) (w:take out/move out/evacuate/carry off) (d:<tuah> and <khia> written as one word: carry or move a person or thing out of a place to another, as the sick out of a burning building; {ki tuahkhia} is be moved out or transferred) (j:tuah/khia) (r:zd:18157/zd:15674) (q:draft, low confidence)
tuahphatna = (i:1) (t:n) (f:everyday/religion) (w:good fortune/prosperity/blessing) (d:<tuahphat> with the noun ending {-na}: meeting with good, the opposite of misfortune) (b:tuahphat) (r:zd:23551/zd:24224) (q:draft)
tuahsawm = (i:1) (t:v) (f:everyday/politics) (w:plan to place/intend to put) (d:<tuah> and <sawm>, intend, written as one word: plan to place or settle people somewhere; in headlines {inntungpan tuahsawm} is said of someone who tries to throw herself from a house top) (j:tuah/sawm) (r:zd:11058) (q:draft, low confidence)
tuahsia = (i:3) (t:v) (f:travel/media) (w:crash/have an accident) (d:of a car, bus, train or other vehicle, have an accident; in headlines also as a noun after the vehicle, <mawtaw tuahsia>, a car accident) (r:zd:16063/zd:15947/zd:13341) (q:draft)
tuahsiatna = (i:2) (t:n) (f:travel/media) (w:accident/crash) (d:in news, one sudden event in which a vehicle is wrecked or people are hurt, named after the vehicle as in <mawtaw tuahsiatna>, a road accident, and <vanleng tuahsiatna>, a plane crash; not misfortune in general) (s:Accident) (r:zd:19979/zd:15368/zd:17777) (q:draft)
tuahun laitak = (i:1) (t:adv) (f:time) (w:at that very moment/just then/at the time) (d:<tuahun>, at that time, and <laitak>, at the very time: followed by <in>, opens a sentence that tells what was going on at the moment of the event just told) (r:zd:14726/zd:11345) (q:draft)
tuahunlai = (i:1) (t:adv) (f:time) (w:at that time/then/in those days) (d:<tuahun>, that time, and <lai>, while, written as one word: at that time in the past, usually followed by <in>) (s:tuahun) (j:tuahun/lai) (r:zd:16713/zd:12057) (q:draft)
tuahunsung = (i:1) (t:adv) (f:time) (w:during that time/in that period/meanwhile) (d:<tua> and <hunsung> written as one word: within that time) (j:tua/hunsung) (r:zd:13211/zd:15463) (q:draft)
tuailai = (i:1) (t:n) (f:social/family) (w:youth/young people) (d:the young people of a community, often paired with <khangno> or <khangthak>; a word of the northern Zo dialects used also in Zolai writing) (r:zd:24452/zd:20148) (q:draft)
tuaituai = (i:1) (t:adv) (f:everyday) (w:on and on/continuously) (d:placed after a verb: the action goes on and on without settling, as in {leng tuaituai}, keep flying, and {kisam tuaituai}, be called again and again) (r:zd:20317/zd:25572) (q:draft, low confidence)
tuakawm = (i:1) (t:conj) (f:everyday) (w:meanwhile/at the same time) (d:<tua>, that, and <kawm>, while, written as one word, mostly followed by <in>: while doing that, at the same time as that) (j:tua/kawm) (r:zd:15274/zd:19335) (q:draft)
tuakawmkal = (i:1) (t:adv) (f:time) (j:tua kawmkal) (r:zd:18303/zd:19695) (q:draft)
tuakding = (i:1) (t:v) (f:everyday/politics) (w:will meet with/will undergo/will suffer) (d:<tuak>, meet with, and <ding>, will, written as one word: will meet with or undergo punishment, hardship or the like) (j:tuak/ding) (r:zd:19976/zd:15080) (q:draft)
tuakhit = (i:1) (t:adv) (f:everyday/time) (w:after that/then) (d:<tua> and <khit> written as one word, mostly as {tuakhit ciangin}: after that) (j:tua/khit) (r:zd:18125/zd:15170) (q:draft)
tuakhitciang = (i:1) (t:conj) (f:everyday/time) (w:after that/then/afterwards) (d:<tua>, that, with <khit> and <ciang>, after, written as one word: after that, then; also followed by <in>) (j:tua/khit/ciang) (r:zd:19351/zd:11904) (q:draft)
tuakhitciangin = (i:1) (t:adv) (f:time) (w:after that/afterwards/then) (d:<tua>, <khit> and <ciangin> written as one word: after that, next) (j:tua/khit/ciangin) (r:zd:11757/zd:11447) (q:draft)
tuakhitzawh = (i:1) (t:adv) (f:time/media) (w:after that/afterwards/then) (d:<tua>, that, and <khitzawh>, after, written as one word, mostly at the start of a sentence: after that) (s:tuazawh) (j:tua/khitzawh) (r:zd:20738/zd:19962) (q:draft)
tuakhua = (i:1) (t:phrase) (f:travel/everyday) (w:that town/that village) (d:<tua> and <khua> written as one word: that town or village, the one just spoken of) (j:tua/khua) (r:zd:17733/zd:25221) (q:draft)
tuakkhak = (i:1) (t:v) (f:everyday) (w:meet with/experience/encounter) (d:<tuak>, meet with, and <khak>, happen to, written as one word: what one happens to meet in life; {tuakkhak thu} is an experience) (j:tuak/khak) (r:zd:17295/zd:21130) (q:draft)
tuakkhia = (i:2) (t:v) (f:everyday) (w:jump off/jump down/leap out) (d:throw oneself down from a high place such as a housetop or a bridge, with <tungpan> before it; not the ordinary getting out of a vehicle) (r:zd:20555/zd:17945) (q:draft, low confidence)
tuakngei = (i:1) (t:v) (f:everyday) (w:have experienced/have met with) (d:<tuak>, meet with, and <ngei>, ever, written as one word: have experienced something at some time) (j:tuak/ngei) (r:zd:20736/zd:20627) (q:draft)
tuakte = (i:1) (t:n) (f:everyday) (w:those who meet with/those who suffer) (d:<tuak>, meet with, and the plural <te> written as one word: the people who meet with or suffer something, or the things that are met with; {sihna tuakte} are those who died) (j:tuak/te) (r:zd:9430/zd:11046) (q:draft)
tuakte = (i:2) (t:n) (f:everyday) (w:things that ought to be done) (d:<tuak>, be fitting, and the plural <te> written as one word after a verb: the things that it is right to do; {sep tuakte} are the things one ought to do) (j:tuak/te) (r:zd:22371/zd:16500) (q:draft)
tuakthei = (i:1) (t:v) (f:everyday/politics) (w:can incur/be liable to/may meet with) (d:<tuak>, meet with, and <thei>, can, written as one word: may meet with or receive something, as a fine or a lawsuit) (j:tuak/thei) (r:zd:12482/zd:14768) (q:draft)
tuakuam = (i:1) (t:phrase) (f:travel/media) (w:that area/that district) (d:<tua>, that, and <kuam> written as one word; in the articles <kuam> is an area or district of a town or country, not only a valley: that area, the area just named) (j:tua/kuam) (r:zd:21474/zd:19172/zd:20335) (q:draft)
tuakuamsung = (i:1) (t:n) (f:travel/everyday) (w:that area/that neighbourhood) (d:<tua> and <kuamsung> written as one word: that area or district, the surroundings of the place just named) (j:tua/kuamsung) (r:zd:21474/zd:15537) (q:draft)
tualai = (i:1) (t:adv) (f:time) (w:at that time/then/in those days) (d:<tua>, that, with <lai>, time, written as one word, often followed by <in>: at the time spoken of) (r:zd:24231/zd:19581) (q:draft)
tualai ah = (i:1) (t:adv) (f:everyday/media) (w:there/at that place/on that occasion) (d:<tualai>, that place or time, and the place marker <ah>: at the place or event just spoken of; it opens a sentence that tells what happened there) (r:zd:25203/zd:11827) (q:draft, low confidence)
tualaitak = (i:1) (t:adv) (f:time) (w:at that very time/just then/at that moment) (d:<tua> and <laitak> written as one word: at the very time just spoken of) (j:tua/laitak) (r:zd:15368/zd:16490/zd:15125) (q:draft)
tualak = (i:1) (t:adv) (f:everyday) (w:among them/among those) (d:<tua>, that, with <lak>, midst, written as one word and followed by <ah> or <panin>: among them, from among them) (j:tua/lak) (r:zd:15305/zd:17107/zd:22821) (q:draft)
tualakah = (i:1) (t:adv) (f:everyday) (w:among them/among those) (d:<tua>, that, and <lakah>, among, written as one word: among them, of those just mentioned) (j:tua/lakah) (r:zd:19906/zd:23727) (q:draft)
tualam = (i:1) (t:n) (f:travel/everyday) (w:that direction/that way/that side) (d:<tua> and <lam> written as one word: that direction or side, there; {tualam ah} is that way, toward it) (j:tua/lam) (r:zd:25346/zd:21221) (q:draft)
tualbiakna = (i:1) (t:n) (f:religion/social) (w:village sacrifice/communal worship) (d:<tual>, the open communal ground of a village, with <biakna>, worship: the traditional sacrifice of a whole village to ask for rain and a good harvest, and the place where it is held) (r:ts:479) (q:draft)
tualbial = (i:1) (t:v) (f:social/everyday) (w:roam about/be active in/frequent) (d:move about and be busy in a place or an activity, making it one's ground) (r:zd:8667/zd:11600) (q:draft, low confidence)
tualbual = (i:1) (t:v) (f:everyday) (w:plunge into/be immersed in/wallow in) (d:be deep in something or throw oneself into it, a work or a ruin; meaning taken from two sentences only) (r:zd:21100/zd:22815) (q:draft, low confidence)
tuale = (i:1) (t:conj) (f:everyday) (w:and then/moreover/and yet) (d:<tua>, that, with <le>, and, written as one word at the head of a sentence or clause: and with that, then, moreover) (j:tua/le) (r:zd:25808/zd:23298) (q:draft, low confidence)
tualeh = (i:1) (t:conj) (f:everyday) (w:and/and then/moreover) (d:<tua> and <leh> written as one word, at the start of a sentence: and, and then, in that case) (j:tua/leh) (r:zd:21502/zd:19603/zd:14720) (q:draft)
tualgal = (i:1) (t:n) (f:politics) (w:civil war/internal conflict) (d:<tual>, local, with <gal>, war: war inside one country or among one's own people) (r:zd:19662/zd:18142/zd:24743) (q:draft)
tualian = (i:1) (t:adv) (f:time) (w:just then/at that very moment) (d:<tua>, that, with <lian>, exactly, written as one word: just then, at that very point; often as {tualian laitak in}, at that very moment) (j:tua/lian) (r:zd:19300/zd:15562) (q:draft)
tualmi = (i:1) (t:n) (f:social/politics) (w:native/local person/indigenous people) (d:<tual>, native, with <mi>, person: one who belongs to the place, set against <khualmi>, a stranger; {tualmi nam} is an indigenous people of a country) (s:tualsuak) (a:khualmi) (r:zd:22827/zd:15553) (q:draft)
tualniam = (i:1) (t:adj) (f:social) (w:lowly/base/degraded/despised) (d:low in standing or in character, looked down on by others; {tualniam lungsim} is a base mind) (r:ts:9859/zd:21044/zd:22757) (q:draft)
tualniamna = (i:1) (t:n) (f:social) (w:backwardness/lowliness/low standing) (d:the state of being low or behind others in standing, knowledge or mind; {lungsim tualniamna} is lowness of mind) (b:tualniam) (r:zd:17021/zd:15784) (q:draft)
tualniamte = (i:1) (t:n) (f:social) (w:lowly people/base people) (d:<tualniam>, lowly or base, with the plural ending <te>: people of low standing or of base character) (b:tualniam) (r:zd:22757/zd:17021) (q:draft)
tualnuam = (i:1) (t:n) (f:religion/social) (w:pleasant land/fair home) (d:poetic word, <tual>, open ground of a village, with <nuam>, pleasant: a pleasant dwelling place; in songs and words of mourning it stands for heaven, as in {thangvan tualnuam}, or for a home town) (r:zd:24462/zd:19866) (q:draft, low confidence)
tualo = (i:1) (t:adv) (f:everyday) (w:besides that/apart from that/otherwise) (d:<tua> and <lo> written as one word at the start of a clause: other than that, in addition; {tualo teng} and {tualo te} are the others, the rest) (j:tua/lo) (r:zd:15743/zd:11214) (q:draft)
tualpi = (i:3) (t:n) (f:everyday/travel) (w:field/ground/playing field/airfield) (d:a large level ground laid out for one use, named by the word before it: {kimawlna tualpi} or {bawlung tualpi} is a playing field or football ground, {vanleng tualpi} is an airport) (r:zd:22658/zd:17463/zd:12309) (q:draft)
tualsang = (i:1) (t:adj) (f:social) (w:advanced/high in standing/civilised) (d:high in standing or level, said of people and of a state of life; the opposite of <tualniam>) (a:tualniam) (r:ts:9859) (q:draft, low confidence)
tualsuak = (i:2) (t:adj) (f:social/politics) (w:indigenous/native/local) (d:placed before a noun: belonging to the land and its own people, not brought in from outside; {tualsuak minamte} is indigenous peoples, {tualsuak lai} the native script and {tualsuak party} a local party of the people) (r:zd:16686/zd:22789/zd:16192) (q:draft)
tualsuakmi = (i:1) (t:n) (f:social/politics) (w:native/indigenous person/native-born person) (d:<tualsuak>, native-born, with <mi>, person, written as one word: a person born in the place, and the indigenous people of a land) (j:tualsuak/mi) (r:zd:21288) (q:draft)
tualsung = (i:2) (t:n) (f:social) (w:community/society/locality) (d:the home community itself as a noun, not a describing word before <mi>: the society people live in together, often set beside <mimal>, the individual) (r:zd:24604/zd:25177/zd:25275) (q:draft)
tualthahna = (i:1) (t:n) (f:politics/social) (w:murder/killing/massacre) (d:the killing of people of one's own community or of people who are not enemies in war; of a whole people, massacre or genocide) (r:zd:16254/zd:20667) (q:draft)
tualthat = (i:1) (t:n) (f:politics/social) (w:murderer/murder/homicide) (d:one who kills a person of his own community, a murderer; also the act itself; often paired with <mithat>) (s:mithat) (r:zd:24221/zd:24115) (q:draft)
tualvak = (i:1) (t:adj) (f:travel/work) (w:itinerant/roving/wandering) (d:<tual>, local ground, with <vak>, walk about: going about from place to place, said of people who offer a service in the villages) (r:zd:15182) (q:draft, low confidence)
tuam = (i:2) (t:adj) (f:everyday) (w:different/separate/apart) (d:separate from the others or different from them: {a tuam} is separately, {tuam om} is live apart, {nu tuam} is of a different mother) (s:tuamdang) (a:kibang) (q:draft)
tuam = (i:3) (t:adv) (f:everyday) (w:all the more/the more for it) (d:placed after a verb or describing word: more so as a result of what was just said, as in {dam tuam}, be the healthier for it, and {ol tuam}, be the easier for it; not the {tuam} of being different) (r:zd:19408/zd:22496/zd:17675) (q:draft)
tuam vilvel = (i:1) (t:adv) (f:everyday) (w:specially/quite separately/distinctly) (d:<tuam>, separate, with the expressive word <vilvel>, which strengthens it: wholly apart from the rest, in a special way of its own; used as {a tuam vilvel in} or {a tuam vilvel a} before a verb, or as {a tuam vilvel} before a noun) (r:zd:9124/zd:20814/ts:3508) (q:draft)
tuama = (i:1) (t:adv) (f:time) (w:before that/previously/earlier) (d:<tua> and <ma> written as one word, mostly followed by <in>: before that, up to then) (j:tua/ma) (r:zd:15501/zd:24574) (q:draft)
tuama = (i:2) (t:adv) (f:everyday) (w:separately/apart) (d:<tuam>, separate, with the ending <a>, written as one word and mostly after <a>: {a tuama}, separately, apart from the rest) (j:tuam/a) (r:zd:25139) (q:draft, low confidence)
tuamahbangin = (i:1) (t:adv) (f:everyday) (w:likewise/in the same way/similarly) (d:<tuamah> and <bangin> written as one word, at the start of a sentence: in that same way, likewise) (j:tuamah/bangin) (r:zd:21097/zd:22116/zd:23343) (q:draft)
tuaman = (i:1) (t:conj) (f:everyday) (w:therefore/because of that/for that reason) (d:<tua> and the first part of <manin> written as one word, with <in> written apart: because of that; it begins a sentence that gives the result) (s:tuahang/tuahangin) (j:tua/man) (r:zd:16951/zd:22707) (q:draft)
tuamanin = (i:1) (t:conj) (f:everyday) (w:therefore/so/because of that) (d:<tua> and <manin> written as one word at the head of a sentence: because of that, therefore) (j:tua/manin) (r:zd:23386/zd:13076) (q:draft)
tuambawl = (i:1) (t:v) (f:social/everyday) (w:treat differently/set apart/make separately) (d:<tuam>, different or separate, and <bawl>, make, written as one word: treat a person differently from others, or make a thing as a separate one) (j:tuam/bawl) (r:zd:16752/zd:11778) (q:draft, low confidence)
tuamciat = (i:1) (t:adj) (f:everyday/social) (w:each different/each separate/each its own) (d:<tuam>, different, with <ciat>, each, written as one word: different for each one, each having its own) (j:tuam/ciat) (r:zd:11648/zd:20999) (q:draft)
tuamdiak = (i:1) (t:adj) (f:everyday) (w:special/unusual/exceptional/especially different) (d:<tuam>, different, and <diak>, especially, written as one word: out of the ordinary, unlike the usual; with <in> it is an adverb, in a special way) (j:tuam/diak) (r:zd:11371/zd:14852/zd:11872) (q:draft)
tuamding = (i:1) (t:v) (f:everyday/health) (w:should cover/to wrap) (d:<tuam>, cover or wrap, and <ding>, written as one word: must cover, is to be wrapped) (j:tuam/ding) (r:zd:21306/zd:12654) (q:draft)
tuamding = (i:2) (t:part) (f:everyday) (w:will all the more/will be the better for it) (d:<tuam>, here placed after a verb for the more so as a result, and <ding>, will, written as one word: will do or be so all the more because of what was said before) (j:tuam/ding) (r:zd:20239/zd:19340) (q:draft)
tuamlo = (i:1) (t:adv) (f:everyday) (w:not particularly/not at all) (d:<tuam> and <lo>, not, written as one word after a verb: not in particular, not any the more, as in {om tuamlo}, there is none in particular; compare <tuan>) (j:tuam/lo) (r:zd:22649/zd:22415) (q:draft, low confidence)
tuamlo = (i:2) (t:v) (f:home/body) (w:not cover) (d:<tuam>, cover, and <lo>, not, written as one word: not cover, said of a woman who does not cover her head) (j:tuam/lo) (r:zd:12654) (q:draft)
tuamna = (i:3) (t:n) (f:everyday/work) (w:benefit/advantage/gain) (d:in {phat tuamna}, the spaced spelling of <phattuamna>: the good or gain that comes from something, as {mipiphat tuamna}, the public benefit; not a covering) (s:phattuamna) (r:zd:24609/zd:22282/zd:19990) (q:draft)
tuampah = (i:1) (t:adv) (f:everyday) (w:all the more/noticeably/at once) (d:<tuam> and <pah> written as one word after a verb or describing word: the state comes about markedly and at once, as in {nuam tuampah}, become all the more pleasant) (j:tuam/pah) (r:zd:23554/zd:8668) (q:draft, low confidence)
tuamtaum = (i:1) (t:n) (f:everyday) (j:tuamtuam) (r:zd:21257/zd:22707) (q:draft, low confidence)
tuamtek = (i:1) (t:adj) (f:everyday) (w:each different/separate) (d:<tuam> and <tek> written as one word: each one different, each its own) (j:tuam/tek) (r:zd:22709/ts:12519/zd:20549) (q:draft)
tuamtuampan = (i:1) (t:adv) (f:everyday/media) (w:from various) (d:<tuamtuam> and <pan> written as one word after a noun: from various ones, as {media tuamtuampan}, from various media) (j:tuamtuam/pan) (r:zd:18154/zd:14836) (q:draft)
tuamtuamtawh = (i:1) (t:adv) (f:everyday) (w:with various/by various) (d:<tuamtuam> and <tawh> written as one word: with, by or because of various things of the kind named before it) (j:tuamtuam/tawh) (r:zd:17841/zd:21649/zd:14869) (q:draft)
tuamtuamzong = (i:1) (t:adj) (f:everyday) (w:various also/of many kinds too) (d:<tuamtuam> various and <zong> also, written as one word after a noun: different kinds of it as well) (j:tuamtuam/zong) (r:zd:19565/zd:19872/zd:14965) (q:draft)
tuamun = (i:1) (t:n) (f:everyday/travel) (w:that place/there) (d:<tua> and <mun> written as one word: that place, the place just spoken of) (j:tua/mun) (r:zd:17374/zd:15848/zd:19786) (q:draft)
tuanding = (i:1) (t:v) (f:travel) (w:to ride/to board/to travel by) (d:<tuan>, ride, and <ding> written as one word: going to ride in a vehicle, in order to travel by car, bus, train or plane) (j:tuan/ding) (r:zd:13276/zd:12891) (q:draft)
tuanding = (i:2) (t:part) (f:everyday) (w:would then/after all) (d:the particle <tuan>, even so, and <ding> written as one word at the end of a question: what would there be then, would it be any different) (j:tuan/ding) (r:zd:11980) (q:draft, low confidence)
tuangding = (i:1) (t:v) (f:travel) (w:will ride/about to board) (d:<tuang> and <ding> written as one word: will ride, going to travel by a vehicle; before a noun, who is about to board) (j:tuang/ding) (r:zd:14555/zd:15307/zd:14557) (q:draft)
tuangdung = (i:1) (t:n) (f:home) (w:floor platform/house floor) (d:part of the traditional house named with the veranda and the shelves, apparently the planked floor or raised platform of the main room; also the name of a village, written {Tuangdung}) (r:zd:22784/zd:11110) (q:draft, low confidence)
tuangkhawm = (i:1) (t:v) (f:travel) (w:ride together/travel together) (d:<tuang> and <khawm> written as one word: ride on the same vehicle, boat or animal together) (j:tuang/khawm) (r:zd:11649/zd:15790/zd:16757) (q:draft)
tuanglam = (i:1) (t:n) (f:travel) (w:way/path/road) (d:poetic word for the road or the path one follows, used in songs and poems, also of the course of a life) (r:zd:20103/zd:17437) (q:draft)
tuanglo = (i:1) (t:v) (f:travel) (w:not ride/not board) (d:<tuang>, ride, and <lo>, not, written as one word: not get on or travel in a vehicle, a boat or on a horse) (j:tuang/lo) (r:zd:15474/zd:21929/ts:3168) (q:draft)
tuangsak = (i:2) (t:v) (f:media) (w:put on/print on/post/publish) (d:put a picture or a text on something for people to see: a portrait on money after <tungah>, a picture on a web page, or words on Twitter after <ah>; nobody rides) (r:zd:15956/zd:19949/zd:11005) (q:draft)
tuangthei = (i:1) (t:v) (f:travel) (w:can ride/can travel/can carry) (d:<tuang>, ride, and <thei>, able, written as one word: be able to ride in a vehicle, or of a vehicle, be able to carry so many people) (j:tuang/thei) (r:zd:11308/zd:13348) (q:draft)
tuangtheiding = (i:1) (t:v) (f:travel) (w:will be able to ride/can ride) (d:<tuang> and <theiding> written as one word: will be able to ride, and of a vehicle, so many people can ride in it) (j:tuang/theiding) (r:zd:16515/zd:15617) (q:draft)
tuankawm = (i:1) (t:v) (f:travel) (w:while riding) (d:<tuan>, form of <tuang>, ride, and <kawm>, while, written as one word, usually followed by <in>: while riding on a motorcycle, in a car or on a train) (j:tuan/kawm) (r:zd:11571/zd:21876) (q:draft)
tuankei = (i:1) (t:part) (f:everyday) (w:not for all that/not anyway) (d:<tuan> and the negative <kei>, written as one word after a verb: not so in spite of what was done or said, still not, not any the more) (j:tuan/kei) (r:zd:13181/zd:10973/zd:20481) (q:draft)
tuanlo = (i:1) (t:adv) (f:everyday) (w:not for all that/not either/not necessarily) (d:<tuan> and <lo> written as one word after a verb: not so in spite of what was said or expected) (j:tuan/lo) (r:zd:8667/zd:21911/zd:18952) (q:draft, low confidence)
tuanloh = (i:1) (t:adv) (f:everyday) (w:not for all that/not either) (d:<tuan> and <loh> written as one word after a verb: not so in spite of that; the form of <tuanlo> used before <ciangin>, <banah> and similar words) (j:tuan/loh) (r:zd:19166/zd:12112) (q:draft)
tuanman = (i:1) (t:n) (f:travel) (w:fare/ticket price) (d:<tuan>, ride, with <man>, price: the money paid to ride a bus, a train or a boat) (r:zd:16421/zd:14633) (q:draft)
tuanphei = (i:1) (t:v) (f:everyday/body) (w:kick sideways/kick/shove with the foot) (d:thrust the foot out sideways against a person or thing, said with <akhetawh>, with the foot) (r:zd:16731/zd:19465) (q:draft, low confidence)
tuanpih = (i:1) (t:v) (f:travel) (w:ride with/take along) (d:<tuan>, the form of <tuang>, ride, with <pih>, together with: ride in a vehicle together with someone, or take someone along in it) (j:tuan/pih) (r:zd:18292/zd:19536) (q:draft)
tuansak = (i:1) (t:v) (f:everyday) (w:put on/place upon/set over) (d:<tuan>, form of <tuang>, ride, be on top, and the causative <sak> written as one word: make something be on or above another thing, as an image on money or one matter above another) (j:tuan/sak) (r:zd:20950/zd:15956) (q:draft, low confidence)
tuantual = (i:1) (t:v) (f:social/politics) (w:lag behind/fall behind/be backward) (d:be behind others in progress or development, said of a people, a country or a pupil) (r:zd:24230/zd:20018/zd:18086) (q:draft)
tuap = (i:1) (t:n) (f:body/health) (w:lung/lungs) (d:the organ of breathing in the chest; {tuap natna} is a disease of the lungs) (r:zd:21388/zd:24276/zd:20841) (q:draft)
tuapan = (i:1) (t:adv) (f:everyday/time) (w:from there/from that/after that) (d:<tua>, that, with <pan>, from, written as one word, often followed by <in>: from that place, from that time on, as a result of that) (j:tua/pan) (r:zd:20806/zd:12271/zd:17009) (q:draft)
tuapanin = (i:1) (t:adv) (f:everyday) (w:from there/after that/then) (d:<tua>, that, and <panin>, from, written as one word: from that place, from that point or amount, after that) (j:tua/panin) (r:zd:17605/zd:19569/zd:17572) (q:draft)
tuapapen = (i:1) (t:pron) (f:everyday) (w:that man/he) (d:<tuapa> that man and the topic marker <pen> written as one word: as for that man, he) (j:tuapa/pen) (r:zd:15759/zd:16786/zd:11060) (q:draft)
tuapen = (i:1) (t:pron) (f:everyday) (w:that/that one) (d:<tua> and <pen> written as one word: that, as the topic of the sentence; it takes up what was just said, that is) (j:tua/pen) (r:zd:21075/zd:12341/zd:25919) (q:draft)
tuaphual = (i:1) (t:n) (f:everyday/media) (w:that place/the scene/the spot) (d:<tua>, that, and <phual>, place, written as one word: the place where the thing just told happened; {tuaphual panin} is from the scene) (j:tua/phual) (r:zd:17023/zd:19562) (q:draft)
tuapi = (i:1) (t:adv) (f:everyday) (w:just like that/as it is/in that state) (d:<tua>, that, with the ending {-pi}, along with: in that very condition, without changing anything; often {tuapi mah} or {tuapi tawh}) (r:zd:19790/zd:12477) (q:draft, low confidence)
tuapsung = (i:1) (t:n) (f:body/health) (w:lungs/inside of the lungs) (d:the lungs, the inside of the chest where the breath goes, from <tuap>, lung, with <sung>, inside; {tuapsung natna} is disease of the lungs) (r:zd:20778/zd:23906/zd:13112) (q:draft)
tuasan = (i:1) (t:adv) (f:everyday/travel) (w:there/in that place) (d:<tua>, that, with <san>, place; used in {tuasan takah}, in that very place, there) (b:tua) (r:43.5.5) (q:draft)
tuasang = (i:1) (t:adv) (f:everyday) (w:than that/more than that) (d:<tua>, that, with the comparative word <sangin> shortened, written as one word, with or without <in>: compared with that, more than that; {tuasang in thupi zaw} is more important than that) (b:tua) (r:zd:25924/zd:22638/zd:25919) (q:draft)
tuasangin = (i:1) (t:adv) (f:everyday) (w:more than that/rather than that) (d:<tua> and <sangin> written as one word: than that, usually with <zaw> on the following word, or rather than that) (j:tua/sangin) (r:zd:21876/zd:17202/zd:15292) (q:draft)
tuasum = (i:1) (t:n) (f:work) (w:that money) (d:<tua> and <sum> written as one word: that money, the money just mentioned) (j:tua/sum) (r:zd:19863/zd:12327) (q:draft)
tuasung = (i:1) (t:adv) (f:everyday) (w:in that/among them/in it) (d:<tua> and <sung> written as one word: inside that, among those just mentioned; {tuasung ah} is in it and {tuasung pan} is from among them) (j:tua/sung) (r:zd:16796/zd:22293/zd:14665) (q:draft)
tuasungah = (i:1) (t:adv) (f:everyday) (w:in it/in there/therein/among them) (d:<tua>, that, and <sungah>, inside, written as one word: in that, inside it, among those just mentioned) (j:tua/sungah) (r:zd:17297/zd:19754/zd:19520) (q:draft)
tuasungteng = (i:1) (t:adv) (f:everyday/travel) (w:in that whole area/all around there/within it) (d:<tua>, that, with <sungteng>, the whole inside of, written as one word: the whole of that place or area just mentioned; {tuasungteng mahah} is right there in that same area) (j:tua/sungteng) (r:zd:10821/zd:15592) (q:draft)
tuat = (i:2) (t:v) (f:everyday) (w:consider/regard/suppose/think) (d:hold something to be so, without any counting; after <bangin> it is regard as, and after <dingin> or <in>, as {ka tuat hi}, it is suppose that) (r:zd:24491/zd:17154/zd:25340) (q:draft)
tuatawh = (i:1) (t:adv) (f:everyday) (w:with that/thereby/then) (d:<tua> and <tawh> written as one word: with that, by that, following on that; {tuatawh kizui in} is in accordance with that) (j:tua/tawh) (r:zd:16331/zd:15619) (q:draft)
tuateh = (i:1) (t:conj) (f:everyday) (w:and so/then/in that case) (d:<tua>, that, and the particle <teh> written as one word at the head of a clause: that being so, and then) (j:tua/teh) (r:zd:14910/zd:17335) (q:draft, low confidence)
tuatepen = (i:1) (t:pron) (f:everyday) (w:those/they) (d:<tuate>, those, and the topic marker <pen> written as one word: as for those, they) (j:tuate/pen) (r:zd:17794/zd:19927/zd:25924) (q:draft)
tuatetawh = (i:1) (t:phrase) (f:everyday) (w:with those/with them) (d:<tuate>, those, and <tawh>, with, written as one word: together with those people or things, or by means of them) (j:tuate/tawh) (r:zd:20734/zd:23984) (q:draft)
tuatezong = (i:1) (t:pron) (f:everyday) (w:they too/those also) (d:<tuate>, those, and <zong>, also, written as one word: those too, they as well) (j:tuate/zong) (r:zd:17094/zd:15243/zd:19860) (q:draft)
tuathu = (i:1) (t:n) (f:everyday) (w:that matter/that event) (d:<tua>, that, and <thu>, matter, written as one word: the matter or event just spoken of) (j:tua/thu) (r:zd:21876/zd:11880/zd:14660) (q:draft)
tuatsak = (i:1) (t:v) (f:work/everyday) (w:calculate for/work out/estimate) (d:<tuat>, calculate, and <sak> written as one word: work out a number or a cost, often for someone) (j:tuat/sak) (r:zd:25287/zd:21458) (q:draft)
tuatung = (i:1) (t:adv) (f:everyday) (w:on it/on that/up there) (d:<tua>, that, and <tung>, top, written as one word: on top of the thing just named; {tuatung panin} is from up there, {tuatung ah} is on it) (j:tua/tung) (r:zd:17023/zd:17141) (q:draft)
tuatung = (i:2) (t:adv) (f:time) (w:that time/on that occasion) (d:<tua>, that, with <tung>, time or occasion, written as one word: that time, of an event just named) (j:tua/tung) (r:zd:15368) (q:draft, low confidence)
tuatungtawn = (i:1) (t:adv) (f:everyday) (w:through that/by that means/from there) (d:<tua> and <tungtawn> written as one word: through that, by means of that, and so as a result of it; usually followed by <in>) (j:tua/tungtawn) (r:zd:20132/zd:11308/zd:20363) (q:draft)
tuavai = (i:1) (t:n) (f:everyday/media) (w:that matter/that affair) (d:<tua> and <vai> written as one word: that matter, the affair just spoken of; {tuavai tawh kisai in} is concerning that matter) (j:tua/vai) (r:zd:14770/zd:18144) (q:draft)
tuavaiteng = (i:1) (t:n) (f:everyday/media) (w:all those matters/all of that) (d:<tuavai>, that matter, with an added word for all, written as one word: all the matters just spoken of; {tuavaiteng hangin} is because of all this) (b:tuavai) (r:zd:21476/zd:18191) (q:draft)
tuavengsung = (i:1) (t:phrase) (f:social/travel) (w:that neighbourhood/that area) (d:<tua> and <vengsung> written as one word: that neighbourhood, the area just spoken of) (j:tua/vengsung) (r:zd:14545/zd:11240) (q:draft)
tuazahpi = (i:1) (t:adv) (f:everyday) (w:that much/so much/to such a degree) (d:<tua>, that, and <zahpi>, so great an amount, written as one word; with <in> and a negative: not all that much) (j:tua/zahpi) (r:zd:17572/zd:22662) (q:draft)
tuazahzah = (i:1) (t:det) (f:everyday) (w:that many/that much/so many) (d:<tua> and <zahzah> written as one word: as many or as much as that, so great an amount or height) (j:tua/zahzah) (r:zd:14635/zd:23144/zd:12976) (q:draft)
tuazawh asawtlo = (i:1) (t:adv) (f:time/media) (w:soon afterwards/shortly after/not long after that) (d:<tuazawh>, after that, with <asawtlo>, not long: opens a sentence and is followed by <in>, shortly after what was just told) (r:zd:22167/zd:20193) (q:draft)
tuazom = (i:1) (t:adv) (f:everyday) (w:next/after that/second to that) (d:<tua>, that, and <zom>, the one that comes next, written as one word and followed by <ah>: next after that in order or rank) (j:tua/zom) (r:zd:12190/zd:13186) (q:draft)
tuazong = (i:1) (t:adv) (f:everyday) (w:that too/even that/also) (d:<tua>, that, and <zong>, also, written as one word: that too, and even that) (j:tua/zong) (r:zd:11630/zd:11846/zd:11327) (q:draft)
tuciang = (i:1) (t:adv) (f:time) (w:until now/up to now/so far) (d:<tu>, now, with <ciang>, up to, written as one word and often followed by <dong>: up to the present; {tuciang in} is at present) (j:tu/ciang) (r:zd:15644/zd:19846/zd:24068) (q:draft)
tuciang dong = (i:1) (t:adv) (f:time) (w:until now/up to now/so far/still) (d:<tuciang>, up to now, and <dong>, until: right up to the present; stands before the verb, which is often negative with <nailo> or <zolo>, not yet) (r:zd:15644/zd:19239) (q:draft)
tuciangciang = (i:1) (t:adv) (f:time) (w:so far/up to now/thus far) (d:<tu> and <ciangciang> written as one word: up to the present time) (j:tu/ciangciang) (r:zd:20387/zd:15481/zd:15385) (q:draft)
tuciangdong = (i:1) (t:adv) (f:time) (j:tuciang dong) (r:zd:15243/zd:16952) (q:draft)
tuciangin = (i:1) (t:adv) (f:time) (w:now/nowadays/at present) (d:<tu>, the present, and <ciangin> written as one word: now, at this time, often in contrast with an earlier time) (s:tu-in) (j:tu/ciangin) (r:zd:19166/zd:22922) (q:draft)
tuding = (i:1) (t:v) (f:work/social) (w:will sit/will occupy) (d:<tu> and <ding> written as one word: who is to sit, said of the one who is to hold a seat or office) (j:tu/ding) (r:zd:17213) (q:draft, low confidence)
tudongmah = (i:1) (t:adv) (f:time) (w:still/even now/to this day) (d:<tudong>, until now, and the emphatic <mah> written as one word: even up to now, still) (j:tudong/mah) (r:zd:11782/zd:12053/zd:11945) (q:draft)
Tuesday = (i:1) (t:n) (c:ni) (f:time) (w:Tuesday) (s:sepkikni/pithai) (o:English) (r:zd:15342/zd:15729) (q:draft)
tuga = (i:1) (t:n) (f:work/home) (w:hoe handle/haft/helve) (d:the wooden handle of a hoe, named together with {heiga}, the handle of an axe) (r:zd:15996) (q:draft, low confidence)
tuh = (i:2) (t:v) (f:social) (w:snatch/grab/compete for) (d:take something quickly before or away from another person, or strive against others to get it; the object is a thing or a turn to speak, not seed) (r:zd:21085/zd:20513) (q:draft, low confidence)
tuhna = (i:2) (t:n) (f:religion/social) (w:burial/interment/committal) (d:the laying of a dead person in the ground as the last part of a funeral, in {leisung ah tuhna}, burial in the earth, with <nei> or <kinei> after it; the same <tuh> as for seed) (s:phumna) (r:zd:23172/zd:24045) (q:draft)
tuhna = (i:3) (t:n) (f:social/politics) (w:scramble/seizing/contest) (d:<tuh> in another meaning, snatch or struggle for, with the noun suffix <na>: the seizing of a thing or a struggle of several for it, as {tui ki tuhna}, a scramble for water, and {gam tuhna}, the seizing of land) (r:zd:25390/ts:6443) (q:draft, low confidence)
tuhun ciangin = (i:1) (t:adv) (f:time) (w:nowadays/these days/at present) (d:<tuhun>, the present time, and <ciangin>, when: nowadays, in our time; opens a sentence or clause, often set against an earlier time such as {nidang lai-in}, in former days) (r:zd:20410/zd:11775/zd:23551) (q:draft)
tuhun teh = (i:1) (t:adv) (f:time) (w:nowadays/these days/at present) (d:<tuhun>, the present time, and <teh>, here a word for when or at, not measure: nowadays, placed at the start of a clause and often followed by <ta> on the verb to contrast the present with the past) (s:tulaitak) (r:zd:23301/zd:25451) (q:draft)
tuhunciang = (i:1) (t:adv) (f:time) (w:nowadays/at the present time/these days) (d:<tuhun> and <ciang> written as one word: at the present time, nowadays; often followed by <in>) (j:tuhun/ciang) (r:zd:20984/zd:16580/zd:15280) (q:draft)
tui = (i:1) (t:n) (f:food/nature) (w:water) (d:water, and any liquid; the first part of many compounds, such as <tuikhuk>, well, and <tuipi>, sea)
tui hai = (i:1) (t:n) (f:food/health) (w:glass of water/cup of water) (d:<tui>, water, and <hai>, cup: a cup or glass of water, used as a measure with a number after it, {tui hai khat}, one glass of water; also the cup that water is drunk from) (r:zd:16665/zd:24276/zd:15730) (q:draft)
tui pipe = (i:1) (t:n) (f:home/work) (w:water pipe/water main/water pipeline) (d:<tui>, water, and <pipe>, pipe: the pipe or pipeline that brings water to a town or house; often after the name of the source or town) (r:zd:15855/zd:19652) (q:draft)
tuibang = (i:1) (t:adv) (f:nature/social) (w:like water) (d:<tui>, water, and <bang>, like, written as one word; a figure of songs and sayings, as {tuibang kigawm}, join together like water, be united) (j:tui/bang) (r:zd:16790/zd:23355) (q:draft)
tuibuahpawi = (i:1) (t:n) (f:social/time) (w:water festival/Thingyan) (d:<tuibuah>, pouring water, with <pawi>, festival: the Burmese new year water festival, Thingyan, in April; also said of the same festival in Thailand) (r:zd:12115/zd:19342) (q:draft)
tuibualna = (i:1) (t:n) (f:everyday/body) (w:swimming/bathing/swimming pool) (d:<tui>, water, with <bual>, wallow, and the noun suffix <na>: swimming or bathing in water, and the place for it, a swimming pool) (r:zd:20430/zd:20177) (q:draft)
tuibuk = (i:1) (t:n) (f:health/everyday) (w:nicotine water/tobacco water) (d:water charged with tobacco smoke in a pipe, kept in a small gourd and held in the mouth; {tuibuk muam} is to hold it in the mouth) (r:zd:9448/zd:14804) (q:draft)
tuibuk = (i:2) (t:n) (f:home) (w:bathroom/washroom) (d:a room for washing, named beside <ekbuk>, the toilet) (r:zd:24054) (q:draft, low confidence)
tuibung = (i:1) (t:n) (f:home) (w:water container/water bottle/water tank) (d:<tui>, water, with <bung>, here a vessel: any vessel that holds water, from a drinking bottle to a storage tank) (r:zd:25927/zd:22650) (q:draft)
tuibuuk = (i:1) (t:n) (f:social/health) (w:nicotine water/tobacco water) (d:water charged with tobacco smoke in a water pipe, which Zomi keep in the mouth and spit out; {tuibuuk muam} is hold it in the mouth; named with tobacco, betel and drink as a habit) (r:zd:25200/zd:17087) (q:draft)
tuibuuk = (i:2) (t:n) (f:home) (w:bathroom/washroom) (d:<tui>, water, with <buuk>, hut or small room: a room for washing, named beside {eekbuuk}, toilet) (r:zd:25115) (q:draft, low confidence)
Tuicinlui = (i:1) (t:name) (c:khua) (f:travel) (w:Tuicinlui) (d:a village of the Tedim area, also written after a personal name to show where the person comes from) (r:zd:21182) (q:draft, low confidence)
tuidat = (i:1) (t:n) (f:health/nature) (w:moisture/water content/fluid) (d:<tui> and <dat> written as one word: the water that a food, the soil or the body holds or needs) (j:tui/dat) (r:zd:24276/zd:21092) (q:draft)
tuidawn = (i:2) (t:v) (f:everyday/food) (w:drink water/drink) (d:<tui>, water, with <dawn>, drink, written as one word and used as a verb: drink water, as in {a tuidawn khit ciangin}, after drinking) (r:zd:17495/zd:20588) (q:draft)
Tuidil = (i:1) (t:name) (c:khua) (f:travel) (w:Tuidil) (d:a village of the Zomi area, named together with Cikha, Suangsang and Phaiza) (r:zd:10960) (q:draft, low confidence)
tuidim = (i:1) (t:v) (f:nature) (w:be flooded/fill with water/be full of water) (d:<tui> and <dim> written as one word: be full of water, said of streets and places under flood water) (j:tui/dim) (r:zd:17416/zd:15257/zd:15342) (q:draft)
tuiduh = (i:1) (t:adj) (f:everyday/food/body) (w:thirsty) (d:<tui>, water, with <duh>, want: wanting water, thirsty; {tuiduh mite} are the thirsty) (s:dangtak) (b:duh)
tuigalkap = (i:1) (t:n) (f:politics) (w:navy/naval soldier/marine) (d:<tui>, water, with <galkap>, soldier or army: the navy, or a man who serves in it) (r:zd:15332/zd:10793) (q:draft)
tuihai = (i:1) (t:n) (f:food/home) (w:cup/glass/drinking cup) (d:<tui> and <hai> written as one word: a cup or glass for drinking water, or a cupful of water) (j:tui/hai) (r:zd:24276/zd:16752) (q:draft)
tuihualpi = (i:1) (t:n) (f:nature/social) (w:great wave/wave/tsunami) (d:<tuihual>, wave, with <pi>, great: a great wave of the sea; also a wave of change that sweeps over the world) (s:hualpi) (b:tuihual) (r:zd:22305/zd:23806) (q:draft)
tuikhang = (i:2) (t:v) (f:nature) (w:flood/be flooded) (d:used as a verb of a place or of the water, with <hi> or <ngeilo> after it: flood, come under water, as {tuikhang ngeilo}, it never floods) (r:zd:22584/zd:24515) (q:draft)
tuikhanggawp = (i:1) (t:v) (f:nature) (w:be badly flooded/flood severely) (d:<tuikhang>, flood, and <gawp>, severely, written as one word: there is heavy flooding) (j:tuikhang/gawp) (r:zd:15257/zd:12717/zd:16061) (q:draft)
tuikhanna = (i:1) (t:n) (f:nature) (w:flood/flooding) (d:<tuikhang>, flood, with the noun suffix {-na}: the rising and overflowing of water, a flood) (s:tuicin) (b:tuikhang) (r:zd:14942/zd:22650/zd:24490) (q:draft)
tuikhawnggawp = (i:1) (t:v) (f:nature) (w:be badly flooded/flood) (d:{tuikhawng}, another spelling of <tuikhang>, flood, with <gawp>, severely: be badly flooded; also the flood itself) (j:tuikhang/gawp) (r:zd:16105/zd:20155/zd:11362) (q:draft)
Tuikhiang = (i:1) (t:name) (c:khua) (f:travel) (w:Tuikhiang) (d:village in the Tonzang area of Chin State) (r:zd:25479/ts:3168) (q:draft)
tuikholna = (i:1) (t:n) (f:nature/work) (w:reservoir/dam/water tank) (d:<tui>, water, with <kholna>, place of storing: a place built to store water, a reservoir, dam or tank) (s:tuibem/tuibeem) (r:zd:20627/zd:22650) (q:draft)
tuikhulh = (i:1) (t:n) (f:nature) (j:tuikulh) (r:zd:16340/zd:20580) (q:draft)
tuikivung = (i:1) (t:n) (f:nature/home) (w:standing water/pool of water/puddle) (d:water that has collected and stands in one place, from <tui>, water, and <kivung>, be held: the water in a toilet bowl, a puddle by the road, a pond, or stagnant water in which mosquitoes breed) (r:zd:16177/zd:20008/zd:13334) (q:draft)
tuikulhno = (i:1) (t:n) (f:nature/travel) (w:small island/islet) (d:<tuikulh>, island, with the ending {-no}, small or young: a little island) (b:tuikulh) (r:zd:17958/zd:11058) (q:draft)
tuikulhtung = (i:1) (t:phrase) (f:nature/travel) (w:on the island/island) (d:<tuikulh>, island, and <tung>, on, written as one word: on an island, the island as a place, placed after its name) (j:tuikulh/tung) (r:zd:16304/zd:11600) (q:draft)
tuilam = (i:2) (t:n) (f:travel/politics) (w:waterway/sea route/sea) (d:<tui>, water, with <lam>, way or side: travel, trade or war by water or sea, set beside <leilam>, by land, and <vanlam>, by air; {tuilam tawh} is by water) (r:zd:22785/zd:19960/zd:24040) (q:draft)
Tuilang = (i:1) (t:name) (c:khua) (f:travel) (w:Tuilang) (d:a village near Tedim, on the Tedim road) (r:zd:15743/zd:23767) (q:draft)
Tuilangh = (i:1) (t:name) (c:khua) (f:travel) (w:Tuilangh) (d:village of the Tedim area in Chin State; written in brackets after a personal name it tells the home village) (r:zd:16983/zd:11409) (q:draft)
tuilu = (i:1) (t:n) (f:nature) (w:headwaters/source/upstream) (d:<tui>, water, with <lu>, head: the upper end of a river or water supply, where the water comes from; {tuilu tuitaw} is upstream and downstream) (r:zd:17295/zd:24227) (q:draft)
tuiluan = (i:1) (t:n) (f:nature/home) (w:flow of water/water flow) (d:<tui>, water, and <luan>, flow, written as one word: the flowing of water; {tuiluan nading} is for water to flow, and {tuiluan khiatna} is where water flows out, a drain) (j:tui/luan) (r:zd:22953/zd:12387) (q:draft)
tuilum = (i:1) (t:n) (f:food/health/home) (w:warm water/hot water) (d:<tui>, water, and <lum>, warm, written as one word: warm or hot water for drinking or bathing) (j:tui/lum) (r:zd:22499/zd:24054/zd:21826) (q:draft)
tuilut = (i:1) (t:v) (f:nature/health) (w:dive/go under water) (d:<tui> and <lut> written as one word: go into the water, dive; also of water getting into something, as into the lungs) (j:tui/lut) (r:zd:15644/zd:21633) (q:draft, low confidence)
tuin = (i:2) (t:adv) (f:time) (w:now/at present) (d:{tuin} is <tu-in> written as one word: now, at the present time, often at the head of a sentence and set against an earlier time) (s:tu-in) (r:zd:19729/zd:20753/zd:12386) (q:draft)
tuinaak = (i:1) (t:n) (f:nature) (j:tuinak) (r:zd:17387/zd:15996) (q:draft)
tuinawl = (i:1) (t:n) (f:nature/travel) (w:water's edge/shore/bank) (d:<tui>, water, with <nawl>, edge: the edge of a river, lake or sea, where the water meets the land) (r:zd:18134/zd:19262) (q:draft)
tuineek = (i:1) (t:n) (f:home/health) (j:tuinek) (r:zd:25390/zd:16604) (q:draft)
tuinek = (i:1) (t:n) (f:home/health) (w:drinking water/water supply) (d:<tui>, water, with <nek>, to drink: water for drinking, and the supply of it to a town or village) (j:tui/nek) (r:zd:16862/zd:14790) (q:draft)
tuinin = (i:1) (t:n) (f:home/health) (w:waste water/sewage/drain water) (d:<tui>, water, with <nin>, dirty: used water that runs off from a house, bathroom or sewer) (r:zd:17295/zd:12387) (q:draft)
tuipaikhiatsakna = (i:1) (t:n) (f:home/work) (w:drain/drainage/drainage channel) (d:<tui>, water, with <paikhiatsak>, let go out, and the noun suffix <na>: a drain or ditch that carries water away from a street or town) (r:zd:20297/zd:17387) (q:draft)
tuipek = (i:1) (t:v) (f:everyday/nature) (j:tuipeek) (r:zd:11762/zd:22910) (q:draft)
tuiphum = (i:2) (t:n) (f:religion) (w:Baptist) (d:the Baptist denomination, in the names of churches and bodies before <pawlpi>, <biakinn> or <kipawlna>, written with a capital letter in names; not the act of baptizing) (r:zd:21547/zd:22928/zd:16016) (q:draft)
tuiphum pawlpi = (i:1) (t:n) (f:religion) (w:Baptist church/Baptist denomination) (d:<tuiphum>, baptize by immersion, and <pawlpi>, church: the Baptist church, both the denomination and one congregation of it; the name of a village or people stands before it, {Zomi Tuiphum pawlpi}) (r:zd:21547/zd:24186) (q:draft)
tuiphumte = (i:1) (t:n) (f:religion) (w:Baptists) (d:<tuiphum>, baptize by immersion, with the plural <te>, written as one word: the Baptists, members of the Baptist church; often written with a capital) (j:tuiphum/te) (r:zd:20636/zd:14735) (q:draft)
tuipigal = (i:1) (t:n) (f:travel/social) (w:overseas/abroad/land across the sea) (d:<tuipi>, sea, with <gal>, the other side: the countries beyond the sea, named beside <Kawlgam>, Myanmar, and <Vaigam>, India, as the places where Zomi live) (j:tuipi/gal) (r:zd:20507/zd:16588) (q:draft)
tuipih = (i:2) (t:n) (f:social) (w:fellow villager/townspeople/neighbour) (d:<tui>, water, with {-pih}, fellow: one who shares the same water, used only as the second half of the pair <khuapih tuipih>, the people of one's own town or village; not <tuipi>, sea) (r:zd:21170/zd:20264/zd:11508) (q:draft)
tuipinawl = (i:1) (t:n) (f:nature/travel) (w:beach/seashore/coast) (d:<tuipi>, sea, with <nawl>, edge: the land along the sea, a beach) (r:zd:15245/zd:15822/zd:16360) (q:draft)
tuipitung = (i:1) (t:phrase) (f:nature/travel) (w:on the sea/over the sea/at sea) (d:<tuipi>, sea, and <tung>, on or over, written as one word: on or over the sea, often after the name of a sea) (j:tuipi/tung) (r:zd:11501/zd:12936) (q:draft)
tuipuan = (i:1) (t:n) (f:home/everyday) (w:waterproof cloth/raincoat/tarpaulin/plastic sheet) (d:cloth or sheet that keeps water out, from <tui>, water, and <puan>, cloth: a raincoat, a tarpaulin or canvas, or a plastic sheet) (r:zd:14824/zd:23767) (q:draft)
tuisa = (i:1) (t:n) (f:food/home) (w:hot water/boiling water) (d:<tui>, water, with <sa>, hot: hot or boiling water) (j:tui/sa) (r:zd:15425/zd:25223) (q:draft)
tuisabel = (i:1) (t:n) (f:food/home) (w:hotpot pot/hot pot) (d:<tuisa>, boiling water, with a short form of <beel>, pot: the pot of boiling soup of a <Hotpot> meal, in which the food is cooked) (r:zd:19987) (q:draft)
Tuisanzang = (i:1) (t:name) (c:khua) (f:travel) (w:Tuisanzang) (d:Zomi village on the road from Tedim towards Phaltang, Chin State; written in brackets after a personal name it tells the home village) (r:zd:21396) (q:draft)
tuisiangtho = (i:1) (t:n) (f:food/health) (w:drinking water/purified water/clean water) (d:<tui>, water, with <siangtho>, here clean and pure: clean water that is safe to drink, also purified or bottled drinking water) (s:tuisiang) (r:zd:14790/zd:25909) (q:draft)
tuisik = (i:1) (t:n) (f:home/food) (w:water/tap water/drinking water) (d:plain water for drinking and washing, and the water supply of a town; set beside <tuisiang>, clean water) (r:zd:17668/zd:18042/zd:17958) (q:draft)
tuisungah = (i:1) (t:adv) (f:nature/everyday) (w:in the water/into the water/under water) (d:<tui>, water, and <sungah>, inside, written as one word: in or into the water) (j:tui/sungah) (r:zd:14301/zd:20747/zd:19427) (q:draft)
tuisunglutsiam = (i:1) (t:n) (f:work/nature) (w:diver) (d:<tuisung>, in the water, <lut>, go in, and <siam>, skilled, written as one word: a person trained to go under water) (j:tuisung/lut/siam) (r:zd:21366/zd:20289) (q:draft)
Tuitangzang = (i:1) (t:name) (c:khua) (f:travel) (w:Tuitangzang) (d:a Zomi village, written after a person's name as the home village) (r:zd:15868) (q:draft, low confidence)
tuitawh = (i:1) (t:adv) (f:everyday/home) (w:with water) (d:<tui>, water, and <tawh>, with, written as one word: with water, using water) (j:tui/tawh) (r:zd:24276/zd:21417) (q:draft, with a capital Tuitawh is also the name of a Zomi village, written after personal names)
tuitha = (i:1) (t:n) (f:nature/work) (w:water power/hydropower) (d:<tui>, water, and <tha>, strength: the force of flowing water, used to make electricity) (r:zd:22650/ts:5049) (q:draft)
tuithe = (i:1) (t:n) (c:animal) (f:nature) (w:dragonfly) (d:a dragonfly; {tuithe vanleng}, dragonfly aeroplane, is a name for a helicopter or a drone) (r:zd:23767) (q:draft)
tuition = (i:1) (t:n) (f:education) (w:tuition/private lessons/extra classes) (d:paid lessons outside school hours; {tuition kah} is attend such lessons and {tuition man} is the fee for them) (o:English) (r:zd:23797/zd:20572) (q:draft)
tuivai = (i:1) (t:n) (f:home/work) (w:water supply/water works) (d:<tui>, water, with <vai>, affair: the matter of water for a town, its supply and its pipes) (r:zd:17675/zd:18024) (q:draft)
Tuivial = (i:1) (t:name) (c:khua) (f:travel) (w:Tuivial) (d:village of the Thangkai circle in the Tedim area of Chin State, Myanmar; also written after the name of a person who comes from it) (r:zd:24049/zd:18896) (q:draft, low confidence)
Tuizang = (i:1) (t:name) (c:khua) (f:social) (w:Tuizang) (d:a village of the Tedim area, often written in brackets after a person's name as the home village) (r:zd:25734/zd:23278) (q:draft)
tuizawn = (i:1) (t:n) (f:home/work) (w:water pipe/hose/water main) (d:<tui>, water, with <zawn>, here pipe: a pipe or hose that carries water; {ekzawn} is a sewage pipe) (r:zd:17834/zd:23767) (q:draft)
tuk = (i:1) (t:v) (f:everyday) (w:fall/fall down/stumble) (d:fall down or stumble. Of a thing, fall on something) (s:puk/kia) (a:tho/dingto) (r:19.37.24) (q:draft)
tukal = (i:1) (t:adv) (f:time) (w:this week) (d:<tu>, this, with <kal>, week; {tukal sung} is during this week) (r:zd:22883/zd:25115/zd:25211) (q:draft)
tukalh = (i:1) (t:v) (f:everyday/social) (w:conflict/contradict/clash/be at odds) (d:used with the prefix <ki> and often with <tawh>, with: {ki tukalh} is be contrary to something or not agree with each other) (r:zd:10732/zd:24932) (q:draft)
tukalsung = (i:1) (t:adv) (f:time) (w:this week/within this week) (d:<tu>, this, <kal>, week, and <sung>, during, written as one word: during the present week) (j:tu/kal/sung) (r:zd:17432/zd:10871) (q:draft)
tukha = (i:2) (t:n) (f:time) (w:this month) (d:<tu>, this, with <kha>, month, written as one word: the present month, often before a day or the name of the month, as {tukha 16 ni}; {tukha kipatlam} is at the beginning of this month) (r:zd:24948/zd:25630/zd:10935) (q:draft)
tukhangin = (i:1) (t:adv) (f:time) (w:in this generation/in this age) (d:<tukhang> and the marker <in> written as one word: in this generation, in the present age) (j:tukhang/in) (r:zd:21327) (q:draft)
tukhasung = (i:1) (t:adv) (f:time) (w:this month/within this month) (d:<tu>, this, <kha>, month, and <sung>, during, written as one word: within this month) (j:tu/kha/sung) (r:zd:14954/zd:15485) (q:draft)
tukpeng = (i:1) (t:n) (f:media) (w:football/soccer) (d:the game of football and the ball it is played with, also called <bawlung>; {tukpeng kidemna} is a football tournament) (r:zd:23427/zd:10892/zd:11714) (q:draft)
tuktum = (i:1) (t:n) (f:body) (w:hair bun/topknot/chignon) (d:hair tied up in a knot at the back of the head; a proverb says that even the knot of hair at one's own nape can become an enemy) (r:zd:15697/zd:21745) (q:draft)
tukumpen = (i:1) (t:adv) (f:time) (w:this year) (d:<tukum>, this year, and the topic marker <pen> written as one word: as for this year) (j:tukum/pen) (r:zd:12259/zd:19018) (q:draft)
tukumsung = (i:1) (t:adv) (f:time) (w:this year/during this year) (d:<tukum>, this year, and <sung>, during, written as one word: in the course of this year) (j:tukum/sung) (r:zd:20173/zd:19558/zd:19567) (q:draft)
tukumzong = (i:1) (t:adv) (f:time) (w:this year too/this year as well) (d:<tukum>, this year, and <zong>, also, written as one word) (j:tukum/zong) (r:zd:12271/zd:12164/zd:12259) (q:draft)
tulaai = (i:1) (t:det) (f:time/media) (j:tulai) (r:zd:19659) (q:draft)
tulaaitak = (i:1) (t:adv) (f:time) (j:tulaitak) (r:zd:24242/zd:23904) (q:draft)
tulaitak = (i:1) (t:adv) (f:time) (w:now/at present/currently) (d:<tu>, this, and <laitak>, at the very time, written as one word: at this very time) (s:tu-in) (j:tu/laitak) (r:zd:16337/zd:19860) (q:draft)
tulaitakin = (i:1) (t:adv) (f:time) (w:at present/right now/currently) (d:<tulai>, the present, with <takin>, at the very time, written as one word: at this very time, now) (j:tulai/takin) (r:zd:23148/zd:13020/zd:20963) (q:draft)
tulam = (i:1) (t:adv) (f:time) (w:nowadays/these days/at present) (d:<tu>, present, with <lam>, side: the present time, set against <nidang> or {a beisa}, formerly; nearly always as {tulam ciangin}, nowadays) (r:zd:19151/zd:14859/zd:20526) (q:draft)
tulamlam = (i:1) (t:adv) (f:time) (w:nowadays/these days/lately) (d:in recent times, as things now stand; mostly as {tulamlam ciangin}, nowadays, setting the present against how things were before) (r:zd:17897/zd:15531) (q:draft)
tulian = (i:1) (t:adv) (f:time) (w:right now/at present/currently) (d:found with <laitak>: {tulian laitak} is at this very time, at present) (r:zd:21358/zd:16055/zd:15305) (q:draft)
Tulsa = (i:1) (t:name) (c:city) (f:travel) (w:Tulsa) (d:city in the state of Oklahoma, USA, where many Zomi live) (r:zd:17122/zd:24453/zd:10745) (q:draft)
tulsang = (i:1) (t:adj) (f:home) (w:high-heeled) (d:of shoes, with a high heel, in {khedap tulsang}, high-heeled shoes; compare <khetul>, heel, and <sang>, high) (r:zd:12380) (q:draft, low confidence)
Tulsuk = (i:1) (t:name) (c:place) (f:travel) (w:Tulsuk) (d:place in the Zomi area of Chin State with a checkpoint, on the Tulsuk, Pimpih and Laibung road) (r:zd:23252/zd:10861) (q:draft, low confidence)
tultampi = (i:1) (t:num) (f:everyday) (w:thousands/many thousands) (d:<tul>, thousand, and <tampi>, many, written as one word after a noun: thousands of) (j:tul/tampi) (r:zd:12950/zd:17107/zd:14664) (q:draft)
tultampitak = (i:1) (t:num) (f:everyday) (w:many thousands/thousands of) (d:<tul>, thousand, and <tampitak>, very many, written as one word after the thing counted) (j:tul/tampitak) (r:zd:18911/zd:17707/zd:16698) (q:draft)
tulthen = (i:1) (t:num) (f:everyday) (w:tens of thousands/thousands upon thousands) (d:<tul>, thousand, and <then>, ten thousand, written as one word for a very large number that is not counted, usually followed by <tampi>, many) (j:tul/then) (r:zd:19295/zd:14616) (q:draft)
tum = (i:1) (t:v) (f:everyday/social) (w:play/blow/sound) (d:play a musical instrument or sound a trumpet; the instrument stands before the verb, as {peengkul tum}, blow the trumpet) (s:mut) of instruments
tuma kum = (i:1) (t:adv) (f:time) (w:years ago) (d:<tuma>, before now, and <kum>, year: years ago; a number follows, and then usually <lai> or {lai in}, as {tuma kum 10 lai in}, ten years ago) (r:zd:21925/zd:15459/zd:2072) (q:draft)
tumaa = (i:1) (t:adv) (f:time) (j:tuma) (r:zd:19159/zd:23136) (q:draft)
tumahmah = (i:1) (t:adv) (f:time) (w:right now/this very moment) (d:<tu>, now, and <mahmah>, the very, written as one word: right now; mostly as {tumahmah in}, and {tumahmah a kipanin} is from this very moment) (j:tu/mahmah) (r:zd:26664/zd:19320) (q:draft)
tumding = (i:1) (t:v) (f:politics/work) (w:to join/to enlist) (d:<tum> in the sense of enter, go into, with <ding>, written as one word: in order to join; {galkap tumding} is to enlist as a soldier) (j:tum/ding) (r:zd:11906/zd:12103) (q:draft)
tumding = (i:2) (t:v) (f:media) (w:to play) (d:<tum>, play an instrument, with <ding>, written as one word: in order to play it) (j:tum/ding) (r:zd:16442) (q:draft, low confidence)
tumding = (i:3) (t:v) (f:travel/nature) (w:will sink/be about to sink) (d:<tum> in the sense of go down, sink, with <ding>, written as one word; said here of a ship going down in the water) (j:tum/ding) (r:zd:18920) (q:draft, low confidence)
tumging = (i:1) (t:n) (f:media/social) (w:musical instrument/music) (d:<tum>, play, with <ging>, sound: an instrument that is played, and the music made with instruments as distinct from singing) (s:tumtheih) (r:zd:19756/zd:21286/zd:26310) (q:draft)
tumh = (i:1) (t:v) (f:everyday) (w:aim at/intend/strive for) (d:set the mind on reaching or doing something; compare <tup>, intend) (r:zd:21458/zd:20176) (q:draft, low confidence)
tumkawm = (i:1) (t:v) (f:media/social) (w:play while/playing along) (d:<tum>, play an instrument, and <kawm>, while, written as one word: playing an instrument while doing something else, such as singing or walking about) (j:tum/kawm) (r:zd:14541/zd:14624) (q:draft, low confidence)
tumlam = (i:1) (t:n) (c:direction) (f:nature) (w:west/western side) (d:the side where the sun sets; {tumlam gamte} is the western countries) (s:nitumna) (r:zd:24227/zd:9424) (q:draft)
tumnih = (i:1) (t:n) (f:everyday) (w:two pieces/two parts) (d:<tum>, here a piece, with <nih>, two: two pieces; {tumnih kisuah} is break in two) (r:zd:15372/zd:18005) (q:draft)
tumpen = (i:1) (t:adj) (f:family) (w:youngest/last-born) (d:the youngest of the children, placed after <tapa> or <tanu>: {tapa tumpen} is the youngest son) (s:nautum) (r:zd:9223/zd:20241) (q:draft)
tumtak = (i:1) (t:adv) (f:everyday/social) (w:by oneself/on one's own/individually) (d:after a pronoun, as in {ei tumtak tek in}, each of us on our own, by ourselves alone; compare <tumtakin>) (r:zd:16974) (q:draft, low confidence)
tumtheilo = (i:1) (t:v) (f:social) (w:cannot play/unable to play) (d:<tum> and <theilo> written as one word: not able to play a musical instrument) (j:tum/theilo) (r:zd:16337) (q:draft, low confidence)
tumtheilo = (i:2) (t:v) (f:nature) (w:cannot sink/unable to sink) (d:<tum>, here sink or go under, with <theilo>: not able to sink in water; from one headline) (r:zd:11497) (q:draft, low confidence)
tun = (i:3) (t:adv) (f:time/everyday) (w:now/at present) (d:the time word <tu>, now, with the ending <in>, more carefully written {tu'n}; it stands at the head of the clause and is not the verb arrive) (r:zd:25168/zd:2072) (q:draft, low confidence)
tunai = (i:2) (t:adv) (f:time) (w:recently/lately/recent) (d:of the near past, not the near future: a short time ago, alone or as {tunai in}, and before a noun as {tunai thuthang}, the recent news) (s:asawtnailo) (r:zd:19677/zd:16035/zd:14616) (q:draft)
tunbeh = (i:1) (t:v) (f:travel/everyday) (w:arrive as well/arrive in addition/also come) (d:<tun>, arrive, with an ending meaning in addition, not the noun for clan: more people or things arrive after the first ones, or someone arrives on the scene as well) (r:zd:19558/zd:16155) (q:draft)
tunciang = (i:1) (t:phrase) (f:time/everyday) (w:when it arrives/on reaching) (d:<tun>, arrive, and <ciang>, when, written as one word and often followed by <in>: when someone or something arrives or comes) (j:tun/ciang) (r:zd:25866/zd:15874/zd:16765) (q:draft)
tunciangin = (i:1) (t:conj) (f:time/travel) (w:when arriving/when it comes) (d:<tun> and <ciangin> written as one word: on reaching a place, or when a time comes) (j:tun/ciangin) (r:zd:24276/zd:20092) (q:draft)
tuncil = (i:1) (t:adv) (f:time/travel) (w:on first arriving/when newly arrived) (d:<tun>, arrive, and <cil>, at first, written as one word: at the time of first arriving in a place, newly arrived) (j:tun/cil) (r:zd:16337/zd:26708) (q:draft)
tunding = (i:1) (t:v) (f:travel/everyday) (w:will arrive/to reach) (d:<tun> and <ding> written as one word: will arrive or come, to reach a place or a goal) (j:tun/ding) (r:zd:25394/zd:17383) (q:draft)
tung = (i:3) (t:prep) (f:everyday) (w:from) (d:after a person or a group and followed by <pan> or <panin>, from that person, as the one who gives or from whom something is taken: {mipite' tung pan} is from the people) (r:ts:2400/zd:25136) (q:draft)
tungaa = (i:1) (t:prep) (f:everyday) (j:tunga) (r:zd:20778/zd:23005) (q:draft)
tungah = (i:3) (t:prep) (f:everyday/social) (w:to/toward) (d:marks the person to whom words, a feeling or a gift are directed, with verbs such as <gen>, <lungdam> and <pia>: {mipite' tungah gen} is say to the people; not a place on top of something) (s:kiangah) (r:ts:301/ts:9579) (q:draft)
tungah kinga = (i:1) (t:v) (f:everyday) (w:depend on/rest on/be based on) (d:<tungah>, on, and <kinga>, rest on: placed after a noun, depend on it, be founded on it or rely on it) (r:zd:24064/zd:25891/zd:23394) (q:draft)
tungah lungdam = (i:1) (t:v) (f:everyday/social) (w:be grateful to/thank) (d:<tungah>, on or toward, and <lungdam>, glad: be thankful to someone; the person thanked stands before the pair, and <ko>, declare, often follows, as {tungah lungdam ko}, give thanks to) (r:zd:16150/zd:21551/zd:20264) (q:draft)
tungahzong = (i:1) (t:adv) (f:everyday) (w:also on/on it too) (d:<tungah>, on, and <zong>, also, written as one word, placed after the noun) (j:tungah/zong) (r:zd:14566/zd:12148/zd:17450) (q:draft)
tungbaih = (i:1) (t:v) (f:travel/time) (w:arrive early/arrive sooner/reach quickly) (d:<tung> and <baih> written as one word: arrive early or sooner; of a goal or a hope, be reached soon) (j:tung/baih) (r:zd:21259/zd:23706) (q:draft)
tungbek = (i:1) (t:phrase) (f:everyday) (w:only on/on ... alone) (d:<tung>, on or upon, and <bek>, only, written as one word, followed by <ah>: on that one alone, as in {Pasian tungbek ah}, on God alone) (j:tung/bek) (r:zd:11831/zd:22159) (q:draft)
tungding = (i:1) (t:v) (f:everyday/time) (w:will arrive/will come) (d:<tung> and <ding> written as one word: will arrive, is to come; {hong tungding} is that which is coming) (j:tung/ding) (r:zd:22474/zd:12186/zd:19117) (q:draft)
tungen = (i:1) (t:adv) (f:time/everyday) (w:as now/as things are) (d:from <tu>, now; found in the set phrase {tungen abat leh}, if it goes on as it is now, at this rate) (r:zd:12769/zd:22880) (q:draft, low confidence)
tungkawikawi = (i:1) (t:v) (f:nature/travel) (w:reach many places/strike all over) (d:<tung>, arrive, and <kawikawi>, here and there, written as one word: arrive in many places, said above all of floods that strike in one place after another) (j:tung/kawikawi) (r:zd:15986/zd:17628/zd:11915) (q:draft)
tungkhat = (i:1) (t:phrase) (f:everyday/travel) (w:on a/on one) (d:<tung>, on, and <khat>, one, written as one word after a noun and before <ah>: on a certain one of the thing named, as {meileng tungkhat ah}, on a train) (j:tung/khat) (r:zd:16323/zd:16088/zd:12967) (q:draft)
tungkhatah = (i:1) (t:phrase) (f:everyday/travel) (w:on a/on one) (d:<tungkhat> and <ah> written as one word after a noun: on a certain one of the thing named, as {Bus tungkhatah}, on a bus) (j:tungkhat/ah) (r:zd:12153/zd:14541/zd:11934) (q:draft)
tungkhawng = (i:1) (t:prep) (f:everyday/it) (w:on and the like/on places like) (d:<tung>, on, with <khawng>, or so: on a thing and others like it, said loosely, as in {Facebook tungkhawng ah}, on Facebook and such places) (j:tung/khawng) (r:zd:14720/zd:12444) (q:draft)
tungkhinta = (i:1) (t:v) (f:travel) (w:have arrived/have already reached) (d:<tung>, arrive, and <khinta>, finished, written as one word: has now arrived) (j:tung/khinta) (r:zd:12717/zd:14869/zd:19662) (q:draft)
tungleh = (i:1) (t:phrase) (f:everyday) (w:on and/to and) (d:<tung>, on or towards, with <leh>, and, written as one word: links two places or persons, as in {Pasian tungleh midang tung ah}, towards God and towards others) (j:tung/leh) (r:zd:15272/zd:19800) (q:draft)
tungleh = (i:2) (t:phrase) (f:time/everyday) (w:when it comes/if it arrives) (d:<tung>, arrive, with <leh>, if or when, written as one word: {hun tungleh} is when the time comes) (j:tung/leh) (r:zd:12287/zd:12215) (q:draft)
tunglo = (i:1) (t:v) (f:everyday/travel) (w:not reach/not arrive) (d:<tung>, arrive, and <lo>, not, written as one word: does not reach or get to a place or a level) (j:tung/lo) (r:zd:16245/zd:12337/zd:23932) (q:draft)
tungma = (i:1) (t:adv) (f:time/travel) (w:before arriving/before coming) (d:<tung>, arrive, and <ma>, before, written as one word: before arriving at a place) (s:tunma) (j:tung/ma) (r:zd:25789) (q:draft)
tungmanlo = (i:1) (t:v) (f:travel/everyday) (w:not reach in time/fail to reach) (d:<tung>, arrive, <man>, be in time or finish, and <lo>, not, written as one word: not get as far as a place; {zato tungmanlo in} is before reaching the hospital) (j:tung/man/lo) (r:zd:11450/zd:21366) (q:draft)
tungna = (i:1) (t:n) (f:travel/everyday) (w:arrival/reaching) (d:<tung>, arrive or reach, with the noun suffix {-na}: the reaching of a place or a position) (b:tung) (r:zd:20862/zd:18142) (q:draft)
tungnailo = (i:1) (t:v) (f:everyday/travel) (w:not yet arrive/not yet reach) (d:<tung> and <nailo> written as one word: has not yet arrived or come, of a person, a message or a time) (j:tung/nailo) (r:zd:12061/zd:12891/zd:20271) (q:draft)
tungnung = (i:2) (t:n) (f:social/politics) (w:upper hand/top place/supremacy) (d:the higher place in rank, power or a contest rather than in space; with <kituh>, strive, it is a struggle to be on top of the other) (r:zd:12341/zd:22749/zd:19662) (q:draft)
tungpanin = (i:2) (t:prep) (f:everyday) (w:from on/off/from the top of) (d:after a thing or a place and not a person: from on top of it, off it or down from it, as {lei tungpanin}, from a bridge; after <Facebook> or another site, from that site) (r:zd:16373/zd:23022/zd:15019) (q:draft)
tungsa = (i:2) (t:adj) (f:travel/social) (w:arrived/already arrived) (d:of people who have already reached a country or place and are there now, after the name of the place; {gamdang tungsa te} are those who have arrived abroad) (r:ts:7876/zd:23479/zd:17841) (q:draft)
tungsak = (i:2) (t:v) (f:travel/social) (w:lodge/put up/accommodate) (d:of a host: let a guest arrive and stay at a place named with <ah>, a house or a hotel; here a person is brought to a place, not a thing brought upon a person) (r:zd:20587/zd:21421) (q:draft)
tungsak = (i:3) (t:v) (f:work/travel) (w:charge) (d:after a sum of money: make a price come to that amount, ask that much of a customer for a ride or a meal) (r:zd:15639/zd:16696) (q:draft, low confidence)
tungsate = (i:1) (t:n) (f:travel/social) (w:those who have arrived/those already there) (d:<tungsa>, having arrived, with the plural <te>: the people who have already arrived or are already in a place or process, as in {a tungsate}) (b:tungsa) (j:tungsa/te) (r:zd:15951/zd:22138) (q:draft, low confidence)
Tungshin = (i:1) (t:name) (c:place) (f:health) (w:Tung Shin) (d:Tung Shin Hospital, a hospital in Kuala Lumpur, Malaysia, named in lists of Zomi patients) (r:zd:19657) (q:draft)
tungsiah = (i:2) (t:n) (f:social/work/politics) (w:superior/higher authority/higher level) (d:those above in rank or office, as a noun or before {thunei} and <makai>: {tungsiah thunei te} are the higher authorities, set against <nuaisiah>, those below) (a:nuaisiah) (r:zd:22874/zd:23533/zd:22565) (q:draft)
tungtaang = (i:1) (t:n) (f:everyday) (j:tungtang) (r:zd:19733) (q:draft, low confidence)
tungtaangin = (i:1) (t:prep) (f:everyday) (j:tungtangin) (r:zd:20176/zd:21843) (q:draft)
tungtawna = (i:1) (t:prep) (f:everyday) (w:through/by means of/as a result of) (d:<tungtawn> with the ending {-a}, placed after a noun or a possessor: through, by means of, arising from) (s:tungtawn/tungtawnin) (b:tungtawn) (r:zd:9231/zd:9224/zd:22603) (q:draft)
tungtawngin = (i:1) (t:prep) (f:everyday) (j:tungtawnin) (r:zd:20782) (q:draft, low confidence)
tungthei = (i:1) (t:v) (f:travel/everyday) (w:can arrive/be able to reach/can come upon) (d:<tung>, arrive, and <thei>, able, written as one word: be able to get to a place, and of an illness be able to come upon the body) (j:tung/thei) (r:zd:14935/zd:14873/zd:20399) (q:draft)
tungtuang = (i:2) (t:v) (f:travel) (w:ride/ride on) (d:<tung>, on, with <tuang>, ride: ride on a vehicle or an animal, which is named just before, as {mawtaw tungtuang}, ride in a car, or {sakol tungtuang}, ride a horse) (s:tuang) (r:zd:21389/zd:15272) (q:draft)
tungtuangte = (i:1) (t:n) (f:social/education) (w:outstanding people/the foremost/the eminent) (d:<tungtuang>, excel, with the plural <te>: those who stand above others, the outstanding ones; {mi tungtuangte} is eminent people) (b:tungtuang) (r:zd:24028/zd:22925) (q:draft)
tungtun = (i:1) (t:n) (f:nature) (w:mound/hillock/knoll) (d:a small rise of ground, a low mound or bank of earth in a field or garden) (r:zd:20117/zd:9133) (q:draft)
tungtung = (i:1) (t:v) (f:travel/everyday) (w:keep arriving/arrive one after another) (d:<tung>, arrive, said twice and written as one word: arrive again and again or one after another; with a capital it is also the name of a village in Tonzang township) (b:tung) (r:zd:19006/zd:23086) (q:draft, low confidence)
tungzo = (i:2) (t:v) (f:everyday/travel) (w:reach/manage to reach/attain) (d:<tung>, arrive, with <zo>, be able: manage to get as far as a place, or attain a rank or level, as in {dinmun tungzo}; with <lo> or <nawnlo>, fail to reach) (r:zd:20281/zd:26948/zd:20786) (q:draft)
tungzolo = (i:1) (t:v) (f:everyday/travel) (w:cannot reach/fail to arrive) (d:<tung>, arrive or reach, with <zolo>, cannot, written as one word) (j:tung/zolo) (r:zd:21306/zd:22584) (q:draft)
tuni = (i:1) (t:n) (f:time/everyday) (w:today) (d:this day, from <tu>, this, and <ni>, day; with the time marker <in> it means today, and {tuni dongin} is to this day)
tuni ciangciang = (i:1) (t:adv) (f:time) (w:until today/to this day/up to now) (d:<tuni>, today, and <ciangciang>, as far as: all the time up to the present day; stands at the head of the clause or before the verb, also followed by <ah>) (r:zd:25488/zd:24327) (q:draft)
tuniciang = (i:1) (t:adv) (f:time) (w:until today/to this day) (d:<tuni> and <ciang> written as one word: up to today, often followed by <dong>) (j:tuni/ciang) (r:zd:25433/zd:25712) (q:draft)
tunidong = (i:1) (t:adv) (f:time) (w:until today/to this day/still) (d:<tuni>, today, with <dong>, until, written as one word) (s:tudong) (j:tuni/dong) (r:zd:12002/zd:11400/zd:11335) (q:draft)
Tunisia = (i:1) (t:name) (c:land) (f:politics) (w:Tunisia) (d:a country in North Africa on the Mediterranean Sea) (r:zd:18086/zd:12016) (q:draft)
tunitan = (i:1) (t:adv) (f:time) (w:until today/to this day/so far) (d:<tuni>, today, and <tan>, as far as, written as one word: up to today) (j:tuni/tan) (r:zd:22606/zd:24934) (q:draft)
tunlawh = (i:1) (t:v) (f:health/everyday) (w:end up in/land in/be brought as a result) (d:<tun>, arrive, with <lawh>, get as a consequence: come to a place or state as the result of something; {zato tunlawh} is end up in hospital) (j:tun/lawh) (r:zd:15370/zd:17538/zd:24750) (q:draft)
tunloh = (i:1) (t:v) (f:everyday) (w:not arrive/not reach/not come) (d:<tun>, arrive, and <loh>, not, written as one word, used before <nading>, <hun> and similar words: not arriving, not reaching) (j:tun/loh) (r:zd:17327/zd:24069) (q:draft)
tunlohna = (i:1) (t:n) (f:everyday) (w:not reaching/not arriving) (d:<tun>, reach, and <lohna> written as one word: not reaching or not coming to a place; before a noun, that is not reached) (j:tun/lohna) (r:zd:20512/ts:12274) (q:draft)
Tunnel = (i:1) (t:n) (f:travel) (w:tunnel) (d:a road or railway passage under the ground or through a mountain; explained in Zolai as {leisung lampi}) (o:English) (r:zd:19338/zd:16851) (q:draft)
tunnu = (i:1) (t:n) (f:family) (w:mother) (d:poetic word for mother, used in songs, poems and titles; {tunnu Zogam} is the motherland Zogam) (r:zd:15874/zd:23974) (q:draft)
tuno = (i:1) (t:n) (c:animal) (f:nature/religion) (j:tuuno) (r:zd:20324/zd:16428) (q:draft)
tunta = (i:1) (t:v) (f:everyday) (w:have reached/have arrived) (d:<tun>, arrive, with <ta>, here now or already, written as one word: have now come to a point; the same spelling is also a personal name) (j:tun/ta) (r:zd:21815) (q:draft, low confidence)
tunteh = (i:1) (t:v) (f:everyday/time) (w:when arrive/on reaching) (d:<tun>, arrive, and <teh>, here when, written as one word: when someone arrives at a place, or when a time comes) (j:tun/teh) (r:zd:24641/zd:26565) (q:draft)
tuntoh = (i:1) (t:v) (f:travel) (w:arrive/reach/get up to) (d:<tun>, arrive, and <toh>, up, written as one word: arrive at a place one has gone up to, or reach as far as; used before <ciangin>, <teh> and <ma>) (j:tun/toh) (r:zd:22784/zd:25624) (q:draft)
tuntun = (i:1) (t:v) (f:travel/everyday) (w:arrive/reach) (d:<tun>, arrive, said twice: wherever one arrives; {a tuntun na} is every place one comes to, wherever they end up) (b:tun) (r:zd:23554/zd:18952/zd:20862) (q:draft)
tuntunna = (i:1) (t:n) (f:travel/everyday) (w:wherever one arrives/every place reached) (d:<tun>, arrive, said twice, with the noun suffix {-na}: each place that someone comes to; {i tuntunna ah} is wherever we come to) (b:tunna) (r:zd:17264/zd:20125/zd:19915) (q:draft)
tunuh = (i:1) (t:v) (f:travel) (w:arrive) (d:<tun> and the plural <uh> written as one word, in {ka tunuh leh} and {ka tunuh ciangin}: when we arrived) (j:tun/uh) (r:zd:19166/zd:17060) (q:draft)
tupek = (i:1) (t:n) (f:work/home) (w:spade/shovel) (d:a digging tool with a flat blade, named together with <tuzum>, the pointed one) (r:zd:25457/zd:22550) (q:draft)
tuplehsawm = (i:1) (t:n) (f:everyday/work) (w:aim/goal/purpose/plan) (d:<tup>, <leh> and <sawm> written as one word: what a person aims at and intends, a goal and plan for the future) (j:tup/leh/sawm) (r:zd:17309/zd:16844) (q:draft)
tupnate = (i:1) (t:n) (f:everyday/work) (w:aims/goals/purposes) (d:plural of <tupna>: the things a person or a body sets out to reach; often paired as {ngimna leh tupnate}, aims and objectives) (b:tupna) (r:zd:23725/zd:10743) (q:draft)
Turkey = (i:1) (t:name) (c:land) (f:politics/travel) (w:Turkey) (d:the country of Turkey; {Turkey te} is the Turks) (r:zd:15163/zd:10719/zd:11213) (q:draft)
Turkish = (i:1) (t:name) (c:people) (f:politics/travel) (w:Turkish) (d:of Turkey, its people or its language, used as in English; {Turkish mi} is a Turk) (o:English) (r:zd:11246/zd:12128) (q:draft, low confidence)
Turks = (i:1) (t:name) (c:people) (f:politics/social) (w:Turks/the Turks) (d:the Turkish people, in the English plural form; also written {Turkey te}, see <Turkey>) (o:English) (r:zd:19279) (q:draft, low confidence)
tusak = (i:2) (t:v) (f:travel) (w:land/make land/bring down) (d:<tu>, alight, with the causative <sak>, said of an aircraft: make it land at a place, mostly as {ki tusak}, be made to land, when a flight is sent to another airport) (r:zd:15342/zd:11827) (q:draft)
tusuk = (i:2) (t:v) (f:travel/everyday) (w:land/come down on/fall onto) (d:of something that flies or falls, such as a missile, a falling object or a person who jumps: come down and land on a place, after <ah> or <tungah>; not a person taking a seat) (r:zd:12693/zd:14933/zd:15437) (q:draft)
tusun = (i:1) (t:adv) (f:time) (w:today/this day) (d:<tu>, this, with <sun>, daytime: today during the day, earlier today; in news followed by the clock time) (r:ts:3628/zd:11259) (q:draft)
tusung = (i:1) (t:adv) (f:time) (w:these days/at present/lately) (d:<tu> and <sung> written as one word: in the present time, during these days; {tusung teng} is all this while) (j:tu/sung) (r:zd:11206/zd:12564/zd:15507) (q:draft)
tusungteng = (i:1) (t:adv) (f:time) (w:these days/lately/at present) (d:<tu>, this or present, with <sungteng>, throughout, written as one word: all through the present time, these days) (j:tu/sungteng) (r:zd:11970/zd:15820/zd:17241) (q:draft)
tuta = (i:1) (t:adv) (f:time) (w:now/at present/for now) (d:built on <tu>, now: at the present time; {tuta dih} is for the time being, as <tadih>) (r:zd:23529/zd:20018) (q:draft, low confidence)
tutadih = (i:1) (t:adv) (f:time) (j:tu tadih) (r:zd:11394/zd:25322) (q:draft)
tutak = (i:3) (t:adj) (f:everyday/time) (w:now)
tutan = (i:1) (t:adv) (f:time) (w:until now/up to now/to this day) (d:<tu>, now, and <tan>, as far as, written as one word: up to the present; also {tutan vei} with the same meaning) (s:tudong) (j:tu/tan) (r:zd:17212/zd:26658/zd:23084) (q:draft)
tutawm = (i:1) (t:adv) (f:time) (w:only now/just recently/all of a sudden) (d:only of late, of recent beginning; mostly denied, as {tutawm in thupiang hi lo}, it did not arise only just now) (r:zd:20850/zd:15853/zd:24646) (q:draft)
tuteng = (i:1) (t:adv) (f:time) (w:these days/lately/at present) (d:<tu>, this present, with <teng>, here all of: in this present period, these days) (r:zd:23810/zd:23057/zd:24120) (q:draft)
tuthei = (i:1) (t:v) (f:travel) (w:be able to land/land safely) (d:<tu>, sit, here of an aircraft coming down to land, and <thei>, able, written as one word: manage to land) (j:tu/thei) (r:zd:17301/zd:15403) (q:draft)
