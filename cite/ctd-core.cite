hauna = (i:1) (t:n) (f:work/everyday) (w:wealth/riches) (d:<hau>, rich, with the noun suffix {-na}: wealth, being rich; the same word as <hauhna>) (s:hauhna) (b:hau) (r:zd:23554/zd:22704) (q:draft)
haupente = (i:1) (t:n) (f:work/social) (w:the richest/the wealthiest) (d:<haupen>, richest, with the plural <te>: the richest people) (b:haupen) (j:haupen/te) (r:zd:22425/zd:16340) (q:draft)
hausa upa = (i:1) (t:n) (f:social/politics) (w:village headman/village elders/local leaders) (d:<hausa>, chief, and <upa>, elder: the headman and elders of a village or quarter, the local leadership, also the office of headman itself; stands after <khuasung> or <vengsung> and takes <te> for the persons) (r:zd:25126/zd:22758) (q:draft, low confidence)
hausa upate = (i:1) (t:n) (f:social/politics) (w:chief and elders/village authorities) (d:<hausa>, chief or headman, and <upate>, elders, said as a pair: the headman and the elders of a village as the body that rules it and judges its cases; often after <khua>, village) (r:zd:20176/zd:25114) (q:draft)
hauzo = (i:1) (t:v) (f:everyday/work) (w:manage to be rich/get rich) (d:<hau> and <zo> written as one word: be able to be rich, succeed in becoming rich) (j:hau/zo) (r:zd:21081/zd:12341) (q:draft, low confidence)
Havana = (i:1) (t:name) (c:city) (f:travel) (w:Havana) (d:capital city of Cuba) (r:zd:19860) (q:draft)
havang = (i:1) (t:n) (f:body) (w:gap between the teeth) (d:<ha>, tooth, and <vang>, gap, written as one word; in the saying {dawi havang kal ah}, between the teeth of the demons, a figure for being in great danger and yet spared) (j:ha/vang) (r:zd:24417) (q:draft, low confidence)
Hawaii = (i:1) (t:name) (c:land) (f:travel) (w:Hawaii) (d:group of islands in the Pacific Ocean that is a state of the United States) (r:zd:25916/zd:14559/zd:19262) (q:draft)
hawh = (i:1) (t:v) (f:social/travel) (w:visit/call on/go to see) (d:go to see a person or a place) (s:veh) (q:draft)
hawha = (i:1) (t:v) (f:social/travel) (w:visit and) (d:<hawh>, visit, and the linking <a> written as one word: visited and then) (j:hawh/a) (r:zd:10743) (q:draft)
hawhding = (i:1) (t:v) (f:social/travel) (w:will visit/to visit) (d:<hawh>, visit, and <ding> written as one word: will visit, is to go and see a person or place) (j:hawh/ding) (r:zd:13157/zd:16663) (q:draft)
hawhna ciahna = (i:1) (t:n) (f:travel/everyday) (w:going out and coming home/coming and going) (d:<hawhna>, a going to visit, paired with <ciahna>, the going home: all moving about outside the home, the way out and back; mostly with <ah> in warnings to be careful when out) (r:zd:14992/zd:19320) (q:draft)
hawhsawm = (i:1) (t:v) (f:social/travel) (w:intend to visit/try to visit/go to visit) (d:<hawh>, visit, and <sawm>, intend, written as one word: set out or plan to call on a person or a place) (j:hawh/sawm) (r:zd:23984/zd:12130) (q:draft)
hawhthei = (i:1) (t:v) (f:social/travel) (w:be able to visit/get to visit) (d:<hawh>, visit, and <thei>, able, written as one word; with <zel>, come or go visiting from time to time) (j:hawh/thei) (r:zd:14678/zd:21085) (q:draft)
hawhtohna = (i:1) (t:n) (f:social/travel) (w:going up to visit/visiting) (d:<hawh>, visit, with <tohna>, going up, written as one word; paired with <hawhsuk> as {hawhsuk hawhtohna}, going down and up on visits, going here and there to see people) (j:hawh/tohna) (r:zd:22652) (q:draft)
hawih = (i:1) (t:adj) (f:everyday) (j:hoih) (r:zd:19210/zd:19166) (q:draft)
hawihlo = (i:1) (t:adj) (f:everyday) (w:not good/bad) (d:<hawih>, a spelling of <hoih>, good, and <lo>, not, written as one word) (s:hoihlo) (j:hawih/lo) (r:zd:20545) (q:draft)
hawihna = (i:1) (t:n) (f:everyday/body) (w:build/form/appearance) (d:the shape, build or good appearance of a body, a building or a road; the meaning is inferred from few sentences) (r:zd:20545/zd:21458) (q:draft, low confidence)
hawk = (i:3) (t:n) (f:nature) (w:gully/watercourse) (d:a channel cut by running rain water, written apart in {hawk tui} for <hawktui>, the water rushing down it, and in {hawk guam} for <hawkguam>; not {hawk}, roar or skin) (r:zd:25863/ts:8850) (q:draft)
hawkguam = (i:2) (t:n) (f:home/travel) (w:drain/ditch/gutter) (d:a channel made beside a road or in a town to carry off rain and waste water, not a natural ravine; {tuinin paikhiatna hawkguam} is a waste water drain and {hawkguam sungah kiasuk} is fall into a drain) (r:zd:22953/zd:11409/zd:17952) (q:draft)
hawksansan = (i:1) (t:v) (f:social/politics) (w:keep shouting at/keep berating) (d:<hawksan>, roar at, with its last part doubled for an action done again and again; with <ki> before it, keep shouting at one another) (b:hawksan) (r:zd:19820) (q:draft, low confidence)
hawlding = (i:1) (t:v) (f:travel) (w:to drive/will drive) (d:<hawl> and <ding> written as one word: to drive or operate a vehicle or engine, will drive) (j:hawl/ding) (r:zd:21974/zd:14787/zd:20399) (q:draft)
hawlgawp = (i:1) (t:v) (f:travel) (w:drive recklessly/drive wildly) (d:<hawl>, drive, and <gawp>, violently, written as one word: drive a vehicle fast and without care) (j:hawl/gawp) (r:zd:15953/zd:17353) (q:draft)
hawlin = (i:1) (t:v) (f:travel) (w:driving/drive) (d:<hawl>, drive, and <in> written as one word: driving a vehicle, while driving) (j:hawl/in) (r:zd:11389/zd:19398) (q:draft)
hawlkawm = (i:1) (t:v) (f:travel) (w:while driving) (d:<hawl> and <kawm> written as one word: while driving a car or a boat) (j:hawl/kawm) (r:zd:17628/zd:24468) (q:draft)
hawlkhat = (i:1) (t:n) (f:travel) (w:driver/one who drives) (d:<hawl> and <khat> written as one word after the name of a vehicle: one who drives it, someone driving) (j:hawl/khat) (r:zd:20225/zd:12736) (q:draft)
hawlkhia = (i:2) (t:v) (f:travel) (w:drive off/drive away) (d:after <mawtaw> or the name of another vehicle, set the vehicle moving and leave in it, not force someone out) (r:zd:16676/zd:20522) (q:draft)
hawlkhiading = (i:1) (t:v) (f:politics) (w:will drive out/will expel) (d:<hawlkhia>, drive out, with <ding>, will, written as one word; after <ki> it is passive, {ki hawlkhiading}, will be expelled or deported) (j:hawlkhia/ding) (r:zd:11746/zd:16323) (q:draft)
hawlkhiakhin = (i:1) (t:v) (f:politics/work) (w:have driven out/have deported/have dismissed) (d:<hawlkhia> and <khin> written as one word: have already driven out, sent out of a country or dismissed from work) (j:hawlkhia/khin) (r:zd:12779/zd:15163) (q:draft)
hawlkhiatding = (i:1) (t:v) (f:politics/everyday) (w:will drive out/to expel) (d:<hawlkhiat> and <ding> written as one word: will drive out, in order to expel; {hawlkhiatding geelna} is a plan to expel) (j:hawlkhiat/ding) (r:zd:21409/zd:12963) (q:draft)
hawlkhuan = (i:1) (t:n) (f:travel/politics) (w:permission to drive/right to drive) (d:<hawl>, drive, with <khuan>, permission: leave to drive a vehicle; {mawtaw hawlkhuan pia} is give permission to drive cars) (j:hawl/khuan) (r:zd:14768/zd:16809) (q:draft, low confidence)
hawllua = (i:1) (t:v) (f:travel) (w:drive too fast/speed) (d:<hawl>, drive, and <lua>, too much, written as one word, usually as {hat hawllua}: drive too fast) (j:hawl/lua) (r:zd:11051/zd:17353) (q:draft)
hawlna = (i:2) (t:n) (f:travel) (w:driving) (d:noun form of <hawl> for a vehicle: the driving of a car or train, after <mawtaw> or <meileng>; before a noun it names what serves for driving, as {mawtaw hawlna licence}, a driving licence) (r:zd:15408/zd:22499/zd:16595) (q:draft)
hawlnu = (i:1) (t:n) (f:travel) (w:woman driver/driver) (d:<hawl>, drive, with <nu>, the woman who does it: a woman who drives a vehicle, mostly as {mawtaw hawlnu}) (b:hawl) (r:zd:11177/zd:15429) (q:draft)
hawlpen = (i:1) (t:phrase) (f:travel) (w:the one driving/the driver) (d:<hawl>, drive, and the topic marker <pen> written as one word after the name of a vehicle: the one who drives it, the driver) (j:hawl/pen) (r:zd:11319/zd:14521) (q:draft)
hawlthei = (i:1) (t:v) (f:travel) (w:can drive/be able to drive) (d:<hawl> and <thei> written as one word: be able to drive a vehicle) (j:hawl/thei) (r:zd:15649/zd:16809) (q:draft)
hawltheihna = (i:1) (t:n) (f:travel) (w:ability to drive/permission to drive) (d:<hawl>, drive, and <theihna> written as one word: being able or allowed to drive; {mawtaw hawltheihna} with Licence is a driving licence) (j:hawl/theihna) (r:zd:15451/zd:15201) (q:draft)
hawm = (i:2) (t:adj) (f:everyday) (w:empty/hollow) (d:with nothing inside: empty or hollow, and of ears of grain thin; {khut hawm guak} is empty-handed) (s:awng/hawmguak) (a:dim) (q:draft)
hawm = (i:1) (t:v) (f:social) (w:divide/distribute/share) (d:give each person a part of something: divide land, goods or spoil among people, or share what one has with others) (s:khen/sehkhen) (r:45.12.13) (q:draft)
hawmding = (i:1) (t:v) (f:social/work) (w:will distribute/to share out/to be handed out) (d:<hawm>, distribute or manage, and <ding> written as one word: to be distributed, will share out; with <vai> it is to manage affairs) (j:hawm/ding) (r:zd:19197/zd:22159) (q:draft)
hawmhawm = (i:1) (t:v) (f:everyday/social) (w:keep distributing/hand out/share out) (d:<hawm>, distribute or share, said twice: go on handing out or sharing, to one after another) (b:hawm) (r:zd:24234) (q:draft)
hawmkhiading = (i:1) (t:v) (f:work/media) (w:will release/will distribute/to issue) (d:<hawmkhia> and <ding> written as one word: will give out, and of a product or an album, will release) (j:hawmkhia/ding) (r:zd:16442/zd:14987) (q:draft)
hawmkhiata = (i:1) (t:v) (f:media/social) (w:has been distributed/now released) (d:<hawmkhia>, distribute, with the particle <ta>, now, written as one word and used in headlines: has now been given out or released) (j:hawmkhia/ta) (r:zd:21255) (q:draft)
hawmkhiatding = (i:1) (t:v) (f:everyday/work) (w:to distribute/to be shared out) (d:<hawmkhiat> and <ding> written as one word: will distribute, is to be given out or supplied) (j:hawmkhiat/ding) (r:zd:23554/zd:18024) (q:draft)
hawmkhiatna = (i:1) (t:n) (f:social/work) (w:distribution/giving out/release) (d:<hawmkhiat>, distribute, with the noun suffix <na>: the giving out of something to many people, as money, water, electricity or news; of a book, its release) (b:hawmkhia) (r:zd:24396/zd:16014/zd:24060) (q:draft)
hawmkhiatsawm = (i:1) (t:v) (f:media/work) (w:plan to release/intend to distribute) (d:<hawmkhiat>, give out, with <sawm>, intend, written as one word: be about to release or distribute a product, a film or the like) (j:hawmkhiat/sawm) (r:zd:11504/zd:15414) (q:draft)
hawmkhop = (i:1) (t:v) (f:social/politics) (w:consult together/plan together/share) (d:<hawm> and <khop> written as one word, the form of <hawmkhawm> used before <ding> and similar words: with <vai>, take counsel and manage a matter together, share in running it) (j:hawm/khop) (r:zd:24658/zd:19239) (q:draft)
hawmpih = (i:1) (t:v) (f:social) (w:arrange for/see to for/share with) (d:<hawm>, share out or arrange, with <pih>, for or with someone: with <vai>, see to a matter on behalf of someone, help him arrange it) (b:hawm) (r:zd:17341/zd:22897) (q:draft)
hawmsawm = (i:1) (t:v) (f:social/media) (w:share/pass on/distribute) (d:give to others what one has or knows, pass a text or a piece of news on to them) (r:zd:24115/zd:23904/zd:24276) (q:draft)
hawmsem = (i:1) (t:v) (f:social/food) (w:share out/share with others) (d:<hawm>, share, with <sem>; known from the proverb {hawmsem nungta, nebum si}, the one who shares lives and the one who eats it all alone dies) (r:zd:24072) (q:draft, low confidence)
hawmsiam = (i:1) (t:adj) (f:social) (w:generous/good at sharing) (d:<hawm>, share out, with <siam>, skilled: sharing what one has freely and fairly; also to share out well, as in {nasep hawmsiam}, divide the work well. The proverb {hawmsiam nungta, nebum si} says that the one who shares lives and the one who eats alone dies) (r:zd:22171/zd:22391) (q:draft)
hawmsiamna = (i:1) (t:n) (f:social/religion) (w:fair sharing/generosity/providence) (d:<hawmsiam>, good at sharing out, with the noun suffix <na>: sharing or allotting things well and fairly; {Pasian' hawmsiamna} is glossed as providence) (b:hawmsiam) (r:zd:22391) (q:draft, low confidence)
hawmtawh = (i:1) (t:v) (f:social) (w:find fault with/criticize/blame) (d:be dissatisfied with a person and speak ill of him; {hawmtawh omlo} is with nothing to find fault with; also written <hawmthawh>) (r:zd:16820/zd:11917) (q:draft, low confidence)
hawmte = (i:2) (t:n) (f:nature) (w:caves/hollows) (d:plural of <hawm>, hollow, written apart after <suang>, stone: {suang hawmte} are caves, the same as <suanghawm> with the plural ending; not the dead bodies of {luang hawmte}) (r:ts:4885) (q:draft, low confidence)
hawmthawhhuai = (i:1) (t:adj) (f:everyday) (w:unimpressive/paltry/of little account) (d:<hawmthawh>, count as too little, with <huai>: such that one finds it too little, poor or not worth much) (b:hawmthawh) (r:zd:17951) (q:draft, low confidence)
hawmthawhna = (i:1) (t:n) (f:social) (w:criticism/fault-finding/disparagement) (d:finding fault with what others do and counting it as too little; named together with <gensiatna> and <phunsanna>) (b:hawmthawh) (r:zd:25354/zd:16424) (q:draft)
hawmthei = (i:1) (t:v) (f:social) (w:can share/be able to give out/can donate) (d:<hawm>, share out, and <thei> written as one word: be able to share or give a part of something, as {sisan hawmthei}, able to give blood) (j:hawm/thei) (r:zd:10743/zd:16442) (q:draft)
hawn = (i:1) (t:v) (f:everyday) (j:hon) (r:zd:20572/zd:24390) (q:draft, low confidence)
hawng = (i:2) (t:n) (f:everyday) (w:casing/wrapper/empty container) (d:the empty man-made cover left when its content is used up, as a spent bullet casing, {thautang hawng}, or the wrapper of food that was eaten; not the natural skin of a fruit or tree) (r:zd:12437/zd:15501) (q:draft)
