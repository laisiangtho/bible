taampi = (i:1) (t:n) (f:nature) (w:forest/jungle) (d:thick forest, wild wooded country, as in {singpona taampi}, a forest where trees grow, and {taampi sung}, through the jungle; in one article the same spelling stands for <tampi>, many) (r:zd:11400/zd:22746) (q:draft, low confidence)
taang = (i:3) (t:n) (f:media/religion) (w:stanza/verse) (d:one stanza of a song or hymn, counted as {taang khat}, {a taang nihna}, the second stanza; not grain and not shine) (r:zd:9240/zd:9215) (q:draft)
taangban = (i:1) (t:n) (f:home) (j:tangban) (r:zd:19788/zd:15998) (q:draft)
