tutsa = (i:1) (t:adv) (f:everyday/body) (w:sitting/seated/while sitting) (d:<tut>, sit, with <sa>: in a sitting position, as a posture for prayer beside {din'sa}, standing; {tutsa lungphona} is a sit-in protest) (b:tut) (r:zd:18097/zd:20999) (q:draft)
