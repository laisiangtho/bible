technical = (i:1) (t:adj) (f:work/education) (w:technical) (d:English word placed before a Zolai noun, as in {technical pilna}, technical knowledge; most often it stands inside English names and terms) (o:English) (r:zd:20007/zd:20041) (q:draft, low confidence)
Technician = (i:1) (t:n) (f:work) (w:technician) (d:a person trained to work with machines or laboratory equipment; mostly written with a capital) (o:English) (r:zd:15103/zd:21554) (q:draft)
Technicians = (i:1) (t:n) (f:work) (w:technician) (d:the English plural used as a Zolai noun: skilled workers who repair or check equipment) (o:English) (r:zd:17147/zd:20186) (q:draft)
technology = (i:1) (t:n) (f:it/education) (w:technology) (o:English) (r:zd:22830/zd:22341) (q:draft)
teci pang = (i:1) (t:v) (f:religion/social) (w:testify/bear witness/witness) (d:<teci>, witness, and <pang>, here take a stand as: to bear witness or give testimony; what is testified stands before it, the person in whose favour with <ading>) (r:zd:14887/zd:23975/zd:21042) (q:draft)
tedan = (i:1) (t:phrase) (f:everyday) (w:like/in the way of) (d:the plural <te> and <dan> written as one word after a noun or a name: like those, in the same way as they) (j:te/dan) (r:zd:24040) (q:draft, low confidence)
Tedim = (i:1) (t:name) (c:khua/land) (f:travel/social) (w:Tedim) (d:town in the north of Chin State in Myanmar and the region around it) (r:zd:22746/zd:24610) (q:draft)
Tedim Labu = (i:1) (t:name) (f:religion) (w:Tedim Hymnal/Tedim hymn book) (d:<Tedim> with <labu>, hymn book: the hymnal in the Tedim language used in the churches; a hymn is cited by its number after the name) (r:ts:301/zd:19156) (q:draft)
Tedimah = (i:1) (t:adv) (f:travel/social) (w:in Tedim/at Tedim/to Tedim) (d:<Tedim> and <ah> written as one word: in or to the town of Tedim) (j:Tedim/ah) (r:zd:20176/ts:3375) (q:draft)
Tedimgam = (i:1) (t:name) (c:land) (f:travel/politics) (w:Tedim region/Tedim area) (d:<Tedim> and <gam> written as one word: the Tedim country, the town of Tedim and the region around it in Chin State) (j:Tedim/gam) (r:zd:23767) (q:draft)
Tedimin = (i:1) (t:phrase) (f:social/travel) (w:Tedim) (d:<Tedim> with the marker <in> written as one word: Tedim as the doer of the action) (j:Tedim/in) (r:zd:23767/zd:17060) (q:draft)
Tedimlam = (i:1) (t:name) (c:land) (f:travel/social) (w:Tedim area/Tedim side) (d:<Tedim> and <lam>, side or direction, written as one word: the Tedim region and its people, as in {Tedimlam Zomite}, and also toward Tedim) (j:Tedim/lam) (r:zd:21815/zd:16924) (q:draft)
Tedimmi = (i:1) (t:name) (c:people) (f:social) (w:Tedim people/Tedim person) (d:<Tedim> and <mi>, person, written as one word: a person or the people of Tedim, those who speak the Tedim dialect) (j:Tedim/mi) (r:zd:22802/zd:13043) (q:draft)
Tedimte = (i:1) (t:name) (c:people) (f:social) (w:Tedim people) (d:the people of Tedim town and township in Chin State, <Tedim> with the plural <te>) (b:Tedim) (r:zd:25097/ts:301/zd:24014) (q:draft)
tee = (i:2) (t:n) (f:food) (w:pulp/fibre/residue) (d:what is left in the mouth when the juice of something chewed has been swallowed, set against {a tui}, its juice; not the verb shine) (r:zd:24028) (q:draft, low confidence)
teeiteei = (i:2) (t:adv) (f:everyday/time) (w:or other/without fail/for certain) (d:after <khat>, one, or a time word such as <hunkhat> and <khatvei>: one or another for certain, at some time without fail, as <teitei.2>; after a verb the other sense, keep on doing, applies) (s:teitei) (r:zd:17383/zd:20537/zd:24280) (q:draft)
teek = (i:1) (t:adj) (f:everyday/family) (w:old/aged) (d:advanced in years, said of people; also as a verb, grow old) (s:ham/khangham) (a:khangno) (r:1.18.11) (q:draft)
Teeklui = (i:1) (t:name) (c:khua) (f:travel) (w:Teeklui) (d:a village near Tedim in Chin State, Myanmar) (r:zd:14992/zd:22444) (q:draft)
teekte = (i:2) (t:n) (f:family) (w:parents-in-law/in-laws) (d:the father and mother of the spouse, chiefly what a wife calls the parents of her husband, with a possessive as in {na teekte}; named beside the own <nu leh pa>, mother and father) (r:zd:26953/zd:19593/zd:24176) (q:draft)
teekte = (i:3) (t:n) (f:home) (w:owners/householders/hosts) (d:after <inn>, house: {inn teekte}, the owners of a house or the hosts with whom one stays, the plural of <innteek> written as two words) (r:zd:22827/zd:14946) (q:draft, low confidence)
teelcin = (i:1) (t:adj) (f:politics) (w:elected) (d:chosen in an election, <teel>: {teelcin MP} is an elected member of parliament and {teelcin President} the president elect) (r:zd:20795/zd:11720) (q:draft)
teelcing = (i:1) (t:v) (f:politics) (w:elect/be elected) (d:built on <teel>, choose: be chosen by vote for an office; before a noun it means elected, as in {teelcing taangmi}, elected representatives, and {teelcing ngah} is win election) (r:zd:19606/zd:11456/ts:2335) (q:draft)
teeldan = (i:1) (t:n) (f:politics/everyday) (w:way of choosing/method of selection) (d:<teel>, choose, and <dan>, manner, written as one word: how someone or something is chosen) (j:teel/dan) (r:zd:23306/zd:25517) (q:draft)
teelding = (i:1) (t:v) (f:everyday/politics) (w:to choose/will choose) (d:<teel>, choose, and <ding>, will or to, written as one word; before a noun, that is to be chosen: {teelding dang nei lo} is have no other choice) (j:teel/ding) (r:zd:25866/zd:24736) (q:draft)
teelhuai = (i:1) (t:adj) (f:everyday) (w:worth choosing/to be chosen/preferable) (d:<teel>, choose, with the suffix <huai>, worthy of: that should be chosen, a good choice) (j:teel/huai) (r:zd:11452/zd:24217) (q:draft)
teelkhiading = (i:1) (t:v) (f:politics/media) (w:will be selected/to be chosen) (d:<teelkhia> and <ding> written as one word, mostly after <aki>: that will be picked out, that are to be selected) (j:teelkhia/ding) (r:zd:11118) (q:draft)
teelkhial = (i:1) (t:v) (f:everyday/social) (w:choose wrongly/make the wrong choice) (d:<teel>, choose, and <khial>, wrongly, written as one word) (j:teel/khial) (r:zd:15720/zd:25569) (q:draft)
teelkhialh = (i:1) (t:v) (f:everyday/social) (w:choose wrongly/make a wrong choice) (d:<teel>, choose, and <khialh>, wrongly, written as one word) (a:teelsiam) (j:teel/khialh) (r:zd:23138/zd:22921) (q:draft)
teelkhiata = (i:1) (t:v) (f:politics/media) (w:has been chosen/selected) (d:<teelkhia>, choose out, and the particle <ta>, now, written as one word, in headlines after <ki>: has now been chosen) (j:teelkhia/ta) (r:zd:11118/zd:18882) (q:draft)
teelkhuan = (i:1) (t:n) (f:social/education) (w:right to choose/freedom of choice) (d:<teel>, choose, with <khuan>, permission or right, written as one word: the right or opportunity to choose) (j:teel/khuan) (r:zd:24296/zd:24281) (q:draft, low confidence)
teelsiam = (i:1) (t:v) (f:everyday) (w:choose well/choose wisely) (d:<teel>, choose, and <siam>, skilled, written as one word: know how to choose, choose with good judgement) (j:teel/siam) (r:zd:23035/zd:21095/zd:23138) (q:draft)
teelsiamding = (i:1) (t:v) (f:everyday/education) (w:should choose well/to choose wisely) (d:<teelsiam>, choose well, and <ding>, to or will, written as one word: that one should choose wisely) (j:teelsiam/ding) (r:zd:12464/zd:20213) (q:draft)
teelsiamna = (i:1) (t:n) (f:everyday/education) (w:skill in choosing/good choice/discernment) (d:<teelsiam>, choose well, with the noun ending {-na}: the ability to choose well, or a choice made well) (b:teelsiam) (r:zd:21083/zd:26974) (q:draft)
teeltawm = (i:1) (t:v) (f:everyday/social) (w:choose for oneself/choose freely) (d:<teel>, choose, with <tawm>, on one's own, written as one word: make one's own choice; {teeltawm theihna} is the freedom to choose) (j:teel/tawm) (r:zd:23975/zd:14805) (q:draft, low confidence)
teeltheihding = (i:1) (t:v) (f:everyday/education) (w:to be able to choose) (d:<teel>, choose, and <theihding>, so as to be able, written as one word: so that one can choose, what can be chosen) (j:teel/theihding) (r:zd:20095/zd:20213) (q:draft)
teeltheihna = (i:1) (t:n) (f:politics/social) (w:choice/freedom to choose/right to choose) (d:<teeltheih>, be able to choose, with the noun ending <na>: the power or freedom to choose or to elect) (b:teeltheih) (r:zd:24296/zd:22701) (q:draft)
teeltuam = (i:2) (t:v) (f:religion/social) (w:choose specially/single out/set apart) (d:choose one out from the others; before a noun it describes the one chosen, as {Pasian' teeltuam minam}, the people God has chosen for himself) (r:ts:3366/zd:21510/zd:23896) (q:draft)
Teeltui = (i:1) (t:name) (c:khua) (f:social) (w:Teeltui) (d:name of a Zomi village, found in the name of the association of its people in Malaysia, {Teeltui Vontawi Innkuan}) (r:zd:23171) (q:draft, low confidence)
teen = (i:2) (t:n) (f:home) (w:clothing/clothes) (d:only in the pair {silh le teen} or {silh leh teen}, what is put on and what is wrapped round the body: clothing as a whole, with <silh>, wear; not {teen}, dwell) (r:zd:22496/zd:10777/zd:24123) (q:draft)
teena = (i:1) (t:n) (f:home) (j:teenna) (r:zd:24153/zd:24417) (q:draft)
teenager = (i:1) (t:n) (f:social/family) (w:teenager) (d:a young person of about thirteen to nineteen years, mostly added as an English word beside a Zolai description) (o:English) (r:zd:22646/zd:11721) (q:draft, low confidence)
teengcip = (i:1) (t:v) (f:home/everyday) (w:live permanently/stay settled/dwell) (d:<teeng>, dwell, with <cip>, fast, written as one word: live in a place without leaving it) (j:teeng/cip) (r:zd:10821) (q:draft, low confidence)
teengin = (i:2) (t:v) (f:home) (w:wear/put on) (d:<teeng>, wear a garment on the lower body such as trousers or a skirt, with the linking ending <in>: wearing; not <teeng>, dwell, which follows a place with <ah> or <sungah>) (r:zd:10823/zd:17661) (q:draft)
teenglo = (i:1) (t:v) (f:everyday/home) (w:not wear on the lower body/wear nothing below) (d:<teeng> and <lo>, not, written as one word and set beside <silhlo>, not wearing on the upper body; <teeng> is here wear a garment round the waist, not dwell) (j:teeng/lo) (r:zd:19365/zd:20501) (q:draft)
teengta = (i:1) (t:n) (f:family/home) (w:playing house/make-believe play) (d:the play of children who pretend to keep house; {teengta van} is a toy or plaything) (r:zd:13194) (q:draft, low confidence)
teengta = (i:2) (t:v) (f:home) (w:now live/have settled) (d:<teeng> and <ta> written as one word: now live, have come to live in a place) (j:teeng/ta) (r:zd:20769) (q:draft, low confidence)
teennading = (i:1) (t:phrase) (f:home) (w:place to live/for living in/housing) (d:<teenna>, dwelling, and <ding>, for, written as one word: for living in, or a place to live; {teennading inn} is a house to live in) (j:teenna/ding) (r:zd:10772/zd:20752/zd:11070) (q:draft)
teenpihding = (i:1) (t:v) (f:family) (w:will marry) (d:<teenpih>, marry or live with as spouse, and <ding>, will, written as one word: will marry, the one to be married) (j:teenpih/ding) (r:zd:12512) (q:draft)
teenzawh = (i:1) (t:v) (f:family/time) (w:have been married) (d:<teen> and <zawh> written as one word, after <ki>: the time since a couple married or began to live together; {aki teenzawh uh kum 12} is it is twelve years since they married) (j:teen/zawh) (r:zd:11872/zd:12567) (q:draft)
teep = (i:3) (t:v) (f:health/everyday) (w:smoke) (d:draw in the smoke of tobacco, after <za>, tobacco, or <zateep>, cigarette; the sucking sense applied to smoking) (r:zd:20764/zd:10929) (q:draft)
teeplo = (i:1) (t:v) (f:health) (w:not smoke/non-smoking) (d:<teep>, smoke, and <lo> written as one word: not smoke; {a teeplo te} are those who do not smoke) (j:teep/lo) (r:zd:10929/zd:20764) (q:draft)
teetaa = (i:1) (t:adv) (f:everyday) (j:teta) (r:zd:15905/zd:11409) (q:draft, low confidence)
tegeel = (i:1) (t:adv) (f:everyday) (j:tegel) (r:zd:25866/zd:17651) (q:draft)
teh = (i:4) (t:conj) (f:everyday/time) (w:when/after) (d:spoken form of <ciangin>, when, placed after a verb, <khit> or <ding>: {khit teh}, also written <khitteh>, is after, and {ding teh} is when about to) (s:ciangin) (r:zd:24786/zd:23036/zd:24411) (q:draft)
tehkaak = (i:1) (t:v) (f:everyday/education) (j:tehkak) (r:zd:22644/zd:23890) (q:draft)
tehkakna = (i:1) (t:n) (f:everyday/education) (w:comparison) (d:<tehkak>, compare, with the noun suffix <na>; {tawh tehkakna in} is in comparison with) (b:tehkak) (r:zd:16312/zd:22803/zd:12807) (q:draft)
tehna = (i:2) (t:n) (f:everyday) (w:comparison) (d:<teh> in the sense compare, with the noun suffix <na>: the comparing of one thing with another; {tawh tehna in} after a noun is compared with) (r:zd:23830/zd:23529/zd:22329) (q:draft)
Tehran = (i:1) (t:name) (c:city) (f:politics/travel) (w:Tehran) (d:capital city of <Iran>) (r:zd:10945/zd:17301) (q:draft)
tehteh = (i:1) (t:v) (f:social/everyday) (w:keep measuring/judge by) (d:<teh>, measure, said twice: go on measuring or judging others by some standard; with <tawh>, by) (b:teh) (r:zd:22034/zd:16424) (q:draft)
tehteh = (i:2) (t:adv) (f:body/health) (w:again and again/often) (d:after <zun>, urine: passing water again and again, wetting oneself often; sense inferred from two sentences) (r:zd:19676) (q:draft, low confidence)
tehthei = (i:1) (t:v) (f:everyday) (w:can be compared/be comparable) (d:<teh>, measure or compare, and <thei>, can, written as one word; after <aki> and with <tawh>, can be compared with, mostly in a negative statement) (s:tehtheih) (j:teh/thei) (r:zd:21458/zd:19239) (q:draft)
tehtheih = (i:2) (t:adj) (f:work/education) (w:measurable) (d:<teh>, measure, with <theih>, can be: that can be measured, said of a goal or result and without <tawh>; not comparable with something else) (r:zd:20905) (q:draft, low confidence)
tehtheihlo = (i:1) (t:adj) (f:everyday) (w:incomparable/beyond compare) (d:<tehtheih>, comparable, and <lo>, not, written as one word, with <tawh> before it: that cannot be compared with) (j:tehtheih/lo) (r:zd:16928/zd:25414) (q:draft)
tei = (i:5) (t:v) (f:education/media) (w:translate) (d:put a writing, a song or the Bible into another language, often as {tei khia}; in the Bible text {tei} is copy, in present-day writing it is nearly always translate) (r:zd:24157/zd:9451/zd:11891) (q:draft)
tei hangin = (i:1) (t:conj) (f:everyday) (w:even though/although indeed) (d:the emphatic word <tei>, indeed or certainly, and <hangin>, although: placed after a verb at the end of a clause, it grants that the thing is certainly so before the main clause says what holds in spite of it; often after <ahih>) (r:zd:23038/zd:22136) (q:draft)
teii = (i:1) (t:part) (f:everyday) (j:tei) (r:zd:15570/zd:21925) (q:draft, low confidence)
teikhia = (i:1) (t:v) (f:education/media) (w:translate/copy out/transcribe) (d:<tei>, copy, with <khia>, out: write a text out again from another writing; after the name of a language with <in> it means translate into that language, as {Mangkamin teikhia}, translate into English) (j:tei/khia) (r:zd:9234/zd:9211/zd:11452) (q:draft)
teikhiat = (i:2) (t:v) (f:education/media) (w:translate) (d:put a writing, a book or a song into another language, the present-day meaning of {teikhiat} as of <tei.5>: the language is named before it, as {Mangkam-a}, into English, or {Kawllai pana}, from Burmese; after a name with the possessive it is that person's translation) (b:tei) (r:zd:9211/zd:24132) (q:draft)
Teimei = (i:1) (t:name) (c:people) (f:social) (w:Meitei/Manipur) (d:name used in songs for the Meitei, the people of Manipur to the north of the Zomi) (r:ts:301) (q:draft, low confidence)
tein = (i:1) (t:num) (f:work) (w:hundred thousand/lakh) (d:one hundred thousand, the unit in which large amounts of Myanmar money are counted: {tein 40} is four million) (o:Burmese, thein) (r:zd:25212/zd:23439/zd:24390) (q:draft)
teina = (i:2) (t:n) (f:education/religion) (w:translation/translating) (d:<tei>, translate, with the noun suffix <na>: the putting of a writing, mostly the Bible, into another language; not cleverness) (r:zd:22972/ts:9862) (q:draft)
teisak = (i:1) (t:v) (f:education/religion) (w:translate for/have translated) (d:<tei>, copy out or translate, with <sak>: translate a writing for someone, as the Bible into the language of a people) (b:tei) (r:zd:9234/zd:24157) (q:draft, low confidence)
teisawn = (i:1) (t:v) (f:education/media) (w:translate/render) (d:put a writing into another language and so pass it on; <tei>, copy, with <sawn>, on to others; {teisawn na} is translation) (r:zd:17478/zd:20058) (q:draft)
teitang = (i:1) (t:adj) (f:everyday/education) (w:clever/sharp/quick-witted) (d:quick and sharp in mind, seemingly built on <tei>, clever; also used as a noun, cleverness) (r:zd:13166/zd:12688) (q:draft, low confidence)
teitei = (i:2) (t:adv) (f:everyday) (w:without fail/by all means/definitely) (d:of something that must or will happen whatever comes, not of a person who insists: without fail, at any cost; {khat teitei} is one or another for certain, at least one) (r:zd:20920/zd:24490/zd:21661) (q:draft)
teiteileh = (i:1) (t:conj) (f:everyday/politics) (w:if nevertheless/if one insists on) (d:<teitei>, insistently, and <leh>, if, written as one word after a verb: if someone does it all the same, in spite of a ban) (j:teitei/leh) (r:zd:12611/zd:11715) (q:draft)
Teizaang = (i:1) (t:name) (c:people) (f:social) (w:Teizang) (d:one of the Zomi groups and its form of speech, named beside Dim, Saizaang, Sihzaang and Losau; {Teizaang awsuah} is the Teizang dialect) (r:zd:13043/zd:25628) (q:draft)
Teizang = (i:1) (t:name) (c:people) (f:social) (w:Teizang) (d:one of the Zomi groups of the Tedim area and their dialect; {Teizang kampau} is the Teizang dialect or one who speaks it) (r:zd:24165/zd:24157/zd:22802) (q:draft)
tek ni = (i:1) (t:part) (f:everyday/social) (w:let us each/let us all) (d:<tek>, each, and a sentence-final hortative word, let us, which is not the <ni> that means day: placed after a verb to urge everyone, the speaker included, to do something; also written as one word <tekni>) (r:zd:25282/zd:25177/zd:24746) (q:draft)
teka = (i:1) (t:phrase) (f:everyday) (w:all/each one) (d:<tek>, each or all, and the linking <a> written as one word after a verb: all do so, and) (j:tek/a) (r:zd:24235/zd:15857) (q:draft, low confidence)
tekding = (i:1) (t:part) (f:everyday) (w:each should/each is to) (d:<tek> and <ding> written as one word after a verb: every one should do it, each is to do it) (j:tek/ding) (r:zd:15237/zd:23756) (q:draft)
tekhat = (i:1) (t:phrase) (f:social) (w:one of the/a member of) (d:<te> and <khat> written as one word, after the name of a people or group: one of them, one person of that people) (j:te/khat) (r:zd:11850/zd:10662/zd:15756) (q:draft)
tekhawng = (i:1) (t:part) (f:everyday) (w:and the like/such as) (d:<te> and <khawng> written as one word, placed after a name or a noun: such people or things as these, people like this one) (j:te/khawng) (r:zd:15937/zd:24381) (q:draft)
tekiang = (i:1) (t:phrase) (f:everyday) (d:the plural <te> and <kiang>, presence, written as one word after a noun: to, with or from those people) (j:te/kiang) (r:zd:23108/zd:25916/zd:15437) (q:draft)
tekiangah = (i:1) (t:phrase) (f:everyday) (w:to them/to those) (d:the plural <te> and <kiangah>, to, written as one word after a noun: to those people) (j:te/kiangah) (r:zd:25305/zd:21174) (q:draft)
tekni = (i:1) (t:part) (f:everyday) (w:let us each) (d:<tek>, each one, and the sentence-final <ni>, let us, written as one word: let each of us do it) (j:tek/ni) (r:zd:16442/zd:15012) (q:draft)
teknu = (i:1) (t:n) (f:family) (j:teeknu) (r:zd:16606) (q:draft)
tekpa = (i:1) (t:n) (f:family) (w:father-in-law) (d:the father of one's spouse, in the articles the father of a woman's husband; the mother-in-law is <teknu>) (r:zd:19474) (q:draft)
tekpan = (i:1) (t:adv) (f:everyday) (w:from each) (d:<tek>, each, and <pan>, from, written as one word: from each one, each from his own place or ability) (j:tek/pan) (r:zd:22217/zd:23338) (q:draft)
