mualliam = (i:1) (t:v) (f:social/health) (w:pass away/die) (d:respectful word for the death of a person, as in a death notice; {hong mualliam san} is he has passed away and left us) (r:zd:21421/zd:25199/zd:24107) (q:draft)
Muallum = (i:1) (t:name) (c:khua) (f:travel) (w:Muallum) (d:a Zomi village in Chin State, Myanmar, near <Laaitui>) (r:ts:6397/zd:21182) (q:draft)
mualmi = (i:1) (t:n) (f:politics/social) (w:hill people/ethnic nationalities/ethnic minorities) (d:<mual>, hill, with <mi>, people: the hill peoples of Myanmar, the ethnic nationalities as distinct from the Burman majority; <mualmi thautawi> are the ethnic armed groups) (r:zd:25053/zd:17745/zd:25026) (q:draft)
mualmi thautawi = (i:1) (t:n) (f:politics) (w:ethnic armed group/ethnic armed organization) (d:<mualmi>, hill people, the ethnic nationalities, and <thautawi>, one who bears arms: the armed groups of the ethnic nationalities of Myanmar; often followed by <pawl> or <kipawlnate>, groups, organizations) (r:zd:25026/zd:22880) (q:draft)
mualmi thautawite = (i:1) (t:n) (f:politics) (w:ethnic armed groups/ethnic armed organisations) (d:<mualmi>, hill people, the ethnic nationalities, and <thautawite>, those who carry guns: the armed organisations of the ethnic nationalities of Myanmar, named beside {Kawl kumpi}, the Burmese government, in writing on the ceasefire and peace talks) (r:zd:25026/zd:22880) (q:draft)
mualmite = (i:1) (t:n) (f:social/politics) (w:hill people/highlanders/hill peoples) (d:<mual>, hill, and <mite>, people, written as one word: the peoples of the hills, said of the ethnic peoples of Myanmar as against the Burmans of the plains) (j:mual/mite) (r:zd:24950/zd:25053/zd:12370) (q:draft)
mualmong = (i:1) (t:n) (f:nature) (w:horizon/skyline) (d:<mual>, mountain, with <mong>, edge: the far line of the hills; {mualmong et bang} is like gazing at the horizon, said of something still far off) (r:zd:24455/zd:24490/zd:25360) (q:draft)
mualpen = (i:1) (t:n) (f:nature) (w:the mountain) (d:<mual>, mountain, and the topic marker <pen> written as one word: the mountain, as the thing the sentence is about) (j:mual/pen) (r:zd:15382) (q:draft)
mualsangdawn = (i:1) (t:n) (f:nature) (w:mountain top/summit/high peak) (d:<mualsang>, high mountain, and <dawn>, top, written as one word: the top of a high mountain) (j:mualsang/dawn) (r:zd:20023/zd:17241) (q:draft)
mualsuah = (i:1) (t:v) (f:work/social) (w:accomplish/achieve/carry through/reach the goal) (d:bring a task, an aim or a struggle through to its end; {mualsuah dong} is until the goal is reached) (r:zd:21327/zd:25135/zd:25094) (q:draft)
mualsuahpih = (i:1) (t:v) (f:work/social) (w:bring through/lead to the goal/see through) (d:<mualsuah>, reach the goal, and <pih>, with or for someone, written as one word: bring a person or a task through to its end) (j:mualsuah/pih) (r:zd:21049/ts:10582) (q:draft)
mualsuak = (i:1) (t:v) (f:everyday/social) (w:win through/succeed/come through) (d:come through to the end of a struggle, an illness or a hard task; {dam mualsuak} is recover fully) (r:zd:20103/zd:25569) (q:draft, low confidence)
mualtuang = (i:1) (t:v) (f:everyday/body) (w:overflow/brim over/well up) (d:run over the brim; mostly of tears in {khitui mualtuang}, tears overflow, and with <sak> of love made to overflow) (r:zd:15748/zd:10957/zd:25461) (q:draft, low confidence)
mualtuangsa = (i:1) (t:v) (f:body/everyday) (w:brimming over/welling up) (d:<mualtuang>, brim over, with <sa>, already, written as one word; said of tears, {khitui mualtuangsa in}, with tears welling up) (j:mualtuang/sa) (r:zd:17437/zd:12928) (q:draft)
Mualtuk = (i:1) (t:name) (c:place) (f:travel) (w:Mualtuk) (d:a locality on the edge of Tedim town in Chin State, the site of an army post) (r:ts:301/zd:25165) (q:draft, low confidence)
mualtungmi = (i:1) (t:n) (f:social/politics) (w:hill people/highlander/hill tribe) (d:<mualtung>, hill country, and <mi>, person, written as one word: the peoples of the hills of Myanmar, such as the Chin and Kachin, as against the Burmans of the plain) (j:mualtung/mi) (r:ts:3375/zd:17722) (q:draft)
mualtungmite = (i:1) (t:n) (f:social/politics) (w:hill peoples/highlanders/hill tribes) (d:<mualtung>, hill country, with <mite>, people: the peoples of the hill regions of Myanmar, set against the Burmans of the plains) (j:mualtung/mite) (r:zd:22334/zd:24336) (q:draft)
muamkhum = (i:1) (t:n) (f:food) (w:sweet/candy/chocolate) (d:<muam>, hold in the mouth, with <khum>, sweet: a sweet that is sucked, also used for chocolate) (r:zd:21198/zd:23198) (q:draft)
muamna = (i:1) (t:n) (f:body/health) (w:holding in the mouth/chewing) (d:<muam>, hold in the mouth, with the noun ending <na>: the keeping of something such as tobacco in the mouth, named beside eating and drinking) (b:muam) (r:zd:24079/zd:25927) (q:draft, low confidence)
muanglo = (i:1) (t:v) (f:everyday/social) (w:not trust/distrust) (d:<muang>, trust, and <lo>, not, written as one word: not trust, have no confidence in) (j:muang/lo) (r:zd:17285/zd:22023/zd:23352) (q:draft)
muangmawh = (i:1) (t:v) (f:social/family) (w:suspect/distrust/doubt) (d:not trust someone, suspect a person of wrongdoing; said often of suspecting a husband or wife of unfaithfulness, with <tawh> for the other person) (s:ummawh) (r:zd:25201/zd:24056/zd:24677) (q:draft)
muangmawhpah = (i:1) (t:v) (f:social/politics) (w:suspect at once/become suspicious) (d:<muangmawh>, suspect, and <pah>, at once, written as one word: suspect someone straight away) (j:muangmawh/pah) (r:zd:19180/zd:18030) (q:draft)
muangna = (i:1) (t:n) (f:social/religion) (w:trust/confidence) (d:<muang>, trust, with the noun suffix <na>: the trust placed in someone, as {mipi muangna}, the confidence of the public, and {lung muangna}, peace of mind) (b:muang) (r:zd:25323/zd:19397) (q:draft)
muanhuailo = (i:1) (t:adj) (f:everyday/social) (w:unsafe/untrustworthy/unreliable) (d:<muanhuai>, safe or trustworthy, and <lo>, not, written as one word) (j:muanhuai/lo) (r:zd:18893/zd:17250) (q:draft)
muanhuaitak = (i:1) (t:adv) (f:everyday) (w:safely/securely/reliably) (d:<muanhuai>, secure or reliable, and <tak> written as one word, followed by <in> or <dingin>: in a safe and reliable way) (j:muanhuai/tak) (r:zd:17556/zd:19543) (q:draft)
muanhuaizaw = (i:1) (t:adj) (f:everyday/travel) (w:more reliable/safer/more trustworthy) (d:<muanhuai>, reliable, and <zaw>, more, written as one word) (j:muanhuai/zaw) (r:zd:15639/zd:10812) (q:draft)
muanlahna = (i:1) (t:n) (f:everyday/social) (w:distrust/doubt/mistrust) (d:<muanlah>, be unable to trust, with the noun suffix {-na}: the state of not trusting, named beside <uplahna>) (b:muanlah) (r:zd:21803) (q:draft)
muanloh = (i:1) (t:v) (f:everyday/social) (w:not trust/distrust) (d:<muan>, trust, with the negative <loh>, written as one word: not trust; before a noun, the one who is not trusted, as {i muanloh mikhat}, a person we do not trust) (j:muan/loh) (r:zd:22034/zd:18927) (q:draft)
muanlohna = (i:1) (t:n) (f:social) (w:distrust/lack of trust/mistrust) (d:<muan>, trust, with <lohna>, written as one word: not trusting; {ki muanlohna} is distrust of one another or lack of confidence in oneself) (a:muanna) (j:muan/lohna) (r:zd:24699/zd:21817) (q:draft)
muanmawh = (i:1) (t:v) (f:social/media) (w:suspect/doubt/distrust) (d:think that someone may have done wrong or that something is not as it should be; before a noun, suspected or suspicious, as in {muanmawh mi}, a suspect) (s:ummawh) (r:zd:23045/zd:12031/zd:11893) (q:draft)
muanmawhhuai = (i:1) (t:adj) (f:politics/everyday) (w:suspicious/suspect) (d:causing distrust, giving reason to suspect something wrong; said of a thing, a person or behaviour) (r:zd:12220/zd:13082) (q:draft)
muanmawhmi = (i:1) (t:n) (f:politics/media) (w:suspect/suspected person) (d:<muanmawh>, suspect, and <mi>, person, written as one word: a person who is suspected of something) (j:muanmawh/mi) (r:zd:12138) (q:draft)
muanmawhna = (i:1) (t:n) (f:social) (w:suspicion/distrust/doubt) (d:the feeling that someone cannot be trusted or has done wrong) (r:zd:14814/zd:24412) (q:draft)
muanngam = (i:1) (t:v) (f:everyday/social) (w:dare to trust/have confidence in) (d:<muan>, trust, and <ngam>, dare, written as one word: trust without fear) (j:muan/ngam) (r:zd:9427/zd:19774) (q:draft)
muantak = (i:1) (t:adj) (f:social) (j:muantaak) (r:zd:24751/zd:24370) (q:draft)
Muar = (i:1) (t:name) (c:city) (f:travel) (w:Muar) (d:a town and district in the state of Johor, Malaysia) (r:zd:19979/zd:15773) (q:draft)
muban = (i:1) (t:v) (f:everyday) (w:see/perceive/catch sight of) (d:seemingly <mu>, see, with <ban>, reach: come to see or perceive something, also its worth) (j:mu/ban) (r:zd:9426/zd:21134) (q:draft, low confidence)
mucian = (i:1) (t:v) (f:everyday) (w:see clearly/notice/perceive well) (d:<mu>, see, with <cian>, clearly, written as one word: see or notice a thing clearly, take good note of it) (j:mu/cian) (r:zd:9428/zd:21066) (q:draft, low confidence)
mucil = (i:1) (t:v) (f:everyday) (w:first see/first find/see for the first time) (d:<mu>, see or find, with <cil>, at first, written as one word, mostly after <ki>: be seen or found for the first time) (j:mu/cil) (r:zd:12014/zd:16994) (q:draft, low confidence)
Mucu = (i:1) (t:n) (f:education) (w:preschool/nursery school/kindergarten) (d:a school for small children below school age; {Mucu sang} and {Mucu inn} are the preschool and its building) (o:Burmese) (r:zd:24029/zd:24458/zd:15268) (q:draft)
mudahna = (i:1) (t:n) (f:social) (w:hatred/hate/dislike) (d:the feeling of hating a person or a people; <mudah> with the noun suffix {-na}) (b:mudah) (r:zd:8375/zd:21037) (q:draft)
muden = (i:1) (t:v) (f:everyday) (w:always see/keep seeing) (d:<mu>, see, and <den>, always, written as one word: see all the time) (j:mu/den) (r:zd:22023/zd:20725) (q:draft)
muding = (i:1) (t:v) (f:everyday) (w:will see/will find) (d:<mu>, see, and <ding>, will, written as one word: will see, will find or receive) (j:mu/ding) (r:zd:21876/zd:23843/zd:11160) (q:draft)
muh khialh = (i:1) (t:v) (f:social) (w:misjudge/see wrongly/get a wrong impression of) (d:<muh>, see, and <khialh>, go wrong: see someone or something wrongly, form a wrong opinion of; {hong muh khialh loh dingin} is so that they do not misjudge us) (r:zd:22652) (q:draft)
muhbeh = (i:1) (t:v) (f:media/everyday) (w:find more/find in addition) (d:<muh>, see or find, with <beh>, in addition: find further ones besides those already found; {ki muhbeh} is be found in addition) (r:zd:15463/zd:24272) (q:draft)
muhciang = (i:1) (t:v) (f:everyday) (w:when one sees/on seeing) (d:<muh>, see, and <ciang>, when, written as one word) (j:muh/ciang) (r:zd:20800) (q:draft)
muhciangin = (i:1) (t:phrase) (f:everyday) (w:when seeing/on seeing) (d:<muh> and <ciangin> written as one word: when someone sees or saw something) (j:muh/ciangin) (r:zd:20652/zd:20588) (q:draft)
muhcil = (i:1) (t:v) (f:everyday/social) (w:first see/first meet) (d:<muh>, see, and <cil>, at first, written as one word: see for the first time; with the prefix <ki>, as {aki muhcil}, when they first met or when it was first found) (j:muh/cil) (r:zd:12409/zd:11150) (q:draft)
muhcilna = (i:1) (t:n) (f:everyday/time) (w:first sight/first time of seeing) (d:<muh>, see, with <cilna>, first time: the first time one sees something) (j:muh/cilna) (r:zd:19812/zd:25221) (q:draft)
muhdaan = (i:1) (t:n) (f:social/media) (j:muhdan) (r:ts:11162/zd:17295) (q:draft)
muhdan = (i:1) (t:n) (f:social/media) (w:view/opinion/way of seeing) (d:<muh>, see, with <dan>, way: the way someone sees a matter, a view or opinion; {ka muhdan} is my view) (s:muhna) (r:zd:25107/zd:23929/zd:21869) (q:draft)
muhdante = (i:1) (t:n) (f:social/media) (w:views/opinions/ways of seeing) (d:plural of <muhdan>, view: the ways in which someone sees a matter) (b:muhdan) (r:zd:22415/zd:17274) (q:draft)
muhding = (i:1) (t:v) (f:everyday) (w:to see/to find) (d:<muh>, see, and <ding> written as one word: to be seen or found, for seeing; {mipi muhding in} is for the public to see) (j:muh/ding) (r:zd:17884/zd:21869) (q:draft)
muhdingin = (i:1) (t:phrase) (f:everyday/media) (w:for seeing/to be seen by) (d:<muh>, see, and <dingin> written as one word: in order to be seen; {mipi muhdingin} is for the public to see) (j:muh/dingin) (r:zd:20643/zd:17003) (q:draft)
muhi = (i:1) (t:v) (f:everyday) (w:see) (d:<mu>, see, and the sentence-final <hi> written as one word) (j:mu/hi) (r:zd:23784/zd:23492) (q:draft)
muhkhiak = (i:1) (t:v) (f:everyday) (w:find/discover/find out) (d:form of <mukhia>, find out, used before an ending or as a noun: {ka muhkhiak} is what I found) (b:mukhia) (r:zd:10973/zd:21439) (q:draft)
muhkhiat = (i:1) (t:v) (f:everyday/education) (w:find out/discover/observe) (d:form of <mukhia>, find out, used before a noun or an ending; {ka muhkhiat thute} is the things I found out, and so also a finding or discovery) (b:mukhia) (r:zd:22203/zd:19858/ts:3280) (q:draft)
muhkhiatbeh = (i:1) (t:v) (f:media/everyday) (w:find in addition/discover further) (d:<muhkhiat>, find out, with <beh>, in addition, written as one word, mostly after <ki>: more is found or discovered besides what was found before) (r:zd:12941/zd:19180) (q:draft)
muhkhiatleh = (i:1) (t:v) (f:politics/everyday) (w:if found/if found out) (d:<muh> see, <khiat> out and <leh> if, written as one word, mostly as {aki muhkhiatleh}: if it is found out or established) (j:muh/khiat/leh) (r:zd:12171/zd:17066/zd:13024) (q:draft)
muhkhiatna = (i:1) (t:n) (f:education/media) (w:discovery/finding) (d:<muh>, see, with <khiat>, out, and the noun suffix {-na}: a discovery or a finding of research; after <aki> it means where or that something was found, as in {aki muhkhiatna munte}, the places where it was found) (r:zd:23198/zd:24276) (q:draft)
muhkhiatte = (i:1) (t:n) (f:education/media) (w:findings/discoveries) (d:<muhkhiat>, find out, and the plural <te> written as one word: the things found out) (j:muhkhiat/te) (r:zd:24346) (q:draft)
muhkholh = (i:1) (t:v) (f:everyday) (w:foresee/see beforehand) (d:<muh>, see, with <kholh>, beforehand: see or know ahead what is to come; the form used before <ding>, <theih> and other endings) (j:muh/kholh) (r:zd:15422/zd:24079/zd:23301) (q:draft)
muhkholhna = (i:1) (t:n) (f:social/work) (w:vision/foresight/anticipation) (d:<muh>, see, with <kholhna>, doing beforehand, written as one word: seeing ahead what is to come and what should be aimed at) (j:muh/kholhna) (r:zd:20971/zd:24673) (q:draft)
muhkhop = (i:1) (t:v) (f:social/politics) (w:meet together/meet) (d:<muh>, see, and <khop>, together, written as one word; with <ki>, {ki muhkhop}, meet each other, hold a meeting) (j:muh/khop) (r:zd:12680/zd:19820/zd:17915) (q:draft)
muhkhopding = (i:1) (t:v) (f:politics/social) (w:to meet/to hold a meeting) (d:<muhkhop>, meet together, and <ding> written as one word, after <ki> or <aki>: that they will meet each other) (j:muhkhop/ding) (r:zd:19820/zd:11598) (q:draft)
muhkhopna = (i:1) (t:n) (f:social/politics) (w:meeting) (d:written after the prefix <ki>, {ki muhkhopna}: a meeting, a coming together of people or groups to see and talk with one another) (s:kikhopna) (r:zd:20507/zd:15463) (q:draft)
muhkopna = (i:1) (t:n) (f:social) (w:joint meeting/meeting) (d:<muh>, see, with <kop>, together, and the noun suffix <na>, used after the prefix <ki>: {ki muhkopna} is a meeting of two parties together) (r:zd:23114) (q:draft, low confidence)
muhlawh = (i:1) (t:v) (f:religion/everyday) (w:come to find/come to see) (d:<muh>, see or find, with <lawh>, as a result, written as one word: come to see or find someone through what another did) (j:muh/lawh) (r:zd:19223/zd:19244) (q:draft, low confidence)
muhleh = (i:1) (t:v) (f:everyday) (w:if one sees/when one sees) (d:<muh>, see, and <leh>, if or when, written as one word: if or when someone sees) (j:muh/leh) (r:zd:23984/ts:3369) (q:draft)
muhlehtuah = (i:1) (t:n) (f:everyday/education) (w:experience) (d:<muh>, see, <leh>, and, <tuah>, meet with, written as one word: what one has seen and gone through, experience) (s:experience) (j:muh/leh/tuah) (r:zd:20003) (q:draft)
muhloh = (i:1) (t:v) (f:everyday) (w:not see/unseen) (d:<muh> and <loh> written as one word: not seeing, not seen; {mi muhloh nading mun} is a place where people will not see) (j:muh/loh) (r:zd:15653/zd:20860/zd:20627) (q:draft)
muhlohding = (i:1) (t:v) (f:everyday) (w:not to be seen/so as not to see) (d:<muhloh>, not see, and <ding> written as one word: that someone will not see; {kuama muhlohding in} is so that nobody sees) (j:muhloh/ding) (r:zd:13199/zd:11803) (q:draft)
muhlohna = (i:1) (t:n) (f:everyday) (w:not seeing/out of sight) (d:<muh>, see, with <lohna>, the not doing: what one does not see or where one is not seen; {mite muhlohna ah} is where people do not see, out of sight) (j:muh/lohna) (r:zd:21085/zd:11831/zd:20997) (q:draft)
muhmawh = (i:1) (t:adj) (f:religion/education) (w:unseen/invisible) (d:that cannot be seen, from <muh>, see; {muhmawh thu} is things that cannot be seen, and in old song language the word names the unseen world) (r:zd:16254) (q:draft, low confidence)
muhnak = (i:1) (t:v) (f:everyday) (w:whenever one sees/if one sees) (d:<muh>, see, with <nak>, the first part of <nakleh>, written as one word and followed by <leh>: whenever or as soon as one sees) (r:zd:20747/zd:19237) (q:draft)
muhnate = (i:2) (t:n) (f:social/media) (w:views/opinions/observations) (d:plural of <muhna.3>: the ways in which someone sees or judges a matter, his views or findings, often after a possessive or <aituam>, personal; not things seen with the eyes) (b:muhna) (r:zd:23383/zd:22543) (q:draft)
muhnop = (i:2) (t:adj) (f:everyday/media) (w:pleasant to see/worth seeing/enjoyable to watch) (d:<muh>, see, with <nop>, here pleasant: a pleasure to look at, said of a show or a place; before <huai> worth seeing, and before <sa> or <kisa> found pleasant to see, where sense 1 is a person wanting to see) (r:zd:15868/zd:9223/zd:12053) (q:draft)
muhnopsa = (i:1) (t:v) (f:everyday) (w:find attractive to see/be eager to see) (d:<muhnop>, want to see, with <sa>, here feel or find: find a thing a pleasure to look at, be drawn to see it) (r:zd:19812/zd:20076) (q:draft)
muhpak = (i:1) (t:v) (f:everyday) (w:see at once/see at a glance/notice quickly) (d:<muh> and <pak> written as one word: see quickly or at first sight; {muhpak theih} is what can be seen at once) (j:muh/pak) (r:zd:25078/zd:11608) (q:draft)
muhpih = (i:1) (t:v) (f:everyday) (w:see together with/help to see/help to find) (d:<muh> and <pih> written as one word: see something along with someone, or see or find it for someone, help someone to get it) (j:muh/pih) (r:zd:23022/zd:16457/zd:22646) (q:draft, low confidence)
muhtangmah = (i:1) (t:adv) (f:social/media) (w:in full view/openly/in plain sight) (d:<muhtang>, plain sight, with the emphatic <mah>, written as one word and followed by <in>: right before the eyes of the people named, as in {mipi muhtangmah in}, in full view of the public) (j:muhtang/mah) (r:zd:14981/zd:15779) (q:draft)
muhteh = (i:1) (t:v) (f:everyday) (w:when seeing/on seeing) (d:<muh>, see, and <teh>, when, written as one word: when one sees or saw it) (j:muh/teh) (r:zd:14824) (q:draft)
muhthakna = (i:1) (t:n) (f:everyday) (w:new discovery/seeing anew) (d:<muh>, see, with <thakna>, newness: the seeing of something new or for the first time; found only in the title of one piece of writing) (j:muh/thakna) (r:zd:20412) (q:draft, low confidence)
muhtheihding = (i:1) (t:phrase) (f:everyday) (w:to be seen/so that one can see/visible to) (d:<muhtheih> and <ding> written as one word, often followed by <in>: so that someone can see it, in view of) (j:muhtheih/ding) (r:zd:13151/zd:17262) (q:draft)
muhtheihloh = (i:1) (t:adj) (f:everyday/religion) (w:invisible/unseen) (d:<muhtheih> can be seen and the negative <loh> written as one word, placed before a noun: that cannot be seen) (j:muhtheih/loh) (r:zd:22429/zd:24320/zd:22695) (q:draft)
muhthu = (i:1) (t:n) (f:everyday/media) (w:what one sees/things seen/observation) (d:<muh>, see, and <thu>, matter, written as one word: what a person has seen) (j:muh/thu) (r:zd:21741/zd:20484) (q:draft)
muhzawh = (i:1) (t:v) (f:everyday/body) (w:be able to see/manage to see) (d:<muh>, see, and <zawh>, be able, written as one word, mostly before <loh>: {muhzawh loh} is what cannot be seen) (j:muh/zawh) (r:zd:23780/zd:10761) (q:draft)
muhzawhloh = (i:1) (t:adj) (f:everyday) (w:cannot be found/cannot be seen) (d:<muh>, see, and <zawhloh>, unable, written as one word: that cannot be seen or found) (j:muh/zawhloh) (r:zd:13320/zd:23198) (q:draft)
muhzia = (i:1) (t:n) (f:everyday/social) (w:view/point of view/way of seeing) (d:<muh>, see, with <zia>, manner: how someone sees or understands a matter) (r:zd:22683/zd:22023/zd:9428) (q:draft)
mui = (i:2) (t:adj) (f:time/nature) (w:dim/dusky/growing dark) (d:of the daylight at nightfall, after <khua>: {khua mui} is it is dusk, not yet fully dark, the same as the one word <khuamui>; not the tree) (r:zd:15861/zd:24034) (q:draft)
muibunh = (i:1) (t:adj) (f:social/work) (j:muibun) (r:zd:19239/zd:20091) (q:draft)
muibuntak = (i:1) (t:adv) (f:work/everyday) (w:effectively/fruitfully) (d:<muibun> and <tak> written as one word, usually followed by <in>: in a way that has real effect) (j:muibun/tak) (r:zd:22171/zd:12765) (q:draft)
muibuntakin = (i:1) (t:adv) (f:everyday) (w:effectively/fruitfully) (d:<muibun>, effective, and <takin> written as one word: in a way that has effect) (j:muibun/takin) (r:zd:12370) (q:draft)
muibut = (i:1) (t:v) (f:work/everyday) (w:be effective/be productive/flourish) (d:do well and bring results in what one does, make good progress) (r:zd:17177/zd:20516) (q:draft, low confidence)
muibutna = (i:1) (t:n) (f:work/everyday) (w:effectiveness/success/fruitfulness) (d:<muibut>, be effective, with the noun suffix <na>: being effective, good result) (b:muibut) (r:zd:24306/zd:25042) (q:draft)
muikhua = (i:1) (t:n) (f:time/nature) (w:dusk/twilight/nightfall) (d:the fading light of evening, the word <khuamui> with its parts turned round, used in songs and fine writing; {muikhua zing} is dusk falls) (s:khuamui) (r:zd:19381/ts:3369) (q:draft)
muinam = (i:1) (t:n) (f:food) (w:smell of meat/savoury smell) (d:the smell or taste of meat or fat in food, which people and animals long for; {sathau-muinam} is the smell of cooking oil) (r:zd:16803/zd:22569) (q:draft, low confidence)
muisiatna = (i:1) (t:n) (f:social/everyday) (w:sorrow/grief/hurt feelings) (d:second half of the pair {khasiat muisiatna}, sorrow and hurt feelings, a grievance; not found alone) (r:zd:20319/zd:25339) (q:draft, low confidence)
muk = (i:2) (t:n) (f:everyday) (w:muzzle/tip/nozzle) (d:the mouth or pointed end of a thing, which is named before it, as {thau muk}, the muzzle of a gun, and {nawi muk}, the nipple; not the lips of a person) (r:zd:20550/ts:7133) (q:draft, low confidence)
mukei = (i:1) (t:v) (f:everyday) (w:not see/not find) (d:<mu>, see or find, and the negative <kei> written as one word: do not see, do not find) (j:mu/kei) (r:zd:12337/zd:23780) (q:draft)
mukhading = (i:1) (t:v) (f:everyday) (w:will see/probably saw) (d:<mukha>, happen to see, and <ding>, will, written as one word: will come to see, or of a past event must have seen) (j:mukha/ding) (r:zd:11630/zd:15437) (q:draft)
mukhalian = (i:1) (t:v) (f:everyday) (w:catch sight of right then/catch in the act) (d:<mu>, see, and <khalian>, right on, written as one word: see a thing at the very moment it happens, come upon someone in the act) (j:mu/khalian) (r:zd:13018/zd:20136) (q:draft)
mukhalo = (i:1) (t:v) (f:everyday) (w:not see/fail to see/not notice) (d:<mukha>, happen to see, with <lo>, not: not get to see, fail to notice someone or something) (j:mukha/lo) (r:zd:14726/zd:25937) (q:draft)
mukhawm = (i:2) (t:v) (f:social/politics) (w:meet/meet together) (d:after a separately written <ki>, {ki mukhawm}: of two or more people, come together and see one another, meet; the same as the single word <kimukhawm>) (s:kimukhawm) (r:zd:12654) (q:draft, low confidence)
mukhiading = (i:1) (t:v) (f:everyday) (w:will find/will discover) (d:<mukhia>, find out, and <ding>, will, written as one word: will find or discover) (j:mukhia/ding) (r:zd:13044/zd:12359) (q:draft)
mukhiakik = (i:1) (t:v) (f:everyday/media) (w:find again/recover/find) (d:<mukhia>, find, and <kik>, again or back, written as one word: find again something or someone that was lost or missing; with <ki> before it, be found again) (j:mukhia/kik) (r:zd:19560/zd:12057) (q:draft)
mukhial = (i:1) (t:v) (f:everyday/social) (w:misjudge/misunderstand/see wrongly) (d:<mu>, see, with <khial>, wrong: see or judge someone or something wrongly, get a mistaken view of it) (j:mu/khial) (r:zd:24223/zd:17221/zd:21180) (q:draft)
mukhiapah = (i:1) (t:v) (f:everyday/media) (w:find out at once/discover immediately) (d:<mukhia>, find out, and <pah>, at once, written as one word: discover or detect right away; after <ki> it is passive, be found at once) (j:mukhia/pah) (r:zd:15427/zd:12996) (q:draft)
mukhiapan = (i:1) (t:v) (f:everyday/media) (w:find only then/discover at last) (d:<mukhia>, find, with <pan>, only then, written as one word: find or be found only at that point, often after <ki>) (j:mukhia/pan) (r:zd:11660/zd:14642) (q:draft)
mukhiat = (i:1) (t:v) (f:everyday/education) (w:find out/discover/find) (d:form of <mukhia> used before words such as <uh>, <ding> and <thu>: find out, discover) (b:mukhia) (r:zd:12564/zd:12212/zd:19342) (q:draft)
mukhiata = (i:1) (t:v) (f:everyday/media) (w:have found/be found) (d:<mukhia>, find, with the ending <ta>, now or already, written as one word; mostly as {ki mukhiata}, has been found) (j:mukhia/ta) (r:zd:13102/zd:16990) (q:draft)
mukhiathei = (i:1) (t:v) (f:everyday) (w:be able to find/manage to find) (d:<mukhia>, find, and <thei>, able, written as one word: can find, succeed in finding) (j:mukhia/thei) (r:zd:17206/zd:12319) (q:draft)
mukhiazo = (i:1) (t:v) (f:everyday) (w:be able to find/manage to find) (d:<mukhia>, find, and <zo>, manage to, written as one word; often after <ki> and with a negative: have not been able to find someone or something) (j:mukhia/zo) (r:zd:17645/zd:16145/zd:11588) (q:draft)
mukhiazolo = (i:1) (t:v) (f:everyday) (w:cannot find/fail to discover) (d:<mukhia>, find out, and <zolo>, cannot, written as one word: not be able to find or detect something) (j:mukhia/zolo) (r:zd:12831/zd:11568/zd:12274) (q:draft)
mukhollo = (i:1) (t:adj) (f:everyday) (w:unforeseen/unexpected) (d:<mukhol>, foresee, with <lo>, not, written as one word: not seen beforehand; {aki mukhollo mawtaw} is a car that nobody saw coming) (j:mukhol/lo) (r:zd:15890) (q:draft, low confidence)
mukpau = (i:1) (t:n) (f:social) (w:speech/words/way of speaking) (d:<muk>, lips, with <pau>, speech: what a person says and how; used as a pair with <kampau>) (s:kampau) (r:zd:16227/zd:19676/zd:23975) (q:draft)
muktuam = (i:1) (t:n) (f:health) (w:face mask/mask) (d:a covering worn over the mouth and nose; <muk>, mouth, with <tuam>, cover. The same word is used as a verb, cover the mouth) (r:zd:23649/zd:23935/zd:24657) (q:draft)
mul = (i:2) (t:n) (f:nature) (w:feather/plumage) (d:the feathers of a bird, after <vasa> or the name of a bird, as {vasa mul}, a bird feather; the same word as {mul} hair, said of birds) (r:zd:24276) (q:draft)
muleng = (i:1) (t:v) (f:everyday) (w:if we see/when we see) (d:<mu>, see, and the conditional ending <leng> written as one word: if we see, if I see) (j:mu/leng) (r:zd:25170/zd:19105) (q:draft)
mulian = (i:1) (t:v) (f:everyday) (w:see exactly/find just then) (d:<mu>, see or find, with <lian>, exactly: see or find the very thing, see it oneself) (j:mu/lian) (r:zd:25616/zd:19603) (q:draft, low confidence)
mulo = (i:1) (t:v) (f:everyday/body) (w:not see/not find) (d:<mu> and <lo> written as one word: not see, not notice or not regard; {mit khua mulo} is blind) (j:mu/lo) (r:zd:24026/zd:20588/zd:15890) (q:draft)
multhak = (i:1) (t:n) (f:nature) (w:new feathers/new plumage) (d:<mul>, feather or hair, and <thak>, new, written as one word: the new feathers that grow on a bird) (j:mul/thak) (r:zd:24079/zd:24276) (q:draft)
mumang = (i:1) (t:n) (f:everyday/body) (w:dream/dreaming) (d:<mu>, see, with <mang>, dream: a dream seen in sleep; {mumang pau} is talk in one's sleep) (r:zd:10893/zd:25126) (q:draft)
Mumbai = (i:1) (t:name) (c:city) (f:travel) (w:Mumbai) (d:large city on the west coast of India) (r:zd:20248/zd:15342) (q:draft)
mumunuam = (i:1) (t:v) (f:everyday) (w:want to keep seeing/long to see) (d:<mumu>, keep seeing, with <nuam>, want, written as one word: want to see someone again and again) (j:mumu/nuam) (r:zd:19357) (q:draft)
mun = (i:3) (t:n) (f:everyday) (w:part/portion/share) (d:one of the equal parts into which a whole is divided, with a number after it: {mun thum ah khen} is divide into three parts, and {mun khat} is one part of them) (r:zd:25909) (q:draft, low confidence)
munah = (i:2) (t:prep) (f:everyday) (w:instead of/in place of) (d:after a word, letter or name, {munah} says that another one is used or stands where that one would be, as in {S munah Sh zang}, use Sh instead of S) (r:zd:17168/zd:24569) (q:draft)
munawnlo = (i:1) (t:v) (f:body/everyday) (w:no longer see) (d:<mu> and <nawnlo> written as one word: no longer see; {khua munawnlo} is having lost one's sight) (j:mu/nawnlo) (r:zd:22695) (q:draft)
munciat = (i:1) (t:n) (f:everyday) (w:each place/every place) (d:<mun> and <ciat> written as one word: each place, every one of the places, each in its own place) (j:mun/ciat) (r:zd:16442/zd:19968) (q:draft)
muncih = (i:1) (t:n) (f:everyday/travel) (w:every place/each place/everywhere) (d:<mun>, place, with <cih> in its meaning each: every place, wherever it may be; {muncih mualcih} is in every place and on every hill) (r:zd:9124/zd:24713) (q:draft)
mundanga = (i:1) (t:adj) (f:everyday) (w:of other places/elsewhere) (d:<mundang>, another place, with the place ending <a>: of or in other places, from elsewhere) (b:mundang) (r:zd:11159/zd:15805) (q:draft, low confidence)
munding = (i:1) (t:n) (f:everyday/travel) (w:site/proper place/place for) (d:<mun>, place, and <ding>, to be, written as one word: the place meant for someone or something, a site for a building or event; {ama munding} is his proper place) (j:mun/ding) (r:zd:22380/zd:23767/zd:22450) (q:draft)
mungei = (i:1) (t:v) (f:everyday) (w:have ever seen/have seen before) (d:<mu> and <ngei> written as one word: have ever seen; with <nailo>, <naikei> or <lo>, have never seen) (j:mu/ngei) (r:zd:15911/zd:19607) (q:draft)
mungeilo = (i:1) (t:v) (f:everyday) (w:have never seen) (d:<mu>, see, and <ngeilo>, never, written as one word) (j:mu/ngeilo) (r:zd:20202/zd:11729) (q:draft)
Mungpi = (i:1) (t:n) (f:social/work) (w:main pillar/mainstay/central institution) (d:the main post or shaft on which something rests or turns, and in public life a central body or institution; as {Mungpi} with a capital it is mostly a personal name) (r:zd:23667/zd:16111) (q:draft, low confidence)
mungtup = (i:1) (t:n) (f:politics/social) (w:goal/aim/objective) (d:the end that a person, a party or a people sets out to reach) (s:ngimna) (r:zd:21455/zd:21037) (q:draft)
mungtuppi = (i:1) (t:n) (f:politics/social) (w:main goal/chief aim/ultimate objective) (d:<mungtup>, goal, with {-pi}, great: the chief goal that a party, a movement or a person works toward) (b:mungtup) (r:zd:24455/zd:11456/zd:25257) (q:draft)
munhoih = (i:1) (t:n) (f:everyday/travel) (w:good place/beautiful spot) (d:<mun>, place, and <hoih>, good, written as one word: a good or beautiful place; also the name of a village) (j:mun/hoih) (r:zd:17941/zd:20513/zd:8667) (q:draft)
munhong = (i:1) (t:phrase) (f:everyday) (w:place) (d:<mun> and <hong> written as one word: the noun place followed by the particle of the next verb, as in {munhong luahkik}, take their place again) (j:mun/hong) (r:zd:25275) (q:draft, low confidence)
munin = (i:2) (t:n) (f:everyday) (w:place/the place) (d:<mun>, place, with <in> marking it as the doer of the sentence, so that the place does or shows something, as {hih munin}, this place; not as a place for something) (r:zd:21027/zd:19521) (q:draft, low confidence)
munkhat = (i:1) (t:n) (f:everyday/travel) (w:one place/a place/somewhere) (d:<mun> and <khat> written as one word: a place, a certain place, or one and the same place; {munkhat peuhah} is anywhere) (j:mun/khat) (r:zd:21011/zd:18208/zd:25399) (q:draft)
munkhatah = (i:1) (t:adv) (f:everyday/travel) (w:in a place/somewhere/in one place) (d:<munkhat> and <ah> written as one word: at a certain place, somewhere) (j:munkhat/ah) (r:zd:15236/zd:22897) (q:draft)
munkhatbek = (i:1) (t:n) (f:everyday/travel) (w:only one place/a single place) (d:<munkhat> and <bek> written as one word: one place and no other) (j:munkhat/bek) (r:zd:11846/zd:20499) (q:draft)
munkhatpeuh = (i:1) (t:n) (f:everyday/travel) (w:anywhere/any place/somewhere or other) (d:<munkhat> and <peuh> written as one word: any place at all, some place or other; with <ah>, anywhere) (j:munkhat/peuh) (r:zd:15433/zd:12208/zd:18292) (q:draft)
munkhempeuh = (i:1) (t:n) (f:everyday/travel) (w:everywhere/every place) (d:<mun> and <khempeuh> written as one word: every place; {munkhempeuh ah} is everywhere) (j:mun/khempeuh) (r:zd:17081/zd:13195/zd:12099) (q:draft)
munla = (i:1) (t:v) (f:everyday/social) (w:take a place/take up position/take hold) (d:<mun>, place, and <la>, here take, written as one word: take up a place or position, and of a thing or teaching, take hold and have its place among people) (j:mun/la) (r:zd:25165/zd:11387) (q:draft, low confidence)
Munlai = (i:1) (t:name) (c:khua) (f:travel) (w:Munlai) (d:a village or quarter in the Kalay area of Sagaing Region, Myanmar, often named as the home place of a person) (r:zd:24119/zd:24186/zd:11999) (q:draft, low confidence)
munleh = (i:1) (t:phrase) (f:everyday/travel) (w:the place and) (d:<mun>, place, and <leh>, and, written as one word: the place of something and another place, mostly when the distance between the two is told) (j:mun/leh) (r:zd:13009/zd:15274) (q:draft)
munlehgam = (i:1) (t:n) (f:social/politics) (w:territory/place and land) (d:<mun>, <leh> and <gam> written as one word: places and lands, a territory of one's own) (j:mun/leh/gam) (r:zd:24847) (q:draft)
munlehmual = (i:1) (t:n) (f:social/nature) (w:place/locality/region) (d:<mun>, place, <leh>, and, and <mual>, hill, written as one word: the place and country where people live, a locality) (j:mun/leh/mual) (r:zd:20769/zd:11648) (q:draft)
munlemual = (i:1) (t:n) (f:social/nature) (w:locality/region/home area) (d:<mun>, <le> and <mual> written as one word, literally place and hill: the place or region where people live or come from) (j:mun/le/mual) (r:zd:24062/zd:20971) (q:draft)
munlian = (i:1) (t:n) (f:everyday) (w:exact place/very spot) (d:<mun>, place, with <lian>, exactly, written as one word: the exact place where something is or happened) (j:mun/lian) (r:zd:20798/zd:22821) (q:draft, low confidence)
munminthang = (i:1) (t:n) (f:travel) (w:famous place/popular spot/attraction) (d:<mun>, place, and <minthang>, famous, written as one word: a well known place, especially one that many visitors go to) (j:mun/minthang) (r:zd:13173/zd:16431) (q:draft)
munmunah = (i:1) (t:adv) (f:everyday) (w:in each place/in every place) (d:<munmun>, each place, and <ah> written as one word: in each place, each in its own place) (j:munmun/ah) (r:zd:9452/zd:17958) (q:draft)
munna = (i:1) (t:n) (f:everyday) (w:frequency/frequent occurrence) (d:after a verb, the fact that it is done or happens often, or the place where it often happens: {zin munna} is a much visited place and {muh munna} is what one often sees) (r:zd:21780/ts:12147) (q:draft, low confidence)
munnih = (i:1) (t:n) (f:everyday/travel) (w:two places) (d:<mun>, place, and <nih>, two, written as one word: two places, mostly as {munnih ah}, in two places) (j:mun/nih) (r:zd:15260/zd:12689/zd:13255) (q:draft)
munnuam = (i:1) (t:n) (f:everyday/religion) (w:pleasant place/place of comfort) (d:<mun>, place, and <nuam>, pleasant, written as one word: a pleasant, comfortable place, also said of heaven; it is also the name of a village) (j:mun/nuam) (r:zd:24542/zd:22464) (q:draft)
munpan = (i:1) (t:adv) (f:travel/everyday) (w:from the place/from where) (d:<mun> and <pan> written as one word: from the place that is named before it; {tua munpan} is from there) (j:mun/pan) (r:zd:21817/zd:23616/zd:24420) (q:draft)
munpawl = (i:1) (t:n) (f:everyday/travel) (w:some places/area) (d:<mun>, place, and <pawl> written as one word: {munpawl khat} is some places, and after the name of a spot it is the area around it) (j:mun/pawl) (r:zd:10966/zd:16615) (q:draft, low confidence)
munpawlkhat = (i:1) (t:n) (f:everyday/travel) (w:some places/certain places) (d:<mun>, place, and <pawlkhat>, some, written as one word: some places, mostly before <ah>, in some places) (j:mun/pawlkhat) (r:zd:20093/zd:20525) (q:draft)
munpen = (i:1) (t:phrase) (f:everyday/travel) (w:the place) (d:<mun>, place, and the topic marker <pen> written as one word: the place, as for the place) (j:mun/pen) (r:zd:24593/zd:18181) (q:draft)
munphiah = (i:1) (t:n) (f:home) (w:broom) (d:a tool for sweeping, compare <phiat> sweep) (q:draft)
munpi = (i:1) (t:n) (f:social/work) (w:centre/main place/base) (d:<mun>, place, with {-pi}, great: the chief place for an activity, a centre or base) (b:mun) (r:zd:22095/zd:24067) (q:draft)
munpiak = (i:1) (t:v) (f:social/politics) (w:give a place/give a position/make room for) (d:<mun>, place, and <piak>, give, written as one word: give someone a place or a post) (j:mun/piak) (r:zd:22278/zd:22565) (q:draft)
munsan = (i:1) (t:n) (f:travel/everyday) (w:exact place/spot/location/position) (d:the very place where something is or happens; also the place or position that a person holds) (r:zd:19182/zd:23782/zd:17947) (q:draft)
munsanteng = (i:1) (t:n) (f:everyday/travel) (w:exact spot/very place) (d:<munsan>, exact place, and <teng>, the whole of, written as one word after the name of a place or body part: right at that spot, that very area) (j:munsan/teng) (r:zd:16932) (q:draft, low confidence)
muntak = (i:1) (t:n) (f:everyday) (w:exact place/very spot) (d:<mun>, place, and <tak>, real or exact, written as one word: the very place where something is) (j:mun/tak) (r:zd:24026) (q:draft, low confidence)
muntampi = (i:1) (t:n) (f:everyday/travel) (w:many places) (d:<mun>, place, and <tampi>, many, written as one word: many places, many parts of a country) (j:mun/tampi) (r:zd:19390/zd:17622/zd:18255) (q:draft)
muntek = (i:1) (t:n) (f:everyday/social) (w:own place/respective place) (d:<mun>, place, and <tek>, each, written as one word: each one's own place, as in {amau muntek ah}, each in their own place) (j:mun/tek) (r:zd:21586/zd:22581/zd:21127) (q:draft)
muntengpen = (i:1) (t:phrase) (f:everyday) (w:the whole area/the whole place) (d:<munteng>, the whole of a place, with the topic marker <pen>, written as one word) (j:munteng/pen) (r:zd:15167/zd:12691) (q:draft)
