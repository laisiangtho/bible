gamkhempeuh = (i:1) (t:phrase) (f:politics/travel) (w:all countries/every country) (d:<gam>, country, and <khempeuh>, all, written as one word) (j:gam/khempeuh) (r:zd:19648/zd:24116/zd:12876) (q:draft)
gamla = (i:1) (t:adj) (f:everyday/travel) (w:far/distant/far away) (d:far in place; with <a> before it and <panin> or <ah> after it, it is used as a noun: {a gamla panin} is from a distance, {a gamla-ah} is at a distance) (a:kinai) (r:41.5.6) (q:draft)
gamlam = (i:1) (t:n) (f:travel/politics) (w:region/part of the world/direction of a country) (d:<gam>, country, with <lam>, direction, written as one word: the lands lying in a direction, as {nitumna gamlam}, the West, or the direction of a named country) (j:gam/lam) (r:zd:15253/zd:21908) (q:draft)
gamleh = (i:1) (t:phrase) (f:politics/social) (w:country and) (d:<gam>, country, and <leh>, and, written as one word; mostly in {gamleh minam}, country and people) (j:gam/leh) (r:zd:24234/zd:14912/zd:14751) (q:draft)
gamliante = (i:1) (t:n) (f:politics) (w:great nations/great powers/big countries) (d:plural of <gamlian>: the large and powerful countries of the world) (b:gamlian) (j:gamlian/te) (r:zd:24965/zd:25893) (q:draft)
gamlim = (i:1) (t:n) (f:education/travel) (w:map/chart) (d:<gam> land with <lim> picture: a map of a country or of the world) (r:zd:20513/zd:20742) (q:draft)
gammakai = (i:1) (t:n) (f:politics) (w:national leader/head of government/prime minister) (d:<gam>, country, with <makai>, leader: the leader of a country, said of a prime minister, a president or another head of government) (r:zd:20971/zd:19631) (q:draft)
gammeikang = (i:1) (t:n) (f:nature) (w:wildfire/forest fire/bushfire) (d:<gam>, wild land, <mei>, fire, and <kang>, burn: a fire that burns over forest or open country) (r:zd:13092/zd:11236/zd:14871) (q:draft)
gammi hihna = (i:1) (t:n) (f:politics) (w:citizenship/nationality) (d:<gammi>, citizen, and <hihna>, the fact of being: citizenship or nationality; the name of the country stands before it, and {gammi hihna ngah} is obtain citizenship) (r:zd:19302/zd:25918) (q:draft)
gammial = (i:1) (t:n) (f:religion) (w:mission field/mission) (d:<gam>, land, with <mial>, dark: a land or people the gospel has not reached, and the mission work done there; {gammial nasep} is mission work and {gammial vei} is have a burden for mission) (r:zd:17060/zd:21547/zd:25078) (q:draft)
gammikhat = (i:1) (t:n) (f:social/politics) (w:a citizen/a national) (d:<gammi> and <khat> written as one word: a citizen of the country named before it, as in {Myanmar gammikhat}, a Myanmar national) (j:gammi/khat) (r:zd:19468/zd:20468) (q:draft)
gammipa = (i:1) (t:n) (f:social/politics) (w:citizen/national/man) (d:<gammi>, citizen, with <pa> marking a man: after the name of a country, a man of that country) (b:gammi) (r:zd:16126) (q:draft)
Gamngai = (i:1) (t:name) (c:khua) (f:travel/social) (w:Gamngai) (d:village in the <Tedim> area of Chin State; written after a personal name it tells where the person is from) (r:zd:19430) (q:draft)
gamnih = (i:1) (t:n) (f:politics) (w:two countries/both countries) (d:<gam> and <nih> written as one word: the two countries, placed after their names) (j:gam/nih) (r:zd:15820/zd:11642/zd:14505) (q:draft)
gamnuaimite = (i:1) (t:n) (f:politics) (w:militants/insurgents/rebels) (d:{gam nuai}, underground, with <mite>, people: the members of an armed underground group) (r:zd:11043/zd:11046) (q:draft)
gampanin = (i:1) (t:adv) (f:travel/politics) (w:from the country of/from the land) (d:<gam>, country, and <panin>, from, written as one word, placed after the name of the country) (j:gam/panin) (r:zd:19314/zd:19130) (q:draft)
gampen = (i:1) (t:phrase) (f:politics/travel) (w:the country/as for the country) (d:<gam> and the topic marker <pen> written as one word: the country, as the thing spoken about; stands after the name of a country) (j:gam/pen) (r:zd:19786/zd:12161) (q:draft)
gampua = (i:1) (t:n) (f:travel/politics) (w:abroad/overseas/foreign country) (d:<gam>, country, with <pua>, outside: the world outside one's own country; often paired with <gamsung>, as in <gamsung gampua>, at home and abroad) (s:gamdang) (r:zd:23492/zd:12039/zd:11415) (q:draft)
gampualam = (i:1) (t:n) (f:travel/politics) (w:abroad/overseas/foreign countries) (d:<gam>, country, and <pualam>, outside, written as one word: outside the country, abroad) (s:gamdang) (j:gam/pualam) (r:zd:12581/zd:17643/zd:19130) (q:draft)
gamsung gampua = (i:1) (t:adv) (f:social/politics) (w:at home and abroad/inside and outside the country) (d:<gamsung>, inside the country, and <gampua>, abroad, set side by side without <leh>: at home and abroad, everywhere that the people live; followed by <ah>, in, or <pan>, from) (r:zd:12039/zd:11415) (q:draft)
gamsung meikang = (i:1) (t:n) (f:nature/media) (w:wildfire/bushfire/forest fire) (d:<gamsung>, here the open country or forest, and <meikang>, a burning: a wildfire or bushfire; a place name often stands before it) (r:zd:15820/zd:15795/zd:14681) (q:draft)
gamsung meikatna = (i:1) (t:n) (f:nature/media) (w:wildfire/forest fire/bushfire) (d:<gamsung>, the wild open country, and <meikatna>, a fire: a fire that burns through forest and open land, as against a fire in a house or a town; often followed by <hangin>, because of) (r:zd:15820/zd:15679) (q:draft)
gamsungpan = (i:1) (t:adv) (f:travel/politics) (w:from the country/out of the country) (d:<gamsung>, the land, and <pan>, from, written as one word and placed after the name of a country: from that country, out of it) (j:gamsung/pan) (r:zd:11265/zd:21968) (q:draft)
gamsungpen = (i:1) (t:phrase) (f:politics/travel) (w:as for the country) (d:<gamsung>, the country, and the topic marker <pen>, written as one word after the name of a country: the country, as the thing spoken about) (j:gamsung/pen) (r:zd:11752/zd:19820) (q:draft)
gamtat luhek = (i:1) (t:n) (f:social) (w:conduct/behaviour/character) (d:<gamtat>, behave, and <luhek>, manners: a pair that names a person's conduct as a whole, often beside words for speech such as <kampau>) (r:zd:19900/zd:17896) (q:draft)
gamtatding = (i:1) (t:v) (f:social) (w:to behave/to act/how to act) (d:<gamtat>, behave, and <ding>, will, written as one word: to behave or act in a certain way, how one should act) (j:gamtat/ding) (r:zd:14646/zd:12042/zd:15216) (q:draft)
gamtathoih = (i:1) (t:n) (f:social) (w:good conduct/good behaviour/decorum) (d:<gamtat>, behave, with <hoih>, good, written as one word: good behaviour, and also to behave well) (j:gamtat/hoih) (r:zd:16254/zd:16433) (q:draft)
gamthak = (i:1) (t:n) (f:social/travel/politics) (w:new country/new land) (d:<gam> and <thak> written as one word: a new land to settle in, or a newly founded country) (j:gam/thak) (r:zd:25918/zd:17309/zd:15527) (q:draft)
gamthu = (i:1) (t:n) (f:politics) (w:national affairs/affairs of the country/politics) (d:<gam>, country, with <thu>, matter: the affairs of a country or region, its public and political matters) (r:zd:24604/zd:16157) (q:draft)
gamthu = (i:2) (t:n) (f:education/nature) (w:geography) (d:the study of lands and of the earth as a school subject; {Zolai Gamthu bu} is the Zolai geography book) (r:zd:25390) (q:draft, low confidence)
gamthum = (i:1) (t:n) (f:politics/travel) (w:three countries) (d:<gam>, country, and <thum>, three, written as one word: three countries, placed after their names) (j:gam/thum) (r:zd:25893/zd:14983) (q:draft)
gamthum = (i:2) (t:n) (f:politics/travel) (w:third country) (d:for refugees, the third country, where one is resettled after the country of refuge; short for {gam thumna}) (j:gam/thum) (r:zd:19626) (q:draft, low confidence)
gamthumna = (i:1) (t:n) (f:travel/politics) (w:third country) (d:<gam> and <thumna> written as one word: the third country, the country in which refugees are resettled after their own country and the country of first refuge) (j:gam/thumna) (r:zd:22897/zd:20936) (q:draft)
gamthupi = (i:1) (t:n) (f:politics/social) (w:great country/advanced country/developed country) (d:<gam>, country, with <thupi>, great: a country of high standing, rich and developed) (r:zd:15433/zd:22728) (q:draft)
gamtuamtuam = (i:1) (t:n) (f:politics/travel) (w:various countries/different countries) (d:<gam>, country, and <tuamtuam>, various, written as one word: several different countries, countries of many kinds) (j:gam/tuamtuam) (r:zd:11588/zd:15307/zd:16259) (q:draft)
gamuk = (i:1) (t:n) (f:politics) (w:government/rule of a country/state administration) (d:<gam> country with <uk> rule: the governing of a country and those who govern it, mostly before <kumpi> or <makai>, as in {gamuk kumpi}, the ruling government, and {gamuk makai}, national leaders) (r:zd:25060/zd:16210/zd:16782) (q:draft)
gamvakna = (i:1) (t:n) (f:travel) (w:travel/going about/outing) (d:<gamvak>, go about the country, with the noun suffix <na>: going about away from home; mostly in the pair {khualzin gamvakna}, travel and journeys) (b:gamvak) (r:zd:24283/zd:22426) (q:draft)
gamveng = (i:1) (t:n) (f:politics) (w:neighbouring country/neighbour) (d:<gam>, country, with <veng>, neighbour: a country that borders another) (r:zd:12210/zd:18952) (q:draft)
gamzawng = (i:1) (t:n) (f:politics/work) (w:poor country) (d:<gam>, country, and <zawng>, poor, written as one word: a poor country) (j:gam/zawng) (r:zd:17355/zd:12387) (q:draft)
gang = (i:1) (t:n) (f:family) (w:uncle) (d:kinship term for the husband of a father's sister, also used as a title before his name; the English word gang occurs in the articles only in English phrases) (r:zd:24678) (q:draft, low confidence)
Gangaw = (i:1) (t:name) (c:city) (f:travel) (w:Gangaw) (d:town and district in Myanmar on the road between Kalay and the central plain, bordering the Chin hills) (r:zd:22802/ts:10251/zd:10860) (q:draft)
ganhing khawina = (i:1) (t:n) (f:nature/work) (w:zoo/animal park/animal farm) (d:<ganhing>, animal, and <khawina>, keeping: a place where animals are kept, a zoo, wildlife park or farm) (r:zd:19468) (q:draft)
gap = (i:1) (t:n) (f:food/nature) (w:ear/cob/pod) (d:one fruit of a plant counted as a unit, as in {vaimim gap}, an ear of maize, and {nahtang gap}, a banana) (r:zd:22185/zd:24276) (q:draft, low confidence)
Garuda = (i:1) (t:name) (f:travel) (w:Garuda Indonesia/Garuda) (d:the national airline of Indonesia) (r:zd:11081/zd:17628) (q:draft)
Gas = (i:1) (t:n) (f:home/work) (w:gas/cooking gas) (d:gas burned as fuel, above all for cooking; {Gas bung} is a gas cylinder) (o:English) (r:zd:22584/zd:21259/zd:15354) (q:draft)
gas bung = (i:1) (t:n) (f:home/food) (w:gas cylinder/gas bottle) (d:{gas}, the English word for cooking gas, and <bung>, a vessel of measure: the metal cylinder that holds cooking gas; in news most often with <puakkham>, explode) (r:zd:14616/zd:21419) (q:draft)
Gate = (i:1) (t:n) (f:travel/politics) (w:gate/checkpoint/toll gate) (d:a gate on a road or at a border where travellers are stopped, checked or made to pay) (o:English) (r:zd:23997/ts:5480/zd:11308) (q:draft, low confidence)
gau = (i:1) (t:v) (f:body) (w:swell/be distended/open wide) (d:be swollen or stand out: {nawi gau} is said of a breast full of milk and {mit gau} of eyes opened wide; the articles also have {vaimim gau}, of maize, and the pair {gu leh gau}, whose meaning is not determined) (r:zd:24117/zd:26097) (q:draft, low confidence)
gawikha = (i:1) (t:v) (f:travel/health) (w:run over/crush) (d:<gawi>, grind, crush, and <kha>, happen to, written as one word: of a vehicle or machine, run over or crush a person or a part of the body by accident) (j:gawi/kha) (r:zd:17455/zd:11683/zd:20615) (q:draft)
gawmkhawm = (i:1) (t:v) (f:everyday/social) (w:join together/combine/unite/mix) (d:<gawm>, join, and <khawm>, together, written as one word: put or bring together into one) (j:gawm/khawm) (r:zd:23394/zd:22228/zd:15671) (q:draft)
gawmtuah = (i:1) (t:v) (f:everyday/work) (w:combine/put together/unite/compile) (d:<gawm> and <tuah> written as one word: bring separate things or people together into one) (j:gawm/tuah) (r:zd:25461/zd:15035/ts:3160) (q:draft)
Gawngmual = (i:1) (t:name) (c:khua) (f:travel) (w:Gawngmual) (d:a village near Tedim town; {Gawngmual khuami} is a person of that village) (r:zd:20883/zd:21182) (q:draft)
gear = (i:1) (t:n) (f:travel) (w:gear) (d:the gear of a car or bicycle, and the lever that changes it) (o:English) (r:zd:17450/zd:12021) (q:draft)
geelkhia = (i:1) (t:v) (f:work/politics) (w:plan/devise/draw up) (d:<geel> plan and <khia> out written as one word: work out a plan for something; {a geelkhia} is the one who planned it) (j:geel/khia) (r:zd:24649/zd:24453) (q:draft)
geelkholhna = (i:1) (t:n) (f:work) (w:plan/advance planning/preparation) (d:<geelkholh>, plan beforehand, with the noun ending <na>: a plan made in advance, planning ahead) (b:geelkholh) (r:zd:16150/zd:12099/zd:23022) (q:draft)
geelna kinei = (i:1) (t:v) (f:work/politics) (w:be planned/there is a plan) (d:<geelna>, plan, and <kinei>, here be held or be had: a plan has been made, it is planned; what is planned stands before it, often with <ding> or <dingin>) (r:ts:9739/zd:21408) (q:draft)
geelsak = (i:1) (t:v) (f:everyday/social) (w:plan for/arrange for/prepare for) (d:<geel>, plan, with <sak>: plan or arrange something for someone else, on his behalf) (b:geel) (r:zd:26626/zd:23191/zd:23386) (q:draft)
Geeltui = (i:1) (t:name) (c:khua) (f:social) (w:Geeltui) (d:an old Zomi settlement in the Tedim area, named after <Ciimnuai> in the tradition of how the people spread) (r:zd:24227/zd:24072) (q:draft)
gegu = (i:1) (t:adv) (f:everyday) (w:indeed/plainly/as a matter of fact) (d:placed after a verb to stress that something is plainly or already the case, often before <napi>, although: even though it really is so) (r:zd:21864/zd:9445) (q:draft, low confidence)
geikhat = (i:1) (t:n) (f:travel/everyday) (w:place near/place beside) (d:<gei>, side, and <khat>, one, written as one word after the name of a place: a spot near or beside it; {sanginn geikhat ah} is at a place near a school) (j:gei/khat) (r:zd:19923/zd:19180/zd:17628) (q:draft, low confidence)
geiteng ah = (i:1) (t:prep) (f:travel/everyday) (w:near/around/in the vicinity of/close by) (d:<geiteng>, the whole edge, from <gei>, side, with the place marker <ah>: placed after the name of a place, in the area round it, near it) (s:geiah) (r:zd:15101/zd:13133) (q:draft)
gelh = (i:1) (t:v) (f:everyday/education) (w:write) (d:put words down in letters. With <lai>, writing, it means write a letter or a document) (s:at/laigelh) (a:phiat) (q:draft)
gelhdan = (i:1) (t:n) (f:education) (w:spelling/way of writing) (d:<gelh>, write, with <dan>, way: how a word or a language is written, its spelling or style of writing) (r:zd:23929/zd:9449/zd:15693) (q:draft)
gelhgelh = (i:1) (t:v) (f:education/media) (w:keep writing/write on/write down) (d:<gelh>, write, doubled: write on and on, or be in the course of writing) (b:gelh) (r:zd:21529/zd:9228/zd:22849) (q:draft)
gelhkhia = (i:1) (t:v) (f:education/media) (w:write/write out/write down) (d:<gelh>, write, and <khia>, out, written as one word: put something into writing and make it known, as a post, an article or a document) (j:gelh/khia) (r:zd:21392/zd:12763/zd:22365) (q:draft)
gelhzia = (i:1) (t:n) (f:education) (w:way of writing/spelling/writing style) (d:<gelh>, write, and <zia>, way, written as one word: how something is written or spelled; {lai gelhzia} is the way of writing) (j:gelh/zia) (r:zd:17168/zd:9449/zd:19201) (q:draft)
gelkhol = (i:1) (t:v) (f:everyday/work) (w:plan ahead/plan in advance/prepare beforehand) (d:<geel>, plan, in a shorter spelling, with <khol>, beforehand: think out and arrange something before the time comes) (r:zd:20647/zd:21456/zd:15933) (q:draft)
gelkholh = (i:1) (t:v) (f:everyday) (j:geelkholh) (r:zd:23443/zd:18234) (q:draft)
gelkholhna = (i:1) (t:n) (f:work/everyday) (w:advance planning/plan/forethought) (d:noun from <geelkholh>, plan beforehand, written here with a short vowel: a plan made ahead of time; {gelkholhna nei} is plan ahead) (b:geelkholh) (r:zd:22742/zd:18026/zd:24358) (q:draft)
gelsa = (i:1) (t:adj) (f:everyday/work) (j:geelsa) (r:zd:23422/zd:23777/zd:25932) (q:draft)
gelsak = (i:1) (t:v) (f:everyday/religion) (w:plan for/arrange for) (d:<geel>, plan, in a shorter spelling, with <sak>, for someone: plan or arrange something for another person, often said of what God plans for people; also written <geelsak>) (j:geel/sak) (r:zd:24231/zd:21252) (q:draft)
gemgam = (i:1) (t:adv) (f:everyday) (d:placed after a describing word to stress a solid, heavy, stark or imposing look: {gum gemgam}, grim; {tul gemgam}, standing stiff and bare; {vom gemgam}, pitch black; {khauh gemgam}, stiff and hard) (r:zd:20874/zd:21121/ts:4569) (q:draft, low confidence)
gen = (i:1) (t:v) (f:everyday) (w:tell/say/speak) (d:say or tell something in words; the basic verb of speaking, as in {thu gen}, speak a word) (s:ci)
gen lehang = (i:1) (t:phrase) (f:everyday) (w:to put it/so to speak/if we say) (d:<gen>, say, and <lehang>, if we: if we say it, to put it; follows a word of manner and introduces a restatement, as in {lam khatin gen lehang}, in other words, and {thu dang khatin gen lehang}, to put it another way) (r:zd:11262/zd:23129) (q:draft)
gen siang = (i:1) (t:v) (f:everyday/social) (w:tell plainly/say outright) (d:<gen>, say, and <siang>, clean: say a thing clearly and completely, holding nothing back; with <ngam> and <kei>, not dare to tell it plainly) (r:zd:23734) (q:draft, low confidence)
gena = (i:1) (t:v) (f:everyday) (w:say/tell/preach) (d:<gen>, say, with the linking ending {-a} written on to it: saying, said and, before another verb; the Bible text writes {gen a}) (b:gen) (r:zd:9234/zd:9238) (q:draft)
genbehna = (i:1) (t:n) (f:media) (w:further statement/additional remark/further explanation) (d:<genbeh>, say in addition, with the noun suffix <na>: what is said in addition; {a genbehna ah} is in his further remarks) (b:genbeh) (r:zd:11635/zd:12347/zd:24303) (q:draft)
gencian = (i:1) (t:v) (f:everyday/social) (w:explain clearly/state exactly/make clear) (d:<gen>, say, with <cian>, clearly, written as one word: say exactly how a thing is, explain it so that it is clear) (j:gen/cian) (r:zd:23281/zd:24217/zd:21900) (q:draft)
genciangin = (i:1) (t:v) (f:everyday) (w:when speaking/when one says) (d:<gen>, speak, and <ciangin>, when, written as one word: when someone speaks or says something) (j:gen/ciangin) (r:zd:20697/zd:21083/zd:21876) (q:draft)
gencianna = (i:1) (t:n) (f:media/politics) (w:clarification/explanation/statement) (d:<gencian>, explain clearly, with the noun ending {-na}: a statement that makes a matter clear; <gencianna nei> is give an explanation) (b:gencian) (r:ts:10582/zd:16790) (q:draft)
gencianna nei = (i:1) (t:v) (f:media/politics) (w:give a statement/give an explanation/clarify) (d:<gencianna>, a clarification, and <nei>, have: make a statement that explains a matter; the matter stands before it, often ending in {ci'n} or <zong>, and the one who speaks takes <in>) (r:ts:11378/zd:20839/zd:17830) (q:draft)
gencianthei = (i:1) (t:v) (f:everyday/media) (w:can say for certain/can state clearly) (d:<gen>, say, <cian>, clearly, and <thei>, can, written as one word: be able to say definitely; mostly negative, as in {ki gencianthei nailo}, it cannot yet be said for certain) (j:gen/cian/thei) (r:zd:12099/zd:13324/zd:19392) (q:draft)
genciantheih = (i:1) (t:v) (f:everyday/media) (w:can say clearly/can say for certain) (d:<gencian>, say clearly, and <theih>, be able, written as one word; mostly with a negative, as {bangmah genciantheih omnailo}, nothing can yet be said for certain) (j:gencian/theih) (r:zd:13220/zd:14949/zd:19385) (q:draft)
gendan = (i:1) (t:n) (f:everyday/media) (w:way of saying/account/telling) (d:<gen>, say, with <dan>, manner, written as one word: the way something is said or told, and what someone says about a matter) (j:gen/dan) (r:zd:10797/zd:21357/zd:16924) (q:draft)
Gender = (i:1) (t:n) (f:social) (w:gender/sex) (d:the state of being male or female; mostly in English phrases such as {Gender Equality}) (o:English) (r:zd:14577/zd:11668) (q:draft, low confidence)
gending = (i:1) (t:v) (f:everyday) (w:will say/to say) (d:<gen>, say, and <ding>, will, written as one word: will say, or what is to be said) (j:gen/ding) (r:zd:21085/zd:21796/zd:21155) (q:draft)
Generator = (i:1) (t:n) (f:work/home) (w:generator) (d:a machine that produces electric power) (o:English) (r:zd:22584/zd:25357/zd:23993) (q:draft)
Geneva = (i:1) (t:name) (c:city) (f:politics) (w:Geneva) (d:city in Switzerland where offices of the United Nations are; {Geneva thukimna} is the Geneva Convention) (r:zd:9124) (q:draft)
genkhiakhin = (i:1) (t:v) (f:media) (w:have stated/have declared) (d:<genkhia>, declare, and <khin>, already, written as one word: has already said or announced) (j:genkhia/khin) (r:zd:20013/zd:19478) (q:draft)
genkhialh = (i:1) (t:n) (f:everyday/social) (w:misstatement/slip of the tongue) (d:<gen> and <khialh> written as one word: something said wrongly, a mistake in what one has said or written) (j:gen/khialh) (r:zd:16651/zd:17213) (q:draft)
genkhialo = (i:1) (t:v) (f:media/everyday) (w:not disclose/not say) (d:<genkhia>, speak out, and <lo>, not, written as one word: did not say or make known) (j:genkhia/lo) (r:zd:11560/zd:14701) (q:draft)
genkhiata = (i:1) (t:v) (f:media/everyday) (w:have announced/has stated) (d:<genkhia>, speak out, and <ta> written as one word: has now announced, has stated) (j:genkhia/ta) (r:zd:11011/zd:12639) (q:draft)
genkhiatbeh = (i:1) (t:v) (f:media) (w:state further/add/also announce) (d:<genkhiat>, speak out, with <beh>, in addition, written as one word: say something more in a statement; usual in news after {ci'n}, saying) (j:genkhiat/beh) (r:zd:19234/zd:15602) (q:draft)
genkhiatding = (i:1) (t:v) (f:everyday/media) (w:to announce/to state/will tell) (d:<genkhiat> and the future marker <ding> written as one word: to say something out, to make it known) (j:genkhiat/ding) (r:zd:13352/zd:11376) (q:draft)
genkhiattheih = (i:1) (t:v) (f:media/everyday) (w:be able to state/can be told) (d:<genkhiat>, state or announce, with <theih>, be able, written as one word; {genkhiattheih omnailo} is there is nothing yet that can be stated) (j:genkhiat/theih) (r:zd:17969/zd:12974) (q:draft)
genkikna = (i:1) (t:n) (f:media/everyday) (w:reply/response/retelling) (d:<genkik>, say again or report back, with the noun suffix <na>: what is said in reply, or a telling again of what was said) (b:genkik) (r:ts:2288/zd:24172) (q:draft)
genleh = (i:1) (t:v) (f:everyday) (w:if one says/when one speaks) (d:<gen> and <leh> written as one word: if or when someone says or tells) (j:gen/leh) (r:zd:13154/zd:21075) (q:draft)
genleng = (i:1) (t:v) (f:everyday) (w:if I say/to put it) (d:<gen>, say, and <leng>, if I, written as one word: if I say it, to put it; introduces a statement after a word of manner, as in {a tomin genleng}, to put it briefly) (j:gen/leng) (r:zd:19971/zd:17333/zd:15600) (q:draft)
genngam = (i:1) (t:v) (f:everyday/social) (w:dare to say/speak boldly) (d:<gen>, say, and <ngam>, dare, written as one word: have the courage to say something) (j:gen/ngam) (r:zd:12564/zd:21075) (q:draft)
genngei = (i:1) (t:v) (f:everyday) (w:have said before/have told) (d:<gen> and <ngei> written as one word: have said or told something at an earlier time) (j:gen/ngei) (r:zd:13181/zd:23322/zd:15416) (q:draft)
genni = (i:1) (t:v) (f:everyday) (w:let us say) (d:<gen>, say, with the ending {-ni}, let us, written as one word; {a tomin genni cileng} is to put it briefly) (j:gen/ni) (r:zd:23432/zd:25919/zd:17161) (q:draft)
gennop bulpi = (i:1) (t:n) (f:everyday/media) (w:main point/chief point/gist) (d:<gennop>, what one wants to say, and <bulpi>, the base or chief part: the main point that a speaker or writer wants to make; usually after <i>, <ih> or <na> and followed by <in>, <ah> or {ahih leh} to introduce that point) (r:zd:25123/zd:21063) (q:draft)
genpah = (i:1) (t:v) (f:everyday) (w:tell at once/say immediately) (d:<gen> and <pah> written as one word: tell or report something right away) (j:gen/pah) (r:zd:20039/zd:21035) (q:draft)
genpi = (i:1) (t:n) (f:social/media) (w:main theme/main message/chief topic) (d:<gen>, speak, with <pi>, chief: what someone chiefly speaks about; {genpi in nei} is make something the main theme of one's speaking) (r:zd:10793/zd:15274) (q:draft)
gensa mah = (i:1) (t:phrase) (f:everyday) (w:as already said/as mentioned) (d:<gensa>, already said, and <mah>, the very: always followed by <bangin>, {gensa mah bangin}, just as was said before; a pronoun such as <ih> or <ka> or the words {a tung a}, above, stand before it) (r:zd:24029/zd:24607) (q:draft)
