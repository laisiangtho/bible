zuakthei = (i:1) (t:v) (f:work) (w:can sell/be able to sell) (d:<zuak> and <thei> written as one word: be able or allowed to sell) (j:zuak/thei) (r:zd:17530) (q:draft)
zuakzuak = (i:1) (t:v) (f:work/everyday) (w:keep selling/sell around) (d:<zuak>, sell, said twice: go on selling in many places; also said of making the faults of one's family known to others) (b:zuak) (r:zd:18952/zd:25470) (q:draft, low confidence)
zual = (i:2) (t:v) (f:social/everyday) (w:be at home/frequent/be familiar) (d:of a person or a pet, go freely and often to a house or a person and be at ease there; after <kiang> or {inn ah}, and {zual nawnlo} is no longer comes around) (r:zd:21070/zd:20003) (q:draft, low confidence)
zualzual = (i:1) (t:adv) (f:everyday) (w:fluently/readily/smoothly) (d:placed after a verb: doing it with ease or as a habit, as one who is used to it) (r:zd:25678/zd:17535) (q:draft, low confidence)
zuana = (i:1) (t:adv) (f:travel) (w:heading for/towards) (d:<zuan>, head for, and <a> written as one word, after a place and before a verb of going: heading for that place) (j:zuan/a) (r:zd:12122/ts:301) (q:draft)
zuanding = (i:1) (t:v) (f:travel) (w:bound for/heading for) (d:<zuan>, head for, and <ding>, the marker of what is to come, written as one word after the name of a place: bound for that place, on the way to it) (j:zuan/ding) (r:zd:13030/zd:14906/zd:13063) (q:draft)
zuandingin = (i:1) (t:adv) (f:travel) (w:bound for/heading for/on the way to) (d:<zuan>, head for, with <dingin>, in order to, written as one word after the name of a place: in order to go there, bound for it) (j:zuan/dingin) (r:zd:20229/zd:19495/zd:12906) (q:draft)
zuang = (i:1) (t:v) (f:social) (w:long/pine/yearn) (d:of the heart, ache with longing for someone absent, in {lung zuang}, also written <lungzuang>) (r:zd:25625/zd:15996) (q:draft, low confidence)
zuanlo = (i:1) (t:v) (f:travel/everyday) (w:not head for/not go to) (d:<zuan> and <lo> written as one word: not go toward a place) (j:zuan/lo) (r:zd:21155/zd:14917) (q:draft)
zuansuak = (i:1) (t:v) (f:travel) (w:go straight on to/head on to) (d:<zuan>, head for, with <suak.1>, right through, written as one word: go on to a place without stopping elsewhere) (j:zuan/suak) (r:zd:25572/zd:17763) (q:draft)
zuanta = (i:1) (t:v) (f:travel/everyday) (w:head for/set out for) (d:<zuan> and <ta> written as one word: now head for a place, set out toward it) (j:zuan/ta) (r:zd:24320) (q:draft)
zuanzuan = (i:1) (t:v) (f:travel/everyday) (w:keep heading for/go steadily toward) (d:<zuan>, head for, said twice: keep going toward a place or in a direction, one after another or more and more) (b:zuan) (r:zd:8375/zd:12998) (q:draft)
Zuapa = (i:1) (t:n) (f:family/social) (w:father) (d:poetic and respectful word for father, paired with <tuunnu>, mother; also a title for a man honoured as the father of a people, as {Zomi Zuapa}; often written with a capital) (s:pa) (r:zd:12194/zd:25714) (q:draft, low confidence)
zuatding = (i:1) (t:v) (f:travel) (w:to go to/to head for/to return to) (d:<zuat> and <ding> written as one word: the going to a place that lies ahead) (j:zuat/ding) (r:zd:20263/zd:11110) (q:draft)
zuatleh = (i:1) (t:v) (f:travel/everyday) (w:if one goes to/when one turns to) (d:<zuat>, go to or head for, and <leh>, if or when, written as one word: if it goes that way, when someone goes to a person) (j:zuat/leh) (r:zd:23394/zd:13340) (q:draft)
zuatpih = (i:1) (t:v) (f:travel) (w:take to/lead toward/bring along to) (d:<zuat>, head for, with <pih>, together with: head for a place taking someone or something along, lead toward) (r:ts:2320/zd:19174/zd:23655) (q:draft)
zuatsan = (i:1) (t:v) (f:religion/social) (w:depart to/go away to/pass away) (d:<zuat>, head for, with the ending {-san}, leaving others behind: go away to a place for good; in death notices {Topa' kiang hong zuatsan} is departed to be with the Lord) (b:zuat) (r:zd:9214/zd:19758) (q:draft)
zuau = (i:2) (t:n) (f:everyday) (w:lie/falsehood) (d:used as a noun, a lie or what is untrue, as in {zuau hilo}, it is not a lie, {zuau tawh}, with a lie, and {zuau phuak}, make up a lie) (r:zd:24276/zd:20936/zd:8668) (q:draft)
zuaukhem = (i:1) (t:v) (f:social) (w:lie and deceive/cheat/deceive) (d:<zuau>, lie, and <khem>, deceive, written as one word: lie and cheat; also as a noun, lying, deceit) (j:zuau/khem) (r:zd:23670/zd:21463) (q:draft)
zuauphuak = (i:1) (t:v) (f:social) (w:lie/make up lies/fabricate) (d:make up something untrue and tell it; also the one who does so, a liar) (r:zd:8668/zd:25461) (q:draft)
zuauthuthang = (i:1) (t:n) (f:media) (w:fake news/hoax/false report) (d:<zuau>, false, with <thuthang>, news: a report that is spread but is not true) (r:zd:19197/zd:12500) (q:draft)
zubel = (i:1) (t:n) (f:food/home) (w:beer pot/wine jar) (d:<zu>, rice or millet beer, with <bel>, here pot, as <beel>: the earthen pot in which the beer is brewed and from which it is drunk) (r:ts:4885/zd:25390) (q:draft)
Zudah = (i:1) (t:name) (c:people) (f:religion/social) (w:Jew/Jewish) (d:the Jewish people, in a spelling used beside <Jew> and <Judah>; {Zudah mite} is the Jews) (r:zd:23301/zd:23138) (q:draft)
zudawn = (i:1) (t:v) (f:food/social) (w:drink alcohol/drinking) (d:<zu>, alcoholic drink, and <dawn>, drink, written as one word: drink alcohol, the drinking of alcohol) (j:zu/dawn) (r:zd:22734/zd:16365/zd:10670) (q:draft)
zudawndawn = (i:1) (t:v) (f:food/social) (w:keep drinking alcohol/drink heavily) (d:<zu>, alcoholic drink, and <dawndawn>, keep drinking, written as one word; also said of those who drink much) (j:zu/dawndawn) (r:zd:18125/zd:14585) (q:draft)
zudawnkhawm = (i:1) (t:v) (f:food/social) (w:drink together) (d:<zu>, alcoholic drink, and <dawnkhawm>, drink together, written as one word: drink alcohol together with others) (j:zu/dawnkhawm) (r:zd:18020/zd:20055) (q:draft)
zudawnna = (i:1) (t:n) (f:food/social/health) (w:drinking/alcohol drinking) (d:<zudawn>, drink alcohol, with the noun ending <na>: the drinking of alcohol) (b:zudawn) (r:zd:20496/zd:24064) (q:draft)
zuha = (i:1) (t:n) (f:food) (w:fermented rice mash/sweet rice beer mash) (d:the soft fermented grain from which <zu>, rice beer, is made, eaten sweet and also given to small children to suck) (r:zd:14804/zd:16924) (q:draft, low confidence)
zuhai = (i:2) (t:n) (f:food/social) (w:liquor cup/drinking cup) (d:<zu>, liquor, with <hai>, cup: the cup from which rice beer is drunk, or a cup of it as a share at a feast, as in {zuhai sabak}, a cup of liquor and a portion of meat; not a drunkard) (r:zd:22894/zd:21815) (q:draft)
zuhang = (i:1) (t:n) (f:food/social) (w:rice liquor/local spirit) (d:a strong drink made from rice and sold by the bottle; a kind of <zu>) (r:zd:12337/zd:25532) (q:draft)
zuhawm = (i:1) (t:n) (f:social/food) (w:sharing of rice beer) (d:<zu>, rice beer, with <hawm>, share out: the sharing out of rice beer at a feast or funeral, said in the pair {zuhawm sahawm}, the sharing of beer and meat by custom) (j:zu/hawm) (r:ts:301/zd:15377) (q:draft)
zuia = (i:1) (t:adv) (f:everyday) (w:according to/following) (d:<zui>, follow, and <a> written as one word: following, in keeping with; {ahun zuia} is according to the time) (j:zui/a) (r:zd:22774/zd:11135) (q:draft)
zuiding = (i:1) (t:v) (f:everyday/social) (w:to follow/will follow/to be followed) (d:<zui> and <ding> written as one word: to follow or obey, who will follow, or that is to be followed) (j:zui/ding) (r:zd:11278/zd:19577) (q:draft)
zuihdan = (i:1) (t:n) (f:social/politics) (w:practice/way of following/rule to follow) (d:<zuih>, follow, and <dan>, way, written as one word: the way or line that people follow, a practice or policy kept) (j:zuih/dan) (r:zd:9449/zd:17264) (q:draft)
zuihding = (i:1) (t:v) (f:everyday/social) (w:to be followed/to follow/to obey) (d:<zuih> and <ding> written as one word: that is to be followed or kept, as a rule or an instruction; {zuihding thukhun} is a rule to be followed; in news reports also said of the flight a passenger is to travel on) (j:zuih/ding) (r:zd:11400/zd:20534/zd:20300) (q:draft)
zuihhuai = (i:1) (t:adj) (f:everyday/social) (w:worth following/to be followed/advisable) (d:<zuih>, follow, and <huai>, worthy of, written as one word: that ought to be followed or kept, as advice, a rule or an example; often paired with <theihhuai>, worth knowing) (j:zuih/huai) (r:zd:22474/zd:11400/zd:23394) (q:draft)
zuihkul = (i:1) (t:v) (f:social/politics) (w:must follow/have to obey) (d:<zuih> and <kul> written as one word: it is necessary to follow a rule, a path or a leader) (j:zuih/kul) (r:zd:24646) (q:draft)
zuihloh = (i:1) (t:v) (f:social) (w:not follow/not obey) (d:<zuih> and <loh> written as one word: not following, not keeping; {zuihloh phamawh} is it must be followed) (j:zuih/loh) (r:zd:21989/zd:17383/zd:17444) (q:draft)
zuihlohna = (i:1) (t:n) (f:social/politics) (w:not following/failure to obey/disobedience) (d:<zuih>, follow or obey, and <lohna>, the fact of not doing, written as one word: the fact of not following a rule or a teaching) (j:zuih/lohna) (r:ts:2891/zd:12023) (q:draft)
zuihsawm = (i:1) (t:v) (f:everyday) (w:try to follow/intend to follow) (d:<zuih>, follow, with <sawm>, intend, written as one word: try or mean to follow a person, a rule or a vehicle) (j:zuih/sawm) (r:zd:11281/zd:12148) (q:draft)
zuihsiam = (i:1) (t:v) (f:social) (w:follow well/obey properly) (d:<zuih> and <siam> written as one word: be good at following, keep rules or follow leaders as one should) (j:zuih/siam) (r:zd:22654/zd:20103) (q:draft)
zuihzuih = (i:1) (t:v) (f:everyday) (w:keep following/follow continually/trail) (d:<zuih>, follow, said twice for an action that goes on; {sul zuihzuih} is keep on someone's track) (b:zuih) (r:zd:19180/zd:19953) (q:draft)
zuiin = (i:1) (t:prep) (f:everyday) (w:according to/following/in accordance with) (d:<zui>, follow, and <in> written as one word, placed after a noun: following it, in keeping with it) (j:zui/in) (r:zd:9126/ts:3375/zd:24356) (q:draft)
zuikawikawi = (i:1) (t:v) (f:everyday/travel) (w:follow about/follow around) (d:<zui> and <kawikawi> written as one word: follow someone wherever he or she goes) (j:zui/kawikawi) (r:zd:20000/zd:16885) (q:draft)
zuikhollo = (i:1) (t:v) (f:everyday/social) (w:hardly follow/not follow much) (d:<zui>, follow, and <khollo>, not much, written as one word: follow only in small number or to a small degree) (j:zui/khollo) (r:zd:19906) (q:draft, low confidence)
zuilo = (i:1) (t:v) (f:social/politics) (w:not follow/disobey/not go along) (d:<zui> and <lo> written as one word: not follow or not keep a rule, a law or a custom; also not go along with someone) (j:zui/lo) (r:zd:15201/zd:14699/zd:23653) (q:draft)
zuilote = (i:1) (t:n) (f:social/religion) (w:those who do not follow/those who do not keep) (d:<zuilo>, not follow, with the plural <te>: people who do not follow a rule, a teaching or a belief, set against <zuite>, those who do) (b:zuilo) (r:zd:25020/zd:13155) (q:draft)
zuiphei = (i:1) (t:v) (f:travel/everyday) (w:follow across/follow over) (d:<zui>, follow, and <phei>, across, written as one word: follow someone over to another place) (j:zui/phei) (r:zd:12487) (q:draft, low confidence)
zuithei = (i:1) (t:v) (f:everyday/social) (w:can follow/be able to follow) (d:<zui> and <thei> written as one word: be able to follow, keep up with or imitate) (j:zui/thei) (r:zd:24645/zd:20764) (q:draft)
zuizolo = (i:1) (t:v) (f:everyday/education) (w:cannot follow/be unable to keep up/fail to keep) (d:<zui>, follow, and <zolo>, cannot, written as one word: be unable to keep up with lessons, or fail to keep a word or a rule) (j:zui/zolo) (r:zd:24595/zd:18244) (q:draft)
zuizui = (i:1) (t:v) (f:everyday/travel) (w:keep following/follow along/trail) (d:<zui>, follow, said twice: go on following someone or something, keep close behind; also keep following an example) (b:zui) (r:zd:25562/zd:23676/zd:17428) (q:draft)
zukhamkham = (i:1) (t:adj) (f:social/health) (w:habitually drunk/always drunk) (d:<zukham>, drunk, with its last part said twice: getting drunk again and again, a habitual drunkard) (b:zukham) (r:zd:20218/zd:20611) (q:draft)
zukhamsa = (i:1) (t:adj) (f:social/food) (w:drunk/intoxicated) (d:<zukham>, drunk, with <sa>, already: in a drunken state, mostly as {zukhamsa in}, while drunk) (j:zukham/sa) (r:zd:13350/zd:15602) (q:draft)
zukhamsul = (i:1) (t:n) (f:social/food) (w:drunkenness/drunken state) (d:<zukham>, drunk, with <sul>, track or wake: the state that follows drinking; almost always as {zukhamsul in}, while drunk, under the influence of drink) (j:zukham/sul) (r:zd:14554/zd:22267) (q:draft)
zulei = (i:1) (t:n) (c:animal) (f:nature) (w:squirrel) (r:zd:25863/zd:11347) (q:draft)
zulhtatna = (i:2) (t:n) (f:travel) (w:recklessness/carelessness) (d:the reckless or careless conduct of a driver that causes an accident, as in {mawtaw hawlpa ii zulhtatna}; not the unruly living of the Bible sense) (r:zd:19445/zd:21316) (q:draft)
zulhzau = (i:2) (t:adj) (f:social/work) (w:slack/shirking/undisciplined) (d:of a person or a mind in everyday life: not keeping to one's duty, loose and unreliable; named beside <thadah>, lazy, and <simtat>, and set against <cihtakna>, faithfulness) (r:zd:16424/zd:19501) (q:draft, low confidence)
zulo = (i:1) (t:v) (f:nature) (w:not rain/no rain falls) (d:<zu>, of rain fall, and <lo>, not, written as one word after <guah>, rain: {guah zulo} is it does not rain) (j:zu/lo) (r:zd:11362/zd:26097/zd:15637) (q:draft)
zumhon = (i:1) (t:n) (f:work) (w:office opening/office hours) (d:<zum>, office, and <hon>, open, written as one word: the opening of an office; {zumhon hun} and {zumhon hunsung} are office hours) (j:zum/hon) (r:zd:11011/zd:11449) (q:draft)
zuminn = (i:1) (t:n) (f:work) (w:office/office building) (d:<zum> and <inn> written as one word: the building or rooms where an organisation or a government has its office) (j:zum/inn) (r:zd:14630/zd:15571/zd:22935) (q:draft)
zumkah = (i:1) (t:v) (f:work) (w:go to work/go to the office/commute) (d:<zum>, office, and <kah>, go up or attend, written as one word: go to the office, go to work; paired with <zumtuak>, coming home from work) (j:zum/kah) (r:zd:21908/zd:18128) (q:draft)
zumkhakni = (i:1) (t:n) (f:time/work) (w:holiday/public holiday/day off) (d:<zumkhak>, holiday, and <ni>, day, written as one word: a day on which offices are closed) (j:zumkhak/ni) (r:zd:19631/zd:24276) (q:draft)
zumkhan = (i:1) (t:n) (f:work) (w:office/office room) (d:<zum>, office, with <khan>, room: a room or set of rooms used as an office) (r:zd:12482/zd:12272) (q:draft)
zumkhen = (i:1) (t:n) (f:work/politics) (w:branch office/liaison office) (d:<zum>, office, with <khen>, divide: an office that an organisation keeps away from its head office) (r:zd:22381/ts:9370) (q:draft)
zumkhum = (i:1) (t:n) (f:health) (w:diabetes) (d:the sugar disease, literally sweet urine; the dictionary writes {zunkhum natna}, and one article names it beside <sikhum>) (r:zd:24276) (q:draft, low confidence)
zumkong = (i:1) (t:n) (f:politics/social) (w:court/office/authorities) (d:the door of an office, <zum> with <kong>; mostly in the pair {zumkong mangkong}, the courts and the authorities before whom a dispute is brought) (r:zd:15794/ts:6443/zd:24085) (q:draft)
zumlam = (i:1) (t:n) (f:politics/work) (w:the authorities/office/government side) (d:<zum>, office, with <lam>, side: the office or the authorities as the party that acts; {zumlam panin} is from the authorities) (j:zum/lam) (r:zd:12280/zd:24297/zd:25107) (q:draft)
zumnamel = (i:1) (t:n) (f:social) (w:sense of shame/sign of shame) (d:<zumna>, shame, and <mel>, appearance, written as one word: any look or sense of shame, mostly with a negative, without shame) (j:zumna/mel) (r:zd:19562/zd:12913) (q:draft)
zumnasem = (i:1) (t:n) (f:work) (w:office worker/office staff/clerk) (d:<zum>, office, with <nasem>, worker: a person who works in an office) (j:zum/nasem) (r:zd:19213/zd:16865) (q:draft)
zumnuai = (i:1) (t:adv) (f:travel/politics) (w:below the office) (d:<zum> in the sense office with <nuai> written as one word: at the lower side of an office or station, as in {Palik zumnuai}, below the police station) (j:zum/nuai) (r:zd:16871) (q:draft, low confidence)
zumpai = (i:1) (t:v) (f:work) (w:go to the office/go to work) (d:<zum>, office, and <pai>, go, written as one word: go to the office, attend work at an office) (j:zum/pai) (r:zd:21876) (q:draft, low confidence)
zumpan = (i:1) (t:adv) (f:work/politics) (w:from the office) (d:<zum>, office, and <pan>, from, written as one word, after the name of the office: from that office) (j:zum/pan) (r:zd:22875/zd:22714) (q:draft)
zumpi = (i:1) (t:n) (f:work/politics) (w:office/head office/headquarters) (d:<zum>, office, with the augmentative <pi>: the office or main office of a government body, an organisation or a church; {thukhenna zumpi} is a court) (b:zum) (r:zd:21217/ts:4587/zd:10892) (q:draft)
zumpih = (i:1) (t:v) (f:social/everyday) (w:be ashamed of) (d:<zum>, be ashamed, with <pih>: feel shame because of someone or something, be ashamed of one's people, parents or conduct) (j:zum/pih) (r:zd:21090/zd:24086/zd:22034) (q:draft)
zumpisung = (i:1) (t:phrase) (f:work/politics) (w:in the office/inside the office) (d:<zumpi>, office, and <sung>, inside, written as one word: the inside of an office, in the office) (j:zumpi/sung) (r:zd:12269/zd:15485) (q:draft)
zumpite = (i:1) (t:n) (f:work/politics) (w:offices) (d:<zumpi>, office, with the plural <te>: offices, and the people of an office) (b:zumpi) (r:zd:16488/zd:17011/ts:3471) (q:draft)
zumpiten = (i:1) (t:n) (f:politics/media) (w:the office/the offices) (d:<zumpi> and <ten> written as one word: the office or offices as the ones who say or announce something) (j:zumpi/ten) (r:ts:3687/ts:1666) (q:draft)
zumsung = (i:1) (t:n) (f:work) (w:office/inside the office) (d:<zum>, office or court, and <sung>, inside, written as one word: the office as a place of work, in the office) (j:zum/sung) (r:zd:11441/zd:15485) (q:draft)
zumte = (i:1) (t:n) (f:politics/work) (w:offices/courts) (d:<zum>, office or court, with the plural <te>: offices; {kumpi zumte} are government offices and {thukhen zumte} are the courts of law) (b:zum) (r:zd:21125/zd:25322) (q:draft)
zumtuah = (i:1) (t:v) (f:work) (w:leave work/finish work/come off work) (d:the end of the working day at the office, when people go home; the counterpart of <zumkah>, go to work, and formed like <sangtuah>, school is out; {zumtuah hun} is the evening rush hour) (r:zd:12029/zd:11750) (q:draft)
zumtuak = (i:1) (t:v) (f:work) (w:come off work/leave the office/finish work) (d:<zum>, office, with <tuak>: come away from the office at the end of the working day, paired with <zumkah>, go to work; also the time of leaving work) (a:zumkah) (r:zd:17295/zd:25201) (q:draft)
zumvai = (i:1) (t:n) (f:work/politics) (w:office matters/official business/office work) (d:<zum>, office, with <vai>, affair: business that has to be done at or with an office or the authorities) (r:zd:21127/zd:19320) (q:draft)
zun = (i:3) (t:v) (f:social) (w:tend/care for/build up) (d:look after and build up a land or a people so that it thrives, often paired with <puah>, repair; a verb, not the noun urine) (r:ts:3508/zd:15874/zd:22356) (q:draft, low confidence)
zunbuk = (i:1) (t:n) (f:home/health) (w:urinal/toilet) (d:<zun>, urine, with <buk>, here a hut or shelter: a place for passing urine; often named together with <ekbuk>) (r:zd:19750/zd:16862) (q:draft)
zungbulh = (i:1) (t:n) (f:home/family) (w:ring/finger ring) (d:a ring worn on the finger, in the articles a wedding or engagement ring; another form of <zungbuh>) (s:zungbuh/khutbuh) (r:zd:16133) (q:draft)
zungkip = (i:1) (t:v) (f:nature/social) (w:be firmly rooted/take firm root) (d:<zung>, root, and <kip>, be firm, written as one word: of a tree, have roots that hold fast; of love or belief, be deeply rooted) (j:zung/kip) (r:zd:19998/zd:16037) (q:draft)
zungpan = (i:1) (t:adv) (f:nature) (w:from the root/by the root) (d:<zung>, root, with <pan>, from, written as one word) (j:zung/pan) (r:zd:17976/zd:19816) (q:draft)
zunin = (i:1) (t:v) (f:social) (w:tending/building up) (d:<zun>, tend, and <in> written as one word, after <puah>, repair: tending and building up; in one article it stands for <zuanin>, heading for) (j:zun/in) (r:zd:10912) (q:draft, low confidence)
zunkhum = (i:1) (t:n) (f:health) (w:diabetes) (d:<zun>, urine, with <khum>, sweet: diabetes, the disease of too much sugar in the blood, also {zunkhum natna}) (r:zd:21032/zd:14586/zd:20747) (q:draft)
zunlampi = (i:1) (t:n) (f:body/health) (w:urinary tract/urethra) (d:the passage by which urine leaves the body, from <zun>, urine, and <lampi>, way) (r:zd:24276/zd:22433) (q:draft)
zunpek = (i:1) (t:v) (f:body) (w:urinate on/pee on) (d:pass <zun>, urine, onto a thing or a place, squirt urine at it) (r:zd:17930/zd:18289) (q:draft, low confidence)
zunsuak = (i:1) (t:v) (f:body/health) (w:urinate/pass urine) (d:<zun>, urine, with <suak>, here come out: pass urine, also the need to do so) (r:zd:21168/zd:13195) (q:draft)
zunsuakpahpah = (i:1) (t:v) (f:health/body) (w:urinate often/pass urine frequently) (d:<zunsuak> and <pahpah> written as one word: need to pass urine again and again) (j:zunsuak/pahpah) (r:zd:21651) (q:draft)
zuntha = (i:1) (t:v) (f:body) (w:urinate/pass urine) (d:<zun>, urine, with <tha>, here let out: pass urine) (r:zd:20588/zd:18289) (q:draft)
zunthak = (i:1) (t:v) (f:body/health) (w:urinate/pass urine) (d:<zun>, urine, and a verb for passing it out of the body, also written {zun a thak}; as a noun, urination) (r:zd:14708/zd:13195) (q:draft)
zunthakna = (i:1) (t:n) (f:body/health/home) (w:urination/urinal/toilet) (d:the passing of <zun>, urine, and the place for it; {zunthakna lampi} is the urinary tract and {pasal zunthakna} the men's toilet) (r:zd:18289/zd:22433) (q:draft)
zupengnawng = (i:1) (t:adj) (f:everyday/health) (w:drunk/dead drunk/intoxicated) (d:heavily drunk with <zu>, alcoholic drink; also a person in that state) (s:zukham) (r:zd:10670/zd:10729) (q:draft, low confidence)
