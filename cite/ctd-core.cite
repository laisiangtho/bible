kavan = (i:1) (t:n) (f:home/travel) (w:my goods/my belongings/my luggage) (d:<ka> and <van> written as one word, <van> in the sense goods: my things, my belongings, my bag) (j:ka/van) (r:zd:22162/zd:12138) (q:draft)
kaw = (i:1) (t:n) (f:everyday/home) (w:glue/sticky substance) (d:glue or a sticky substance that clings to the hands) (r:zd:21243) (q:draft, low confidence)
kawikaih = (i:1) (t:v) (f:social/politics) (w:twist/distort/bend) (d:pull a matter out of its straight course, twist words or rules to suit oneself; {thu kawikaih} is twisting of matters, a roundabout way of speaking) (r:zd:25516) (q:draft)
kawikawiding = (i:1) (t:v) (f:everyday/travel) (w:will do around/will do here and there) (d:<kawikawi>, about, here and there, and the future marker <ding> written as one word; after a verb: will do it in one place after another) (j:kawikawi/ding) (r:zd:19558/zd:12626/zd:20293) (q:draft)
kawk = (i:3) (t:v) (f:everyday/education) (w:refer to/mean/denote) (d:of a word, a text or a speaker: have someone or something in view, mean it, without any pointing of the hand; the thing meant stands before {kawk}, as in {mi pawlkhat bek a kawk hi loin}, not referring to some people only) (r:zd:12333/zd:19299/zd:23022) (q:draft)
kawkna = (i:1) (t:n) (f:everyday/education) (w:reference/pointing at/denotation) (d:the act of pointing at or referring to someone or something, from <kawk>; also what a word refers to) (b:kawk) (r:zd:25043/zd:12544) (q:draft)
kawl = (i:3) (t:n) (f:politics/social) (w:Burmese/Burman/Myanmar) (d:the Burman people, their language and their country, usually written {Kawl}; before a noun it means Burmese, as in {Kawl galkap}, the Myanmar army, {Kawl kumpi}, the Myanmar government, and <Kawlgam>, Myanmar) (r:zd:21379/zd:12487/zd:19612) (q:draft)
Kawlbiakna = (i:1) (t:name) (f:religion) (w:Buddhism/Burmese religion) (d:{Kawl}, Burmese, with <biakna>, religion: the religion of the Burmese, Buddhism) (s:Buddhist) (r:zd:15859/zd:22873) (q:draft)
Kawlgaalkap = (i:1) (t:n) (f:politics) (w:Burmese army/Myanmar military/Burmese soldier) (d:{Kawl}, Burmese, and <gaalkap>, soldier or army, written as one word: the army of Myanmar or its soldiers) (r:zd:25394/zd:25165) (q:draft)
Kawlgaalkapte = (i:1) (t:n) (f:politics) (j:Kawlgalkapte) (r:zd:25569/zd:25394) (q:draft)
Kawlgalkap = (i:1) (t:n) (f:politics) (w:Burmese army/Myanmar military/Burmese soldier) (d:{Kawl}, Burmese, with <galkap>, soldier or army: the armed forces of Myanmar or their soldiers) (r:zd:11639/zd:12936/zd:15228) (q:draft)
Kawlgalkapte = (i:1) (t:n) (f:politics) (w:Burmese soldiers/Myanmar army troops) (d:{Kawl}, Burmese, written as one word with <galkapte>: the soldiers of the Myanmar army) (b:galkapte) (r:zd:25094/zd:16336) (q:draft)
Kawlgam = (i:1) (t:name) (c:land) (f:politics/travel) (w:Myanmar/Burma) (d:{Kawl}, Burmese, with <gam>, country: the country of Myanmar) (s:Myanmar) (r:zd:24276/ts:11162/zd:11844) (q:draft)
Kawlgamah = (i:1) (t:adv) (f:politics/travel) (w:in Myanmar/in Burma/to Myanmar) (d:<Kawlgam>, Myanmar, written as one word with the place marker <ah>: in or to Myanmar) (j:Kawlgam/ah) (r:zd:21866/zd:24673/zd:15527) (q:draft)
Kawlgambup = (i:1) (t:name) (c:land) (f:politics) (w:all Myanmar/the whole of Burma) (d:<Kawlgam>, Myanmar, with <bup>, whole: the whole country of Myanmar; before a noun, nationwide, all-Myanmar) (j:Kawlgam/bup) (r:zd:13239/zd:17162) (q:draft)
Kawlgamin = (i:1) (t:phrase) (f:politics) (w:Myanmar/Burma) (d:<Kawlgam>, Myanmar, and the marker <in> written as one word: Myanmar as the subject of the sentence) (j:Kawlgam/in) (r:zd:11400/zd:19239) (q:draft)
Kawlgammi = (i:1) (t:name) (c:people) (f:social/politics) (w:Myanmar national/Burmese) (d:<Kawlgam>, Myanmar, with <mi>, person: a person or the people from Myanmar, of any of its peoples) (b:Kawlgam) (r:zd:16061/zd:11303/zd:11040) (q:draft)
Kawlgamsum = (i:1) (t:n) (f:work) (w:Myanmar kyat/Myanmar money) (d:<Kawlgam>, Myanmar, and <sum>, money, written as one word: the money of Myanmar, the kyat) (j:Kawlgam/sum) (r:zd:11364/zd:11639/zd:16114) (q:draft)
Kawlgamsung = (i:1) (t:phrase) (f:politics/travel) (w:in Myanmar/inside Myanmar) (d:<Kawlgam>, Myanmar, and <sung>, in, written as one word: within Myanmar) (j:Kawlgam/sung) (r:zd:15045/zd:11380) (q:draft)
Kawlin = (i:1) (t:name) (c:city) (f:travel/politics) (w:Kawlin) (d:town in Sagaing Region in the north of Myanmar) (r:ts:3921/ts:3954) (q:draft)
kawlkai = (i:1) (t:n) (f:food/nature) (w:sweet potato) (d:a root crop grown in the fields, whose leaves are also eaten; named beside maize, taro and beans) (r:zd:15767/ts:3375) (q:draft)
kawlkal = (i:1) (t:n) (f:everyday) (j:kawmkal) (r:zd:19556/zd:25322) (q:draft, low confidence)
Kawlkam = (i:1) (t:name) (f:education/social) (w:Burmese/Burmese language) (d:the Burmese language: {Kawl}, Burmese, with <kam>, speech) (r:zd:25208/zd:25454/zd:23533) (q:draft)
Kawlkumpi = (i:1) (t:n) (f:politics) (w:Burmese government/government of Myanmar) (d:{Kawl}, Burmese, with <kumpi>, king or government: the government of Myanmar, and in accounts of the past the Burmese rulers) (r:zd:16336/zd:19612) (q:draft)
Kawlla = (i:1) (t:n) (f:media/social) (w:Burmese song/Burmese music) (d:a song in the Burmese language, {Kawl} with <la>, song; set beside <Zola>, the Zo song) (b:la) (r:zd:16442/zd:22686) (q:draft)
Kawllai = (i:1) (t:name) (f:education) (w:Burmese/Burmese writing) (d:the Burmese language as it is written and as a school subject: {Kawl}, Burman, with <lai>, writing; named beside <Manglai>, English, and <Zolai>) (r:zd:24574/ts:301/zd:25394) (q:draft)
Kawllukhu = (i:1) (t:n) (f:home) (w:umbrella) (d:an umbrella; built from {Kawl}, Burmese, and <lukhu>, hat) (r:zd:20484/zd:12240) (q:draft)
Kawlmang = (i:1) (t:n) (f:politics) (w:Burmese rulers/Burmese government/Burmese authorities) (d:{Kawl}, Burman, with a word for a ruler or official: the Burman rulers and their government, as opposed to <Mangkaang>, the British; see <Kawlte>) (r:zd:23488/ts:11162) (q:draft)
Kawlmi = (i:1) (t:name) (c:people) (f:social/politics) (w:Burman/Bamar/Burmese person) (d:{Kawl}, Burman, with <mi>, person: a Burman, a member of the majority people of Myanmar, as against the hill peoples) (r:zd:24455/zd:19662) (q:draft)
Kawlmite = (i:1) (t:name) (c:people) (f:social/politics) (w:Burmans/Bamar/Burmese people) (d:the Burman people, the majority people of Myanmar, as distinct from the hill peoples; plural of <Kawlmi>) (b:Kawlmi) (r:zd:20786/zd:24455/zd:11244) (q:draft)
Kawlngian = (i:1) (t:n) (f:politics) (w:Burmese trickery/Burmese cunning) (d:the cunning of the Burmans, {Kawl} with <ngian>: political trickery ascribed to the Burman rulers by writers of the hill peoples; {Kawlngian zang} is use Burmese trickery) (r:zd:17722/zd:25569) (q:draft)
Kawlpau = (i:1) (t:name) (f:social/education) (w:Burmese/Burmese language) (d:the Burmese language; {Kawl}, Burmese, with <pau>, language) (r:zd:17208/zd:12314/zd:24480) (q:draft)
Kawlpi = (i:1) (t:name) (c:city) (f:travel) (w:Kalay/Kalaymyo/Kalemyo) (d:Zolai name of the town of Kalay in Sagaing Region, Myanmar, where many Zomi live) (r:zd:22773/zd:19798) (q:draft)
kawlsai = (i:1) (t:n) (f:food/work) (w:Burmese shop/Burmese restaurant) (d:{Kawl}, Burmese, with <sai>, shop: a shop or eating place run by people from Myanmar, in the articles those in Malaysia; set beside <Zosai>, a Zomi shop) (r:zd:20008/zd:19932) (q:draft)
kawlsum = (i:1) (t:n) (f:work) (w:Burmese money/kyat) (d:{Kawl}, Burmese, with <sum>, money: the money of Myanmar, the kyat, mostly before an amount) (r:zd:25085/zd:25043/zd:22210) (q:draft)
Kawlte = (i:1) (t:name) (c:people) (f:social/politics) (w:Burmese/Burmans) (d:the Burmans, the majority people of Myanmar; {Kawl}, Burman, with the plural <te>) (r:zd:18200/zd:20919/zd:19239) (q:draft)
kawlten = (i:1) (t:phrase) (c:people) (f:politics/social) (w:the Burmans/the Burmese) (d:<Kawlte>, the Burmans, with {-n}, the short form of <in> that marks the doer, written as one word: the Burmans as the ones who act or speak; written with a capital at the start of a sentence) (r:zd:17212/zd:21340) (q:draft)
Kawlzang = (i:1) (t:name) (c:land) (f:travel/politics) (w:Burmese plains/Kabaw Valley) (d:the lowland where the Burmese live, set against the Chin hills; Zomi use the name especially for the Kabaw Valley) (r:zd:20900/zd:22291/zd:24038) (q:draft)
Kawlzatui = (i:1) (t:n) (f:health) (w:Burmese medicine/Burmese traditional medicine) (d:{Kawl}, Burmese, with <zatui>, medicine: a medicine made in Myanmar) (r:zd:17526) (q:draft, low confidence)
kawm = (i:1) (t:n) (f:home) (w:wall) (d:the wall of a house or room; {kawm bangin} is like a wall) (q:draft)
kawm = (i:3) (t:n) (f:body/everyday) (w:gap/crevice) (d:the narrow space between or under things that lie close together, after the name of the thing: {ha kawm} is the gaps between the teeth, {khutme kawm} the space under the fingernails) (r:zd:11020/zd:16878) (q:draft, low confidence)
kawmkaal = (i:1) (t:n) (f:everyday) (w:midst/meantime/interval) (d:the space or time between things, placed after a noun or clause and mostly followed by <ah> or {pan-in}: amid, in the midst of, in the meantime) (r:zd:20550/zd:15162/zd:25232) (q:draft)
kawmkaalah = (i:1) (t:prep) (f:everyday/time) (w:in the midst of/meanwhile/amid) (d:<kawmkaal>, the space or time between, and <ah> written as one word; {tuabang kawmkaalah} is in the midst of this, meanwhile) (j:kawmkaal/ah) (r:zd:21279/zd:21626) (q:draft)
kawmkal = (i:1) (t:n) (f:everyday) (w:midst/gap/interval) (d:the space between two things, or the time during which something goes on; {tua kawmkal ah} is meanwhile, in the midst of that) (r:zd:23198/zd:17143/zd:16442) (q:draft)
kawmkalah = (i:1) (t:prep) (f:everyday) (w:amid/among/in the midst of) (d:<kawmkal>, the space between, with the place marker <ah>: in the midst of people, things or circumstances, also in spite of them) (s:lakah) (r:zd:21268/zd:9445/zd:21978) (q:draft)
kawmman = (i:1) (t:n) (f:work) (w:hire charge/fee/rent) (d:<kawm>, hire, with <man>, price: the money paid for hiring a thing or the services of a person) (r:zd:19410/zd:15681) (q:draft, low confidence)
kawmtung = (i:1) (t:n) (f:home) (w:wall/wall surface) (d:<kawm>, wall, and <tung>, upon, written as one word: the face of a wall, where pictures are hung or painted; {kawmtung a kisuang} is hung on the wall) (j:kawm/tung) (r:zd:19518/zd:15653) (q:draft)
kawpi = (i:1) (t:n) (c:plant) (f:food) (w:cabbage) (d:a vegetable named in lists of vegetables beside <ankam>, mustard greens; cabbage, Burmese gawbi) (o:Burmese) (r:zd:24276) (q:draft, low confidence)
kawt = (i:1) (t:v) (f:everyday/nature) (w:wet/be wet) (d:be or become wet or moist; of water, soak the ground or a thing) (a:keu)
Kayah = (i:1) (t:name) (c:land) (f:politics) (w:Kayah) (d:Kayah State in eastern Myanmar, also called Karenni, with the capital Loikaw; also the name of its people) (r:zd:12259/zd:14609) (q:draft)
Kayin = (i:1) (t:name) (c:people/land) (f:politics/social) (w:Karen/Kayin) (d:the Karen people of Myanmar and Kayin State, their state in the south-east of the country) (o:Burmese) (r:zd:23597/zd:17175) (q:draft)
kaza = (i:1) (t:v) (f:everyday) (w:I hear/I heard) (d:<ka> and <za> written as one word: I hear, I have heard; {cih thu kaza hi} is I have heard that) (j:ka/za) (r:zd:26163/zd:12845) (q:draft)
kazak = (i:1) (t:v) (f:everyday) (w:I hear/I heard) (d:<ka>, the first person marker, and <zak>, the form of <za>, hear, written as one word: that I hear or heard, my hearing of it) (j:ka/zak) (r:zd:25173/zd:13181/zd:24139) (q:draft)
Kazakhstan = (i:1) (t:name) (c:land) (f:travel/politics) (w:Kazakhstan) (d:country in Central Asia) (r:zd:10828/ts:8955) (q:draft)
kazang = (i:1) (t:v) (f:everyday) (w:I use/we use/spend) (d:<ka> and <zang> written as one word: I use, or with <uh> we use; of time, spend) (j:ka/zang) (r:zd:14910/zd:15767) (q:draft)
kazat = (i:1) (t:v) (f:everyday) (w:use/spend) (d:<ka> and <zat> written as one word: I or we use, or spend a time; {hun kazat} is the time I spent or the service I led) (j:ka/zat) (r:zd:10973/zd:21561) (q:draft)
kazi = (i:1) (t:n) (f:family) (w:my wife) (d:<ka> and <zi> written as one word: my wife) (j:ka/zi) (r:zd:19232/zd:25572/zd:16337) (q:draft)
kazin = (i:1) (t:v) (f:travel) (w:I travel/my journey) (d:<ka> and <zin>, travel, written as one word: I travel, I visit; {kazin sung} is during my journey) (j:ka/zin) (r:zd:21421/zd:25572) (q:draft)
kazuan = (i:1) (t:v) (f:travel) (w:I head for/we go to) (d:<ka> and <zuan> written as one word: I, or with <uh> we, go to or make for a place) (j:ka/zuan) (r:zd:24594/zd:25572) (q:draft)
KBZ = (i:1) (t:name) (f:work) (w:KBZ/Kanbawza Bank) (d:short name of Kanbawza Bank, a private bank in Myanmar, said as {KBZ Bank}) (r:zd:18017/zd:15913) (q:draft)
Kedah = (i:1) (t:name) (c:land) (f:travel) (w:Kedah) (d:a state in the north of Malaysia) (r:zd:11479/zd:12761) (q:draft)
keeimawk = (i:1) (t:part) (f:everyday) (d:the emphatic <keei> and <mawk> written as one word after a verb: really, quite, to the surprise of the speaker) (j:keei/mawk) (r:zd:25225/zd:16038) (q:draft, low confidence)
keek = (i:4) (t:part) (f:everyday) (w:exactly/just/even) (d:word of emphasis placed after <bang>, like, after a pronoun or after a verb, often followed by <mah>: {ka cihbang keek} is exactly as I said; no bow, lightning or border is meant) (r:zd:21843/zd:24370) (q:draft, low confidence)
keh = (i:3) (t:conj) (f:everyday) (w:if not/or else/if) (d:colloquial short form of {kei leh}, if not, placed after a verb as in {a om keh}; {ahih keh} or {aih keh} is or else, otherwise; some writers also use it for plain <leh>, if) (r:zd:21107/zd:21380/zd:22830) (q:draft)
kehkhia = (i:1) (t:v) (f:everyday/health) (w:leak/leak out/escape) (d:<keh>, leak, with <khia>, out: come out through a crack or hole, said of gas, chemicals and the like) (b:keh) (r:zd:14575/zd:15481) (q:draft)
kei = (i:1) (t:pron) (f:everyday) (w:I/me) (d:first person singular pronoun: I or me; with the possessive mark it means my) (s:ken/ke)
kei = (i:2) (t:conj) (f:everyday) (w:do not/shall not/will not/not) (d:negative word placed after the verb: {kei hi} states that something is not so, {kei in} and {kei un} forbid, and {kei ding hi} means shall not) (r:1.2.17)
kei inla = (i:1) (t:conj) (f:everyday) (w:do not ... but/do not ... and) (d:<kei.2>, not, and <inla>, the polite particle of a command that is followed by another: placed after a verb, it forbids that act and leads on to a second command, do not do this but do that, or do not do this and not that) (r:zd:21075/zd:23972/zd:20805) (q:draft)
kei ning = (i:1) (t:part) (f:everyday) (w:I will not/I shall not) (d:<kei>, here the negative word and not the pronoun I, with <ning>, the verb-final word of the first person singular: placed after a verb at the end of the sentence, I will not; {nawn kei ning} is I will no longer and {zo kei ning} is I will not be able to) (r:zd:23424/zd:23428/zd:21659) (q:draft)
kei phial = (i:1) (t:conj) (f:everyday) (w:even if not/even though not) (d:<kei>, here the negative not and not the pronoun I, and <phial>, even if: placed after a verb and followed by <zongin>, <mah taleh> or <lehzong>, even if it is not so, even though it does not happen) (r:zd:23554/zd:21529) (q:draft)
kei unla = (i:1) (t:conj) (f:everyday/religion) (w:do not ... but/do not ... and) (d:the negative <kei>, not, with <unla>, the plural command that goes on to a further clause: placed after a verb in an address to several people, do not do this, but or and; the next clause gives the command that follows, often ending in <un>) (r:zd:19397/zd:24064/zd:22159) (q:draft)
keibang = (i:1) (t:phrase) (f:everyday) (w:one like me/someone like me) (d:<kei> and <bang> written as one word: a person like me, like me) (j:kei/bang) (r:zd:23361/zd:22977) (q:draft)
keibek = (i:1) (t:pron) (f:everyday) (w:only I/I alone/just me) (d:<kei> and <bek> written as one word: I alone, only me) (j:kei/bek) (r:zd:14824/zd:20263) (q:draft)
keibel = (i:1) (t:pron) (f:everyday) (w:as for me/I for my part) (d:<kei>, I, and the particle <bel>, written as one word: as for me, I on my part, setting the speaker apart from others) (j:kei/bel) (r:zd:16442/zd:19581) (q:draft)
keiding = (i:1) (t:part) (f:everyday) (w:will not/shall not) (d:the negative <kei> and the future marker <ding> written as one word after a verb: will not do it) (j:kei/ding) (r:zd:19556/zd:23737/zd:16630) (q:draft)
keihi = (i:1) (t:part) (f:everyday) (w:not/do not/did not) (d:<kei> and <hi> written as one word at the end of a sentence, after the verb: the statement is negative, mostly with a first person subject) (j:kei/hi) (r:zd:19671/zd:17651/zd:17661) (q:draft)
keii = (i:1) (t:part) (f:everyday) (j:keei) (r:zd:16148/zd:24592) (q:draft, low confidence)
keikia = (i:1) (t:pron) (f:everyday) (w:I alone/only I/by myself) (d:<kei> with an ending meaning alone: I alone, I by myself with no one else; often followed by <bek>) (s:keibek) (r:zd:22773/zd:23734/zd:14824) (q:draft)
keilai = (i:1) (t:adv) (f:everyday) (w:still not/not yet) (d:<kei>, not, and <lai>, still, written as one word at the end of a clause, often after <nai>: still not, not yet) (j:kei/lai) (r:zd:21862/zd:21458) (q:draft)
keile = (i:1) (t:conj) (f:everyday) (w:if not/unless) (d:<kei>, not, and <le>, if, written as one word after a verb: if it is not so, if one does not) (j:kei/le) (r:zd:25200/zd:24289) (q:draft)
keileh = (i:1) (t:conj) (f:everyday) (w:if not/unless) (d:<kei>, not, and <leh>, if, written as one word after a verb: if it is not so, unless; {ahih keileh} is or else, otherwise) (j:kei/leh) (r:zd:23906/zd:26026/zd:21605) (q:draft)
keilehkei = (i:1) (t:pron) (f:everyday) (w:myself/I myself) (d:<kei>, <leh> and <kei> written as one word, I and I: myself as the one acted on, used with a verb in <ki>) (r:zd:20569/zd:16259) (q:draft)
keilehzong = (i:1) (t:conj) (f:everyday) (w:even if not/even though not) (d:<keileh> and <zong> written as one word after a verb: even if it is not so) (j:keileh/zong) (r:zd:24977/zd:17841) (q:draft)
keilekei = (i:1) (t:pron) (f:everyday) (w:myself/I myself) (d:<kei>, <le> and <kei> written as one word, literally I and I: myself, as the one who both does and receives the action, often before <kaki>) (j:kei/le) (r:zd:16366/zd:16337) (q:draft)
keileng = (i:1) (t:conj) (f:everyday) (w:if not/unless) (d:the negative <kei> and <leng>, if, written as one word after a verb: if we do not, if one does not) (j:kei/leng) (r:zd:12389/zd:21110) (q:draft)
keima = (i:1) (t:pron) (f:everyday) (w:my/mine) (d:possessive form of <kei>, placed before a noun: my; {keima aa} means mine) (s:kei/ken) (b:kei)
keini = (i:1) (t:part) (f:everyday) (w:let us not) (d:<kei>, not, and the first person plural ending <ni>, let us, written as one word after a verb: let us not do so) (r:zd:24062/zd:17886) (q:draft)
keipen = (i:1) (t:pron) (f:everyday) (w:I/as for me) (d:<kei>, I, with the topic marker <pen>, written as one word: as for me, I) (j:kei/pen) (r:zd:11677/zd:19472) (q:draft)
keiphial = (i:1) (t:conj) (f:everyday) (j:kei phial) (r:zd:16302/zd:24365) (q:draft)
keita = (i:1) (t:part) (f:everyday) (w:no longer/not any more) (d:the negative <kei> and <ta>, now, written as one word after a verb: not any more; {keita hen} is let it not be so, {keita leh} if no longer) (j:kei/ta) (r:zd:25923/zd:12707) (q:draft, low confidence)
keitah = (i:1) (t:phrase) (f:everyday) (d:the negative <kei.2> with a closing word of assurance, written as one word and followed by <ci>: surely will not, said of what someone wrongly supposes, as in {hong mu keitah ci}, thinking that no one will see) (r:zd:23488/zd:15942) (q:draft, low confidence)
keitawh = (i:1) (t:phrase) (f:everyday) (w:with me) (d:<kei>, I, and <tawh>, with, written as one word: with me, together with me; {keitawh kisai kei} is it does not concern me) (j:kei/tawh) (r:zd:17332/zd:16224/zd:21869) (q:draft)
Keizang = (i:1) (t:name) (c:khua) (f:travel/social) (w:Keizang) (d:a Zomi village of the Tedim area in Chin State, often named together with Cingpikot) (r:zd:17208) (q:draft, low confidence)
keizaw = (i:1) (t:part) (f:everyday) (w:rather not/not) (d:the negative <kei> with <zaw>, rather, written as one word after a verb: rather not, used to advise against something) (j:kei/zaw) (r:zd:19222/zd:16588) (q:draft, low confidence)
keizel = (i:1) (t:part) (f:everyday) (w:still not/again not) (d:the negative <kei>, not, with <zel>, again and again, written as one word after a verb: once more not, still not so) (j:kei/zel) (r:zd:19239/zd:22922) (q:draft, low confidence)
keizong = (i:1) (t:pron) (f:everyday) (w:I also/me too) (d:<kei>, I, and <zong>, also, written as one word: I too, I as well) (j:kei/zong) (r:zd:16337/zd:15107) (q:draft)
keizongin = (i:1) (t:conj) (f:everyday) (w:even if not/although not) (d:the negative <kei> with <zongin>, even if, written as one word after a verb: even if it does not, whether or not) (j:kei/zongin) (r:zd:20997/zd:15382) (q:draft)
kek = (i:4) (t:v) (f:everyday/politics) (w:widen/expand/enlarge) (d:make a road, a piece of land or a territory wider or larger, close to <golsak>; {gam kek} is extend the territory of a country) (s:golsak) (r:zd:18952/zd:24227) (q:draft)
kekin = (i:1) (t:adv) (f:everyday) (w:apart/asunder) (d:<kek>, apart or to pieces, and the marker <in> written as one word after a verb of tearing or fleeing: so as to break apart) (j:kek/in) (r:zd:25967) (q:draft, low confidence)
kekkek = (i:1) (t:adv) (f:everyday) (w:wider and wider/spreading out) (d:taken as <keek.3>, widen, said twice: of a fence or a town, pushed out further and further) (r:zd:19599/zd:22849) (q:draft, low confidence)
kekkia = (i:1) (t:n) (f:nature) (j:keekkia) (r:zd:20188/zd:19088) (q:draft)
Kelana = (i:1) (t:name) (c:place) (f:travel) (w:Kelana Jaya) (d:first word of Kelana Jaya, a part of the city of Petaling Jaya in Selangor, Malaysia, with an LRT station and a clinic) (r:zd:17994) (q:draft)
Kelantan = (i:1) (t:name) (c:place) (f:travel) (w:Kelantan) (d:a state in the north-east of Peninsular Malaysia) (r:zd:11679/zd:17262) (q:draft)
kelki = (i:1) (t:n) (f:nature) (w:goat horn) (d:{kel}, goat, also written <keel>, and <ki>, horn, written as one word: the horn of a goat) (r:zd:21376) (q:draft, low confidence)
kelkong = (i:1) (t:n) (f:home) (w:gate/gateway) (d:the gate in the fence of a house or compound) (s:kongpi) (r:zd:13302/zd:25192) (q:draft)
kem siapa = (i:1) (t:n) (f:religion) (w:pastor/minister in charge) (d:<kem>, look after, and <siapa>, teacher: the minister who has charge of a congregation; it stands after <pawlpi> or the name of a church, {pawlpi kem siapa}, the pastor of the church, and often before the title Rev. and a name) (r:zd:25734/zd:11653/zd:17327) (q:draft)
Kemaman = (i:1) (t:name) (c:place) (f:travel) (w:Kemaman) (d:a district and town in the state of Terengganu, Malaysia) (r:zd:11350/zd:15165) (q:draft)
kembit = (i:1) (t:v) (f:religion/politics) (w:keep safe/protect/safeguard) (d:<kem>, look after, with <bit>, safe: keep a person or thing safe, common in the blessing {Topan hong kembit ta hen}) (j:kem/bit) (r:zd:24382/zd:25110) (q:draft)
kemcing = (i:1) (t:v) (f:everyday/social) (w:preserve/keep safe/guard/look after) (d:<kem>, keep, with <cing>, guard: keep something safe and whole so that it is not lost or harmed) (j:kem/cing) (r:zd:25110/zd:23990/zd:18026) (q:draft)
kemcingin = (i:1) (t:v) (f:everyday) (w:keep safe/look after well) (d:<kem>, keep, and <cing>, guard, with the ending <in>, written as one word: keeping it safe; at the end of a sentence a command, keep it safe) (j:kem/cing/in) (r:zd:21664) (q:draft)
kemcip = (i:2) (t:v) (f:social/politics) (w:detain/hold in custody) (d:of police or armed men, keep a person locked up or under guard for a time, often with the number of days and <phot>, for now; {ki kemcip} is be detained) (r:zd:16786/zd:12493/ts:3110) (q:draft)
kemcipding = (i:1) (t:v) (f:politics) (w:will detain/will hold in custody) (d:<kemcip>, keep hold of, and <ding>, will, written as one word: will keep someone in custody, said of the police) (j:kemcip/ding) (r:zd:19495/zd:11312) (q:draft)
kemcippah = (i:1) (t:v) (f:politics) (w:detain at once/lock up immediately) (d:<kemcip>, keep fast, and <pah>, at once, written as one word; with <ki>, be taken into custody at once) (j:kemcip/pah) (r:zd:20416/zd:12138) (q:draft)
kemding = (i:1) (t:v) (f:everyday/family) (w:will look after/to keep/to care for) (d:<kem>, look after or keep, and <ding> written as one word: will look after, or how something is to be kept) (j:kem/ding) (r:zd:17681/zd:15647) (q:draft)
kemlo = (i:1) (t:v) (f:everyday/family) (w:not look after/not keep/neglect) (d:<kem> and <lo> written as one word: not look after, not keep; {hoihtak kemlo} is not take proper care of) (j:kem/lo) (r:zd:21815/zd:15848) (q:draft)
kempah = (i:1) (t:v) (f:everyday/politics) (w:take into keeping at once/seize at once/guard at once) (d:<kem> and <pah> written as one word: keep, guard or take charge of something immediately; of authorities, seize or hold on the spot) (j:kem/pah) (r:zd:21232/zd:16007) (q:draft)
kemphot = (i:1) (t:v) (f:politics/social) (w:keep for the time being/hold in custody/take into care) (d:<kem>, keep or look after, and <phot>, for the time being, written as one word: of police, authorities or carers, keep or hold a person for now) (j:kem/phot) (r:zd:20023/zd:11360) (q:draft)
kemsiam = (i:1) (t:v) (f:everyday/work) (w:look after well/manage well/take good care of) (d:<kem>, keep, and <siam>, skilled, written as one word: be good at looking after or managing what one has, such as money) (j:kem/siam) (r:zd:21753/zd:25919/zd:25115) (q:draft)
kemzo = (i:1) (t:v) (f:everyday/politics) (w:be able to keep/hold/keep control of) (d:<kem>, keep, with <zo>, manage to, written as one word: succeed in keeping, guarding or holding a thing, a place or oneself) (j:kem/zo) (r:zd:21262/zd:18896/zd:17722) (q:draft)
ken = (i:1) (t:pron) (f:everyday) (w:I) (s:kei)
ken bel = (i:1) (t:phrase) (f:everyday) (w:as for me/for my part/I myself) (d:<ken>, I as the one who acts, and <bel>, here a word that sets one thing against others and not the verb take refuge: opens a sentence in which the speaker gives a personal view or experience, as against what others say or do) (r:zd:21154/zd:26163/zd:23086) (q:draft)
kendang = (i:1) (t:n) (f:nature/travel) (w:ravine/precipice/cliff) (d:a steep drop beside a road or on a mountainside, down which a vehicle can fall; {kendang ah kiasuk} is fall down a ravine) (r:zd:19160/zd:17094/zd:19112) (q:draft)
keng = (i:1) (t:v) (f:everyday/travel) (w:take along/carry/bring) (d:have a thing with one on a journey, take or bring it along) (s:pua) (q:draft)
kengsiah = (i:1) (t:v) (f:politics) (w:obstruct/undermine/trip up) (d:work against someone so that his plan fails) (r:zd:25399) (q:draft, low confidence)
kenla = (i:1) (t:part) (f:everyday) (w:do not) (d:<kei> and <in> and <la> written as one word, placed after a verb: do not do this, but; a prohibition that is followed by a second command) (j:kei/in/la) (r:zd:23019/zd:19600/zd:16385) (q:draft)
kenteh = (i:1) (t:part) (f:everyday) (w:will not/would not) (d:placed at the end of a sentence after a verb: the negative <kei> with <teh>, a firm statement or guess that something will not happen or is not so) (r:zd:22683/zd:19626) (q:draft, low confidence)
Kentucky = (i:1) (t:name) (c:land) (f:travel) (w:Kentucky) (d:state of the United States where Zomi communities live) (r:zd:24648/zd:25452) (q:draft)
Kenya = (i:1) (t:name) (c:land) (f:travel/politics) (w:Kenya) (d:a country in East Africa, mostly as {Kenya gam}; its capital is Nairobi) (r:zd:20977/zd:14983) (q:draft)
kenzong = (i:1) (t:pron) (f:everyday) (w:I too/I also) (d:<ken>, I, and <zong>, also, written as one word) (j:ken/zong) (r:zd:17722/zd:23977) (q:draft)
kepbit = (i:1) (t:v) (f:everyday/work) (w:keep safe/safeguard/protect) (d:<kep> and <bit> written as one word: keep something so that it stays safe, said of money, a village, a people or a belief) (j:kep/bit) (r:zd:25158/zd:22597/zd:25919) (q:draft)
kepbitna = (i:1) (t:n) (f:social/politics) (w:protection/safekeeping) (d:<kep>, keep, with <bitna>, safety: the keeping of someone safe, as the protection given by God or by an office for refugees) (r:zd:21948/ts:11032/zd:22438) (q:draft)
kepcing = (i:1) (t:v) (f:social) (w:preserve/maintain/safeguard/keep up) (d:<kep>, keep, with <cing>, guard: look after something so that it lasts and is not lost, said of customs, language, writing and peace) (s:kemcing) (j:kep/cing) (r:zd:8667/zd:24217) (q:draft)
kepcingna = (i:1) (t:n) (f:social/politics) (w:protection/preservation/safekeeping) (d:<kep>, <cing> and <na> written as one word: the keeping and guarding of something, as rights, nature, a language or the mind; once also for being kept in detention) (j:kep/cing/na) (r:zd:20195/zd:23929/zd:9125) (q:draft)
kepcip = (i:1) (t:v) (f:everyday) (w:keep hold of/hold/detain) (d:<kep>, keep, and <cip>, firmly, written as one word: keep a thing and not let it go; of a town, hold it; of people, keep them in custody) (j:kep/cip) (r:zd:23554/ts:3855) (q:draft)
kepding = (i:1) (t:v) (f:everyday/health) (w:to keep/to care for/to look after) (d:<kep> and <ding> written as one word: to keep or care for, what should be kept; {bangci kepding} is how to care for) (j:kep/ding) (r:zd:15984/zd:16878) (q:draft)
keplaitak = (i:1) (t:v) (f:health/everyday) (w:be kept at present/be held now) (d:<kep>, keep or look after, and <laitak>, at this very time, written as one word after <aki>: is being kept or cared for at present, in a hospital or a police station) (j:kep/laitak) (r:zd:11980/zd:15729) (q:draft)
Kepong = (i:1) (t:name) (c:place) (f:travel) (w:Kepong) (d:district of Kuala Lumpur, Malaysia) (r:zd:13161) (q:draft)
kepsakding = (i:1) (t:v) (f:everyday) (w:will keep for/will look after for) (d:<kepsak> and <ding> written as one word: will keep or look after something for someone, is to be given into the keeping of someone) (j:kepsak/ding) (r:zd:13151/zd:11953) (q:draft)
kepsiam = (i:1) (t:v) (f:everyday) (w:keep well/take good care of/look after well) (d:<kep>, keep, with <siam>, skilled, written as one word: know how to keep and look after something, keep it well) (j:kep/siam) (r:zd:17081/zd:25919/zd:16150) (q:draft)
kepsiamna = (i:1) (t:n) (f:everyday/social) (w:good care/careful keeping/stewardship) (d:<kepsiam>, keep well, with the noun suffix {-na}: the skill or practice of keeping and looking after something well; {ki kepsiamna} is self-care) (b:kepsiam) (r:zd:15794/zd:23488) (q:draft)
keptheih = (i:1) (t:v) (f:everyday/home) (w:be able to look after/be able to keep) (d:<kep>, keep or look after, and <theih>, be able, written as one word) (j:kep/theih) (r:zd:25919/zd:20334) (q:draft)
kepzia = (i:1) (t:n) (f:everyday/family) (w:way of keeping/way of caring for/care) (d:<kep>, keep or look after, and <zia>, way, written as one word: how a person or thing is to be kept or cared for) (j:kep/zia) (r:zd:15107/zd:20525/zd:23488) (q:draft)
Kerinchi = (i:1) (t:name) (c:place) (f:travel) (w:Kerinchi) (d:area of Kuala Lumpur in Malaysia with a light rail station, found in addresses) (r:zd:23663) (q:draft, low confidence)
keu = (i:1) (t:v) (f:everyday/nature) (w:dry/dry up/wither) (d:be or become dry, said of water, land and plants; {lei keu} is dry land) (s:kang) (a:kawt)
keyboard = (i:1) (t:n) (f:media/it) (w:keyboard) (d:the electronic keyboard as a musical instrument, played with <tum>; also the keys of a computer or phone) (o:English) (r:zd:19779/zd:15505/zd:17565) (q:draft)
KFC = (i:1) (t:name) (f:food/work) (w:KFC) (d:Kentucky Fried Chicken, an American chain of fast food restaurants that sells fried chicken) (r:zd:14531/zd:24116) (q:draft)
kha = (i:3) (t:n) (f:time) (w:month) (d:a month of the year; {kha khat} is one month and {kha masa} the first month) (r:2.13.4)
kha = (i:5) (t:adj) (f:food/everyday) (w:bitter) (d:bitter in taste) (r:zai:bitter) (q:draft)
kha het = (i:1) (t:part) (f:everyday) (w:at all/by any chance) (d:<kha.4>, happen to, with <het>, at all: placed after a verb and before a negative such as <kei> or <lo>, not do it at all, not even by accident; with {kei in} a strong warning never to do it) (r:zd:22915/zd:25326/zd:25109) (q:draft)
kha ken = (i:1) (t:part) (f:everyday) (w:do not/take care not to) (d:<kha>, here happen to, and <ken>, do not: placed after a verb at the end of a sentence, a warning to one person, do not let yourself do it) (r:zd:21224/zd:8375) (q:draft)
kha khanlawhna = (i:1) (t:n) (f:religion) (w:spiritual revival/revival/awakening) (d:<kha>, here spirit and not month, and <khanlawhna>, revival: a revival of faith in a church or a people, the usual term for a revival movement) (r:zd:18200/zd:23022) (q:draft)
kha kipat = (i:1) (t:n) (f:time) (w:beginning of the month/start of the month) (d:<kha>, month, and <kipat>, begin: the first days of a month; it stands after the name of the month and is mostly followed by <lam>, as in {June kha kipat lam}, in early June) (r:zd:15861/zd:25322) (q:draft)
kha pahpah = (i:1) (t:part) (f:everyday) (w:tend to/easily happen to) (d:<kha.4>, happen to, with <pahpah>, at once, each time: placed after a verb, be quick to do it without meaning to, easily fall into doing or thinking it) (r:zd:20391/zd:25053) (q:draft, low confidence)
khaak = (i:1) (t:part) (f:everyday) (j:khak) (r:zd:25223/zd:19147) (q:draft, low confidence)
khaak = (i:2) (t:v) (f:social/everyday) (w:hold out/send) (d:hold out or send towards someone: {khut khaak} is hold out the hand, and {mangpha khaak} is bid farewell) (r:zd:20944) (q:draft, low confidence)
khaal = (i:1) (t:n) (f:time/nature) (w:dry season/summer/hot season) (d:the hot dry part of the year, named beside <tuuk>, the harvest season, and <phalbi>, the cold season; also {khua khaal}) (s:khuakhal) (r:zd:25678/ts:1813) (q:draft)
khaal = (i:2) (t:n) (f:body) (w:groin) (d:the fold of the body where the thigh joins the belly) (r:zd:15984) (q:draft, low confidence)
khaan = (i:1) (t:n) (f:home) (w:room) (d:a room of a house; {lupna khaan} is a bedroom. The same spelling also writes a different Burmese word, accept or bear, inside the loan phrases {thauh khaan}, endorse, and {tetti khaan}, bear witness) (s:inndei/dei) (o:Burmese, khan) (r:zd:24075/zd:19065) (q:draft)
khabei = (i:1) (t:n) (f:time) (w:end of the month/month end) (d:<kha>, month, and <bei>, come to an end, written as one word; it follows the name of the month, as {August khabei}, the end of August) (j:kha/bei) (r:zd:22109/zd:20912/zd:14983) (q:draft)
khabeikuan = (i:1) (t:n) (f:time) (w:end of the month/late in the month) (d:<kha>, month, with <beikuan>, be about to end, written as one word; it follows the name of the month, as {May khabeikuan}, towards the end of May) (j:kha/beikuan) (r:zd:19529/zd:20104) (q:draft)
khaci = (i:1) (t:n) (f:nature/work) (w:seed/crop) (j:khaici) (r:zd:20058/zd:20885) (q:draft, low confidence)
khaci = (i:2) (t:phrase) (f:everyday) (d:in the pair {huci khaci}: like this and like that, so and so, reporting loosely what people say) (r:zd:24088) (q:draft, low confidence)
khacinglo = (i:1) (t:adj) (f:health/family) (w:premature/preterm) (d:<kha>, month, and <cinglo>, incomplete, written as one word: before the months of pregnancy are complete; {khacinglo in suak} is be born prematurely) (j:kha/cinglo) (r:zd:12942/zd:12267) (q:draft)
khadiam = (i:1) (t:part) (f:everyday) (d:<kha>, happen to, and <diam>, the question word, written as one word after a verb: might it perhaps, I wonder whether it will) (j:kha/diam) (r:zd:13282/zd:17653) (q:draft)
khading = (i:1) (t:part) (f:everyday) (w:probably/likely) (d:<kha> and <ding> written as one word, after a verb or describing word and before <hi>: it is probably so, it will likely be so, as the guess of the speaker) (j:kha/ding) (r:zd:21012/zd:15939/zd:24946) (q:draft)
khadinghi = (i:1) (t:v) (f:everyday) (w:will probably/may well) (d:<khading>, probably, and <hi> written as one word at the end of a sentence: it will probably be so, it may well happen) (j:khading/hi) (r:zd:20498/zd:16121) (q:draft)
khadong = (i:1) (t:adv) (f:time) (w:until the month of/up to the month) (d:<kha>, month, and <dong>, until, written as one word after the name of a month: up to and including that month) (j:kha/dong) (r:zd:15939/zd:20167) (q:draft)
khah = (i:3) (t:v) (f:media/it) (w:post/publish/broadcast/send out) (d:put news, a notice, a video or a live programme out to the public, as on Facebook or Youtube; often with <khia>, out, or <sawn>, onward) (r:zd:24892/zd:14992/zd:19503) (q:draft)
khahiam = (i:1) (t:part) (f:everyday) (w:perhaps/by any chance) (d:<kha>, happen to, and the question word <hiam> written as one word at the end of a clause: did it perhaps happen, could it be that) (j:kha/hiam) (r:zd:17488/zd:14687) (q:draft)
khahkhia = (i:3) (t:v) (f:media) (w:release/publish/issue/post) (d:make a video, photo or statement public, on social media or to the press; the thing released stands before it, as {Statement khahkhia} and {Video ki khahkhia}, where the other senses let loose a living thing or free a prisoner) (r:zd:19472/zd:17884/zd:14778) (q:draft)
khahkhiading = (i:1) (t:v) (f:everyday/media) (w:will release/will issue/will set free) (d:<khahkhia>, release, and <ding>, will, written as one word: will let out, said of prisoners set free and of a statement or update made public) (j:khahkhia/ding) (r:zd:19275/zd:19234) (q:draft)
khahkhiakik = (i:1) (t:v) (f:politics/everyday) (w:release again/set free again/let go again) (d:<khahkhia> and <kik> written as one word: let someone who was held go free again) (j:khahkhia/kik) (r:zd:14808/zd:11803) (q:draft)
khahkhiapah = (i:1) (t:v) (f:media) (w:release at once/post immediately/issue at once) (d:<khahkhia> and <pah> written as one word: put out at once, said of a video or photo posted on social media and of a statement issued) (j:khahkhia/pah) (r:zd:19667/zd:16966) (q:draft)
khahkhiat = (i:2) (t:v) (f:media/it) (w:release/publish/post/issue) (d:put a video, a photo, a statement or other writing out for the public, above all on social media; form of <khahkhia> used before words such as <ciangin> and <ding>) (r:zd:12418/zd:17003/zd:14720) (q:draft)
khahkhiata = (i:1) (t:v) (f:media/everyday) (w:release/publish/put out) (d:<khahkhia>, release or put out, with the particle <ta>, now, written as one word and common in headlines: {ki khahkhiata} is has now been released, of a prisoner, a video or a statement) (j:khahkhia/ta) (r:zd:11715/zd:12754) (q:draft)
khahkhiatding = (i:1) (t:phrase) (f:media/politics) (w:to release/to be released/to publish) (d:<khahkhiat>, release, and <ding> written as one word: that is to be released, of a prisoner, or to be put out to the public, of a video, a statement or a gas) (j:khahkhiat/ding) (r:zd:15097/zd:19275) (q:draft)
khahkhiatpen = (i:1) (t:phrase) (f:media/it) (w:the releasing/the posting) (d:<khahkhiat>, release, and the topic marker <pen> written as one word: as for releasing or publishing something, or the thing that was released) (j:khahkhiat/pen) (r:zd:20643/zd:20363) (q:draft)
khaici = (i:2) (t:n) (f:health/body) (w:egg/sperm/reproductive cell) (d:the cell of a person from which a child begins: {numei' khaici} is the egg of a woman and {pasal' khaici} the sperm of a man) (r:zd:17563) (q:draft)
khaicii = (i:1) (t:n) (f:nature/work) (j:khaici) (r:zd:20959/zd:22090/zd:23896) (q:draft)
Khaikam = (i:1) (t:name) (c:city) (f:travel/politics) (w:Khaikam) (d:a town of the Zomi area near Kalaymyo in Myanmar, made a town in 2015; also found as a personal name) (r:ts:10679/zd:24049) (q:draft)
khailumsa = (i:1) (t:adj) (f:everyday/media) (w:hanged/dead by hanging) (d:<khailum>, hang to death, and <sa>, already, written as one word: already hanged, said of people found dead by hanging, mostly as {aki khailumsa in}) (j:khailum/sa) (r:zd:20278) (q:draft)
khaini = (i:1) (t:n) (f:health/food) (w:chewing tobacco/khaini) (d:tobacco mixed with lime that is held in the mouth, {khaini muam}; named among harmful habits with betel, cigarettes and drink) (o:Hindi) (r:ts:8872/zd:15424/zd:9453) (q:draft)
khak = (i:3) (t:v) (f:everyday/home) (w:shut/close) (r:zai:shut) (q:draft)
khak = (i:4) (t:v) (f:everyday/it) (w:send/remit) (d:send a letter, a message, money or goods to someone, with the thing sent as object; {hong khak} is send to me or to us; not the particle after a verb and not shut) (r:zd:19210/zd:23204/zd:23400) (q:draft)
khak zenzen = (i:1) (t:phrase) (f:everyday) (w:happen to/by any chance) (d:<khak>, here the form of <kha>, happen to or do by accident, and <zenzen>, by chance: placed after a verb and followed by <leh>, if one should happen to, in case something unwished comes about; this is not the verb shut) (r:zd:18159/zd:25616) (q:draft)
khakcipding = (i:1) (t:v) (f:everyday) (w:will be closed/to close/to shut down) (d:<khakcip>, shut completely, and the future marker <ding> written as one word: to close or shut down, will be closed) (j:khakcip/ding) (r:zd:11759/zd:19932/zd:14885) (q:draft)
khakcipna = (i:1) (t:n) (f:politics/travel) (w:restriction/ban/closure/blockade) (d:<khakcip>, shut tightly, with the noun suffix <na>: the shutting or barring of something, as a ban on entry, a restriction or the closing of a road or prison) (b:khakcip) (r:zd:11835/zd:12389/zd:20394) (q:draft)
khakcippah = (i:1) (t:v) (f:travel/everyday) (w:close at once/shut down immediately) (d:<khakcip> and <pah> written as one word: close or block completely right away; with <ki>, be closed at once, said of roads, lines and bridges) (j:khakcip/pah) (r:zd:11685/zd:14827/zd:12051) (q:draft)
khakcipphot = (i:1) (t:v) (f:everyday/travel) (w:close for the time being/shut temporarily) (d:<khakcip>, shut up, and <phot>, for the time being, written as one word: a road, school or shop is closed for now, usually as {ki khakcipphot}) (j:khakcip/phot) (r:zd:14829/zd:14914) (q:draft)
khakcipsak = (i:2) (t:v) (f:politics/travel) (w:close/shut down/close off) (d:of the police or another authority, or of an accident: have a road, school, shop or office closed so that nobody can use it, often passive with <ki>; not said of the womb) (r:zd:13129/zd:15307/zd:17632) (q:draft)
khakcipsuak = (i:1) (t:v) (f:work/politics) (w:close down for good/shut permanently) (d:<khakcip>, shut up, with <suak>, right through, written as one word: close a shop or office for good; usually with the prefix <ki>, be closed down) (j:khakcip/suak) (r:zd:20008/zd:22416) (q:draft)
khakding = (i:1) (t:part) (f:everyday) (d:<khak>, happen to, and <ding>, will, written as one word after a verb: that something might happen, lest; mostly before a word of fear or caution) (j:khak/ding) (r:zd:12950/zd:14768) (q:draft)
khakei = (i:1) (t:adv) (f:everyday) (w:not at all/by no means) (d:<kha>, happen to, and the negative <kei>, written as one word after a verb: in a command, be sure not to do it even by chance; in a statement, not at all) (j:kha/kei) (r:zd:12742/zd:19550/zd:12403) (q:draft)
khakha = (i:1) (t:adv) (f:time/work) (w:each month/per month/monthly) (d:<kha>, month, said twice and written as one word: in each month, month by month; mostly as {khakha in} and {khakha sungin}) (b:kha) (r:zd:19215/zd:15659) (q:draft, low confidence)
khakhat = (i:1) (t:n) (f:time) (w:one month/a month) (d:<kha> and <khat> written as one word: one month, and in stating pay or a fee, per month) (j:kha/khat) (r:zd:17363/zd:17437/zd:24043) (q:draft)
khakhatsung = (i:1) (t:adv) (f:time) (w:within one month/in a month) (d:<kha>, month, <khat>, one, and <sung>, during, written as one word: in the space of one month) (j:kha/khat/sung) (r:zd:11707/zd:11193) (q:draft)
khakhatzong = (i:1) (t:phrase) (f:time) (w:even one month/even a month) (d:<khakhat>, one month, and <zong>, even, written as one word; with <cingnailo>, not yet complete, or another negative: in less than a month) (j:khakhat/zong) (r:zd:12589/zd:16145) (q:draft)
khakkha = (i:1) (t:v) (f:it/social) (w:send by mistake/happen to send) (d:<khak>, here send, with <kha>, happen to, written as one word: happen to send something, such as a photo, to someone) (j:khak/kha) (r:zd:11938) (q:draft, low confidence)
khakkhak = (i:1) (t:v) (f:everyday/it) (w:keep sending/send again and again) (d:<khak>, here the verb send, said twice: keep sending letters or messages to someone) (b:khak) (r:zd:14728/zd:12021) (q:draft, low confidence)
khakkhia = (i:1) (t:v) (f:everyday/it) (w:send out/send/issue) (d:<khak>, send, with <khia>, out: send a message, money or goods out to someone; {ki khakkhia} is be sent out or issued) (r:zd:14772/zd:19529) (q:draft)
khakkik = (i:1) (t:v) (f:everyday/work) (w:send back/send in return/reply) (d:<khak>, here in the sense of send, with <kik>, back, written as one word: send something back or send it in reply, said of money, messages, parcels and letters) (j:khak/kik) (r:zd:21540/zd:9257) (q:draft)
khakkik = (i:2) (t:v) (f:home/everyday) (w:close again/shut again) (d:<khak>, shut, and <kik>, again, written as one word: shut a door once more) (j:khak/kik) (r:zd:14917) (q:draft, low confidence)
khakleh = (i:1) (t:conj) (f:everyday) (w:if it happens that/in case) (d:<khak>, happen to, and <leh>, if, written as one word, placed after a verb: if one should happen to do it) (j:khak/leh) (r:zd:21044/zd:15848/zd:20736) (q:draft)
khakloh = (i:1) (t:part) (f:everyday) (w:not happen to/fail to) (d:<khak>, happen to, and <loh>, not, written as one word and placed after a verb: not happen to do, fail to do; with <ding> it says that one should take care not to do something) (j:khak/loh) (r:zd:25322/zd:19846/zd:17224) (q:draft)
khaklohding = (i:1) (t:part) (f:everyday) (d:<khak>, happen to, with <lohding>, not to, written as one word after a verb: so as not to happen to do it, must take care not to; {khaklohding thupi hi} is it is important not to) (j:khak/lohding) (r:zd:18893/zd:17841) (q:draft)
khaknate = (i:1) (t:n) (f:everyday) (d:<khakna> with the plural <te>, after a verb: the things one happened to do or the times it happened; {khialh khaknate} is the mistakes one happened to make) (b:khakna) (r:ts:9856/zd:25562) (q:draft)
khaknuamte = (i:1) (t:n) (f:work) (w:those who want to send) (d:<khak>, send, and <nuamte>, those who want, written as one word: those who wish to send something, as money by check) (j:khak/nuamte) (r:zd:16813) (q:draft)
khakpen = (i:1) (t:phrase) (f:everyday) (d:<khak> written together with the topic marker <pen>; mostly <khak.2>, happen to, after a verb, so that {athuak khakpen} is the one who happened to suffer it; also with <khak.3>, shut, as in {aki khakpen}, its being closed, and in the sense send, of a message) (j:khak/pen) (r:zd:24024/zd:17727) (q:draft)
khaksawh = (i:1) (t:n) (f:health/body) (w:phlegm/sputum/mucus) (d:the thick matter coughed up from the throat and lungs) (r:zd:23832/zd:24276/zd:21557) (q:draft)
khaksawn = (i:1) (t:v) (f:media/it) (w:forward/pass on/send on) (d:send on to another person something one has received, as a message, a photo or a video; the second part is <sawn>, onward) (r:zd:14883/zd:15443) (q:draft)
khaksuah = (i:1) (t:n) (f:health/body) (w:phlegm/sputum) (d:thick matter coughed up from the chest; {khaksuah etna} is a sputum test) (r:zd:21633) (q:draft, low confidence)
khaktanna = (i:1) (t:n) (f:social/politics) (w:restriction/obstruction/barrier/hindrance) (d:<khaktan>, hinder, with the noun suffix <na>: what blocks or holds back, a restriction or ban set by an authority) (b:khaktan) (r:zd:23011/zd:20801/zd:24376) (q:draft)
khaktansak = (i:1) (t:v) (f:everyday) (w:block/hinder/prevent) (d:<khaktan>, block, with <sak>, cause: put a stop to something, keep it from happening, close a way) (j:khaktan/sak) (r:zd:18958/zd:20841) (q:draft)
khakun = (i:1) (t:v) (f:body/everyday) (w:hang one's head/be downcast/be dejected) (d:sit or go with the head bowed in sadness, worry or defeat; {lunggim khakun in om} is to stay brooding and dejected) (r:zd:11831/zd:18204/zd:21664) (q:draft)
khal = (i:3) (t:n) (f:time/nature) (w:dry season/hot season/summer) (d:the hot dry season of the year, set beside <tuk>, the rainy season, and <phalbi>, the cold season; {khal hun} and {khal sung} are the time of the dry season) (r:zd:25863/zd:23797/zd:17586) (q:draft)
khal = (i:4) (t:v) (f:nature/time) (w:turn dry/become dry) (d:of the weather, after <khua>: turn to the hot dry season, when water grows scarce and leaves wither, as in {khua hong khal}) (r:zd:18179/zd:26097) (q:draft)
khalai = (i:1) (t:part) (f:everyday) (d:<kha>, happen to, and <lai>, still, written as one word after a verb and before <ding>: may still, may yet happen to) (j:kha/lai) (r:zd:20534/zd:11927) (q:draft, low confidence)
khalai = (i:2) (t:n) (f:time) (w:middle of the month/mid-month) (d:<kha>, month, and <lai>, middle, written as one word after the name of a month: {July khalai} is the middle of July) (j:kha/lai) (r:zd:20518) (q:draft, low confidence)
khalau = (i:1) (t:v) (f:everyday) (w:be anxious/be apprehensive/be wary) (d:be uneasy and on guard about what may happen; {ki khalau} is be anxious about something) (r:zd:23466/zd:15996) (q:draft, low confidence)
khaleng = (i:1) (t:conj) (f:everyday) (w:if one happens to/should one) (d:<kha>, happen to, and <leng>, if, written as one word after a verb: if one happens to do it, if it should happen) (j:kha/leng) (r:zd:23784/zd:15984) (q:draft)
khalhna = (i:1) (t:n) (f:religion/social) (w:discipline/correction) (d:noun from {khalh}, a form of <khal>, discipline: the disciplining of a person, as by a church; {khalhna hun} is the period of discipline; compare <khalna>) (b:khal) (r:ts:5498/zd:24238) (q:draft, low confidence)
khalian = (i:1) (t:adv) (f:everyday/media) (w:right on/squarely) (d:placed after a verb of hitting, cutting or catching: the action happens to strike its object fully, as in {kiphu khalian}, collide head-on, and {dengsia khalian}, crush outright) (r:zd:11368/zd:12304) (q:draft, low confidence)
khaliang = (i:1) (t:part) (f:everyday) (w:even/actually) (d:<kha> and <liang> written as one word after a verb: the action happens to go as far as that, one even ends up doing it) (j:kha/liang) (r:zd:25342/zd:11167) (q:draft, low confidence)
Khalkha = (i:1) (t:name) (c:city) (f:travel/politics) (w:Hakha) (d:Zolai name of Hakha, the capital of Chin State in Myanmar; also the Hakha people and their area) (r:zd:17339/zd:17345) (q:draft)
Khalkhate = (i:1) (t:name) (c:people) (f:social/politics) (w:Hakha people/the Hakha) (d:the people of <Khalkha>, Hakha, and its area in Chin State, with the plural ending <te>) (b:Khalkha) (r:zd:21095/zd:21862) (q:draft)
khalo = (i:1) (t:part) (f:everyday) (d:the verb particle <kha> with <lo> written as one word after a verb: not happen to, not get to, never, as in {phawk khalo}, not notice) (j:kha/lo) (r:zd:25046/zd:25208) (q:draft)
khaloding = (i:1) (t:part) (f:everyday) (d:<khalo> and <ding> written as one word after a verb: will not happen to, will not get to, probably not; {kihel khaloding} is will not be among them) (j:khalo/ding) (r:zd:11992/zd:12641) (q:draft)
khaloin = (i:1) (t:part) (f:everyday) (d:<khalo> and <in> written as one word after a verb: without getting to, without ever doing) (j:khalo/in) (r:zd:22652) (q:draft, low confidence)
khalote = (i:1) (t:phrase) (f:everyday) (w:those who did not get to/those who never) (d:<khalo>, not get to, and the plural <te> written as one word after a verb: the people who did not get to do it or to whom it did not happen, as in {angah khalote}, those who did not receive it) (j:khalo/te) (r:zd:15377/zd:24948) (q:draft)
khamah = (i:1) (t:adv) (f:everyday) (w:probably/may well) (d:<kha>, happen to, with the emphatic <mah>, written as one word after a verb and before <ding>: it may well be so, it will probably happen) (j:kha/mah) (r:zd:17655/zd:24036/zd:23138) (q:draft)
khamai = (i:1) (t:part) (f:everyday) (d:after a verb, <kha>, happen to, with <mai> used as a particle, just, written as one word and mostly followed by <ding> or <thei>: may well, will probably) (j:kha/mai) (r:zd:15416/zd:23301) (q:draft, low confidence)
khamangthang = (i:1) (t:n) (f:religion) (w:lost soul/the lost/the unsaved) (d:<kha>, spirit or soul, and <mangthang>, be lost, written as one word: a lost soul, a person who is not saved, as the object of evangelism) (j:kha/mangthang) (r:zd:22544/zd:25891/zd:26310) (q:draft)
khamawk = (i:1) (t:part) (f:everyday) (d:<kha> and <mawk> written as one word after a verb: happen to do, do by accident or without meaning to, often with regret, as in {kikhial khamawk}, got it wrong by mistake) (j:kha/mawk) (r:zd:12337/zd:25572/zd:19917) (q:draft)
khamcipding = (i:1) (t:v) (f:politics) (w:will ban/to forbid) (d:<khamcip>, forbid strictly, and <ding>, the marker of what is to come, written as one word: will forbid, to ban; with <ki> before it, will be banned) (j:khamcip/ding) (r:zd:15822/zd:16236) (q:draft)
khamcipna = (i:1) (t:n) (f:politics) (w:ban/prohibition) (d:<khamcip>, forbid strictly, with the noun ending {-na}: a ban, a firm prohibition) (s:khamna) (b:khamcip) (r:zd:11874/zd:12016) (q:draft)
khamh = (i:1) (t:n) (f:work/everyday) (j:kham) (r:zd:24957/zd:21586) (q:draft)
khamh = (i:2) (t:n) (f:nature/politics) (w:hills/highlands/hill country) (d:the hill country of Myanmar and its peoples, set against the plains, {zang gam}) (s:khamtung) (r:zd:25330/zd:24733) (q:draft, low confidence)
khami = (i:1) (t:n) (f:religion) (w:spiritual person/spiritual) (d:<kha> spirit with <mi> person: a person who lives by the Spirit; also describes someone as spiritual, as in {khami mahmah}, very spiritual, and {khami hihna}, spirituality) (r:zd:23539/zd:26643/zd:20930) (q:draft)
khamit = (i:1) (t:n) (f:religion/everyday) (w:mind's eye/spiritual eye/imagination/inner sight) (d:<kha>, spirit, with <mit>, eye: the eye of the mind or spirit, with which one sees what is not before the eyes; {khamit kihong} is the inner eye is opened) (r:zd:20888/zd:21085/zd:23780) (q:draft)
khamitna = (i:1) (t:n) (f:religion) (w:spirituality/spiritual life) (d:the spiritual side of life and of worship; a writer glosses it as spirituality) (r:zd:24178) (q:draft)
khamlo = (i:1) (t:adj) (f:everyday/health) (w:not enough/insufficient/short of) (d:<kham>, have enough, with <lo>, not, written as one word: not getting enough of something, as in {ihmut khamlo}, not enough sleep, and {huih khamlo}, short of breath; {zu khamlo} is not drunk) (j:kham/lo) (r:zd:14790/zd:20486/zd:11342) (q:draft)
Khampat = (i:1) (t:name) (c:khua) (f:travel) (w:Khampat) (d:a town in the Kabaw valley near Tamu in Sagaing Region, Myanmar, told of as an early settlement of the Zomi) (r:ts:3817/ts:3375) (q:draft)
khamthei = (i:1) (t:adv) (f:everyday) (w:might/possibly) (d:placed after a verb: the action could happen, there is a risk or chance of it; {apuak khamthei} is something that might explode) (r:zd:12040/zd:20999) (q:draft, low confidence)
khamtheih = (i:2) (t:n) (f:health/social) (w:intoxicant/drug/narcotic) (d:used as a noun: a substance that makes drunk or high, mostly in the pair <guihtheih khamtheih>, drugs and intoxicants) (s:guihtheih) (r:zd:25932/zd:12334/zd:20064) (q:draft)
khamtheih guihtheih = (i:1) (t:n) (f:health/social) (w:drugs and alcohol/intoxicants/narcotics) (d:the pair of <khamtheih> and <guihtheih>, both what can make drunk: drugs, alcohol and other intoxicants as one thing; with <zang>, use, it is take drugs) (r:zd:14767/zd:25464) (q:draft)
khamtheih vankham = (i:1) (t:n) (f:health/politics) (w:narcotics/intoxicating drugs/illegal drugs) (d:<khamtheih>, intoxicating, and <vankham>, forbidden goods: drugs that intoxicate and are forbidden by law; in news usually in the fuller formula {guihtheih khamtheih vankham}, addictive and intoxicating drugs) (r:zd:16869/zd:14620) (q:draft)
Khamtunggam = (i:1) (t:name) (c:land) (f:politics/travel) (w:Chin Hills) (d:<khamtung>, hill country, with <gam>, land: the Chin Hills, the highland home of the Zomi in Myanmar, today Chin State) (r:zd:19159/zd:16035/ts:301) (q:draft)
Khamtungmi = (i:1) (t:name) (c:people) (f:social/politics) (w:hill people/highlanders) (d:<khamtung>, the hills, with <mi>, people: the peoples of the hills of Myanmar, used as a common name for the Chin and Zomi) (j:khamtung/mi) (r:zd:19159/zd:22646) (q:draft)
khamuan = (i:1) (t:n) (f:social/religion) (w:comfort/reassurance/peace of mind) (d:being at ease and without worry, or what gives that ease; {khamuan huai} is reassuring, comforting) (r:zd:24462/zd:25333/zd:14844) (q:draft)
khamuang = (i:1) (t:v) (f:everyday/social) (w:be heartened/feel secure/be at ease/be encouraged) (d:<kha>, spirit, with <muang>, trust: be in good heart, feel secure and content; {khamuang sak} is hearten, give confidence to) (r:zd:24235/zd:22140) (q:draft, low confidence)
khamuanna = (i:1) (t:n) (f:religion/social) (w:comfort/consolation/peace of mind) (d:<kha>, spirit, with <muanna>, trust: inner peace, comfort of the spirit) (r:ts:301/zd:20772/zd:24176) (q:draft)
khamzolo = (i:1) (t:v) (f:everyday/family) (w:be unable to restrain/cannot forbid) (d:<khamzo> and <lo> written as one word: not be able to hold someone back from what he wants to do) (j:khamzo/lo) (r:zd:11508/zd:12512) (q:draft)
khamzolo = (i:2) (t:v) (f:food/health) (w:not have enough/not get one's fill) (d:<khamzo> and <lo> written as one word: not be able to get enough of food, drink or air) (j:khamzo/lo) (r:zd:24167/zd:25180) (q:draft)
khang = (i:3) (t:n) (f:family/time/social) (w:generation/age) (d:the people born and living in the same period, one step in a family line, or that period itself; counted as {khang khat}, one generation, and {khang nihna}, the second generation, and seen in <khangthak>, the new generation) (r:zd:24279/zd:26566/zd:22341) (q:draft)
khangcinna = (i:1) (t:n) (f:religion/social) (w:maturity/growing up/full growth) (d:growing up to maturity, used mostly of spiritual growth; from <khang>, grow, and a second part meaning full or complete, with the noun suffix {-na}) (s:picinna) (r:zd:15700/zd:17444) (q:draft)
khangel = (i:1) (t:adv) (f:everyday) (w:surely/no doubt) (d:<kha>, happen to, and <ngel>, certainly, written as one word after a verb; {khangel ding hi} is will surely, will no doubt) (j:kha/ngel) (r:zd:26620/zd:14730) (q:draft, low confidence)
khanggawp = (i:1) (t:v) (f:nature) (w:flood/rise greatly/surge) (d:<khang> and <gawp> written as one word: rise or increase very much; {tui khanggawp} is the water rises high, there is a flood) (j:khang/gawp) (r:zd:14842/zd:14850/zd:15002) (q:draft)
khanggui = (i:1) (t:n) (f:family/social) (w:lineage/genealogy/line of descent/ancestry) (d:the line of generations of a family or of mankind, from <khang>, generation, and <gui>, line; {khanggui kizom} is a continuing line of descent) (r:zd:26026/zd:23896/zd:16641) (q:draft)
khanghun = (i:1) (t:n) (f:time/social) (w:age/era/times/history) (d:<khang>, generation, with <hun>, time: an age or era of the world; {tu khanghun} is the present age, and writers also use it for history) (r:zd:11135/zd:24305) (q:draft)
khangkhat = (i:1) (t:n) (f:time/family) (w:lifetime/one generation) (d:<khang>, a generation or age, with <khat>, one: one generation, a whole lifetime; {khangkhat sungin} is in a lifetime) (r:zd:21616/zd:21608) (q:draft)
khangkhiate = (i:1) (t:n) (f:family/social) (w:those who grew up) (d:<khangkhia>, grow up, with the plural <te>: the people who grew up in a place, a home or a way of life) (b:khangkhia) (r:zd:22709/zd:25147) (q:draft)
khanglian = (i:1) (t:v) (f:family/everyday) (w:grow up/grow big) (d:<khang> and <lian> written as one word: grow up from childhood, grow big) (j:khang/lian) (r:zd:24393/zd:15845/zd:25711) (q:draft)
khanglo = (i:1) (t:v) (f:everyday/body) (w:awake/wake up) (d:wake from sleep; {khanglo in} is the call to wake up) (s:khanlawh) (a:ihmu)
khanglui = (i:4) (t:n) (f:social) (w:the ancients/forebears/people of old) (d:the people of former generations themselves, not their time: with <te> and <in> as the subject of a verb of saying or doing, as in {khanglui te in ci hi}, the forebears said) (r:zd:16790/zd:25569) (q:draft)
khangno = (i:1) (t:adj) (f:everyday/family) (w:young/youthful) (d:young in age; {a khangno lai} is while still young, and {khangno mite} are young people, the opposite of {khangham mite}) (s:moi/khangmoi) (a:khangham/teek) (r:18.33.25) (q:draft)
khangno = (i:2) (t:n) (f:social/time) (w:youth) (d:the time of being young, as in {khangno lai}) (s:khangnona/khangnolai) (q:draft)
khangno kipawlna = (i:1) (t:n) (f:social) (w:youth organization/youth association/youth fellowship) (d:<khangno>, young, and <kipawlna>, association: an organization of young people, such as the youth association of a people or the youth fellowship of a church) (r:zd:22059) (q:draft)
khangnopa = (i:1) (t:n) (f:social/family) (w:young man/youth) (d:<khangno>, young, and <pa>, man, written as one word: the young man) (j:khangno/pa) (r:zd:12281/zd:12928) (q:draft)
khangsawn = (i:1) (t:n) (f:family/social) (w:posterity/coming generations/descendants) (d:the generations that come after, mostly in songs and solemn speech; paired with <tusawn> as {tusawn khangsawn}) (r:zd:24393/zd:25256/zd:15874) (q:draft)
khangsemsem = (i:1) (t:v) (f:everyday/work) (w:keep increasing/grow more and more) (d:<khang>, increase, and <semsem>, more and more, written as one word: go on growing or rising, of a number, a feeling, knowledge or water) (j:khang/semsem) (r:zd:23697/zd:12283/zd:20725) (q:draft)
khangtangthu = (i:1) (t:n) (f:education/social) (w:history) (d:<khang> in the sense generation or age, with <tangthu>, story, written as one word: the record of what happened in past times; with a capital, {Khangtangthu}, the Bible book of Chronicles) (j:khang/tangthu) (r:zd:16254/zd:19379/zd:22658) (q:draft)
khangthak = (i:2) (t:adj) (f:time) (w:modern/of the new generation) (d:belonging to the present age or to the young generation, said of a time, a person or a thing; {khangthak hun} is modern times, against <khanglui>, of the old days) (r:zd:21201/zd:22023/zd:15681) (q:draft)
khangthu = (i:1) (t:n) (f:social/education) (w:history/genealogy/family history) (d:the account of the generations: the line of a family or the history of a people or country) (r:ts:3375/zd:21916) (q:draft)
khangto = (i:2) (t:v) (f:social/politics) (w:develop/progress/advance/be developed) (d:of a country, a town, a people or a person: make progress in education, wealth and way of life, not grow in size or number; {gam khangto} is a developed country) (r:zd:17339/zd:18952/ts:3164) (q:draft)
khangtoh = (i:1) (t:v) (f:social/politics) (j:khangto) (r:zd:15543/zd:15661/zd:9430) (q:draft)
khangtohna = (i:1) (t:n) (f:social/politics) (j:khantohna) (r:zd:20786/zd:12033/zd:18086) (q:draft)
khangtolo = (i:1) (t:adj) (f:social/politics) (w:undeveloped/backward) (d:<khangto>, grow or develop, with <lo>, not, written as one word: not developed, of a people or country) (j:khangto/lo) (r:zd:22474/zd:11758) (q:draft)
khangtosa = (i:1) (t:adj) (f:politics/social) (w:developed/advanced) (d:<khangto> with an ending meaning already: that has developed; {a khangtosa gamte} are the developed countries) (b:khangto) (r:zd:21974/zd:23554) (q:draft)
khangtote = (i:1) (t:n) (f:social/politics) (w:developed ones/advanced ones) (d:<khangto>, grow or develop, with the plural <te>: those that are developed; {gam khangtote} is the developed countries and {mi khangtote} is advanced or civilised people) (b:khangto) (r:ts:7051/zd:16385/zd:20930) (q:draft)
khangtoto = (i:1) (t:v) (f:everyday) (w:keep growing/keep rising/increase more and more) (d:<khang>, grow, and <toto>, more and more, written as one word: go on growing, rising or advancing) (b:khangto) (j:khang/toto) (r:zd:25221/zd:11527/zd:15007) (q:draft)
khangtozaw = (i:1) (t:v) (f:everyday/work) (w:grow more/increase more/be more developed) (d:<khangto>, grow or rise, and <zaw>, more, written as one word: rise by an amount, or be more developed than another) (j:khangto/zaw) (r:zd:17349/zd:17339) (q:draft)
khangual = (i:1) (t:n) (f:social) (w:peer/contemporary/age-mate) (d:people of the same age or generation as oneself) (r:zd:13340/zd:20572/zd:21340) (q:draft)
khankhat = (i:1) (t:n) (f:time) (w:a lifetime/one lifetime/whole life) (d:<khan>, lifetime, and <khat>, one, written as one word: one lifetime, once in a life) (j:khan/khat) (r:zd:26566/zd:19320) (q:draft)
khankhiatna = (i:1) (t:n) (f:family/social) (w:upbringing/growing up) (d:<khan>, grow, with <khiat>, out, and the noun suffix <na>: the growing up of a person, and the place or home where one grew up, as in {ka khankhiatna khua}, the village where I grew up) (r:zd:22990/zd:23394/zd:15459) (q:draft)
khanlawhna = (i:1) (t:n) (f:religion/social) (w:revival/awakening) (d:<khanlawh>, wake up, with the noun ending <na>: an awakening, above all a spiritual revival in the church, also the awakening of a people) (b:khanlawh) (r:zd:14765/zd:23792/zd:19066) (q:draft)
khanna = (i:2) (t:n) (f:everyday/nature) (w:growth/increase/rise) (d:<khang>, increase, with the noun suffix <na>: the growing or increasing of something, as a church, knowledge or a price; of a river or of water, its rising) (r:zd:9447/zd:25106/ts:2118) (q:draft)
khanpih = (i:1) (t:v) (f:social) (w:help to grow/raise up/bring forward) (d:<khan>, grow, with <pih>, together with: grow along with someone and so make them grow or progress; {hong khanpih ding makai} is a leader who will lift us up, set against {hong kiatpih}, bring us down) (r:zd:21761/zd:14565) (q:draft)
khanpih = (i:2) (t:n) (f:social) (w:contemporary/peer) (d:one who grew up at the same time as another, a person of the same age group) (r:zd:24672) (q:draft, low confidence)
khansakding = (i:1) (t:v) (f:everyday/work) (w:to increase/to raise) (d:<khansak>, make grow, and the future marker <ding> written as one word: will raise or is to raise an amount, a fee or a level) (j:khansak/ding) (r:zd:16381/zd:11117) (q:draft)
khansungah = (i:1) (t:adv) (f:home) (w:in the room) (d:the word for room, as in <innkhan>, with <sungah>, written as one word: inside the room; {lupna khansungah} is in the bedroom) (j:khan/sungah) (r:zd:20725/zd:21012) (q:draft)
khantawn = (i:1) (t:adv) (f:time) (w:lifelong/for life/all one's life) (d:<khan>, lifetime, with <tawn>, go along: through the whole of life, for good; {khantawn thongkia} is imprisoned for life) (r:zd:22557/zd:22584) (q:draft)
khanto = (i:1) (t:v) (f:everyday/social) (j:khangto) (r:zd:25891/zd:16381/zd:14887) (q:draft)
khantoding = (i:1) (t:v) (f:everyday/work) (w:will increase/will rise/will grow) (d:<khanto>, a spelling of <khangto>, grow or rise, with <ding>, will, written as one word: will go up, said of pay, a number or a limit) (j:khanto/ding) (r:zd:18079/zd:16095) (q:draft)
khantohding = (i:1) (t:v) (f:social/everyday) (w:to progress/will progress) (d:<khantoh>, progress, and <ding> written as one word: to progress, the progressing that is still to come) (j:khantoh/ding) (r:zd:21605/zd:24955) (q:draft)
khantohnang = (i:1) (t:n) (f:politics/social) (w:development/for development) (d:<khantoh>, progress, with {-nang}, a short form of <nading>: for development, the cause of development; used like <khantohna>) (b:khantoh) (r:zd:22783/zd:14867) (q:draft, low confidence)
khantohnate = (i:1) (t:n) (f:social/politics) (w:developments/progress) (d:plural of <khantohna>: the ways in which a place or people has advanced) (b:khantohna) (r:zd:22157/zd:17958) (q:draft)
khantohzia = (i:1) (t:n) (f:social/politics) (w:development/progress/state of development) (d:<khantoh>, progress, with <zia>, manner: the way and the degree in which a country, a town or a people develops) (s:khantohna) (b:khantoh) (r:zd:15781/zd:9447/zd:22171) (q:draft)
khasiangtho = (i:1) (t:n) (f:religion) (w:Holy Spirit) (d:<kha>, spirit, and <siangtho>, holy, written as one word and usually with a capital: the Holy Spirit) (j:kha/siangtho) (r:zd:22159/zd:23492/zd:19397) (q:draft)
khasiasak = (i:1) (t:v) (f:social/family) (w:sadden/grieve/hurt the feelings of/dishearten) (d:<khasia>, be saddened, and <sak.1>, cause, written as one word: make someone sad, hurt their feelings) (b:khasia) (j:khasia/sak) (r:zd:24320/zd:25768/zd:21701) (q:draft)
khasiat = (i:2) (t:v) (f:everyday/social) (w:be sad/be grieved/be upset) (d:feel sorrow or hurt at what has happened, not pity for a person; {khasiat huai} is sad or saddening, said of news or of a state of things, and {khasiat sak} is to sadden or hurt someone) (s:khasia) (r:zd:11375/zd:23821/zd:14760) (q:draft)
khasiatna = (i:1) (t:n) (f:everyday/social) (w:sorrow/sadness/grief/disappointment) (d:<khasia>, be troubled or saddened, with the noun suffix {-na}: sadness, hurt feelings or discouragement) (b:khasia) (r:zd:19915/zd:17961/zd:21037) (q:draft)
khasiatnate = (i:1) (t:n) (f:everyday/social) (w:sorrows/griefs/hurts) (d:<khasiatna> with the plural {-te}: the things that sadden or hurt someone) (b:khasiatna) (r:zd:17333/zd:25025) (q:draft)
khasung = (i:1) (t:phrase) (f:time) (w:in the month/during the month) (d:<kha>, month, and <sung>, in, written as one word, placed after the name of a month and often followed by <in>: {April khasung in} is in the month of April) (j:kha/sung) (r:zd:12567/zd:17607/zd:11454) (q:draft)
khasungin = (i:1) (t:adv) (f:time) (w:in the month of/during the month) (d:<kha> and <sungin> written as one word: placed after the name of a month, in or during that month) (j:kha/sungin) (r:zd:23083/zd:20498) (q:draft)
khat pepeuh = (i:1) (t:det) (f:everyday) (w:any/any one/whichever) (d:<khat>, one, and <pepeuh>, a spoken form of <peuhpeuh>: placed after a noun, any one of that kind, whichever it may be) (s:khatpeuhpeuh) (r:zd:17208/zd:25392) (q:draft)
khatahzong = (i:1) (t:adv) (f:everyday/media) (w:also at one/at another too) (d:<khatah>, at one, and <zong>, also, written as one word after a noun: at one such place too, in another one as well) (j:khatah/zong) (r:zd:12457/zd:12311/zd:19786) (q:draft)
khatam = (i:1) (t:part) (f:everyday) (w:perhaps/maybe/I wonder) (d:placed at the end of a clause, usually before <ci>, say or think: it may be so, I wonder whether; a guess of which the speaker is not sure) (r:zd:22116/zd:21325/zd:24749) (q:draft)
khatampi = (i:1) (t:phrase) (f:time) (w:many months/for months) (d:<kha>, month, and <tampi>, many, written as one word: many months, for a long time counted in months) (j:kha/tampi) (r:zd:15792/zd:12389) (q:draft)
khatawn = (i:1) (t:adv) (f:time) (w:all month long/month after month) (d:through the whole month, used in a pair after <kumtawn>, all year, or {nitawn}, all day, for a thing that goes on without end) (r:zd:21745/zd:21037) (q:draft)
khatbang = (i:1) (t:num) (f:everyday) (w:about one/one or so) (d:<khat> and <bang> written as one word: about one of a measure, as {meter khatbang}, about one metre; after a noun for a person, a certain one, someone like) (j:khat/bang) (r:zd:11889/zd:15008) (q:draft)
khatbangin = (i:1) (t:adv) (f:everyday) (w:like a/as a) (d:<khat>, one, and <bangin>, like, written as one word after a noun: like a, as one) (j:khat/bangin) (r:zd:21350/zd:19131/zd:15803) (q:draft)
khatbek = (i:1) (t:phrase) (f:everyday) (w:only one/just one/a single) (d:<khat> and <bek> written as one word: only one, one alone) (j:khat/bek) (r:zd:22451/zd:24289/zd:17450) (q:draft)
khatbekbek = (i:1) (t:num) (f:everyday) (w:only one/just one/a single) (d:<khat> and <bekbek> written as one word: one and no more) (j:khat/bekbek) (r:zd:12307/zd:18893/zd:20734) (q:draft)
khatbel = (i:1) (t:phrase) (f:everyday) (d:<khat>, one, and the particle <bel> written as one word: one, however; one at least; it sets a single person or thing against what was said before) (j:khat/bel) (r:zd:17872/zd:16876/zd:16844) (q:draft, low confidence)
khatciang = (i:1) (t:adv) (f:everyday/work) (w:each/apiece/per one) (d:<khat> and <ciang> written as one word, after a noun and often followed by <in>: for each one, per item or per person, said of a price or share) (j:khat/ciang) (r:zd:14531/zd:15097/zd:11308) (q:draft)
khatciangin = (i:1) (t:adv) (f:everyday/work) (w:each/apiece/per unit) (d:<khat>, one, and <ciangin> written as one word after the thing counted: for each one, giving the price or number that belongs to a single unit) (j:khat/ciangin) (r:zd:16515/zd:15417/zd:11445) (q:draft)
khate = (i:4) (t:part) (f:everyday) (w:those who/the ones who) (d:<kha.4>, happen to, with the plural <te>, placed after a verb: the people to whom it happened or who came to do it, as in {a thuak khate}, the victims, and not a plural of the noun <kha>) (r:zd:16678/zd:24071/zd:22046) (q:draft)
khateh = (i:1) (t:n) (f:everyday/social) (w:scraps/leavings/handout) (d:what another person lets fall or leaves over; {mi khateh ngak} is wait for the leavings of others, live on what others give) (r:zd:24712/zd:20823) (q:draft, low confidence)
khatha = (i:1) (t:n) (f:religion) (w:spirit/spiritual strength) (d:<kha>, spirit, and <tha>, strength, written as one word: the spirit and its strength, spiritual life) (j:kha/tha) (r:zd:23784/zd:10682) (q:draft, low confidence)
khathak = (i:1) (t:n) (f:time) (w:new month) (d:<kha>, month, and <thak>, new, written as one word: a new month, the beginning of a month) (j:kha/thak) (r:zd:17327) (q:draft, low confidence)
khathei = (i:1) (t:adv) (f:everyday) (w:perhaps/maybe/probably) (d:placed after the verb to say that something may well happen or be so, often followed by <ding>) (q:draft)
khatheiding = (i:1) (t:adv) (f:everyday) (w:may/might/probably will) (d:<khathei> and <ding> written as one word after a verb: it may well happen, it is likely to) (j:khathei/ding) (r:zd:14995/zd:20345/zd:12985) (q:draft)
khathu = (i:1) (t:n) (f:religion) (w:spiritual matters/spiritual things) (d:<kha> spirit and <thu> matter, written as one word: the things of the spirit, set beside {leitung thu}, worldly matters, and {taksa thu}, matters of the body) (j:kha/thu) (r:zd:11891/zd:15772/zd:13305) (q:draft)
khatin = (i:3) (t:det) (f:everyday/media) (w:a/one/a certain) (d:<khat>, one, with <in>, the marker of the doer: placed after a noun for one unnamed person who does or says something, as {khuami khatin gen hi}, a villager said; the commonest use in news reports) (r:zd:21389/ts:8593/ts:5049) (q:draft)
khatinzong = (i:1) (t:phrase) (f:everyday) (w:one also/another also) (d:<khat>, one, with the marker <in> and <zong>, also, written as one word: after a noun, a certain one also did something; after <pen>, also as one of the most) (j:khat/in/zong) (r:zd:16598/zd:12992/zd:19743) (q:draft)
khatkhat = (i:1) (t:adj) (f:everyday) (w:some/certain) (d:<khat>, one, doubled and written as one word: some, one here and one there; {mun khatkhat ah} is in some places and {khatkhat te} is some people) (r:zd:12337/zd:14696) (q:draft)
khatkhat = (i:2) (t:adv) (f:everyday) (w:one by one/one at a time) (d:<khat>, one, doubled and followed by <in>: one by one, one after another) (r:zd:23594) (q:draft)
khatkhatte = (i:1) (t:pron) (f:everyday) (w:some/certain ones) (d:<khatkhat>, some, and the plural <te> written as one word: some of them, certain ones; {pawl khatkhatte} is some groups) (j:khatkhat/te) (r:zd:22860/zd:12989) (q:draft)
khatkhit = (i:1) (t:phrase) (f:everyday) (d:<khat>, one, and <khit>, after, written as one word, in {khatkhit khat}, one after another, literally after one, one) (j:khat/khit) (r:zd:21594) (q:draft)
khatkhitkhat = (i:1) (t:adv) (f:everyday) (w:one after another/one by one) (d:<khat>, <khit> and <khat> written as one word, one after one: each following the last, in turn) (r:zd:19958/zd:12632/zd:14959) (q:draft)
khatkiang = (i:1) (t:phrase) (f:everyday) (w:to one/to a certain person) (d:<khat>, one, and <kiang>, side, written as one word and followed by <ah>: to a certain person, to one of them) (j:khat/kiang) (r:zd:13072/zd:17661) (q:draft)
khatkiangah = (i:1) (t:phrase) (f:everyday) (w:to one/to a) (d:<khat>, one, and <kiangah>, to, written as one word, after a noun: to one of them, to a certain person) (j:khat/kiangah) (r:zd:20071/zd:13336) (q:draft)
khatle = (i:1) (t:num) (f:everyday) (w:one and) (d:<khat> and <le> written as one word; {khatle khat} is one another, between one and another, and after a measure, as {Minute khatle alang}, it is one and a half) (j:khat/le) (r:zd:13076/zd:23727/zd:23148) (q:draft)
khatleh = (i:1) (t:phrase) (f:everyday) (w:one and) (d:<khat>, one, and <leh>, and, written as one word: one and, a and, joining a first person or thing to the next; {khatleh khat} is one another) (j:khat/leh) (r:zd:12676/zd:16490/zd:23432) (q:draft)
khatlehkhat = (i:1) (t:pron) (f:everyday/social) (j:khatlekhat) (r:zd:24847/zd:12656/zd:8668) (q:draft)
khatmah = (i:1) (t:phrase) (f:everyday) (w:one/indeed one) (d:<khat> and the emphatic <mah> written as one word: one, a, with emphasis; after a noun, {Actor khatmah ahihi}, he is an actor) (j:khat/mah) (r:zd:12244/zd:18191) (q:draft)
khatni = (i:1) (t:adv) (f:time) (w:one day/some day) (d:<khat> and <ni> written as one word, in {ni khatni}: one day, some day; with <ciangin> of a day still to come) (j:khat/ni) (r:zd:21389/zd:21690) (q:draft)
khatpan = (i:1) (t:adv) (f:everyday) (w:from one/from a) (d:<khat> and <pan> written as one word, after the noun that is counted: from one, from a, as {innkuan khatpan}, from a family) (j:khat/pan) (r:zd:16257/zd:23903) (q:draft)
khatpanin = (i:1) (t:phrase) (f:everyday) (w:from a/from one) (d:<khat> and <panin> written as one word, after a noun: from a, from one such place or thing) (j:khat/panin) (r:zd:12945/zd:15427) (q:draft)
khatpapen = (i:1) (t:phrase) (f:everyday) (w:one of them/the other one) (d:<khatpa>, one man, and the topic marker <pen> written as one word: one of the men, the other man, as the one spoken about) (j:khatpa/pen) (r:zd:16998/zd:15828) (q:draft)
khatpen = (i:1) (t:num) (f:everyday) (w:one/the one) (d:<khat>, one, with the topic marker <pen>, written as one word: one of them, a certain one, as the one spoken about) (j:khat/pen) (r:zd:19052/zd:24276) (q:draft)
khatpeuhtawh = (i:1) (t:phrase) (f:everyday) (w:with any/with some) (d:<khatpeuh> and <tawh> written as one word, after a noun: with any one of them, with some one or other) (j:khatpeuh/tawh) (r:zd:20191/zd:19369) (q:draft)
khatpeuhzong = (i:1) (t:pron) (f:everyday) (w:anyone at all/any at all/even one) (d:<khatpeuh> and <zong> written as one word: any person or thing whatever, and with a negative not even one) (j:khatpeuh/zong) (r:zd:20257/zd:16869) (q:draft)
khatsung = (i:1) (t:adv) (f:everyday/time) (w:in one/within one) (d:<khat>, one, and <sung>, in, written as one word after a noun: inside one thing, as {mawtaw khatsung ah}, in one car, or within one unit of time, as {Minute khatsung in}, within a minute) (j:khat/sung) (r:zd:11752/zd:12600/zd:14545) (q:draft)
khatsungah = (i:1) (t:adv) (f:everyday) (w:in one/inside one) (d:<khat>, one, and <sungah>, inside, written as one word after a noun: inside one thing, as {Box khatsungah}, in one box) (j:khat/sungah) (r:zd:21922/zd:19529) (q:draft)
khatsungpan = (i:1) (t:phrase) (f:everyday/family) (w:from one/from within one) (d:<khatsung>, in one, and <pan>, from, written as one word after a noun: from within one, as {innkuan khatsungpan}, from one family) (j:khatsung/pan) (r:zd:21164/zd:16813) (q:draft)
khatta = (i:1) (t:num) (f:everyday) (w:one each/one apiece) (d:<khat>, one, with the distributive ending {-ta}: one for each, one at a time) (b:khat) (r:zd:17177/zd:15275/zd:22695) (q:draft)
khattang = (i:1) (t:adv) (f:everyday/social) (w:alone/by oneself/solitary) (d:one person alone, without company; {khattang kisa} is feel lonely) (r:zd:21151/zd:22557/zd:22715) (q:draft)
khattawh = (i:1) (t:phrase) (f:everyday) (w:with one/with a) (d:<khat> and <tawh> written as one word, after a noun: with a, with one, by means of one) (j:khat/tawh) (r:zd:14899/zd:8668/zd:11827) (q:draft)
khatteh = (i:1) (t:phrase) (f:time/everyday) (w:in one/per) (d:<khat>, one, with <teh>, here a spoken form of <ciangin>, written as one word: at or in one, as {nipi khatteh}, in a week, and {hun khatteh}, at one time, after a time) (r:zd:23873/zd:15743) (q:draft, low confidence)
khattek = (i:1) (t:adv) (f:everyday) (w:one each/each one) (d:<khat>, one, and <tek>, each, written as one word: one for each person) (j:khat/tek) (r:zd:23343/zd:16696) (q:draft)
khattuak = (i:1) (t:adv) (f:everyday) (w:one each/one apiece) (d:<khat>, one, with <tuak>, each, written as one word after a noun: one for each of them) (j:khat/tuak) (r:zd:16900/zd:15305) (q:draft)
khattung = (i:1) (t:phrase) (f:everyday/travel) (w:on one/upon one) (d:<khat>, one, with <tung>, on, written as one word and followed by <ah> or <panin>: on one, as {Motorcycle khattung ah}, on one motorcycle; of a person, against one) (j:khat/tung) (r:zd:14658/zd:11574) (q:draft)
khattungah = (i:1) (t:phrase) (f:everyday/travel) (w:on one/upon one) (d:<khattung>, on one, with the place marker <ah>, written as one word: on one vehicle, or leaning on one person) (j:khattung/ah) (r:zd:17353/zd:19353) (q:draft)
khatval = (i:1) (t:num) (f:everyday) (w:more than one/over one) (d:<khat> and <val> written as one word: more than one; after a unit, over one of it, as {Million khatval}, over a million) (j:khat/val) (r:zd:20363/zd:15445) (q:draft)
khatveibek = (i:1) (t:adv) (f:everyday/time) (w:only once/just once) (d:<khatvei>, once, and <bek>, only, written as one word) (j:khatvei/bek) (r:zd:15790/zd:15321/zd:13056) (q:draft)
khatveimah = (i:1) (t:adv) (f:time/everyday) (w:once/once again/on one occasion) (d:<khatvei>, once, and the emphatic <mah>, written as one word: one time, with <ngei> once before and with <kik> or <leuleu> once again) (j:khatvei/mah) (r:zd:20023/zd:12662) (q:draft)
khatveita = (i:1) (t:adv) (f:time) (w:once each/once every) (d:<khatvei>, once, with the distributive <ta>, each, written as one word after a period of time: once in every such period, as in {khakhat in khatveita}, once a month) (j:khatvei/ta) (r:zd:14557/zd:12280) (q:draft)
khatveizong = (i:1) (t:adv) (f:everyday) (w:even once/not once) (d:<khatvei> and <zong> written as one word: even once; with a negative verb, never, not a single time) (j:khatvei/zong) (r:zd:16961/zd:15609) (q:draft)
khatzaw = (i:1) (t:pron) (f:everyday) (w:the other/one or the other) (d:one of two as against the other; mostly {a khatzaw}, the other one, and {khatzaw zaw}, either one of the two) (r:ts:3375/zd:19863/zd:16490) (q:draft)
khatzawkzawk = (i:1) (t:pron) (f:everyday) (w:either one/any one/one or the other) (d:<khat>, one, with <zawkzawk>: one of those named, whichever it is; placed after a list or after <lak>, among) (r:zd:15445/zd:19820) (q:draft)
khatzong = (i:2) (t:pron) (f:media/everyday) (w:one also/another one/also one of) (d:in statements that are not negative: one more of the kind as well, as in {Police Officer khatzong liam}, one police officer was also injured; with <ahihi> it is also one of them) (r:zd:19745/zd:11625/zd:15512) (q:draft)
khaubang = (i:1) (t:phrase) (f:media) (w:like a cord) (d:<khau> and <bang> written as one word: like a cord, a simile of songs and poetic speech for what is drawn out, traced or entangled) (j:khau/bang) (r:zd:19984) (q:draft, low confidence)
khaugui = (i:1) (t:n) (c:plant) (f:nature) (w:vine/creeper) (d:<khau>, rope, with <gui>, vine: a climbing or trailing plant with long stems like cords, also used for tying) (r:ts:3375/ts:3369) (q:draft)
khauhlua = (i:1) (t:adj) (f:nature/everyday) (w:very strong/too strong/severe) (d:<khauh> and <lua> written as one word: very or too strong, said of wind, an earthquake, fire, a smell or speed) (j:khauh/lua) (r:zd:20703/zd:14714/zd:21961) (q:draft)
khauhmahmah = (i:1) (t:adj) (f:everyday/nature) (w:very strong/very hard/severe) (d:<khauh>, strong, and <mahmah>, very, written as one word: very strong, said of wind, a smell, smoke, an illness or a crackdown) (j:khauh/mahmah) (r:zd:18166/zd:14547/zd:21961) (q:draft)
khauhpai = (i:1) (t:adj) (f:everyday/social) (w:strong/intense/firm/strict) (d:strong and forceful, or growing so: of wind, fighting, trade, feeling or faith strong and intense, of a rule or a leader firm and strict; built on <khauh>, hard or strong) (r:zd:22040/zd:23332/zd:21918) (q:draft)
khauhsuai = (i:1) (t:n) (f:food) (w:noodles) (d:noodles made from wheat flour; also instant noodles) (o:Burmese, khauk swe) (r:zd:19245/zd:11364/zd:14826) (q:draft)
khauhtak = (i:1) (t:adv) (f:everyday/politics) (w:firmly/strictly/severely/sternly) (d:<khauh> and <tak> written as one word, usually followed by <in>: firmly, strictly or severely; {khauhtak in thu bawl} is deal severely with a case) (j:khauh/tak) (r:zd:14620/zd:14543) (q:draft)
khaukhih = (i:1) (t:v) (f:everyday) (w:tie with a rope/tie a rope to) (d:<khau>, rope, and <khih>, tie, written as one word: fasten a rope to something) (j:khau/khih) (r:zd:12756) (q:draft, low confidence)
khaukhung = (i:1) (t:v) (f:everyday/politics) (w:rope off/cordon off/stretch a rope) (d:<khau>, rope, with <khung>, put across: stretch a rope or tape, to close off a place or to hold on to) (r:zd:17256/zd:11384) (q:draft)
khautawh = (i:1) (t:phrase) (f:everyday/home) (w:with a rope/by a cord) (d:<khau> and <tawh> written as one word: with or by means of a rope, cord or cable) (j:khau/tawh) (r:zd:21989/zd:14722) (q:draft)
khawh = (i:3) (t:v) (f:everyday) (w:spear/stab/thrust) (d:thrust or throw a spear at an animal or a target, with <tei> or <teipi>, spear; {tei khawh} is also a spear contest; not the {khawh} of working a field) (r:ts:301) (q:draft, low confidence)
khawina = (i:1) (t:n) (f:nature/work) (w:rearing/breeding/keeping of animals) (d:<khawi>, keep and rear, with the noun suffix <na>: the rearing of animals, or the place where they are kept; <ganhing khawina> is a place where animals are kept, a zoo or farm) (b:khawi) (r:zd:22157/zd:19468) (q:draft)
khawisa = (i:1) (t:n) (f:home/nature) (w:domestic animal/livestock/pet) (d:<khawi>, keep or rear, with <sa>, already done: an animal that one keeps, livestock or a pet; named beside <neihsa> and <khawhsa>) (b:khawi) (r:zd:20769/zd:19396) (q:draft)
khawk = (i:2) (t:n) (f:social/politics) (w:district/area/region/circuit) (d:a marked-off area of a country or of the work of a church, with its own leaders, such as a county, a state or a church circuit; {khawk makaite} are the area leaders and {khawk le veng} is area and ward) (r:zd:9239/zd:13013/zd:25080) (q:draft)
khawl = (i:2) (t:v) (f:everyday/work) (w:stop/rest/cease/retire) (d:stop what one is doing: pause to rest or stay a while on the way, cease an activity, and after <pan>, from, leave a job or office; {khawl sak} is make stop, suspend, and {khawl phot} is stop for now) (r:zd:23533/zd:24786/ts:7065) (q:draft)
khawlbawl = (i:1) (t:v) (f:everyday) (w:stop/pause/leave off) (d:stop doing something, for a while or for good; {ki khawlbawl} is be discontinued) (r:zd:11687/zd:24276/zd:20798) (q:draft)
khawlcipsak = (i:1) (t:v) (f:work/travel) (w:bring to a standstill/halt/shut down/suspend) (d:<khawlcip>, stop completely, with <sak>, cause: make something stop completely, as trains, a terminal or a business; with <ki> before it, be halted) (b:khawlcip) (j:khawlcip/sak) (r:zd:17743/zd:17097) (q:draft)
khawldan = (i:1) (t:n) (f:social) (w:manners/conduct/behaviour) (d:way of behaving, found in the pair <omdan khawldan>, conduct and manners, beside <omdan>) (r:zd:19990/zd:22138) (q:draft, low confidence)
khawldante = (i:1) (t:n) (f:social/everyday) (w:ways of staying/conduct) (d:<khawl>, stay or stop, with <dante>, ways: how people stay and behave in a place, paired with {om dan} as {i om dan i khawldante}, the way we live and conduct ourselves) (r:zd:22652) (q:draft, low confidence)
khawlding = (i:1) (t:v) (f:everyday/travel) (w:to stop/will stop/to quit) (d:<khawl> and <ding> written as one word, with <khawl> in the sense stop or rest: to stop, of a vehicle, a piece of work or a habit) (j:khawl/ding) (r:zd:15286/zd:14869/zd:20966) (q:draft)
khawlhun = (i:1) (t:n) (f:work/time) (w:break/rest time/time off) (d:<khawl>, stop or rest, with <hun>, time: the time when work stops, a break) (r:zd:19915/zd:17070) (q:draft)
khawlkhawm = (i:1) (t:v) (f:social/family) (w:keep company/stay together/be together) (d:<khawl> with <khawm>, together: spend time in one another's company; often paired with <tukhawm>, sit together, as {tukhawm khawlkhawm}) (r:zd:21869/zd:24386/zd:24121) (q:draft)
khawlkik = (i:1) (t:v) (f:everyday) (w:stop/give up/halt) (d:<khawl> in the sense stop, with <kik> back: stop what one was doing, give up before the goal, or come to a halt) (r:zd:22988/zd:21869) (q:draft)
khawllai = (i:1) (t:phrase) (f:everyday/work) (w:while stopped/at rest/parked) (d:<khawl>, stop or rest, and <lai>, while, written as one word: while at rest or stopped; of a vehicle, parked; of work or school, in the time when it has stopped) (j:khawl/lai) (r:zd:19683/zd:12994) (q:draft)
khawllo = (i:1) (t:v) (f:everyday) (w:not stop/be unceasing) (d:<khawl>, stop or rest, with <lo>, not, written as one word: not stop; {khawllo in} is without stopping) (j:khawl/lo) (r:zd:22992/zd:23890/zd:20568) (q:draft)
khawlmun = (i:2) (t:n) (f:travel) (w:stop/station/parking place) (d:a place where a bus, boat, taxi or car stops for passengers or is parked, often beside the English words bus or stop; a present-day use beside the resting place and the harbour for ships) (s:khawlna) (r:zd:16421/zd:15617/zd:22282) (q:draft)
khawlni = (i:1) (t:n) (f:time/work) (w:day off/rest day/holiday) (d:<khawl>, stop or rest, with <ni>, day: a day on which work stops, as in {nasep khawlni}; also the day on which something is given up) (r:zd:14519/zd:15698) (q:draft)
khawlnuamlo = (i:1) (t:v) (f:travel/everyday) (w:refuse to stop/be unwilling to stop) (d:<khawl>, here stop or halt, with <nuamlo>, not want, written as one word: not be willing to stop, said of a driver told to halt) (j:khawl/nuamlo) (r:zd:19554/zd:11051) (q:draft)
khawlpan = (i:1) (t:v) (f:travel/everyday) (w:come to a stop/stop only then) (d:<khawl>, here stop or halt, and <pan>, only then, written as one word: of a vehicle or driver, finally come to a stop) (j:khawl/pan) (r:zd:12155/zd:20129) (q:draft, low confidence)
khawlphot = (i:1) (t:v) (f:everyday/work) (w:stop for a while/pause/stop for now) (d:<khawl>, here stop or rest, with <phot>, for the time being, written as one word: stop what one is doing for a while) (j:khawl/phot) (r:zd:22742/zd:13299/zd:20652) (q:draft)
khawlsak = (i:2) (t:v) (f:work) (w:dismiss/suspend/lay off) (d:put an end to a person's work, for good or for a time: after <nasep>, work, or in the passive {ki khawlsak}, be dismissed or suspended from a job) (r:zd:11961/zd:13028/zd:23616) (q:draft)
khawlsakding = (i:1) (t:v) (f:work/everyday) (w:will stop/will be stopped/will be dismissed) (d:<khawlsak>, stop, and <ding> written as one word: will stop or is to be stopped; of work, will be dismissed or laid off) (j:khawlsak/ding) (r:zd:17396/zd:19721/zd:11961) (q:draft)
khawlsakphot = (i:1) (t:v) (f:work/everyday) (w:suspend/stop for the time being/halt for now) (d:<khawlsak>, make stop, and <phot>, for the time being, written as one word: suspend a person from work or a service from running until a matter is settled; mostly with <ki>, be suspended) (j:khawlsak/phot) (r:zd:13188/zd:14965) (q:draft)
khawlsaksawm = (i:1) (t:v) (f:travel/politics) (w:try to stop/attempt to halt) (d:<khawlsak>, make stop, and <sawm>, intend or try, written as one word: try to stop a vehicle or a person, said of police and guards) (j:khawlsak/sawm) (r:zd:17748/zd:21341) (q:draft)
khawlsakthei = (i:1) (t:v) (f:everyday/travel) (w:be able to stop/manage to stop) (d:<khawlsak>, make stop, with <thei>, be able, written as one word: manage to bring a vehicle, a person or an act to a stop) (j:khawlsak/thei) (r:zd:11841/zd:17030) (q:draft)
khawlsan = (i:1) (t:v) (f:everyday/work) (w:stop/cease/give up/cancel) (d:<khawl>, stop, with the ending {-san}, leaving behind: stop doing something and leave it, give up or call off what was done or planned) (s:tawpsan) (r:zd:21313/zd:11005/zd:10859) (q:draft)
khawlsanna = (i:1) (t:n) (f:politics/everyday) (w:stopping/cessation/halt) (d:<khawlsan>, stop, with the noun suffix {-na}: the stopping of something; {kikaptuahna khawlsanna} is a ceasefire) (b:khawlsan) (r:zd:21931) (q:draft)
khawlta = (i:1) (t:v) (f:work/everyday) (w:stop/cease/step down/resign) (d:<khawl>, here stop or rest, and <ta.2> written as one word: has stopped, has given up a work or an office; {apanmun pan khawlta} is has stepped down from his post) (j:khawl/ta) (r:zd:19166/zd:18191/zd:24733) (q:draft)
khawltading = (i:1) (t:v) (f:work) (w:will step down/will resign/will stop) (d:<khawlta> and <ding> written as one word: is now going to stop, said of leaving a post or a job; {nasep khawltading} is will retire from work) (j:khawlta/ding) (r:zd:21649/zd:11852) (q:draft)
khawlthei = (i:1) (t:v) (f:everyday/travel) (w:be able to stop/manage to stop) (d:<khawl>, stop or rest, and <thei>, able, written as one word: be able to stop, come to a stop) (j:khawl/thei) (r:zd:20099/zd:18169) (q:draft)
khawltheilo = (i:1) (t:v) (f:everyday/travel) (w:cannot stop/unable to stop) (d:<khawl>, stop, with <theilo>, unable, written as one word: of a train, a plane or a craving, be unable to stop) (j:khawl/theilo) (r:zd:10768/zd:11982) (q:draft)
khawltuanlo = (i:1) (t:v) (f:everyday) (w:not stop/keep going) (d:<khawl>, here stop, with <tuanlo>, not even so, written as one word: not stop in spite of it, carry on regardless) (j:khawl/tuanlo) (r:zd:20767/zd:16580) (q:draft)
khawlvat = (i:1) (t:v) (f:everyday/health) (w:stop suddenly/halt abruptly) (d:come to a sudden stop, said of a vehicle or of the heart; {lungtang khawlvat-natna} is cardiac arrest) (r:zd:18063/zd:17152) (q:draft)
khawm = (i:1) (t:adv) (f:everyday/social) (w:along/together/side by side) (d:after a verb, doing the action together with others or jointly) (s:khawmin/khop)
khawmding = (i:1) (t:part) (f:everyday/social) (w:will do together/to do together) (d:<khawm> and <ding> written as one word after a verb: will do it together, are to do it jointly) (j:khawm/ding) (r:zd:22171/zd:19820/zd:16038) (q:draft)
khawmlo = (i:1) (t:adv) (f:everyday) (w:not together) (d:<khawm>, together, and <lo>, not, written as one word after a verb: not doing it together) (j:khawm/lo) (r:zd:25710/zd:19662) (q:draft)
khawmpi = (i:1) (t:n) (f:social/politics/religion) (w:conference/convention/assembly) (d:<khawm>, together, with the augmentative <pi>: a large general meeting of an organisation, a church body or of nations, such as an annual conference) (b:khawm) (r:zd:13207/zd:24574/zd:20587) (q:draft)
Khawmpite = (i:1) (t:n) (f:social/religion) (w:conferences/assemblies) (d:<khawmpi>, conference, with the plural <te>) (b:khawmpi) (r:zd:20727/zd:16686) (q:draft)
khawmthei = (i:1) (t:adv) (f:everyday/social) (w:able to do together) (d:<khawm>, together, and <thei>, able, written as one word after a verb: can do it together; {om khawmthei} is can be together) (j:khawm/thei) (r:zd:11308/zd:21279) (q:draft)
khawng peuh = (i:1) (t:part) (f:everyday) (w:and the like/or some such/things like) (d:<khawng>, or so, and <peuh>, any: placed after a noun, a list or a quoted word, it makes it one loose example among others, things like that, or some such, often with a slighting tone) (r:ts:3369/zd:24742) (q:draft)
khawnga = (i:1) (t:part) (f:everyday) (d:<khawng>, or so, and the like, with <a>: placed after a place, a time or an action to mean in, at or from such a place or about such a time, and things of that kind) (j:khawng/a) (r:zd:23297/zd:25668/zd:9223) (q:draft)
khawngbek = (i:1) (t:adv) (f:everyday) (w:only about/just around) (d:<khawng>, about, and <bek>, only, written as one word after a number or amount: only about that much) (j:khawng/bek) (r:zd:19063/zd:19719/zd:16442) (q:draft)
khawngciangin = (i:1) (t:adv) (f:time) (w:at about/around) (d:<khawng> and <ciangin> written as one word: placed after a time or an amount of time, at about that time, when about that much time has passed) (j:khawng/ciangin) (r:zd:19098/zd:17864/zd:13171) (q:draft)
khawnggawp = (i:1) (t:v) (f:nature) (w:flood badly/overflow) (d:said of water, {tui khawnggawp}: rise and flood with great damage; the first part seems to be a form of <khang>, rise, with <gawp>) (r:zd:20345/zd:12283) (q:draft, low confidence)
khawngmah = (i:1) (t:part) (f:everyday) (w:or so/or the like/even) (d:<khawng>, or so, with the emphatic <mah>, written as one word after a number, a place or a thing: about that, or some such) (j:khawng/mah) (r:zd:18083/zd:22827) (q:draft, low confidence)
khawngpan = (i:1) (t:prep) (f:everyday) (w:from about/from places like) (d:<khawng> and <pan> written as one word, often followed by <in>: from such places as the one named, or from about the time or amount named) (j:khawng/pan) (r:zd:17919/zd:12299/zd:12742) (q:draft)
khawngpen = (i:1) (t:part) (f:everyday) (w:things like/as for the likes of) (d:<khawng>, and the like or thereabouts, with the topic marker <pen> written as one word: marks a loosely named thing or time as the subject) (j:khawng/pen) (r:zd:14768/zd:21351) (q:draft)
khawngpeuh = (i:1) (t:part) (f:everyday) (w:or the like/and such/or something) (d:<khawng> and <peuh> written as one word, placed after a noun or a list: that sort of thing, or anything like it) (j:khawng/peuh) (r:zd:18104/zd:14720) (q:draft)
khawngtawh = (i:1) (t:prep) (f:everyday) (w:with something like/with or the like/with about) (d:<khawng>, or so, and <tawh>, with, written as one word after a noun or number: with such a thing or something like it, with about that many) (j:khawng/tawh) (r:zd:16249/zd:15445/zd:22030) (q:draft)
khawngzong = (i:1) (t:part) (f:everyday) (w:and the like also/things like that too) (d:<khawng>, or so, and <zong>, also, written as one word after a noun or phrase: such things as this too) (j:khawng/zong) (r:zd:14888/zd:12942/zd:22707) (q:draft)
khawnkhong = (i:1) (t:adj) (f:work/everyday) (w:free/free of charge/gratis) (d:given or done without payment; mostly as {a khawnkhong}, free, and {a khawnkhong in}, for free, freely) (r:zd:19425/zd:26310/zd:10685) (q:draft)
khawp = (i:1) (t:adv) (f:everyday) (w:together) (d:form of <khawm>, together, used after a verb when another word follows: {tuang khawp} is ride together and {kikaih khawp} is be gathered together) (b:khawm) (r:zd:17295/zd:15501) (q:draft, low confidence)
khawpi = (i:1) (t:n) (f:travel/social) (j:khuapi) (r:zd:20389/zd:24462) (q:draft)
khazai = (i:1) (t:n) (f:politics) (w:district) (d:an administrative district of Myanmar, the unit between the township and the state) (o:Burmese, kha-yaing) (r:zd:25488/zd:22586) (q:draft)
Khazaing = (i:1) (t:n) (f:politics) (j:khazai) (r:zd:22334) (q:draft)
khazih sungah = (i:1) (t:phrase) (f:religion) (w:in Christ/yours in Christ) (d:<Khazih>, Christ, and <sungah>, inside: in Christ; set alone on a line with a comma and followed by the name of the writer, it is the closing formula of a letter or article by a Christian writer) (r:zd:26956) (q:draft)
khedan = (i:1) (t:n) (f:education) (w:pencil) (o:Burmese) (r:zd:22695/zd:17269) (q:draft)
khedap = (i:1) (t:n) (f:home) (w:shoe/sandal) (d:footwear, a sandal or shoe; {khedap bulh} is put on sandals, {khedap suah} is take them off, and {khedap khau} is the sandal strap) (q:draft)
kheikhia = (i:1) (t:v) (f:everyday) (w:cut out/take out/extract) (d:<khei>, pick out, and <khia>, out, written as one word; said here of the belly of a snake that is cut open to take out what it swallowed) (j:khei/khia) (r:zd:11986) (q:draft, low confidence)
khelam = (i:1) (t:n) (f:travel) (w:footpath/foot track) (d:<khe>, foot, and <lam>, way, written as one word: a path for going on foot, as between houses or along an old road line) (j:khe/lam) (r:zd:16035/zd:22586) (q:draft, low confidence)
khelangkhat = (i:1) (t:n) (f:body) (w:one leg/one foot) (d:<khe> and <langkhat> written as one word: one of the two legs or feet) (j:khe/langkhat) (r:zd:22116) (q:draft)
khelhna = (i:1) (t:n) (f:religion/everyday) (j:khialhna) (r:zd:25473/zd:21159) (q:draft)
khelkhel = (i:1) (t:v) (f:everyday) (w:keep changing/change again and again) (d:<khel> said twice: change repeatedly, often with <ki>; other uses, as in {Comment khelkhel} and {kituak khelkhel}, are not determined) (b:khel) (r:zd:12341/zd:18002/zd:13165) (q:draft)
khelna = (i:1) (t:n) (f:everyday/social) (w:change/changing/shift) (d:<khel>, change, with the noun suffix <na>: the changing of something; {ki khelna}, also written <kikhelna>, is change that comes about, being changed) (s:kikhelna) (b:khel) (r:zd:20875/zd:22451) (q:draft)
khelthei = (i:1) (t:v) (f:everyday) (w:can change/be able to change) (d:<khel>, change, and <thei>, able, written as one word: able to change a thing, or with <ki> able to be changed) (j:khel/thei) (r:zd:20682/zd:19621) (q:draft)
khelzo = (i:1) (t:v) (f:everyday) (w:be able to change/manage to change) (d:<khel> and <zo> written as one word: succeed in changing something; with <ki>, be changed) (j:khel/zo) (r:zd:23049/zd:11555) (q:draft)
khem = (i:4) (t:det) (f:everyday) (w:all/every) (d:only with <peuh> after it, as {khem peuh}, the word <khempeuh>, all, written as two words: {meltheih khem peuh} is all acquaintances; it has nothing to do with deceiving) (r:zd:23427/zd:11449) (q:draft)
khempeuh = (i:1) (t:pron) (f:everyday) (w:every/all/everyone/everything) (d:all, every: placed after a noun, as {mi khempeuh}, all people or everyone, and {thu khempeuh}, everything)
khempeuh phial = (i:1) (t:adv) (f:everyday) (w:almost all/nearly every/virtually all) (d:<khempeuh>, all, and <phial>, here a word that loosens the statement: placed after a noun, almost all or practically every one of them) (r:zd:20919/zd:25086) (q:draft)
khempeuhphial = (i:1) (t:pron) (f:everyday) (w:almost all/practically all) (d:<khempeuh>, all, and <phial> written as one word, placed after a noun: all of it or very nearly all) (j:khempeuh/phial) (r:zd:11545/zd:11538) (q:draft, low confidence)
khempeuhzong = (i:1) (t:pron) (f:everyday) (w:all also/every one too) (d:<khempeuh>, all, and <zong>, also, written as one word after a noun: all of them as well; with a negative, not all of them either) (j:khempeuh/zong) (r:zd:21057/zd:15764) (q:draft)
khen = (i:3) (t:v) (f:social/politics) (w:judge/decide/settle) (d:with <thu>, matter, before it: hear a case and decide it, pass judgment; the same as the one word <thukhen>) (r:zd:15857/zd:23297) (q:draft)
khenbawl = (i:1) (t:v) (f:everyday) (w:divide up/separate/part) (d:<khen> with <bawl>, written as one word: divide into parts, as by state and region; with <ki>, part from one another) (j:khen/bawl) (r:zd:19964/zd:19166) (q:draft, low confidence)
khencian = (i:1) (t:v) (f:everyday) (w:distinguish clearly/tell apart/identify) (d:<khen>, separate, with <cian>, clearly: tell one from another with certainty; often with the prefix <ki> as {ki khencian thei}, can be told apart) (s:khentel) (j:khen/cian) (r:zd:17064/zd:11908) (q:draft)
kheng = (i:2) (t:v) (f:everyday/politics) (w:change/exchange/amend) (d:put one thing in the place of another, the same word as <khek>: exchange goods for other goods with <tawh>, or change a law, as in {thukhunpi kheng}, amend the constitution) (r:zd:24455/ts:301) (q:draft, low confidence)
khengkhang = (i:1) (t:adv) (f:everyday) (w:in great numbers/in a rush/all over) (d:placed after a verb, of many people or things doing the same at once in a throng or a rush, as {ciak khengkhang}, be packed full, and {kizel khengkhang}, spread everywhere) (r:zd:21027/ts:4569/zd:15456) (q:draft, low confidence)
khengval = (i:2) (t:v) (f:everyday/time) (w:exceed/be in excess/be over) (d:be more than a set time or amount, without the thought of wrongdoing; {hun khengval} is beyond the set hours, overtime, {a khengval in} is in excess, and {thau khengval} is overweight) (r:zd:25178/zd:24361/zd:24166) (q:draft)
khenkhap = (i:1) (t:v) (f:social) (w:divide/separate/split apart) (d:set people apart from one another, break up a group or a family; {khenkhap theih loh} is indivisible) (s:khen) (r:zd:25357/ts:7133) (q:draft)
khenkhen = (i:1) (t:v) (f:social/everyday) (w:divide up/split apart/separate) (d:<khen>, divide, doubled: go on dividing, split people or things into several groups or kinds) (b:khen) (r:zd:21822/zd:22577) (q:draft)
khenkhia = (i:4) (t:v) (f:media) (w:publish/print/bring out) (d:bring out a book or songs in print, with objects such as <labu> and <la>, often after <kaikhawmin>, having collected them; not the separating of the other senses) (r:zd:9240/zd:9224/zd:9214) (q:draft)
khenlo = (i:1) (t:adv) (f:everyday/social) (w:without distinction/regardless of/not dividing) (d:<khen> and <lo> written as one word: not separating; after a list of kinds, without distinction between them) (j:khen/lo) (r:zd:17309/zd:25202/zd:24064) (q:draft)
Khenman = (i:1) (t:name) (c:place) (f:travel) (w:Khenman) (d:a village in the Tonzang area of Chin State near the Indian border, named with Cikha as the end of a road) (r:zd:19702/zd:19723) (q:draft, low confidence)
khenpi = (i:1) (t:n) (f:everyday/education) (w:part/division/section) (d:one of the main parts into which a whole is divided, such as a part of a book, a branch of a group or a division of a country; from <khen>, divide, with the suffix <pi>, great) (r:zd:21306/zd:21547/zd:18952) (q:draft)
khensatna nei = (i:1) (t:v) (f:politics/social) (w:decide/make a decision/rule/resolve) (d:<khensatna>, decision, with <nei>, have: come to a decision, of a court, a meeting or a person; what is decided stands before it, often with <ding> or after <thu>) (s:khensat) (r:zd:24800/zd:25078/zd:24845) (q:draft)
khensiam = (i:1) (t:v) (f:everyday/social) (w:distinguish/discern/tell apart) (d:<khen>, separate, with <siam>, skilled: know how to keep two things apart and judge between them rightly) (j:khen/siam) (r:zd:19302/zd:24030/zd:20798) (q:draft)
khentatding = (i:1) (t:v) (f:politics/everyday) (w:will decide/to be decided) (d:<khentat>, decide, and the future marker <ding> written as one word: will decide, or what is to be decided) (j:khentat/ding) (r:zd:20263/zd:20008) (q:draft)
khentuamna = (i:1) (t:n) (f:social/politics) (w:discrimination/partiality/unequal treatment) (d:<khentuam> with the noun suffix <na>: treating some people differently from others) (s:deidanna) (b:khentuam) (r:zd:9125/zd:9124/zd:25399) (q:draft)
Khephiau = (i:1) (t:n) (f:home/social) (w:traditional cloth) (d:a kind of traditional Zomi woven cloth worn by women, named together with <Puandum>; which garment it is exactly is not confirmed) (r:zd:22303/zd:22289) (q:draft, low confidence)
khet = (i:2) (t:v) (f:media) (w:print/publish) (d:print or publish a book, a song book or other writing, as in {a khet labu}, the song book he published; the fuller word is <khetkhiat>) (r:ts:3503/zd:9235/zd:9254) (q:draft)
khetawh = (i:1) (t:adv) (f:travel/body) (w:on foot/by foot) (d:<khe>, foot, and <tawh>, with, written as one word: on foot, walking) (j:khe/tawh) (r:zd:25630/zd:24276/zd:11856) (q:draft)
khetkhiat = (i:1) (t:v) (f:media/education) (w:publish/print/bring out) (d:print and bring out a book, songs or other writing; the second part is <khiat>, out) (r:zd:9221/zd:9262) (q:draft)
khetkhiatna = (i:1) (t:n) (f:media/work) (w:publishing/printing/publication) (d:the printing and bringing out of books or music; <khetkhiat> with the noun suffix {-na}) (b:khetkhiat) (r:zd:9247/zd:9229) (q:draft)
khetna = (i:1) (t:n) (f:media/work) (w:printing/print/impression) (d:<khet>, strike or stamp, with the noun suffix {-na}: the striking or stamping of something, above all of writing; {lai khetna} is printing, {lai khetna set} a printing press, {siktawh lai khetna} a typewriter, and {nihvei khetna} the second printing of a book) (b:khet) (r:zd:19621/zd:9225/zd:19316) (q:draft)
khetung = (i:1) (t:phrase) (f:body/everyday) (w:on the foot/on one's own feet) (d:<khe> and <tung> written as one word: on the foot or feet; {eima khetung ah ding} is to stand on one's own feet) (j:khe/tung) (r:zd:21306/zd:24712) (q:draft)
kheuhkheuh = (i:1) (t:adv) (f:everyday/body) (w:lightly/gently and repeatedly) (d:follows a verb to picture a light action done again and again: {beng kheuhkheuh} is pat gently and {nui kheuhkheuh} is giggle) (r:zd:15965/zd:25433) (q:draft, low confidence)
khiading = (i:1) (t:part) (f:everyday) (d:<khia> and <ding> written as one word, placed after a verb: will do it out or forth, in order to bring it out; {tangko khiading} is will be announced) (j:khia/ding) (r:zd:12945/zd:16155) (q:draft)
khiain = (i:1) (t:adv) (f:everyday) (w:out/going out) (d:<khia>, out, and the marker <in> written as one word after a verb: going out and then doing what follows) (j:khia/in) (r:zd:20716) (q:draft, low confidence)
khiakikding = (i:1) (t:v) (f:everyday/media) (w:will do out again/will in turn) (d:<khia>, out, <kik>, again or back, and <ding>, will, written as one word after a verb; mostly {tangko khiakikding}, will announce in turn, and {ciah khiakikding}, will go back out) (j:khia/kik/ding) (r:zd:13011/zd:11118) (q:draft)
khial = (i:1) (t:v) (f:everyday) (w:wrong/sin/do wrong/err) (d:do wrong or sin; with <tungah>, sin against someone) (s:mawh)
khial = (i:3) (t:adv) (f:everyday) (w:wrongly/mistakenly/by mistake) (d:placed after another verb to say that the act is done wrongly or misses its aim: {mu khial} is see wrongly, mistake, {bawl khial} is do wrongly, and {kitel khial} is be misunderstood) (r:zd:24337/zd:21815/zd:24046) (q:draft)
khialh = (i:2) (t:adv) (f:everyday) (w:wrongly/mistakenly/by mistake) (d:after a verb stem such as <muh>, <gen>, <theih>, <dawn> or <zat> it says that the action is done wrongly, like English mis-: {gen khialh} say wrongly, {theih khialh} be mistaken; not sin as such) (r:zd:24347/zd:15473/zd:24133) (q:draft)
khialhna = (i:2) (t:n) (f:everyday/work) (w:mistake/error/fault) (d:something said, written or done wrongly without meaning to, a mistake that is corrected or excused and that carries no thought of sin; {khialhna a om leh ngaidam} asks pardon for any mistake) (r:zd:21463/zd:24480/zd:23533) (q:draft)
khiallo = (i:1) (t:adj) (f:everyday) (w:not wrong/without error/unerring) (d:<khial>, be wrong, and <lo>, not, written as one word: not in the wrong, free of mistake) (j:khial/lo) (r:zd:23902/zd:21388) (q:draft)
khialna = (i:2) (t:n) (f:everyday) (w:mistake/error) (d:something done or said wrongly without moral guilt, such as a slip in speech, in writing or in understanding; {kitel khialna} is a misunderstanding) (r:zd:21075/zd:20297/zd:11215) (q:draft)
khialo = (i:1) (t:v) (f:everyday) (w:not out/not bring out) (d:<khia> and <lo> written as one word after a verb: the action of bringing or going out is not done; {pulak khialo} is not disclose, {pusuak khialo} is not go out) (j:khia/lo) (r:zd:11459/zd:25322/zd:19176) (q:draft)
khiamawk = (i:1) (t:adv) (f:everyday/media) (d:<khia>, out, and <mawk> written as one word after a verb: the act brings something out or into the open, and is sudden, unexpected or surprising, as in {pulak khiamawk}, came out and announced) (j:khia/mawk) (r:zd:22728/zd:19939) (q:draft)
khiamding = (i:1) (t:v) (f:everyday/work) (w:to reduce/will reduce/to be reduced) (d:<khiam>, reduce, and <ding> written as one word: is to be made less, in order to lower a price, a weight or a speed) (j:khiam/ding) (r:zd:14633/zd:13332) (q:draft)
khianailo = (i:1) (t:part) (f:everyday) (w:not yet out) (d:<khia> and <nailo> written as one word after a verb: has not yet done it outwardly, as in {pulak khianailo}, has not yet announced, and {asuak khianailo}, not yet born) (j:khia/nailo) (r:zd:16600/zd:13346/zd:11329) (q:draft)
khiangah = (i:1) (t:prep) (f:everyday) (j:kiangah) (r:zd:24174/zd:24310) (q:draft)
khiankhian = (i:2) (t:adv) (f:everyday/social) (w:quietly/softly/discreetly) (d:after a verb of speaking or asking such as <gen> or <dot>: in a low voice or without drawing attention, where nothing is moving about) (r:zd:21070/zd:20139/ts:11162) (q:draft)
khiap = (i:1) (t:v) (f:everyday/work) (w:reduce/cut/lower) (d:make less: cut a budget, lower a speed, reduce a penalty; form of <khiam> used before words such as <ding> and <theih>) (s:kiamsak) (r:zd:22747/zd:11590/zd:22157) (q:draft)
khiapah = (i:1) (t:adv) (f:everyday) (w:out at once/right away) (d:<khia>, out, and <pah>, at once, written as one word after a verb: the action is carried out immediately, as {kiman khiapah}, was caught right away, and {tangko khiapah}, announced at once) (j:khia/pah) (r:zd:12414/ts:5921) (q:draft)
khiapan = (i:1) (t:adv) (f:everyday/time) (w:only then/only now) (d:<khia>, out, and <pan>, here only then or just now, written as one word after a verb: the thing is made known, released or done only at that time; {pulak khiapan} is announce only now) (j:khia/pan) (r:zd:11764/zd:14507) (q:draft)
khiapna = (i:1) (t:n) (f:everyday/work) (w:reduction/cut/lowering) (d:<khiap>, reduce, with the noun ending {-na}: the making less of something, as in {man khiapna}, a discount) (b:khiap) (r:zd:19824/zd:21125) (q:draft)
khiata = (i:1) (t:adv) (f:media/everyday) (w:out/out now) (d:<khia>, out, with the particle <ta>, now or already, written as one word after a verb and common in headlines: {kiman khiata} is has now been caught) (j:khia/ta) (r:zd:15543/zd:24963) (q:draft)
khiatdan = (i:1) (t:n) (f:education/religion) (w:interpretation/way of interpreting) (d:<khiat>, interpret, with <dan>, way: the way a text or an event is interpreted or explained) (s:khiatna) (j:khiat/dan) (r:zd:21096/zd:20821) (q:draft)
khiatding = (i:1) (t:adv) (f:everyday) (w:out) (d:<khiat> out and <ding> written as one word after a verb: in order to do the action outward, as in {puak khiatding}, to carry out) (j:khiat/ding) (r:zd:25312/zd:22282) (q:draft)
khiatheilo = (i:1) (t:v) (f:everyday) (w:cannot get out/unable to bring out) (d:<khia>, out, and <theilo>, unable, written as one word after a verb: unable to do the thing outward, as {pusuak khiatheilo}, unable to get out, and {pulak khiatheilo}, cannot be made public) (j:khia/theilo) (r:zd:21164/zd:17407) (q:draft)
khiatkhit = (i:1) (t:adv) (f:everyday) (w:already out/after doing) (d:<khiat>, out, and <khit>, finished, written as one word after a verb: have done it, after having done it) (j:khiat/khit) (r:zd:19775/zd:17647) (q:draft)
khiatna = (i:3) (t:n) (f:everyday) (w:bringing out/release) (d:<khiat>, out, with the noun suffix <na>, placed after a verb to name the act of doing it outward, not a meaning: <bomb khiatna> is the dropping of bombs, {piak khiatna} is giving out, {pian khiatna} is coming into being) (r:zd:20945/zd:25214) (q:draft)
khiatna nei = (i:1) (t:v) (f:everyday/education) (w:mean/have a meaning/be meaningful) (d:<khiatna>, meaning, and <nei>, have: to have a meaning, to mean something, said of a word, a sign or an act; {bang khiatna nei} asks what something means and {khiatna nei lo} is meaningless) (r:zd:21102/zd:23079) (q:draft)
khiatsawm = (i:1) (t:v) (f:everyday) (w:try to take out/intend to get out) (d:<khiat>, out, and <sawm>, intend or try, written as one word after a verb: try or be about to do the action outward, as in {hot khiatsawm}, try to rescue) (j:khiat/sawm) (r:zd:11803/zd:13328) (q:draft)
khiattheih = (i:1) (t:v) (f:politics) (w:can be imprisoned/liable to be jailed) (d:<khiat>, put into, with <theih>, be able, written as one word, in {thong khiattheih}: can be put in prison) (j:khiat/theih) (r:zd:12094/zd:11568) (q:draft)
khiattheih = (i:2) (t:v) (f:everyday) (w:be able to do out) (d:after a verb, <khiat>, out, with <theih>, be able, written as one word: {hawm khiattheih nadingin} is so as to be able to give out) (j:khiat/theih) (r:zd:15475) (q:draft, low confidence)
khiatzawh = (i:1) (t:conj) (f:everyday/media) (w:after) (d:<khiat>, out, and <zawh>, finished, written as one word after a verb: after the action has been carried out, as {akipat khiatzawh}, after setting out, and {alen khiatzawh}, after taking off; compare <khitzawh>) (j:khiat/zawh) (r:zd:13348/zd:17450/zd:16897) (q:draft)
khiatzia = (i:1) (t:n) (f:education/religion) (w:interpretation/way of interpreting) (d:<khiat>, interpret, and <zia>, way, written as one word: the way a text or a word is explained or translated) (j:khiat/zia) (r:zd:25620/zd:9236) (q:draft)
khiatzia = (i:2) (t:n) (f:everyday) (d:after a verb, <khiat>, out, and <zia>, way: the way something comes out, begins or is brought out, as in {kipat khiatzia}, how it began) (j:khiat/zia) (r:zd:23129) (q:draft)
khiazo = (i:1) (t:v) (f:everyday) (w:be able to bring out/manage to get out) (d:<khia>, out, and <zo>, be able, written as one word after a verb: manage to do it fully, as give out, find out or get hold of) (j:khia/zo) (r:zd:19174/zd:11566) (q:draft, low confidence)
khil = (i:1) (t:v) (f:everyday) (w:string together/thread) (d:put things one after another on a string or in a row; {khil khop} is string together) (r:zd:25947/zd:17521) (q:draft, low confidence)
khil = (i:2) (t:n) (f:food/nature) (w:bunch/cluster/hand) (d:a number of things hanging together in a row, as a hand of bananas; {a khilkhil in} is in bunches) (r:ts:12519) (q:draft, low confidence)
khin = (i:1) (t:adv) (f:everyday/time) (w:already) (d:placed after a verb to show that the action is already done or complete) (s:khinta/khinzo) (a:nailo)
khinding = (i:1) (t:adv) (f:everyday/time) (w:must already/probably already) (d:<khin> and <ding> written as one word after a verb: the action is expected or believed to be already done, will have) (j:khin/ding) (r:zd:11099/zd:11362) (q:draft)
khinhi = (i:1) (t:adv) (f:everyday) (w:already) (d:<khin>, already, and the sentence-final <hi> written as one word after a verb: it has already happened, it is done) (j:khin/hi) (r:zd:17632/zd:15677/zd:21974) (q:draft)
khinkhai = (i:1) (t:v) (f:everyday/education) (w:weigh/consider/ponder/think over) (d:weigh a matter in the mind before believing, deciding or acting; {khinkhai huai} is worth thinking over and {khinkhai siamna} is the skill of judging well) (r:zd:24282/zd:23496/zd:22496) (q:draft)
khinkhaina = (i:1) (t:n) (f:everyday/education) (w:consideration/assessment/evaluation/analysis) (d:<khinkhai>, weigh, with the noun suffix <na>: the weighing up of a matter, an assessment) (b:khinkhai) (r:zd:17295/zd:24118) (q:draft)
khinkhat = (i:1) (t:phrase) (f:everyday) (w:one who has already) (d:<khin>, already, and <khat>, one, written as one word after a verb: a person who has already done or reached it, as in {kum 19 apha khinkhat}, one who has reached the age of 19) (j:khin/khat) (r:zd:19178/zd:17277) (q:draft)
khinkhian = (i:2) (t:adv) (f:everyday) (w:indeed/really/truly/quite) (d:after an adjective or a verb of feeling, often following <mahmah> or <sim>, stresses that something really is so; no silence or stillness is meant) (r:zd:23036/zd:11833/zd:23543) (q:draft)
khinlo = (i:1) (t:adv) (f:everyday) (w:not all/not entirely/not always) (d:<khin>, completely, and <lo>, not, written as one word after a verb or describing word: not all of them, not in every case) (j:khin/lo) (r:zd:15396/zd:25866/zd:11452) (q:draft)
khinto = (i:1) (t:v) (f:everyday/time) (w:move on/shift/postpone) (d:move on to another place, or move a set time or deadline to a later date; often as {ki khinto}, be moved) (r:zd:23252/zd:20912/ts:6014) (q:draft)
khit akipan = (i:1) (t:conj) (f:time) (w:ever since/from the time that) (d:<khit>, marker of a finished action, and <akipan>, beginning from: placed after a verb or after <tua>, since that happened, from then on; {tua khit akipan} is from then on) (r:ts:617/ts:9564) (q:draft)
khit nung = (i:1) (t:conj) (f:time) (w:after/since) (d:<khit>, finished, and <nung>, behind: placed after a verb, a date or <tua>, after it; also {khit nung ah}) (s:khitciang) (r:zd:16623/zd:20649/zd:10855) (q:draft)
khitang = (i:1) (t:n) (f:home) (w:bead/beads) (d:a small pierced ball strung on a thread, as in a necklace or a string of prayer beads; from <khi>, necklace, and <tang>, a grain) (r:zd:19803/ts:3375) (q:draft)
khitciang = (i:1) (t:conj) (f:time) (w:after) (d:<khit> and <ciang> written as one word: placed after a verb, a noun or <tua>, after that is done; the same as {khit ciangin}) (j:khit/ciang) (r:zd:19591/zd:23345) (q:draft)
khitciangin = (i:1) (t:conj) (f:everyday/time) (w:after) (d:<khit> and <ciangin> written as one word, placed after a verb or a length of time: after that has happened or passed) (j:khit/ciangin) (r:zd:21047/zd:20503/zd:17930) (q:draft)
khitdeuh = (i:1) (t:adv) (f:time) (w:shortly after/just after/a little past) (d:<khit>, after, with <deuh>, a little, written as one word: a little after an event or a time, as in {zankim khitdeuh}, just past midnight) (j:khit/deuh) (r:zd:12128/zd:20122/zd:16584) (q:draft)
khitkhawng = (i:1) (t:adv) (f:time) (w:after about/about ... later) (d:<khit>, after, with <khawng>, about, written as one word after a length of time and followed by <ciangin>: about that long afterwards) (j:khit/khawng) (r:zd:12304/zd:11819/zd:19609) (q:draft)
khitpawl = (i:1) (t:n) (f:time) (w:shortly after/some time after) (d:<khit>, after, and <pawl> written as one word, placed after a clock time: some time after that hour; compare <hunpawl>) (j:khit/pawl) (r:zd:11872/zd:14547) (q:draft)
khitteh = (i:1) (t:conj) (f:everyday/time) (w:after/afterwards) (d:<khit>, after, and <teh>, a spoken form of when, written as one word after a verb, a noun or <tua>: after that has happened, the same as {khit ciangin}) (j:khit/teh) (r:zd:16038/zd:23394) (q:draft)
Khitui Gospel = (i:1) (t:name) (f:religion/media) (w:Khitui Gospel) (d:<khitui>, tears, and <gospel>, gospel: name of a Zomi Christian gospel ministry, known for its films and relief work; stands before words such as {Team} and {Innkuan}, family) (r:zd:24393/zd:25251) (q:draft, low confidence)
khitui luang = (i:1) (t:v) (f:body/everyday) (w:shed tears/weep) (d:<khitui>, tears, and <luang>, flow: the tears flow, that is, to weep; the one who weeps stands before it as possessor, as in {a khitui luang hi}) (r:zd:23556/zd:25668/zd:15063) (q:draft)
khitui naptui = (i:1) (t:n) (f:body/everyday) (w:tears and snot/bitter weeping) (d:<khitui>, tears, and <naptui>, nasal mucus: a pair that pictures hard, unrestrained weeping; nearly always with <tawh>, as in {khitui naptui tawh thungen}, pray in floods of tears) (r:zd:23551/zd:25472/zd:15063) (q:draft)
khoih = (i:2) (t:v) (f:everyday/social) (w:move/touch/affect) (d:stir the feelings of a person, said with <lungsim>, heart, before {khoih}: {ka lungsim hong khoih hi}, it touched my heart) (r:zd:22815/zd:21848) (q:draft)
khoihkha = (i:1) (t:v) (f:everyday) (w:touch/affect/move) (d:<khoih>, touch, and <kha>, happen to, written as one word: touch someone, or touch and move the heart or life of a person) (j:khoih/kha) (r:zd:21593/zd:15467) (q:draft)
khoihkhoih = (i:1) (t:v) (f:everyday/it) (w:keep touching/fiddle with/handle) (d:<khoih>, touch, doubled: touch again and again, keep handling or fiddling with something, as a phone) (b:khoih) (r:zd:15571/zd:9432) (q:draft)
khokkhia = (i:1) (t:v) (f:food/everyday) (w:peel off/strip off) (d:take off the outer skin or bark of something, with <khia>, out or off; {singhawng khokkhia} is strip off the bark) (r:zd:20657/zd:23906) (q:draft)
khol = (i:3) (t:adv) (f:everyday) (w:beforehand/in advance/ahead) (d:after another verb, shows that the action is done ahead of time, as in {kiging khol} prepare in advance, {gen khol} tell beforehand and {thei khol lo} not know beforehand; not the verb store or save) (r:zd:25181/zd:20016/zd:24746) (q:draft)
kholhloh = (i:1) (t:adv) (f:everyday) (w:not beforehand/without doing in advance) (d:<kholh>, beforehand, and the negative <loh> written as one word, placed after a verb: not having done it in advance) (j:kholh/loh) (r:zd:19841) (q:draft)
kholhpih = (i:1) (t:v) (f:social) (w:associate with/keep company with/befriend) (d:spend time with someone as a companion; with the prefix <ki>, keep company with each other, as in <kikholh>) (s:kipawlpih) (r:zd:23191/zd:17599/zd:20771) (q:draft)
kholkei = (i:1) (t:adv) (f:everyday) (w:not really/not particularly/hardly) (d:placed after a verb or a describing word, like <khollo> with <kei> in place of <lo>: not particularly, not to any great degree) (s:khollo) (r:zd:18211/zd:18107) (q:draft)
kholkhol = (i:1) (t:adv) (f:time/everyday) (w:beforehand/in advance/ahead of time) (d:placed after a verb, the ending {-khol}, beforehand, said twice: the thing is seen, said or thought out before it happens, as {mu kholkhol}, see beforehand) (r:zd:21059/zd:21741) (q:draft, low confidence)
kholna = (i:2) (t:n) (f:everyday) (w:doing beforehand/forethought) (d:after a verb, <kholh>, beforehand, with the noun suffix <na>: the doing of something ahead of time, as {gen kholna}, a foretelling, and {lungngaih kholna}, thinking ahead; nothing is stored) (r:zd:23770/zd:15926) (q:draft, low confidence)
kholthei = (i:1) (t:v) (f:work) (w:be able to save/can save up) (d:<khol>, save, and <thei>, able, written as one word: be able to put money aside) (j:khol/thei) (r:zd:25928/zd:12728) (q:draft)
kholthei = (i:2) (t:v) (f:everyday) (w:be able to do beforehand/can do in advance) (d:<khol>, here beforehand, as in <kholh>, and <thei>, able, written as one word after a verb: {gen kholthei} is be able to say in advance and {ngaihsun kholthei} be able to think ahead) (j:khol/thei) (r:zd:21900) (q:draft, low confidence)
khomun = (i:1) (t:n) (f:food) (w:bread/loaf) (d:bread or a loaf of bread) (s:anlum/moh/tangho) (q:draft)
khong = (i:3) (t:part) (f:everyday) (w:and the like/or so/about) (d:another spelling of <khawng>, after a noun, a place or a number: that and things like it, or about that much, as {TV khong} and {Falam khong ah}) (r:zd:11463/zd:21271) (q:draft)
khong = (i:4) (t:adv) (f:everyday) (w:free/for nothing) (d:in {a khong in} before a verb of giving: without payment, as a free gift) (r:zd:23896) (q:draft, low confidence)
khopding = (i:1) (t:adv) (f:social) (w:to do together) (d:<khop> and <ding> written as one word after a verb: to do it together, as in {kipawl khopding}, to unite, and {nasep khopding}, to work together) (j:khop/ding) (r:zd:20337/zd:11018) (q:draft)
khopin = (i:1) (t:adv) (f:everyday) (d:<khop>, enough, with <in>, written as one word after a verb or after <zah>: to the point that, so much that) (j:khop/in) (r:zd:20582/zd:24375) (q:draft, low confidence)
khopna nei = (i:1) (t:v) (f:social/religion) (w:hold a joint/do together) (d:<khopna>, the doing of something together, with <nei>, have: placed after a verb, hold a joint session of that action, as {kimuh khopna nei}, hold a meeting, and {thunget khopna nei}, hold a prayer meeting) (r:zd:14801/zd:20874/zd:13020) (q:draft)
khopnate = (i:1) (t:n) (f:social) (w:joint efforts) (d:plural of <khopna>, doing together, placed after a verb; in the articles only in {pan khopnate}, the things done side by side, joint efforts) (b:khopna) (r:zd:22786) (q:draft, low confidence)
khoppi = (i:1) (t:n) (f:religion/social) (w:conference/convention/assembly) (d:<khop>, gather, with the augmentative {-pi}: a large gathering of a church body or organisation; {ki khoppi} is hold such a gathering) (s:khawmpi) (r:zd:25157/zd:25565) (q:draft, low confidence)
Khris = (i:1) (t:name) (f:religion) (j:Khrih) (r:zd:21547/zd:21180) (q:draft)
Khrismas = (i:1) (t:name) (f:religion/time) (j:Christmas) (r:zd:25467) (q:draft)
Khrist = (i:1) (t:name) (f:religion) (j:Khrih) (r:ts:11794/zd:24963) (q:draft)
khristian nuntakna = (i:1) (t:n) (f:religion) (w:Christian life/the Christian walk) (d:<Khristian>, Christian, with <nuntakna>, life: the life a believer leads as a follower of Christ; often after a possessive such as <i> or <na>) (r:zd:24954/zd:21140) (q:draft)
khu = (i:3) (t:v) (f:everyday/home) (w:wear/put on) (d:put on or wear something on the head, such as a hat, crown or helmet) (q:draft)
khua = (i:4) (t:n) (f:time/nature) (w:seasonal/season) (d:the weather or time of year, in {khua hun}, season)
khua = (i:3) (t:n) (f:social/travel) (w:village) (d:a village or small settlement, often said with <neu>, small, or <no>, little) (s:khuaneu)
khua = (i:2) (t:n) (f:social/travel) (w:city/town) (d:a town or city, a place where many people live together; {khua sung} is inside the town and {khua mite} are its people) (s:khuapi)
Khua Kipawlna = (i:1) (t:n) (f:social) (w:village association/hometown association) (d:<khua>, village, and <kipawlna>, association: the association of the people who come from one village, formed where they now live; the name of the village stands before it) (r:zd:23629/zd:23538) (q:draft)
khua makai = (i:1) (t:n) (f:social) (w:village leader/community leader) (d:<khua>, village or town, and <makai>, leader: a leader of a village, and among Zomi abroad a leader of the people who come from one home village) (r:zd:23171/zd:20968) (q:draft)
khuaah = (i:1) (t:adv) (f:social/travel) (w:in the village/to the village/in the town) (d:<khua> and <ah> written as one word: in or to the village or town; after a name, in the village of that name) (j:khua/ah) (r:zd:24029/zd:22827) (q:draft)
khuabup = (i:1) (t:n) (f:social) (w:the whole town/the whole village) (d:<khua>, town or village, with <bup>, whole: all of a town or village and all its people) (r:zd:12487/zd:22935/zd:19086) (q:draft)
Khuado = (i:1) (t:name) (f:social/time) (w:Khuado) (d:the traditional harvest and new year festival of the Zomi, kept after the harvest around October; often {Khuado pawi}, the Khuado festival, with <pawi>) (r:zd:23394/zd:26708/zd:15794) (q:draft)
khuado pawipi = (i:1) (t:n) (f:social/time) (w:Khuado festival/Khuado feast) (d:<Khuado>, the harvest and new year festival of the Zomi, and <pawipi>, great feast: the Khuado festival as a public celebration, the usual name of the event held by Zomi communities; a place name may stand before it) (r:zd:23394/zd:16037) (q:draft)
Khuadopawi = (i:1) (t:name) (f:social) (w:Khuado festival) (d:the Khuado, the traditional festival of the Zomi kept after the harvest, with <pawi>, festival; also written {Khuado pawi}) (r:zd:23770/zd:21282) (q:draft)
khuageinai = (i:1) (t:phrase) (f:travel/media) (w:near the town/vicinity of the town) (d:<khua>, town, and <geinai>, near, written as one word, placed after the name of a town: the area near that town) (j:khua/geinai) (r:zd:19414/zd:17252) (q:draft)
khuah = (i:1) (t:v) (f:health/home) (w:rinse/rinse out/flush) (d:wash the inside of something with water, as the mouth or a tank; {kam khuah} is rinse the mouth) (r:zd:24276/zd:19363/zd:17295) (q:draft)
khuahun luanzia = (i:1) (t:n) (f:social/politics) (w:trend of the times/course of events/current situation) (d:<khuahun>, the state of things, with <luanzia>, the way something flows: the way the times are moving, the present trend or situation; {leitung khuahun luanzia} is world trends, and {khuahun luanzia zui in} is in keeping with the situation) (r:zd:24765/zd:24573/zd:23992) (q:draft)
khuahun sia = (i:1) (t:n) (f:nature) (w:bad weather/foul weather) (d:<khuahun>, weather, and <sia>, bad: bad weather, also said of a climate that is getting worse; used as a noun or as a statement, {khuahun sia mahmah} is the weather is very bad) (r:zd:25505/zd:14983) (q:draft)
khuahun siatna = (i:1) (t:n) (f:nature) (w:bad weather/storm/natural disaster) (d:<khuahun>, here the weather, and <siatna>, ruin: bad weather or a disaster brought by weather, such as a storm or flood; often followed by <hangin>, because of) (r:zd:12811/zd:19109/zd:12530) (q:draft)
khuahunsia = (i:1) (t:n) (f:nature) (w:bad weather/bad times) (d:<khuahun>, weather or condition, with <sia>, bad: bad weather, and so a bad time) (j:khuahun/sia) (r:zd:25292) (q:draft, low confidence)
khuailak = (i:1) (t:n) (f:social/nature) (w:taking of the bees' nest/bee nest taking) (d:<khuai>, bee, with <lak>, take: the taking of a nest of bees at the <Khuado> festival, when the comb is examined to foretell the coming year) (j:khuai/lak) (r:zd:15772/zd:21141) (q:draft)
khuaimei = (i:1) (t:n) (f:home) (w:candle) (d:a wax candle, <khuai>, bee, with <mei>, fire or light) (r:zd:24748/zd:25224/zd:15996) (q:draft)
khuainote = (i:1) (t:n) (f:nature) (w:young bees/bee brood) (d:<khuai>, bee, with <no>, young, and the plural ending <te>: the young of the bees in the comb) (r:zd:15996/zd:15772) (q:draft, low confidence)
khuak = (i:2) (t:n) (f:body/health) (w:brain/mind/intellect) (d:the brain inside the head, and the power to think and remember that goes with it, as in {khuak hoih}, a good brain; a noun, not the verb hew) (r:zd:21388/zd:24276/zd:11452) (q:draft)
khuakbu = (i:1) (t:n) (f:body) (w:brain/mind) (d:the brain, as an organ of the body and as the seat of thinking and memory) (r:zd:24276/zd:21616/zd:21529) (q:draft)
khuakhal = (i:1) (t:n) (f:time/nature) (w:summer) (d:the hot, dry season of the year) (s:khualkhal) (a:phalbi) (q:draft)
khuakhalhun = (i:1) (t:n) (f:time/nature) (w:summer/summer time/dry season) (d:<khuakhal>, summer, and <hun>, time, written as one word: the hot, dry season) (j:khuakhal/hun) (r:zd:17806/zd:19410) (q:draft)
khuakhat = (i:1) (t:n) (f:social/travel) (w:one village/one town/a village) (d:<khua> and <khat> written as one word: one village or town, a single town, a whole village) (j:khua/khat) (r:zd:17437/zd:17864/zd:25569) (q:draft)
khuakhung = (i:1) (t:n) (f:nature/travel) (w:upper end of the village/head of the village) (d:<khua>, village, with <khung>, the upper end: the upper side of a village and the ground next to it; after a village name, the upper end of that village) (r:zd:25477/zd:14824/zd:11409) (q:draft, low confidence)
khuakim = (i:1) (t:n) (f:social/travel) (w:surrounding villages/area around a village/neighbourhood) (d:<khua>, village or town, with <kim>, the area around: the country and villages round about a place; {khuakim khuapam} is the neighbouring villages) (r:zd:14765/ts:6741/zd:19168) (q:draft)
khuaksung = (i:1) (t:n) (f:body/health) (w:brain/inside of the brain) (d:<khuak>, here brain, and <sung>, inside, written as one word: the inside of the brain, the brain as the place of thought and of illness; {khuaksung nasepna} is the working of the brain) (j:khuak/sung) (r:zd:24082/zd:20433) (q:draft)
khual = (i:2) (t:v) (f:social) (w:care for/be considerate of/be concerned for) (d:think of another person with concern and kindness, often beside <hehpih>, pity, or <vei>, feel for; used without <zin>, unlike the sense journey) (r:zd:19581/zd:14930/zd:26967) (q:draft)
khualai = (i:1) (t:n) (f:travel/social) (w:town centre/centre of the village/downtown) (d:<khua>, town or village, with <lai>, here the middle: the central part of a town or village; also the name of a central ward, as {Khualai veng} in Tedim) (r:zd:25477/zd:23957) (q:draft)
khualaizang = (i:1) (t:n) (f:travel/social) (w:town centre/city centre/downtown) (d:<khua>, town, and <laizang>, middle, written as one word: the central part of a town or city) (j:khua/laizang) (r:zd:11839/zd:19936) (q:draft)
khualak = (i:1) (t:n) (f:social/travel) (w:out in town/the streets/public places) (d:<khua>, town, and <lak>, midst, written as one word: out among the houses and people of a town, away from home; {khualak vak} is go about the town) (j:khua/lak) (r:zd:25068/zd:19571) (q:draft, low confidence)
khualam = (i:1) (t:n) (f:travel) (w:direction of the town/way to the town) (d:<khua>, town, and <lam>, direction, written as one word after the name of a town: toward that town; {Ipoh khualam zuanin} is heading for Ipoh) (j:khua/lam) (r:zd:12837/zd:16815) (q:draft)
khualam = (i:2) (t:n) (f:social/travel) (w:home village/countryside/the villages) (d:<khua>, village, and <lam>, side, written as one word: the home village, or the villages as against the town; {khualam ah ciah} is go back home to the village) (j:khua/lam) (r:zd:20545/zd:14760/zd:18241) (q:draft)
khualehtui = (i:1) (t:n) (f:social/politics) (w:homeland/community/native place) (d:<khua>, <leh> and <tui>, village and water, written as one word: one's home village and community, the common good of one's people) (j:khua/leh/tui) (r:zd:24022/zd:14604) (q:draft, low confidence)
khualin = (i:1) (t:v) (f:everyday/social) (w:consider/think of/have regard for) (d:<khual> in the sense of caring about or taking into account, with <in>: thinking of, for the sake of, as one’s future, children or people) (j:khual/in) (r:zd:17021/zd:24072/zd:24320) (q:draft)
khuallo = (i:1) (t:v) (f:social) (w:disregard/not care about/be inconsiderate of) (d:<khual> in the sense have regard for, care about, with the negative <lo>, written as one word: without regard for, not considering) (j:khual/lo) (r:zd:12269/zd:12736/zd:17335) (q:draft)
khualui = (i:1) (t:n) (f:social/family) (w:home village/ancestral village/old town) (d:<khua>, village, with <lui>, old: the village a person or family originally comes from; of a city, its old part) (r:zd:16337/zd:25429/ts:2753) (q:draft)
khualum = (i:2) (t:n) (f:nature/health) (w:heat/hot weather) (d:hot weather as a condition of a season or a place, and as something a person suffers from; {khualum thuaklah} is be overcome by the heat, {khualum hun} the hot season and {khualum gam} a hot country) (r:zd:20518/zd:22650/zd:20953) (q:draft)
khualumna = (i:1) (t:n) (f:nature) (w:warmth/heat/temperature) (d:warm or hot weather, and how warm it is; {khualumna mun} is a place with a warm climate) (b:khualum) (r:zd:23240/zd:20518/zd:20747) (q:draft)
khualzin gamvak = (i:1) (t:n) (f:travel) (w:travel/tourism/travelling about) (d:<khualzin>, go on a journey, paired with <gamvak>, go about the country: travelling and going about, travel for pleasure, used for the English word tourism; also as a verb, travel about) (r:zd:17649/zd:11401) (q:draft)
khualzinding = (i:1) (t:v) (f:travel) (w:will travel/to travel/about to travel) (d:<khualzin> and <ding> written as one word: will travel, is to travel; before a noun, those who are to travel, and with <in>, in order to travel) (j:khualzin/ding) (r:zd:14498/zd:12274/zd:15031) (q:draft)
khualzinmi = (i:1) (t:n) (f:travel) (w:traveller/tourist/passenger) (d:<khualzin>, travel, with <mi>, person: a person on a journey; {gamdang khualzinmi} is a foreign tourist) (b:khualzin) (r:zd:13149/zd:16595) (q:draft)
khualzitna = (i:1) (t:n) (f:travel) (j:khualzinna) (r:zd:23014/zd:23394) (q:draft)
khualzo = (i:1) (t:v) (f:social) (w:be able to consider/care about/spare a thought for) (d:<khual>, here have regard for, with <zo>, be able: manage to think of or care for someone or something; mostly negative, {khualzo lo}, no longer care about) (j:khual/zo) (r:zd:24035/zd:25573) (q:draft)
Khuamakai = (i:1) (t:n) (f:social) (j:khua makai) (r:zd:20782/zd:20033) (q:draft)
khuambulpi = (i:1) (t:n) (f:home/social) (w:main pillar/foundation/mainstay) (d:<khuam>, pillar, with <bulpi>, base: the chief post that holds a building up, and so the thing on which all else rests) (r:zd:20917/zd:21876) (q:draft)
khuaminthang = (i:1) (t:n) (f:travel) (w:famous city/well-known town) (d:<khua>, town or city, and <minthang>, famous, written as one word) (j:khua/minthang) (r:zd:11438/zd:17711) (q:draft)
khuamiten = (i:1) (t:phrase) (f:social/media) (w:townspeople/villagers/local residents) (d:<khuamite>, the people of a town or village, with <in> shortened to {-n}, which marks them as the ones who act; {khuamiten gen hi} is the townspeople said) (j:khuamite/in) (r:ts:5605/ts:9564/ts:2256) (q:draft)
khuamual = (i:1) (t:n) (f:social/travel) (w:village entrance/edge of the village) (d:<khua>, village, with <mual>, hill: the rise at the edge of a village or town where the road comes in, where travellers are met and seen off and memorials are set up) (r:ts:301) (q:draft, low confidence)
khuamuhna = (i:1) (t:n) (f:social/everyday) (w:vision/outlook/foresight/eyesight) (d:<khuamuh>, see, with <na>: the power to see, and more often the way a person or a people sees things and looks ahead; {khuamuhna tom} is short-sighted) (b:khuamuh) (r:zd:24276/zd:24069/zd:16640) (q:draft)
khuaneu = (i:1) (t:n) (f:social/travel) (w:village/small town) (d:<khua>, town, and <neu>, small; set against <khuapi>, city) (a:khuapi) (q:draft)
khuaneu khuata = (i:1) (t:n) (f:social/travel) (w:villages/countryside/rural places) (d:<khuaneu>, small town, and <khuata>, village, said as a pair: the villages and hamlets taken together, the countryside as against the city; mostly followed by the plural <te> and a place marker) (r:zd:20784/zd:14648) (q:draft)
khuang = (i:3) (t:v) (f:nature) (w:chirp/sing) (d:of a cicada, make its loud ringing call; said of the insect as {khuang} is said of a rooster crowing) (r:zd:19242) (q:draft, low confidence)
khuangai = (i:1) (t:v) (f:social/family) (w:feel lonely/long for/miss) (d:feel lonely and full of longing for someone who is gone or far away; mostly in the pair {lungleng khuangai}, said of those who mourn) (r:zd:12371/zd:22849) (q:draft)
khuangai = (i:2) (t:v) (f:everyday) (w:be mindful/be thoughtful) (d:think about what is around one and take care; in the saying {Buipi leikei in zong khuangai}, even the bamboo rat digging the earth is mindful) (r:zd:21624) (q:draft, low confidence)
khuangaih = (i:1) (t:v) (f:social/everyday) (w:grieve/feel sorrow/feel lonely/pine) (d:feel sad, lonely or full of longing; often paired with <lungzuan> or <lunglen>; {khuangaih huai} is sad, pitiful, and {ki khuangaih} is feel for one another) (r:zd:20646/zd:26097/zd:16989) (q:draft, low confidence)
khuangaihna = (i:1) (t:n) (f:social/family) (w:longing/sorrow/pining/grief) (d:the sad longing for a person who is absent or dead, or for home; often in the pair {lungzuan khuangaihna}, and beside <dahna>, grief) (r:zd:19975/zd:22492) (q:draft)
Khuangnung = (i:1) (t:name) (c:khua) (f:travel/social) (w:Khuangnung) (d:old village of the Tedim area, said to have existed before Tedim was founded, whose chiefs once ruled the places around it) (r:zd:23767/zd:17053) (q:draft)
khuanih = (i:1) (t:phrase) (f:travel/social) (w:two towns/two villages) (d:<khua>, town or village, and <nih>, two, written as one word: the two towns, mostly in {khuanih kikal}, between the two towns) (j:khua/nih) (r:zd:17822/zd:17250) (q:draft)
khuano = (i:1) (t:n) (f:social/travel) (w:village/small village/hamlet) (d:<khua>, village, with the ending {-no}, little: a small village, set against <khuapi>, town; Khuano is also the name of a Zomi group and its speech) (s:khuaneu) (b:khua) (r:zd:22550/zd:25165/zd:16900) (q:draft)
khuanote = (i:1) (t:n) (f:social/travel) (w:villages/small villages/hamlets) (d:<khua>, village, with <no>, small, and the plural <te>: the small villages, often those around a town) (b:khua) (r:ts:7044/zd:23394) (q:draft)
khuanu = (i:1) (t:n) (f:social/politics) (w:town elder/community leader) (d:<khua>, town, with <nu>, mother: used in the pair {khuanu khuapa}, town mothers and town fathers, the elders and respected people who speak for a town) (r:zd:11101/zd:11358) (q:draft)
khuanung = (i:1) (t:n) (f:time/everyday) (w:afterwards/hindsight/later time) (d:the time after something has happened; {khuanung pil} is be wise afterwards, in hindsight, and {a khuanung ah} is afterwards) (r:zd:24236/zd:21822/zd:22780) (q:draft)
khuapa = (i:1) (t:n) (f:social) (w:town elder/community elder) (d:<khua> town with <pa> father: a senior man of a town or ward; nearly always in the pair {khuanu khuapa}, the elders or respected residents of a town) (r:zd:16058/zd:11176/zd:24234) (q:draft)
khuapaam = (i:1) (t:n) (f:social/travel) (w:neighbouring villages/surrounding area) (d:<khua>, town, with <paam>, surroundings: the villages around a town, used in the pair {khuakiim khuapaam}, the whole country round) (j:khua/paam) (r:zd:17339/zd:21690) (q:draft)
khuapam = (i:1) (t:n) (f:social/travel) (w:outskirts of a village/surrounding area) (d:<khua>, village or town, and <pam>, the side or edge, written as one word; used in the pair {khuakim khuapam}, the neighbouring villages all around, see <khuakim>) (j:khua/pam) (r:zd:14765/ts:3168) (q:draft)
khuapan = (i:1) (t:adv) (f:travel/social) (w:from the town/from the village) (d:<khua> and <pan> written as one word: from the town or village named before it, said of where a person comes from or a journey starts) (j:khua/pan) (r:zd:11936/zd:16346) (q:draft)
khuapate = (i:1) (t:n) (f:social) (w:townsmen/men of the town) (d:<khuapa>, a man of the town, with the plural <te>; {khuanu khuapate} is the women and men of a town, a way of addressing all the townspeople) (b:khuapa) (r:zd:24563/zd:11176) (q:draft)
khuapen = (i:1) (t:phrase) (f:travel/social) (w:the town/the village) (d:<khua> and the topic marker <pen> written as one word, after the name of a town or after <hih>: marks the town or village as what the sentence is about) (j:khua/pen) (r:zd:13220/zd:11639) (q:draft)
khuaphawk = (i:2) (t:v) (f:health) (w:be conscious/come to/regain consciousness) (d:be awake and aware in the body, of a sick or injured person; {khuaphawk nawnlo} is unconscious and {khuaphawk kik} is come round again) (r:zd:21869/zd:18028/zd:15641) (q:draft)
khuaphawklo = (i:1) (t:adj) (f:health) (w:unconscious/unaware/senseless) (d:<khuaphawk>, be aware, and <lo>, not, written as one word: without consciousness after a fall, a bite or an illness; also not noticing what happens around) (j:khuaphawk/lo) (r:zd:18154/zd:12619/zd:15307) (q:draft)
khuaphawkna = (i:1) (t:n) (f:social/education) (w:awareness/consciousness/realisation) (d:<khuaphawk>, be aware, with the noun suffix <na>: being aware, the inner realising of how things truly are; one article gives the English conscious for it and names it beside <khuatheihna>) (b:khuaphawk) (r:zd:25063) (q:draft)
khuaphelep = (i:1) (t:n) (f:nature) (j:khuaphialep) (r:zd:22658) (q:draft)
khuaphelep = (i:2) (t:n) (f:home/it) (w:electricity/electric power) (d:electric power; mostly as {khuaphelep mei}, electric light or electricity supplied to a village) (r:zd:22818/zd:23896) (q:draft)
khuapi = (i:1) (t:n) (f:social/travel) (w:city/town) (d:a large town, <khua>, town, with <pi>, great) (a:khuaneu) (r:1.4.17)
khuapi = (i:3) (t:n) (f:politics/travel) (w:capital/capital city) (d:the chief city of a country or people, said with a possessive before it, as in {a khuapi}, its capital; apart from that it is any large town) (r:ts:3992/ts:4885) (q:draft, low confidence)
khuapi laizang = (i:1) (t:n) (f:travel/everyday) (w:city centre/downtown/heart of the city) (d:<khuapi>, city, and <laizang>, midst: the centre of a city or town; the name of the city stands before it and <ah> after it to say in the centre of) (r:zd:25221/zd:12728) (q:draft)
khuapibup = (i:1) (t:n) (f:social/politics) (w:the whole city/the whole town) (d:<khuapi>, town or city, with <bup>, whole: all of a town) (j:khuapi/bup) (r:ts:3855/ts:9489) (q:draft)
khuapih tuipih = (i:1) (t:n) (f:social) (w:fellow townspeople/people of one's home town/home community) (d:<khuapih>, fellow townsman, paired with a second member formed in the same way from <tui>, water, one who shares the same water: the people of one's own town or village taken together, a paired expression of the same kind as {khua leh tui}; listed with relatives and friends in thanks and condolences, and a place name may stand before it) (r:zd:26708/zd:21170) (q:draft)
khuapua = (i:1) (t:n) (f:travel/social) (w:outside the town/outskirts/out of town) (d:<khua>, town, and <pua>, outside, written as one word: the area outside a town or village, often paired with <khuasung>) (a:khuasung) (j:khua/pua) (r:zd:24049/zd:21853) (q:draft)
khuapualam = (i:1) (t:n) (f:travel/social) (w:outskirts/edge of town/suburb) (d:<khua>, town, with <pualam>, outside: the area just outside a town or city, after the name of the town) (j:khua/pualam) (r:zd:14679/zd:17147/zd:12130) (q:draft)
khuasa = (i:1) (t:v) (f:everyday/social) (w:live/lead one's life/dwell) (d:live one's daily life in a place or in a certain way; often paired with <nungta>, be alive) (r:zd:24029/zd:11994/zd:16340) (q:draft)
khuasa = (i:2) (t:n) (f:nature) (w:hot weather/heat) (d:<khua>, weather, with <sa>, hot: hot weather, the opposite of <khuavot>) (a:khuavot) (r:zd:24054) (q:draft, low confidence)
khuasakna = (i:1) (t:n) (f:social/everyday) (w:living/way of life/daily life) (d:the way people live from day to day, the noun of <khuasa> with <na>; mostly in the pair <nuntak khuasakna>, life and living, living conditions) (r:zd:21717/zd:21886/zd:22262) (q:draft)
khuasakzia = (i:1) (t:n) (f:social/everyday) (w:way of life/living conditions/lifestyle) (d:the way a person or a community lives, most often in the pair <nuntak khuasakzia>) (s:nuntakzia) (r:zd:19462/zd:15720/zd:16254) (q:draft)
khuasat = (i:1) (t:v) (f:social) (w:found a village/establish a settlement) (d:<khua>, village, and <sat>, found, written as one word: found a new village; also the founder of a village, as in {khuasatte}, the founders) (j:khua/sat) (r:ts:6443/zd:24496/zd:24029) (q:draft)
khuasate = (i:1) (t:n) (f:social/everyday) (w:those who live) (d:<khuasa>, live one's life, with the plural <te>, after <a>: those who lead their life in a certain way) (b:khuasa) (r:zd:22922) (q:draft)
khuasiam = (i:1) (t:n) (f:religion) (w:good spirit/guardian spirit) (d:in the old Zomi religion the unseen good spirit or spirits of a village, asked for blessing on crops and people and welcomed at the Khuado feast; set against <khuazing>, the darkness, as the name of the evil spirit) (r:ts:479) (q:draft)
khuasik = (i:1) (t:n) (f:health) (w:fever/chills/ague) (d:illness with shivering and fever, named among the signs of flu and similar diseases; {khuasik mul} is gooseflesh) (r:zd:24054/zd:19846) (q:draft, low confidence)
khuasuah = (i:1) (t:v) (f:family/social) (w:provide for/support/bring up) (d:look after people so that they can get on in life, as a mother her children or a leader the young; {ki khuasuah} seems to be manage for oneself) (r:zd:24123/zd:23591) (q:draft, low confidence)
khuasuak = (i:1) (t:v) (f:social/work) (w:succeed/get on in life/prosper) (d:come to something in life, be successful; {mi khuasuak} is a successful person and {khuasuak zolo} is fail to get on) (r:zd:21340/zd:20971/zd:23591) (q:draft)
khuasuak = (i:2) (t:n) (f:social) (w:native) (d:after the name of a village or town: a person born in that place) (r:zd:12290) (q:draft, low confidence)
khuasung kikawmna = (i:1) (t:n) (f:travel) (w:city transport/public transport/urban transport) (d:<khuasung>, inside the town, and <kikawmna>, transport and communication: the public transport of a city, its buses and other services; the name of the city often stands before it) (r:zd:16421/zd:17607) (q:draft)
khuasung mipi = (i:1) (t:n) (f:social/media) (w:townspeople/local residents/the public) (d:<khuasung>, the inside of a town, and <mipi>, the public: the people who live in the town or neighbourhood where something happens, the locals, as against the police or the authorities; usually followed by the plural <te>; one such person is a <khuami>) (r:zd:20663/zd:15481/zd:12450) (q:draft)
khuasungah = (i:1) (t:adv) (f:social/travel) (w:in the town/in the village) (d:<khuasung> and <ah> written as one word: in the town or village, inside the town) (j:khuasung/ah) (r:zd:17335/ts:301/zd:15834) (q:draft)
khuasungmi = (i:1) (t:n) (f:social/politics) (w:civilian/townspeople/resident) (d:<khuasung> and <mi> written as one word: the people who live in a town or village; in news of fighting, civilians as opposed to soldiers) (j:khuasung/mi) (r:zd:11936/zd:13125/zd:12029) (q:draft)
khuasungteng = (i:1) (t:n) (f:travel/social) (w:the whole town/throughout the city) (d:<khuasung>, the inside of a town, and <teng>, here meaning all, written as one word, mostly after the name of a city: all of the town, everywhere in it) (j:khuasung/teng) (r:zd:17241/zd:12856) (q:draft)
khuasungvak = (i:1) (t:v) (f:travel/everyday) (w:walk about town/go about in public) (d:go about in the streets of a town, from <khuasung> and <vak>, walk about; {khuasungvak te} are the people out in the street, passers-by or pedestrians) (r:zd:15604/zd:20129/zd:11527) (q:draft)
khuata = (i:1) (t:n) (f:social/travel) (w:village/countryside) (d:a village, the villages of the countryside as against the town; often paired as <khuaneu khuata>, and {khuata mi} is a villager, a countryman) (s:khuaneu) (r:zd:17339/zd:20784/zd:25477) (q:draft)
khuatate = (i:1) (t:n) (f:social/travel) (w:villages/country villages) (d:<khuata>, village, and the plural <te>, written as one word: the villages of the countryside) (b:khuata) (j:khuata/te) (r:zd:14734) (q:draft, low confidence)
khuataw = (i:1) (t:n) (f:travel/social) (w:lower end of the village/foot of the village) (d:the lower end of a village and the land just below it, from <khua>, village, and <taw>, bottom; after a village name, below that village; the upper end is {khualu}) (r:zd:17939/zd:15996/zd:15992) (q:draft)
khuathak = (i:1) (t:n) (f:social/travel) (w:new village/new settlement) (d:<khua>, village, and <thak>, new, written as one word: a newly founded village; also part of village names) (j:khua/thak) (r:ts:3375/zd:19335/zd:20315) (q:draft)
khuatual = (i:1) (t:n) (f:social) (w:village/local community/home village) (d:<khua>, village, with <tual>, local: one's own village and its community; also the open place of a village where its worship was held) (r:zd:24160/zd:25094) (q:draft, low confidence)
khuavaak = (i:1) (t:n) (f:nature/time) (j:khuavak) (r:zd:20410/zd:24347) (q:draft)
khuavak = (i:2) (t:n) (f:time) (w:daybreak/dawn) (d:the time when it gets light in the morning, not light itself; after <zingsang>, morning, or before <ma>, before, <dong>, until, and <ciangin>, when) (r:zd:22773/zd:19826/zd:15880) (q:draft)
khuavannuai = (i:1) (t:n) (f:nature/politics) (w:universe/whole world) (d:all that is under the sky, the universe or the whole world; {Mihing Hamphatnate Khuavannuai Tangkona} is the Universal Declaration of Human Rights, where it stands for universal) (r:zd:23670/zd:20418) (q:draft)
khuaveengte = (i:1) (t:n) (f:social) (w:neighbouring village/neighbouring villagers) (d:<khua>, village, and <veengte>, neighbours, written as one word: the village or villages next to one’s own and their people) (j:khua/veengte) (r:zd:20176) (q:draft, low confidence)
khuazaang = (i:1) (t:n) (f:social) (j:khuazang) (r:zd:20936/zd:19396) (q:draft)
khuazaangin = (i:1) (t:n) (f:social) (j:khuazangin) (r:zd:15996/zd:15998) (q:draft)
khuazangbup = (i:1) (t:n) (f:social) (w:whole village/whole town) (d:<khuazang>, the whole town, with <bup>, entire, written as one word: all the people of a village or town together) (j:khuazang/bup) (r:zd:15805/zd:23129/zd:17939) (q:draft)
khuazong = (i:1) (t:phrase) (f:nature/time) (w:the weather also/the daylight also) (d:<khua>, the weather or the light of day, and <zong>, also, written as one word, as in {khuazong vot} the weather too is cold and {khuazong vak} it is also light) (j:khua/zong) (r:zd:26097/zd:15194) (q:draft)
khuazong = (i:2) (t:phrase) (f:social/travel) (w:the village also/the town also) (d:<khua>, village or town, and <zong>, also, written as one word after a place name: that town as well) (j:khua/zong) (r:zd:23822) (q:draft)
khuh = (i:3) (t:v) (f:health) (w:cough) (d:force air from the chest with a sudden sound, and as a noun a cough, as in {khuh natna}, a coughing illness; told from {khuh} cover by the talk of illness, nose and mouth) (s:bukkhuh) (r:zd:23512/zd:17838/zd:23727) (q:draft)
khui = (i:2) (t:n) (f:media) (w:album/music album) (d:a set of songs or music videos released together for sale, as in {la khui}, a song album, {khui thak}, a new album, and {khui bawl}, make an album; not the verb sew) (s:Album) (r:zd:11587/zd:18234/zd:12342) (q:draft)
khuisak = (i:1) (t:v) (f:health) (w:stitch up/have stitched/suture) (d:<khui> and <sak> written as one word: sew up a wound, or have it sewn up by a doctor) (j:khui/sak) (r:zd:12725/zd:17123) (q:draft)
khuitui = (i:1) (t:n) (f:body) (j:khitui) (r:zd:22556/zd:19556) (q:draft, low confidence)
khuk = (i:2) (t:n) (f:nature/work) (w:pit/hole/well/mine) (d:a deep hole in the ground, not the knee; the word before it says what kind: {tui khuk} is a well, {han khuk} a grave, {namgimtui khuk} an oil well, {suangmeihol khuk} a coal mine and {hell khuk} the pit of hell) (r:zd:23792/zd:19383/zd:17355) (q:draft)
khukdinsuk = (i:1) (t:v) (f:body/religion) (w:kneel down/fall on one's knees) (d:<khukdin> and <suk> written as one word: go down on the knees) (j:khukdin/suk) (r:zd:15051/zd:16885) (q:draft)
khukna = (i:1) (t:n) (f:health) (w:knee pain) (d:<khuk>, knee, with a word for ache: pain in the knee) (r:zd:24276) (q:draft, low confidence)
khum = (i:1) (t:adj) (f:food/everyday) (w:sweet/pleasant) (d:sweet in taste; of speech pleasant or smooth, as in {kam khum}, sweet words) (q:draft)
khum = (i:4) (t:v) (f:media) (w:record) (d:put songs on tape or disc, with <lakhui>, <la> or album before it: record a song or an album) (r:zd:9229/zd:21070) (q:draft)
khumcipna = (i:1) (t:n) (f:politics/social) (w:confinement/detention/custody) (d:<khumcip>, shut in, with the noun ending <na>: the keeping of a person shut in, detention or imprisonment) (b:khumcip) (r:zd:9124/zd:9125) (q:draft)
Khumi = (i:1) (t:name) (c:people) (f:social) (w:Khumi) (d:a Chin people of the Paletwa area in southern Chin State, and their language) (r:zd:22833/zd:24595) (q:draft)
khumlo = (i:1) (t:v) (f:everyday) (w:not put in/not score/not enter) (d:<khum>, put in, and <lo>, not, written as one word: fail to put in, as a goal in football, or not enter in a list) (j:khum/lo) (r:zd:19897/zd:20730) (q:draft)
khumlo = (i:2) (t:adj) (f:everyday) (w:not sweet/unpleasant) (d:<khum>, sweet, and <lo>, not, written as one word, said of the sound of a voice and of speech) (j:khum/lo) (r:zd:17634) (q:draft, low confidence)
Khumnuai = (i:1) (t:name) (c:khua) (f:travel) (w:Khumnuai) (d:village in the Tonzang area of Chin State in Myanmar) (r:zd:11159/zd:20784) (q:draft, low confidence)
khun = (i:2) (t:n) (f:politics/social) (w:rule/regulation/law) (d:the second part of <thukhun> when it is written as two words, {thu khun}: a rule or law that must be followed) (r:zd:21379/zd:24287/zd:25241) (q:draft)
khut kilen = (i:1) (t:v) (f:social) (w:join hands/hold hands/shake hands/cooperate) (d:<khut>, hand, and <kilen>, hold one another: hold or shake hands, and as a figure work together in unity, often before <in> or <a> and a verb of working together) (r:zd:22595/zd:19335/zd:11548) (q:draft)
khut kilenin = (i:1) (t:adv) (f:social/politics) (w:hand in hand/in cooperation/jointly) (d:<khut>, hand, with <kilenin>, holding one another: hand in hand; placed after a partner marked with <tawh> and before a verb of working, working closely together with them) (r:zd:25110/zd:22650) (q:draft)
khutbeng = (i:1) (t:v) (f:social/body) (w:clap/applaud/clap hands) (d:<khut> and <beng> written as one word: clap the hands, applaud) (s:beeng) (j:khut/beng) (r:zd:24114/zd:16928) (q:draft)
khutbetna = (i:1) (t:n) (f:social) (w:applause/clapping) (d:<khut>, hand, with <bet>, strike, and the noun suffix <na>: clapping of the hands in welcome or approval) (r:zd:16157) (q:draft)
khutcin = (i:1) (t:n) (f:body) (w:fingernail/nail) (d:<khut>, hand, with <cin>, here nail: the nail of a finger; {khutcin khecin} is the nails of hands and feet, and {khutcin tan} is to cut the nails) (r:zd:23853/zd:15730/zd:16776) (q:draft)
khutdawhngen = (i:1) (t:n) (f:social) (w:beggar) (d:<khutdawh> and <ngen> written as one word: one who asks for alms, and also to beg; {khutdawhngen in avak} is going about begging) (j:khutdawh/ngen) (r:zd:20135/zd:11078/zd:18089) (q:draft)
khutkhat = (i:1) (t:n) (f:social) (w:one hand) (d:<khut>, hand, with <khat>, one, written as one word; found in {khutkhat tawi khekhat khai}, carrying with one hand and lifting one foot, said of people who work together as one) (j:khut/khat) (r:zd:22595/zd:24062) (q:draft)
khutkhial = (i:1) (t:v) (f:social/family) (w:strike/hit/lay hands on) (d:<khut>, hand, with <khial>, do wrong: do wrong with the hand, hit or beat a person, as in anger) (r:zd:16020/zd:19654) (q:draft)
khutkhialhna = (i:1) (t:n) (f:social) (w:rash act/act of violence) (d:<khut>, hand, and <khialhna>, wrong, written as one word: a wrong done with the hand, such as striking someone in a quarrel, a rash act that cannot be undone) (j:khut/khialhna) (r:zd:16695/zd:23902) (q:draft, low confidence)
khutkilen = (i:1) (t:v) (f:social) (w:hold hands/join hands/go hand in hand) (d:<khut>, hand, and <kilen>, hold one another, written as one word: hold each other by the hand, and so work together in unity; {khutkilen in} is hand in hand) (j:khut/kilen) (r:zd:24452/zd:19952/zd:17826) (q:draft)
khutlam = (i:1) (t:n) (f:education) (w:handwriting/hand) (d:<khut>, hand, with <lam>: the writing of a person done by hand, his or her own hand) (r:zd:21925/zd:9258) (q:draft)
khutlam = (i:2) (t:n) (f:body/social) (w:palm lines) (d:the lines of the hand as read by a fortune-teller; {khutlam et} is palm reading) (r:zd:24238) (q:draft, low confidence)
khutlehkhe = (i:1) (t:n) (f:body) (w:hands and feet/limbs) (d:<khut>, <leh> and <khe> written as one word: hands and feet, the limbs; also said of those who carry out the work of a ruler) (j:khut/leh/khe) (r:zd:24082/zd:25165) (q:draft)
khutlot = (i:1) (t:adj) (f:politics) (w:hand-thrown) (d:<khut>, hand, with <lot>, throw: thrown by hand; {khutlot bomb} is a hand grenade) (j:khut/lot) (r:ts:8311/ts:10538/ts:2913) (q:draft)
khutma = (i:1) (t:n) (f:work/everyday) (w:handiwork/work of one's hands/doing) (d:what a person has made or done, the work that someone leaves behind; also the doing of the one behind a deed, as in {Pasian' khutma}, the work of God) (r:zd:25185/zd:24375/zd:20587) (q:draft)
khutnga = (i:1) (t:v) (f:body/social) (w:lay hands on) (d:put the hands on a person, whether to pray for the person or to strike; {khutnga in bawlsia} is to harm someone physically) (r:zd:12487/zd:16657) (q:draft, low confidence)
khutsawp = (i:1) (t:v) (f:health/home) (w:wash hands/hand washing) (d:<khut> and <sawp> written as one word: wash the hands, the washing of hands) (j:khut/sawp) (r:zd:23731/zd:24276) (q:draft)
khutsiam = (i:2) (t:n) (f:work/education) (w:craft/handicraft/manual skill) (d:used as a noun for the skill of the hands itself or a trade learned with it, where the other sense describes a person or work; {khutsiam sinna} is vocational training and {khutsiam khatpeuh} any craft) (r:zd:20999/zd:16779/zd:15653) (q:draft)
khutsil = (i:1) (t:v) (f:health/body) (w:wash hands/handwashing) (d:<khut>, hand, with <sil>, wash: wash the hands; also as a noun, the washing of hands) (j:khut/sil) (r:zd:24054/zd:23649/zd:14734) (q:draft)
khutsilna = (i:1) (t:n) (f:health/body) (w:handwashing/hand washing) (d:<khut>, hand, and <sil>, wash, with the noun ending {-na}: the washing of the hands, and what is set out for it; {khutsilna zatui} is hand sanitiser) (r:zd:23853/zd:23649) (q:draft)
khutsungah = (i:1) (t:adv) (f:everyday/social) (w:in the hands of/in the power of) (d:<khutsung>, hand or grasp, with the place marker <ah>: in the hand, in the control of someone) (b:khutsung) (j:khutsung/ah) (r:zd:21918/zd:20682) (q:draft)
khutsungpan = (i:1) (t:adv) (f:everyday/politics) (w:out of the hand of/from the power of) (d:<khutsung> and <pan> written as one word, after the one who holds: out of his hand, from his grasp or power) (j:khutsung/pan) (r:zd:11670/zd:21015) (q:draft)
khuttawh = (i:1) (t:adv) (f:body/everyday) (w:by hand/with the hand) (d:<khut> and <tawh> written as one word: with the hand, by the hands of someone) (j:khut/tawh) (r:zd:19683/zd:20035/zd:17673) (q:draft)
khuttawi = (i:1) (t:n) (f:social) (w:gift/present) (d:<khut>, hand, with <tawi>, carry: something carried in the hand as a gift for the person visited; before a noun it means held in the hand, as in {khuttawi bomb}, hand grenade) (s:letsong) (r:zd:10730/zd:10742) (q:draft, low confidence)
khuttuam = (i:1) (t:n) (f:home/health) (w:glove/gloves) (d:<khut>, hand, with <tuam>, cover: a covering worn on the hand; {khuttuam thuah} is wear gloves) (r:zd:11440/zd:16241/zd:24049) (q:draft)
khutzat = (i:1) (t:n) (f:politics/work) (w:tool/instrument/agent/pawn) (d:<khut>, hand, with <zat>, use: what is used by the hand; in the news mostly a person or group that another uses to do its work, an agent or proxy, and {khutzat laibu} is a handbook) (r:zd:16702/ts:7697/zd:22938) (q:draft)
khutzep = (i:1) (t:n) (f:body/social) (w:folded arms) (d:the arms folded across the chest; {khutzep in en} is look on with folded arms, stand by without doing anything to help) (r:zd:13288/zd:12765) (q:draft)
ki nawhdeih = (i:1) (t:v) (f:work) (w:be urgently wanted/be needed at once) (d:the verb prefix <ki>, written apart, and <nawhdeih>, want urgently: the passive, to be wanted at once; a formula of job notices, placed after the kind and number of workers sought) (r:zd:20033/zd:17217) (q:draft)
ki ukzia = (i:1) (t:n) (f:politics) (w:system of government/form of rule) (d:<ki>, here the reflexive and passive prefix written apart, not horn, and <ukzia>, way of ruling: how a country or a body is governed; often after <gam>, as {gam ki ukzia}) (r:zd:24336/zd:11798) (q:draft)
ki ummawh = (i:1) (t:v) (f:media) (w:be suspected/be believed) (d:<ummawh>, suspect, with the passive prefix <ki> written apart: it is suspected, it is thought; it follows a clause that ends in {hiding in} or {hi dingin}, it is thought to be so) (r:ts:617/zd:23727) (q:draft)
kia = (i:1) (t:v) (f:everyday) (w:fall/drop) (d:fall down or drop from a height; said of a person, of rain and of seed that falls on the ground; the form <kiat> is used before <leh> and <ciangin>) (s:puk/tuk) (a:tho) (q:draft)
kiading = (i:1) (t:v) (f:politics) (w:be sentenced to/will serve) (d:<kia>, fall, and <ding>, will, written as one word; after <thong>, prison, and a length of time: is to be in prison for that long) (j:kia/ding) (r:zd:22056/zd:11941) (q:draft)
kiadingin = (i:1) (t:phrase) (f:politics) (w:to be sentenced to/to serve in prison) (d:<kiading>, will fall, with <in>, written as one word; after <thong>, prison, and a length of time: that one is to be in prison for that long, as the ruling of a court) (j:kiading/in) (r:zd:18139/zd:16961) (q:draft)
kiallap = (i:1) (t:n) (f:food) (w:light meal/breakfast/snack) (d:built on <kial>, hunger: food that stays the hunger, a light meal or the morning meal; {kiallap ne} is eat it) (r:zd:19371/zd:22773) (q:draft)
kiallap = (i:2) (t:adj) (f:politics) (w:interim/temporary/stopgap) (d:filling a gap for the time being: {kiallap kitelna} is a by-election and {kiallap kumpi} an interim government) (r:zd:21509/zd:25263) (q:draft, low confidence)
kiallap = (i:3) (t:adj) (f:everyday) (w:timely/meeting the need) (d:coming just when it is needed and meeting the need of the moment; {kiallap mahmah} is very timely) (r:zd:19201/zd:25264) (q:draft, low confidence)
kiamlam = (i:1) (t:n) (f:everyday) (w:decline/decrease/downward trend) (d:<kiam> and <lam> written as one word: the direction of decrease; {kiamlam manawh} is to head toward decline) (j:kiam/lam) (r:zd:21690/zd:25215) (q:draft)
kiamna = (i:1) (t:n) (f:everyday/work) (w:decrease/reduction/decline) (d:a becoming less in amount, number or strength) (b:kiam) (r:zd:13295) (q:draft)
kiamsemsem = (i:1) (t:v) (f:everyday) (w:decrease more and more/keep falling) (d:<kiam> and <semsem> written as one word: become less and less) (j:kiam/semsem) (r:zd:21817/zd:16715) (q:draft)
kiamsukna = (i:1) (t:n) (f:social/work) (w:decline/decrease/downfall) (d:<kiamsuk>, go down, with the noun ending {-na}: a going down in strength, number or standing, the opposite of progress) (a:khantohna) (b:kiamsuk) (r:zd:23556/zd:22557/zd:21377) (q:draft)
kiamtuam = (i:1) (t:v) (f:everyday/work) (w:decrease/go down/become less) (d:<kiam>, decrease, with <tuam>, to some degree, written as one word: become noticeably less; {kiamtuam sak} is reduce) (j:kiam/tuam) (r:zd:20747/zd:12210/zd:25589) (q:draft)
kiap = (i:1) (t:v) (f:everyday/work) (w:be handed over/be entrusted/be submitted) (d:<ap>, hand over, with the passive prefix <ki>: be entrusted to someone; of a list, be handed in; {sang kiap} is to enrol at a school) (b:ap) (r:zd:15407/zd:20968/ts:3375) (q:draft)
kiasak = (i:2) (t:v) (f:politics) (w:sentence/jail/imprison) (d:after <thong>, prison: send someone to prison by the judgment of a court; {thong ki kiasak} is be sentenced to prison, often after the length of the term) (r:zd:12148/zd:23492/zd:12774) (q:draft)
kiasakthei = (i:1) (t:v) (f:politics) (w:can be sentenced to/may be jailed) (d:<kiasak>, cause to fall, and <thei>, can, written as one word; with <thong>, prison, and the passive <ki>: can be sent to prison, as the penalty a law allows) (j:kiasak/thei) (r:zd:12727/zd:16919/zd:19307) (q:draft)
kiasukmawk = (i:1) (t:v) (f:everyday/media) (w:fall down suddenly/crash down) (d:<kiasuk>, fall down, with <mawk>, which marks the event as unexpected, written as one word: fall or crash down all at once) (j:kiasuk/mawk) (r:zd:16645/zd:13332) (q:draft)
kiasuksuak = (i:1) (t:v) (f:everyday) (w:fall right down/fall down into) (d:<kiasuk>, fall down, with <suak>, right through: fall all the way down from a height or into a hole) (j:kiasuk/suak) (r:zd:17909/zd:15317) (q:draft)
kiathei = (i:1) (t:v) (f:politics/everyday) (w:may fall/can fall) (d:<kia>, fall, and <thei>, can, written as one word: can fall; after <thong> and a length of time it means may be sentenced to prison for that long) (j:kia/thei) (r:zd:14609/zd:19624) (q:draft)
kiatheiding = (i:1) (t:v) (f:politics/everyday) (w:may fall/could fall) (d:<kia>, <thei> and <ding> written as one word: may fall, is liable to fall; {thong kiatheiding} is may be sent to prison) (j:kia/thei/ding) (r:zd:15759/zd:15123) (q:draft)
kiatlawh = (i:1) (t:v) (f:everyday/politics) (w:fall as a result/end up in) (d:<kiat>, fall, with <lawh>, as a consequence, written as one word: fall or crash because of something; {thong kiatlawh} is end up in prison for it) (j:kiat/lawh) (r:zd:14566/zd:12057) (q:draft)
kiatsuah = (i:1) (t:v) (f:everyday) (w:drop/let fall/fall off) (d:<kiat>, fall, with <suah>, let out: let something slip and fall by accident, or of the thing itself, fall off or fall out) (r:zd:23268/zd:21826/zd:16060) (q:draft)
kiau = (i:1) (t:adv) (f:everyday) (w:just/merely/simply) (d:placed after a verb, often before <se> or <hi>, to say that it is only so, or done lightly or in passing; {om kiau se hi} is there is just the one) (r:zd:13070/zd:21383/zd:25454) (q:draft, low confidence)
kiaukiau = (i:1) (t:adv) (f:everyday) (w:now and then/here and there/sporadically) (d:placed after a verb: it happens off and on or in scattered cases, not steadily) (r:zd:25094/zd:17224/zd:22815) (q:draft, low confidence)
kibah = (i:1) (t:v) (f:food/social) (w:feed one another/be fed) (d:<bah>, put food to the mouth, with <ki>: feed each other by hand or be given food, as a sign of love; in the saying {Ciimnuai-a sa kibah Geeltui-ah kithuk} a kindness is repaid later) (b:bah) (r:zd:24072/zd:25313) (q:draft, low confidence)
kibaih = (i:1) (t:v) (f:everyday) (w:be ready/be at hand) (d:in {a kibaih sa in om}, stand ready beforehand for someone; one other sentence has it as be taken easily or lightly, of marriage and divorce) (r:zd:20968) (q:draft, low confidence)
kibak = (i:1) (t:v) (f:food/social) (w:feed each other) (d:<bak> with the prefix <ki>: put pieces of meat into each other's mouths at a feast as a sign of affection, in {sa kibak}; see <sabak>) (b:bak) (r:zd:15996/zd:25393) (q:draft, low confidence)
kiban = (i:1) (t:v) (f:social) (w:keep up with/catch up with/be equal to) (d:<ban>, reach, with <ki>: come level with others, be their equal; mostly with <zo> and a negative, as in {kiban zo nailo}, not yet able to keep up with) (r:zd:11891/ts:4823/zd:19676) (q:draft)
kibang = (i:2) (t:adj) (f:everyday) (w:same/alike) (d:the same, not different; {a kibang} before a noun means the same, as in {ngeina a kibang khat}, one and the same law) (s:kikim) (a:tuam)
kibang lel = (i:1) (t:v) (f:everyday) (w:be just the same/be just like/be no different) (d:<kibang>, be alike, and <lel>, here the particle just, merely, not the verb lose: be simply the same; after a noun with <tawh>, be just like it, be no more than it) (r:zd:9425/zd:16385) (q:draft)
kibanghi = (i:1) (t:v) (f:everyday) (w:be like/be the same as) (d:<kibang>, be like, and the sentence ending <hi> written as one word: is like, is the same as; the thing compared with takes <tawh>) (j:kibang/hi) (r:zd:23784/zd:22171/zd:18028) (q:draft)
kibanglel = (i:1) (t:adj) (f:everyday) (w:just the same/no different) (d:<kibang> and <lel> written as one word: merely the same, no different, mostly after <tawh>) (j:kibang/lel) (r:zd:16442/zd:15505) (q:draft)
kibanglian = (i:1) (t:adj) (f:everyday) (w:exactly the same/identical/exactly alike) (d:<kibang>, the same, with <lian>, here exactly, written as one word; what it is compared with is followed by <tawh>) (j:kibang/lian) (r:zd:8375/zd:12874) (q:draft)
kibanglo = (i:1) (t:adj) (f:everyday) (w:different/not the same/unlike) (d:<kibang> and <lo> written as one word: not alike, different from each other) (j:kibang/lo) (r:zd:11409/zd:23843) (q:draft)
kibanglote = (i:1) (t:n) (f:social) (w:those that differ/different ones) (d:<kibang>, alike, with <lote>, those that are not, written as one word: people or things that are not alike; after a noun, those who differ in it, as in {ngaihsutna kibanglote}, those of different views) (j:kibang/lote) (r:zd:24217/zd:24951) (q:draft)
kibangpian = (i:1) (t:v) (f:everyday) (w:be much like/look alike/resemble) (d:<kibang> and <pian.2> written as one word: be about the same as, look like; the thing compared with is followed by <tawh>) (j:kibang/pian) (r:zd:19427/zd:15184) (q:draft)
kibanpih = (i:1) (t:v) (f:social) (w:share the same/be equal in) (d:<kiban>, be equal to, with <pih>, together with: have the same aim, wish or quality as another) (j:kiban/pih) (r:zd:22474) (q:draft, low confidence)
kibatloh = (i:1) (t:adj) (f:everyday/social) (w:different/unlike/not alike) (d:<kibat> and <loh> written as one word: not being alike; {kibatloh hang} is although not the same, and {kibatloh na} is a difference) (j:kibat/loh) (r:zd:21866/zd:13144/zd:23272) (q:draft)
kibatlohnate = (i:1) (t:n) (f:social) (w:differences) (d:<kibatlohna>, difference, with the plural <te>: the ways in which people or things are not alike) (b:kibatlohna) (r:zd:21866/zd:22543) (q:draft)
kibatpihte = (i:1) (t:n) (f:social) (w:fellows/peers) (d:<kibatpih> with the plural <te>: those who share the thing named before it, as {biakna kibatpihte}, people of the same religion, {tan kibatpihte}, classmates, and {lungsim kibatpihte}, the like-minded) (b:kibatpih) (r:zd:22470/zd:11207/zd:9426) (q:draft)
kibawl = (i:2) (t:v) (f:health) (w:be treated/receive treatment) (d:of a sick or injured person: be given medical treatment, at a hospital or with medicine, as in {zatui tawh kibawl}; the one treated is the subject, not a thing that is made) (r:ts:4572) (q:draft, low confidence)
kibawlbeh = (i:1) (t:v) (f:everyday/politics) (w:be made in addition/be done further/be added) (d:the prefix <ki> with <bawlbeh> written as one word: more of something is made or done; {thu kibawlbeh} is further action or a further charge is brought) (j:ki/bawlbeh) (r:zd:24303/zd:20661) (q:draft)
kibawlding = (i:1) (t:v) (f:everyday/media) (w:will be held/will be done/will be made) (d:<kibawl> and <ding> written as one word: will be held, done or made; <thu kibawlding> is legal action will be taken, and {zatui kibawlding in} is in order to be treated) (j:kibawl/ding) (r:zd:17804/zd:15602/zd:14523) (q:draft)
kibawlkha = (i:1) (t:v) (f:media/everyday) (w:happen to be made/get recorded) (d:<kibawl>, be made, with <kha>, happen to: be made as it happened, mostly {Record kibawlkha}, be caught on a recording) (j:kibawl/kha) (r:zd:19743/zd:18116) (q:draft)
kibawlkhia = (i:1) (t:v) (f:work/it) (w:be produced/be manufactured/be made) (d:<kibawl>, be made, with <khia>, out, written as one word: be made and brought out, of goods, models and products) (j:kibawl/khia) (r:zd:23729/zd:15097/zd:24500) (q:draft)
kibawlkhin = (i:1) (t:v) (f:everyday) (w:have been made/have been done/have been held) (d:<kibawl>, be made or done, and <khin>, already, written as one word: already made, filed, carried out or held) (j:kibawl/khin) (r:zd:20984/zd:12662/zd:26124) (q:draft)
kibawlkik = (i:1) (t:v) (f:everyday) (w:be made again/be redone/be renewed/be held again) (d:<kibawl>, be made or done, and <kik>, again, written as one word: a card is renewed, a report is made again, an event is held again) (j:kibawl/kik) (r:zd:22650/zd:17217/ts:2844) (q:draft)
kibawllai = (i:1) (t:v) (f:everyday) (w:still be done/be held again/be still under way) (d:<kibawl>, be done or be held, with <lai>, still: it is still being done, or with <ding> it will yet be held) (j:kibawl/lai) (r:zd:17299/zd:10907) (q:draft)
kibawllo = (i:1) (t:v) (f:everyday/work) (w:not be made/not be done/not be held) (d:<kibawl>, be made or done, and <lo>, not, written as one word; {thu kibawllo} is no case is brought, no action is taken) (j:kibawl/lo) (r:zd:12194/zd:14531/zd:13066) (q:draft)
kibawlna = (i:2) (t:n) (f:health) (w:treatment/cure) (d:the medical treatment of a disease or of a patient, with <natna>, disease, <zatui>, medicine, or the name of an illness: {kibawlna mun} is a place of treatment; not the making or holding of something) (r:zd:23745/zd:25616) (q:draft)
kibawlngei = (i:1) (t:v) (f:everyday) (w:have been held before/have been done before) (d:<kibawl> and <ngei> written as one word: was once held, made or done) (j:kibawl/ngei) (r:zd:12662/zd:17112) (q:draft)
kibawlpah = (i:1) (t:v) (f:everyday/health) (w:be done at once/be carried out immediately) (d:<kibawl>, be made or done, and <pah>, at once, written as one word: is done, made or given right away, of a report, an operation or treatment) (j:kibawl/pah) (r:zd:12603/zd:20049/zd:12955) (q:draft)
kibawlphot = (i:1) (t:v) (f:everyday/politics) (w:be done first/be made for now) (d:<kibawl>, be made or done, and <phot>, first or for the time being, written as one word: be done first, be set up or filed for the time being) (j:kibawl/phot) (r:zd:20104) (q:draft)
kibawlpih = (i:1) (t:v) (f:social/work) (w:be done for/be held with) (d:<kibawl> and <pih> written as one word: be made, done or held for someone or together with someone, as a service, a report or paperwork) (j:kibawl/pih) (r:zd:21156/zd:17735) (q:draft)
kibawlsakding = (i:1) (t:v) (f:social/everyday) (w:will be held for/will be arranged for) (d:<kibawlsak>, be made or done for someone, and <ding>, will, written as one word: something will be held or arranged for someone) (j:kibawlsak/ding) (r:zd:12641) (q:draft)
kibawlsawm = (i:1) (t:v) (f:social/politics) (w:be planned/be about to be held) (d:<kibawl>, be made or held, with <sawm>, intend, written as one word: something is planned or intended to be done or held) (j:kibawl/sawm) (r:zd:15602/ts:9834) (q:draft)
kibawlta = (i:1) (t:v) (f:politics/media) (w:be charged/have been made) (d:<kibawl> with <ta>, which marks that the thing has now happened, written as one word; {thu kibawlta} is a case has been brought, the person has been charged in court) (j:kibawl/ta) (r:zd:19624/zd:15807) (q:draft)
kibawlthei = (i:1) (t:v) (f:everyday) (w:can be made/can be done/can be held) (d:<kibawl>, be made or done, and <thei>, able, written as one word) (j:kibawl/thei) (r:zd:17824/zd:20534) (q:draft)
kibawltheiding = (i:1) (t:v) (f:politics/everyday) (w:can be done/may be brought/can be made) (d:<kibawlthei> and <ding> written as one word: it will be possible to do it; {thu kibawltheiding} is a case can be brought, charges may be laid) (j:kibawlthei/ding) (r:zd:20300/zd:11527) (q:draft)
kibawlzo = (i:1) (t:v) (f:social/work) (w:be held successfully/be able to be done) (d:<kibawl>, be made or held, and <zo>, manage to, written as one word: of a meeting or task, be carried through; with a negative, cannot be done) (j:kibawl/zo) (r:zd:22866/zd:11289) (q:draft)
kibehlapna = (i:1) (t:n) (f:everyday/family) (w:addition/increase) (d:<kibehlap>, be added, with the noun suffix {-na}: an addition to a number or group, as a new member of a household) (b:kibehlap) (r:zd:25789) (q:draft)
kibehlapte = (i:1) (t:n) (f:social/family) (w:those added/new additions) (d:<kibehlap> and <te> written as one word: those who are added, as a wife or husband added to a household) (j:kibehlap/te) (r:zd:25789) (q:draft)
kibei = (i:1) (t:v) (f:everyday/work) (w:be spent/be used up/come to an end) (d:<bei>, come to an end, with the prefix <ki>: of money, time or a rule, be used up or come to an end; {kibei sak} is bring to an end) (j:ki/bei) (r:zd:20859/zd:21598) (q:draft)
kibel = (i:1) (t:v) (f:social/politics) (w:attach oneself/join together/lean on one another) (d:<bel>, cling to, with the prefix <ki>: attach oneself to, hold together with others; {kibel pawl gam} is a federal union of states) (b:bel) (r:zd:19599/zd:20450) (q:draft, low confidence)
kibelh = (i:1) (t:v) (f:everyday) (w:be stuck on/be attached/be added) (d:<ki> with <belh>, cling to: be stuck or pasted on something, as a sticker or a notice; {kibelh lap} is be added on top) (j:ki/belh) (r:zd:11698/zd:17313) (q:draft)
kibelpawl = (i:1) (t:v) (f:politics) (w:ally with/be allied/side with) (d:<ki> with <bel>, lean on, and <pawl>, group: join with another as an ally; the ally is marked with <tawh>) (r:zd:24446/zd:23071) (q:draft)
kibelpawlna = (i:1) (t:n) (f:politics) (w:federation/union/alliance/coalition) (d:the joining of states, peoples or parties into one body, used for a federal union and for a coalition of parties) (r:zd:24455/zd:20863) (q:draft)
kibeng = (i:1) (t:v) (f:everyday/social) (w:be clapped/be slapped/be struck) (d:be struck with the open hand; {khut kibeng} is the hands are clapped, there is applause, and {apang kibeng} is be slapped on the cheek) (r:zd:11135/zd:20907) (q:draft)
kibuai = (i:2) (t:v) (f:everyday/work) (w:be busy/be occupied/be engaged) (d:have the hands full with work or a matter, named with <tawh> or <vai>, without the noise of a crowd; {kibuai pih} after a place with <ah> is be occupied or engaged there) (r:zd:21013/zd:24034) (q:draft)
kibuaina = (i:1) (t:n) (f:social/politics) (w:conflict/dispute/clash/unrest) (d:<kibuai>, be in turmoil with one another, with the noun suffix <na>: trouble or fighting between people or groups; {minam vai kibuaina} is ethnic conflict) (b:kibuai) (r:zd:19662/ts:3020) (q:draft)
kibuaipih = (i:1) (t:v) (f:social/work) (w:be attended to/be dealt with/be busy with) (d:<buai>, be occupied, with <ki> and the suffix <pih>: be busied with a matter; in community notices, said of a person whose case at a hospital, an office, a court or a lockup is being taken care of) (b:buai) (r:zd:22714/zd:21462) (q:draft)
kibual = (i:1) (t:v) (f:everyday) (w:wallow/be immersed in/indulge in) (d:the prefix <ki> with <bual>, wallow: roll or bathe in water, and so be sunk in or given over to something, as in {siatna sungah kibual}, wallow in evil) (b:bual) (r:zd:21426/zd:23551) (q:draft)
kibuan = (i:2) (t:v) (f:social) (w:wrestle/grapple/struggle) (d:two people or sides seize each other and struggle, as a sport at a feast or in a fight, often with <tawh>, with; no violation is meant) (s:kilai) (r:zd:23022/ts:3375) (q:draft)
kibuanna = (i:1) (t:n) (f:social) (w:wrestling/wrestling match) (d:the sport of wrestling, two people struggling to throw each other; in news of war also violent assault on women) (r:zd:10963/ts:479) (q:draft)
kibuk = (i:1) (t:v) (f:social/everyday) (w:take shelter/hide/take cover) (d:<buk>, take cover, with the prefix <ki>: shelter or hide oneself, also under the protection of an organisation) (b:buk) (r:zd:17860/ts:6842) (q:draft)
kibulh = (i:2) (t:v) (f:religion/media) (w:be set to/be matched with) (d:of a song: the words and the tune, {la-aw}, are joined to each other, with <tawh> for the other part, as a hymn text is set to a tune; not a thing fastened on a body or an object) (b:bulh) (r:zd:9255/zd:9225/zd:9263) (q:draft)
kibulhsak = (i:1) (t:v) (f:politics) (w:be put on someone/be handcuffed) (d:the passive prefix <ki> with <bulhsak>, put on someone, written as one word; {kol kibulhsak} is have shackles or handcuffs put on) (j:ki/bulhsak) (r:zd:16869/zd:12515) (q:draft)
kibuluak = (i:1) (t:v) (f:politics) (w:be seized/be captured/be overrun) (d:<buluak>, seize by force, with the passive prefix <ki>: of a camp or base, be attacked and taken) (b:buluak) (r:ts:4121/ts:3707) (q:draft)
kibuluhna = (i:1) (t:n) (f:politics/social) (w:seizure/raid/being raided) (d:<kibuluh>, be raided, with the noun suffix <na>: the raiding of a house, or the seizing of power by force) (s:buluhna) (b:kibuluh) (r:zd:24943) (q:draft)
kibung = (i:1) (t:v) (f:travel) (w:overturn/capsize/turn over) (d:of a car, bus, lorry or boat: turn over in an accident) (s:kilumlet) (r:zd:16944/zd:16906/zd:15715) (q:draft)
kibungin = (i:1) (t:v) (f:travel) (w:overturning/having overturned/capsizing) (d:<kibung>, overturn, with the linking <in>, written as one word: a vehicle or boat overturns and something follows) (j:kibung/in) (r:zd:15667/zd:19960) (q:draft)
kibusim = (i:1) (t:v) (f:politics) (w:be attacked/be raided/be stormed) (d:of a camp, post or town in war: be attacked by a force that closes in on it) (r:ts:5635/ts:3882) (q:draft, low confidence)
kibut = (i:1) (t:v) (f:travel) (w:collide/crash) (d:of vehicles: run into each other or into something; {mawtaw kibut} is a car crash) (s:kitaih) (r:zd:22550/zd:12337) (q:draft)
kibutna = (i:1) (t:n) (f:travel) (w:crash/collision/accident) (d:<kibut>, crash, with the noun ending {-na}: the crash of a vehicle or the wreck of a ship, a road or sea accident) (r:zd:12906/zd:17816) (q:draft, low confidence)
kici = (i:3) (t:v) (f:everyday/media) (w:be said/it is said) (d:closes a statement that is passed on from what people say, after <hi> or a verb: {om kici hi} is it is said to be there; not the giving of a name) (r:ts:693/zd:25928) (q:draft)
kici sawnsawn = (i:1) (t:phrase) (f:media) (w:it is further reported/is said to be) (d:<kici>, be said, and <sawnsawn>, on and on: closes a news sentence before <hi>, the fact stated before it is passed on as a further report and not as the writer's own knowledge) (r:zd:21067/zd:14954) (q:draft, low confidence)
kiciah = (i:1) (t:v) (f:everyday/travel) (w:go home/return/disperse) (d:<ciah>, go home, with the prefix <ki>: of a group, go home after a gathering or journey; {kiciah sak} is be sent home) (b:ciah) (r:zd:16797/zd:11447/zd:20403) (q:draft)
kiciak = (i:1) (t:v) (f:social/media) (w:be in an uproar/clamour/make an outcry) (d:of many people, raise their voices at once over a matter, in complaint or excitement; followed by a sound word such as <ngeingai>, {sepsup} or <ziazua>) (r:zd:20197/zd:22691) (q:draft)
kicial = (i:2) (t:v) (f:social/religion) (w:be invited/be urged/be called on) (d:passive of <cial> where no pay is meant: be asked to come and speak or to do something, after <dingin>; in sermons and appeals {i kicial hi} is we are urged) (r:zd:16245/zd:11552/zd:23893) (q:draft)
kiciam = (i:2) (t:v) (f:social/time) (w:agree/arrange/make an appointment/fix) (d:agree with someone on a day, time or place to meet or to do something, without any oath; {kiciam ni} is the day agreed on) (r:zd:24594/zd:19654/zd:16832) (q:draft)
kician = (i:2) (t:adj) (f:everyday/work/politics) (w:proper/definite/clear/valid) (d:clear, exact and in good order, not vague or makeshift: said of a permit or permission that is valid, of a job that is regular, and of a list or figure that is settled; {kician takin} is properly, clearly) (r:zd:21032/zd:21552/ts:2669) (q:draft)
kicianin = (i:1) (t:adv) (f:everyday) (w:clearly/definitely/firmly) (d:<kician>, firm and sure, and <in> written as one word: in a clear and definite way, for certain) (j:kician/in) (r:zd:12370/zd:20272) (q:draft)
kiciankhat = (i:1) (t:phrase) (f:everyday) (w:a definite one/a firm one) (d:<kician> and <khat> written as one word after a noun: a definite, firm or proper one, as in {deihna kiciankhat}, a definite aim) (j:kician/khat) (r:zd:20801/zd:22742) (q:draft)
kicianlo = (i:1) (t:adj) (f:everyday) (w:unclear/uncertain/unreliable/improper) (d:<kician>, sure, and <lo>, not, written as one word: not clear or not certain; of a person, not proper or not to be trusted) (j:kician/lo) (r:zd:21876/zd:13159) (q:draft)
kiciantak = (i:1) (t:adv) (f:everyday) (w:clearly/definitely/exactly/firmly) (d:<kician>, firm and sure, with <tak>, written as one word and mostly followed by <in>: in a clear, exact and reliable way, said of telling, teaching, knowing and holding to something) (j:kician/tak) (r:zd:22683/zd:17204/zd:11278) (q:draft)
kiciantakin = (i:1) (t:adv) (f:everyday) (w:clearly/definitely/firmly/precisely) (d:<kician>, firm and sure, and <takin> written as one word: in a clear, exact and well-founded way) (s:ciantakin) (j:kician/takin) (r:zd:22171/zd:23767/zd:23317) (q:draft)
kicianzaw = (i:1) (t:adj) (f:everyday) (w:clearer/more exact/more detailed) (d:<kician> clear and sure with <zaw> more, written as one word; {a kicianzaw in} is more exactly, in more detail) (j:kician/zaw) (r:zd:22967/zd:21605) (q:draft)
kiciapteh = (i:1) (t:v) (f:everyday) (j:kiciamteh) (r:zd:19329/ts:12519) (q:draft)
kiciaptehna = (i:1) (t:n) (f:work/education) (w:record/registration/mark) (d:<ciaptehna> with the prefix <ki>: what has been noted down, a written record or entry; also a mark by which something is known) (b:ciaptehna) (r:zd:25893/zd:23283/zd:24199) (q:draft)
kiciat = (i:1) (t:v) (f:everyday) (w:be certain/be definite/be exact) (d:be sure and settled about a matter, close in sense to <kician>; {kiciat lohna} is uncertainty or indecision) (r:zd:20418) (q:draft, low confidence)
kiciding = (i:1) (t:v) (f:everyday/media) (w:will be called/to be named) (d:<kici>, be called, and the future marker <ding> written as one word: will be called, is to be named) (j:kici/ding) (r:zd:11438) (q:draft)
kicihi = (i:1) (t:v) (f:media/everyday) (w:it is said/be called) (d:<kici> and <hi> written as one word at the end of a sentence: it is said, reportedly; also it is called) (j:kici/hi) (r:zd:12161/zd:22569) (q:draft)
kiciin = (i:1) (t:v) (f:nature/work) (w:be planted/be grown/be cultivated) (d:passive of <ciin>, plant: of a crop, be planted or grown; {kiciin lohna} is where nothing is grown) (b:ciin) (r:zd:21092/zd:24068) (q:draft)
kiciinna = (i:1) (t:n) (f:nature/work) (w:cultivation/planting/plantation) (d:<ki>, passive, with <ciin>, plant, and the noun ending {-na}: the growing of a crop, or the place where it is grown, as in {lenggah kiciinna}, vineyard) (r:zd:15525/zd:15679) (q:draft)
kicikhat = (i:1) (t:phrase) (f:everyday/media) (w:one called/a person named) (d:<kici>, be called, and <khat>, one, written as one word; placed after a name: someone called by that name) (j:kici/khat) (r:zd:11736/zd:11164) (q:draft)
kiciliang = (i:1) (t:v) (f:everyday/media) (w:be even called) (d:<kici>, be called, and <liang>, even, written as one word: is even called, goes so far as to be called or said) (j:kici/liang) (r:zd:20703/zd:21288) (q:draft)
kicilo = (i:1) (t:v) (f:everyday) (w:not be called/not be said) (d:<kici> and <lo> written as one word: is not called, cannot be said to be) (j:kici/lo) (r:ts:3341/zd:24420) (q:draft)
kicimawk = (i:1) (t:v) (f:media) (w:be reportedly said/be reported) (d:<kici>, be said or be called, and <mawk>, written as one word, mostly as {kicimawk hi} at the end of a news sentence: so it is said, it is reported) (j:kici/mawk) (r:zd:20401/zd:14566) (q:draft)
kicimtak = (i:1) (t:v) (f:social/everyday) (w:be found tiresome/be wearied of/bore) (d:<cimtak>, be tired of, with <ki>: with <hong>, people grow tired of the one speaking) (b:cimtak) (r:zd:21075/zd:21034) (q:draft)
kicimzan = (i:1) (t:v) (f:nature) (w:collapse completely/be flattened/be destroyed) (d:<cimzan>, be levelled, with the prefix <ki>: of a bridge or houses, fall down in ruins, as in an earthquake) (b:cimzan) (r:ts:10007/ts:9264) (q:draft)
kicing = (i:1) (t:adj) (f:everyday) (w:enough/complete/full) (d:complete, perfect or enough; also used as a verb, be enough or be fulfilled, and {a kicing lo} is what is lacking) (s:cingtaak/kicingtaak) (q:draft)
kicingh = (i:1) (t:adj) (f:everyday) (j:kicing) (r:zd:23212/zd:15586) (q:draft)
kicinglo = (i:1) (t:adj) (f:everyday) (w:not enough/insufficient/incomplete/lacking) (d:<kicing>, enough or complete, and <lo>, not, written as one word; {khuak kicinglo} is of deficient mind) (j:kicing/lo) (r:zd:20435/zd:16360/zd:21918) (q:draft)
kicingtak = (i:1) (t:adv) (f:everyday) (w:fully/completely/thoroughly) (d:<kicing>, complete, and <tak> written as one word: in full, with nothing lacking; mostly followed by <in>) (j:kicing/tak) (r:zd:21502/zd:11110/zd:20695) (q:draft)
kicingtakin = (i:1) (t:adv) (f:everyday) (w:fully/sufficiently/completely/in full) (d:<kicing>, enough or complete, with <takin>, which makes an adverb: in full measure, enough for the need) (s:cingtakin) (j:kicing/takin) (r:zd:23767/zd:16640/zd:21796) (q:draft)
kicinlahna = (i:1) (t:n) (f:everyday/social) (w:shortcoming/inadequacy/deficiency) (d:what is not complete or not good enough in a person or a piece of work, named together with <kisapna>, need, and <thanemna>, weakness) (r:zd:15489) (q:draft)
kicinlohna = (i:1) (t:n) (f:everyday/social) (w:insufficiency/lack/shortage/inadequacy) (d:<kicin>, be complete, with <lohna>: the state of not being complete or not having enough of the thing named before it) (j:kicin/lohna) (r:zd:18896/zd:24346/zd:15459) (q:draft)
kicinu = (i:1) (t:n) (f:everyday/media) (w:the woman called/woman named) (d:<kici>, be called, with <nu>, a female person, written as one word: the woman or girl who is called by the name that stands before it; the male form is <kicipa>) (b:kici) (j:kici/nu) (r:zd:14674/zd:19428) (q:draft)
kicinuam = (i:1) (t:v) (f:social/everyday) (w:like to be called/want to call oneself) (d:<kici>, be called, with <nuam>, want, written as one word: want to be called something or like to call oneself so; also of what people tend to say) (j:kici/nuam) (r:zd:20569/zd:20769) (q:draft, low confidence)
kicipah = (i:1) (t:v) (f:everyday/media) (w:be called/be said) (d:<kici>, be called or be said, with <pah>, straight away, written as one word: is duly called so, or it is said at once) (j:kici/pah) (r:zd:16924) (q:draft)
kicipen = (i:1) (t:phrase) (f:everyday) (d:<kici>, be called, and the topic marker <pen> written as one word, placed after a name: the thing called so, the one known as) (j:kici/pen) (r:zd:17538/zd:20466) (q:draft)
kicipna = (i:2) (t:n) (f:nature/home) (w:collapse/cave-in) (d:the event of a building, bridge, ceiling or mass of earth or snow falling in, often before <hangin>, because of; {vukkhalmual kicipna} is an avalanche; in the Bible sense it is the place where a wall is broken) (r:zd:11947/zd:21244/zd:15803) (q:draft)
kicitek = (i:1) (t:v) (f:everyday/media) (w:be said by all/be generally said) (d:<kici> and <tek> written as one word, closing a statement: everyone says so, it is the common opinion that) (j:kici/tek) (r:zd:15389/zd:12259/zd:17689) (q:draft)
kiciteng = (i:1) (t:phrase) (f:everyday) (w:all that are called/every so-called) (d:<kici>, be called, and <teng>, all, written as one word: all that are called so; {mun kiciteng ah} is in every place, everywhere) (j:kici/teng) (r:zd:25068/zd:20588) (q:draft)
kicithei = (i:1) (t:v) (f:everyday) (w:can be called/can be said) (d:<kici>, be called, with <thei>, able, written as one word: it can be called or said to be so) (j:kici/thei) (r:zd:12093/zd:21018/ts:11032) (q:draft)
kicizel = (i:1) (t:v) (f:everyday/media) (w:be said repeatedly/be often said) (d:<kici> and <zel> written as one word: it is said again and again, people keep saying) (j:kici/zel) (r:zd:15294/zd:13039) (q:draft)
kidah = (i:1) (t:v) (f:everyday/social) (w:be sad/grieve/be sorry) (d:<dah>, be sad, with the prefix <ki>: people are sad, there is grief or regret over something) (b:dah) (r:ts:2349/zd:22034/zd:24913) (q:draft)
kidalkholhna = (i:1) (t:n) (f:health/politics) (w:precaution/prevention/preventive measure) (d:<kidal>, protect oneself, with <kholhna>, doing in advance, written as one word: a step taken beforehand against danger) (j:kidal/kholhna) (r:zd:12860/zd:14792) (q:draft)
kidalna = (i:2) (t:n) (f:health) (w:prevention/self-protection/self-defence) (d:the act of guarding oneself against a disease or an attack, not a thing that shields; <kidalna zatui> is a vaccine and {ei leh ei kidalna} is self-defence) (r:zd:23932/zd:24947/zd:25043) (q:draft)
kidalna zatui = (i:1) (t:n) (f:health) (w:vaccine/preventive medicine) (d:<kidalna>, protection, and <zatui>, medicine: a medicine that protects against a disease, a vaccine; stands after the name of the disease, and {kidalna zatui kisut} is be vaccinated) (s:vaccine) (r:zd:24947/ts:12490) (q:draft)
kidalnading = (i:1) (t:phrase) (f:everyday) (w:to shield oneself/as a shield for oneself) (d:<kidal> and <nading> written as one word: for shielding oneself; {kidalnading in} is as a shield for oneself) (j:kidal/nading) (r:zd:11799/zd:20049) (q:draft)
kidaltheih = (i:1) (t:v) (f:everyday/health) (w:be able to protect oneself/be able to guard against/be preventable) (d:<kidal> and <theih> written as one word, used before <nading>: so that one can keep oneself safe from something) (j:kidal/theih) (r:zd:11199/zd:14640) (q:draft)
kidam = (i:1) (t:v) (f:health) (w:be healed/get well/recover) (d:<dam>, be well, with the prefix <ki>: one is healed, people get well; said in general, not of one named person) (b:dam) (r:zd:20824/zd:23539) (q:draft)
kidang = (i:2) (t:v) (f:everyday) (w:differ/be different/change) (d:be unlike something else, with <tawh> for what it differs from, or, after <hong>, become different, change; a verb of its own, not the {kidang koih} of sense 1) (s:kilamdang) (b:dang) (r:zd:8668/zd:26664/zd:20574) (q:draft)
kidawk = (i:2) (t:v) (f:social) (w:stand out/be prominent/be noticed) (d:of a person or a name, be noticed among others and become well known, often with <mahmah> or after <min>, name; not the coming into view of a hidden thing) (r:zd:22941/zd:24544/zd:19779) (q:draft)
kidawmsa = (i:1) (t:adj) (f:everyday/social) (w:wary/on guard/watchful/alert) (d:<kidawm>, be careful, with the ending {-sa}, already in that state: being on one's guard; {kidawmsa in om} is stay watchful) (b:kidawm) (r:zd:22459) (q:draft)
kidawmsiam = (i:1) (t:v) (f:everyday/social) (w:know how to be careful/take good care) (d:<kidawm>, be careful, with <siam>, skilled: be wisely careful, know how to guard oneself) (j:kidawm/siam) (r:zd:21409/zd:21015) (q:draft)
kidawmtak = (i:1) (t:adv) (f:everyday) (w:carefully/cautiously/watchfully) (d:<kidawm>, be careful, with <tak> making an adverb, written as one word: with care, taking heed) (j:kidawm/tak) (r:zd:23629/zd:24569) (q:draft)
kidawn = (i:1) (t:v) (f:food) (w:be drunk/drink) (d:<ki> with <dawn>, drink: is drunk, of water, tea or another drink, or people in general drink it) (j:ki/dawn) (r:zd:23249/zd:22650) (q:draft)
kidawn = (i:2) (t:v) (f:social/travel) (w:be met/be welcomed/be fetched) (d:<ki> with <dawn>, go to meet: be met on arrival, welcomed or fetched) (j:ki/dawn) (r:zd:16038/zd:16500) (q:draft, low confidence)
kidawp = (i:1) (t:v) (f:social/work) (w:be inquired about/be followed up/be taken up) (d:<dawp>, go to an office or a person to ask about a matter and follow it up, with the prefix <ki>: of a matter, be asked about or taken up; {kidawp thei hi} after a place, day or phone number says that inquiries can be made there) (r:zd:20190/zd:22593/zd:10892) (q:draft)
kidawp = (i:2) (t:v) (f:health/everyday) (w:be careful/take care/be on guard) (d:watch oneself against a danger such as an illness; {kidawp huai mahmah hi} is one must be very careful; probably another spelling of <kidop>) (s:kidawm/kidop) (r:zd:24609/zd:24489/zd:25932) (q:draft, low confidence)
kidawt = (i:1) (t:v) (f:everyday/health) (w:be stabbed/stab one another/stab oneself) (d:<dawt>, stab, with the prefix <ki>: be stabbed or pierced, stab each other, or with {amah leh amah} stab oneself) (b:dawt) (r:zd:21588/zd:23907) (q:draft)
kidawtkha = (i:1) (t:v) (f:health/everyday) (w:be stabbed/get stabbed) (d:<kidawt>, be stabbed, with <kha>, happen to: come to be stabbed) (j:kidawt/kha) (r:zd:21588/zd:12673) (q:draft)
kidawtlum = (i:1) (t:v) (f:politics/media) (w:be stabbed to death) (d:<dawtlum>, stab to death, with the passive <ki>: be killed by stabbing; common in news headlines) (b:dawtlum) (r:zd:11420/zd:12673) (q:draft)
kidawtna = (i:1) (t:n) (f:media/health) (w:stabbing/knife attack) (d:<kidawt>, stab one another or be stabbed, with the noun suffix <na>: a stabbing; often {temtawh kidawtna}, a stabbing with a knife) (b:kidawt) (r:zd:17701/zd:12829) (q:draft)
kidei = (i:1) (t:v) (f:social) (w:be separated/be divided/be set apart) (d:be kept apart or treated as different; mostly in {kidei danna}, a spelling of <kideidanna>, distinction or separation) (r:zd:20418/zd:12177) (q:draft, low confidence)
kideihlo = (i:1) (t:adj) (f:social) (w:unwanted/not wanted/unwelcome) (d:<kideih> and <lo> written as one word: is not wanted, is not welcome) (j:kideih/lo) (r:zd:23306/zd:11980/zd:12481) (q:draft)
kideihpen = (i:1) (t:adj) (f:everyday/media) (w:most popular/best loved/favourite/most wanted) (d:<kideih>, be wanted, with the superlative ending {-pen}, most: the one that is liked or wanted most, usually as {a kideihpen}) (b:kideih) (r:zd:9212/zd:9263) (q:draft)
kideihsak = (i:1) (t:v) (f:social) (w:wish one another well/care for one another/be wished) (d:<ki> and <deihsak> written as one word: want what is good for one another; also be wished something by others) (j:ki/deihsak) (r:zd:20406/zd:25678/zd:20979) (q:draft)
kideihsakna = (i:1) (t:n) (f:social) (w:goodwill/mutual care/kindness) (d:<kideihsak>, wish one another well, with the noun ending {-na}: caring for one another, goodwill) (b:kideihsak) (r:zd:23554/zd:20391) (q:draft)
kideihzaw = (i:1) (t:v) (f:everyday/work) (w:be preferred/be wanted more) (d:<kideih>, be wanted, and <zaw>, more, written as one word: be the one that is preferred) (j:kideih/zaw) (r:zd:14928) (q:draft)
kidelh = (i:2) (t:v) (f:everyday/social) (w:rush to/hurry after/give chase) (d:not passive: <delh> with {ki-} for people who set off together and in haste, to the place where something has happened, as {aphual kidelh}, rush to the scene, or after someone who runs away) (r:zd:25479/zd:14944/zd:15846) (q:draft)
kidelhpah = (i:1) (t:v) (f:media/travel) (w:rush to at once/hurry to the scene) (d:<kidelh> and <pah> written as one word: of fire and rescue teams, set out at once to the place of an accident) (j:kidelh/pah) (r:zd:17614/zd:21611) (q:draft)
kidemnate = (i:1) (t:n) (f:media/social) (w:competitions/contests) (d:<kidemna> with the plural <te>: competitions, contests) (b:kidemna) (j:kidemna/te) (r:zd:23057/ts:3375) (q:draft)
kidiah = (i:2) (t:v) (f:social/health) (w:be steeped in/be given over to/indulge in) (d:figurative use of {kidiah}: be sunk in drink, drugs or another habit, after {zu le sa tawh} or {guih theih kham theih}, not dipped in a real liquid) (r:zd:23301/zd:11403/zd:22649) (q:draft)
kidiahcip = (i:1) (t:v) (f:everyday) (w:be soaked/be steeped/be immersed) (d:<kidiah> and <cip> written as one word: be left soaking in a liquid or be drenched with it; also be immersed in work or in a state for a long time) (j:kidiah/cip) (r:zd:15560/zd:22079) (q:draft)
kidimcip = (i:1) (t:v) (f:everyday) (w:be completely filled/be covered all over) (d:<kidim> and <cip> written as one word: be filled or covered completely, with <tawh> for what fills or covers) (j:kidim/cip) (r:zd:15820/zd:12277) (q:draft)
Kidnap = (i:1) (t:n) (f:politics/media) (w:kidnapping/abduction) (d:the seizing of a person by force, often for ransom; {Kidnap bawl} is to kidnap and {Kidnap thuak} is to be kidnapped; in the articles it is written with a capital letter) (o:English) (r:zd:21554/zd:16676/zd:12159) (q:draft)
kidney = (i:1) (t:n) (f:body/health) (w:kidney) (d:the English word, written mostly as a gloss beside <kal>) (s:kal) (o:English) (r:zd:15305) (q:draft, low confidence)
kidong = (i:3) (t:v) (f:everyday/social) (w:be asked/be requested/ask) (d:<dong>, ask, with <ki> as a passive or impersonal form and not each other: a question is put or anyone may ask, as in {kidong thei hi}; with <sum> or <huhna> before it, money or help is asked for) (r:zd:16136/zd:24234/zd:23005) (q:draft)
kidongthei = (i:1) (t:v) (f:everyday/social) (w:can be asked/may enquire) (d:<kidong>, here be asked, and <thei>, able, written as one word: questions can be asked, one may enquire, common in notices as {kidongthei ding hi}) (j:kidong/thei) (r:ts:4379/zd:21540) (q:draft)
kidopding = (i:1) (t:v) (f:everyday/social) (w:to be careful/to beware/to take precautions) (d:<kidop>, be careful, and <ding>, will, written as one word: that one should be careful, and as a noun the things to be careful about) (j:kidop/ding) (r:zd:17735/zd:16225/zd:11759) (q:draft)
kidopna = (i:1) (t:n) (f:everyday/social) (w:caution/carefulness/precaution/self-restraint) (d:<kidop>, be careful, with the noun suffix <na>: the taking of care to avoid harm or wrong, a precaution; {gamtat kampau kidopna} is care in conduct and speech) (b:kidop) (r:zd:19975/zd:25304/ts:11873) (q:draft)
kidopsiam = (i:1) (t:v) (f:everyday/social) (w:be careful/take good care) (d:<kidop>, be careful, and <siam>, skilled, written as one word: know how to look after oneself and keep out of trouble) (j:kidop/siam) (r:zd:23005/zd:15356) (q:draft)
kidoptheih = (i:1) (t:v) (f:everyday/social) (w:be able to take care/be able to beware) (d:<kidop>, be careful, with <theih>, be able, written as one word, mostly before <nadingin>: so that people can be on their guard) (j:kidop/theih) (r:zd:18074/zd:16580) (q:draft)
kiduh = (i:1) (t:v) (f:food/everyday) (w:be craved/be desired/crave) (d:<duh>, hunger or thirst for, with the prefix <ki>: is craved, people long to eat or drink it) (j:ki/duh) (r:zd:22650/zd:19355) (q:draft)
kien = (i:1) (t:v) (f:everyday) (w:be looked at/be examined/look at oneself) (d:<ki> and <en> written as one word: be looked at or checked; with {amah le amah}, look at oneself) (j:ki/en) (r:zd:25873/zd:22858) (q:draft)
kiet = (i:1) (t:v) (f:everyday) (w:look at oneself/be looked at/be examined) (d:<ki> and <et> written as one word: look at oneself, as in a mirror, or be looked at and considered) (j:ki/et) (r:zd:21120/zd:19287) (q:draft)
Kiev = (i:1) (t:name) (c:city) (f:politics) (w:Kyiv/Kiev) (d:capital city of <Ukraine>) (r:ts:2690/zd:12772) (q:draft)
kifit = (i:1) (t:v) (f:social) (w:be fit/be qualified/be eligible) (d:be suitable or qualified for a position, after a verb with <ding>; {kifit lo} is not eligible; the prefix <ki> with the English word fit) (o:English, fit) (r:zd:12912/zd:22592) (q:draft, low confidence)
kigalmuh = (i:1) (t:v) (f:everyday/nature) (w:be seen from afar/be visible from a distance) (d:passive of <galmuh>, see from afar: be seen or be visible from far away, as smoke or a distant village; {kigalmuh thei} is can be seen from afar) (b:galmuh) (r:ts:4885/zd:11376/zd:24234) (q:draft)
kigamlatna = (i:1) (t:n) (f:travel) (w:distance/distance apart) (d:<kigamlat>, be far from, with <na>: how far two places or people are from each other) (b:kigamlat) (r:zd:16779/ts:1195/zd:17005) (q:draft)
kigawm = (i:5) (t:v) (f:social/everyday) (w:unite/merge/be combined/join together) (d:passive and mutual form of <gawm>, join: of people, groups or amounts, come together or be put together into one; the other senses are adverbs placed after the things named) (b:gawm) (r:zd:9135/zd:25097/zd:22412) (q:draft)
kigawm vekpi = (i:1) (t:adv) (f:everyday/media) (w:in total/altogether/combined) (d:<kigawm>, be joined together, and <vekpi>, all: placed after a list of two or more groups and before a number, gives the total of them all) (r:ts:9653/ts:4218) (q:draft)
kigawmkhawm = (i:1) (t:v) (f:social/politics) (w:join together/merge/unite/combine) (d:<kigawm>, be joined, with <khawm>, together: come together into one, said of groups, parties, voices or things) (b:kigawm) (r:zd:9213/zd:25218/zd:17630) (q:draft)
kigawmkhop = (i:1) (t:v) (f:social) (w:unite/join together/be united) (d:<kigawm>, be joined, with <khop>, together: come together as one; the form used before words such as <ding>, <nading> and <ciangin>) (b:kigawm) (r:zd:9258/zd:22291/zd:21228) (q:draft)
kigawmkhopna = (i:1) (t:n) (f:social/politics) (w:unity/unification/union) (d:<kigawmkhop>, join together, with the noun suffix {-na}: the joining of separate groups into one; one writer sets it apart from <kipumkhatna>, oneness) (b:kigawmkhop) (r:zd:11648) (q:draft)
kigawmna = (i:2) (t:n) (f:social/politics) (w:union/merger/combination) (d:<kigawm> with the noun suffix <na>, said of peoples, parties or churches: their joining into one body, or a combination of things, where nothing is counted up) (r:zd:10973/zd:22412/zd:13268) (q:draft)
kigawtna = (i:1) (t:n) (f:social) (w:mistreatment/torture/punishment) (d:<gawt>, afflict, with <ki> and the noun ending {-na}: being ill-treated, beaten or tortured) (b:gawt) (r:zd:19320/zd:12177) (q:draft)
kigel = (i:1) (t:v) (f:everyday/work) (j:kigeel) (r:zd:17075/zd:23437) (q:draft)
kigelhkhial = (i:1) (t:v) (f:education/media) (w:be misspelt/be written wrongly) (d:<kigelh>, be written, with <khial>, wrong, written as one word: be written with a mistake) (j:kigelh/khial) (r:zd:19917/zd:16966) (q:draft)
kigelhlo = (i:1) (t:v) (f:education/media) (w:not be written/not be recorded) (d:<kigelh>, be written, and <lo>, not, written as one word: is not written, is not stated in writing) (j:kigelh/lo) (r:zd:21067/zd:12967/zd:10735) (q:draft)
kigelhsak = (i:1) (t:v) (f:everyday/education) (w:be written on/have written/be written for) (d:<gelhsak>, have something written, with the prefix <ki>: something is written on a thing or for someone) (b:gelhsak) (r:zd:22685/zd:15095) (q:draft)
kigencian = (i:1) (t:v) (f:media/everyday) (w:be stated clearly/be confirmed/be made clear) (d:passive of <gencian>, explain clearly: be said exactly; {kigencian thei nai lo} is cannot yet be confirmed) (b:gencian) (r:ts:2027/ts:4653) (q:draft)
kigenkhia = (i:1) (t:v) (f:media/everyday) (w:be stated/be announced/be disclosed/be expressed) (d:passive of <genkhia>, speak out: be made known in words; {kigenkhia nailo} is has not yet been disclosed) (b:genkhia) (r:zd:26026/zd:15370/ts:3067) (q:draft)
kigenlo = (i:1) (t:v) (f:everyday/media) (w:not be said/not be stated) (d:<kigen>, be said, and <lo>, not, written as one word: it is not said, it has not been told or reported) (j:kigen/lo) (r:zd:12732/zd:12255) (q:draft)
kigenpih = (i:1) (t:v) (f:social) (w:be told/be spoken to/talk with one another) (d:<genpih>, speak to, with the prefix <ki>: be spoken to about something, or speak to one another) (b:genpih) (r:zd:17772/zd:13154) (q:draft)
kigensawn = (i:1) (t:v) (f:social/media) (w:be passed on/tell one another/spread) (d:<gensawn>, pass on, with <ki>: news is passed from one to another, people tell it on to each other) (b:gensawn) (r:zd:25342/zd:19642/zd:11924) (q:draft)
kigensiat = (i:1) (t:v) (f:social) (w:be slandered/be spoken ill of) (d:passive of <gensiat>: be spoken ill of by others; {hong kigensiat} is we are spoken ill of) (b:gensiat) (r:zd:9433/zd:22034/zd:19938) (q:draft)
kigenteh = (i:1) (t:v) (f:everyday/religion) (w:be compared/be likened) (d:passive of <genteh>, compare, with the prefix <ki>; what a thing is compared with is marked by <tawh>) (b:genteh) (r:zd:24199/zd:12370/zd:19772) (q:draft)
kigenthei = (i:1) (t:v) (f:everyday/media) (w:can be said/can be told) (d:<kigen>, be said, and <thei>, able, written as one word; mostly negated, as {kigenthei nailo}, cannot yet be said) (j:kigen/thei) (r:ts:4018/zd:25243/zd:22650) (q:draft)
kigi = (i:1) (t:n) (f:nature/home) (w:boundary/border) (d:the line where one piece of land ends and the next begins, as between fields or house plots) (s:gi) (r:zd:15402) (q:draft)
kigi = (i:2) (t:v) (f:nature/travel) (w:border on/share a boundary) (d:have a common boundary with something, which is followed by <tawh>) (r:zd:25472) (q:draft, low confidence)
kiginglopi = (i:1) (t:adv) (f:everyday/work) (w:without preparing/unprepared) (d:<kiging>, get ready, and <lopi>, without, written as one word, followed by <in>: without having prepared) (j:kiging/lopi) (r:zd:22778) (q:draft)
kigingnaomlo = (i:1) (t:adv) (f:everyday) (w:unprepared/without preparation) (d:<kiging>, prepare, with the noun ending {-na}, and <omlo>, without, written as one word: with no preparation made; seen in one notice that is repeated in several articles) (j:kiging/na/omlo) (r:zd:20418) (q:draft, low confidence)
kigingsain = (i:1) (t:adv) (f:everyday) (w:in readiness/ready) (d:<kigingsa> and <in> written as one word: being ready, on standby; {kigingsain om} is stand ready) (j:kigingsa/in) (r:zd:23278) (q:draft)
kigolh = (i:1) (t:v) (f:politics) (w:intervene/get involved/interfere) (d:enter into a conflict, an election or an affair of others and take a part in it) (r:zd:11318/zd:10890) (q:draft)
kigualzo = (i:1) (t:v) (f:everyday/social) (w:win/succeed/be victorious) (d:<gualzo>, win, with the prefix <ki>, said of people in general: one wins, there is success) (j:ki/gualzo) (r:zd:24990/zd:21343) (q:draft)
kiguang = (i:1) (t:v) (f:everyday) (w:be put in/be loaded/be included/be filled) (d:passive of <guang>, put in, with the prefix <ki>: be put into a container, a book or a list) (b:guang) (r:zd:9246/zd:16128/zd:19612) (q:draft)
kihal = (i:2) (t:v) (f:everyday/health) (w:be apart/keep apart/be spaced) (d:be at a distance from one another in space or time, after a measure such as {pi 6}, six feet, or {nipi kal khat}, one week; not the passive of <hal>, burn) (r:zd:24054/zd:21421/zd:25139) (q:draft)
kihanciam = (i:1) (t:v) (f:everyday/work) (w:strive/make an effort/be attempted) (d:<hanciam>, try hard, with the prefix <ki>: an effort is made, people strive together, without naming who) (b:hanciam) (r:ts:3085/zd:22711/zd:17345) (q:draft)
kihawh = (i:1) (t:v) (f:social/travel) (w:visit one another/be visited) (d:<hawh>, visit, with the prefix <ki>: people visit one another, or a visit is made to a person or place) (b:hawh) (r:zd:23767/zd:24610/zd:24209) (q:draft)
kihawmsawn = (i:1) (t:v) (f:social) (w:share/share with one another/be shared) (d:<hawmsawn>, share and pass on, with the prefix <ki>: share a thing, a thought or an experience with others, or be shared) (b:hawmsawn) (r:zd:24071/zd:19245/zd:24004) (q:draft)
kihawmthawh = (i:1) (t:v) (f:social) (w:feel slighted/be slighted/feel unappreciated) (d:<hawmthawh> with <ki>: feel that one is counted as too little, or be looked down on and not valued by others) (b:hawmthawh) (r:zd:21037/zd:16060) (q:draft, low confidence)
kihehpihna = (i:1) (t:n) (f:social/religion) (w:mutual compassion/kindness to one another) (d:<kihehpih>, have compassion on one another, with the noun ending {-na}: the compassion people show each other) (b:kihehpih) (r:zd:20818/zd:20827/zd:9124) (q:draft)
kiheii = (i:1) (t:v) (f:everyday) (j:kihei) (r:zd:26385/zd:21803) (q:draft)
kihel hamtang = (i:1) (t:v) (f:social) (w:be sure to take part/join without fail) (d:<kihel>, take part, and <hamtang>, insistently: take part without fail; used in invitations and notices, often as {hong kihel hamtang un}, please be sure to join) (r:zd:23494/zd:15396) (q:draft)
kihelding = (i:1) (t:v) (f:everyday/media) (w:will be included/will take part) (d:<kihel>, be included, and <ding>, will, written as one word: will be among, will take part; in reports also is said to be among) (j:kihel/ding) (r:zd:13125/zd:14665/zd:10828) (q:draft)
kihelkha = (i:1) (t:v) (f:everyday/social) (w:be included/be involved/get mixed in) (d:<kihel>, be included, and <kha> written as one word: come to be among a group or caught up in an event) (j:kihel/kha) (r:zd:18129/zd:23365/zd:21886) (q:draft)
kihelkhalo = (i:1) (t:v) (f:everyday/social) (w:not be included/not be among/not be involved) (d:<kihelkha>, be included, and <lo>, not, written as one word: not among those named, not caught up in the event) (j:kihelkha/lo) (r:zd:20703/zd:15187) (q:draft)
kihello = (i:1) (t:v) (f:everyday) (w:not be included/be left out/be absent) (d:<kihel> and <lo> written as one word: is not included, is not among, does not take part) (j:kihel/lo) (r:zd:11456/zd:16245/zd:11074) (q:draft)
kihelna = (i:1) (t:n) (f:social) (w:participation/involvement/inclusion/taking part) (d:<kihel>, take part or be included, with the noun ending {-na}: the taking part in something, or the thing or place in which one takes part) (b:kihel) (r:zd:23538/ts:1278/zd:23427) (q:draft)
kihelthei = (i:1) (t:v) (f:social/media) (w:can take part/be able to attend) (d:<kihel>, take part, and <thei>, able, written as one word: can take part, or was able to be present and join in) (j:kihel/thei) (r:zd:17893/ts:9677/zd:16598) (q:draft)
kihelzo = (i:1) (t:v) (f:social/media) (w:be able to take part/manage to join) (d:<kihel>, take part, and <zo>, be able, written as one word) (j:kihel/zo) (r:zd:20145/zd:15933) (q:draft)
kihemkhia = (i:2) (t:v) (f:everyday/nature) (w:evacuate/be evacuated/be moved out) (d:leave or be taken out of a place of danger such as a fire, an eruption or an attack, mostly after a number of people as in {mi 3000 val kihemkhia}; in this use it is the passive of <hemkhia>, move something out) (r:zd:15657/zd:17808/ts:5232) (q:draft)
kihi = (i:1) (t:v) (f:everyday) (w:one is/we are/people are) (d:<ki> and <hi> written as one word: the form of <hi>, be, that names no particular subject, said of people in general or of the speaker and hearers together) (j:ki/hi) (r:zd:24030/zd:24963/zd:10721) (q:draft)
kihilh = (i:2) (t:v) (f:social/education) (w:teach one another/tell one another) (d:reciprocal use of {kihilh}, not the passive, with a plural subject: people teach or tell each other, and {kihilh sawn} is pass the word on from one to another) (r:zd:12695/zd:17327/zd:25142) (q:draft)
kihilo = (i:1) (t:v) (f:everyday) (w:one is not/we are not) (d:<kihi> and <lo> written as one word: one is not, we are not, naming no particular subject) (j:kihi/lo) (r:zd:14611/zd:14805) (q:draft)
kihingmat = (i:1) (t:v) (f:politics) (w:be captured alive/be taken alive) (d:passive of <hingmat>: be taken alive, of fighters captured in battle; {a kihingmat} is one who was captured alive) (b:hingmat) (r:ts:9163/ts:4309/ts:10508) (q:draft)
kihmahmah = (i:1) (t:v) (f:everyday/social) (w:detest greatly/loathe/find disgusting) (d:<kih> and <mahmah> written as one word: detest very much, be strongly disgusted by) (j:kih/mahmah) (r:zd:15456/zd:15283) (q:draft)
kihodan = (i:1) (t:n) (f:social) (w:way of talking together/conversation/talks) (d:<kiho>, talk together, and <dan>, manner, written as one word: how people speak with each other, also what was agreed in talks) (j:kiho/dan) (r:zd:23977/zd:14814) (q:draft)
kiholim = (i:1) (t:v) (f:everyday/social) (w:converse/talk together/hold talks) (d:<holim>, converse, with the prefix <ki>: talk with one another; the other party is marked by <tawh>) (b:holim) (r:zd:10973/ts:9677/zd:25177) (q:draft)
kiholimna = (i:1) (t:n) (f:social/media) (w:conversation/talk/interview/discussion) (d:talking together at ease, a conversation or friendly discussion; in news also an interview, as in {tawh kiholimna}, conversation with) (s:kihona) (r:zd:22586/zd:25203/ts:12498) (q:draft)
kihong = (i:1) (t:v) (f:everyday/home) (w:open/be opened) (d:be open or be opened, said of a container, a door or gate, a tomb, the sky, and of eyes and ears; {a kihong} before a noun means open) (s:kihon) (a:kikhak) (r:40.27.52)
kihongding = (i:1) (t:v) (f:work/everyday) (w:will open/will be opened) (d:<kihong> and <ding> written as one word: will be open or will be opened, of a shop, a bank or an office) (j:kihong/ding) (r:zd:17836/zd:19648) (q:draft)
kihongkhia = (i:1) (t:v) (f:everyday/home) (w:come open/be opened) (d:<kihong>, be opened, with <khia>, out: come open or be opened up, said of a door, a bag or a load) (j:kihong/khia) (r:zd:14521/zd:19495) (q:draft)
kihongkik = (i:1) (t:v) (f:everyday) (w:reopen/be opened again) (d:<kihong>, be opened, and <kik>, again, written as one word: of a school, market or road, open again after being closed) (j:kihong/kik) (r:ts:10215/zd:11011) (q:draft)
kihonna = (i:1) (t:n) (f:everyday/religion) (w:opening) (d:<kihon>, be opened, with the noun suffix <na>: the opening of a door, of a way or of a chance; {mit kihonna} is the opening of the eyes) (b:kihon) (r:zd:12166/zd:21321/zd:24029) (q:draft)
kihosiamna = (i:1) (t:n) (f:social) (w:communication skill/ability to talk together/good dialogue) (d:<kiho>, talk together, with <siamna>, skill: the ability to talk things over well with others) (j:kiho/siamna) (r:zd:23485) (q:draft)
kihtaak = (i:1) (t:v) (f:everyday) (j:kihtak) (r:zd:20627/zd:22341) (q:draft)
kihtalo = (i:1) (t:v) (f:everyday/religion) (w:not fear/be unafraid) (d:<kihta> and <lo> written as one word: not fear, have no fear of) (j:kihta/lo) (r:zd:24392/zd:23860) (q:draft)
kihtat = (i:1) (t:v) (f:everyday/health) (w:fear/dread) (d:form of <kihta> used before a noun ending or a dependent word; {kihtat launa} is the fear or phobia of something) (b:kihta) (r:zd:24238) (q:draft, low confidence)
kihua = (i:1) (t:v) (f:social) (w:detest each other/be at enmity/be detested) (d:dislike strongly, of people who cannot stand one another, and of a thing that is found repulsive; often paired with <kimudah>) (s:kimudah) (r:zd:25611/zd:12784/zd:15358) (q:draft)
kihuai = (i:1) (t:v) (f:social) (w:look after one another/support one another/hold together) (d:care for and stand by each other, said of a people or community; often paired with <kidon> or <kikem>) (r:zd:24452/zd:25156/zd:17325) (q:draft, low confidence)
kihuatna = (i:1) (t:n) (f:social/politics) (w:mutual hatred/enmity/hostility) (d:<huat>, hate, with {ki-}, each other, and the noun suffix <na>: hatred between people or groups) (s:kimuhdahna) (r:zd:24227/zd:25580) (q:draft)
kiik = (i:1) (t:adv) (f:everyday) (j:kik) (r:zd:10973/zd:17152) (q:draft)
kiim = (i:2) (t:adv) (f:everyday) (w:about/approximately/around) (d:after a number, an amount or a time, shows that it is an estimate: {mi 20 kiim}, about 20 people, {kum 1500 kiim}, about 1500 years; in the other sense {kiim} follows a place or person) (r:zd:20145/zd:20410/zd:20572) (q:draft)
kiimin = (i:1) (t:adv) (f:everyday/time) (w:around/about/approximately) (d:<kiim> and <in> written as one word: around a place; after a number, year or time of day, about, approximately) (j:kiim/in) (r:zd:25393/zd:20821/zd:10772) (q:draft)
kiimlehpaam = (i:1) (t:n) (f:nature/social) (w:surroundings/environment/neighbourhood) (d:<kiim>, <leh> and <paam> written as one word: everything and everyone around one) (s:kimlepam) (j:kiim/leh/paam) (r:zd:19470/zd:16893) (q:draft)
kiimlepaam = (i:1) (t:n) (f:social/everyday) (w:surroundings/neighbourhood/environment) (d:<kiim>, <le> and <paam> written as one word: all that is around a person or place, the neighbourhood and the people in it) (j:kiim/le/paam) (r:zd:16321/zd:25534/ts:3125) (q:draft)
kiimpawl = (i:1) (t:adv) (f:time/everyday) (w:about/around/approximately/circa) (d:<kiim>, around, with <pawl>, written as one word and placed after a number, a year or a time: about that much, not exactly known) (j:kiim/pawl) (r:zd:21829/zd:13220/zd:24740) (q:draft)
kik = (i:1) (t:adv) (f:everyday) (w:again/back) (d:placed after a verb to show that the action is done again or turned back: {gen kik} is say again, {pia kik} is give back) (s:leuleu) (q:draft)
kik leuleu = (i:1) (t:adv) (f:everyday) (w:once again/yet again/back again) (d:<kik>, again or back, and <leuleu>, once more: placed after a verb, the action is done again or turned back another time, after it had already happened or been undone) (s:kik/leuleu) (r:zd:19244/ts:3369) (q:draft)
kikaal = (i:1) (t:adv) (f:everyday) (j:kikal) (r:zd:21347/zd:21511/zd:24283) (q:draft)
kikaapna = (i:1) (t:n) (f:social/politics) (j:kikapna) (r:zd:16192/zd:15458) (q:draft)
kikah = (i:3) (t:v) (f:education) (w:attend/be attended/go to) (d:<kah.2>, go up, with <ki>: of a school or a class, be attended, people go to it, as in {sang kikah}, compare <sangkah>; {kikah sak} is have someone attend; nobody weeps) (r:zd:11775/zd:14921/zd:20264) (q:draft)
kikahsak = (i:1) (t:v) (f:social/politics/education) (w:be allowed to attend/be sent to attend) (d:<ki> with <kahsak>: be let or sent to attend a meeting or a school) (b:kahsak) (j:ki/kahsak) (r:zd:20328/zd:25097) (q:draft)
kikai = (i:2) (t:v) (f:everyday/politics) (w:be drawn/be fenced/be signed) (d:of a line, be drawn: {dai kikai} is a fence or boundary is put up and {suai kikai} is a signature is put, a thing is signed; no person is led away) (r:zd:16680/zd:11005/zd:22580) (q:draft, low confidence)
kikalbang = (i:1) (t:adv) (f:everyday) (w:about between/somewhere between) (d:<kikal>, between, and <bang>, about, written as one word after two numbers joined by <leh> or <pan>: roughly between the one and the other) (j:kikal/bang) (r:zd:13022/zd:13334) (q:draft)
kikalpawl = (i:1) (t:adv) (f:time/everyday) (w:somewhere between/roughly between) (d:<kikal>, between, and <pawl>, here about, written as one word after two ages, years or times joined by <leh>: somewhere in the range between the two) (j:kikal/pawl) (r:zd:12437/zd:16580/zd:15886) (q:draft)
kikalpen = (i:1) (t:phrase) (f:everyday/travel) (w:between) (d:<kikal>, between, and the topic marker <pen> written as one word after two places or things: as for the stretch between them) (j:kikal/pen) (r:zd:17822/zd:17941) (q:draft)
kikalsuan = (i:1) (t:v) (f:social/everyday) (w:proceed/go forward/advance) (d:<kalsuan>, take a step, with the prefix <ki>: go forward, said of people together, of a movement or of a piece of work; proceed, carry on) (b:kalsuan) (r:zd:16588/zd:10743/zd:20281) (q:draft)
kikanding = (i:1) (t:v) (f:politics/everyday) (w:will be investigated/to be looked into) (d:<kikan>, be investigated, and <ding>, will, written as one word: a matter will be looked into) (j:kikan/ding) (r:zd:19324/zd:20164) (q:draft)
kikankhia = (i:1) (t:v) (f:politics/media) (w:be found out/be investigated/be traced) (d:passive of <kankhia>, search out, with the prefix <ki>: a person or matter is looked into until it is found out) (b:kankhia) (r:zd:13024/zd:15568) (q:draft)
kikanpih = (i:1) (t:v) (f:social/politics) (w:be followed up/be looked into for someone) (d:<kikan>, be investigated, with <pih>, for or together with someone: the case of a person held in prison or a camp is enquired into on that person's behalf) (b:kikan) (r:zd:22685) (q:draft, low confidence)
kikansan = (i:1) (t:v) (f:media/politics) (w:be under investigation/be being investigated) (d:<kikan>, be investigated, with the ending {-san}, still going on: the matter is being looked into at present; mostly as {kikansan laitak}, is now under investigation) (b:kikan) (r:zd:18145/zd:12117/ts:1919) (q:draft)
kikap = (i:2) (t:v) (f:politics) (w:exchange fire/fight/shoot at each other/clash) (d:reciprocal of <kap>, shoot: two sides shoot at each other, with <tawh> for the other side; {nasiatak kikap} is fight fiercely) (r:ts:3110/zd:25097/ts:4892) (q:draft)
kikapgawp = (i:1) (t:v) (f:politics/media) (w:be shot many times/exchange heavy fire/shoot at each other) (d:<kikap>, be shot or shoot at each other, and <gawp>, severely, written as one word: be shot at again and again, or fight each other with guns) (j:kikap/gawp) (r:zd:16325/zd:20219) (q:draft)
kikapkha = (i:1) (t:v) (f:politics/health) (w:be hit by a shot/get shot) (d:<kikap>, be shot, with <kha>, here happen to: be struck by a bullet or a shell) (b:kikap) (r:zd:11936/zd:19868/zd:15833) (q:draft)
kikapkhia = (i:1) (t:v) (f:politics) (w:be shot down) (d:<kikap>, be shot, and <khia>, out, written as one word: of an aircraft, be shot down) (j:kikap/khia) (r:zd:12772/ts:5564) (q:draft)
kikapliam = (i:1) (t:v) (f:health/politics) (w:be shot and wounded) (d:<kikap> and <liam> written as one word: be hit by a shot and wounded, not killed) (j:kikap/liam) (r:zd:11812/zd:21328) (q:draft)
kikaplupna = (i:1) (t:n) (f:politics/media) (w:fatal shooting/shooting dead) (d:<kaplupna>, shooting dead, with the prefix <ki>: an incident in which someone is shot dead; often {thautawh kikaplupna}) (b:kaplupna) (r:zd:17969/zd:19324) (q:draft)
kikapsak = (i:1) (t:v) (f:politics) (w:be fired on/be shot at/shoot at each other) (d:<kikap>, be shot, with <sak>, written as one word: a place or thing is fired on or shelled; of two sides, they fire at each other) (j:kikap/sak) (r:zd:10884/zd:17868) (q:draft)
kikaptuah = (i:1) (t:v) (f:politics) (w:exchange fire/shoot at each other/clash) (d:<kikap> with <tuah>, meet: shoot at one another, of two armed sides that meet and fight) (j:kikap/tuah) (r:ts:10733/zd:10857) (q:draft)
kikaptuahna = (i:1) (t:n) (f:politics) (w:clash/firefight/exchange of fire) (d:shooting at each other when two armed sides meet: an armed clash) (s:kikapna) (r:ts:5264/ts:12263/ts:9312) (q:draft)
kikaptuak = (i:1) (t:v) (f:politics) (w:shoot at each other/exchange fire) (d:<kikap>, shoot one another, and <tuak>, each, written as one word: the two sides fire at each other) (j:kikap/tuak) (r:zd:14718/zd:19025) (q:draft)
kikawk = (i:1) (t:v) (f:social) (w:blame one another/accuse one another/point fingers) (d:<kawk>, point at, with the prefix <ki>: point at one another, put the blame on each other; also as a noun, mutual blame) (b:kawk) (r:zd:23765/zd:12370) (q:draft)
kikawm = (i:2) (t:v) (f:travel/social) (w:go between/be linked/have contact with) (d:go to and from one another, of places joined by a road or of people who visit and deal with each other, not of a thing on loan; {kikawm nading lampi} is a road linking two places, and <tawh> marks the other party) (r:zd:24249/zd:22709/zd:9265) (q:draft)
kikawmna = (i:1) (t:n) (f:travel) (w:transport/communication/travel between places) (d:going to and fro between places, and the means for it: <khuasung kikawmna> is transport within a city and {kikawmna lampi} a road that links places) (r:ts:301/zd:20703/zd:24963) (q:draft)
kikciangin = (i:1) (t:conj) (f:everyday/time) (w:when again) (d:<kik>, again or back, with <ciangin>, when, written as one word: when something happens again or in return) (j:kik/ciangin) (r:zd:23943) (q:draft)
kikding = (i:1) (t:part) (f:everyday) (w:will again/will back) (d:<kik>, again or back, and <ding>, the marker of what is to come, written as one word after a verb: will do it again, will come or give back) (j:kik/ding) (r:zd:18050/zd:12031/zd:19949) (q:draft)
kikek = (i:1) (t:v) (f:everyday) (w:be torn/be split/be widened) (d:be torn or split open, of cloth, a knee or a country; of a road, be opened out wider) (b:kek) (r:zd:12177/zd:11409) (q:draft)
kikem = (i:2) (t:v) (f:health) (w:be cared for/be treated/be kept) (d:passive of <kem>: be looked after or kept by others, with <ah> for the place, as a patient in a hospital; not guarding oneself) (r:zd:17703/zd:9251) (q:draft)
kikembit = (i:1) (t:v) (f:everyday/health/politics) (w:be kept safe/keep oneself safe/be secured) (d:<kikem>, be kept or keep oneself, with <bit>, safe: be guarded securely, of a person, a thing or a captured town) (j:kikem/bit) (r:zd:24453/ts:11032) (q:draft)
kikemcip = (i:1) (t:v) (f:politics/everyday) (w:be detained/be kept in custody/be kept safely) (d:{ki-} form of <kemcip>, keep fast: be kept and not let go, said of a person held by the police or kept in hospital, and of a thing stored away) (b:kemcip) (r:zd:16164/zd:11373/zd:19837) (q:draft)
kikemlai = (i:1) (t:v) (f:health/everyday) (w:still be kept/still be cared for) (d:<kikem>, be kept or looked after, and <lai>, here still, written as one word: is still being kept or cared for, as in a hospital or in custody) (j:kikem/lai) (r:zd:12117/zd:17299/zd:16490) (q:draft)
kikemphot = (i:1) (t:v) (f:politics/health) (w:be held for now/be kept for the time being) (d:<kikem>, here be kept or held, with <phot>, for the time being, written as one word: a person is held in custody, in hospital or in a shelter until the next step) (j:kikem/phot) (r:zd:19960/zd:11470/zd:15431) (q:draft)
kikeng = (i:1) (t:v) (f:everyday/travel) (w:be taken along/be carried/be brought) (d:passive of <keng> with <ki>: be taken or brought along with one) (b:keng) (r:zd:24053/zd:25393) (q:draft)
kikepding = (i:1) (t:v) (f:everyday/health) (w:to keep oneself safe/to protect oneself) (d:<kikep> and <ding> written as one word: to look after or protect oneself, often after <bangci>, how) (j:kikep/ding) (r:zd:17107/zd:19172) (q:draft)
kikepna = (i:2) (t:n) (f:health/social/work) (w:care/keeping/storage/custody) (d:the keeping of people or things by others, not of oneself: the care of the sick, the old or children, or the storing of goods; before a word for a building it names the place, as {piteekte kikepna inn}, a home for old women, and {cidam kikepna} is health care) (r:zd:9223/zd:20428/zd:22464) (q:draft)
kikepsiam = (i:1) (t:v) (f:health/everyday) (w:take good care of oneself/look after oneself well) (d:<kikep>, keep oneself, and <siam>, skilled, written as one word: know how to look after oneself) (j:kikep/siam) (r:zd:25169/zd:17107) (q:draft)
kikepzia = (i:1) (t:n) (f:health/everyday) (w:way of taking care of oneself/self-care/precautions) (d:<kikep> and <zia> written as one word: the way to look after or protect oneself) (j:kikep/zia) (r:zd:24365/zd:24079) (q:draft)
kikeuh = (i:1) (t:adv) (f:everyday) (w:at all/whatsoever/absolutely) (d:placed after a verb and before <lo>, or after <omlo>: strengthens the negative, not at all, none whatsoever) (r:zd:9425/zd:24740) (q:draft, low confidence)
kikhaam = (i:1) (t:v) (f:politics/social) (j:kikham) (r:zd:20418/zd:23754/zd:24283) (q:draft)
kikhah = (i:2) (t:v) (f:media/it) (w:be broadcast/be aired/be put out) (d:of a programme, video or news: be sent out to the public by television, radio or the internet, often with {live in} or <online>; not a person or animal set free) (r:zd:17788/zd:17344/zd:24428) (q:draft)
kikhahkhia = (i:2) (t:v) (f:media/it) (w:be posted/be published/be put out) (d:of a video, a photo or a text: be put out for the public to see, mostly on social media, as in {Video kikhahkhia} and {Social Media ah kikhahkhia}; not said of a prisoner) (r:zd:20132/zd:18038/zd:15216) (q:draft)
kikhai = (i:2) (t:v) (f:everyday) (w:differ/be far apart/be unlike) (d:of two things that are compared, joined by <tawh> or <leh>: be far from each other, not alike; often with <mahmah>, very, or with <sa>, feel) (s:kilamdang) (r:zd:16682/zd:18952/zd:18175) (q:draft)
kikhaih = (i:1) (t:v) (f:everyday/food) (w:be filtered/be strained/be sifted) (d:<khaih> with the passive <ki>: be strained or filtered; of people in a contest, be sifted out round by round) (j:ki/khaih) (r:zd:14928/zd:24082) (q:draft, low confidence)
kikhaihna = (i:1) (t:n) (f:social/everyday) (w:difference/gap/disparity) (d:what sets two things or groups apart, the distance between them; {dinmun kikhaihna} is a difference in standing) (s:kilamdanna) (r:zd:22391/zd:13147) (q:draft)
kikhaikim = (i:1) (t:v) (f:everyday/social) (w:be balanced/be evenly matched/be in proportion) (d:be weighed out equal: two sides are even, or one thing keeps pace with another) (r:zd:24714/zd:20886) (q:draft, low confidence)
kikhailua = (i:1) (t:v) (f:everyday/family) (w:differ too much/be too far apart) (d:<kikhai> in the sense be far apart from each other, not be hanged, with <lua>, too much: of ages or strength, the gap between two is very great) (j:kikhai/lua) (r:zd:17886/zd:13260) (q:draft, low confidence)
kikhak = (i:2) (t:v) (f:everyday/work) (w:be sent/be remitted) (d:<khak> in the sense send, with the passive <ki>: of a letter, a message or money, be sent to someone; the thing sent stands before it, as in {lai kikhak} and {sum kikhak}, while a place or office before it gives the sense be closed) (r:zd:17410) (q:draft, low confidence)
kikhakding = (i:1) (t:v) (f:everyday/work) (w:will be closed/will be shut) (d:<kikhak>, be shut, and <ding> written as one word: will be closed, said of an office, clinic or embassy on a holiday) (j:kikhak/ding) (r:zd:14949/zd:13124/zd:12231) (q:draft)
kikhakna = (i:2) (t:n) (f:social/media) (w:sending/sending off) (d:<kikhak> in its other meaning, be sent, with the noun suffix <na>: the sending of a letter, {lai kikhakna}, or the sending off of a bride, {mo kikhakna}; not a shutting) (r:zd:24347/zd:11133) (q:draft, low confidence)
kikhaksak = (i:1) (t:v) (f:social/politics) (w:be closed/be shut down) (d:<kikhak>, be shut, with <sak>, cause, written as one word: be made to close, said of schools, airports, churches and shops closed by order) (b:kikhak) (j:kikhak/sak) (r:zd:15342/zd:17707/zd:23843) (q:draft)
kikhal = (i:1) (t:v) (f:social/everyday) (w:restrain oneself/control oneself/exercise self-control) (d:hold oneself back and keep oneself in check; {kikhal zawhna} and {kikhal na} are self-control) (r:zd:23653/zd:23113/zd:11687) (q:draft)
kikhanding = (i:1) (t:v) (f:everyday/politics) (w:will be increased/will be raised/will be stepped up) (d:<kikhan>, be enlarged, and <ding> written as one word: will be increased or raised, of security, a number, an age limit or a fee) (j:kikhan/ding) (r:zd:19018/zd:19818) (q:draft)
kikhang = (i:1) (t:v) (f:everyday/work) (w:increase/be raised/grow) (d:<khang>, increase, with the prefix <ki>: grow or be made greater; {kikhang sak} is raise a price or amount) (j:ki/khang) (r:zd:25790/zd:14887) (q:draft)
kikhangto = (i:2) (t:v) (f:social) (w:develop/progress/advance) (d:<khangto> with the prefix <ki>, said of people in general: a people, a country or a life develops and moves forward, with no thought of one man being raised on high) (s:khantoh) (r:zd:15992/zd:11548/zd:9453) (q:draft)
kikhanto = (i:1) (t:v) (f:everyday/work) (w:be extended/be raised/be increased) (d:<kikhan>, be extended, with <to>, upward, written as one word: a time, a level or an amount is extended or raised) (j:kikhan/to) (r:zd:18274/zd:16515) (q:draft)
kikhasiat = (i:1) (t:v) (f:social) (w:be saddened/be grieved/be upset) (d:<khasia>, be troubled in spirit, with <ki>: feel grieved or upset, also with one another) (b:khasia) (r:zd:24231/zd:22868) (q:draft, low confidence)
kikhawina = (i:1) (t:n) (f:nature/work) (w:rearing place/farm/enclosure) (d:<kikhawi>, be kept or reared, with the noun ending {-na}: the keeping of animals, and placed after the name of the animal the place where it is kept, as {ak kikhawina}, a chicken farm) (b:kikhawi) (r:zd:11679/zd:11044) (q:draft)
kikhawl = (i:3) (t:v) (f:everyday/politics) (w:stop/cease/be halted) (d:come to a stop, of fighting, an advance or an activity: <ki> with <khawl>, stop or rest; without <tawh>, and often with {nai lo}, not yet) (r:ts:5513/ts:1485/ts:4298) (q:draft)
kikhawlh = (i:1) (t:v) (f:social) (j:kikholh) (r:zd:8667/zd:22540) (q:draft)
kikhawlkhawl = (i:1) (t:v) (f:social) (w:keep company with/spend time with/associate with) (d:<kikhawl> with its last part repeated: keep on being in the company of someone, spend time together again and again; the companion is marked by <tawh>) (b:kikhawl) (r:zd:26585/zd:13154) (q:draft)
kikhawlkhawm = (i:1) (t:v) (f:social) (w:keep company together/spend time together) (d:<kikhawl> and <khawm> written as one word: be in one another's company, stay together) (j:kikhawl/khawm) (r:zd:16673) (q:draft)
kikhawlsak = (i:3) (t:v) (f:work/politics) (w:be dismissed/be suspended/be removed from office) (d:of a person with a post or job: be made to stop working, be dismissed or suspended, often with {nasepna panin}, from work; of work or a project, be halted) (r:zd:18104/zd:19506/zd:17848) (q:draft)
kikhawngpen = (i:1) (t:adj) (f:media/work) (w:best-selling/most sold) (d:<kikhawng>, be sold, with <pen>, most, written as one word: the one that sells most, said of books) (j:kikhawng/pen) (r:zd:21670/zd:9213) (q:draft)
kikheelkheel = (i:1) (t:v) (f:everyday) (w:keep changing/change again and again) (d:<kikheel>, change, with its last part said twice: change time after time) (b:kikheel) (r:zd:22803/zd:21074) (q:draft)
kikheelna = (i:1) (t:n) (f:everyday/social) (w:change/variation/transformation) (d:<kikheel>, change, with the noun ending {-na}: a change in a thing, a person or a state of affairs) (s:kikhelna) (b:kikheel) (r:zd:11891/zd:15458) (q:draft)
kikhei = (i:1) (t:v) (f:health/body) (w:be cut open/be taken out/be dissected) (d:<khei>, dig out, with the prefix <ki>: a body is opened for examination, as in {aluang kikhei}, or a part of the body is taken out; with <khia> it is be gouged out) (j:ki/khei) (r:zd:11814/zd:17483) (q:draft, low confidence)
kikhek = (i:2) (t:v) (f:everyday) (w:be changed/change) (d:become different or be altered, of a name, a law, a programme or a way of thinking, not one thing given for another; {A pan in B in kikhek} is be changed from A to B) (s:kikhel) (r:zd:22818/zd:25078) (q:draft)
kikhello = (i:1) (t:v) (f:everyday) (w:not change/be unchanged) (d:<kikhel>, change, and <lo>, not, written as one word: does not change, stays the same) (j:kikhel/lo) (r:zd:15422/zd:15274) (q:draft)
kikhelnate = (i:1) (t:n) (f:social/politics) (w:changes) (d:plural of <kikhelna>, change) (b:kikhelna) (r:zd:21605/zd:25078) (q:draft)
kikhelta = (i:1) (t:v) (f:everyday) (w:have changed/be changed) (d:<kikhel> with the completive <ta> written as one word: has changed, is now changed) (j:kikhel/ta) (r:zd:20418/zd:19316/zd:20565) (q:draft)
kikhemna = (i:1) (t:n) (f:social/it) (w:deception/fraud/scam/hoax) (d:<kikhem>, deceive one another, with the noun suffix {-na}: an act of deceiving people, a fraud, scam or hoax) (s:khemna) (b:kikhem) (r:zd:14728/zd:22746/zd:25016) (q:draft)
kikhen = (i:2) (t:v) (f:media) (w:be printed/be published) (d:<khen> in its meaning print, with the prefix <ki>: of a book or hymnbook, be printed or published, mostly after a year as in {1876 kuma kikhen}, printed in 1876) (r:zd:9262) (q:draft, low confidence)
kikhen = (i:3) (t:v) (f:politics) (w:be judged/be decided) (d:after <thu>, matter, the passive of <thukhen>, judge: a case is heard and decided in court; {thu kikhen} is judgment being given) (r:zd:21125) (q:draft, low confidence)
kikhending = (i:1) (t:v) (f:social/family) (w:will separate/be divided) (d:<kikhen> and <ding> written as one word: will separate or divorce, to part; of a thing, will be divided) (j:kikhen/ding) (r:zd:20363/zd:23439) (q:draft)
kikheng = (i:1) (t:v) (f:everyday) (w:change/be exchanged/interchange) (d:change into something else or be exchanged one for another) (r:zd:22713) (q:draft, low confidence)
kikheng = (i:2) (t:v) (f:everyday) (w:be passed by/be passed over) (d:<kheng>, go past, with the prefix <ki>: be passed by or missed; of a border, be crossed by each side) (b:kheng) (r:zd:15035) (q:draft, low confidence)
kikhenkham = (i:1) (t:v) (f:social/politics) (w:be divided/split apart/break up) (d:<khenkham>, split in two, with the prefix <ki>: be split apart, said of a people, a country or the world) (s:kiphelkhap) (b:khenkham) (r:zd:24283/zd:10833/zd:19998) (q:draft)
kikhenkhap = (i:1) (t:v) (f:social/politics) (w:be divided/split up/break apart) (d:of a people, a land or a group: be divided into separate parts, split apart from one another; built on <kikhen>, divided) (r:zd:22709/zd:24733) (q:draft)
kikhenkhapna = (i:1) (t:n) (f:social/politics) (w:division/disunity/split/break-up) (d:the state of being split apart from one another, from <kikhen>, be divided; said of a people, a group or a country) (r:ts:7676/zd:15874) (q:draft)
kikhenkhen = (i:1) (t:v) (f:social/religion) (w:split up/be divided/keep separating) (d:<kikhen>, be divided, with <khen> doubled: split again and again into separate groups, said of churches, parties and people) (b:kikhen) (r:zd:25580/zd:21095) (q:draft)
kikhensat = (i:1) (t:v) (f:social/politics) (w:be decided/be resolved) (d:passive of <khensat>, decide, with the prefix <ki>: a matter is decided, mostly by a meeting) (b:khensat) (r:zd:21159/zd:13207/zd:15407) (q:draft)
kikhentat = (i:2) (t:v) (f:social/everyday) (w:be decided/be resolved/be settled) (d:passive of <khentat>, decide: a matter, a date or a course of action is decided, often after <dingin>; not the cutting off of flowing water) (r:zd:21598/zd:24977/zd:24943) (q:draft)
kikhente = (i:1) (t:n) (f:social/family) (w:those who are separated/the divided/the parted) (d:<kikhen>, separated, with the plural ending <te>: people or things that are parted from one another; {nupa kikhente} is couples who have separated) (b:kikhen) (r:zd:24059/zd:21369) (q:draft)
kikhenthaang = (i:1) (t:v) (f:social) (j:kikhenthang) (r:zd:24068/zd:22785) (q:draft)
kikhenthei = (i:1) (t:v) (f:everyday) (w:can be divided/be classified) (d:<kikhen> and <thei> written as one word: can be divided into kinds or groups; the number of kinds stands before it with <in>) (j:kikhen/thei) (r:zd:22019/zd:14720) (q:draft)
kikhet = (i:1) (t:v) (f:media/education) (w:be printed/be published) (d:form of <kikhen>, be printed, used before <ciangin>, <zawh>, <lai> and similar words: of a book or a song, be printed or published) (r:zd:9254/zd:9262) (q:draft)
kikhia = (i:3) (t:v) (f:politics) (w:be cast/be voted) (d:of votes, be cast in an election or in a house of parliament, after <mee> or <vote>) (r:zd:24681/zd:22818) (q:draft)
kikhia = (i:4) (t:v) (f:education) (w:be interpreted/be explained) (d:be given a meaning, with <khiatna> or <deihna> before it: be understood or explained in a certain way) (r:zd:22597/zd:25687) (q:draft, low confidence)
kikhiallo = (i:1) (t:v) (f:everyday) (w:not be wrong/not be mistaken) (d:<kikhial>, be mistaken, and <lo>, not, written as one word; mostly in {cileng kikhiallo ding hi}, it would not be wrong to say) (j:kikhial/lo) (r:zd:24457/zd:12436) (q:draft)
kikhiatsuk = (i:1) (t:v) (f:everyday) (w:be dropped/be thrown down/be lowered) (d:<ki> and <khiatsuk> written as one word: be dropped, lowered or thrown down from above) (j:ki/khiatsuk) (r:zd:12869) (q:draft)
kikhin = (i:2) (t:v) (f:time) (w:be postponed/be rescheduled/be put off) (d:of a date, a deadline or a planned event, be moved to another time, mostly a later one, with <to> after {kikhin}; not a move from place to place) (r:zd:24500/zd:23808) (q:draft)
kikhinto = (i:1) (t:v) (f:time) (w:be postponed/be extended/be put off) (d:<kikhin>, be moved, with <to>: of a date or deadline, be moved to a later time) (j:kikhin/to) (r:zd:13186/zd:23659) (q:draft)
kikhoina = (i:1) (t:n) (f:health/social) (w:care/nurture/treatment) (d:<kikhoi> with the noun ending {-na}: the caring for and looking after of people, mostly in the pair {kikep kikhoina}, care and keeping) (b:kikhoi) (r:zd:23528/zd:25228) (q:draft)
kikholhkhop = (i:1) (t:v) (f:social) (w:keep company together/associate with/spend time together) (d:<kikholh>, keep company, and <khop>, together, written as one word; the form used before words such as <nading> and <sangin>) (j:kikholh/khop) (r:zd:21568/zd:9434) (q:draft)
kikhop = (i:2) (t:n) (f:religion) (w:service/worship service/meeting) (d:a church service or meeting as an event, a noun without the suffix <na>; {kikhop hun} is the time of the service and {zingsang kikhop} is the morning service) (s:kikhopna) (r:zd:15637/zd:23446/zd:17047) (q:draft)
kikhopna = (i:1) (t:n) (f:social) (w:meeting/assembly) (d:A gathering of people who come together, or the place where they gather) (s:kikaihkhopna) (r:4.16.43) (q:draft)
kikhoppi = (i:1) (t:n) (f:social/politics/religion) (w:conference/general meeting/assembly) (d:<kikhop>, gather, with <pi>, great: a large formal meeting of a people, a church or an organisation; {kumcin kikhoppi} is an annual meeting) (r:zd:8375/zd:22470) (q:draft)
kikhoppite = (i:1) (t:n) (f:social/religion) (w:conferences/meetings/assemblies) (d:<kikhoppi>, conference, with the plural <te>) (b:kikhoppi) (j:kikhoppi/te) (r:zd:9263/zd:9253) (q:draft)
kikhual = (i:1) (t:v) (f:social) (w:care for one another/be considerate/look after oneself) (d:<khual>, have regard for, with the prefix <ki>: have regard for one another; also look after or provide for oneself, as {amah bek a kikhual mi}, a person who thinks only of himself) (r:zd:20979/zd:23758/zd:23989) (q:draft)
kikhuasuak = (i:1) (t:v) (f:social/work) (w:succeed/get on in life) (d:<khuasuak>, succeed, with the prefix <ki> in its general use: one succeeds, people get on in life) (b:khuasuak) (r:zd:16779/zd:25063) (q:draft)
kikhumcipna = (i:1) (t:n) (f:health/social) (w:confinement/lockdown/quarantine) (d:<kikhumcip> with the noun ending <na>: the state or place of being shut in) (b:kikhumcip) (r:zd:24004/zd:24278) (q:draft)
kikhupna = (i:1) (t:n) (f:social/politics) (j:kikupna) (r:zd:24648) (q:draft)
kikia = (i:1) (t:v) (f:politics/everyday) (w:be put in prison/be dropped/fall behind) (d:<kia>, fall, with the prefix <ki>: {thong kikia} is be sent to prison and {thong kikia sak} sentence to prison; also fall behind others or be failed in an examination) (b:kia) (r:zd:25481/zd:14554/zd:12912) (q:draft)
kikih = (i:1) (t:v) (f:everyday/body) (w:be disgusting/be loathed/be found revolting) (d:<kih>, loathe, with the prefix {ki-}: people feel disgust at it, it is found disgusting) (b:kih) (r:zd:24383/zd:23865) (q:draft)
kikik = (i:1) (t:adv) (f:everyday) (j:kikkik) (r:zd:9448/zd:24420) (q:draft)
kikilh = (i:1) (t:v) (f:home/work) (w:be nailed/be fastened) (d:<kilh> with the prefix <ki>: be nailed or fastened together; {kikilh khawm} is be joined together with nails) (b:kilh) (r:zd:17779/zd:22589) (q:draft)
kikimlo = (i:1) (t:adj) (f:everyday/social) (w:unequal/not equal/uneven) (d:<kikim>, equal, and <lo>, not, written as one word) (j:kikim/lo) (r:ts:11942/zd:12337) (q:draft)
kikimlohna = (i:1) (t:n) (f:social) (w:inequality/imbalance) (d:<kikim>, equal, with <lohna>, the state of not being: the state of not being equal) (j:kikim/lohna) (r:ts:2963/zd:24110) (q:draft)
kikimna = (i:1) (t:n) (f:social/politics) (w:equality/equivalence/balance) (d:<kikim>, equal, with the noun suffix <na>: the state of being equal; {liangko kikimna}, shoulders level, is equal standing, and {numei pasal liangko kikimna} is equality of women and men) (b:kikim) (r:zd:21462/zd:23356/zd:25188) (q:draft)
kikipsak = (i:3) (t:v) (f:politics/media) (w:be confirmed/be approved/be decided) (d:of a report, a number, a decision or an appointment: be declared certain or officially settled, not of a thing set firmly in its place) (r:zd:17359/zd:23155/ts:4411) (q:draft)
kikni = (i:1) (t:phrase) (f:everyday) (w:let us ... again) (d:<kik>, again, with the ending {-ni}, let us, written as one word after a verb: let us do it again, we will do it again) (r:zd:11625/zd:20905) (q:draft)
kikni = (i:2) (t:phrase) (f:time) (d:<kik>, again, and <ni>, day, written as one word: the day on which something happens again) (j:kik/ni) (r:zd:17432) (q:draft, low confidence)
kiknuam = (i:1) (t:v) (f:everyday) (w:want to do again/want to go back) (d:<kik>, again or back, and <nuam>, want, written as one word after a verb: want to do it again or in return) (j:kik/nuam) (r:zd:15163/zd:17841) (q:draft)
kikoihding = (i:1) (t:v) (f:everyday/politics) (w:will be placed/will be stationed/will be kept) (d:<kikoih>, be put or placed, and <ding> written as one word: will be placed, set up, stationed or kept somewhere) (j:kikoih/ding) (r:zd:20293/zd:14846) (q:draft)
kikoihlo = (i:1) (t:v) (f:everyday) (w:not be put/not be kept/not be placed) (d:<kikoih>, be put or kept, and <lo>, not, written as one word) (j:kikoih/lo) (r:zd:12955/zd:12589) (q:draft)
kikpah = (i:1) (t:adv) (f:everyday) (w:again at once/right back/straight away again) (d:<kik> and <pah> written as one word after a verb: the action is done again or in return, and at once) (j:kik/pah) (r:zd:23935/zd:17239) (q:draft)
kikpan = (i:1) (t:adv) (f:everyday/time) (w:again only then/back at last) (d:<kik>, again or back, with <pan> in the sense only just, written as one word after a verb: done again or back only at the time named) (j:kik/pan) (r:zd:19447/zd:19300) (q:draft, low confidence)
kiksawm = (i:1) (t:v) (f:everyday) (w:try again/intend to do again) (d:<kik>, again, and <sawm>, intend or try, written as one word after a verb: try or plan to do it again) (j:kik/sawm) (r:zd:19373/zd:21665) (q:draft)
kikta = (i:1) (t:adv) (f:everyday/time) (w:again now/once more) (d:<kik> and <ta> written as one word after a verb: the action or state has now come about again, as in {kihong kikta}, has opened again) (j:kik/ta) (r:zd:22921/zd:11506/zd:15855) (q:draft)
kikthei = (i:1) (t:v) (f:everyday) (w:can again/be able to return) (d:<kik>, again or back, and <thei>, able, written as one word after a verb: able to do it again or to get back; {ciah kikthei} is able to go back home) (j:kik/thei) (r:zd:16350/zd:24739/zd:12061) (q:draft)
kiktheih = (i:1) (t:adv) (f:everyday) (w:be able to again/can again) (d:<kik>, again or back, and <theih>, be able, written as one word after a verb and mostly before <nading>: so that it can be done again, so that one can go back) (j:kik/theih) (r:zd:20276/zd:26495) (q:draft)
kikupkhop = (i:1) (t:v) (f:social/politics) (w:discuss together/consult together) (d:<kikup>, discuss, and <khop>, together, written as one word: talk a matter over together) (j:kikup/khop) (r:zd:23037/ts:9808) (q:draft)
kikupkhopna = (i:1) (t:n) (f:social/politics) (w:discussion/consultation/dialogue/talks) (d:<kikup>, discuss, with <khopna>, doing together: a discussion held together, a meeting to talk a matter over) (s:kikupna) (r:zd:14686/zd:20263/zd:9232) (q:draft)
kikupna kinei = (i:1) (t:v) (f:social/politics) (w:a discussion is held/be discussed/hold talks) (d:<kikupna>, discussion, and <kinei>, here the passive of <nei>, have or hold: a discussion is held, it is discussed; the regular wording of meeting reports, with the matter discussed standing before it) (r:zd:23994/zd:16055/zd:16235) (q:draft)
kikupna nei = (i:1) (t:v) (f:social/politics) (w:hold a discussion/hold talks/confer) (d:<kikupna>, discussion, as the object of <nei>, have: hold a discussion or a meeting to talk a matter over; the matter stands before it, often with <thu> or {tawh kisai}, and the persons one confers with take <tawh>) (s:kikum) (r:zd:24333/ts:3190/zd:10743) (q:draft)
kikupnate = (i:1) (t:n) (f:politics/social) (w:discussions/consultations/talks) (d:plural of <kikupna>, a discussion or consultation) (b:kikupna) (r:zd:24682) (q:draft)
kikuppih = (i:1) (t:v) (f:social) (w:consult with/discuss with/talk over with) (d:talk a matter over together with someone, often as {thu kikuppih}; <kikup> with the ending {-pih}, together with) (s:kuppih) (b:kikup) (r:zd:24252/zd:24022/zd:16745) (q:draft)
kikzel = (i:1) (t:adv) (f:everyday) (w:again/again in turn/once more) (d:<kik> and <zel> written as one word after a verb: the action is done again, or again each time) (j:kik/zel) (r:zd:20841/zd:12371/zd:16337) (q:draft)
kilaakna = (i:1) (t:n) (f:religion) (w:revelation/appearing) (d:<kilaak>, show oneself, with the noun suffix {-na}: revelation, above all the self-revelation of God; with a capital letter also a name of the last book of the Bible, Revelation) (b:kilaak) (r:zd:21845/zd:24303/zd:23113) (q:draft)
kilading = (i:1) (t:v) (f:work/politics) (w:will be taken/will be charged/will be collected) (d:<kila>, be taken, with <ding>, will, written as one word: said of a fee that will be charged and of a statement or action that will be taken) (j:kila/ding) (r:zd:10717/zd:12164/zd:19324) (q:draft)
kilah = (i:2) (t:v) (f:health) (w:see a doctor/be examined/consult) (d:after <zato> or with a clinic, show oneself to a doctor for examination or treatment; {kilah man} is the consultation fee) (r:zd:23529/zd:23512/zd:25194) (q:draft)
kilahna = (i:2) (t:n) (f:health) (w:consultation/medical visit/treatment) (d:showing oneself to a doctor: a visit to a hospital or clinic to be examined and treated; this meaning comes after <zato>, hospital, as {zato kilahna}) (r:zd:23863/zd:21074) (q:draft)
kilaihding = (i:1) (t:v) (f:everyday) (w:will be changed/will be replaced) (d:<kilaih> and <ding> written as one word: is to be changed or exchanged) (j:kilaih/ding) (r:zd:19674/zd:16459) (q:draft)
kilaihna = (i:1) (t:n) (f:everyday/politics) (w:change/replacement/exchange/reshuffle) (d:<kilaih>, be replaced, with the noun suffix <na>: the putting of one in the place of another, a change of persons, places or rules) (s:kikhelna) (b:kilaih) (r:zd:19464/zd:24630) (q:draft)
kilainatpih = (i:1) (t:v) (f:social) (w:sympathise with/condole with/share the grief of) (d:<lainat>, feel compassion, with the prefix {ki-} and <pih>, together with: feel the pain of the bereaved with them; used in messages of condolence beside <kidahpih>) (b:lainat) (r:zd:21699) (q:draft)
kilak = (i:3) (t:v) (f:health) (w:see a doctor/be examined/consult) (d:show oneself to a doctor, nurse or clinic to be examined, with <kiangah>, <tawh> or <ah> after the one consulted) (r:zd:21557/zd:14887/zd:19098) (q:draft)
kilakhia = (i:4) (t:v) (f:politics) (w:be captured/be seized/be taken) (d:of a military camp, post or town: be taken from the enemy in fighting, with <Camp>, <galphual> or <khuapi> before it and often <zo> or <khin> after it, where the other senses are taking a thing out of a place) (r:ts:3446/ts:8561/ts:3707) (q:draft)
kilakhiazo = (i:1) (t:v) (f:politics) (w:be captured/be taken/fall) (d:<kilakhia>, be taken, with <zo>, succeed: in war reports, of a camp, an office or a town that has been taken from the enemy) (b:kilakhia) (j:kilakhia/zo) (r:ts:4587/ts:11323/ts:4734) (q:draft)
kilakhin = (i:1) (t:v) (f:everyday/politics) (w:have already been taken/already taken) (d:<kila>, be taken, and <khin>, already, written as one word: has already been taken, chosen or captured) (j:kila/khin) (r:ts:7364/zd:16799) (q:draft)
kilakpah = (i:1) (t:v) (f:health) (w:see a doctor at once/show oneself at once) (d:<kilak> and <pah> written as one word: show oneself without delay, said of going to a doctor or clinic to be examined) (j:kilak/pah) (r:zd:14650/zd:23848) (q:draft)
kilal = (i:1) (t:v) (f:travel/social) (w:migrate/move/resettle) (d:<lal>, migrate, with the prefix <ki>: of people, move to live in another place) (b:lal) (r:zd:21605/zd:18150) (q:draft)
kilalo = (i:1) (t:v) (f:everyday) (w:not be taken) (d:<kila> and <lo> written as one word: is not taken, not charged, not accepted) (j:kila/lo) (r:zd:17709/zd:22502/ts:3565) (q:draft)
kilamdannate = (i:1) (t:n) (f:social/religion) (w:differences/distinctions) (d:<kilamdanna>, difference, with the plural <te>: the points in which people or groups differ) (b:kilamdanna) (r:zd:22815/zd:21859) (q:draft)
kilamding = (i:1) (t:v) (f:work/home) (w:will be built/to be built) (d:<kilam>, be built, and <ding> written as one word) (j:kilam/ding) (r:zd:17097/zd:11438) (q:draft)
kilamh = (i:1) (t:v) (f:politics/work) (j:kilam) (r:zd:10854/zd:21327) (q:draft)
kilamhzia = (i:1) (t:n) (f:politics/social) (w:structure/organisation/make-up) (d:<kilamh>, be built, the same word as <kilam>, with <zia>, manner: the way something is built up or organised, as a state, an organisation or a town) (r:zd:21114) (q:draft)
kilamlo = (i:1) (t:v) (f:home/work) (w:not be built) (d:<kilam>, be built, and the negative <lo> written as one word: is not built) (j:kilam/lo) (r:zd:20488/zd:20703) (q:draft)
kilamsan = (i:1) (t:v) (f:work/home) (w:be under construction/be being built) (d:<kilam>, be built, with the ending {-san}, in the course of: still being built; {inn kilamsan} is a building under construction) (b:kilam) (r:zd:18074/zd:17593/zd:12420) (q:draft)
kilamthakna = (i:1) (t:n) (f:social/religion) (w:rebuilding/renewal/reconstruction) (d:a building up anew, of a town, a church or a person's life) (r:zd:19845/zd:24250) (q:draft)
kilamzia = (i:1) (t:n) (f:social/body) (w:structure/build/constitution) (d:<kilam>, be built, with <zia>, manner: the way something is built up or organised, as the body, a church or a state; {pumpi kilamzia} is the build of the body) (b:kilam) (r:zd:17152/zd:23016/zd:25020) (q:draft)
kilangh = (i:1) (t:v) (f:everyday) (j:kilang) (r:zd:24381/zd:20930/zd:24199) (q:draft)
kilangpan = (i:1) (t:v) (f:social/politics) (w:oppose each other/be in conflict/be against) (d:<langpan>, oppose, with the prefix <ki>: stand against one another, be opposed to someone or something) (b:langpan) (r:zd:22709/zd:24046/ts:6525) (q:draft)
kilangpanna = (i:1) (t:n) (f:social/politics) (w:mutual opposition/conflict/antagonism) (d:<langpanna>, opposition, with the reciprocal prefix <ki>: the opposing of one another, a standing against each other) (r:ts:7130/ts:9808/zd:20841) (q:draft)
kilapsang = (i:1) (t:v) (f:social) (w:be lifted up/be raised/be promoted/improve) (d:the prefix <ki> with <lapsang>, lift up: be raised in rank, honour or standard of life, or raise oneself) (b:lapsang) (r:zd:19833/zd:14930) (q:draft)
kilaptoh = (i:1) (t:v) (f:everyday/body) (w:be raised/be lifted up) (d:passive of <laptoh>, lift up: be lifted or raised higher, as the legs on a footrest) (b:laptoh) (r:zd:14586) (q:draft, low confidence)
kilata = (i:1) (t:v) (f:everyday/work) (w:be now taken/be now being collected) (d:<kila>, be taken, with <ta>, here now, written as one word: is now being taken; {sazian kilata} is the list of names is now being taken, registration is open) (j:kila/ta) (r:zd:17021) (q:draft, low confidence)
kilathei = (i:1) (t:v) (f:everyday) (w:can be taken/can be obtained/can be collected) (d:<kila>, be taken, and <thei>, able, written as one word: it can be got, collected or taken) (j:kila/thei) (r:zd:21409/zd:13096/zd:15445) (q:draft)
kilau = (i:1) (t:v) (f:everyday) (w:be afraid/fear/be feared) (d:<lau>, fear, with the prefix <ki>: people are afraid, it is feared that; also fear one another) (b:lau) (r:zd:24280/zd:25473) (q:draft)
Kilauea = (i:1) (t:name) (c:place) (f:nature/travel) (w:Kilauea) (d:volcano on the island of Hawaii in the United States) (r:zd:19546/zd:19514) (q:draft)
kilauthawng = (i:1) (t:v) (f:everyday/social) (w:be frightened/be alarmed/fear) (d:<lauthawng>, be struck with fear, with the prefix <ki>, said of people in general: people are frightened, there is alarm) (s:kipatau) (j:ki/lauthawng) (r:zd:12985/ts:3234) (q:draft)
kilawh = (i:3) (t:v) (f:health) (w:be transmitted/be contagious/spread/be infected) (d:of an illness, pass from one person or animal to another; often after <natna> and before <thei>, and with <pan> for the source, not the spreading of a sore over the body) (r:zd:24054/zd:24276/zd:24037) (q:draft)
kilawhbaih = (i:1) (t:adj) (f:health) (w:contagious/easily spread/catching) (d:<kilawh>, spread, and <baih>, here easily, written as one word: that spreads or is caught easily, said of a disease, a fire or bad behaviour) (j:kilawh/baih) (r:zd:12267/zd:14681/zd:15953) (q:draft)
kilawhcing = (i:1) (t:v) (f:work/social) (w:succeed/be successful) (d:the prefix <ki> and <lawhcing>, succeed, written as one word: people in general succeed, success is had) (j:ki/lawhcing) (r:zd:21221/zd:23167/zd:9452) (q:draft)
kilawhna = (i:1) (t:n) (f:health) (w:spread/infection/contagion) (d:the passing of a disease from one person to another; {natna kilawhna} is the spread of a disease) (b:kilawh) (r:zd:23958/zd:24609) (q:draft)
kilawhna = (i:2) (t:n) (f:social) (w:name/designation) (d:what a person or people is called, from <lawh>, call or name; {ei le ei kilawhna} is what we call ourselves) (r:zd:21607/ts:261/zd:13043) (q:draft)
kilawhthei = (i:1) (t:v) (f:health) (w:be contagious/can spread/be infectious) (d:<kilawh>, spread, and <thei>, able, written as one word: of a disease or a mood, able to pass from one person to another) (j:kilawh/thei) (r:zd:16949/zd:20801/zd:23848) (q:draft)
kilawm = (i:3) (t:v) (f:everyday) (w:seem/appear/be likely) (d:at the end of a clause that closes with <leh>, <hileh> or <leng>: it seems that, it looks as if; the speaker judges from what is seen and is not saying that the thing is fitting or deserved) (r:zd:21925/zd:24119/zd:15056) (q:draft)
kilawm sa = (i:1) (t:v) (f:everyday) (w:think it fitting/wish/would like) (d:<kilawm>, be fitting, and <sa>, to deem or feel: to consider something right or good; after a clause ending in <leh> or <leng> and followed by <ing>, a polite way to say I wish that or it would be good if) (r:zd:23322/zd:20818/zd:11400) (q:draft)
kilawmlo = (i:1) (t:adj) (f:social/everyday) (w:unsuitable/improper/not fitting) (d:<kilawm>, fitting, and <lo>, not, written as one word; after a verb with <ding>, it is not right to do it) (j:kilawm/lo) (r:zd:23394/zd:11346/zd:12337) (q:draft)
kilawmsa = (i:1) (t:v) (f:everyday) (w:consider fitting/think proper/seem right) (d:<kilawm> and <sa> written as one word: think it right or fitting; after <leh>, it would be fitting if) (j:kilawm/sa) (r:zd:20929/zd:9221) (q:draft)
kilawmsakna = (i:1) (t:n) (f:social) (w:show/formality/sake of appearance) (d:<kilawm> with <sakna>: making something look fitting, what is said or done only for the sake of appearance or good form) (j:kilawm/sakna) (r:zd:25711/zd:23984) (q:draft, low confidence)
kilawmta = (i:1) (t:v) (f:social) (w:be friends/befriend/get along) (d:<lawmta>, friends, with the prefix <ki>: be or become friends with one another; the other person is named with <tawh>) (b:lawmta) (r:zd:22260/zd:23729/zd:22446) (q:draft)
kilawmtak = (i:1) (t:v) (f:social) (j:kilawmta) (r:zd:11891/zd:15572) (q:draft)
kilawmtat = (i:1) (t:v) (f:social) (w:be friends/socialize/get acquainted) (d:form of <kilawmta> used before words such as <ding> and <nading>: be on friendly terms, come together as friends) (b:kilawmta) (r:zd:23528/zd:22691) (q:draft)
kilawn = (i:2) (t:v) (f:everyday) (w:be fired/be set off/be launched) (d:said of a gun, a firecracker or a rocket, after <thau> and the like: go off or be sent up, where nothing is thrown by hand) (r:zd:17047/zd:17062/zd:16155) (q:draft)
kilawngawp = (i:1) (t:v) (f:everyday) (w:be flung/be hurled/be thrown about) (d:<kilawn>, be thrown, and <gawp>, violently, written as one word: be thrown with great force, as by a crash, a blast or a storm) (j:kilawn/gawp) (r:zd:13034/zd:14906) (q:draft)
kilawp = (i:1) (t:v) (f:social/everyday) (w:be excited/be eager/be enthusiastic) (d:<lawp>, eager, with the prefix <ki>: people are excited or keen about something; {kilawp mahmah} is very excited) (b:lawp) (r:zd:15865/zd:20673/zd:21025) (q:draft)
kilazo = (i:1) (t:v) (f:politics) (w:be captured/be taken) (d:<lazo>, capture, with the passive prefix <ki>: of a town or a military base, be taken by force) (b:lazo) (r:ts:3855/ts:6807) (q:draft)
kileekkim = (i:1) (t:adj) (f:everyday) (j:kilekkim) (r:zd:17339/zd:16150) (q:draft)
kileen = (i:1) (t:v) (f:social) (j:kilen) (r:zd:17860/zd:11110) (q:draft)
kilehleh = (i:1) (t:v) (f:everyday) (w:go back and forth/go to and fro/run about) (d:doubled form of <kileh>, turn back: keep moving this way and that, of a person pacing, of animals running about and of traffic) (b:kileh) (r:zd:21259/zd:14589) (q:draft)
kileiding = (i:1) (t:v) (f:work) (w:to be bought/will be bought) (d:<kilei> and <ding> written as one word: to be bought, going to be bought) (j:kilei/ding) (r:zd:15560/zd:11329) (q:draft)
kileisak = (i:1) (t:v) (f:work/everyday) (w:buy for someone/be bought for) (d:<ki> and <leisak>, buy for, written as one word: something is bought for someone, or people buy from a seller as a favour to him) (j:ki/leisak) (r:zd:16038/zd:22695) (q:draft)
kileithei = (i:1) (t:v) (f:work/everyday) (w:can be bought/be available to buy) (d:<kilei>, be bought, with <thei>, able, written as one word: can be bought) (j:kilei/thei) (r:zd:11789/zd:21869) (q:draft)
kilek = (i:1) (t:v) (f:everyday) (w:tip/tilt/sway/lose balance) (d:tip or swing to one side as a scale does, compare <lek>: lose balance, lean now this way now that; {kilek kim} is evenly balanced) (r:zd:17826/zd:15317) (q:draft, low confidence)
kilekkim = (i:1) (t:adj) (f:everyday) (w:balanced/even/in proportion/symmetrical) (d:of two or more things, in balance with one another, none too much and none too little; {kilekkim sak} is to balance) (r:zd:12167/zd:14734) (q:draft)
kilel = (i:1) (t:v) (f:social/politics) (w:be defeated/lose/be worn down) (d:be beaten in war or in a contest; also be overcome or worn down by pressure; the passive form of <lel>, lose) (b:lel) (r:zd:8667/zd:25192) (q:draft)
kilemkikna = (i:1) (t:n) (f:politics/social) (w:reconciliation) (d:noun from <kilemkik>: being at peace again after enmity; {gambup kilemkikna} is national reconciliation) (b:kilemkik) (r:ts:6945/zd:16455) (q:draft)
kilemlo = (i:2) (t:v) (f:health/food) (w:not agree with/not go with/be incompatible) (d:of a food, a drink or a habit and a person or an illness, with <tawh>: the two do not suit each other, with no thought of a quarrel between people) (r:zd:25148/zd:20790) (q:draft)
kilemloh = (i:1) (t:v) (f:social) (w:not be at peace/be at odds/quarrel) (d:<kilem>, be at peace, and the negative <loh> written as one word, the form used before <ding>, <nading> and similar words: not get on with one another, be in conflict) (j:kilem/loh) (r:zd:16406/zd:20751/ts:3341) (q:draft)
kilemna = (i:2) (t:n) (f:social) (w:peace) (d:being on good terms after or instead of fighting, often as {gal kilemna}; <kilemna bawl> is make peace) (s:gallemna/galdaihna) (a:kidona/kilemlohna) (b:kilem) (q:draft)
kilemna bawl = (i:1) (t:v) (f:politics/social) (w:make peace/reconcile) (d:<kilemna>, peace, and <bawl>, make: make peace or be reconciled; the other party stands before it with <tawh>) (r:zd:20125/zd:21509) (q:draft)
kilemtuah = (i:1) (t:v) (f:everyday/social) (w:be put in order/be set right/be reconciled) (d:be arranged so that the parts fit, or be put right again after going wrong) (r:zd:24157/zd:21605/zd:25620) (q:draft)
kilen = (i:2) (t:v) (f:it/everyday) (w:be answered/be picked up) (d:passive of <len>, said of a phone call: be picked up; {kilen vet lo} is the call is not answered at all) (r:zd:17028/zd:23673) (q:draft)
kileng = (i:1) (t:v) (f:travel/social) (w:go abroad/migrate/move away) (d:of people, leave in numbers for other places or countries, literally fly off; the dictionary data also has {kileng sak} for making something fly) (r:zd:15527/zd:20769) (q:draft, low confidence)
kilengsak = (i:1) (t:v) (f:travel) (w:be flown/be operated) (d:<ki>, passive, with <leeng>, fly, here spelled with one e, and the causative <sak>: of an aircraft or a flight, be made to fly, be flown or run on a route) (b:leeng) (r:zd:17864/zd:17941) (q:draft)
kilet = (i:1) (t:v) (f:social/body) (w:hold one another/shake hands/join hands) (d:form of <kilen> used after <khut>, hand, and before words such as <ding>: take each other by the hand, in greeting or in unity) (b:kilen) (r:zd:21362/zd:25394/zd:24598) (q:draft)
kilet = (i:2) (t:v) (f:education/media) (w:be translated) (d:<let> in the sense of translate, with the prefix <ki>: be put into another language; {kilet khia} is be translated from a source) (r:zd:19676/zd:23832/zd:15584) (q:draft)
kiletkhia = (i:1) (t:v) (f:education/media) (w:be translated) (d:passive with <ki> of the verb for translating a text out of one language into another; said of books and writings) (r:zd:20410/zd:24303/zd:20699) (q:draft)
kiliau = (i:1) (t:v) (f:social/politics) (w:be fined/be made to pay) (d:<liau>, pay a fine, with the passive prefix <ki>: be fined; {kiliau sak} is be made to pay a fine or compensation) (b:liau) (r:zd:24453/zd:21282/zd:12336) (q:draft)
kiliausak = (i:1) (t:v) (f:social/politics) (w:be fined/be made to pay a fine) (d:<kiliau>, be fined, with the ending <sak>: be made to pay a sum as a penalty; the sum stands before it) (b:kiliau) (r:zd:16717/zd:19788/zd:17649) (q:draft)
kilimbawl = (i:1) (t:v) (f:social) (w:be taken seriously/be given much attention/be done in earnest) (d:<ki>, passive or reflexive, with <limbawl>: be treated as important, be held or carried out with much care and effort; of a person, make much of oneself) (b:limbawl) (r:zd:23383/zd:11805) (q:draft, low confidence)
kilimgen = (i:1) (t:v) (f:media/social) (w:be much talked about/be widely discussed) (d:be spoken of by many people, be the talk of the day; the form with the prefix <ki> of <limgen>, talk much about) (r:zd:15507/zd:15315/zd:15784) (q:draft)
kilimgin = (i:1) (t:v) (f:social/politics) (w:be on the alert/be vigilant/take care) (d:be watchful and prepared for something; {Security kilimgin mahmah} is security is very tight) (r:zd:16916/ts:8689) (q:draft, low confidence)
kilimzak = (i:1) (t:v) (f:media/everyday) (w:be often heard of/be widely reported) (d:be heard of again and again, said of a kind of event that is much in the news; usually {kilimzak mahmah}, and paired with <kinawhzak>) (r:zd:15820/zd:11934/zd:18307) (q:draft)
kilimzat = (i:1) (t:v) (f:everyday) (w:be widely used/be commonly used/be popular) (d:be much used and well liked, with <zat>, use, and the passive <ki>) (s:kizang) (r:zd:19756/zd:11527/zd:25115) (q:draft)
kilinglawng = (i:1) (t:v) (f:social) (w:be shaken/be alarmed/be in turmoil) (d:<ki> with <linglawng>: of a people or a place, be thrown into alarm and commotion; of the earth, shake) (b:linglawng) (r:zd:23899/zd:23907/ts:7679) (q:draft)
kilipkhap = (i:1) (t:v) (f:social) (w:be dreaded/be abhorred/be shunned) (d:<lipkhap>, feel horror at, with the prefix {ki-}: be looked on with horror or disgust, be shunned by people) (b:lipkhap) (r:zd:23138/zd:22928) (q:draft)
kilkel = (i:2) (t:adv) (f:everyday) (w:at all/in the least) (d:placed after a verb and before a negative, {kilkel lo}, {kilkel kei}, {kilkel loh}: strengthens the negation, not at all, not in the least; {kisai kilkel lo} is to have nothing at all to do with) (s:het) (r:zd:21780/zd:21090/zd:23653) (q:draft)
kilkello = (i:1) (t:adv) (f:everyday) (w:not at all/not in the least) (d:<kilkel> and <lo> written as one word after a verb or describing word: a strong negative, not at all, not in the least) (j:kilkel/lo) (r:zd:21458/zd:23343/zd:21862) (q:draft)
kilo = (i:2) (t:v) (f:nature/food) (w:be picked/be plucked/be harvested) (d:of fruit, flowers or shoots, be picked from the plant; the passive <ki> with a verb for picking, and the word before is <gah>, fruit, or <pak>, flower, not <min>, name) (r:zd:20831/zd:20516) (q:draft)
kilom = (i:1) (t:adv) (f:everyday) (w:in a mass/in one lump/together) (d:<ki> with <lom>, lump or bundle: gathered into one mass or group, taken all together; {mi kilom thahna} is mass killing and {kilom khawm} is gather together in one) (r:zd:17675/zd:24001) (q:draft)
kilometer = (i:1) (t:n) (f:travel) (w:kilometer/kilometre) (d:the measure of distance, written after the number) (o:English) (r:zd:20023/zd:14726) (q:draft)
kilot = (i:1) (t:v) (f:everyday/politics) (w:be thrown) (d:<lot>, throw, with the prefix {ki-}: be thrown, said of a bomb, fire or other thing thrown at a place) (b:lot) (r:zd:17540/zd:16669) (q:draft)
kilung = (i:2) (t:v) (f:everyday/social) (w:feel) (d:<lung>, heart, with the general <ki>, written apart before a word of feeling such as <dam>, <himawh> or <kim>: people in general feel so, as {kilung dam}, everyone is glad, and {kilung himawh}, everyone is worried; not the reciprocal {kilung tuak}) (r:zd:14887/zd:18171/zd:12819) (q:draft)
kilungdam = (i:1) (t:v) (f:social/everyday) (w:be glad/be thankful/rejoice) (d:<ki> and <lungdam> written as one word: people are glad or thankful, said of a group or without naming who; {tungah kilungdam} is be thankful to someone) (j:ki/lungdam) (r:zd:16235/zd:24847/zd:15622) (q:draft)
kilungdampih = (i:1) (t:v) (f:social) (w:congratulate/rejoice with) (d:<ki> with <lungdampih>, rejoice with: people share in someone's joy, he is congratulated; said of a group or without naming who rejoices) (b:lungdampih) (r:zd:20414/zd:18937) (q:draft)
kilunggulh = (i:2) (t:v) (f:social/everyday) (w:long for/be longed for/hope for/wish for) (d:<lunggulh>, desire, with <ki> as the general prefix: people long for a thing or hope that it will happen, often after <ding> and before <mahmah> or <ciat>; nothing sexual is meant) (r:zd:23361/zd:14765/zd:21948) (q:draft)
kilungkia = (i:1) (t:v) (f:everyday/religion) (w:be discouraged/lose heart) (d:<lungkia>, lose heart, with the prefix <ki>, said of people in general: one becomes discouraged) (b:lungkia) (r:zd:24235/zd:21900) (q:draft)
kilunglut = (i:1) (t:v) (f:everyday/social) (w:be interested/take an interest) (d:be interested in something and eager to know about it, said of people in general with the prefix <ki>; {kilunglut mahmah} is there is great interest) (r:zd:25255/zd:19932/zd:20060) (q:draft)
kilungneusak = (i:1) (t:v) (f:everyday/social) (w:be discouraged/lose heart/feel small) (d:<lungneu>, be downhearted, with the prefix <ki> and the causative <sak>: let oneself feel small and discouraged) (b:lungneu) (r:zd:17858/zd:24939) (q:draft)
kilut = (i:1) (t:v) (f:everyday/social) (w:enter/go in/join/take part) (d:<lut>, enter, with the prefix <ki>: people go in, a place is entered, or one joins and takes part in something) (b:lut) (r:ts:6807/zd:20513/zd:12024) (q:draft)
kilutthei = (i:1) (t:v) (f:social/everyday) (w:can enter/can take part) (d:<kilut>, enter or take part, and <thei>, can, written as one word: one can enter, entry is possible) (j:kilut/thei) (r:zd:23494) (q:draft)
kim = (i:4) (t:adv) (f:everyday/media) (w:about/approximately/around) (d:placed after a number, an amount or a clock time to show that it is an estimate, as {inn 200 kim}, about 200 houses; not the area around a place and not every) (r:ts:10275/ts:2942/ts:5635) (q:draft)
kimah = (i:2) (t:prep) (f:everyday) (w:in every/in each) (d:<kim> in its meaning of all or every, with the place marker <ah>, after a noun: in every one of them, as {pawlpi kimah}, in every church, not around one place) (r:zd:23215/zd:24016/zd:17965) (q:draft)
kimai = (i:2) (t:v) (f:social/religion) (w:forgive one another/be forgiven) (d:written apart before <sak>: {kimai sak} is <kimaisak>, be forgiven or forgive one another, often after <mawh> or <mawhna>, sin; {kimai sakna} is forgiveness of each other) (r:zd:25200/zd:24062/zd:21869) (q:draft)
kimaingap = (i:1) (t:v) (f:social) (w:be on familiar terms/feel at ease together) (d:<ki>, each other, and <maingap>, feel at ease, written as one word: be unshy and familiar with one another) (b:maingap) (j:ki/maingap) (r:zd:23797/zd:14530) (q:draft)
kimaingapna = (i:1) (t:n) (f:social) (w:familiarity/closeness/rapport/mutual ease) (d:the reciprocal <ki> with <maingap>, feel at ease, and the noun suffix <na>: being at ease with one another, a close and unshy relationship) (b:maingap) (r:zd:13076/zd:21155/zd:25094) (q:draft)
kimakaih = (i:1) (t:v) (f:social/politics) (w:be led/be guided/lead one another) (d:<makaih>, lead, with the prefix <ki>: be led, or lead and govern one another; {kimakaih zia} is the way of leading and <kimakaihna> is leadership) (b:makaih) (r:zd:25569/zd:9436/zd:21049) (q:draft)
kimakaihna = (i:1) (t:n) (f:social/politics) (w:leadership/governance/rule) (d:the way a people or group is led, <makaihna> with the prefix <ki>: leading and being led among themselves) (b:makaihna) (r:zd:16254/zd:23257/zd:23780) (q:draft)
kimakaihzia = (i:1) (t:n) (f:social/religion) (w:leadership/way of leading/administration) (d:<kimakaih>, be led or lead one another, from <makaih>, lead, with <zia>, way: how a church, family, army or other group is led and run) (b:kimakaih) (r:zd:9430/zd:11891/zd:22941) (q:draft)
kimanawh = (i:1) (t:v) (f:everyday/travel) (w:head for/be heading toward) (d:<manawh> with the prefix <ki>: people in general head toward something, things are moving in that direction; usually after <lam>) (j:ki/manawh) (r:zd:22736/zd:22446) (q:draft)
kimanding = (i:1) (t:v) (f:politics/media) (w:will be arrested/will be detained) (d:<kiman>, be arrested, and <ding> written as one word: will be arrested or held) (j:kiman/ding) (r:zd:14701/zd:12833) (q:draft)
kimanglo = (i:1) (t:v) (f:everyday) (w:not last/be of no use) (d:<kimang> and <lo> written as one word: not stay in use, not last; {sauvei kimanglo} is not last long) (j:kimang/lo) (r:zd:11409/zd:24847) (q:draft)
kimankhia = (i:1) (t:v) (f:media/everyday) (w:be caught/be seized/be arrested) (d:the passive <ki> with <mankhia> written as one word: be caught and taken out, said of arrested persons, of seized goods and of a captured animal) (j:ki/mankhia) (r:zd:12181/zd:18089) (q:draft)
kimankhin = (i:1) (t:v) (f:politics/media) (w:have been arrested/be arrested) (d:<kiman>, be arrested, and <khin>, already, written as one word: have been arrested; in headlines after the number of people) (j:kiman/khin) (r:zd:20912/zd:12210) (q:draft)
kimankhinta = (i:1) (t:v) (f:politics) (w:have been arrested/be already caught) (d:<kiman.2> and <khinta> written as one word: have already been arrested) (j:kiman/khinta) (r:zd:14505/zd:18014) (q:draft)
kimankik = (i:1) (t:v) (f:politics/everyday) (w:be recaptured/be caught again/be arrested) (d:<kiman>, be caught, and <kik>, again or back, written as one word: be caught after running away, or be arrested in turn) (j:kiman/kik) (r:ts:9743/zd:15165) (q:draft)
kimanlo = (i:1) (t:v) (f:politics/everyday) (w:not be caught/not be arrested/not be seized) (d:<kiman>, be caught, and <lo>, not, written as one word: not be arrested, and of goods, not be seized) (j:kiman/lo) (r:zd:12210/zd:14883) (q:draft, low confidence)
kimanpah = (i:1) (t:v) (f:politics) (w:be arrested at once/be caught immediately) (d:<kiman>, be arrested, with <pah>, at once, written as one word) (j:kiman/pah) (r:zd:19061/zd:16365) (q:draft)
kimansak = (i:1) (t:v) (f:politics/media) (w:let oneself be arrested/give oneself up/be caught) (d:the prefix <ki> with <mansak>, cause to seize, written as one word: let oneself be arrested, give oneself up; also be caught, of smuggled animals) (j:ki/mansak) (r:zd:12603) (q:draft)
kimansuak = (i:1) (t:v) (f:politics) (w:be arrested/be taken into custody) (d:<kiman>, be arrested, with <suak>, right through: be arrested there and then, end up under arrest) (j:kiman/suak) (r:zd:16819/zd:20365/zd:12085) (q:draft)
kimanta = (i:1) (t:v) (f:politics/media) (w:has been arrested/has been caught) (d:<kiman>, be arrested, with the particle <ta>, now, already, written as one word: has now been caught; common at the end of headlines) (j:kiman/ta) (r:zd:10881/zd:18014) (q:draft)
kimanthei = (i:1) (t:v) (f:media/politics) (w:can be caught/can be arrested/be caught) (d:<kiman>, be caught or arrested, and <thei>, able, written as one word: can be caught or arrested, was successfully caught; {kimanthei nailo} is has not yet been caught) (j:kiman/thei) (r:zd:18083/zd:20537/zd:12240) (q:draft)
kimasak = (i:1) (t:v) (f:everyday/social) (w:be put first/be given priority) (d:<masak> with the prefix <ki>: be put first, be treated as coming before the others) (j:ki/masak) (r:zd:23780/zd:22544) (q:draft)
kimat kihen = (i:1) (t:v) (f:politics) (w:be arrested/be detained) (d:<kimat>, be caught, and <kihen>, be bound: be arrested and held by the police or the immigration office; with <na> after it, an arrest or detention) (r:zd:22652/zd:23487) (q:draft)
kimat kihenna = (i:1) (t:n) (f:politics/social) (w:arrest and detention/arrest) (d:<kimat>, be arrested, and <kihenna>, being bound or imprisoned, set side by side: arrest and detention by the police or immigration officers, said of refugees and migrants; one meets with it, {kimat kihenna tuak}) (r:zd:22938/zd:23048) (q:draft)
kimatbeh = (i:1) (t:v) (f:politics/social) (w:be arrested in addition/be arrested as well) (d:<kimat>, be arrested, with the ending {-beh}, in addition, as in <behlap>: one more person is arrested besides those already held; in news reports usually followed by <leuleu>, again) (b:kimat) (r:zd:15475/zd:11345) (q:draft)
kimawh = (i:1) (t:v) (f:social) (w:blame one another/accuse one another) (d:<mawh>, be guilty, with the prefix <ki>; in the articles it stands before <sak> as {kimawh sak}, hold one another guilty, the same as <kimawhsak>, and {kimawh sakna} is blaming one another) (b:mawh) (r:zd:24566/zd:24127) (q:draft)
kimawhsak = (i:2) (t:v) (f:social/media) (w:be blamed/be condemned/be criticised) (d:passive of <mawhsak>, blame: a person or body is blamed by others for what was done, often as {kimawhsak mahmah}, is much blamed, while with {khat leh khat} the meaning is accuse one another) (s:kingawh) (r:zd:16490/zd:10777/zd:15779) (q:draft)
kimawl = (i:1) (t:v) (f:everyday/social) (w:play) (d:Play, as children do; also perform or hold a contest for others to watch) (q:draft)
kimawlding = (i:1) (t:v) (f:media/social) (w:will play/to be played) (d:<kimawl> and <ding> written as one word: will play, those who are to play; {kimawlding hun} is the time of the games) (j:kimawl/ding) (r:zd:21598/zd:14899) (q:draft)
kimawlmawl = (i:1) (t:v) (f:everyday) (w:play about/keep playing/play around) (d:<kimawl>, play, with its last syllable repeated: play on and on or play about with something; with <a> or <khat> also the one who does so) (b:kimawl) (r:zd:17017/zd:22868/zd:20906) (q:draft)
kimawlni = (i:1) (t:n) (f:media/time) (w:match day/day of the game) (d:<kimawl>, play, and <ni>, day, written as one word: the day on which a game, match or show is held) (j:kimawl/ni) (r:zd:12336) (q:draft, low confidence)
kimawlpih = (i:1) (t:v) (f:social/family) (w:play with) (d:<kimawl>, play, with the suffix <pih>: play together with someone, or play with something as a toy) (b:kimawl) (r:zd:11619/zd:22446) (q:draft)
kimawlsiam = (i:1) (t:n) (f:media) (w:athlete/skilled player/sportsman) (d:<kimawl>, play, with <siam>, skilled: one who is good at sport or games) (r:zd:9244/zd:23653/zd:14844) (q:draft)
kimciat = (i:1) (t:adv) (f:everyday) (w:each and every one/every one/all alike) (d:<kim> and <ciat> written as one word after a verb or noun: every one without exception, each of us; common in blessings, as {hong pia kimciat ta hen}, may he give to each one of us) (j:kim/ciat) (r:zd:26708/zd:14791/zd:19302) (q:draft)
kimel = (i:1) (t:v) (f:social) (w:know each other/be acquainted) (d:the prefix <ki> with <mel>, appearance, used before <theih> or <thei>: {kimel theih} is know one another, be acquainted, and {kimel theihna} is acquaintance) (r:zd:23246/zd:11262) (q:draft)
kimeltheihna = (i:1) (t:n) (f:social) (w:acquaintance/knowing each other/getting acquainted) (d:<kimeltheih>, know each other, with the noun suffix <na>: the state of knowing one another) (b:kimeltheih) (r:zd:23367/zd:9449) (q:draft)
kimin = (i:2) (t:adv) (f:everyday) (w:about/around/approximately) (d:after a number, a year or a time of day: roughly that many or at about that time, not exactly; here <kim> is around, not complete) (r:ts:1957/zd:24641) (q:draft)
kimkhat = (i:1) (t:det) (f:everyday) (w:some/some of) (d:An indefinite number or part of a group or thing, placed after the noun; repeated, some and others; of a divided thing it can be one half.) (s:khenkhat/pawkhat)
kimkot = (i:2) (t:v) (f:everyday/nature) (w:surround/go around/circle/orbit) (d:used as a verb before <hi> or after <hong> and <na>: be all around someone or something, or move in a circle around it as the moon goes around the earth) (r:zd:20917/zd:19578/zd:15767) (q:draft)
kimlaai = (i:1) (t:conj) (f:everyday) (j:kimlai) (r:zd:11110) (q:draft)
kimlepaam = (i:1) (t:n) (f:nature/social) (w:surroundings/environment) (d:<kim>, <le> and <paam> written as one word: all that lies around, the surroundings; in the articles the natural environment) (j:kim/le/paam) (r:zd:23729/zd:25620) (q:draft)
kimlepam = (i:1) (t:n) (f:nature/social) (w:surroundings/environment) (d:<kim>, <le> and <pam> written as one word: everything and everyone around one) (j:kim/le/pam) (r:zd:24069/zd:20871/zd:22557) (q:draft)
kimlo = (i:1) (t:adv) (f:everyday) (w:not all/not every/not equally) (d:<kim>, all or fully, and <lo>, not, written as one word after a verb: not all of them, not in every case; {ki kimlo} is not equal, not the same for everyone) (j:kim/lo) (r:zd:21118/zd:20410/zd:21168) (q:draft)
kimlohna = (i:1) (t:n) (f:everyday/social) (w:dissatisfaction/discontent) (d:with <lung>, heart: {lung kimlohna} is not being satisfied, displeasure, the noun of <lungkim> with <lo>) (b:kimlo) (r:zd:22492/zd:24595) (q:draft)
kimna = (i:2) (t:n) (f:politics/social) (w:agreement/consent) (d:after <thu>, word, a spaced spelling of <thukimna>: agreement between parties, not the doing of something in full; {thu kimna nei} is reach an agreement) (s:thukimna) (r:zd:14790/zd:24528/zd:25665) (q:draft)
kimpawl = (i:1) (t:adv) (f:time) (w:around/about) (d:<kim>, surroundings, with <pawl>, written as one word after a time or year: around that time, about then) (j:kim/pawl) (r:zd:19908/zd:21829) (q:draft, low confidence)
kimtak = (i:1) (t:adv) (f:everyday) (w:in full/completely/fully) (d:<kim>, all, complete, with <tak>: in full, with nothing and no one missing; often {kimtak in}) (r:ts:1408/zd:17348) (q:draft)
kimte = (i:2) (t:part) (f:everyday) (w:about/some/around) (d:after a number, <kim> in the sense of about with the plural <te>: roughly that many persons or things, as in {galkap 100 kimte}, some 100 soldiers) (r:ts:9781/ts:2753) (q:draft)
kimtek = (i:1) (t:adv) (f:everyday/social) (w:every one/all alike/each and all) (d:<kim>, all, and <tek>, each, written as one word after a verb or noun: all of them, each one without exception) (j:kim/tek) (r:zd:22586/zd:19116) (q:draft)
kimteng = (i:1) (t:n) (f:everyday/travel) (w:surroundings/whole area around) (d:<kim>, surroundings, with <teng>, all of: the whole area around a place, often followed by <ah>) (j:kim/teng) (r:zd:19826/zd:17256) (q:draft)
kimu = (i:2) (t:v) (f:everyday) (w:be seen/be found/appear) (d:passive of <mu>, see: a thing is seen or found, with no <tawh> and no person who is met; <kimuh> is the form before endings) (r:zd:22065/ts:12490/zd:23767) (q:draft)
kimu tek = (i:1) (t:phrase) (f:everyday/media) (w:see you all/let us meet) (d:<kimu>, see each other, and <tek>, each one: with <ni> after it, {kimu tek ni}, let us all see each other; a closing formula of a writer or broadcaster, see you all there, with the place of meeting before it) (r:zd:24845/zd:25586) (q:draft)
kimuak = (i:1) (t:v) (f:social) (w:be welcomed/be received/welcome one another) (d:<muak>, go to meet or welcome, with the prefix <ki>: be welcomed; {hong kimuak hi} says that persons are welcome, and of a feast day, be celebrated) (b:muak) (r:zd:21978/zd:16359) (q:draft)
kimuang = (i:2) (t:v) (f:social) (w:be trusted/be relied on) (d:<muang>, trust, with <ki> as a passive: be trusted by others, mostly with <lo> of a person, a company or a government that people do not trust) (r:zd:23572/zd:24480) (q:draft)
kimuanlohna = (i:1) (t:n) (f:social/everyday) (w:lack of confidence/self-doubt/mistrust) (d:<kimuan> with <lohna>, not being: not trusting oneself, lack of confidence; between people, lack of trust in each other) (j:kimuan/lohna) (r:zd:22116/zd:21083) (q:draft)
kimuanmawhna = (i:1) (t:n) (f:social) (w:mutual distrust/mutual suspicion) (d:<muanmawhna>, suspicion, with the reciprocal prefix <ki>: distrust of one another) (b:muanmawhna) (r:zd:20761/ts:301) (q:draft)
kimuding = (i:1) (t:v) (f:social/politics) (w:will meet) (d:<kimu>, meet, with <ding>, will, written as one word) (j:kimu/ding) (r:zd:19820/zd:12271) (q:draft)
kimuhcil = (i:1) (t:adv) (f:social) (w:on first meeting/at first sight) (d:<kimuh>, see each other, and <cil>, at first, written as one word: when people have just met for the first time) (j:kimuh/cil) (r:zd:19814/zd:25923) (q:draft)
kimuhding = (i:1) (t:v) (f:social/politics) (w:to meet/meeting) (d:<kimuh>, meet, with <ding>, written as one word: to meet, the meeting that is to take place; {tawh kimuhding} is to meet with) (j:kimuh/ding) (r:zd:19820/zd:12703) (q:draft)
kimuhkhop = (i:1) (t:v) (f:social/politics) (w:meet together/meet/hold a meeting) (d:<kimuh>, meet, and <khop>, together, written as one word, the form used before <ding>, <hun> and {-na}: meet with one another; {kimuhkhop hunding} is the time set for a meeting) (s:kimu) (j:kimuh/khop) (r:zd:14505/zd:19820/zd:25505) (q:draft)
kimuhkhopna = (i:1) (t:n) (f:social) (w:meeting/get-together) (d:<kimuh>, see each other, and <khopna>, being together, written as one word: a meeting at which people or groups come together to see and talk with one another) (s:kikhopna) (j:kimuh/khopna) (r:zd:15627/zd:10892) (q:draft)
kimuhkik = (i:1) (t:v) (f:social/family) (w:meet again/see each other again) (d:<kimuh> and <kik> written as one word: meet one another again after being apart) (j:kimuh/kik) (r:zd:9124/zd:25235) (q:draft)
kimuhna = (i:2) (t:n) (f:social) (w:meeting/talks/interview) (d:<kimu>, meet, with {-na}: a coming together of people to talk, after <tawh>, with, and with <nei>, hold; not the being found of the other sense) (r:ts:5194/zd:25045/zd:14579) (q:draft)
kimukha = (i:1) (t:v) (f:everyday/social) (w:meet/come across/encounter) (d:come to meet someone, often by chance; <tawh> marks the person met) (b:mukha) (r:zd:23138/ts:7023) (q:draft)
kimukha = (i:2) (t:v) (f:everyday) (w:be seen/be found) (d:passive of <mukha>: come to be seen or found; with <nawnlo> or <kei>, no longer or not to be seen anywhere) (b:mukha) (r:zd:16114/zd:12572) (q:draft)
kimukhawm = (i:1) (t:v) (f:social) (w:meet together/gather/get together) (d:<kimu> and <khawm> written as one word: come together and see one another) (j:kimu/khawm) (r:zd:24365/zd:9230) (q:draft)
kimukhiata = (i:1) (t:v) (f:media/everyday) (w:have been found/be discovered) (d:<kimukhia>, be found, and the particle <ta>, now or already, written as one word: has now been found) (j:kimukhia/ta) (r:zd:15886/zd:14583) (q:draft)
kimukhin = (i:1) (t:v) (f:everyday/media) (w:have been found/have been seen) (d:<mukhin>, have found, with the passive prefix <ki>: have already been found; also of people, have already met) (j:ki/mukhin) (r:zd:13102/zd:15886) (q:draft)
kimulo = (i:1) (t:v) (f:everyday) (w:not be seen/not be found) (d:<kimu> and <lo> written as one word, with <kimu> as the passive of <mu>, see: is not seen, is not found, there is none to be seen) (j:kimu/lo) (r:zd:21119/zd:17085) (q:draft)
kimuta = (i:1) (t:v) (f:media/everyday) (w:has been found/is now seen) (d:<kimu>, here be seen or be found, with <ta>, now, written as one word: has been found, can now be seen) (j:kimu/ta) (r:zd:20289/zd:13102/zd:12341) (q:draft)
kimutheilo = (i:1) (t:adj) (f:everyday) (w:invisible/unseen/not visible) (d:<kimuthei>, visible, and <lo>, not, written as one word: that cannot be seen) (j:kimuthei/lo) (r:zd:17247/zd:18083) (q:draft)
kimvial = (i:1) (t:adv) (f:everyday) (w:around/all around/round about) (d:<kim>, surroundings, with <vial>, round: going round a place or in a circle) (r:zd:12437/zd:25393) (q:draft, low confidence)
kin = (i:3) (t:adj) (f:everyday/work) (w:urgent/pressing/urgently) (d:said of a matter that cannot wait, as {vai kin}, an urgent matter, and {a kin zaw}, more urgent; after a verb, as in {ki deih kin} of notices, it means urgently) (r:zd:20418/zd:20823/zd:19222) (q:draft)
Kinabalu = (i:1) (t:name) (c:city) (f:travel) (w:Kinabalu) (d:second word of Kota Kinabalu, the capital city of the state of Sabah in Malaysia) (r:zd:12261/zd:11396) (q:draft)
kinahvawh = (i:1) (t:v) (f:social) (w:have dealings with/be involved with/be in touch with) (d:have to do with a person or thing, come into contact and deal with it; what one deals with is marked by <tawh>, with) (r:zd:17577/zd:24393/zd:24467) (q:draft)
kinai = (i:1) (t:v) (f:everyday/travel) (w:be near/be close) (d:be near to a place or to each other, used with <tawh>; {khat leh khat kinai}, come near one another) (a:kigamla) (b:nai) (r:2.14.20) (q:draft)
kinaksap = (i:1) (t:v) (f:everyday/social) (w:be greatly needed/need badly) (d:<kisap>, need, strengthened by an inner syllable meaning strongly: be much needed, or need someone or something very much; often followed by <mahmah>) (r:zd:20971/zd:25212/zd:21866) (q:draft)
kinakzat = (i:1) (t:v) (f:everyday) (w:be much used/be widely used) (d:the passive prefix <ki> with <nakzat>, use much: be used a great deal) (j:ki/nakzat) (r:zd:20207/ts:261) (q:draft)
kinang = (i:1) (t:v) (f:everyday/social) (w:be resisted/be withstood/be opposed) (d:be held off or stood up against; {kinang zolo} is cannot be resisted) (b:nang) (r:zd:25115/zd:22046) (q:draft, low confidence)
kinawh = (i:3) (t:v) (f:everyday/media) (w:be frequent/happen often) (d:of events such as fires or robberies, come one close upon another, happen often; said of the events themselves and not of a person who hurries) (r:zd:12494) (q:draft, low confidence)
kinawh sap = (i:1) (t:v) (f:social/work) (w:be called urgently/be summoned in haste) (d:<kinawh>, hurry, and <sap>, call: to be called to come quickly or at short notice, said in community notices of persons whom an office summons for an interview or for resettlement; the office that calls stands before it with <pan>) (r:zd:22459/zd:21550) (q:draft, low confidence)
kinawhzak = (i:1) (t:v) (f:media/everyday) (w:be heard of often/be reported frequently) (d:<kinawh>, quickly, with <zak>, hear: news of the same kind is heard again and again in close succession) (r:zd:12891/zd:14616) (q:draft)
kinawk = (i:1) (t:v) (f:everyday/travel/politics) (w:collide/clash/crash into) (d:strike against each other, said of vehicles that crash, of bodies that touch and of armies or sides that clash; {kinawk khakna} is a collision or contact) (b:nawk) (r:zd:19309/zd:16262/zd:26017) (q:draft)
kinawkkha = (i:1) (t:v) (f:travel) (w:collide/crash into/hit) (d:from <nawk>, strike against, with the prefix <ki> and <kha>, happen to: two vehicles run into each other, or one hits something, the other marked by <tawh>) (b:nawk) (r:zd:20982/zd:12105/zd:15836) (q:draft)
kinawkna = (i:1) (t:n) (f:politics/social) (w:clash/conflict/collision/friction) (d:striking against one another, from <nawk>, collide, with <ki> and the noun suffix <na>: a clash between people or groups, also the striking together of things) (r:zd:10910/zd:21605/zd:23729) (q:draft)
kinawktuahna = (i:1) (t:n) (f:politics/social) (w:clash/confrontation) (d:<kinawk>, clash, with <tuah>, meet, and the noun suffix {-na}: a clash between two sides, as between protesters and police or between armed groups) (b:kinawk) (r:zd:11145/ts:5605) (q:draft)
kinawl = (i:1) (t:v) (f:social) (w:be rejected/be pushed aside) (d:written before <khin> in {kinawl khin}, the form of <nawlkhin>, reject, with the prefix <ki>: be rejected, or reject one another) (b:nawlkhin) (r:zd:18952/zd:24200) (q:draft)
kinawn = (i:1) (t:v) (f:travel/work) (w:be transported/be carried/be moved) (d:passive of <nawn>, carry: of goods or people, be carried or moved from one place to another) (b:nawn) (r:zd:25146/zd:10912) (q:draft)
kinawt = (i:1) (t:v) (f:social/politics) (w:push forward/advance/progress) (d:<ki> with <nawt>, push: with <ma> or <mai>, front, push ahead, make progress; of two sides also rub or clash against each other) (b:nawt) (r:zd:12370/zd:22803) (q:draft)
kinbawl = (i:1) (t:v) (f:everyday/work) (w:attend to promptly/deal with first/give priority to) (d:<kin>, care about or treat as urgent, with <bawl>, do: see to something promptly and with care, not put it off) (j:kin/bawl) (r:zd:23367/zd:20782) (q:draft)
Kindergarten = (i:1) (t:n) (f:education) (w:kindergarten) (d:a school for small children before the first grade; {mukhu} is the word used beside it) (o:English) (r:zd:13059/zd:18128/zd:11995) (q:draft)
kine = (i:2) (t:v) (f:food/everyday) (w:be eaten/eat) (d:<ne>, eat, with the prefix <ki>, as the verb of the sentence and not before a noun: a food is eaten, or people in general eat it, as {an kine}, a meal is eaten; {kine thei} is can be eaten) (b:ne) (r:zd:16038/zd:19371/zd:23590) (q:draft)
kineiding = (i:1) (t:v) (f:media/politics) (w:will be held/will be carried out) (d:<kinei>, be held, and <ding>, will, written as one word: will be held, said of a meeting, a discussion, a trial or an inquiry) (j:kinei/ding) (r:zd:22565/zd:16395/zd:15639) (q:draft)
kineidinga = (i:1) (t:v) (f:social/religion) (w:will be held) (d:<kinei>, be held, with <ding>, will, and the linking <a>, written as one word: will be held, and then; used in announcements of a service or meeting) (j:kinei/ding/a) (r:zd:16747/zd:12684) (q:draft)
kineidinghi = (i:1) (t:v) (f:social/religion) (w:will be held) (d:<kinei>, <ding> and <hi> written as one word, here {ki-} with <nei>, be held: a service, funeral or meeting will be held) (j:kinei/ding/hi) (r:zd:21987/zd:23172) (q:draft)
kineih = (i:2) (t:v) (f:politics/social) (w:go to law/have a case/dispute) (d:after <thu>, matter: two sides have a case or dispute with each other, before a court or an office; here it is <neih>, have, with the prefix <ki> for one another, and has nothing to do with pretending) (r:zd:21876/zd:21125) (q:draft)
kineihsak = (i:1) (t:v) (f:religion/social) (w:be held for/be made for) (d:<ki> with <neihsak>, have something for someone: a prayer or a request is made on behalf of someone, as in {thungetna kineihsak}, prayer is offered for them) (j:ki/neihsak) (r:zd:25734/zd:14751) (q:draft)
kineihsiam = (i:1) (t:n) (f:media) (w:actor/performer) (d:<kineih>, pretend, with <siam>, skilled: a person who acts in films or videos; {kineihsiam numei} is an actress and {kineihsiam pasal} an actor; also used as a verb, play a part well) (r:ts:11153/zd:23382) (q:draft)
kineikhin = (i:1) (t:v) (f:everyday/politics) (w:have been held/be already done) (d:<kinei>, be held, with <khin>, already, written as one word: of a meeting, inquiry or check, already carried out) (j:kinei/khin) (r:zd:20850/zd:14537) (q:draft)
kineikik = (i:1) (t:v) (f:politics/social) (w:be held again/take place again) (d:<kinei> and <kik> written as one word: be held again, said of a court hearing, a protest or a meeting) (j:kinei/kik) (r:zd:20282/zd:15091) (q:draft)
kineikikding = (i:1) (t:v) (f:politics/social) (w:will be held again/will take place again) (d:<kineikik> and <ding> written as one word: will be held again, said of a court hearing or a decision) (j:kineikik/ding) (r:zd:12172/zd:16876/zd:12741) (q:draft)
kineilai = (i:1) (t:v) (f:everyday/media) (w:still be had/still be held/be still to come) (d:<kinei>, be had or held, and <lai>, still, written as one word: there still are, or it is still being carried out) (j:kinei/lai) (r:zd:15531/zd:16660) (q:draft)
kineilo = (i:1) (t:v) (f:everyday/social) (w:not be held/not be had/there is none) (d:<kinei>, be had or held, and <lo>, not, written as one word: there is none of it, it has not been held or done) (j:kinei/lo) (r:zd:15712/zd:11010/zd:14927) (q:draft)
kineipah = (i:1) (t:v) (f:media/politics) (w:be held at once/be carried out immediately) (d:<kinei>, be held or done, and <pah> written as one word: a notice, a questioning or an operation is made or carried out at once) (j:kinei/pah) (r:zd:20313/zd:20661/zd:12658) (q:draft)
kineisak = (i:1) (t:v) (f:everyday/work) (w:be carried out/be held/be conducted) (d:<kinei>, be held or done, and <sak> written as one word: an inspection, inquiry or service is carried out, often on behalf of someone) (j:kinei/sak) (r:zd:12398/zd:14742) (q:draft, low confidence)
kineita = (i:1) (t:v) (f:social/politics) (w:has been held/be held now) (d:<kinei> and <ta> written as one word: has now been held or carried out, of a trial, a funeral or a test) (j:kinei/ta) (r:zd:20446/zd:15781) (q:draft)
kineithei = (i:1) (t:v) (f:everyday/social) (w:can be held/can be done) (d:<kinei>, be held or carried out, and <thei>, able, written as one word: a meeting, talks, an inquiry or an event can be held, or one is able to have it) (j:kinei/thei) (r:zd:17064/ts:11570/zd:20328) (q:draft)
kineito = (i:1) (t:v) (f:social/everyday) (w:go on being held/continue to be held) (d:<kinei>, be held, and <to> written as one word: of a meeting, a ceremony or a process, go on to be held, be held in continuation) (j:kinei/to) (r:ts:2711/zd:11447) (q:draft)
kineizo = (i:1) (t:v) (f:everyday) (w:can be had/can be held/be achieved) (d:<kinei>, be had or held, and <zo>, able, written as one word: can be had, held or achieved; {kineizo lo} is cannot be had) (j:kinei/zo) (r:zd:20999/zd:15941) (q:draft)
kineumuh = (i:1) (t:v) (f:social) (w:be looked down on/be despised/belittle oneself) (d:from <neu>, small, and <muh>, see, with the prefix {ki-}: be seen as small, be looked down on; with {nangle nang} or {ei leh ei}, look down on oneself; the opposite is <kipimuh>) (r:zd:20032/zd:20892) (q:draft)
kineuseek = (i:1) (t:v) (f:social) (w:belittle/look down on/despise) (d:with the prefix {ki-} and <neu>, small: belittle one another or oneself, treat as of little worth; also be looked down on) (r:zd:25923/zd:24592) (q:draft)
kineusek = (i:1) (t:v) (f:social) (w:belittle oneself/belittle one another) (d:<ki> and <neusek> written as one word: think or make little of oneself or of each other) (j:ki/neusek) (r:zd:20391/zd:21159) (q:draft)
kinga = (i:2) (t:v) (f:everyday/social) (w:depend on/rely on/rest with) (d:said of a matter, a result or a person and not of a thing lying on another: depend on or rely on what is named before <tungah> or <ah>) (r:zd:24306/zd:16412/zd:25919) (q:draft)
kingahkhia = (i:1) (t:v) (f:politics/everyday) (w:be seized/be captured/be obtained) (d:<kingah>, be obtained, with <khia>, out, written as one word: be got out of a place, said mostly of weapons and vehicles taken from the enemy) (j:kingah/khia) (r:ts:7798/ts:1745/ts:8850) (q:draft)
kingahlo = (i:1) (t:v) (f:everyday) (w:not be obtained/be unavailable/cannot be got) (d:<kingah>, be obtained, with <lo>, not: something is not got or cannot be had) (j:kingah/lo) (r:zd:22581/zd:25346/zd:19392) (q:draft)
kingahna = (i:1) (t:n) (f:everyday/media) (w:obtaining/source/means of getting) (d:<kingah>, be obtained, with the noun suffix {-na}: the getting of something, or the place or means by which it is got; {sazian kingahna ah} is according to the figures received) (b:kingah) (r:zd:23272/ts:5729) (q:draft)
kingahthei = (i:1) (t:v) (f:everyday/health) (w:can be obtained/be available/can be caught) (d:<kingah>, be got, and <thei>, able, written as one word: it can be got or is available; of an illness, one can get it) (j:kingah/thei) (r:zd:25924/zd:24276) (q:draft)
kingai = (i:3) (t:v) (f:social/family) (w:be fond of each other/care for each other/hold each other dear) (d:of kin, friends or one people, not of a couple: feel affection for one another and miss one another, often paired with {ki-it}, love one another) (r:zd:24488/zd:23037) (q:draft)
kingaihsun = (i:3) (t:v) (f:everyday) (w:be thought/be considered/be reckoned) (d:<ngaihsun>, think, with the prefix <ki> as a passive: a thing or matter is thought of, taken into account or reckoned in a certain way, where the one thinking is not the one thought about) (r:zd:20041/zd:14887) (q:draft)
kingaite = (i:1) (t:n) (f:social/family) (w:lovers/sweethearts/courting couple) (d:<kingai>, love each other, and the plural <te> written as one word: those who are in love with each other; {lawm kingaite} is sweethearts) (j:kingai/te) (r:ts:3375/zd:20116) (q:draft)
kingakh = (i:1) (t:v) (f:social/everyday) (w:lean on/rely on/depend on) (d:another spelling of <kingak> in the sense lean on, used before <nading> and {-na}: {kingakh-na} is support or dependence) (j:kingak) (r:zd:20032/zd:15847) (q:draft, low confidence)
kingaklah = (i:1) (t:v) (f:everyday/social) (w:be eagerly awaited/look forward to/be eager) (d:<ngaklah>, long for, with the prefix <ki>: of a thing or a day, be waited for with impatience; of people, be eager for it) (j:ki/ngaklah) (r:ts:479/zd:21121/zd:20060) (q:draft)
kingakna = (i:2) (t:n) (f:social/religion) (w:reliance/dependence/support) (d:<kingak>, lean on, with the ending <na>: the leaning on or trusting in someone, or the person or thing that is leaned on, often after <tungah> or beside {muan leh suan}; not a physical stand) (r:zd:21803/zd:9428/zd:23431) (q:draft)
kingalo = (i:1) (t:v) (f:everyday) (w:not depend on/not rest on) (d:<kinga>, rest on, and <lo>, not, written as one word: not resting on or depending on something, with <tungah>) (j:kinga/lo) (r:zd:23394/zd:16415) (q:draft)
kingawh = (i:2) (t:v) (f:social) (w:blame/accuse/be blamed) (d:<ngawh>, blame, with the prefix <ki>: put the blame on one another or on someone, or be blamed, often with <thei> or <theilo>; not the adverb that stands before a verb) (s:kimawhsak) (r:zd:24213/zd:23821/zd:25461) (q:draft)
kingelh = (i:1) (t:v) (f:education/media) (j:kigelh) (r:zd:24091/zd:20271) (q:draft)
kingetna = (i:1) (t:n) (f:social/religion) (w:request/appeal) (d:<kinget>, be asked for, with the noun ending <na>: a request that is made, a thing asked for; {thu a kingetna} is a prayer that is offered) (s:ngetna) (b:kinget) (r:zd:24470) (q:draft, low confidence)
kingkeng = (i:1) (t:adv) (f:everyday) (w:firmly/solidly) (d:placed after a verb or descriptive word: in a firm, settled and full way; {cidam kingkeng} is in sound health and {nei kingkeng} is hold firmly) (r:zd:24233/zd:15697) (q:draft, low confidence)
kinialgawp = (i:1) (t:v) (f:social) (w:argue fiercely/quarrel badly) (d:<kinial>, argue with one another, with <gawp>, severely, written as one word) (j:kinial/gawp) (r:zd:12696/zd:15431) (q:draft)
kinialnial = (i:1) (t:v) (f:social) (w:keep arguing/argue back and forth/quarrel) (d:<kinial>, argue, with its last part said twice: go on arguing with one another; often with <kam>, mouth, for a quarrel in words) (b:kinial) (r:zd:15016/zd:14568/zd:17725) (q:draft)
kiniam = (i:2) (t:v) (f:everyday/work) (w:be low/be behind) (d:be at a low level compared with others, said of a field such as education or business, {lai lam kiniam}; nobody brings it low, unlike the sense with <koih>) (r:zd:24121/zd:21066/zd:24156) (q:draft)
kining = (i:1) (t:v) (f:everyday) (w:be fed up/be tired of/have had enough) (d:have so much of something that one is tired of it or bored by it; of food and goods, as in {kining cing}, be plentiful) (r:zd:17784/zd:22341) (q:draft, low confidence)
kinken = (i:1) (t:adv) (f:everyday) (w:constantly/steadily/always) (d:placed after a verb: keep on doing it steadily, without letting up, as in {muang kinken}, keep trusting) (r:zd:9262/zd:25199/zd:21013) (q:draft, low confidence)
kinopneh = (i:1) (t:v) (f:social) (w:be looked down on/be bullied/be taken lightly) (d:passive of <nopneh>: be treated as weak and of no account) (b:nopneh) (r:zd:23902/zd:23419) (q:draft)
kinuampih = (i:1) (t:v) (f:social) (w:rejoice with/be glad together with) (d:<kinuam>, be glad, with <pih>, together with: share the joy of others, set beside <kidahpih>, grieve with) (j:kinuam/pih) (r:zd:20262/zd:11024) (q:draft)
KIO = (i:1) (t:name) (f:politics) (w:Kachin Independence Organisation) (d:abbreviation of the Kachin Independence Organisation, an armed political organisation of the Kachin people in Myanmar; its army is the KIA) (r:zd:14924/zd:17927) (q:draft)
kiom = (i:1) (t:v) (f:everyday) (w:there are/be/live/stay) (d:<ki> and <om> written as one word: people are or stay somewhere, said of people in general or of a group that includes the speaker; {tampi kiom hi} is there are many) (j:ki/om) (r:zd:19219/zd:19556/zd:18896) (q:draft)
kipaak = (i:1) (t:v) (f:everyday) (j:kipak) (r:zd:16500/zd:22749) (q:draft)
kipaakta = (i:1) (t:v) (f:social) (j:kipakta) (r:zd:17758/zd:19400) (q:draft)
kipahpih = (i:1) (t:v) (f:social) (w:rejoice with/congratulate/be glad about) (d:<kipah>, be glad, with <pih>, together with: share the joy of someone, or be pleased with a thing) (s:lungdampih) (b:kipah) (r:zd:17858/zd:20172) (q:draft)
kipahtawi = (i:2) (t:v) (f:social) (w:honor one another/praise each other) (d:the reciprocal use of <ki> with <pahtawi>: people honor and praise each other, brought out by {khat le khat} or {ei leh ei}, not the passive be honored) (r:zd:10726/zd:9448/zd:22709) (q:draft)
kipaikhawm = (i:1) (t:v) (f:social) (w:gather/go together/come together) (d:<kipai> and <khawm> written as one word: people go or come together to one place, attend together) (j:kipai/khawm) (r:zd:10973/ts:11168) (q:draft)
kipaithei = (i:1) (t:v) (f:travel) (w:can be travelled/be passable) (d:<kipai>, one goes, with <thei>, can, written as one word: people can go, of a road or place that is open to travel) (j:kipai/thei) (r:zd:23803/zd:17067) (q:draft)
kipaktak = (i:1) (t:adv) (f:everyday/social) (w:joyfully/gladly/happily) (d:<kipak> and <tak> written as one word, usually followed by <in>: with joy, gladly) (j:kipak/tak) (r:zd:21613/zd:11827) (q:draft)
kipan = (i:1) (t:v) (f:everyday/time) (w:begin/start) (d:start to do something or come into being; after a verb with <ding>, begin to do; with <panin>, start from a place) (s:kipat) (a:tawp/bei) (q:draft)
kipanding = (i:1) (t:v) (f:time) (w:will begin/will start) (d:<kipan>, begin, with the future marker <ding>, written as one word: will begin, is to start; after <tawh>, starting from an amount) (j:kipan/ding) (r:zd:22504/zd:13314/zd:18208) (q:draft)
kipang = (i:1) (t:v) (f:social) (w:take the lead/press forward/take a stand) (d:<pang>, take up a position, with the prefix <ki>; in the articles after <ma>, front: <ma kipang> is put oneself at the front, lead the way or press forward, often with <khawm>, together) (b:pang) (r:zd:22595/zd:21232/zd:22696) (q:draft)
kipang = (i:2) (t:v) (f:social) (w:pretend/feign) (d:placed after a verb phrase: act as if, pretend to be; {a theilo kipang} is pretend not to know) (b:pang) (r:zd:23604) (q:draft, low confidence)
kipangkhawm = (i:1) (t:v) (f:social/politics) (w:stand together/work together/cooperate) (d:<pangkhawm>, stand with, with the prefix <ki>: take a stand together, join forces) (b:pangkhawm) (r:zd:23367/zd:22046) (q:draft)
kipankhin = (i:1) (t:v) (f:everyday/time) (w:have begun/have already started) (d:<kipan>, begin, and <khin>, already, written as one word: has already begun or been started) (j:kipan/khin) (r:zd:24116/zd:16421/zd:11308) (q:draft)
kipanpah = (i:1) (t:v) (f:everyday/time) (w:begin at once/start immediately) (d:<kipan>, begin, with <pah>, at once, written as one word: start right away; placed after the action that is begun) (j:kipan/pah) (r:zd:14787/zd:12136/zd:15372) (q:draft)
kipanpan = (i:1) (t:v) (f:everyday/time) (w:begin/have just begun/start at last) (d:<kipan>, begin, with <pan>, here only now: something is just starting or starts at last, often followed by <ta>) (b:kipan) (r:zd:16337/zd:24170/zd:22356) (q:draft, low confidence)
kipanpih = (i:1) (t:v) (f:social) (w:help one another/support/assist) (d:<panpih>, help, with <ki>: help and stand by one another; also be helped, be given as aid) (s:kihuh) (b:panpih) (r:zd:22709/zd:23657) (q:draft)
kipanpihna = (i:1) (t:n) (f:social) (w:mutual help/support/assistance) (d:<kipanpih> with the noun suffix <na>: helping and standing by one another) (b:kipanpih) (r:zd:21155/zd:17481) (q:draft)
kipansak = (i:1) (t:v) (f:everyday) (w:start/begin/set going) (d:<kipan>, begin, with the causative <sak>, written as one word: make something begin; {tawh kipansak} is begin with) (j:kipan/sak) (r:zd:11109/zd:15408) (q:draft)
kipantah = (i:1) (t:v) (f:family/education) (w:be brought up/be trained/be nurtured) (d:<ki> and <pantah> written as one word: be brought up, taught and trained, said of children and pupils) (j:ki/pantah) (r:zd:23443/zd:19501) (q:draft)
kipanthei = (i:1) (t:v) (f:everyday/time) (w:can begin/be able to start) (d:<kipan>, begin, with <thei>, able, written as one word) (j:kipan/thei) (r:zd:20387/zd:24276) (q:draft)
kipatau = (i:1) (t:v) (f:everyday/social) (w:be alarmed/panic/be anxious) (d:<patau>, be alarmed, with the prefix <ki>: people are alarmed or anxious about something, there is alarm) (b:patau) (r:zd:22046/zd:25847/zd:18181) (q:draft)
kipatcillam = (i:1) (t:n) (f:time) (w:beginning/early part/start) (d:<kipatcil> and <lam> written as one word: the early part of a month or period; {tukha kipatcillam in} is early this month) (j:kipatcil/lam) (r:zd:15205/zd:16421) (q:draft)
kipatkhiat = (i:1) (t:v) (f:everyday/time) (w:begin/start out/originate) (d:<kipat>, begin, with <khiat>, out, written as one word: set about something, or of a movement or belief, come into being; the form used when a word such as <ding>, <cil> or {phet in} follows) (j:kipat/khiat) (r:zd:25221/zd:17309/zd:23860) (q:draft)
kipatlam = (i:1) (t:n) (f:time) (w:beginning/early part) (d:<kipat> and <lam> written as one word: the early part of a month or year; {tukum kipatlam in} is at the beginning of this year) (j:kipat/lam) (r:zd:15431/zd:12355/zd:16346) (q:draft)
kipatni = (i:1) (t:n) (f:time) (w:starting day/day of beginning) (d:<kipat>, begin, and <ni>, day, written as one word: the day on which something begins) (j:kipat/ni) (r:zd:17327/zd:22771) (q:draft)
kipatpen = (i:1) (t:phrase) (f:time/media) (w:the start was/it began) (d:<kipat> and the topic marker <pen> written as one word, placed after a noun and before a time: as for when it began, the start of it) (j:kipat/pen) (r:zd:12900/zd:14681) (q:draft)
kipattah = (i:1) (t:v) (f:education/family) (w:be trained/be brought up/be disciplined) (d:be trained or brought up in good habits, {ki-} with <pattah>, train; also the upbringing itself, as in {kipattah dan}, the way one is brought up) (r:zd:24324/zd:25056/zd:23157) (q:draft)
kipattahna = (i:1) (t:n) (f:education/work) (w:training/practice/exercise) (d:<kipattah>, train oneself, with the noun suffix {-na}: training in a skill or habit, or a course that gives it) (s:kisinna) (r:zd:23386/zd:22291/zd:23528) (q:draft)
kipawl = (i:4) (t:v) (f:social/politics) (w:unite/band together/ally/organize) (d:come together as one group or alliance, said of several people or groups at once and often followed by <khawm>, together; the other senses have one side joining another with <tawh>) (r:zd:25399/zd:10743/zd:26163) (q:draft)
kipawlkhawmte = (i:1) (t:n) (f:politics) (w:allies/allied forces/coalition) (d:<kipawlkhawm>, unite as allies, with the plural <te>: those who have joined together; in war reports the armed groups fighting on one side) (b:kipawlkhawm) (r:ts:4513/ts:6842/ts:4083) (q:draft)
kipawlkhop = (i:1) (t:v) (f:social) (w:associate together/join together/cooperate) (d:<kipawl>, associate, and <khop>, together, written as one word: keep company and work together with others) (j:kipawl/khop) (r:zd:20999/zd:22046/zd:8668) (q:draft)
kipawlkhopna = (i:1) (t:n) (f:social/politics) (w:unity/union/association/federation) (d:<kipawl>, join, with <khopna>, being together, written as one word: the joining together of people, unity, or a body in which groups are joined) (j:kipawl/khopna) (r:zd:16640/zd:16844) (q:draft)
kipawlna = (i:2) (t:n) (f:social/politics) (w:organization/association/group) (d:a body of people formed for a purpose, not the act of allying: {khua kipawlna} is a village association and <thautawi kipawlna> an armed group; often after the name of the body) (r:ts:6525/ts:8477/zd:22652) (q:draft)
kipawlnate = (i:2) (t:n) (f:social/politics) (w:organizations/associations/groups) (d:plural of <kipawlna> as an organized body of people: societies, associations and armed groups, as in {thautawi kipawlnate}, armed groups; not the joints of the body) (b:kipawlna) (r:zd:14746/zd:22650/zd:22019) (q:draft)
kipawlpih = (i:2) (t:n) (f:politics/social) (w:ally/associate/partner) (d:the one a person or group has joined with, used as a noun without <a> before it: {kipawlpih galkapte} are allied soldiers and {kipawlpih nei} is have an ally or partner) (r:zd:25569/zd:22228/zd:25790) (q:draft)
kipeel = (i:1) (t:v) (f:everyday/social) (w:be avoided/keep away from) (d:<peel>, avoid, with the prefix <ki>: be avoided, stay apart from; {kipeel theilo} is unavoidable, not able to do without) (b:peel) (r:zd:22650/zd:17152) (q:draft)
kipei = (i:2) (t:v) (f:everyday/work/social) (w:bustle/be busy/be active) (d:of people, not of wind or a wheel: move about busily, be hard at work or get moving for a cause, often {hong kipei} and with a following adverb such as <ziahziah> or <ngeingai>) (r:zd:20369/zd:16022/zd:24677) (q:draft)
kipeigawp = (i:1) (t:v) (f:travel) (w:spin out of control/spin round) (d:<kipei>, spin, and <gawp> written as one word: of a vehicle or an aircraft, spin or swerve violently out of control) (j:kipei/gawp) (r:zd:19157/zd:19351) (q:draft)
kipeipei = (i:1) (t:v) (f:everyday) (w:keep turning/go round and round/revolve) (d:doubled form of <kipei>, spin: turn round and round, also of a person busy going round in the same work, and of times that keep turning) (b:kipei) (r:zd:12687/zd:11438/zd:16696) (q:draft)
kipek = (i:1) (t:v) (f:nature/everyday) (w:swim/struggle) (d:<ki> with <peek>, swim or kick: move oneself through water, as in {tui kipek}; also said of struggling on in a hard situation) (r:zd:15541/ts:11162) (q:draft, low confidence)
kipel = (i:1) (t:v) (f:everyday/social) (w:keep away from/avoid/be apart from) (d:<pel>, avoid, with the prefix <ki>: keep oneself away from a thing or be separate from it, said after <tawh>, with) (b:pel) (r:zd:9446/zd:23729) (q:draft)
kipet = (i:1) (t:v) (f:body/everyday) (w:bite each other/bite one another) (d:<pet>, bite, with the reciprocal <ki>; in the proverb {lei leh ha zong kipet}, even tongue and teeth bite each other, said of quarrels among people who live close together) (b:pet) (r:zd:23761/zd:24176) (q:draft)
Kipgen = (i:1) (t:name) (c:beh) (f:family/social) (w:Kipgen) (d:a clan name, found among the Thadou-Kuki and among the Zomi) (r:ts:4569/zd:23938) (q:draft)
kipha = (i:1) (t:v) (f:everyday) (w:number/amount to/reach) (d:follows a number or quantity: there are that many, the total comes to that much; {mi 21 kipha hi} is there were 21 people) (r:zd:17197/zd:12801/zd:8667) (q:draft)
kiphal = (i:2) (t:v) (f:social) (w:be willing/be generous/give freely) (d:with a person as subject, as in {ka kiphal mahmah hi}: be willing to give oneself, one's time or one's goods, be generous; not the passive be allowed of things and actions) (r:zd:22085/zd:24072/zd:25457) (q:draft)
kiphallo = (i:1) (t:v) (f:politics/social) (w:be forbidden/not be allowed/be prohibited) (d:<kiphal>, be allowed, and <lo>, not, written as one word: it is not allowed, it is forbidden) (j:kiphal/lo) (r:zd:12774/zd:11783/zd:11642) (q:draft)
kipham = (i:1) (t:v) (f:social) (d:only in {luang kipham}: stand by one another to the death and see to the burial of one another's dead; of the dead, be cared for and buried by their own people) (r:zd:21701/zd:25461) (q:draft, low confidence)
kiphattuampih = (i:1) (t:v) (f:social/everyday) (w:benefit from/be of benefit) (d:<phattuampih> with the prefix <ki>: people gain good from something or someone, or two sides benefit each other) (b:phattuampih) (r:zd:22757/zd:25056) (q:draft)
kiphawk = (i:2) (t:v) (f:everyday) (w:realise/be aware/notice) (d:<phawk> turned back on oneself: become aware of one's own state or of a fact about oneself, mostly after a clause ending in <lam>; {kiphawk kha lo} is without realising it) (r:zd:15527/zd:12337/zd:19108) (q:draft)
kiphelhsiang = (i:1) (t:v) (f:everyday) (w:be put out completely/be extinguished) (d:<kiphelh>, be put out, with <siang>, clean: of a fire, be put out completely) (s:kiphelh) (j:kiphelh/siang) (r:zd:12736/zd:19125) (q:draft)
kiphelkhap = (i:1) (t:v) (f:everyday/politics) (w:be split apart/break apart/shatter) (d:<phelkhap>, split, with the prefix <ki>: be split in pieces, said of a thing, a mountain or a country) (s:kikhenkham) (b:phelkhap) (r:zd:22291/ts:3280) (q:draft)
kiphinna = (i:1) (t:n) (f:politics/social) (w:uprising/agitation/revolt/provocation) (d:<kiphin>, provoke each other, with the noun suffix <na>: in the news a rising or agitation against a ruler; also the provoking or teasing of one another) (s:langpanna) (b:kiphin) (r:zd:11043/zd:10833/zd:10857) (q:draft)
kiphitkhia = (i:1) (t:v) (f:nature) (w:be spewed out/be blown out/erupt) (d:<ki> with <phit>, here blow or spurt, and <khia>, out: of ash, smoke or pressure, be forced out in a jet, as from a volcano) (r:zd:17733/zd:20023) (q:draft)
kiphuah = (i:2) (t:v) (f:media/religion) (w:be composed/be written) (d:passive of <phuah> in the sense of compose: of a song or hymn, be made up, after <la> or {hymn}, where the Bible sense is of a name being given) (r:zd:9218/zd:9211/zd:9255) (q:draft)
kiphuah = (i:3) (t:v) (f:social/politics) (w:be formed/be set up/be founded) (d:of a group, a force or a household, be set up or made up, with <tawh> for those it is formed of) (r:zd:25097) (q:draft, low confidence)
kiphuak = (i:2) (t:v) (f:media/religion) (w:be composed/be written) (d:of a song, a tune or a poem: be composed, with <la>, song, or {la-aw}, tune, where the other sense is the giving of a name; {a kiphuak tawm} is something made up) (s:kiphuah) (r:zd:9262/zd:9240/zd:9218) (q:draft)
kiphuaka = (i:1) (t:v) (f:media/religion) (w:be composed/be named) (d:<kiphuak> and the linking <a> written as one word: was composed, of the words or tune of a hymn, or was given as a name, and then) (j:kiphuak/a) (r:zd:9263/zd:9261) (q:draft)
kiphuaktawm = (i:1) (t:v) (f:media/everyday) (w:be made up/be invented/be fabricated) (d:<phuaktawm>, make up, with the passive prefix <ki>: of a story, be invented) (b:phuaktawm) (r:zd:21780) (q:draft)
kiphuakte = (i:1) (t:n) (f:religion/media) (w:those composed/compositions) (d:<kiphuak> and <te> written as one word, with <kiphuak> in the sense be composed: the songs, tunes or verses that have been composed) (j:kiphuak/te) (r:zd:9252/zd:9239) (q:draft)
kiphuan = (i:1) (t:v) (f:social/politics) (w:be founded/be established/be formed) (d:passive of <phuan>, set up: of a church, school, party or committee, be founded; often with <khia>) (s:kiphut) (b:phuan) (r:zd:19998/zd:18200/zd:21042) (q:draft)
kiphuankhia = (i:1) (t:v) (f:social/politics) (w:be founded/be formed/be established) (d:of an organisation, a committee or a company: be set up, be brought into being) (r:zd:23952/zd:24074) (q:draft)
kiphuat = (i:1) (t:v) (f:politics/social) (w:be founded/be established/be formed) (d:of a party, a church body or an organisation, be founded; the form of <kiphuan> used before words such as <ciangin>, <cil>, <khit> and <nung>) (s:kiphut) (r:zd:9266/ts:7065/zd:17120) (q:draft)
kiphugawp = (i:1) (t:v) (f:travel) (w:collide violently/pile up/crush against each other) (d:<kiphu>, collide, with <gawp>, severely: of several vehicles, crash into one another; of a crowd, crush against one another) (j:kiphu/gawp) (r:zd:14781/zd:12967/zd:15489) (q:draft)
kiphuh = (i:2) (t:v) (f:social/religion/politics) (w:be founded/be established/be set up) (d:of a church, an organisation, a factory or a state: be founded or set up, after the name of the body or after <pawlpi>; not the laying of a foundation stone) (r:zd:24029/zd:25063/zd:26306) (q:draft)
kiphul = (i:1) (t:v) (f:travel/everyday) (w:collide/crash into/run into) (d:hit against one another, as vehicles on a road or people in a crowd; also run into a hardship) (r:zd:11579/zd:25919) (q:draft)
kiphumna = (i:3) (t:n) (f:religion) (w:baptism/immersion) (d:being immersed as a rite of the church, from <kiphum>, be baptized: {tui kiphumna} is water baptism and {Kha Siangtho sunga kiphumna} is baptism in the Holy Spirit; <tui> or <sunga> before it sets it apart from burial) (s:tuiphumna) (r:zd:21052/zd:24055) (q:draft)
kiphun = (i:1) (t:v) (f:social/media) (w:complain/grumble/protest) (d:<phun>, grumble, with the prefix <ki>: people complain, there is complaining about something; {kiphun ngeingai} is complain loudly) (b:phun) (r:zd:24234/zd:14768/zd:11943) (q:draft)
kiphutkhakna = (i:1) (t:n) (f:travel) (w:collision/crash) (d:{kiphut khak}, run into each other, with the noun suffix <na>; {mawtaw kiphutkhakna} is a car crash) (r:zd:16200/zd:11048) (q:draft)
kiphutkhia = (i:1) (t:v) (f:politics/social) (w:be founded/be established/be set up) (d:<kiphut>, be set up, and <khia>, out, written as one word, the passive of <phutkhia>: of an organisation or a country, be founded) (j:kiphut/khia) (r:zd:9452/ts:3234) (q:draft)
kipia = (i:2) (t:v) (f:religion/social) (w:give oneself/offer oneself/devote oneself) (d:reflexive of <pia>, give, with a person as the subject and often <khia> after it: give oneself up to a task or to God, where the passive sense is said of the thing that is given) (r:zd:25572/zd:19174) (q:draft, low confidence)
kipiading = (i:1) (t:v) (f:everyday/politics) (w:will be given/to be granted) (d:<kipia> and <ding> written as one word: will be given, granted or issued) (j:kipia/ding) (r:zd:11118/zd:10993) (q:draft)
kipiak = (i:2) (t:v) (f:social) (w:give one another/exchange/pass) (d:<piak>, give, with <ki> in its mutual meaning: people give something to each other; {tha kipiak} is encourage one another, and in football {bawlung kipiak} is pass the ball) (r:zd:19302/zd:24062/zd:20349) (q:draft)
kipiakbeh = (i:1) (t:v) (f:everyday/work) (w:be given in addition/be added) (d:<piakbeh>, give more, with the passive prefix <ki.2>: be given as well, on top of what was already given) (b:piakbeh) (r:zd:19569/zd:11675) (q:draft)
kipiakhia = (i:2) (t:v) (f:social/religion) (w:give oneself/devote oneself/offer oneself/volunteer) (d:reflexive of <piakhia>, not the passive be given: give oneself up for a person or a cause, mostly after <ading> or <tangin>, for, or with {amah leh amah}) (r:zd:19174/zd:22779/zd:24948) (q:draft)
kipiakhin = (i:1) (t:v) (f:everyday) (w:have been given/have been issued) (d:<kipia> and <khin> written as one word: has already been given, issued or handed in) (j:kipia/khin) (r:zd:15054/zd:12727/zd:15779) (q:draft)
kipiakkhiat = (i:1) (t:v) (f:social/religion) (w:give oneself up/devote oneself/surrender) (d:give oneself over, in devotion to a work or to God, or in surrender to an enemy; the reflexive form of <piakkhiat>, give up) (b:piakkhiat) (r:zd:24607/zd:25572/ts:301) (q:draft)
kipiakkhiatna = (i:1) (t:n) (f:religion/social) (w:dedication/self-sacrifice/devotion) (d:giving oneself up for others or for a cause: <kipiakkhiat>, give oneself up, with the noun suffix {-na}) (b:kipiakkhiat) (r:zd:26026/zd:24172) (q:draft)
kipiakzah = (i:1) (t:n) (f:work) (w:amount given/amount paid) (d:<kipiak> and <zah> written as one word: the amount that is given or paid out) (j:kipiak/zah) (r:zd:23749) (q:draft)
kipialeh = (i:1) (t:v) (f:everyday) (w:if given/when given) (d:<kipia>, be given, and <leh>, if, written as one word: if or when something is given) (j:kipia/leh) (r:zd:20646/zd:14885/zd:21943) (q:draft)
kipialo = (i:1) (t:v) (f:everyday) (w:not be given) (d:<kipia>, be given, and <lo>, not, written as one word: is not given, is not granted) (j:kipia/lo) (r:zd:17634/zd:11454) (q:draft)
kipiang = (i:1) (t:v) (f:everyday/family) (w:be born/come into being) (d:<piang>, be born, with the prefix {ki-}: one is born, people are born, said in general) (b:piang) (r:zd:11831/zd:12170/zd:22116) (q:draft)
kipiata = (i:1) (t:v) (f:media/politics) (w:has been given/is now given) (d:<kipia>, be given, and <ta>, the marker of a completed change, written as one word: has now been given, much used in headlines) (j:kipia/ta) (r:zd:10936/zd:11675) (q:draft)
kipiathei = (i:1) (t:v) (f:everyday/politics) (w:can be given/may be imposed) (d:<kipia> and <thei> written as one word: can be given, of money, a name or a penalty) (j:kipia/thei) (r:zd:14877/zd:16949/zd:17945) (q:draft)
kipicing = (i:1) (t:v) (f:everyday/social) (w:become mature/mature/grow up) (d:<picing>, mature, with the prefix <ki>: grow to maturity in body, mind or work) (b:picing) (r:zd:25300/zd:21377) (q:draft)
kipil = (i:1) (t:v) (f:education) (w:become wise/grow in knowledge) (d:<pil>, wise, with the prefix <ki>: of people in general, become wise or learned; {kipil sak} is make oneself wise, and also make oneself out to be wise, see <kipilsak>) (b:pil) (r:zd:24361/zd:22742) (q:draft, low confidence)
kipilsakna = (i:1) (t:n) (f:social) (w:conceit/pretending to be wise/showing off one's knowledge) (d:<kipilsak>, think oneself wise, with the noun suffix <na>: making oneself out to be clever) (b:kipilsak) (r:zd:21280/zd:22853) (q:draft)
kipimuh = (i:1) (t:v) (f:social) (w:be esteemed/be looked up to/be highly regarded) (d:<pimuh>, regard as great, with the prefix <ki>: be seen as great by others, the opposite of <kineumuh>) (a:kineumuh) (b:pimuh) (r:zd:20032/zd:22034) (q:draft)
kipkho = (i:1) (t:adj) (f:social/politics) (w:stable/permanent/firmly established) (d:<kip> and <kho> written as one word: standing firm and lasting, stable; {a kipkho mipi} is a permanent population) (j:kip/kho) (r:zd:25054/zd:22176) (q:draft)
kiplet = (i:1) (t:v) (f:everyday/social) (w:hold fast/hold firmly/keep firmly) (d:<kip>, firm, with <let>, hold: hold firmly to a belief, a name or a decision and not let it go) (j:kip/let) (r:zd:20125/zd:19783/zd:21590) (q:draft)
kiplo = (i:1) (t:adj) (f:everyday) (w:not firm/unstable/unsteady/insecure) (d:<kip>, be firm, and <lo>, not, written as one word: not firm, not lasting, said of a building, a community or a faith) (j:kip/lo) (r:zd:24604/zd:14628/zd:20703) (q:draft)
kipom = (i:1) (t:v) (f:everyday/family) (w:embrace each other/hug) (d:<pom>, embrace, with the prefix <ki>: hold one another in the arms) (b:pom) (r:zd:22658/zd:24075) (q:draft)
kipom = (i:2) (t:v) (f:social/politics) (w:be held/be accepted/adhere to) (d:<pom>, hold fast, with the prefix <ki>: of a view or teaching, be held or accepted; of people, hold to a party or a cause) (b:pom) (r:zd:25275) (q:draft, low confidence)
Kippur = (i:1) (t:name) (f:religion) (w:Yom Kippur) (d:second word of Yom Kippur, the Jewish Day of Atonement) (o:Hebrew) (r:zd:17322) (q:draft)
kipsakna nei = (i:1) (t:v) (f:politics/media) (w:confirm/ratify/approve) (d:<kipsakna>, confirmation, and <nei>, have: give confirmation, said of a body or an official that confirms a report or formally approves a decision or an appointment; what is confirmed stands before it, often as a clause ending in <cih>) (r:zd:15407/zd:11704) (q:draft)
kipuahna = (i:2) (t:n) (f:social/everyday) (w:improvement/correction) (d:the putting right and improving of a person or of conduct, as in <kipuahphatna>, named beside <phatna>; not something that beautifies the body) (s:kipuahphatna) (r:zd:21219) (q:draft, low confidence)
kipuahphat = (i:2) (t:v) (f:social/politics) (w:reform/improve oneself/be put right) (d:form of <kipuahpha> before <ding>, <hun> and <sawm>: correct one's own faults and do better, or, of a church or the police, be reformed; without <mawhna>, sin, it does not mean make amends) (b:kipuahpha) (r:zd:25139/zd:24248/zd:9252) (q:draft)
kipuahphatna = (i:1) (t:n) (f:social/everyday) (w:self-improvement/reform/correction) (d:<kipuahphat> with the noun suffix {-na}: the putting right or improving of oneself or of a community) (b:kipuahphat) (r:zd:11891/zd:19943/zd:24750) (q:draft)
kipuakding = (i:1) (t:v) (f:travel/politics) (w:will be sent/will be taken) (d:<kipuak> and <ding> written as one word: will be sent, taken or delivered to a place) (j:kipuak/ding) (r:zd:15165/zd:21357/zd:13270) (q:draft)
kipuakkhin = (i:1) (t:v) (f:everyday) (w:have been sent/have been taken) (d:<kipuak>, be sent or carried, and <khin>, already, written as one word: have already been sent or taken to a place such as a hospital) (j:kipuak/khin) (r:zd:12717/zd:12613) (q:draft)
kipuakkik = (i:1) (t:v) (f:politics/travel) (w:be sent back/be deported/be returned) (d:passive of <puakkik>, send back: be sent back to where one came from, said of people deported to their country and of patients sent to another hospital) (b:puakkik) (j:ki/puakkik) (r:zd:24286/zd:19397) (q:draft)
kipuakman = (i:1) (t:v) (f:health/travel) (w:be taken in time/be rushed to) (d:<kipuak>, be carried, with <man>, be in time: be brought to a place, mostly a hospital, while still alive) (j:kipuak/man) (r:zd:19365) (q:draft, low confidence)
kipuakpah = (i:1) (t:v) (f:health/everyday) (w:be taken at once/be sent immediately) (d:<kipuak> and <pah> written as one word: be carried or sent somewhere at once, most often of an injured person taken to hospital) (j:kipuak/pah) (r:zd:11878/zd:24276/zd:12649) (q:draft)
kipuakphot = (i:1) (t:v) (f:health/media) (w:be sent first/be taken for now) (d:<kipuak>, be sent or taken, and <phot>, first, written as one word: be taken somewhere first, before anything else is done) (j:kipuak/phot) (r:zd:17200/zd:11773) (q:draft)
kipuaksak = (i:1) (t:v) (f:health/travel) (w:be sent/be taken to) (d:<kipuak>, be carried, with <sak>, cause: be sent or taken somewhere by others, said mostly of the injured and the dead taken to a hospital) (j:kipuak/sak) (r:zd:18911/zd:20721) (q:draft)
kipuaksawn = (i:1) (t:v) (f:health/travel) (w:be sent on/be transferred/be taken on) (d:<kipuak> and <sawn> written as one word: be sent or carried on to a further place, as a patient to a hospital or an accused person to a court) (j:kipuak/sawn) (r:zd:16101/zd:20215) (q:draft)
kipuaksuak = (i:1) (t:v) (f:health/travel) (w:be taken straight to/be rushed to/be sent on) (d:<kipuak> and <suak> written as one word: be carried or sent on directly to a place, in the news mostly of an injured person taken to hospital) (j:kipuak/suak) (r:zd:13188/zd:19863/zd:16895) (q:draft)
kipulaak = (i:1) (t:v) (f:social/religion) (j:kipulak) (r:zd:21845/zd:14927) (q:draft)
kipulakkhia = (i:1) (t:v) (f:media) (w:be announced/be disclosed/be made public) (d:<kipulak>, be made known, with <khia>, out, written as one word: be announced or made public) (j:kipulak/khia) (r:ts:3110/zd:19962) (q:draft)
kipulakna = (i:1) (t:n) (f:social/religion) (w:declaration/confession/disclosure) (d:<kipulak>, make oneself known or be made known, with the noun suffix <na>: a declaring of oneself or of what one has done; also a statement that claims something) (b:kipulak) (r:zd:23539/zd:20168) (q:draft)
kipumkhat = (i:1) (t:v) (f:social/politics) (w:be united/unite/be one) (d:<kipum> and <khat> written as one word: be as one body, be united) (j:kipum/khat) (r:zd:8668/zd:11244/zd:25097) (q:draft)
kipumkhatin = (i:1) (t:adv) (f:social/religion) (w:united as one/with one accord) (d:<kipum>, be united, and <khatin>, into one, written as one word; {lungsim kipumkhatin} is with one heart) (j:kipum/khatin) (r:zd:23005) (q:draft)
kipumkhatna = (i:1) (t:n) (f:social) (w:unity/oneness) (d:<kipumkhat>, be united as one body, with the noun suffix <na>: unity among people) (s:kikhatna) (b:kipumkhat) (r:zd:14765/zd:15652/zd:24199) (q:draft)
kipumpiak = (i:2) (t:v) (f:politics) (w:surrender/give oneself up) (d:of a soldier or a wanted person: hand oneself over to the other side or to the authorities, often with {galvan tawh}, with weapons; not giving oneself in service) (r:ts:4309/ts:5469/ts:10538) (q:draft)
kipumpiakna = (i:1) (t:n) (f:social/religion) (w:dedication/self-giving/sacrifice/devotion) (d:<kipumpiak>, give oneself wholly, with the noun suffix <na>: the giving of one's whole self to a work, a cause or a person) (b:kipumpiak) (r:zd:23791/zd:24230) (q:draft)
kisa = (i:3) (t:v) (f:everyday) (w:be considered/be thought/be found) (d:said after a describing word of what people in general think or feel about a thing: <lamdang kisa> is it is found strange and <hoih kisa> it is thought good; in the other sense a person thinks so of himself) (r:zd:21925) (q:draft)
kisaang = (i:1) (t:v) (f:everyday/social) (j:kisang) (r:ts:479/zd:24014) (q:draft)
kisaiin = (i:1) (t:prep) (f:everyday) (w:concerning/regarding/about) (d:<kisai> and <in> written as one word; <tawh kisaiin> after a noun is concerning, in connection with) (j:kisai/in) (r:zd:23083/zd:9424) (q:draft)
kisailo = (i:1) (t:v) (f:everyday/social) (w:be unrelated/have nothing to do with/not concern) (d:<kisai>, relate to, with <lo>, not, written as one word; {tawh kisailo} is having nothing to do with, regardless of) (j:kisai/lo) (r:zd:14730/zd:24381/zd:25107) (q:draft)
kisaina = (i:1) (t:n) (f:everyday/social) (w:connection/relation/relevance) (d:<kisai>, concern, with the noun suffix <na>: what one thing or person has to do with another; {kisaina omlo} is have nothing to do with) (b:kisai) (r:zd:13228/zd:24249) (q:draft)
kisaina = (i:2) (t:n) (f:body/health) (w:beat/pulse) (d:the beating of the heart: {lungtang kisaina} is the heartbeat) (r:zd:21135) (q:draft, low confidence)
kisaipen = (i:1) (t:phrase) (f:everyday/media) (w:as for what concerns/what relates to) (d:<kisai>, concern, with the topic marker <pen>, written as one word, after <tawh>: as for the matter concerning) (j:kisai/pen) (r:zd:19801) (q:draft)
kisak khak = (i:1) (t:v) (f:everyday/religion) (w:wrongly suppose oneself/mistakenly think oneself) (d:<kisak>, here the form that <kisa>, think oneself, takes before another word, and <khak>, here the like form of the particle <kha>, by mistake or by chance: come to think wrongly that one is or does something; stands after the clause that says what is supposed and before <ding> or <leh>, as a warning) (r:zd:12175/zd:24814) (q:draft)
kisakha = (i:1) (t:v) (f:everyday) (w:happen to think oneself/suppose wrongly) (d:<kisa>, think oneself, with <kha>, happen to, written as one word: come to feel or suppose something about oneself or one's situation, often mistakenly) (j:kisa/kha) (r:zd:16259/zd:12112/zd:20946) (q:draft)
kisakna = (i:2) (t:n) (f:religion/media) (w:singing/being sung) (d:a different word, from <kisa.2>, be sung, with the noun suffix <na>: the singing of a hymn or song and the occasion on which it is sung; beside {hymn} or <la>, not the considering oneself of the other sense) (r:zd:9244/zd:9240) (q:draft, low confidence)
kisakpih = (i:1) (t:v) (f:social/family) (w:sympathise/feel with) (d:<ki> with <sak>, the form of <sa>, feel, and <pih>, together with: share the feeling of someone, said to the bereaved after {ki khasiatpih}, grieve with) (r:zd:11757) (q:draft, low confidence)
kisakpih = (i:2) (t:v) (f:social/media) (w:sing along) (d:<ki> with <sak>, sing, and <pih>, together with: join in the singing of someone) (r:zd:23629) (q:draft, low confidence)
kisalo = (i:1) (t:v) (f:everyday) (w:not consider oneself/not feel) (d:<kisa> consider oneself and <lo> not written as one word after a describing word: not think or feel oneself to be so, as in {khial kisalo}, not think oneself wrong) (j:kisa/lo) (r:zd:12941/zd:12151) (q:draft)
kisam = (i:1) (t:v) (f:everyday) (w:need/lack/be necessary/be needed) (d:be without something that is wanted or required: of a person, need or lack; of a thing, be needed or missing; <ding kisam> is it is necessary to) (s:kul/kiphamawh/tasam) (r:15.6.9) (q:draft)
kisamden = (i:1) (t:v) (f:everyday) (w:be always needed/be constantly necessary) (d:<kisam>, be needed, and <den>, always, written as one word) (j:kisam/den) (r:zd:24059/zd:23025) (q:draft)
kisamding = (i:1) (t:v) (f:everyday) (w:will be needed/will need) (d:<kisam>, be needed, and the future marker <ding> written as one word: will be needed, will take) (j:kisam/ding) (r:zd:17549/zd:11723) (q:draft)
kisamh = (i:1) (t:v) (f:everyday) (j:kisam) (r:zd:16420/zd:19665) (q:draft)
kisamhi = (i:1) (t:v) (f:everyday) (w:be needed/be necessary) (d:<kisam> and <hi> written as one word: it is needed, it is necessary) (j:kisam/hi) (r:zd:20574/zd:20729/zd:23025) (q:draft)
kisamkin = (i:1) (t:v) (f:everyday/social) (w:be urgently needed/be badly needed) (d:<kisam>, be needed, with <kin>, pressing, written as one word: be needed urgently, mostly followed by <mahmah>) (j:kisam/kin) (r:zd:20582/zd:16423) (q:draft)
kisamlai = (i:1) (t:v) (f:everyday) (w:still need/be still needed/remain) (d:<kisam> be needed with <lai>, still, written as one word: still be needed, still be lacking; of time, still remain) (j:kisam/lai) (r:zd:19964/zd:20181) (q:draft)
kisamlo = (i:1) (t:v) (f:everyday) (w:not be needed/be unnecessary) (d:<kisam> and <lo> written as one word: is not needed, is not necessary; {a kisamlo} is what is not needed) (j:kisam/lo) (r:zd:22818/ts:397/zd:23799) (q:draft)
kisamlua = (i:1) (t:v) (f:everyday) (w:need very much/be badly needed/be very necessary) (d:<kisam>, need, with <lua>, too much, written as one word: be greatly needed; with <lo>, not really necessary) (j:kisam/lua) (r:zd:25354/zd:20503) (q:draft)
kisampah = (i:1) (t:v) (f:everyday/media) (w:be called at once/be summoned immediately) (d:<kisam>, be called, and <pah>, at once, written as one word: of the police, the fire service or an ambulance, be called to a place straight away) (j:kisam/pah) (r:zd:16093/zd:19458/zd:15924) (q:draft)
kisamsam = (i:1) (t:v) (f:social) (w:be called one after another/keep being called) (d:<kisam>, be called, with the last syllable doubled, compare <samsam>: people are being called in, one after another, as for an interview) (b:kisam) (r:zd:23317/zd:21550) (q:draft)
kisamta = (i:1) (t:v) (f:everyday) (w:be needed now/be necessary now) (d:<kisam> with <ta>, now, written as one word: has become necessary; after a number, only that much is still lacking) (j:kisam/ta) (r:zd:16788/zd:12641/zd:23361) (q:draft)
kisamte = (i:2) (t:n) (f:everyday) (w:necessities/needs/things needed/those in need) (d:<kisam>, need, with the plural <te>: the things that are needed, as in {van kisamte}, the goods needed, or the people who need something, as in {panpihna a kisamte}, those who need help; not the guests of a feast) (r:zd:24538/zd:10725/zd:11224) (q:draft)
kisang = (i:2) (t:v) (f:social/everyday) (w:be on speaking terms/communicate/answer one another) (d:in {kam kisang}, with <kam>, word, before it: take up one another's words, so speak with each other or be in contact, also by radio; {kam kisang nawn lo} is no longer on speaking terms) (r:zd:21925/zd:15493) (q:draft, low confidence)
kisanglo = (i:1) (t:v) (f:everyday/social) (w:not be accepted/be rejected) (d:<kisang> and <lo> written as one word: is not accepted, said of applicants, applications and things sent in) (j:kisang/lo) (r:zd:15681/zd:24812/zd:18208) (q:draft)
kisangsiam = (i:1) (t:v) (f:social) (w:accept one another/understand one another/be well accepted) (d:the mutual and passive form of <sansiam>, accept with understanding: of people, know how to accept and bear with each other; of a thing, be readily accepted) (r:zd:21783/zd:8422) (q:draft)
kisapleh = (i:1) (t:phrase) (f:everyday) (w:if needed/if necessary) (d:<kisap> and <leh> written as one word, usually as {a kisapleh}: if it is needed) (j:kisap/leh) (r:zd:23822/zd:21155) (q:draft)
kisapnai = (i:1) (t:v) (f:everyday/social) (w:need yet/need so far) (d:<kisap>, need, and <nai>, yet, written as one word; seen only with the negative <kei>, as {na kisapnai kei leh}, if you do not yet need it) (j:kisap/nai) (r:zd:10892) (q:draft, low confidence)
kisapte = (i:1) (t:n) (f:everyday/social) (w:needs/necessities/things needed) (d:<kisap>, need, with the plural <te>: the things that someone needs or lacks) (b:kisap) (r:zd:25130/zd:9124/zd:10951) (q:draft)
kisapzia = (i:1) (t:n) (f:everyday) (w:need/how much something is needed) (d:<kisap>, need, and <zia>, way, written as one word: the way or the degree in which something is needed) (j:kisap/zia) (r:zd:24375/zd:24030) (q:draft)
kisasa = (i:1) (t:v) (f:religion/media) (w:be sung/be still sung) (d:<ki> with <sasa>, keep singing, written as one word: of a song or hymn, be sung again and again, be in use) (j:ki/sasa) (r:zd:9239/zd:9211/zd:9261) (q:draft)
kisasa = (i:2) (t:v) (f:everyday) (w:keep thinking oneself/feel oneself to be) (d:<kisa>, consider oneself, with its last syllable said twice: go on thinking or feeling oneself to be so, as in {mawh kisasa}, feeling guilty) (r:zd:9451) (q:draft, low confidence)
kisat = (i:2) (t:v) (f:social) (w:be founded/be established/be set up) (d:passive of <sat.2>, found: of a village, a town or an organisation, be founded; stands after <khua> or the name of the place, often with the year) (r:zd:19273/zd:20513/ts:617) (q:draft)
kisatsuah = (i:1) (t:v) (f:social/politics) (w:be roused/be stirred up) (d:of a people or group, be roused to spirit and action, stir one another up) (r:zd:17011/zd:10726) (q:draft, low confidence)
kisawh = (i:2) (t:v) (f:social/health) (w:come into contact with/mix with/associate with) (d:of people, after <tawh> and often before <kha>: come into contact or keep company with someone, or get mixed up with something bad, where the other sense is of an ingredient mixed into food) (r:zd:24413/zd:20028/zd:23551) (q:draft)
kisawlna = (i:1) (t:n) (f:everyday/social) (w:being sent/being ordered/order) (d:the fact of being sent or of being told to do something, from <kisawl>) (b:kisawl) (r:zd:19174/zd:24432) (q:draft)
kisehthei = (i:1) (t:v) (f:everyday/work) (w:can be appointed/can be assigned/can be divided) (d:<kiseh>, be appointed or set, and <thei>, able, written as one word: can be appointed, set or divided into parts) (j:kiseh/thei) (r:ts:261/zd:23156) (q:draft)
kisel = (i:2) (t:v) (f:everyday) (w:be hidden/hide/be secret) (d:another spelling of <kiseel.1>, passive of <seel>, hide: be hidden or hide oneself, as in {a kisel thusim}, a hidden secret, and not the arguing of the first sense) (s:kiseel) (r:zd:20568/zd:25129/zd:17106) (q:draft)
kiselsim = (i:1) (t:v) (f:everyday/social) (w:be hidden/be kept secret/be concealed) (d:<selsim>, secret, with the prefix <ki>: be hidden or kept secret, or hide oneself) (j:ki/selsim) (r:zd:24231/zd:25139) (q:draft)
kisemding = (i:1) (t:v) (f:work/politics) (w:will be done/will be carried out) (d:<kisem> and <ding> written as one word: it will be done, it is to be carried out) (j:kisem/ding) (r:zd:19805/zd:12108) (q:draft)
kisemkhawm = (i:1) (t:v) (f:work/social) (w:work together/cooperate) (d:<semkhawm>, work together, with the prefix {ki-}: work with one another, cooperate) (b:semkhawm) (r:ts:2669/zd:20767/zd:21720) (q:draft)
kisemsem = (i:1) (t:v) (f:work) (w:keep being done/be carried on/keep working) (d:<kisem>, be done, with the verb <sem> said twice to show that the work goes on and on: the work is carried on steadily, we keep at it) (j:kisem/sem) (r:zd:10743/zd:20403) (q:draft)
kisemthei = (i:1) (t:v) (f:work/everyday) (w:can be done/be possible to do) (d:<kisem>, be done, and <thei>, can, written as one word: it can be done; with <lo>, nothing can be done) (j:kisem/thei) (r:zd:15958/zd:14910) (q:draft)
kisi = (i:2) (t:v) (f:everyday/health) (w:die/be killed) (d:<si>, die, with <ki>, said without naming who dies: people die, there are deaths, usually after a number or {mi tampi}; it is not the meeting of opponents of the other sense) (r:zd:11072/zd:23754/zd:19676) (q:draft)
kisiam = (i:1) (t:v) (f:everyday/education) (w:be skilled at/be good at/know how to/master) (d:<siam>, skilled, with the prefix {ki-}: said of people in general, be good at something or know how to do it; {kisiam lo} is not be good at, {a kisiam thei} is what can be mastered) (b:siam) (r:zd:22639/zd:21826/zd:21340) (q:draft)
kisiat = (i:2) (t:v) (f:social) (w:fall out/be at odds/harm one another) (d:spoil the relation with one another, the reciprocal <ki> with <siat>: said of people or groups, after <tawh> or {ei leh ei}, each other, and paired with <kitot>, quarrel; differs from a thing being ruined) (r:zd:20751/zd:24064/zd:23717) (q:draft)
kisiatlawh = (i:1) (t:v) (f:everyday/social) (w:be ruined/be damaged/suffer harm) (d:<ki> and <siatlawh> written as one word: be ruined or damaged as the outcome of something) (j:ki/siatlawh) (r:zd:20945/zd:18307) (q:draft)
kisiatna = (i:2) (t:n) (f:social) (w:discord/falling-out/strife) (d:a break in the good relations between people in a church, a family or a group, often beside <kikhenna>, division; not the ruin of a thing) (r:zd:26310/zd:25734/zd:11715) (q:draft)
kisiau = (i:1) (t:v) (f:work/politics) (w:be applied for/apply/register) (d:<siau>, apply, with the prefix <ki>: an application is made, people apply or register, for a job, a benefit, a visa or a service; {kisiau thei} is one can apply) (b:siau) (r:zd:25202/zd:14554/zd:25925) (q:draft)
kisih = (i:1) (t:v) (f:everyday/health) (w:die) (d:<sih>, die, with the prefix <ki>: people die, one dies; {kisih lawh} is die as a result of something, and {kisih bawl} is to take one's own life) (b:sih) (r:zd:24231/zd:17177) (q:draft)
kisihbawl = (i:1) (t:v) (f:health/media) (w:kill oneself/commit suicide/take one's own life) (d:the prefix {ki-}, oneself, with <sih>, die, and <bawl>, make: bring about one's own death; often after {amah leh amah}, himself) (r:zd:26947/zd:25227) (q:draft)
kisihlawh = (i:1) (t:v) (f:everyday/health) (w:die as a result/lose one's life) (d:<sihlawh>, die because of something, with the prefix <ki>: people die as a result, it can cost lives; often paired with <kisuplawh>, suffer loss) (b:sihlawh) (j:ki/sihlawh) (r:zd:22970/zd:25015) (q:draft)
kisik = (i:1) (t:v) (f:everyday/social) (w:regret/repent) (d:feel sorry for something done and turn from it; {mawhna kisik} is repent of sin)
kisikna = (i:2) (t:n) (f:everyday) (w:regret) (d:being sorry afterwards for a choice, a purchase or something left undone, with no thought of sin; {kisikna om lo ding hi} is there will be no regret) (r:zd:15324/zd:22691/zd:22686) (q:draft)
kisil = (i:1) (t:v) (f:everyday/body) (w:bathe/wash oneself) (d:<sil>, wash, with the reflexive prefix <ki>: wash oneself, bathe, or wash the hands before eating) (s:kipumsil) (b:sil) (q:draft)
kisilbuk = (i:1) (t:n) (f:home) (w:bathroom/shower room) (d:<kisil>, bathe, with <buk>, hut or small room: the room where one washes) (r:zd:10929/zd:12444) (q:draft)
kisilh = (i:1) (t:v) (f:home/everyday) (w:wear/put on/be worn) (d:<silh>, wear, with the prefix <ki>: put a garment on oneself, or of a garment, be worn) (b:silh) (r:zd:25191/zd:23322) (q:draft)
kisimthei = (i:1) (t:v) (f:education/everyday) (w:can be read/be readable/can be counted) (d:<kisim>, be read or be counted, with <thei>, able, written as one word) (j:kisim/thei) (r:zd:10973/ts:8682/zd:11738) (q:draft)
kisinkholhna = (i:1) (t:n) (f:work/education) (w:rehearsal/drill/practice) (d:<kisin>, practise, and <kholhna>, doing beforehand, written as one word: practice held in advance of an event, a rehearsal or an emergency drill) (j:kisin/kholhna) (r:zd:19213/zd:16782) (q:draft)
kisinsakna = (i:1) (t:n) (f:education) (w:training/instruction) (d:<kisinsak>, train, with the noun suffix <na>: the training or teaching that people are given) (s:sinsakna) (b:kisinsak) (r:zd:9426) (q:draft)
kisinthei = (i:1) (t:v) (f:education) (w:can be learned/be able to learn) (d:<kisin>, learn or practise, and <thei>, able, written as one word) (j:kisin/thei) (r:zd:21876/zd:21543) (q:draft)
kisittelna = (i:1) (t:n) (f:religion/education) (w:self-examination/testing) (d:<kisittel> with the noun ending {-na}: the examining of oneself, or a time of being tested) (b:kisittel) (r:zd:23394) (q:draft)
kisongsawlawi = (i:1) (t:v) (f:everyday) (w:be out of joint/be thrown into disorder/be mismatched) (d:expressive word, used beside <kilawi>, for things that no longer fit together or stand in their right place) (r:zd:23975/zd:24296) (q:draft, low confidence)
kisot = (i:1) (t:v) (f:time/everyday) (w:be extended/be prolonged) (d:<sot>, extend, with the prefix <ki>: be made longer in time, go on further; {ma kisot} is to move forward) (b:sot) (r:zd:22620/zd:21925) (q:draft)
kisotto = (i:1) (t:v) (f:time) (w:be postponed/be extended/be put off) (d:<sotto>, extend, with the prefix {ki-}: of a set time or an event, be moved to a later time or made longer) (s:kisot) (b:sotto) (r:zd:19583/zd:14899/zd:22803) (q:draft)
kisuahkhia = (i:1) (t:v) (f:media) (w:be published/be issued/be released/appear) (d:<ki> with <suahkhia>, bring out: be brought out to the public, said of news, a statement or a video; {Newspaper ah kisuahkhia} is appear in a newspaper) (b:suahkhia) (r:zd:21327/ts:3429) (q:draft)
kisuahkhia = (i:2) (t:v) (f:home) (w:be taken off) (d:<ki> with <suahkhia>, take off: be taken off, said of shoes and clothes) (b:suahkhia) (r:zd:15358/zd:17055) (q:draft)
kisuahliang = (i:1) (t:v) (f:everyday) (w:be split right into/even break into) (d:<kisuah>, be divided into, and <liang>, even, written as one word after a number of parts: break so badly as to be in that many pieces) (j:kisuah/liang) (r:zd:15372/zd:19860) (q:draft)
kisuak = (i:2) (t:v) (f:everyday) (w:become/turn into/end up as) (d:{kisuak} without <sak> after it: people in general, one or we, become something; what one becomes stands directly before it, as in {mi thak kisuak}, one becomes a new person) (r:zd:23394/zd:24712/zd:22040) (q:draft)
kisuaksak = (i:2) (t:v) (f:media) (w:be published/be posted/be released) (d:of news, writing or pictures, be brought out in a paper, a book or on a website; the passive of <suaksak> in the sense of bringing out) (r:zd:14703/zd:11410/zd:25918) (q:draft)
kisuakta = (i:1) (t:v) (f:social/religion) (w:be free/be set free/be released) (d:<suakta>, be free or escape, with the prefix <ki>, said of people in general: one is free, people are freed; {kisuakta sak} is be released) (b:suakta) (r:zd:21246/zd:26565) (q:draft)
kisuakthei = (i:1) (t:v) (f:health/everyday) (w:can become/can turn into) (d:<kisuak>, become, and <thei>, can, written as one word: one can become so, it can come about) (j:kisuak/thei) (r:zd:14879) (q:draft, low confidence)
kisuamlum = (i:1) (t:v) (f:politics/social) (w:be assassinated/be murdered/be attacked and killed) (d:passive of <suamlum> with the prefix <ki>; also kill one another) (s:kithatlum) (b:suamlum) (r:zd:11715/zd:11557) (q:draft)
kisuamlupna = (i:1) (t:n) (f:politics/media) (w:assassination/killing/murder) (d:the killing of a person by a planned attack; noun in {-na} from {kisuamlup}, be attacked and killed, as <suamlum> is attack and kill) (r:zd:11345/zd:15498) (q:draft)
kisuamna = (i:1) (t:n) (f:politics/social) (w:attack/assault) (d:<kisuam>, be attacked, with the noun suffix <na>: an attack on people, an assault) (b:kisuam) (r:zd:24001/zd:24532) (q:draft)
kisuan = (i:4) (t:v) (f:everyday) (w:be laid on/be put on/rest on) (d:after <tungah> or <ah>, be placed as a load on the shoulders or on a person, of a burden, of authority and of anger that is let out on someone) (r:zd:23670/zd:25054) (q:draft, low confidence)
kisuang = (i:3) (t:v) (f:media) (w:be posted/be published/be displayed) (d:said of writing, a notice or a picture, after words such as <lai> or {warning}: be put up or printed where people can see it) (r:zd:23729/zd:21498/zd:11337) (q:draft)
kisuhsak = (i:1) (t:v) (f:social) (w:be robbed of/have snatched) (d:passive of <suhsak> with the prefix <ki>: have something taken from one by force) (b:suhsak) (r:zd:14997/zd:9124) (q:draft)
kisum = (i:1) (t:v) (f:everyday/work) (w:be lost/be wasted/suffer loss) (d:of people, time, money or good things: be lost, go to waste; passive with the prefix <ki>, related to <sup>, lose, and <supna>, loss) (r:zd:22464/zd:21268/zd:12912) (q:draft)
kisun = (i:3) (t:v) (f:health) (w:be vaccinated/be injected/get an injection) (d:the prefix <ki> on the verb for pierce or inject: receive an injection, above all a vaccine, after <zatui> or <vaccine> or a count with <vei>, times; unrelated to the meaning like or similar) (r:zd:19606/zd:25280/zd:24489) (q:draft)
kisunte = (i:1) (t:n) (f:health) (w:those injected/the vaccinated/injected ones) (d:{ki sun}, be pierced or injected, with the plural <te>: the people who have been given an injection, or the things injected; not <kisun>, like) (r:zd:25202/zd:24476) (q:draft, low confidence)
kisuplawh = (i:1) (t:v) (f:everyday/work) (w:be lost/suffer loss/lose out) (d:<ki> with <suplawh>, lose: something is lost, or people suffer a loss; {kisuplawh thei} is can be lost, can lose out) (b:suplawh) (r:zd:21941/zd:11248/zd:23603) (q:draft)
kisut = (i:3) (t:v) (f:health) (w:be injected/be vaccinated/get an injection) (d:have a medicine or vaccine put into the body with a needle, said after <zatui> or <vaccine>: {kidalna zatui kisut} is get vaccinated; not the passive of <sut>, plunder) (r:zd:23556/zd:24476/zd:25215) (q:draft)
kisutna = (i:1) (t:n) (f:health) (w:injection/vaccination) (d:<ki> with <sut>, here inject, and the noun ending {-na}: the giving of an injection; {zatui kisutna} is an injection of medicine) (r:zd:24476/zd:25132) (q:draft)
kita = (i:1) (t:v) (f:everyday) (w:fit in/have room/be contained) (d:<ta>, here fit or hold, with the prefix <ki>: there is room for a thing or a person in a place; {kita zo lo} is cannot fit in, have no place) (r:zd:26411/zd:23367) (q:draft, low confidence)
kitaan = (i:1) (t:v) (f:everyday/religion) (w:be lost/lose) (d:<taan>, lose, with the prefix <ki>: of a good thing, be lost to someone; {gupna kitaan thei} is salvation can be lost) (b:taan) (r:zd:9512/zd:25571/zd:9429) (q:draft)
kitahna = (i:1) (t:n) (f:social/work) (w:gambling/betting) (d:the staking of money on a game or a result, mostly as {sum kitahna}; one article gives the English gambling for it) (r:zd:21337/zd:20092) (q:draft)
kitai = (i:2) (t:v) (f:everyday/politics) (w:flee/run away) (d:<tai>, run, with the prefix {ki-}: people run away, mostly from fighting or danger; often followed by <khia>, out, or <kawikawi>, here and there) (r:ts:5848/ts:9564/ts:6164) (q:draft)
kitaih = (i:1) (t:v) (f:travel/media) (w:collide/crash/clash) (d:of vehicles or ships: run into each other; also of names or people, clash with one another, as <min kitaih>, a dispute over a name) (s:kiphu/kiphukha) (r:zd:14626/zd:17141/zd:23037) (q:draft)
kitaih = (i:2) (t:v) (f:media) (w:be robbed) (d:after <damiah>, robber: be held up and robbed, of a person, a shop or a bank) (r:zd:15913/zd:12063) (q:draft, low confidence)
kitaihkha = (i:1) (t:v) (f:travel) (w:collide/crash into each other) (d:of vehicles: run into each other, <ki> with <taihkha>, hit against) (r:zd:15078/zd:17743) (q:draft)
kitaihna = (i:1) (t:n) (f:travel/media) (w:collision/crash/clash) (d:<kitaih>, collide, with the noun suffix <na>: a collision of vehicles or ships; {min kitaihna} is a clash of names) (b:kitaih) (r:zd:24388/zd:23048) (q:draft)
kitaihna = (i:2) (t:n) (f:media) (w:robbery/hold-up) (d:after <damiah>, robber: a robbery or hold-up) (b:kitaih) (r:zd:15178) (q:draft, low confidence)
kitaikhia = (i:1) (t:v) (f:politics/travel) (w:flee/run away/escape) (d:<taikhia>, flee, with the prefix <ki>: said of people in general fleeing from a place) (b:taikhia) (j:ki/taikhia) (r:ts:5448/ts:2228/ts:7764) (q:draft)
kitaisak = (i:1) (t:v) (f:travel) (w:be run/be operated/be put in service) (d:passive of <taisak>, make run: said of buses, trains and boats that are run on a route or at a certain time or speed) (b:taisak) (r:zd:16515/zd:20104/zd:15781) (q:draft)
kitalsik = (i:1) (t:v) (f:social/politics) (w:clash/collide/run into) (d:come up against each other, of people, countries or things that meet with force; used after <tawh>) (r:zd:19603/zd:25063) (q:draft)
kitam = (i:2) (t:v) (f:everyday) (w:be many/be numerous/be common) (d:the prefix <ki> with <tam>, many: there are many of them, said of people or things in general, often before <mahmah>, <zaw> and <semsem>; not the breaking of sense 1) (r:zd:22584/zd:14894/zd:26444) (q:draft)
kitam = (i:3) (t:v) (f:travel) (w:burst/blow out) (d:of the tyre of a car or an aeroplane, burst, in {apei kitam}, its tyre burst; {bomb kitam} is said of a bomb that goes off) (r:zd:15031/zd:14521) (q:draft, low confidence)
kitamzat = (i:1) (t:v) (f:everyday) (w:be much used/be commonly used) (d:the passive <ki> with <tamzat>, use much: be used a lot or by many people) (j:ki/tamzat) (r:zd:21886/zd:22707) (q:draft)
kitamzaw = (i:1) (t:v) (f:everyday) (w:be in the majority/be more numerous) (d:<ki> and <tamzaw>, more, written as one word at the end of a clause: there are more people who are, do or think so; most do) (j:ki/tamzaw) (r:zd:26411/zd:12763/zd:19552) (q:draft)
kitan = (i:2) (t:v) (f:religion) (w:be lost/be cut off/be severed) (d:of a bond or a state that someone holds, be cut off and come to an end; said of salvation in the question {gupna kitan thei}, can salvation be lost) (r:zd:24191) (q:draft, low confidence)
kitan = (i:3) (t:v) (f:everyday/social) (w:break out/escape/break loose) (d:with <pan> before and <khia> after, break free from the place where one is held, such as a lockup or a police station) (r:zd:11706/zd:22336) (q:draft)
kitanauna = (i:1) (t:n) (f:social/politics) (w:relationship/relations/kinship) (d:<tanau>, relative, with <ki> and the noun ending <na>: being related to one another; in news, the relations between countries) (s:kizopna) (b:tanau) (r:zd:10833/zd:10828) (q:draft)
kitangsam = (i:2) (t:v) (f:everyday/social) (w:be needed/be necessary/be required) (d:of a thing, be needed or necessary, where the subject is what is lacking and not the one who lacks it; {a kitangsam thu} is a thing that is needed, and {kitangsam pha mahmah} is be very much needed) (s:kisam) (r:zd:24673/zd:11891/zd:23167) (q:draft)
kitangsap = (i:1) (t:n) (f:everyday/social) (w:need/lack/necessity) (d:form of <kitangsam>, be in need, used as a noun: what a person or a people needs or lacks; {kitangsap bulpi} is a basic need) (s:kitangsapna) (b:kitangsam) (r:zd:8668/ts:3125/zd:20281) (q:draft)
kitansak = (i:2) (t:v) (f:work/politics) (w:ransom/free for payment) (d:with {sum tawh} or {sum pia-in}, with or by paying money: have a captive or a seized person set free for a payment, said of kidnappers who hold people for ransom) (r:zd:16559/zd:11600/ts:7881) (q:draft)
kitatkha = (i:1) (t:v) (f:everyday/travel/health) (w:hit against/be struck/bump into) (d:the prefix <ki> with a verb of striking and <kha>, happen to, written as one word: knock hard against something by accident, as the head or body in a crash) (r:zd:14865/zd:14709) (q:draft)
kitawi = (i:3) (t:v) (f:everyday/travel) (w:get ready/prepare oneself) (d:after a purpose with <dingin>, make oneself ready to go or to do something, as in {zin dingin ka kitawi}, I get ready to travel; in this use it stands where <kithawi> stands) (s:kithawi) (r:zd:14824/zd:16387) (q:draft, low confidence)
kitawm = (i:1) (t:v) (f:everyday) (w:be few/be scarce/be rare) (d:<ki> with <tawm>, few: there are few of them, said of people or things that are hard to find; {kitawm mahmah} is there are very few) (r:zd:19327/zd:23990/zd:23910) (q:draft)
kitawn = (i:1) (t:v) (f:travel/everyday) (w:be taken/be followed/be travelled) (d:<tawn>, go by way of, with the prefix <ki>: of a road or a way, be taken or followed; {lampi kitawn} is the route that is taken) (b:tawn) (r:zd:24646/zd:10912) (q:draft)
kitawnggawp = (i:1) (t:v) (f:social) (w:brawl/fight violently/quarrel fiercely) (d:<kitawng> quarrel or fight with <gawp>, which shows that the action is done violently, written as one word) (j:kitawng/gawp) (r:zd:18067/zd:14965/zd:15981) (q:draft)
kitawp = (i:1) (t:v) (f:work/politics) (w:resign/quit/step down/give up) (d:<ki> with <tawp>, stop: leave a post or office of one's own accord, or give up what one was doing) (b:tawp) (r:zd:11145) (q:draft)
kitawp = (i:2) (t:v) (f:everyday) (w:kiss one another/touch one another) (d:kiss or meet each other; in the one sentence found it is said of the two charges of electricity coming together in lightning) (r:zd:23896) (q:draft, low confidence)
kitawsawn = (i:1) (t:v) (f:social) (w:urge one another/encourage one another/be spurred on) (d:<tawsawn>, urge, with the prefix <ki>: urge one another on, or be driven on by something) (b:tawsawn) (r:ts:7051/zd:22228) (q:draft)
Kitchen = (i:1) (t:n) (f:work/food) (w:kitchen) (d:the kitchen of a restaurant as a place of work, mostly in job advertisements) (s:anbuk) (o:English) (r:zd:17217/zd:17978) (q:draft)
kiteelcing = (i:1) (t:v) (f:politics) (w:be elected/be chosen) (d:<teelcing>, elect, with the passive prefix <ki>: be chosen by vote for an office; before a noun, the elected, as in {kiteelcing President}) (b:teelcing) (r:zd:20145) (q:draft)
kiteelna = (i:1) (t:n) (f:politics) (w:election/vote) (d:<kiteel>, be chosen, with the noun suffix {-na}: the choosing of leaders or members by vote, an election) (b:kiteel) (r:zd:22921/zd:24019/zd:16660) (q:draft)
kiteelni = (i:1) (t:n) (f:politics/time) (w:election day/polling day) (d:<kiteel>, be elected, and <ni>, day, written as one word: the day of an election) (j:kiteel/ni) (r:zd:19520/zd:19430) (q:draft)
kiteelpi = (i:1) (t:n) (f:politics) (w:general election/election) (d:<kiteel> with the augmentative {-pi}: the great choosing, a general election; <gambup kiteelpi> is a nationwide election) (b:kiteel) (r:zd:23011/zd:21978) (q:draft)
kiteelpina = (i:1) (t:n) (f:politics) (w:general election/election) (d:<kiteelpi> with the noun suffix {-na}: the holding of a general election; {Kawlgambup kiteelpina} is the nationwide election of Myanmar) (s:kiteelpi) (b:kiteelpi) (r:zd:24376/zd:24696) (q:draft)
kiteenna = (i:1) (t:n) (f:family/social) (w:marriage/wedding/wedlock) (b:kiteen) (r:zd:12630/zd:22408) (q:draft)
kitehkak = (i:1) (t:v) (f:social/everyday) (w:compare oneself/be compared) (d:<tehkak>, compare, with the prefix <ki>: compare oneself with another, or be compared; the one compared with takes <tawh>, with) (b:tehkak) (r:zd:23487/zd:22046/zd:25169) (q:draft)
kiteikhia = (i:1) (t:v) (f:education/media) (w:be translated) (d:<kitei>, be transferred, with <khia>, out: of a book or writing, be put into another language) (j:kitei/khia) (r:zd:9257/zd:9236) (q:draft)
kitel = (i:3) (t:v) (f:politics/social) (w:be elected/be chosen) (d:another spelling of <kiteel>, be chosen by vote, said of leaders and representatives; {palai kitel} is representatives are elected and {kitel kik} is be elected again) (s:kiteel) (r:zd:24714/zd:25392) (q:draft)
kitelcian = (i:1) (t:v) (f:everyday/education) (w:be clear/be clearly known/understand clearly) (d:<kitel> and <cian> written as one word: be known or understood for certain; {kitelcian nailo} is not yet clear; of people, understand one another well) (j:kitel/cian) (r:zd:24343/zd:22037/zd:20941) (q:draft)
kitelcing = (i:1) (t:v) (f:politics) (w:be elected/win an election) (d:<telcing>, be elected, with the prefix <ki>: be chosen in an election) (b:telcing) (r:zd:24677/zd:10951) (q:draft)
kitelkhia = (i:1) (t:v) (f:politics/everyday) (j:kiteelkhia) (r:zd:23422) (q:draft)
kitelkhial = (i:1) (t:v) (f:everyday/social) (w:be misunderstood/misunderstand each other) (d:<tel>, understand, and <khial>, wrongly, with the prefix {ki-}: be understood wrongly, or misunderstand one another) (r:zd:22459/zd:20798) (q:draft)
kitelkhialh = (i:1) (t:v) (f:social) (w:misunderstand each other/be misunderstood) (d:<telkhialh>, misunderstand, with the prefix <ki>: misunderstand one another; also used as a noun, misunderstanding between people) (b:telkhialh) (r:zd:22709/zd:15274) (q:draft)
kitelkhialhna = (i:1) (t:n) (f:social) (w:misunderstanding) (d:<ki>, one another, <tel>, understand, and <khialhna>, error: people understanding one another wrongly) (r:zd:20647/ts:11942/ts:2680) (q:draft)
kitelna = (i:1) (t:n) (f:politics) (j:kiteelna) (r:zd:25488/zd:24743/zd:25203) (q:draft)
kitelpi = (i:1) (t:n) (f:politics) (w:general election/election) (d:a nationwide election in which the people choose their government and representatives) (r:zd:24343/zd:24370/zd:24354) (q:draft)
kitelpina = (i:1) (t:n) (f:politics) (w:election/voting) (d:<kitelpi>, election, with the noun ending <na>: the election, the choosing) (b:kitelpi) (r:ts:12037) (q:draft)
kitelsiam = (i:1) (t:v) (f:social) (w:understand one another/have mutual understanding) (d:<tel>, understand, with the reciprocal <ki> and <siam>, skilled: understand each other well; {kitelsiam lohna} is misunderstanding) (r:zd:22709/zd:23148/zd:17468) (q:draft)
kitelsiamna = (i:1) (t:n) (f:social) (w:mutual understanding/understanding) (d:<ki>, each other, with <telsiam>, understand well, and the noun suffix <na>: understanding of one another) (s:kitheihsiamna) (r:zd:21166/zd:23075/zd:16461) (q:draft)
kitelzaw = (i:1) (t:adv) (f:everyday/media) (w:more clearly/in more detail) (d:<kitel>, clear, and the comparative <zaw>, written as one word; {a kitelzaw} is what is clearer, further details) (j:kitel/zaw) (r:ts:4831/zd:23083/zd:15499) (q:draft)
kiteng = (i:2) (t:v) (f:everyday) (w:live/dwell/settle) (d:<teng>, dwell, with the prefix <ki>: people live or settle in a place, said in general or of groups living side by side, with no thought of marriage; {kiteng khawm} is live together in one place) (r:ts:6531/zd:23896) (q:draft)
kitengte = (i:1) (t:n) (f:family) (w:those who marry/married people) (d:<kiteng>, marry, with the plural <te>: the people who marry, those married to someone; <tawh> marks the kind of partner) (b:kiteng) (r:zd:23044/zd:22329) (q:draft)
kitenna = (i:1) (t:n) (f:social/family) (w:marriage/intermarriage) (d:<kiten> marry with the noun suffix <na>; {kitenna bawl} and {kitenna nei} are to marry) (s:kipina/tenpihna) (b:kiten) (q:draft)
kithahat = (i:1) (t:v) (f:social/politics) (w:be strong together/strengthen one another) (d:<thahat>, strong, with the prefix <ki>: be strong as a group, strengthen one another) (b:thahat) (j:ki/thahat) (r:zd:23572/ts:2680) (q:draft)
kithahzawh = (i:1) (t:v) (f:media) (w:after being killed) (d:<kithah>, be killed, and <zawh>, here finish, written as one word: after the killing of someone, after someone was killed) (j:kithah/zawh) (r:zd:11736) (q:draft, low confidence)
kithanem = (i:1) (t:v) (f:everyday/social) (w:be weak/be lacking/lose heart) (d:<thanem>, weak, with the prefix <ki>: of people in general, be weak in something or lose strength and courage; {kithanem sak} is discourage) (b:thanem) (r:zd:26310/ts:3125) (q:draft)
kithat = (i:2) (t:v) (f:health/social) (w:kill oneself/commit suicide) (d:reflexive use of {kithat}, not the passive: after {amah leh amah}, himself and himself, a person takes his own life) (r:zd:23539/zd:16997) (q:draft)
kithatna = (i:1) (t:n) (f:politics/social) (w:killing/murder) (d:<kithat>, be killed, with the noun suffix <na>: the killing of a person; {kithatna vai} is a murder case) (s:kithahna/mithahna) (b:kithat) (r:zd:16245/zd:15681/zd:19906) (q:draft)
kithawipah = (i:1) (t:v) (f:everyday) (w:get ready at once) (d:<kithawi>, get ready, and <pah>, at once, written as one word: set about doing something straight away) (j:kithawi/pah) (r:zd:20046/zd:12732) (q:draft)
kithehkhia = (i:1) (t:v) (f:nature/everyday) (w:be thrown out/spew out/burst out) (d:<kitheh>, be splashed, with <khia>, out: be flung or sprayed outward, said of ash from a volcano and of flames) (j:kitheh/khia) (r:zd:20023/zd:19480) (q:draft)
kithehthaang = (i:1) (t:v) (f:social/everyday) (w:be scattered/be dispersed/spread out) (d:be scattered or dispersed over many places, said of a people living far apart) (r:zd:8375/zd:25105) (q:draft)
kithehzak = (i:2) (t:v) (f:media/it) (w:spread/go viral/circulate) (d:of a video, a photo or news: spread widely among people on social media, often with <tungah> before it and the English word {viral} beside it, where the first sense is things lying scattered over the ground) (r:zd:19962/zd:18154/zd:14568) (q:draft)
kithehzakpah = (i:1) (t:v) (f:media/it) (w:spread at once/go viral) (d:<kithehzak>, be spread about, and <pah>, at once, written as one word: of a video or a piece of news, spread at once over social media) (j:kithehzak/pah) (r:zd:20193/zd:21294) (q:draft)
kitheician = (i:1) (t:v) (f:everyday/media) (w:be known for certain/be clearly known) (d:<kithei> and <cian> written as one word: be known clearly; in news mostly as {kitheician nailo}, not yet known for certain) (j:kithei/cian) (r:zd:13161/zd:14521/ts:9341) (q:draft)
kitheicianlo = (i:1) (t:v) (f:everyday/media) (w:be not clearly known/be unclear) (d:<kithei>, be known, <cian>, clearly, and <lo>, not, written as one word: it is not known for certain) (j:kithei/cian/lo) (r:zd:19973/zd:20302/zd:13348) (q:draft)
kitheiding = (i:1) (t:v) (f:everyday) (w:will be known/will be found out) (d:<kithei> and <ding> written as one word: it will be known, it will become clear) (j:kithei/ding) (r:zd:18145/zd:12876) (q:draft)
kitheih = (i:2) (t:v) (f:social) (w:know each other/be acquainted) (d:<thei>, know, with <ki> in its sense of each other: two people know each other, with <tawh> for the other person; {kitheih zawh} is the time since they came to know each other) (r:zd:25351) (q:draft, low confidence)
kitheihloh = (i:1) (t:v) (f:everyday) (w:not be known/be unknown) (d:<kitheih>, be known, and the negative <loh> written as one word: not known; {kitheihloh bawl} is act as if one did not know) (j:kitheih/loh) (r:zd:25712/zd:16871) (q:draft)
kitheihpih = (i:1) (t:v) (f:social) (w:know one another/be acquainted/be aware of) (d:<theihpih>, know together with someone, with the prefix <ki>: know each other, or share the knowledge of a matter; {kua kitheihpih lo} is nobody knew of it) (b:theihpih) (r:zd:16297/zd:12403/zd:17468) (q:draft)
kitheihsiamna = (i:1) (t:n) (f:social) (w:mutual understanding/understanding one another) (d:<theihsiamna>, understanding, with <ki>, one another: people understanding each other and making allowance for each other) (r:zd:21166/zd:21624) (q:draft)
kitheilo = (i:1) (t:v) (f:everyday) (w:not known/unknown) (d:<kithei> and <lo> written as one word: it is not known; after a question with <cih> it means it is not known whether or what) (j:kithei/lo) (r:zd:25243/ts:3307) (q:draft)
kitheinailo = (i:1) (t:v) (f:media/everyday) (w:not yet known/still unknown) (d:<kithei>, be known, and <nailo>, not yet, written as one word) (j:kithei/nailo) (r:zd:22618/zd:16815) (q:draft)
kitheinuam = (i:1) (t:v) (f:everyday/media) (w:want to know) (d:<kithei>, be known, and <nuam>, want, written as one word: people want to know, it is something everyone wishes to know) (j:kithei/nuam) (r:zd:23394/zd:18028) (q:draft)
kitheipah = (i:1) (t:v) (f:everyday) (w:be known at once/be recognized immediately) (d:<kithei>, be known, and <pah>, at once, written as one word) (b:kithei) (j:kithei/pah) (r:zd:12996/zd:21366) (q:draft)
kitheipan = (i:1) (t:v) (f:everyday/media) (w:only then be known/come to be known/be found out) (d:<ki> and <theipan> written as one word: it was known or found out only at that point) (j:ki/theipan) (r:zd:17779/zd:17241) (q:draft)
kitheita = (i:1) (t:v) (f:media/everyday) (w:be known now/become known) (d:<kithei>, be known, with <ta> marking a change: it is now known; common at the end of headlines) (j:kithei/ta) (r:zd:17017/zd:24019/zd:24414) (q:draft)
kitheithei = (i:1) (t:v) (f:everyday) (w:can be known/can be seen/be evident) (d:<kithei>, be known, and <thei>, able, written as one word: it can be known or told from something, marked with <pan> or <panin>) (j:kithei/thei) (r:ts:3992/zd:17563) (q:draft)
kitheizo = (i:1) (t:v) (f:everyday/media) (w:be known/can be known) (d:<kithei>, be known, and <zo>, be able, written as one word: can be known or found out; in news mostly negated, {kitheizo nailo}, is not yet known) (j:kithei/zo) (r:ts:2549/ts:5232/zd:20787) (q:draft)
kithoh = (i:1) (t:v) (f:work) (w:be withdrawn/be collected) (d:<thoh>, withdraw or collect, with the prefix <ki>: be drawn out or collected, said of money, cards and goods that are issued) (b:thoh) (j:ki/thoh) (r:zd:24421/zd:25052/zd:21409) (q:draft)
kithoih = (i:1) (t:v) (f:religion) (w:sacrifice/make an offering/propitiate) (d:make an animal sacrifice to the spirits, as in the old religion before Christianity; {dawi kithoih} is sacrifice to the spirits; the noun is <kithoihna>) (r:zd:9435/ts:3503/zd:21175) (q:draft)
kithuahding = (i:1) (t:v) (f:everyday/it) (w:will be installed/will be fitted) (d:<kithuah>, be fitted or attached, with <ding>, will, written as one word: will be installed, said of cameras, scanners and other equipment) (j:kithuah/ding) (r:zd:15592/zd:11658) (q:draft)
kithuahin = (i:1) (t:adv) (f:social) (w:together with/in company with/along with) (d:<kithuah> with <in>: keeping company with, together with; it follows <tawh>, and of things it says that one comes along with another) (j:kithuah/in) (r:zd:9448/zd:24087/zd:19960) (q:draft)
kithuahkhawm = (i:1) (t:v) (f:social) (w:be together/keep company/go together/cooperate) (d:<kithuah>, keep company or be joined, with <khawm>, together, written as one word; <tawh> marks the companion) (j:kithuah/khawm) (r:zd:14720/zd:20952/zd:9213) (q:draft)
kithuahna = (i:1) (t:n) (f:social) (w:companionship/fellowship/association/partnership) (d:<kithuah>, keep company with, with the noun suffix <na>: being together or working together with someone, the time spent in company with a person; <tawh> marks the companion) (b:kithuah) (r:zd:25147/zd:23812/zd:25218) (q:draft)
kithuaklah = (i:1) (t:v) (f:everyday/health) (w:be hard to bear/suffer badly) (d:<ki> and <thuaklah> written as one word: one suffers much from it, it is very hard to bear; mostly as {kithuaklah mahmah}) (j:ki/thuaklah) (r:zd:21246/zd:12538) (q:draft)
kithudon = (i:1) (t:v) (f:social) (w:be heeded/pay attention to one another) (d:<thudon>, heed, with the prefix <ki>: be heeded, be given attention) (b:thudon) (j:ki/thudon) (r:ts:1278) (q:draft, low confidence)
kithuhual = (i:1) (t:v) (f:social/family) (w:be in harmony/be united/agree) (d:be of one mind and live or work together in harmony; {kithuhual takin} is harmoniously) (s:kithutuak) (r:zd:21013/zd:25461) (q:draft)
kithukhualsak = (i:1) (t:v) (f:social) (w:defer to one another/be considerate of one another) (d:<ki>, one another, <thukhual>, have regard, and <sak> written as one word: show regard and give way to each other out of courtesy, often said of doing so too much) (j:ki/thukhual/sak) (r:zd:24035/zd:17264) (q:draft, low confidence)
kithum = (i:1) (t:v) (f:social/religion) (w:request/plead/be requested) (d:<thum>, beg or ask, with the prefix <ki>: make an earnest request, or be requested, as in notices; {hong kithum hi} is you are kindly requested; of a wrong, ask for pardon) (b:thum) (r:zd:15566/zd:24304/zd:22228) (q:draft)
kithupi = (i:2) (t:adj) (f:social) (w:important/valued/esteemed) (d:held to be important by people or by one another, with the prefix <ki> in its passive or mutual meaning, before <ngaihsut>, <sim> or <bawl>; not said of what one thinks of oneself) (r:ts:3375/zd:25891/zd:20572) (q:draft)
kithupisak = (i:1) (t:v) (f:social) (w:be valued highly/be regarded as important/be given importance) (d:<thupisak>, regard as important, with the prefix <ki>: be held important, be given great weight by people) (b:thupisak) (r:zd:23554/zd:20979/zd:9239) (q:draft)
kithutuahna = (i:1) (t:n) (f:social) (w:agreement/unity/harmony) (d:<kithutuah>, agree, with the noun suffix <na>: being of one mind with one another) (b:kithutuah) (r:zd:10973/zd:23803/zd:25751) (q:draft)
kithutuakna = (i:1) (t:n) (f:social/politics) (w:agreement/unity/harmony) (d:<kithutuak>, be of one mind, with the noun suffix <na>: being in agreement with one another) (b:kithutuak) (r:zd:24978/zd:9426) (q:draft)
kithuza = (i:1) (t:v) (f:social/media) (w:be in contact/communicate/confer) (d:hear word from one another: get in touch, keep in contact or talk a matter over with someone, who is marked by <tawh>) (r:zd:21596/zd:24286/zd:16895) (q:draft)
kithuzak = (i:1) (t:v) (f:social/media) (w:be in contact/communicate/confer) (d:form of <kithuza> used before <nading>, <ding> and other dependent endings) (b:kithuza) (r:zd:20620/zd:15471) (q:draft)
kithuzakna = (i:1) (t:n) (f:social/it) (w:communication/contact/exchange of news) (d:the hearing of news from one another, <thuzak> with the prefix <ki> and the noun suffix <na>; often paired with <kizopna>) (r:zd:25203/zd:22046) (q:draft)
kito = (i:3) (t:v) (f:social) (w:contend/challenge each other) (d:after <tawh>, with: two sides challenge each other or contend in a contest or quarrel; not the passive of digging) (r:zd:24411) (q:draft, low confidence)
kitolh = (i:1) (t:v) (f:everyday/nature) (w:slide/slip) (d:slide or slip along a surface, as a ladder that slips away or people sliding on snow) (r:zd:19826/zd:19814) (q:draft, low confidence)
kitom = (i:3) (t:v) (f:social) (w:make a scene/rage/throw a tantrum/be rowdy) (d:behave wildly and noisily out of anger, drink or wanting one's way, as a child crying for a thing or a crowd in protest; {zukham kitom} is to be drunk and disorderly) (r:zd:19931/zd:22775/zd:12754) (q:draft)
kitomgawp = (i:1) (t:v) (f:everyday) (w:struggle violently/thrash about/make a scene) (d:<kitom>, struggle, and <gawp>, violently, written as one word: struggle hard to get free, or in anger behave wildly) (j:kitom/gawp) (r:zd:12618/zd:20764) (q:draft)
kiton = (i:1) (t:v) (f:everyday/social) (w:go together with/accompany/keep pace with) (d:<ton>, accompany, with the prefix <ki>: go along together; {tawh kiton in} is together with, at the same time as) (b:ton) (r:ts:3168/zd:23204) (q:draft)
kitonin = (i:1) (t:adv) (f:everyday) (w:along with/together with/at the same time) (d:<ton>, go together with, with the prefix <ki> and the linking ending <in>: after <tawh>, in step with or at the same time as something) (r:zd:9434/zd:24375) (q:draft)
kitot = (i:1) (t:v) (f:social) (w:quarrel/dispute/strive/argue) (d:quarrel with one another; also used as a noun, a quarrel or strife) (s:kitawng/kinial/kisel/kiseel) (a:kilem/kithutuak) (q:draft)
kitotna = (i:1) (t:n) (f:social) (w:strife/quarrel/conflict/dispute) (d:<kitot> quarrel with the noun suffix <na>: quarrelling and strife between people; {kitotna piangsak} is stir up strife) (s:kinialna/kiselna/kiseelna) (a:kilemna) (q:draft)
kitoto = (i:1) (t:v) (f:social) (w:quarrel/argue/bicker) (d:argue back and forth with one another, said together with <kikoko>, shout at one another) (s:kitot) (r:zd:15930/zd:20537) (q:draft, low confidence)
kitottot = (i:1) (t:v) (f:social) (w:keep quarrelling/quarrel on and on) (d:<kitot>, quarrel, with its last part repeated: go on quarrelling with one another) (b:kitot) (r:zd:12989/zd:25295) (q:draft)
kitu = (i:1) (t:v) (f:everyday/social) (w:sit/be seated/sit down together) (d:<tu>, sit, with the prefix <ki>: people sit, sit down together, also of a sitting or a sit-in) (b:tu) (r:zd:22396/zd:11425) (q:draft)
kitu = (i:2) (t:v) (f:nature/social) (w:fight) (d:of cocks, fight each other; {ak kitu sak} is to set cocks fighting; inferred from one sentence and one dictionary entry) (r:zd:22713) (q:draft, low confidence)
kituah = (i:3) (t:v) (f:everyday/travel) (w:move/relocate/transfer) (d:move to live or work in another place, the place marked by <ah> or <pan>; not a meeting of persons or of parts as in the other senses) (r:zd:9262/ts:2724/zd:23733) (q:draft)
kituahkhawm = (i:1) (t:v) (f:social) (w:meet together/come together/gather) (d:<kituah>, meet, with <khawm>, together, written as one word; {maitang kituahkhawm} is meet face to face) (j:kituah/khawm) (r:zd:24064/zd:19820) (q:draft)
kituahsak = (i:1) (t:v) (f:politics/work) (w:be moved/be transferred/be relocated) (d:be made to change place: of people, be moved to another place of stay or posting) (r:zd:12589/zd:11058) (q:draft, low confidence)
kituak = (i:1) (t:v) (f:social) (w:match/agree/be consistent) (d:of statements, thoughts or minds: agree with one another, be the same; {thu kituak lo} is disagree) (s:kithutuak)
kituak = (i:3) (t:v) (f:everyday) (w:meet/come across/encounter) (d:<ki> with <tuak>, meet: come upon a person, a thing or a hardship, not agree with or suit it; what is met stands before {kituak}, with or without <tawh>) (r:zd:23897/zd:21421) (q:draft, low confidence)
kituakkha = (i:1) (t:v) (f:everyday) (w:happen to meet/run into/coincide with) (d:<tuakkha>, come upon by chance, with the prefix <ki>: meet one another by chance, or of two events fall at the same time; <tawh> marks what is met) (b:tuakkha) (r:zd:15039/zd:15577/zd:16425) (q:draft)
kituaklian = (i:1) (t:v) (f:time/everyday) (w:coincide/happen at the same time/fit exactly) (d:<kituak>, match, and an ending that means exactly: fall at exactly the same time as something else or fit it exactly; <tawh> marks the other thing) (b:kituak) (r:zd:11750/zd:11666/zd:21616) (q:draft)
kituaklo = (i:1) (t:v) (f:everyday/social) (w:not match/not agree/be unfitting) (d:<kituak> and <lo> written as one word: not agree with, not be in keeping with, not be proper) (j:kituak/lo) (r:zd:21220/zd:11995/zd:19327) (q:draft)
kituam = (i:2) (t:v) (f:social/health) (w:be kept apart/be set apart/be isolated) (d:<tuam.2>, separate, with <ki>: be put apart from the others, as a sick person or a traveller kept alone in {kituam koih} and {kituam kep}; {kituam bawlna} is treating people differently; nothing is wrapped) (r:zd:24461/zd:23843/zd:16752) (q:draft)
kituang = (i:1) (t:v) (f:travel) (w:ride/travel by/be carried) (d:<tuang>, ride, with the prefix <ki>: people ride or travel in a vehicle, said without naming who) (b:tuang) (r:zd:11011/zd:16038/zd:24234) (q:draft)
kituangthei = (i:1) (t:v) (f:travel) (w:can be ridden/one can ride) (d:<kituang>, ride or travel by, and <thei>, can, written as one word: people can travel by the vehicle named) (j:kituang/thei) (r:zd:16334/zd:11253) (q:draft)
kituantual = (i:1) (t:v) (f:social/politics) (w:lag behind/be left behind/be backward) (d:<tuantual> with the prefix {ki-}: be behind others in progress, said of a people, a land or its affairs) (b:tuantual) (r:zd:24731/zd:17156) (q:draft)
kituat = (i:1) (t:v) (f:everyday/work) (w:be reckoned/be counted/be estimated/be considered) (d:<ki> with <tuat>: be worked out or estimated, or be regarded as something; {kituat zo lo} is beyond reckoning) (b:tuat) (r:zd:15501/zd:23857/zd:23733) (q:draft)
kituh = (i:3) (t:v) (f:social) (w:be buried/be interred) (d:of a dead body: be laid in the grave, an extended use of {kituh}, be planted; the place is named with <han> or <hanmual> followed by <ah>) (r:zd:22459/zd:11224) (q:draft)
kitukalh = (i:1) (t:v) (f:social) (w:conflict/contradict/clash/be at odds) (d:of words, opinions or people, to cross each other and not agree) (r:ts:261/zd:12276) (q:draft)
kitulh = (i:1) (t:v) (f:food/social) (w:be served to drink/be given to drink/be fed) (d:passive <ki> with <tulh>, give to drink: of drink at a feast, be served to the guests; of food, be put into the mouth of a child) (b:tulh) (r:zd:16640/zd:25393) (q:draft)
kitulmawh = (i:1) (t:v) (f:social/politics) (w:interfere/meddle/intrude) (d:push into a matter that is the business of others; used after <va>, go and) (r:zd:21221) (q:draft, low confidence)
kitum = (i:2) (t:v) (f:social) (w:fight/box/come to blows) (d:hit one another with the fists, fight or box; no instrument is named, and words such as <kitawng>, punch one another, or {kisultuak} stand beside it) (r:zd:25253/zd:19151/zd:15775) (q:draft)
kitum = (i:3) (t:v) (f:work) (w:be stamped/be sealed) (d:of a seal or stamp, be pressed on a document or a door; the word <seal> stands before {kitum}) (r:ts:6285/zd:18920) (q:draft, low confidence)
kitun = (i:3) (t:v) (f:everyday/travel) (w:be brought to/be taken to/reach) (d:<ki> with <tun>, arrive: a person or thing is brought to a place or reaches it, after a place such as <zato>, hospital, or after <kiang> and <tung>; nothing is wrapped) (r:zd:12561/zd:24592/zd:9125) (q:draft)
kitusak = (i:1) (t:v) (f:everyday/travel) (w:be seated/be made to land) (d:<ki> and <tusak>, make sit, written as one word: be given a seat, seat oneself; of an aircraft, be made to land) (j:ki/tusak) (r:zd:23037/zd:17554) (q:draft, low confidence)
kiu = (i:3) (t:n) (f:body) (w:elbow) (d:the joint of the arm, named together with other joints such as the knee and the shoulder when aches of the body are listed; not the corner of a thing) (r:zd:21323) (q:draft, low confidence)
kiuk = (i:1) (t:v) (f:politics) (w:be governed/govern oneself/be ruled) (d:<uk>, rule, with the prefix <ki>: be ruled, or rule oneself; {kiuk zia} is the system by which a country is governed, and {pumpi kiuk} is self-control) (b:uk) (r:zd:8668/zd:15874/zd:14791) (q:draft)
kiukhat = (i:1) (t:n) (f:everyday) (w:one corner/one side/one aspect) (d:<kiu> corner and <khat> one written as one word: one corner or side of something; {kiukhat pan} is from one side, from one point of view) (j:kiu/khat) (r:zd:26588/zd:20699) (q:draft)
kiukna = (i:1) (t:n) (f:politics) (w:governance/system of government/rule) (d:the way a country or people is governed; {gam kiukna} is the government of a country and {federal kiukna} a federal system) (b:ukna) (r:zd:15661/zd:16254/zd:19947) (q:draft)
kiukzia = (i:1) (t:n) (f:politics) (w:system of government/form of government/way of governing) (d:<kiuk> and <zia> written as one word: the way a country is governed, a system of government such as democracy or federalism) (j:kiuk/zia) (r:zd:24336/zd:11244) (q:draft)
kium = (i:1) (t:v) (f:everyday) (w:be believed/be thought) (d:<um>, believe, with the prefix <ki>, written as one word: be believed; {kium mawh} is it is feared or suspected) (j:ki/um) (r:zd:25641/zd:24609) (q:draft)
kium = (i:2) (t:v) (f:everyday) (w:be surrounded/be fenced in) (d:be enclosed all round, as a place by a fence) (r:zd:17387) (q:draft, low confidence)
kiummawh = (i:1) (t:v) (f:everyday/media) (w:be suspected/be thought likely/be presumed) (d:<ummawh>, suspect, with the prefix <ki>, written as one word: it is suspected or thought likely, of what is not known for certain; usually after {ding in}) (j:ki/ummawh) (r:zd:24369/zd:25461) (q:draft)
kiva = (i:1) (t:v) (f:work/education) (w:be skilled/be proficient/be versed in) (d:know a kind of work or subject well from practice, placed after the subject, often with <lam>; {kiva mahmah} is expert and {kiva lo} is not good at) (r:zd:23591/zd:22341/zd:21829) (q:draft)
kivaakna = (i:1) (t:n) (f:work/everyday) (w:livelihood/sustenance/living) (d:<kivaak> with the noun ending {-na}: what one lives on, the way one makes a living) (b:kivaak) (r:zd:19845) (q:draft)
kivaan = (i:1) (t:v) (f:social/work) (j:kivan) (r:zd:19900/zd:14910) (q:draft, low confidence)
kivaihawm = (i:1) (t:v) (f:social/work) (w:be arranged/be managed/be organized) (d:passive of <vaihawm>, manage or arrange: of a matter or a need, be seen to and settled; {kivaihawm sak} is have it arranged for someone) (b:vaihawm) (r:zd:25286/zd:25293) (q:draft)
kivaihawmsak = (i:1) (t:v) (f:social/work) (w:be arranged for/be provided/be assigned) (d:passive of <vaihawmsak> with the prefix <ki>: be arranged or provided for someone) (b:vaihawmsak) (r:zd:24563/ts:2256) (q:draft)
kivaipuak = (i:1) (t:v) (f:social/work) (w:be organised/share responsibilities) (d:<vaipuak>, responsibility, with the prefix <ki>: have duties assigned among the members, be organised and run; {kivaipuak zia} is the way a group is organised) (b:vaipuak) (j:ki/vaipuak) (r:zd:24605/ts:879) (q:draft, low confidence)
kivaipuakna = (i:1) (t:n) (f:politics) (w:administration/governance) (d:the running of the affairs of a country, people or organisation; said together with {ki-ukna}, rule) (r:zd:24733) (q:draft, low confidence)
kivaipuakzia = (i:1) (t:n) (f:politics/social) (w:administrative structure/system of administration/organisation) (d:the way in which a country, an organisation or a church is run and its offices are arranged; from <kivaipuak>, carry out the affairs, with <zia>, manner) (r:zd:15407/zd:10983/zd:25891) (q:draft)
kivak = (i:3) (t:v) (f:food/social) (w:be fed/be served food) (d:passive of <vaak>, feed: people are given a meal by a host, a school or a relief group, usually as {an kivak}, food is served; in {kivak}, live on, a person provides for himself) (r:zd:16660/zd:15681) (q:draft)
kivak = (i:4) (t:v) (f:travel/social) (w:go around/go about) (d:<ki> with <vak>, here walk about: of a group, go round from place to place, mostly as {kivak kawikawi}; nothing to do with food or light) (r:zd:17489/zd:10743) (q:draft, low confidence)
kivakna = (i:2) (t:n) (f:education/work) (w:talent/gift/aptitude) (d:a natural ability or gift of a person, often paired with <siamna>, skill, and glossed in the articles with the English word talent; not the feeding of the other sense) (s:talent) (r:zd:11378/zd:23725/zd:23148) (q:draft)
kivalak = (i:1) (t:v) (f:everyday) (w:be similar/resemble/be close to) (d:be much alike or close to each other, said with <tawh>) (s:kibang) (r:ts:3164/zd:11587) (q:draft)
kivan = (i:1) (t:v) (f:social/work) (w:be handled/be arranged/be taken care of) (d:of a matter or case: be looked after and arranged by someone on behalf of another; {kivan pih} is help with the handling of it; compare <vaan>) (r:zd:21550/zd:23494/zd:20033) (q:draft, low confidence)
kivanpih = (i:1) (t:v) (f:social/work) (w:be helped with/be handled for) (d:<kivan>, be handled, and <pih>, for someone, written as one word: a matter or case is handled on behalf of someone, help is given with it) (j:kivan/pih) (r:zd:11119/zd:22897) (q:draft)
kivansak = (i:1) (t:v) (f:social/work) (w:be arranged for/be handled for) (d:<kivan>, be handled, with <sak>, here for someone: a matter or case is taken care of on a person's behalf) (j:kivan/sak) (r:zd:23171/zd:23035) (q:draft, low confidence)
kivate = (i:1) (t:n) (f:work/education) (w:those skilled/experts) (d:<kiva> with the plural <te>: people who are versed or engaged in a field) (b:kiva) (r:zd:25891/zd:23025) (q:draft, low confidence)
kivawh = (i:3) (t:v) (f:everyday/social) (w:be named/be called/be given a name) (d:after <min>, name: a name is put on a person, place, group or event; {cih min kivawh} is be given the name of) (r:zd:12819/ts:11162) (q:draft)
kiveh = (i:1) (t:v) (f:social) (w:be visited) (d:passive of <veh>, visit, with the prefix <ki>: someone in prison, in a detention camp or in hospital is visited; {kiveh thei} is can be visited) (b:veh) (r:zd:21550/zd:21841) (q:draft)
kivei = (i:3) (t:v) (f:health) (w:be suffered/be afflicted with) (d:passive of <vei>, be sick with or be burdened by: of an illness or a trouble, be suffered by people, not a thing moving to and fro) (r:zd:22228/zd:17309) (q:draft)
kivei = (i:4) (t:v) (f:time/travel) (w:wander/go round and round) (d:of people, go round without arriving, or stay in the same state while years pass, with a length of time such as {kum 40 sung}) (r:zd:24036) (q:draft, low confidence)
kivua = (i:1) (t:v) (f:social/family) (w:beat one another/fight/come to blows) (d:<vua>, beat, with the prefix <ki>: hit one another, or with {nang leh nang} beat oneself) (b:vua) (r:zd:25025/zd:25056) (q:draft)
kivuiding = (i:1) (t:v) (f:social/religion) (w:will be buried/to be buried) (d:<kivui>, be buried, and <ding>, will, written as one word: of a dead person or the body, will be buried in the place named) (j:kivui/ding) (r:zd:15503/zd:12208) (q:draft)
kivung = (i:1) (t:v) (f:nature) (w:pool/collect/lie in pools) (d:of water, blood or another liquid: gather and stand on the ground or a floor, as in {tui kivung}, water lies in pools, there is standing flood water) (r:zd:14650/zd:19088/zd:15257) (q:draft)
kiza = (i:2) (t:v) (f:media) (w:be reported/be said/be heard of) (d:of news rather than of a sound: be heard of, be reported; it closes a news sentence after <cih> or {cih thu}, and {cih kiza hi} is it is reported that) (r:ts:1277/ts:2189/ts:4734) (q:draft)
kizah = (i:1) (t:v) (f:social) (w:be respected/be honoured) (d:be held in respect, often as {kizah tak}; the same as <kizahtak>) (s:kizahtak) (r:zd:24176/zd:9138) (q:draft, low confidence)
kizahpih = (i:1) (t:v) (f:social) (w:mock one another/look down on one another) (d:<zahpih>, mock, with the prefix <ki>: mock or despise one another, and with {ei leh ei} look down on oneself) (b:zahpih) (r:zd:25063/zd:21166/zd:25923) (q:draft)
kizahtaak = (i:1) (t:v) (f:social) (j:kizahtak) (r:zd:23653/zd:25923) (q:draft)
kizahtak = (i:2) (t:v) (f:social) (w:respect one another/respect each other) (d:<zahtak>, respect, with <ki> meaning each other and not the passive: people show respect to one another, mostly after {khat le khat}, one another) (b:zahtak) (r:zd:24682/zd:25340/zd:21759) (q:draft)
kizahtaksiamna = (i:1) (t:n) (f:social) (w:mutual respect) (d:<kizahtak> with <siam>, know how to, and the noun ending {-na}: knowing how to respect one another) (b:kizahtak) (r:zd:23647/zd:10726) (q:draft)
kizaih = (i:1) (t:v) (f:media/it) (w:be photographed/be filmed/be recorded/take a photo) (d:the prefix <ki> with <zaih>, take a picture: a photo, video or X-ray is taken, or people take a picture of themselves, as in {Selfie kizaih}) (b:zaih) (r:zd:18234/zd:16148/zd:14601) (q:draft)
kizaihding = (i:1) (t:v) (f:media/it) (w:take a photo/be filmed/be recorded) (d:<kizaih>, be photographed or recorded on film, and the future marker <ding> written as one word: to take a photograph or selfie, to be filmed) (j:kizaih/ding) (r:zd:14795/zd:21406) (q:draft)
kizaihkha = (i:1) (t:v) (f:media/it) (w:be caught on camera/be filmed/be recorded) (d:of an event: be recorded on video or photographed as it happens, usually by chance; from <zaih>, film or photograph, with the prefix {ki-} and <kha>, happen to) (r:zd:12982/zd:14616/zd:12732) (q:draft)
kizaihkhawm = (i:1) (t:v) (f:media/social) (w:take a photo together/be photographed together) (d:<kizaih>, have a picture taken, with <khawm>, together, written as one word: people take a photo or selfie together) (j:kizaih/khawm) (r:zd:17899/zd:19536) (q:draft)
kizaihna = (i:1) (t:n) (f:media/it) (w:photographing/filming/scan) (d:the taking of a picture or recording of someone by camera or machine, as a selfie, a video or a medical scan) (r:zd:11967/zd:14601) (q:draft)
kizaihpah = (i:1) (t:v) (f:media/it) (w:be photographed at once/be filmed at once) (d:<kizaih>, be photographed or filmed, and <pah>, at once, written as one word) (j:kizaih/pah) (r:zd:15579/zd:13326) (q:draft)
kizaihpih = (i:1) (t:v) (f:media/everyday) (w:have a photo taken with/take a photo together with) (d:<kizaih>, be photographed, with <pih>, together with, written as one word: have a picture taken together with someone or something) (j:kizaih/pih) (r:zd:11954/zd:10738) (q:draft)
kizaihsak = (i:1) (t:v) (f:media/health) (w:film/photograph/have scanned) (d:<kizaih>, be photographed or filmed, with <sak>: take a video or photo of someone, or have an X-ray taken) (j:kizaih/sak) (r:zd:15437/zd:13142) (q:draft)
kizaihsawm = (i:1) (t:v) (f:media/it) (w:try to take a photo/be about to take a picture) (d:<kizaih> and <sawm>, intend, written as one word: set out to take a picture of oneself or of one another) (j:kizaih/sawm) (r:zd:17659/zd:11967) (q:draft)
kizaihsim = (i:1) (t:v) (f:media) (w:be filmed secretly/be secretly recorded) (d:<kizaih>, be filmed, with <sim>, which after a verb here means secretly: a video or photo is taken without the person knowing) (j:kizaih/sim) (r:zd:18102/zd:17003) (q:draft)
kizakbeh = (i:1) (t:v) (f:media) (w:be further reported/be heard in addition) (d:<kizak>, be heard, with <beh>, here in addition: it is further reported, closing a sentence that adds one more piece of news) (j:kizak/beh) (r:zd:15840/zd:19752/zd:17983) (q:draft)
kizakha = (i:1) (t:v) (f:media/everyday) (w:be heard of/be reported/come to be heard) (d:<zakha>, happen to hear, with the passive prefix <ki>: come to people's ears, be heard of; mostly with <nailo>, not yet, or <ngeilo>, never: nothing of the kind has been reported) (j:ki/zakha) (r:zd:19546/zd:16720/zd:17129) (q:draft)
kizakhin = (i:1) (t:v) (f:media/everyday) (w:have been heard/have been reported) (d:<kiza> and <khin> written as one word: it has already been heard or reported) (j:kiza/khin) (r:zd:21409/zd:23994) (q:draft)
kizakik = (i:1) (t:v) (f:media) (w:be heard again/be reported further) (d:<kiza>, be heard, and <kik>, again, written as one word: news is heard again, a further report comes) (j:kiza/kik) (r:zd:16784/zd:16834) (q:draft)
kizakna = (i:1) (t:n) (f:media/social) (w:news/report/communication) (d:what is heard of a matter; {thu kizakna} is news, or the passing on of news) (b:kizak) (r:zd:19834/zd:24306/zd:17994) (q:draft)
kizaknawh = (i:1) (t:v) (f:media/everyday) (w:be heard often/be often reported) (d:<kizak>, be heard, with <nawh>, here often: of news or events, be heard of again and again, usually with <mahmah>) (j:kizak/nawh) (r:zd:22864/zd:18307) (q:draft)
kizalo = (i:1) (t:v) (f:media/everyday) (w:not be heard/not be reported) (d:<kiza>, be heard, and <lo>, not, written as one word: nothing is heard or known of it, there is no report) (j:kiza/lo) (r:ts:1919/zd:15529/zd:17917) (q:draft)
kizancip = (i:1) (t:v) (f:home/politics) (w:collapse/be crushed/be flattened) (d:<zancip>, be crushed, with the passive prefix <ki>: of a building, be brought down flat by fire, bombing or an earthquake) (b:zancip) (r:ts:6741/ts:10275) (q:draft, low confidence)
kizangding = (i:1) (t:v) (f:everyday/work) (w:will be used/is to be used) (d:<kizang>, be used, and the future particle <ding> written as one word: will be used) (j:kizang/ding) (r:zd:12311/zd:17822/zd:19311) (q:draft)
kizangh = (i:1) (t:v) (f:everyday) (j:kizang) (r:ts:617/zd:14730/zd:24022) (q:draft)
kizangkhin = (i:1) (t:v) (f:everyday) (w:be already in use/have been used) (d:<kizang>, be used, with <khin>, already: is already in use) (j:kizang/khin) (r:zd:11965/zd:11844) (q:draft)
kizangkik = (i:1) (t:v) (f:everyday/travel) (w:be used again/be back in use) (d:<kizang>, be used, and <kik>, again, written as one word: be used again, be in service again after a stop) (j:kizang/kik) (r:zd:10931/zd:18054/zd:16515) (q:draft)
kizanglai = (i:1) (t:v) (f:everyday) (w:be still in use/still be used) (d:<kizang>, be used, and <lai>, still, written as one word: is still used, still in use) (j:kizang/lai) (r:zd:15560) (q:draft)
kizanglo = (i:1) (t:v) (f:everyday) (w:not be used/be unused) (d:<kizang>, be used, and <lo>, not, written as one word: it is not used) (j:kizang/lo) (r:zd:16511/zd:14581) (q:draft)
kizangte = (i:1) (t:n) (f:everyday) (w:those in use/things used) (d:<kizang>, be used, and the plural <te> written as one word: the ones that are used) (j:kizang/te) (r:zd:22136/zd:17133) (q:draft)
kizangthei = (i:1) (t:v) (f:everyday) (w:can be used/be usable/be useful) (d:<kizang> and <thei> written as one word: can be used; {a kizangthei mi} is a useful person) (j:kizang/thei) (r:zd:20682/zd:19898/zd:25452) (q:draft)
kizangtheilo = (i:1) (t:v) (f:everyday) (w:cannot be used/be unusable) (d:<kizangthei> and <lo> written as one word: cannot be used, be out of use) (j:kizangthei/lo) (r:zd:19176/zd:17416/zd:11506) (q:draft)
kizangzaw = (i:1) (t:v) (f:everyday) (w:be used more/be more common) (d:<kizang>, be used, and <zaw>, more, written as one word: be used more, be used rather; the thing compared takes <sangin>) (j:kizang/zaw) (r:zd:11639/zd:21175) (q:draft)
kizaphot = (i:1) (t:v) (f:media) (w:be heard so far/be reported for now) (d:<kiza>, be heard, and <phot>, for the time being, written as one word: this much is heard for now, said at the end of a first news report) (j:kiza/phot) (r:zd:15629/zd:12097/zd:13324) (q:draft)
kizasakpah = (i:1) (t:v) (f:everyday/media) (w:be informed at once/be notified immediately/be called at once) (d:<kizasak> and <pah> written as one word: be told or called straight away, said mostly of police and firefighters) (j:kizasak/pah) (r:zd:14873/zd:17017) (q:draft)
kizasawn = (i:1) (t:v) (f:media) (w:be reported/be heard) (d:<kiza>, be heard, with <sawn>, on to others: news is passed on and heard from the source named; closes a news report) (j:kiza/sawn) (r:zd:16608/zd:12873/zd:12190) (q:draft)
kizathei = (i:1) (t:v) (f:media/everyday) (w:be heard of/can be heard) (d:<kiza>, be heard, and <thei>, can, written as one word: one can hear of it; in news {kizathei zelzel hi} is one hears of it again and again) (j:kiza/thei) (r:zd:14575/zd:19868/zd:16946) (q:draft)
kizattheihna = (i:1) (t:n) (f:work/everyday) (w:usefulness/use/usability) (d:the verb prefix <ki> with <zattheihna>, ability to use: the ways in which something can be used, how far a thing or a person is of use) (r:zd:21239/zd:23382) (q:draft)
kizawi = (i:1) (t:v) (f:everyday/education) (w:be in line with/correspond/go together with) (d:used with <tawn> as {kizawi tawn}, after <tawh>: go side by side with something, be in accordance with it) (r:zd:23554/zd:24289) (q:draft, low confidence)
kizawitawn = (i:1) (t:v) (f:everyday/social) (w:correspond/be related/be in keeping with) (d:be connected or in line with something, which is marked by <tawh>; {tawh kizawitawn in} is in connection with, in keeping with) (r:zd:15290/zd:19139) (q:draft)
kizawl = (i:1) (t:v) (f:social) (w:be bound as friends/pair up/be betrothed) (d:of two people, be bound to each other as close friends or as a couple; {kizawl sak} is bind two people so) (r:zd:19779/ts:3369) (q:draft, low confidence)
kizeek = (i:1) (t:v) (f:work) (w:be spent/be used/be managed) (d:<zeek> with the prefix <ki>: of money or time, be spent, used or managed) (b:zeek) (r:zd:10983/zd:15527) (q:draft)
kizelgawp = (i:1) (t:v) (f:media/everyday) (w:spread widely/spread all over) (d:<kizel>, spread, and <gawp>, completely, written as one word: of a video or news, spread everywhere; of a fire, spread through the whole place) (j:kizel/gawp) (r:zd:19394/zd:12915) (q:draft)
kizelhna = (i:1) (t:n) (f:everyday/health) (w:spread/spreading/extent) (d:noun of <kizelh>: the spreading of an illness, of news or of a rule over an area, and how far it has spread) (b:kizelh) (r:zd:23932/zd:12279) (q:draft)
kizep = (i:2) (t:v) (f:everyday) (w:be whipped/be beaten/be struck) (d:passive of <zep> in its meaning strike with a cane or whip: be beaten, as in {ciangduai tawh kizep}, be beaten with a cane; not the meaning dress up) (r:zd:17848) (q:draft, low confidence)
kizin = (i:1) (t:v) (f:travel) (w:travel) (d:<zin>, travel, with the prefix <ki>, written as one word: people travel, one travels; {khual kizin thei} is one can travel) (j:ki/zin) (r:zd:22758/zd:24022) (q:draft)
kizol = (i:1) (t:v) (f:social) (w:be urged/be persuaded/persuade one another) (d:<zol>, persuade, with the prefix <ki>: people are urged or coaxed to do something, or urge one another) (b:zol) (r:zd:10742/zd:24381) (q:draft)
kizomding = (i:1) (t:v) (f:social) (w:to join/to be connected) (d:<kizom>, be joined, and <ding> written as one word, after <tawh>: to join or stay in touch with someone) (j:kizom/ding) (r:zd:17383) (q:draft)
kizomsuak = (i:2) (t:v) (f:everyday/travel) (w:join on to/connect through/run on into) (d:with <tawh>, be joined to the next thing without a gap: of a road that leads straight through, a part of a building joined to another, or a holiday that runs on into the weekend, not a thing lasting in time) (r:zd:17402/zd:14949) (q:draft)
kizomthei = (i:1) (t:v) (f:everyday/social) (w:can be connected/can connect) (d:<kizom> and <thei> written as one word, usually after <tawh>: can be joined or linked with something, can be in touch with someone; also may have to do with) (j:kizom/thei) (r:zd:21991/ts:2349/zd:26565) (q:draft)
kizomtoto = (i:1) (t:v) (f:everyday) (w:continue on/keep going on) (d:<kizom>, continue, and <toto>, onward, written as one word: go on and on without a break) (j:kizom/toto) (r:ts:9489/zd:21586) (q:draft)
kizomzom = (i:1) (t:v) (f:everyday/time) (w:keep going on/continue on and on/follow one after another) (d:<kizom>, continue, with the last part doubled: go on and on without a break, or happen again and again) (b:kizom) (r:ts:9489/ts:7044) (q:draft)
kizon = (i:1) (t:v) (f:everyday/work) (w:be sought/be looked for) (d:form of <kizong> used before another word such as <sak>: {nasep kizon sak} is have work looked for on behalf of someone) (b:kizong) (r:zd:23388/zd:23538) (q:draft)
kizongsang = (i:1) (t:v) (f:everyday/health) (w:become a habit/get used to/become accustomed) (d:<zongsang>, be accustomed, with the prefix <ki>: one gets used to a thing by doing it again and again, it becomes a habit) (b:zongsang) (r:zd:20963/zd:24089/zd:25919) (q:draft)
kizonsan = (i:1) (t:v) (f:politics/social) (w:be sought/be hunted for/be wanted) (d:<ki>, passive, with <zon>, seek, and the verb ending {-san}: be searched for, of a suspect on the run or a missing thing) (r:zd:18083/zd:19929) (q:draft)
kizop = (i:3) (t:v) (f:social/it) (w:contact/get in touch/communicate) (d:get in touch or keep in touch with a person or a group, by phone, letter or visit, usually after <tawh>; {kizop nading} introduces a contact name or number) (r:zd:19652/zd:17719/zd:13165) (q:draft)
kizopdan = (i:1) (t:n) (f:social) (w:way of relating/relationship/connection) (d:<kizop> and <dan> written as one word: the way people relate to or deal with one another; {mi tawh kizopdan siam} is good at getting on with people) (j:kizop/dan) (r:zd:21991/zd:16227) (q:draft)
kizopnate = (i:1) (t:n) (f:social/body) (w:relationships/connections/joints) (d:plural of <kizopna>: dealings and ties between people, connections, and in the body the joints where bones meet) (b:kizopna) (r:zd:13242/zd:21916) (q:draft)
kizoppih = (i:1) (t:v) (f:social) (w:be connected with/be in contact with/have relations with) (d:<kizop>, be joined, with <pih>, together with: be linked or keep in touch with someone; also used as a noun, a connection or contact) (b:kizop) (r:ts:3284/zd:13020/zd:26591) (q:draft)
kizoppihte = (i:1) (t:n) (f:social) (w:contacts/connections/associates) (d:<kizoppih>, be in contact with, with the plural ending <te>: the people one is connected or in touch with) (b:kizoppih) (r:zd:19938/zd:21355) (q:draft)
kizopzia = (i:1) (t:n) (f:social) (w:relationship/way of relating/connection) (d:<kizop>, be connected, and <zia>, way, written as one word: how people or things are connected or relate to one another) (j:kizop/zia) (r:zd:15234/zd:24114) (q:draft)
kizothei = (i:1) (t:v) (f:everyday/work) (w:can be completed/be able to finish) (d:<kizo>, be finished, and <thei>, able, written as one word: could be completed) (j:kizo/thei) (r:zd:20387) (q:draft, low confidence)
kizuakkhia = (i:1) (t:v) (f:work/media) (w:be sold/be sold out/be exported) (d:<zuakkhia>, sell off, with the passive prefix <ki>: of copies, tickets or goods, be sold) (b:zuakkhia) (r:zd:9254/zd:20153) (q:draft)
kizuakna = (i:2) (t:n) (f:work/everyday) (w:shop/stall/market) (d:the place where a thing is sold, named after the goods as in {laibu kizuakna}, a bookshop, and often followed by <ah> or <khat>; not the act of selling) (r:zd:9421/zd:12744/zd:24574) (q:draft)
kizuan = (i:1) (t:v) (f:travel/everyday) (w:head for/go to/make for) (d:<zuan>, head for, with the prefix <ki>: of people in general or each of a group, set out for a place or turn to someone) (b:zuan) (r:zd:22810/zd:24645/zd:15772) (q:draft)
kizui = (i:2) (t:v) (f:social) (w:be followed/be observed/be kept) (d:passive of <zui>, follow, with the prefix <ki>: a rule, custom or way of doing things is followed or kept; it stands without <tawh>, unlike {tawh kizui}, in keeping with) (r:zd:23990/zd:24000) (q:draft)
kizuiin = (i:1) (t:adv) (f:everyday) (w:in accordance with/in keeping with/according to) (d:<kizui> and <in> written as one word, placed after <tawh>: in keeping with what is named before it) (j:kizui/in) (r:zd:14703/zd:9434/zd:23286) (q:draft)
kizuui = (i:1) (t:v) (f:everyday) (j:kizui) (r:zd:11110) (q:draft)
kizuun = (i:1) (t:v) (f:everyday/social) (w:be tended/be maintained/be put in order) (d:<zuun> with the prefix <ki>: be looked after and kept in good order, or put oneself in order; paired with <kipuah>, be repaired) (b:zuun) (r:zd:21066/zd:22815) (q:draft)
KL = (i:1) (t:name) (c:city) (f:travel) (w:Kuala Lumpur/KL) (d:Kuala Lumpur, the capital of Malaysia, in its usual short form) (r:zd:19581/zd:17800) (q:draft)
Klang = (i:1) (t:name) (c:city) (f:travel) (w:Klang) (d:town and district in the state of Selangor, Malaysia, west of Kuala Lumpur, where many Zomi live) (r:zd:14885/zd:15686) (q:draft)
KLCC = (i:1) (t:name) (c:place) (f:travel) (w:KLCC/Kuala Lumpur City Centre) (d:the district of Kuala Lumpur, Malaysia, around the Petronas Twin Towers, with its shopping centre and convention centre) (r:zd:18028/zd:13303) (q:draft)
Klinik = (i:1) (t:n) (f:health) (w:clinic) (d:the Malay word for a clinic, used of clinics in Malaysia and in their names, as in Klinik Kesihatan, a government health clinic) (o:Malay) (r:zd:23427/zd:12715) (q:draft, low confidence)
KNDF = (i:1) (t:name) (f:politics) (w:Karenni Nationalities Defence Force/KNDF) (d:Karenni Nationalities Defence Force, an armed resistance group of Karenni State in Myanmar) (o:English) (r:ts:3110/ts:4587) (q:draft)
KNU = (i:1) (t:name) (f:politics) (w:KNU/Karen National Union) (d:the Karen National Union, a political and armed organisation of the Karen people in Myanmar) (r:zd:24318/zd:16262) (q:draft)
ko = (i:2) (t:v) (f:social/religion) (w:express/give/voice) (d:say out aloud what one feels, after <lungdam> or <lungdamna>: {lungdam ko} and {lungdamna ko} are to express thanks or joy; the pronoun {ko} stands before a noun or at the head of the clause instead) (r:zd:23037/zd:25189/zd:24123) (q:draft)
kobawl = (i:1) (t:v) (f:social) (w:disparage/reproach/find fault with) (d:speak of someone with blame, named together with <neubawl>, belittle) (r:zd:20929) (q:draft, low confidence)
kogawp = (i:1) (t:v) (f:social) (w:scold/abuse/shout at/berate) (d:shout angry or insulting words at someone; the second part is <gawp>, severely) (r:zd:20682/zd:12172) (q:draft)
koi = (i:1) (t:adv) (f:everyday/travel) (w:where) (d:question word for place, usually followed by a place word as in {koi-ah}, at what place, {koi lai}, whereabouts, and {koi pan}, from where) (s:koiah/koilai)
koibangin = (i:1) (t:adv) (f:everyday) (w:how/in what way) (d:<koi>, which, and <bangin>, in the way of, written as one word: question word asking in what way) (s:koici/bangci) (j:koi/bangin) (r:zd:24542/zd:19953) (q:draft)
koiciang = (i:1) (t:adv) (f:everyday) (w:how far/to what extent) (d:<koi> and <ciang> written as one word, a question: up to where, how far, to what extent) (j:koi/ciang) (r:zd:24124/zd:20823) (q:draft)
koicih = (i:1) (t:adv) (f:everyday) (w:how/in what way) (d:form of <koici> used before a verb or <ding>: {koicih ding} is how to do, what to do) (b:koici) (r:zd:23008/zd:19591/zd:20538) (q:draft)
koidan = (i:1) (t:adv) (f:everyday) (w:how/in what way) (d:<koi> and <dan>, way, written as one word: question word asking the manner of something, often followed by <in>) (s:koici/bangci) (j:koi/dan) (r:zd:24022/zd:23978/zd:17784) (q:draft)
koigam = (i:1) (t:n) (f:travel/social) (w:which country/what country) (d:<koi>, where or which, and <gam>, country, written as one word; {koimun koigam}, whatever place and country, means wherever) (j:koi/gam) (r:zd:23112/zd:21085) (q:draft)
koihcip = (i:2) (t:v) (f:everyday/work) (w:set aside/shelve/put on hold/leave unused) (d:put a thing or a matter away and leave it there without dealing with it or using it, said of a case kept waiting, a book left at home or an old house left without repair; not the shutting in of a person) (r:zd:11587/zd:11452/zd:12325) (q:draft)
koihding = (i:1) (t:v) (f:everyday) (w:to put/will put/to place) (d:<koih> and the future marker <ding> written as one word: to put, set up or deposit, will put) (j:koih/ding) (r:zd:15913/zd:21869/zd:20661) (q:draft)
koihhi = (i:1) (t:v) (f:everyday) (w:put/place/keep) (d:<koih> and the sentence-final <hi> written as one word: puts, places, keeps) (j:koih/hi) (r:zd:14566) (q:draft)
koihkha = (i:1) (t:v) (f:everyday) (w:happen to put/leave) (d:<koih>, put, with <kha>, happen to: put or leave something somewhere, often without thinking) (j:koih/kha) (r:zd:16408/zd:15067) (q:draft)
koihkoih = (i:1) (t:v) (f:everyday) (w:keep on putting/keep/leave in place) (d:<koih>, put, said twice and written as one word: go on keeping or leaving something where it is; after <hong>, wherever one is placed) (b:koih) (r:zd:21741/zd:25919) (q:draft)
koihlo = (i:1) (t:v) (f:everyday) (w:not put/not place) (d:<koih>, put, and <lo>, not, written as one word) (j:koih/lo) (r:zd:17149/zd:23301) (q:draft)
koihnading = (i:1) (t:phrase) (f:everyday) (w:for putting/for keeping/place to put) (d:<koih>, put or keep, and <nading>, for, written as one word: for putting or keeping something, and the place or means for it) (j:koih/nading) (r:zd:18054/zd:19527) (q:draft)
koihphot = (i:1) (t:v) (f:everyday) (w:put aside for now/leave for the time being) (d:<koih>, put, and <phot>, first or for now, written as one word: put or leave something for the time being) (j:koih/phot) (r:zd:24016/zd:20195/zd:22411) (q:draft)
koihta = (i:1) (t:v) (f:everyday/politics) (w:have put/have placed/have set up) (d:<koih>, put, with <ta>, now or already, written as one word: has now put or set up, common in headlines) (j:koih/ta) (r:zd:20394/zd:10997) (q:draft)
koihziau = (i:1) (t:v) (f:everyday) (w:put down casually/just leave/set aside) (d:<koih>, put, with <ziau>, quickly and lightly, written as one word: simply put a thing somewhere or leave a person or matter as it is, without care) (j:koih/ziau) (r:zd:18104/zd:20035) (q:draft)
koikoi = (i:1) (t:adv) (f:everyday/travel) (w:wherever/anywhere/everywhere) (d:<koi>, where, said twice: any place at all; {koikoi ah} is wherever, in every place, and after a verb it means here and there) (b:koi) (r:zd:21866/zd:20787/zd:9445) (q:draft)
koimun = (i:1) (t:adv) (f:everyday/travel) (w:where/which place/wherever) (d:<koi> and <mun> written as one word: which place, where; doubled as {koimun koimun}, wherever) (j:koi/mun) (r:zd:16914/zd:19571) (q:draft)
koisung = (i:1) (t:adv) (f:everyday) (w:in which/in which one) (d:<koi> and <sung> written as one word: inside which of several groups or places, followed by <ah>) (j:koi/sung) (r:zd:19311/zd:14720) (q:draft)
koiteng = (i:1) (t:adv) (f:everyday/travel) (w:where/which places/whereabouts) (d:<koi> and <teng> written as one word: at or to which place or places, where exactly) (j:koi/teng) (r:zd:25178/zd:17208) (q:draft, low confidence)
koiveng = (i:1) (t:phrase) (f:travel/everyday) (w:which neighbourhood/which quarter) (d:<koi> and <veng> written as one word: in which neighbourhood, paired with <koimun>, which place) (j:koi/veng) (r:zd:14686) (q:draft, low confidence, one repeated sentence)
koizaw = (i:1) (t:pron) (f:everyday) (w:which/which one) (d:<koi> with <zaw>, more: question word asking which of two) (b:koi) (q:draft)
Kokang = (i:1) (t:name) (c:land/people) (f:politics) (w:Kokang) (d:a region in the north of Shan State in Myanmar on the border with China, and the people who live there) (r:zd:11639/ts:5203) (q:draft)
koko = (i:1) (t:v) (f:everyday/social) (w:keep telling/keep declaring/proclaim) (d:the verb of {lungdam ko}, give thanks, said twice: go on telling or declaring; {lungdam koko} is give thanks again and again) (r:zd:24231/zd:15972/zd:24072) (q:draft)
kolampan = (i:1) (t:adv) (f:everyday/social) (w:from our side/on our part) (d:<ko> and <lampan> written as one word: from our side, as far as we are concerned) (j:ko/lampan) (r:zd:20263/zd:16216) (q:draft)
Kolkata = (i:1) (t:name) (c:city) (f:travel) (w:Kolkata/Calcutta) (d:a large city in the east of India, formerly written Calcutta) (r:zd:26566/zd:10973/zd:24272) (q:draft)
kom = (i:1) (t:conj) (f:everyday) (j:kawm) (r:zd:19866/zd:24280) (q:draft, low confidence)
kong = (i:2) (t:n) (f:home) (w:door/entrance/doorway) (d:the door or entrance of a house, tent or room) (s:kongkhak) (r:2.33.8)
kong it = (i:1) (t:phrase) (f:family/social) (w:I love you/beloved/dear) (d:<kong>, here the marker of an action by I toward you, and <it>, love: I love you; before a noun of address it means beloved, as in {kong it u leh naute}, my beloved brothers and sisters, a formula that opens a letter or speech) (r:zd:20071/zd:23424/zd:16052) (q:draft)
kong thum = (i:1) (t:phrase) (f:religion/social) (w:I beg you/I ask you/I beseech you) (d:<kong>, here the marker of an action by I toward you, and <thum>, here the verb plead: a formula that closes a request in a prayer, letter or appeal; the thing asked stands before it, often with <nading>, and <uh> follows when several ask) (r:zd:17025/zd:23037) (q:draft)
konggen = (i:1) (t:v) (f:everyday) (w:I tell you/I say to you) (d:<kong>, I to you, with <gen>, tell, written as one word: I tell you, what I am telling you) (j:kong/gen) (r:zd:17651/zd:8668) (q:draft)
kongit = (i:1) (t:phrase) (f:family/social) (j:kong it) (r:zd:25360/zd:20952) (q:draft)
kongkhak = (i:1) (t:n) (f:home) (w:door/entrance/doorway) (d:the door of a house, tent or room, and the entrance it closes) (s:kong)
kongngen = (i:1) (t:v) (f:religion/social) (w:ask you/request of you/pray to you) (d:<kong>, I or we to you, and <ngen>, ask, written as one word: I or we ask you; {thu kongngen hi} is I pray to you) (j:kong/ngen) (r:zd:21149/zd:22159) (q:draft)
kongpia = (i:1) (t:v) (f:everyday) (w:I give you/we give you) (d:<kong>, I to you, and <pia>, give, written as one word: I give or we give to you) (j:kong/pia) (r:zd:25932/zd:20263) (q:draft)
kongthum = (i:1) (t:v) (f:social) (w:apologise/beg pardon) (d:<kong> and <thum>, beg, written as one word: we beg you, said as an apology or as an earnest request) (j:kong/thum) (r:zd:15469/zd:20093/zd:11326) (q:draft)
kongthuum = (i:1) (t:v) (f:social) (w:apologise/beg/plead) (d:<kong> and <thuum> written as one word: I or we beg you; the usual way to say we apologise or we ask your understanding) (j:kong/thuum) (r:zd:16511/zd:11175) (q:draft)
kongvang = (i:2) (t:n) (f:home) (w:opening/window opening) (d:any opening in a wall, not only that of a door; with <tawlet> or the English word window it is the opening of a window, through which a thing is thrown or a person falls) (r:zd:13199/zd:14935) (q:draft, low confidence)
kongzawn = (i:1) (t:v) (f:social) (w:invite you/call on you) (d:<kong>, I or we to you, joined to <zawn> in its sense invite, urge to come: I invite you, we invite you; the usual close of a public invitation, {kongzawn uhhi}) (j:kong/zawn) (r:zd:11340/zd:11064) (q:draft)
konlawh = (i:1) (t:v) (f:social/everyday) (w:burden/trouble/draw in) (d:draw another person into one's own task or trouble and so put a burden on him) (r:zd:22380/zd:19065) (q:draft, low confidence)
kop = (i:2) (t:v) (f:everyday/social) (w:combine/pair/join) (d:put two together or do a thing together with another, used with <tawh>, with, or after another verb, as in {kalsuan kop}, walk together, and {kop khawm}, combine; not the counting noun pair) (r:zd:23016/zd:24199/zd:24056) (q:draft)
kopah = (i:1) (t:v) (f:everyday/social) (w:call at once/notify at once) (d:the verb for call out to, with <pah>, at once: call on or inform someone immediately, as in {hong kopah un}, let us know at once) (r:zd:22877) (q:draft, low confidence)
kopah = (i:2) (t:v) (f:social/media) (w:rebuke at once/cry out against) (d:the verb for shout at or scold, with <pah>, at once: speak out at once against what someone did) (r:zd:19530) (q:draft, low confidence)
kopen = (i:1) (t:pron) (f:everyday) (w:we/as for us) (d:<ko>, we, and the topic marker <pen> written as one word: as for us, we, leaving out the person spoken to) (j:ko/pen) (r:zd:16428/zd:16559/zd:10662) (q:draft)
kopkhat = (i:1) (t:n) (f:everyday/family) (w:one pair/a couple) (d:<kop> and <khat> written as one word: one pair; {nupa kopkhat} is one married couple) (j:kop/khat) (r:zd:13346/zd:25154) (q:draft)
Korea = (i:1) (t:name) (c:land) (f:politics/travel) (w:Korea) (d:the land of the Koreans in East Asia, in the articles mostly North Korea or South Korea) (r:zd:25208/zd:16906/zd:14942) (q:draft)
Korean = (i:1) (t:name) (c:people) (f:social) (w:Korean) (d:of Korea and its people; {Korean te} is the Koreans, and {North Korean} and {South Korean} follow English use) (o:English) (r:zd:25616/zd:11598) (q:draft)
Koreate = (i:1) (t:name) (c:people) (f:social/politics) (w:Koreans/the Koreans) (d:<Korea> with the plural <te>: the people of Korea; before a noun also Korean, of the Koreans) (b:Korea) (r:zd:24467/zd:24320) (q:draft)
Korinth = (i:1) (t:name) (f:religion) (j:Korin) (r:zd:26643/zd:13354) (q:draft)
kosak = (i:1) (t:v) (f:social) (w:have someone express/make say) (d:a form of <koh> with a causative ending: have someone say or express something; {lungdam kosak} is have a child say thank you) (r:zd:21991) (q:draft, low confidence)
kote = (i:1) (t:pron) (f:everyday) (w:we are/we/us) (d:first person plural pronoun that leaves out the person spoken to: <ko> with the plural <te>; English we, us or our depends on its place in the sentence) (s:ko/komau) (b:ko)
kou = (i:1) (t:pron) (f:everyday) (j:ko) (r:zd:23649) (q:draft, low confidence)
kozong = (i:1) (t:pron) (f:everyday) (w:we too/we also) (d:<ko> and <zong> written as one word: we also, leaving out the person spoken to) (j:ko/zong) (r:zd:24604/zd:12515/zd:12307) (q:draft)
Kremlin = (i:1) (t:name) (c:place) (f:politics) (w:Kremlin) (d:the seat of the government of <Russia> in Moscow, also said for that government) (r:ts:2529/zd:11215) (q:draft)
Kristian = (i:1) (t:name) (f:religion) (j:Khristian) (r:zd:23027/zd:25056) (q:draft)
KTV = (i:1) (t:n) (f:media/social) (w:karaoke lounge/KTV) (d:a place of entertainment with rooms for singing <Karaoke>, explained in one article as {Karaoke sai}) (o:English) (r:zd:12048) (q:draft)
kua = (i:2) (t:pron) (f:everyday) (w:who) (d:question word for a person: who; before a noun it asks whose, as in {kua min}, whose name) (r:1.3.11)
kuacih = (i:1) (t:phrase) (f:everyday/media) (w:who it is/the identity) (d:<kua>, who, and <cih>, written as one word: who a person is; {kuacih ki theician nailo} is it is not yet known for certain who it is) (j:kua/cih) (r:zd:17206/zd:11283) (q:draft)
kuacik = (i:1) (t:adj) (f:everyday/home) (w:narrow/cramped/tight) (d:with little room, of a street, a doorway, a room or a building; also written <kawcik>) (s:kawcik) (a:zai) (r:zd:17097/zd:14969/zd:12048) (q:draft)
kuahiam = (i:1) (t:pron) (f:everyday) (w:who/who it is/someone) (d:<kua>, who, and the question particle <hiam> written as one word: who it is; {kuahiam cih} is the question of who, and {kuahiam in} is someone) (j:kua/hiam) (r:zd:15830/zd:15874) (q:draft)
kual = (i:3) (t:n) (f:politics/travel) (w:area/tract/circle/region) (d:a group of villages that form one part of the Zo country, named after its chief village, clan or people, as {Tonzang kual}, {Gungal kual} and {Hualngo kual}; the name stands before {kual}) (r:zd:21421/zd:25357/zd:25120) (q:draft)
Kualalumpur = (i:1) (t:name) (c:city) (f:travel) (w:Kuala Lumpur) (d:capital city of Malaysia, usually written in two words) (r:zd:24168) (q:draft)
kuamaciat = (i:1) (t:pron) (f:everyday/social) (w:everyone/each one) (d:<kuama> and <ciat>, each, written as one word, usually as {a kuamaciat}: each and every one) (j:kuama/ciat) (r:zd:16139/zd:23538) (q:draft)
kuamahin = (i:1) (t:pron) (f:everyday) (w:no one/nobody) (d:<kuamah> and the subject marker <in> written as one word: no one, as the doer of a negative verb) (j:kuamah/in) (r:zd:11400/zd:16856) (q:draft)
kuaman = (i:1) (t:pron) (f:everyday) (w:no one/nobody) (d:<kuamah> with the subject marker <in>, shortened to {-n}: no one, as the doer of a negative verb; {kuaman theilo hi} is nobody knows) (b:kuamah) (r:zd:24043/zd:24117/zd:22686) (q:draft)
kuamapeuh = (i:1) (t:pron) (f:everyday/social) (w:everyone/anyone/whoever) (d:<kuama> and <peuh> written as one word: everyone, anyone at all; often {a kuamapeuh} after a list of people, all of them whoever they are) (j:kuama/peuh) (r:zd:9242/zd:9233/zd:10745) (q:draft)
kuamsung = (i:2) (t:n) (f:travel/media) (w:area/district/locality) (d:the area of a town or region, after a place name, as in {Gombak kuamsung}, the Gombak area, also of places that are not valleys) (r:zd:17748/zd:17411/zd:17228) (q:draft)
kuamsungteng = (i:1) (t:n) (f:travel) (w:whole area/vicinity/surroundings) (d:<kuam>, here area, and <sungteng>, throughout, written as one word after a place name: the whole area in and around that place) (j:kuam/sungteng) (r:zd:15481/zd:13303) (q:draft)
kuamteng = (i:1) (t:n) (f:travel/nature) (w:area/vicinity/surrounding area) (d:<kuam>, valley or area, and <teng>, all, written as one word after a place name: the whole area of or around that place) (j:kuam/teng) (r:zd:14947/zd:21984) (q:draft)
kuan = (i:2) (t:pron) (f:everyday) (w:who) (d:<kua>, who, with the marker <in> shortened to {-n}: who as the doer of the action, at the start of a question; not the verb set out) (r:zd:10951/zd:19953/zd:20028) (q:draft)
kuan = (i:3) (t:part) (f:time/everyday) (w:about to/on the point of/toward) (d:placed after a verb for what is just about to happen: {bei kuan} is nearing the end, of a month, a year or the world, {sih kuan} is at the point of death and {lup kuan} is at bedtime) (r:zd:24598/zd:22856) (q:draft)
kuanding = (i:1) (t:v) (f:work/travel) (w:be going to/be on the way to/will set out) (d:<kuan> and <ding> written as one word: about to set out, on the way to work or to a journey; {nasep kuanding} is going to work) (j:kuan/ding) (r:zd:12525/zd:10931/zd:23437) (q:draft)
kuangdai = (i:1) (t:n) (f:home/food) (w:plate/dish/platter) (d:a wide shallow dish, larger than <kuang> bowl) (s:dalkuang) (q:draft)
kuanggawp = (i:1) (t:v) (f:everyday) (w:burn up/be engulfed in flames/burn fiercely) (d:<kuang>, burn, with <gawp>, completely: burn fiercely or burn up altogether, often after <mei>, fire) (j:kuang/gawp) (r:zd:12477/zd:19470/zd:13324) (q:draft)
kuanglui = (i:1) (t:v) (f:politics) (w:stand for election/contest/run as a candidate) (d:put oneself forward as a candidate in an election, often as {mee kuanglui}; also said of the candidate) (r:zd:24327/zd:24603/zd:21470) (q:draft)
kuangluii = (i:1) (t:v) (f:politics) (j:kuanglui) (r:zd:24277) (q:draft)
kuangluina = (i:1) (t:n) (f:politics) (w:candidacy/standing for election) (d:<kuanglui>, stand for election, with the noun suffix <na>; {kuangluina bial} is the constituency where one stands) (b:kuanglui) (r:zd:21137/zd:24697) (q:draft)
kuangsawp = (i:1) (t:n) (f:work/food) (w:dishwasher/dishwashing) (d:<kuang>, bowl, with <sawp>, wash: washing the dishes, and a person who washes dishes in a restaurant) (r:zd:12024/zd:19932) (q:draft)
kuangsil = (i:1) (t:n) (f:home/work) (w:dishwashing/washing up) (d:<kuang>, bowl, with <sil>, wash: washing the dishes, as a household task or as paid work in a restaurant) (r:zd:17448/zd:24276) (q:draft)
kuanin = (i:3) (t:conj) (f:time) (w:just before/towards/when about to) (d:after a verb or after <dek>, at the moment something is about to happen: {a sih kuanin} is just before he died, {kha bei kuanin} is towards the end of the month; no going out is meant) (r:zd:15636/zd:25484/ts:3369) (q:draft)
kuankhiapah = (i:1) (t:v) (f:everyday/work) (w:set out at once/go out immediately) (d:<kuankhia>, set out, and <pah>, at once, written as one word: of a team or the police, leave at once for a task) (j:kuankhia/pah) (r:zd:12293/zd:17743) (q:draft)
kuanpi = (i:1) (t:n) (f:media) (w:full-size football) (d:apparently football played on the full-size field, as against futsal; {kuanpi kimawl} is play on the big field) (r:zd:23155) (q:draft, low confidence)
kuanpih = (i:1) (t:n) (f:family) (w:family member/family) (d:second part of {inn kuanpih}, a divided writing of <innkuanpih>: the family, or a member of it) (b:innkuanpih) (r:zd:22714/zd:16989) (q:draft)
kuanpihte = (i:1) (t:n) (f:family) (w:family members/household members) (d:second part of {inn kuanpihte}, a divided writing of <innkuanpih> with the plural <te>: the members of one family) (b:innkuanpih) (r:zd:12436) (q:draft)
Kuantan = (i:1) (t:name) (c:city) (f:travel) (w:Kuantan) (d:city on the east coast of Peninsular Malaysia, capital of the state of Pahang) (r:zd:21419/zd:13138) (q:draft)
kuapeuh = (i:1) (t:pron) (f:everyday) (w:everyone/anyone/whoever) (d:<kua>, who, and <peuh>, any, written as one word: whoever it is, everyone; after a list of people it means all of them) (j:kua/peuh) (r:zd:17804/zd:25626/zd:12074) (q:draft)
kuasah = (i:1) (t:n) (f:social/religion/family) (w:funeral feast/funeral sacrifice) (d:the traditional feast for a dead person, at which animals are killed; the word belongs to the old religion, so some prefer other words today) (r:zd:20170/ts:301) (q:draft)
kuatawh = (i:1) (t:phrase) (f:everyday/social) (w:with whom) (d:<kua>, who, and <tawh>, with, written as one word: with whom) (j:kua/tawh) (r:zd:12021/zd:12639) (q:draft)
kuaten = (i:1) (t:pron) (f:everyday) (w:who) (d:<kuate>, who of several people, with <in> marking the doer, written as one word) (b:kuate) (j:kuate/in) (r:zd:23546) (q:draft, low confidence)
Kuchai = (i:1) (t:name) (c:place) (f:travel) (w:Kuchai) (d:first word of Kuchai Lama, a district in the south of Kuala Lumpur in Malaysia, named in Zomi notices as a place of events and of work) (r:zd:21581/zd:22019) (q:draft)
Kuchai Lama = (i:1) (t:name) (c:place) (f:travel) (w:Kuchai Lama) (d:a district of Kuala Lumpur in Malaysia, a Malay place name; the second word is part of the name and is not the Zolai word <lama>) (r:zd:12024) (q:draft)
Kuching = (i:1) (t:name) (c:city) (f:travel) (w:Kuching) (d:city in Malaysia, capital of the state of Sarawak) (r:zd:18270/zd:20738) (q:draft)
kugawp = (i:1) (t:v) (f:everyday) (w:scream/shriek/cry out wildly) (d:<ku>, cry out, with <gawp>, which shows that it is done violently: scream loudly in fear or panic) (j:ku/gawp) (r:zd:16617/zd:22618) (q:draft)
kuhkal = (i:1) (t:adj) (f:everyday/work) (w:diligent/persevering/steadfast) (d:working hard and keeping at a task without giving up; often paired with <citak>) (r:zd:16340/zd:20241) (q:draft)
kuhkalna = (i:1) (t:n) (f:work/social) (w:diligence/perseverance/steadfastness) (d:steady, persistent effort that does not give up, often paired with <cihtakna>) (r:zd:16340/zd:25067/zd:9448) (q:draft)
kuitung = (i:1) (t:n) (f:everyday/education) (w:summit/peak/highest point) (d:the highest point or level that can be reached, as in {pilna kuitung}, the highest level of learning, and {thuneihna kuitung}, supreme authority; also used as a verb, reach the top) (r:zd:24502/zd:24160/zd:25152) (q:draft)
Kuki = (i:1) (t:name) (c:people) (f:social/politics) (w:Kuki) (d:a name for related hill peoples of Manipur and nearby parts of India, the Thadou being the largest group; named together with Chin, Mizo and Zomi) (r:zd:20584/zd:24227) (q:draft)
kul = (i:1) (t:v) (f:everyday) (w:must/need/be necessary) (d:placed after a verb or after <ding>: it is necessary to, have to; with <lo> or <se loin>, there is no need to) (s:kisam) (r:5.18.22) (q:draft)
Kulai = (i:1) (t:name) (c:city) (f:travel) (w:Kulai) (d:a town and district in the state of Johor, Malaysia) (r:zd:13230) (q:draft)
kulden = (i:1) (t:v) (f:everyday) (w:always have to/keep having to) (d:<kul> and <den> written as one word after a verb: it is necessary all the time, one has to keep doing it) (j:kul/den) (r:zd:12534/zd:20764/zd:14787) (q:draft)
kulding = (i:1) (t:v) (f:everyday) (w:will have to/will need to) (d:<kul>, be necessary, and <ding>, will, written as one word after a verb: it will be necessary to) (j:kul/ding) (r:zd:12327/zd:15445/zd:12094) (q:draft)
kulhi = (i:1) (t:v) (f:everyday) (w:must/need/be necessary) (d:<kul>, be necessary, and the sentence ending <hi>, written as one word after a verb: it is necessary to, one must) (j:kul/hi) (r:zd:16637/zd:22203) (q:draft)
Kulim = (i:1) (t:name) (c:city) (f:travel) (w:Kulim) (d:a town and district in the state of Kedah, Malaysia) (r:zd:12825/zd:19414) (q:draft)
kullai = (i:1) (t:v) (f:everyday) (w:still need/still have to) (d:<kul>, must, with <lai>, still: it is still necessary, one still has to) (b:kul) (r:zd:11782/zd:15572/zd:24236) (q:draft)
kullaiding = (i:1) (t:v) (f:everyday) (w:will still need to/will still have to) (d:<kullai>, still be necessary, and <ding> written as one word) (j:kullai/ding) (r:zd:12942/zd:17735) (q:draft)
kulna = (i:1) (t:n) (f:everyday) (w:necessity/need) (d:<kul>, be necessary, with the noun suffix {-na}: the need for something, the fact that it is necessary; {a kulna} is the need for it, where it is needed) (s:kisapna) (b:kul) (r:zd:17958/zd:22701/zd:24217) (q:draft)
kulnawn = (i:1) (t:v) (f:everyday) (w:need any longer/be necessary any more) (d:<kul> and <nawn> written as one word, followed by <lo> or <kei>: no longer necessary, no need any more) (j:kul/nawn) (r:zd:25569/zd:24847) (q:draft)
kulnawnlo = (i:1) (t:v) (f:everyday) (w:no longer necessary/no longer need) (d:<kul>, be necessary, and <nawnlo>, no longer, written as one word) (j:kul/nawnlo) (r:zd:12336/zd:25573) (q:draft)
kulpah = (i:1) (t:v) (f:everyday) (w:must at once/have to straight away) (d:<kul>, must, and <pah>, at once, written as one word after a verb: it becomes necessary right away to do it) (j:kul/pah) (r:zd:17622/zd:13270) (q:draft, low confidence)
kulta = (i:1) (t:v) (f:everyday) (w:be now necessary/must now) (d:<kul>, be necessary, and <ta>, now or already, written as one word: it has become necessary to) (j:kul/ta) (r:zd:22540/zd:16788/zd:24749) (q:draft)
kum = (i:1) (t:n) (f:time) (w:year) (d:a year, in counting time and in giving the age of a person; {kum thum sung} is for three years and {kum za pha} is be a hundred years old) (r:1.23.1)
kumaa = (i:1) (t:phrase) (f:time) (w:in the year/of the year/for the year) (d:<kum>, year, and <aa> written as one word after a number or <tua>: of or in that year) (j:kum/aa) (r:zd:20176/zd:21590) (q:draft)
kumah = (i:1) (t:adv) (f:time) (w:in the year) (d:<kum> and <ah> written as one word: in the year, after the number or the name of the year) (j:kum/ah) (r:ts:3562/zd:24422) (q:draft)
kumbangzah = (i:1) (t:phrase) (f:time) (w:how many years) (d:<kum>, year, and <bangzah>, how many, written as one word) (j:kum/bangzah) (r:zd:15807/zd:21900) (q:draft)
kumbei = (i:1) (t:n) (f:time) (w:end of the year/year end) (d:<kum> and <bei> written as one word: the end of a year, after the number of the year the end of that year) (j:kum/bei) (r:zd:15459/zd:21409/zd:25488) (q:draft)
kumciang = (i:1) (t:adv) (f:time) (w:by the year/in the year) (d:<kum>, year, and <ciang>, up to or when, written as one word and placed after the number of a year: by that year, when that year comes) (j:kum/ciang) (r:zd:16257/zd:11438) (q:draft)
kumciangin = (i:1) (t:adv) (f:time) (w:in the year/by the year) (d:<kum>, year, and <ciangin>, when, written as one word after the number of a year: in that year, or when that year comes) (j:kum/ciangin) (r:zd:12567/zd:17735/zd:17711) (q:draft)
kumciangtanlo = (i:1) (t:phrase) (f:social) (w:no age limit/without age limit) (d:<kum>, year or age, <ciangtan>, limit, and <lo>, not, written as one word: people of any age may take part) (j:kum/ciangtan/lo) (r:zd:17634) (q:draft)
kumcin = (i:1) (t:adj) (f:time/social) (w:annual/yearly/anniversary) (d:<kum>, year, with <cin>, be completed: held or done when the year is full, once a year; {kumcin khawmpi} is an annual conference and {kumcin pawi} an anniversary feast) (r:zd:12039/zd:19971/zd:13013) (q:draft)
Kumcin Khawmpi = (i:1) (t:n) (f:social/religion) (w:annual conference/annual convention/annual general meeting) (d:<kumcin>, annual, and <khawmpi>, conference: the great meeting that a society or church holds once every year, where reports are heard and often leaders are chosen; the name of the body stands before it and the year often after it) (r:zd:12039/zd:12366) (q:draft)
kumcing = (i:1) (t:adj) (f:social/family) (w:of age/adult/full-grown) (d:<kum>, year, with <cing> in the sense be full, written as one word: having reached adult age; {kumcing nailo} is not yet of age, a minor) (j:kum/cing) (r:zd:13323/zd:16332/zd:19282) (q:draft)
kumcinglo = (i:1) (t:adj) (f:social/family) (w:underage/minor) (d:<kum>, year, {cing lo}, not complete, written as one word: not yet of full age, said of a child or young person below the legal age; <cing> here means be full, not guard) (j:kum/cing/lo) (r:zd:11654/zd:14599) (q:draft)
kumcingnailo = (i:1) (t:adj) (f:social/politics) (w:underage/minor) (d:<kum>, year, <cing>, be complete, and <nailo>, not yet, written as one word: not yet of full age, a person under the legal age) (j:kum/cing/nailo) (r:zd:17681/zd:14648) (q:draft)
kumcingsa = (i:1) (t:n) (f:social/family) (w:adult/grown-up) (d:<kumcing>, of age, with <sa>, here already: one who has reached adult age, set against {kumcing nailo}, not yet of age) (b:kumcing) (r:zd:15107/zd:24074/zd:13323) (q:draft)
kumdang = (i:1) (t:n) (f:time) (w:other years/previous years) (d:<kum>, year, and <dang>, other, written as one word: other years, the years before this one; {kumdang bangin} is as in other years) (j:kum/dang) (r:ts:1202/zd:24186/zd:13133) (q:draft)
kumding = (i:1) (t:n) (f:time) (w:years to come/number of years) (d:<kum>, year, and <ding>, will, written as one word: the years that are to be, as the years of a prison sentence) (j:kum/ding) (r:zd:17526) (q:draft, low confidence)
kumdong = (i:1) (t:adv) (f:time) (w:until the year/up to the year) (d:<kum>, year, and <dong>, until, written as one word after the number of a year: until that year) (j:kum/dong) (r:zd:16381/zd:21649) (q:draft)
kumh = (i:1) (t:v) (f:social/work) (w:consult/discuss with) (d:take a matter to someone and talk it over with him; compare <kikum>, discuss together) (r:zd:19166/zd:20176) (q:draft, low confidence)
kumkhatsung = (i:1) (t:adv) (f:time) (w:in one year/within a year/during the year) (d:<kumkhat>, one year, and <sung>, in, written as one word) (j:kumkhat/sung) (r:zd:15822/zd:10729) (q:draft)
kumkhattek = (i:1) (t:adv) (f:time/politics) (w:one year each/a year each) (d:<kumkhat>, one year, and <tek>, each, written as one word: one year for each of them) (j:kumkhat/tek) (r:zd:15779) (q:draft)
kumkhawm = (i:1) (t:v) (f:social) (w:discuss together/confer/talk over) (d:talk a matter over together, the verb of <kikum>, discuss, with <khawm>, together; often after <thu> or <ki>, compare <kikumkhawm>) (s:kikumkhawm) (r:zd:11848/zd:25047) (q:draft)
kumkhen = (i:1) (t:n) (f:time/social) (w:turn of the year/year's end) (d:<kum> year with <khen> divide: the parting of the old year from the new; {kumkhen pawi} is another name of the Khuado harvest festival) (r:zd:15800/zd:15622) (q:draft)
kumkhua = (i:1) (t:n) (f:time) (w:years/lifetime) (d:word of songs and poetry for the years of a life; {khan kumkhua sawt} is to live long) (r:zd:15861/zd:16038) (q:draft, low confidence)
kumkik = (i:2) (t:v) (f:religion/travel) (w:come down again/descend again/return) (d:<kum>, come down, with <kik>, again: come back down; said of an aircraft that lands again and of the return of Jesus, {Zeisu hong kumkik}; a verb after <hong>, not the noun for next year) (r:zd:21050/zd:12985) (q:draft)
kumkum = (i:1) (t:adv) (f:time) (w:year by year/every year) (d:<kum>, year, doubled: as {a kumkum in}, year after year, with each year that passes; written <kumkumin> when the ending is joined) (b:kum) (r:zd:17185/zd:22650) (q:draft)
kumlai = (i:1) (t:n) (f:time) (w:year/around the year) (d:<kum>, year, with <lai>, the time of, written as one word after the number of a year: in or around that year) (j:kum/lai) (r:zd:24932/zd:19581) (q:draft)
kumlui = (i:1) (t:n) (f:time) (w:old year/past year/last year) (d:<kum> and <lui> written as one word: the year that has ended, set against <kumthak>, the new year; {kumlui in} is last year) (j:kum/lui) (r:zd:25392/zd:21957) (q:draft)
kumpan = (i:1) (t:adv) (f:time) (w:from the year/since the year) (d:<kum>, year, and <pan>, from, written as one word, placed after the number of a year: from that year on) (j:kum/pan) (r:zd:12301/zd:15184/zd:12787) (q:draft)
kumpanin = (i:1) (t:adv) (f:time) (w:from the year/since the year) (d:<kum> and <panin> written as one word, after the number of a year: from that year on) (j:kum/panin) (r:zd:20263/zd:20367) (q:draft)
kumpawl = (i:1) (t:n) (f:time) (w:about the year/around the years) (d:<kum> and <pawl> written as one word, placed after a year or a decade: in about that year, in those years; {1990s kumpawl in} is in the 1990s) (j:kum/pawl) (r:zd:10945/zd:15842) (q:draft)
kumpek = (i:1) (t:adv) (f:time) (w:back in the year/as long ago as) (d:<kum>, year, and <pek> written as one word after the number of a year: as far back as that year) (j:kum/pek) (r:zd:10992/zd:14963/zd:16588) (q:draft)
kumpekpan = (i:1) (t:adv) (f:time) (w:since as long ago as/as far back as) (d:<kum>, year, <pek>, long ago, and <pan>, from, written as one word after the number of a year: since as far back as that year) (j:kum/pek/pan) (r:zd:19801/zd:24490/zd:17802) (q:draft)
kumpen = (i:1) (t:phrase) (f:time) (d:<kum>, year, and the topic marker <pen> written as one word: the year, as for the year) (j:kum/pen) (r:zd:16177/zd:23943) (q:draft)
kumpi = (i:3) (t:n) (f:politics) (w:government/state/authorities) (d:the government of a country, in present-day use, often after the name of the country as in {India kumpi}; <kumpi nasem> is a government employee) (r:zd:25678/zd:25573/zd:24215) (q:draft)
kumpi nasem = (i:1) (t:n) (f:work/politics) (w:government employee/civil servant/government service) (d:<kumpi>, here the government, and <nasem>, one who works: a person employed by the state, and also the service itself; {kumpi nasem te} is government staff) (r:zd:25678/zd:20403/zd:24471) (q:draft)
kumpi nasemte = (i:1) (t:n) (f:politics/work) (w:civil servants/government employees/government staff) (d:<kumpi>, king and today the government, and <nasemte>, workers: the people employed by the state, civil servants) (r:zd:10742/zd:18200) (q:draft)
kumpi phalna = (i:1) (t:n) (f:politics) (w:government permission/official permit/licence) (d:<kumpi>, here the government and not a king, and <phalna>, permission: permission or a permit given by the authorities; {kumpi phalna nget} is apply for it and {kumpi phalna tawh} is with official permission) (r:zd:24854/zd:20912) (q:draft)
kumpi thukhun = (i:1) (t:n) (f:politics) (w:law/state law/government regulation) (d:<kumpi>, here the government or the state, and <thukhun>, rule: the law of the country, the regulations of the government; {kumpi thukhun ombangin} is according to the law) (r:zd:22813/zd:19953) (q:draft)
kumpi thunei = (i:1) (t:n) (f:politics) (w:the authorities/government officials) (d:<kumpi>, here the government, and {thunei}, one who has the say: those who hold office in the government of a country, the authorities; mostly followed by <te>) (r:zd:22223/zd:15379/zd:17990) (q:draft)
kumpi thuneihna = (i:1) (t:n) (f:politics) (w:state power/government authority/royal authority) (d:<kumpi>, king and in present-day use the government, with <thuneihna>, authority: the power of the state or of a ruler to govern; {kumpi thuneihna tawh} is by the authority of the state, and the power that is seized in a coup is named so) (r:zd:23791/zd:21040/zd:16055) (q:draft)
kumpi thuneite = (i:1) (t:n) (f:politics) (w:government authorities/government officials/the authorities) (d:<kumpi>, here government and not king, and <thuneite>, those in authority: the officials of the state, the authorities; the name of a country may stand before it, as in {India kumpi thuneite}) (r:zd:24166/zd:10910) (q:draft)
kumpi ulian = (i:1) (t:n) (f:politics) (w:government official/senior official/authorities) (d:<kumpi>, here the government, and <ulian>, high official: a high officer of a government, such as a minister; mostly followed by <te>) (r:zd:14505/zd:25060) (q:draft)
kumpi vaihawmna = (i:1) (t:n) (f:politics) (w:government administration/government scheme/government) (d:<kumpi>, here the government, with <vaihawmna>, the managing of affairs: the administration of a government, or a scheme that it runs; the name of the country stands before it) (r:ts:3506/zd:21215) (q:draft, low confidence)
kumpilam = (i:1) (t:n) (f:politics) (w:government side/the authorities) (d:<kumpi>, here the government, and <lam>, side, written as one word: the side of the government, those in public office) (j:kumpi/lam) (r:zd:23821/zd:11176) (q:draft, low confidence)
kumpisang = (i:1) (t:n) (f:education) (w:government school/state school) (d:<kumpi>, here the government, with <sang>, school, written as one word: a school run by the government) (j:kumpi/sang) (r:zd:11891/zd:25221) (q:draft)
kumpite = (i:2) (t:n) (f:politics) (w:government/authorities/rulers) (d:the government of a country and those who govern it, in the present day and without any king: after the name of a country, as in {Malaysia kumpite}, or after <uk>, as in {hong uk kumpite}, those who govern us) (b:kumpi) (r:ts:3125/zd:24376/zd:25281) (q:draft)
kumpiten = (i:1) (t:n) (f:politics) (w:the government/the authorities) (d:<kumpite> and <in> written as one word: the government or the rulers as the doer of the action) (j:kumpite/in) (r:zd:10687/zd:24036) (q:draft)
kumpithak = (i:1) (t:n) (f:politics) (w:new government/new king) (d:<kumpi>, king or government, and <thak>, new, written as one word: the new government, or the new king) (j:kumpi/thak) (r:zd:19721/zd:18065) (q:draft)
kumpivai = (i:1) (t:n) (f:politics) (w:official business/state affairs/government matter) (d:<kumpi>, king or government, with <vai>, affair, written as one word: government business; {kumpivai tawh zin} is travel on an official visit) (j:kumpi/vai) (r:zd:16663/zd:12101) (q:draft)
kumpizum = (i:1) (t:n) (f:politics/work) (w:government office/government) (d:<kumpi>, here government, and <zum>, office, written as one word: an office of the government, also the government as an authority) (j:kumpi/zum) (r:zd:23049/zd:19966) (q:draft)
kumsangin = (i:1) (t:adv) (f:time) (w:than the year/than last year) (d:<kum> and <sangin> written as one word: compared with a year, as in {abeisa kumsangin}, than last year) (j:kum/sangin) (r:zd:17088/zd:20547) (q:draft)
kumsawt = (i:1) (t:n) (f:time) (w:many years/long time/long life) (d:<kum>, year, and <sawt>, long, written as one word: many years, a long span of years; in blessings, a long life) (j:kum/sawt) (r:zd:25318/zd:14648/zd:21099) (q:draft)
kumsawtpi = (i:1) (t:adv) (f:time) (w:for many years/for years) (d:<kum>, year, and <sawtpi>, for a long time, written as one word: for many years) (j:kum/sawtpi) (r:zd:22983/zd:23929/zd:24276) (q:draft)
kumsial = (i:1) (t:adv) (f:time) (w:every year/yearly/each year) (d:<kum>, year, with <sial>, each: every year, year after year) (r:zd:16506/zd:19203) (q:draft)
kumsim = (i:2) (t:adv) (f:time) (w:every year/yearly/annually) (d:used alone or as {kumsim in} and {kumsim a} before the verb or a date: every year; not the adjective before a noun) (r:zd:21348/zd:23466/zd:21862) (q:draft)
kumsung = (i:1) (t:adv) (f:time) (w:in the year/during the year) (d:<kum>, year, and <sung>, in, written as one word, mostly after the number of a year: in that year, in the course of the year) (j:kum/sung) (r:zd:17179/zd:17689/zd:23797) (q:draft)
kumsungin = (i:1) (t:adv) (f:time) (w:in the year/during the year) (d:<kum>, year, and <sungin>, within, written as one word, after the number of a year: in that year) (j:kum/sungin) (r:zd:18893/zd:19671) (q:draft)
kumtam = (i:1) (t:n) (f:time) (w:many years/long life) (d:<kum>, year, with <tam>, many, written as one word: many years; of a person, many years of age, set against <kumtawm>, few years) (j:kum/tam) (r:zd:22744/zd:22429/zd:15323) (q:draft)
kumtamkhin = (i:1) (t:adj) (f:family/time) (w:elderly/aged/old) (d:<kumtam>, many years, and <khin>, already, written as one word: advanced in years, said of an old person; of a thing, long in use and worn out) (j:kumtam/khin) (r:zd:15207/zd:16389/zd:17822) (q:draft)
kumtampi = (i:1) (t:n) (f:time) (w:many years) (d:<kum>, year, and <tampi>, many, written as one word; {kumtampi sung} is for many years) (j:kum/tampi) (r:zd:24234/zd:21876) (q:draft)
kumtawm = (i:1) (t:adj) (f:time/family) (w:young/of few years) (d:<kum>, year, with <tawm>, few, written as one word: few in years, young of age, set against <kumtam>, many years) (a:kumtam) (j:kum/tawm) (r:zd:25394/zd:12409) (q:draft)
kumtawn = (i:1) (t:adv) (f:time) (w:all year long/year after year) (d:<kum>, year, with <tawn>, along; in the pair {kumtawn khatawn}, through the years and months, all the time) (j:kum/tawn) (r:zd:21037) (q:draft, low confidence)
kumteh = (i:1) (t:adv) (f:time) (w:in the year/when the year came) (d:<kum>, year, and <teh>, here when, written as one word after the number of a year: in that year, when that year came) (j:kum/teh) (r:zd:21327/zd:16433) (q:draft)
kumthak = (i:1) (t:n) (f:time/social) (w:new year/New Year) (d:<kum>, year, and <thak>, new, written as one word: the new year and its feast) (j:kum/thak) (r:zd:23486/zd:19275) (q:draft)
kumthakni = (i:1) (t:n) (f:time/social) (w:New Year's Day) (d:<kum>, year, <thak>, new, and <ni>, day, written as one word: the first day of the new year) (j:kum/thak/ni) (r:zd:10729) (q:draft)
kumzalom = (i:1) (t:n) (f:time) (w:century) (d:<kumza>, a hundred years, with <lom>, bundle: a period of a hundred years; a number after it names the century, as in {kumzalom 21}, the 21st century) (r:zd:21288/ts:11162/zd:23729) (q:draft)
kun = (i:2) (t:n) (f:food) (w:betel/areca) (d:the betel that is chewed, a different word from {kun}, bow; {kun gah} is the areca nut, also traded as goods, and <kunza> is the betel quid) (o:Burmese, kun) (r:ts:3227) (q:draft, low confidence)
kung = (i:4) (t:n) (f:everyday/religion) (w:goal/mark) (d:the point a runner or a person makes for, short for <kungmui>; brought out by {kung dongah tai}, run up to the goal, and by <tupna>, aim, beside it, not a tree or plant) (s:kungmui) (r:zd:17488/zd:20906) (q:draft, low confidence)
kunglam = (i:1) (t:n) (f:everyday/media) (w:goal/mark) (d:the goal one heads for; in football the goal of a side, and in the saying {kunglam zuanin tai} run toward the goal) (r:zd:21100/zd:20746) (q:draft, low confidence)
kungmui = (i:1) (t:n) (f:everyday/social) (w:goal/aim/target) (d:the point one sets out to reach, in a race or in life and work; {kungmui tung} is reach the goal) (r:zd:15259/zd:22709/zd:21737) (q:draft)
kungpang = (i:1) (t:n) (f:media) (w:goalkeeper) (d:the player who guards the goal in football; also {kungpang mi}) (r:zd:15622/zd:20746) (q:draft)
kungpu = (i:1) (t:n) (f:social/politics) (w:chief/master/head) (d:the foremost one of a kind, placed after a noun: {kumpi kungpu} is an emperor, {vuanzi kungpu} a chief minister and {la kungpu} a master of song) (r:zd:16914/zd:10874) (q:draft)
