lauhuailua = (i:1) (t:adj) (f:everyday) (w:too dangerous/very frightening) (d:<lauhuai> and <lua> written as one word: too fearful, very dangerous) (j:lauhuai/lua) (r:zd:24276/zd:22223/zd:19814) (q:draft)
lauhuaisak = (i:1) (t:v) (f:social/health) (w:endanger/make dangerous/frighten) (d:<lauhuai>, fearful or dangerous, and <sak>, cause, written as one word: put in danger, raise the danger of) (j:lauhuai/sak) (r:zd:15408/zd:14519) (q:draft)
lauhuaithei = (i:1) (t:adj) (f:everyday/health) (w:can be dangerous/potentially dangerous) (d:<lauhuai> and <thei>, can, written as one word: it can be dangerous or frightening) (j:lauhuai/thei) (r:zd:24276/zd:14954) (q:draft)
