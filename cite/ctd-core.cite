thauh = (i:1) (t:v) (f:politics) (w:support/endorse/back) (d:only in {thauh khaan}, from Burmese: support or endorse a person or a government; {thauh khaan muh ngah} is win the support of) (o:Burmese, htauk khan) (r:zd:15047) (q:draft, low confidence)
thauhoih = (i:1) (t:n) (f:politics/media) (w:good gun/quality firearm) (d:<thau>, gun, and <hoih>, good, written as one word: good or powerful firearms) (j:thau/hoih) (r:zd:11600) (q:draft, low confidence)
thauka = (i:1) (t:n) (f:politics) (w:double-barrelled shotgun/shotgun) (d:a gun with two barrels fired with shot) (r:ts:301) (q:draft)
thaukap = (i:1) (t:n) (f:politics) (w:shooting/gunfire/gunman/shooter) (d:<thau>, here gun, with <kap>, shoot: the firing of a gun, and the person who fires; {thaukap pa} is the gunman and {thaukap siam} a marksman) (r:zd:16406/zd:24001) (q:draft)
thaukapna = (i:1) (t:n) (f:politics/media) (w:shooting/gunfire) (d:the act of shooting with a gun, a shooting incident; <thaukap> with the noun suffix {-na}) (b:thaukap) (r:zd:11932/zd:11995) (q:draft)
thaukappa = (i:1) (t:n) (f:social/media) (w:gunman/shooter) (d:the man who shoots with a gun: <thau>, here gun and not fat, with <kappa>, shooter) (j:thau/kappa) (r:zd:20219/zd:19868) (q:draft)
thaukhat = (i:1) (t:n) (f:politics/media) (w:a gun/one gun) (d:<thau>, here a gun, and <khat>, one, written as one word: a gun, often after the English name of the kind of gun) (j:thau/khat) (r:zd:20191/zd:16131) (q:draft)
thaukikap = (i:1) (t:n) (f:politics/media) (w:shooting/gunfire) (d:<thau>, here a gun, and <kikap>, be shot, written as one word: a shooting, an exchange of gunfire) (j:thau/kikap) (r:zd:17748/zd:14919) (q:draft)
thaukikapna = (i:1) (t:n) (f:politics/media) (w:shooting/gunfire/gunfight) (d:<kikapna>, shooting at one another, with the word for gun before it: a shooting incident or an exchange of gunfire) (b:kikapna) (r:zd:20252/zd:12146) (q:draft)
thaulawng = (i:1) (t:n) (f:politics) (j:thau lawng) (r:ts:3375/zd:25611) (q:draft)
thaulua = (i:1) (t:adj) (f:body/health) (w:too fat/overweight/obese) (d:<thau> and <lua> written as one word: too fat) (j:thau/lua) (r:zd:23972/zd:21306) (q:draft)
thauluatna = (i:1) (t:n) (f:health/body) (w:obesity/being overweight/excess fat) (d:<thau>, fat, and <luatna>, excess, written as one word: being too fat) (j:thau/luatna) (r:zd:20747/zd:22019) (q:draft)
thaumuk = (i:1) (t:n) (f:politics) (w:gun barrel/muzzle/the gun) (d:<thau>, here gun, with <muk>, mouth: the muzzle of a gun; it stands for armed force, as in {thaumuk tawh uk}, rule by the gun) (r:zd:22992/zd:25043/zd:20673) (q:draft)
thauna = (i:1) (t:n) (f:body/health) (w:fat/fatness/body fat) (d:<thau>, fat, with the noun ending {-na}: the fat of the body, used also for cholesterol) (b:thau) (r:zd:14826) (q:draft, low confidence)
thauneu = (i:1) (t:n) (f:politics) (w:handgun/pistol/small arms) (d:<thau>, gun, with <neu>, small: a pistol or revolver, and in war reports small arms as against <thaupi>, heavy guns) (a:thaupi) (r:zd:10735/ts:7798/zd:19973) (q:draft)
thauno = (i:1) (t:n) (f:politics) (w:pistol/handgun/small gun) (d:a small gun held in one hand; <thau lawng> is a gun) (r:ts:6573) (q:draft, low confidence)
thaupen = (i:1) (t:phrase) (f:politics/media) (w:the gun) (d:<thau>, here a gun, and the topic marker <pen> written as one word: the gun, as the topic of the sentence) (j:thau/pen) (r:zd:14609/zd:21332) (q:draft)
thaupi = (i:1) (t:n) (f:politics) (w:cannon/artillery/heavy weapon) (d:a big gun; <thau>, gun, with <pi>, big: artillery, and in news also a missile or rocket) (r:ts:5913/ts:5480/ts:7798) (q:draft)
thaupite = (i:1) (t:n) (f:politics) (w:artillery/heavy weapons/cannons/missiles) (d:plural of <thaupi>: big guns, artillery pieces or missiles) (b:thaupi) (r:ts:8880/ts:3254) (q:draft)
thaupua = (i:1) (t:v) (f:politics/media) (w:carry a gun/be armed) (d:<thau>, gun, and <pua>, carry, written as one word: carry a gun; before <khat> it names a person carrying a gun) (s:thautawi) (r:zd:17556) (q:draft)
thautang = (i:1) (t:n) (f:politics) (w:bullet/cartridge/ammunition) (d:the shot fired from a gun; {thau leh thautang} is guns and ammunition) (r:zd:12274/ts:9163/zd:12621) (q:draft)
thautanghawng = (i:1) (t:n) (f:politics) (w:bullet casing/cartridge case/shell casing) (d:<thautang> and <hawng> written as one word: the empty case left after a bullet is fired) (j:thautang/hawng) (r:zd:21328) (q:draft)
thautangpi = (i:1) (t:n) (f:politics) (w:shell/bomb/missile) (d:<thautang>, bullet, with <pi>, big: a heavy round fired or dropped in war, such as an artillery or mortar shell, a bomb or a missile) (b:thautang) (j:thautang/pi) (r:ts:5049/zd:25188) (q:draft)
thautangte = (i:1) (t:n) (f:politics) (w:bullets/ammunition) (d:plural of <thautang>, bullet) (b:thautang) (r:ts:3759/ts:1786) (q:draft)
thautawh = (i:1) (t:adv) (f:politics/everyday) (w:with a gun/by shooting) (d:<thau>, here in the sense gun, and <tawh>, with, written as one word: with a gun, mostly before <kap>, shoot) (j:thau/tawh) (r:zd:18030/zd:12437) (q:draft)
thautawi = (i:1) (t:n) (f:politics) (w:armed person/gunman/armed group) (d:the word for gun with <tawi>, carry: one who carries a gun; before a noun it means armed, as in <thautawi kipawlna>, armed organisation, and <mualmi thautawi> is an ethnic armed group) (r:zd:25043/zd:21262/zd:19308) (q:draft)
thautawi kipawlna = (i:1) (t:n) (f:politics) (w:armed organisation/armed group) (d:<thautawi>, one who carries a gun, armed, and <kipawlna>, organisation: an armed organisation, the usual term for the ethnic and resistance armies of Myanmar; {minam thautawi kipawlna} is an ethnic armed organisation) (r:zd:25043/zd:21509/zd:25562) (q:draft)
thautawi migilo = (i:1) (t:n) (f:politics/media) (w:gunman/armed criminal/armed militant) (d:<thautawi>, one who carries a gun, and <migilo>, wicked person: an armed attacker, used in news for gunmen, armed robbers and armed militant groups; <te> follows for the plural) (r:zd:12159/zd:17032) (q:draft)
thautawina = (i:1) (t:n) (f:politics) (w:bearing arms/taking up arms/armed struggle) (d:<thau>, gun, and <tawina>, carrying, written as one word: the taking up or bearing of arms) (j:thau/tawina) (r:zd:25043) (q:draft)
thautawipa = (i:1) (t:n) (f:politics) (w:gunman/armed man) (d:<tawipa>, the man who carries, after the word for gun: a man carrying a gun, the shooter in a report of a shooting) (r:zd:15170) (q:draft)
thautawisa = (i:1) (t:adv) (f:politics) (w:armed/carrying a gun) (d:<thau>, gun, <tawi>, carry, and the ending {-sa}, written as one word and followed by <in>: with a gun in hand, armed) (j:thau/tawi/sa) (r:zd:11378) (q:draft)
thautawite = (i:1) (t:n) (f:politics) (w:armed groups/armed men/gunmen) (d:plural of <thautawi>, one who carries a gun: armed men, and in news of Myanmar the armed groups of the ethnic peoples, {minam thautawite}) (b:thautawi) (r:ts:6525/zd:24966) (q:draft)
thaute = (i:4) (t:n) (f:politics) (w:guns/firearms/weapons) (d:<thau> in its sense of gun, with the plural <te>: guns, with words as <galkap>, {rifle} and <vanzat>; not the fat of an animal) (r:zd:14609/zd:25473/ts:301) (q:draft)
thauvan = (i:1) (t:n) (f:politics) (w:firearm/gun/weapon) (d:<thau>, here gun, with <van>, here goods: guns and the things that belong to them, firearms) (r:zd:22298/zd:15554) (q:draft)
thauvui = (i:1) (t:n) (f:politics/work) (w:gunpowder/explosive/ammunition) (d:the powder that fires a gun or makes a bomb explode; <thauvui thautang> is powder and bullets, ammunition) (r:zd:22371/zd:24532/ts:7742) (q:draft)
thauvui thautang = (i:1) (t:n) (f:politics) (w:ammunition/arms and ammunition/munitions) (d:<thauvui>, gunpowder, and <thautang>, bullet, set side by side without <leh>: ammunition, and more loosely firearms and armed force; often after <galvan>, weapons) (r:zd:22371/zd:14696) (q:draft)
thauzong = (i:1) (t:phrase) (f:politics) (w:the gun also) (d:<thau>, gun, and <zong>, also, written as one word: the gun too, even the gun) (j:thau/zong) (r:zd:20231/zd:16922) (q:draft)
thawhbaih = (i:1) (t:v) (f:everyday/time) (w:get up early/rise early) (d:<thawh>, get up, and <baih>, early, written as one word: get up early in the morning) (j:thawh/baih) (r:zd:24089/zd:25914) (q:draft)
thawhbat = (i:2) (t:n) (f:food) (w:avocado) (d:the avocado fruit, named in lists of fruits and healthy foods beside <hai>, mango, and <banla>, banana; not butter made from milk) (r:zd:20657/zd:21284) (q:draft, low confidence)
thawhciangin = (i:1) (t:phrase) (f:everyday/time) (d:<thawh>, get up, and <ciangin>, when, written as one word: when getting up from sleep) (j:thawh/ciangin) (r:zd:24276/zd:23616) (q:draft)
thawhkikni = (i:1) (t:n) (f:religion/time) (w:resurrection day/Easter) (d:<thawhkik>, rise again, with <ni>, day: the day of the resurrection of Jesus, Easter Sunday) (s:Easter) (j:thawhkik/ni) (r:zd:19052/zd:19772) (q:draft)
thawhpan = (i:1) (t:adv) (f:time/everyday) (w:from getting up/from rising) (d:<thawh>, get up, and <pan>, from, written as one word: from the time one gets up) (j:thawh/pan) (r:zd:21918) (q:draft)
thawhphet = (i:1) (t:v) (f:everyday/time) (w:just get up/as soon as one gets up) (d:<thawh>, get up, with <phet>, just, written as one word: the moment of getting up from sleep; {zingsang na thawhphet in} is as soon as you get up in the morning) (j:thawh/phet) (r:zd:25909/zd:19455) (q:draft)
thawi = (i:2) (t:v) (f:everyday) (w:get ready/prepare) (d:after <ki> written as a separate word it is the verb <kithawi>: get oneself ready for something, mostly after a verb with <ding>; it has nothing to do with searching a house) (r:zd:19518/zd:22874/zd:16757) (q:draft)
thawithawi = (i:1) (t:v) (f:everyday) (w:be getting ready/be preparing) (d:written after a detached <ki>: {ki thawithawi} is <kithawithawi>, be busy getting ready, be about to) (b:kithawi) (r:zd:15622/zd:15669) (q:draft)
thawl = (i:2) (t:v) (f:everyday) (w:pass through/fit through/get through) (d:have room to go through a gap or between things without being held back, unlike the noun {thawl}, a bottle; often followed by <thei> or <zawh>) (r:zd:24280) (q:draft, low confidence)
thawlhawm = (i:1) (t:n) (f:home) (w:empty bottle) (d:<thawl>, bottle, and <hawm>, empty, written as one word: an empty bottle, as collected and sold again) (j:thawl/hawm) (r:zd:22805/zd:21330) (q:draft)
thawlneu = (i:1) (t:n) (f:home/everyday) (w:small bottle/flask/vial) (d:<thawl>, bottle, and <neu>, small, written as one word) (j:thawl/neu) (r:zd:16434) (q:draft)
thawlnih = (i:1) (t:n) (f:food/home) (w:two bottles) (d:<thawl>, bottle, and <nih>, two, written as one word, after the name of the liquid) (j:thawl/nih) (r:zd:14824/zd:2072) (q:draft)
thawlsung = (i:1) (t:adv) (f:home/everyday) (w:in the bottle/inside a bottle) (d:<thawl>, bottle, and <sung>, in, written as one word, usually followed by <ah>: inside a bottle) (j:thawl/sung) (r:zd:20860) (q:draft)
thawmhau = (i:1) (t:adj) (f:everyday/social) (w:lonely/lonesome) (d:feeling alone and without company; {thawmhau kisa} is feel lonely) (s:lungleng) (r:zd:22715/zd:23655) (q:draft)
thawmhauna = (i:1) (t:n) (f:everyday/social) (w:loneliness) (d:<thawmhau>, lonely, with the noun suffix <na>: the state of feeling alone or empty) (b:thawmhau) (r:zd:23655) (q:draft, low confidence)
thaza = (i:1) (t:n) (f:health/food) (w:tonic/supplement/vitamin) (d:<tha>, strength, with the first part of <zatui>, medicine: something taken to build up strength, a tonic or vitamin) (r:zd:19593/zd:15857/zd:16695) (q:draft)
thazawh = (i:1) (t:v) (f:body/everyday) (w:overpower/be stronger than/manage by strength) (d:<tha>, strength, with <zawh>, overcome: be stronger than someone and overpower him, or have strength enough for a heavy task) (r:zd:16020/zd:18023) (q:draft)
thazawmcip = (i:1) (t:v) (f:body/health) (w:be utterly weak/be exhausted) (d:<thazawm>, weak, and <cip>, completely, written as one word: be completely without strength) (j:thazawm/cip) (r:zd:11083/zd:12450) (q:draft)
thazawmna = (i:1) (t:n) (f:health/body) (w:weakness/faintness) (d:<thazawm>, weak, with the noun ending <na>: lack of strength, of body or of mind) (b:thazawm) (r:zd:24530/zd:13077) (q:draft)
thazawmsak = (i:1) (t:v) (f:health/everyday) (w:weaken/make weak/enfeeble) (d:<thazawm>, weak, with the causing <sak>: make a person, a body or a power weak) (j:thazawm/sak) (r:zd:16640/zd:22771/zd:24276) (q:draft)
Thazi = (i:1) (t:name) (c:city) (f:travel) (w:Thazi) (d:a town and district in <Mandalay> Region of Myanmar) (r:ts:2288/zd:14609) (q:draft)
Thazin = (i:1) (t:name) (c:place) (f:travel) (w:Thazin) (d:Burmese name, that of an orchid; a ward of the town of Kalaymyo, and part of the name of the bus line Shwe Thazin) (o:Burmese) (r:zd:23957) (q:draft, low confidence)
thehkhia = (i:1) (t:v) (f:nature) (w:throw out/spew out/give off) (d:<theh>, sprinkle, with <khia>, out, written as one word: send out in a spray or cloud, as a volcano its ash or a flower its scent; with <ki>, be thrown out) (j:theh/khia) (r:zd:19514/zd:11776) (q:draft)
thehthang = (i:2) (t:v) (f:media/it) (w:spread/circulate/go viral) (d:with <ki.2>, as {ki thehthang}: of a photo, a video or news, spread quickly among many people, above all on social media) (r:zd:12748/zd:13022/zd:11712) (q:draft)
thehthanggawp = (i:1) (t:v) (f:media/everyday) (w:scatter everywhere/spread all over/go viral) (d:<thehthang> with <gawp>, written as one word after <ki.2>: of people or broken glass, be scattered in all directions; of a photo or a video, spread all over social media) (j:thehthang/gawp) (r:zd:13034/zd:13197/zd:12405) (q:draft)
thehthangpah = (i:1) (t:v) (f:media/it) (w:spread at once/go viral) (d:<thehthang>, scatter, and <pah>, at once, written as one word; with <ki>, of news or a video: spread quickly everywhere) (j:thehthang/pah) (r:zd:12374/zd:12945) (q:draft)
thehzak = (i:1) (t:v) (f:media/everyday) (w:scatter/spread about/strew) (d:scatter or spread over a wide area; mostly with <ki> as {ki thehzak}, the same as <kithehzak>: be scattered about, and of a video or a piece of news, be spread widely) (s:thehthang) (r:zd:17375/zd:17164/zd:17677) (q:draft)
thehzakgawp = (i:1) (t:v) (f:media/it) (w:spread widely/go viral/scatter all over) (d:<thehzak>, scatter, with <gawp>, thoroughly; with the prefix <ki>, mostly written apart, be spread everywhere, said of a video or photo that goes viral on social media; compare <kithehzak>) (j:thehzak/gawp) (r:zd:20490/zd:17886) (q:draft)
thehzakpah = (i:1) (t:v) (f:media/it) (w:spread at once/go viral) (d:written after <ki>, as {ki thehzakpah}: <kithehzak>, be scattered, with <pah>, at once; of a photo, video or piece of news, spread quickly and widely on social media) (r:zd:14981/zd:13326/zd:18125) (q:draft)
thehzaksak = (i:1) (t:v) (f:media) (w:spread/circulate/disseminate) (d:<thehzak>, scatter, and the causative <sak> written as one word: cause news or a message to spread among people; mostly after <ki>, be spread about) (j:thehzak/sak) (r:zd:17830) (q:draft)
thei = (i:1) (t:v) (f:everyday) (w:know) (d:know a person, a fact or a way; {thei kei} is not know) (a:theilo)
thei = (i:2) (t:adj) (f:everyday) (w:able/capable of/qualified to) (d:placed after a verb: able to do it, can; {thei lo} is unable) (a:theilo)
thei keng = (i:1) (t:phrase) (f:everyday) (w:I do not know/I cannot) (d:<thei>, know or be able, and <keng>, here not the verb carry but the negative <kei> run together with <ing>, the ending of the first person: I do not know, closing a sentence, often after a question clause; after another verb, I cannot) (r:zd:13217/zd:20618/zd:23281) (q:draft)
theibaih = (i:1) (t:v) (f:everyday/education) (w:understand quickly/learn fast/know early) (d:<thei>, know, with <baih>, soon or quickly, written as one word: come to know or understand a thing quickly or early) (j:thei/baih) (r:zd:13343/zd:20433) (q:draft)
theibek = (i:1) (t:v) (f:everyday) (w:can only) (d:<thei>, able, and <bek>, only, written as one word after a verb: can only do that, it is possible in that way alone) (j:thei/bek) (r:zd:20037/zd:12688) (q:draft)
theician = (i:1) (t:v) (f:everyday/education) (w:know clearly/know for certain/know exactly) (d:<thei>, know, with <cian>, clearly: know exactly; {ki theician nailo} is it is not yet known for certain) (r:zd:11564/zd:21063/zd:10939) (q:draft)
theicianlo = (i:1) (t:v) (f:everyday/media) (w:not know clearly/be unclear/be unconfirmed) (d:<thei>, know, <cian>, clearly, and <lo>, not, written as one word; in news reports {ki theicianlo hi} is it is not known for certain) (j:thei/cian/lo) (r:zd:12776/zd:12290/zd:15255) (q:draft)
theiciannuam = (i:1) (t:v) (f:everyday/politics) (w:want to know for certain/want to know exactly) (d:<theician>, know for certain, and <nuam>, want, written as one word; with <ki>, people want to know for certain) (j:theician/nuam) (r:zd:19754/zd:11289) (q:draft)
theicianzo = (i:1) (t:v) (f:everyday/media) (w:be able to know for certain/manage to identify) (d:<theician>, know exactly, and <zo>, be able, written as one word; mostly with <ki> before and <nailo> or <nawnlo> after: it cannot yet be known for certain) (j:theician/zo) (r:zd:13022/zd:14802) (q:draft)
theiciat = (i:1) (t:v) (f:everyday) (w:each know/all know) (d:<thei>, know, and <ciat>, each, written as one word: each one knows; {i theiciat hi} is we all know) (j:thei/ciat) (r:zd:26026/zd:15565) (q:draft)
theidan = (i:1) (t:n) (f:everyday) (w:way of being able to) (d:<thei>, be able, and <dan>, way, written as one word after a verb: the way in which something can be done) (j:thei/dan) (r:zd:21215) (q:draft, low confidence)
theiden = (i:1) (t:adv) (f:everyday) (w:can always/always able) (d:<thei> and <den> written as one word, placed after a verb: always able to do it, can at any time) (j:thei/den) (r:zd:20964/zd:10892) (q:draft)
theiding = (i:1) (t:v) (f:everyday) (w:will be able/can/will know) (d:<thei> and <ding> written as one word: after a verb, will be able to, so as to be able to; alone, will know) (j:thei/ding) (r:zd:22850/zd:19320/zd:24271) (q:draft)
theidinghi = (i:1) (t:v) (f:everyday) (w:will be able/can) (d:<thei>, able, and <dinghi> written as one word at the end of a sentence, after a verb: will be able to, may well) (j:thei/dinghi) (r:zd:17758/zd:12299) (q:draft)
theidingin = (i:1) (t:phrase) (f:everyday) (w:so as to be able to/in order that it can) (d:<thei> and <dingin> written as one word, placed after a verb: so that one is able to do it) (j:thei/dingin) (r:zd:15986/zd:12420) (q:draft)
theih nadingin = (i:1) (t:conj) (f:everyday) (w:so that it may be possible/in order to be able to) (d:<theih>, be able, and <nadingin>, in order to: placed after a verb, so that it can be done, in order to be able to do it; by itself after an object, so that it may be known) (r:zd:24673/zd:16779) (q:draft)
theih nadingun = (i:1) (t:conj) (f:everyday) (w:so that they can/so that they may know) (d:<theih>, know or be able, and <nadingun>, in order that, with a plural subject: placed after a verb it closes a clause of purpose, so that they can do it; after a noun as object, so that they may know it) (s:theih nadingin) (r:zd:11891/zd:22040) (q:draft)
theih nangin = (i:1) (t:conj) (f:everyday) (w:so that one can/in order to be able to) (d:<theih>, be able, with <nangin>, here a short form of <nadingin>, in order to, and not the pronoun you: placed after a verb, so that the action can be done; the same as <theih nadingin>) (r:zd:20410/zd:23935/zd:19953) (q:draft)
theihban = (i:1) (t:v) (f:everyday/education) (w:reach by knowing/grasp) (d:<theih>, know, and <ban>, reach, written as one word; {theihban zawhloh} is what knowledge cannot reach, unknown or beyond understanding) (j:theih/ban) (r:zd:20725) (q:draft, low confidence)
theihbanloh = (i:1) (t:v) (f:everyday) (w:be unaware of/not realise) (d:<theih>, <ban> and <loh> written as one word: what one's knowing does not reach, be beyond one's knowledge) (j:theih/ban/loh) (r:zd:22116) (q:draft, low confidence)
theihbat = (i:1) (t:v) (f:everyday/education) (w:know/reach by knowing) (d:<theih>, know, with <bat>, reach, written as one word: as far as knowledge reaches; {ka theihbat tanh} is as far as I know, and {theihbat loh} is what is beyond one's knowledge) (j:theih/bat) (r:zd:24231/zd:25580) (q:draft)
theihbeh = (i:1) (t:v) (f:everyday/education) (w:know more/learn more/find out more) (d:<theih>, know, with the ending {-beh}, more, in addition: come to know more; {theihbeh nop a om leh} is if anyone wishes to know more) (r:zd:16928/zd:19435) (q:draft)
theihbehhuai = (i:1) (t:adj) (f:media/everyday) (w:worth knowing further/further noteworthy) (d:<theihbeh>, know more, and <huai>, worthy of, written as one word: that is worth knowing in addition; {theihbehhuai aomte} is further things worth knowing) (j:theihbeh/huai) (r:zd:18091/zd:19745) (q:draft)
theihbehnop = (i:1) (t:v) (f:everyday/media) (w:want to know more) (d:<theihnop>, want to know, and {theih beh}, know further, written as one word: wish to know more about a matter) (r:zd:22778/zd:23155) (q:draft)
theihcian = (i:1) (t:v) (f:everyday/education) (w:know clearly/know for certain/understand fully) (d:<theih>, know, and <cian>, clearly, written as one word: know a thing exactly and for certain; {ki theihcian} is be found out for certain) (j:theih/cian) (r:zd:9429/zd:16625/zd:12906) (q:draft)
theihcianding = (i:1) (t:v) (f:everyday/education) (w:to know clearly/should understand fully) (d:<theihcian> and <ding> written as one word: what is to be known clearly, or in order that someone knows it for certain) (j:theihcian/ding) (r:zd:15004/zd:20912) (q:draft)
theihciang = (i:1) (t:phrase) (f:everyday) (d:<theih> and <ciang> written as one word: as far as is known, what one knows, or when it became known) (j:theih/ciang) (r:zd:22463/zd:14678) (q:draft, low confidence)
theihciangin = (i:1) (t:v) (f:everyday) (w:when one knows/when able to) (d:<theih> and <ciangin> written as one word: when someone comes to know something, or after another verb when it could be done) (j:theih/ciangin) (r:zd:21015/zd:13094) (q:draft)
theihcianna = (i:1) (t:n) (f:everyday/media) (w:certain knowledge/confirmation) (d:noun of <theihcian>: knowing a thing clearly and for certain; {theihcianna om lo} is nothing is known for certain) (b:theihcian) (r:zd:15833/zd:14583) (q:draft)
theihciat = (i:1) (t:v) (f:everyday) (w:each know/all know) (d:<theih>, know, with <ciat>, each, written as one word: known to each one; {i theihciat} is what we all know) (j:theih/ciat) (r:zd:17577/zd:22364) (q:draft)
theihcil = (i:1) (t:v) (f:everyday) (w:first know/first notice) (d:<theih> and <cil> written as one word: the first knowing of a thing, when it is first noticed; {ka theihcil akipan} is since I first knew, as long as I remember) (j:theih/cil) (r:zd:16259/zd:14587) (q:draft)
theihdan = (i:1) (t:n) (f:everyday/education) (w:understanding/way of knowing) (d:<theih>, know, and <dan>, way, written as one word: the way someone knows or understands a thing, what one knows of it; {ka theihdan} is as far as I know) (j:theih/dan) (r:zd:25139/zd:19431) (q:draft)
theihding = (i:1) (t:v) (f:everyday/education) (w:to know/be able to) (d:<theih> and <ding> written as one word: what is to be known, things one should know; after another verb, so as to be able to) (j:theih/ding) (r:zd:20035/zd:23108/zd:25932) (q:draft)
theihdingin = (i:1) (t:phrase) (f:everyday/media) (w:for the information of/so as to know) (d:<theih>, know, and <dingin>, in order to, written as one word: so that someone may know, placed after those who are to know) (j:theih/dingin) (r:zd:20466/zd:17735) (q:draft)
theihhuai = (i:1) (t:adj) (f:everyday/media) (w:worth knowing/good to know/noteworthy) (d:<theih>, know, and <huai>, worthy of, written as one word: that ought to be known; {a theihhuai} is the things worth knowing) (j:theih/huai) (r:zd:11702/zd:20595/zd:16949) (q:draft)
theihhuaisa = (i:1) (t:v) (f:everyday/media) (w:consider worth knowing/think noteworthy) (d:<theihhuai>, worth knowing, with <sa>, consider: find that something ought to be known and therefore tell it) (r:zd:12932/zd:14820) (q:draft)
theihi = (i:1) (t:v) (f:everyday) (w:can/be able/be possible) (d:<thei>, able, and the sentence-final <hi> written as one word after a verb: closes a statement that something can be done or may happen) (j:thei/hi) (r:zd:22695/zd:12736/zd:11251) (q:draft)
theihiam = (i:1) (t:phrase) (f:everyday) (d:<thei>, can, and the question particle <hiam> written as one word: could it, how could it; closes an indirect question, as in {banghangin puakkham theihiam}, why it could explode) (j:thei/hiam) (r:zd:11897/zd:22717) (q:draft)
theihkei = (i:1) (t:v) (f:everyday) (w:cannot/be unable) (d:<theih>, be able, and the negative <kei> written as one word, after a verb and mostly before <leh>, if: {theihkei leh} is if one cannot) (j:theih/kei) (r:zd:25932/zd:20875/zd:20801) (q:draft)
theihkhialh = (i:1) (t:v) (f:everyday) (w:misunderstand/be mistaken/know wrongly) (d:<theih>, know, and <khialh.2>, wrongly, written as one word: understand wrongly; {ka theihkhialh kei leh} is if I am not mistaken) (j:theih/khialh) (r:zd:15234/zd:23797) (q:draft)
theihkhiatna = (i:1) (t:n) (f:everyday/education) (w:finding out/discovery/detection) (d:<theihkhiat>, find out, with the noun suffix <na>: the act of finding out or coming to know something) (b:theihkhiat) (r:ts:5105/zd:20729) (q:draft)
theihkhit = (i:2) (t:v) (f:everyday) (w:have been able to/have managed to) (d:after another verb, <theih>, form of <thei>, can, with <khit>, finished: the action has been achieved, as in {aphelh theihkhit uhciangin}, after they were able to put it out; not the verb know of the other sense) (r:zd:20668/zd:20446) (q:draft)
theihlawh = (i:1) (t:v) (f:everyday/social) (w:come to know/get to know/learn of) (d:<theih>, know, with <lawh>, here gain as a result: come to know something through an event or through someone; {ki theihlawh} is get acquainted with one another) (b:theih) (r:zd:11083/zd:17097/zd:13133) (q:draft)
theihleh = (i:1) (t:v) (f:everyday) (w:if able/if possible) (d:<theih> and <leh> written as one word: if one can; {ahih theihleh} is if possible) (j:theih/leh) (r:zd:19846/zd:22543) (q:draft)
theihlo = (i:1) (t:v) (f:everyday) (w:not know/unknown) (d:<theih> know and <lo> not written as one word: not knowing, not known, without someone knowing) (j:theih/lo) (r:zd:23479/zd:12096) (q:draft)
theihloh = (i:1) (t:v) (f:everyday) (w:not know/be unable/cannot) (d:<theih> and <loh> written as one word, the form of {thei lo} used before a noun or <ding>: after a verb, that cannot be done; alone, not knowing or what is not known) (j:theih/loh) (r:zd:23896/zd:24186/zd:23882) (q:draft)
theihloh kalin = (i:1) (t:adv) (f:everyday) (w:unawares/without noticing/before one knows it) (d:<theihloh>, not knowing, and <kalin>, while: while one does not know or notice, unawares; stands at the head of a clause or after a subject marker, as in {i theihloh kalin}, without our noticing) (r:zd:20264/zd:24217/zd:24375) (q:draft)
theihlohding = (i:1) (t:v) (f:everyday) (w:so as not to know/so as not to be able) (d:<theihloh> and <ding> written as one word after a verb: so that it is not known or cannot be done, as in {amuh theihlohding in}, so that he or she could not see) (j:theihloh/ding) (r:zd:17357/zd:14543) (q:draft)
theihlohkal = (i:1) (t:adv) (f:everyday) (w:unawares/without knowing/unnoticed) (d:<theih>, know, <loh>, not, and <kal>, interval, written as one word: while someone does not know or notice; after a possessive and before <in>, as in {na theihlohkal in}, without your noticing) (j:theih/loh/kal) (r:zd:22474/zd:14792) (q:draft)
theihlohman = (i:1) (t:conj) (f:everyday) (w:because of not knowing/out of ignorance) (d:<theih> and <lohman> written as one word: because one does not know, or what comes only from not knowing) (j:theih/lohman) (r:zd:17344/zd:23929) (q:draft)
theihlohna = (i:2) (t:n) (f:everyday/health) (w:inability/being unable) (d:after a verb, where <theih> means can and not know: not being able to do what that verb says, as {ihmut theihlohna}, being unable to sleep, and {lungkim theihlohna}, being unable to be content) (r:zd:21869/zd:19943/zd:25928) (q:draft)
theihlohnate = (i:1) (t:n) (f:everyday) (w:inabilities/things one cannot do) (d:plural of <theihlohna>; after a verb it names the things one is not able to do, as {na hih theihlohnate}, the things you cannot do) (b:theihlohna) (j:theihlohna/te) (r:zd:20699/zd:17672) (q:draft)
theihluat = (i:1) (t:v) (f:everyday) (w:know very well/know so much) (d:<theih>, know or be able, and <luat>, so very, written as one word: know something only too well; in some sentences be very possible) (j:theih/luat) (r:zd:24396) (q:draft, low confidence)
theihma = (i:2) (t:adv) (f:everyday) (w:before knowing/before learning) (d:<theih> in the sense know, with <ma> before: before one knew or came to know a thing, after a pronoun such as <a> or <i> and not after another verb; followed by <in> or {pek-pan}) (r:zd:20769/zd:20924) (q:draft)
theihna = (i:3) (t:n) (f:everyday) (w:ability/possibility/means) (d:<thei>, can, with the noun ending, after another verb: being able to do it; {theihna ding} or <theihna dingin> is so that it can be done, and {theihna lampi} is a way to do it) (r:zd:19201/zd:23487/zd:17672) (q:draft)
theihna dingin = (i:1) (t:conj) (f:everyday) (w:so that it may be possible/in order to be able to) (d:<theihna>, here being able, and <dingin>, in order to: placed after a verb, so that it can be done; another way of writing <theih nadingin>) (r:zd:22151/ts:5396) (q:draft)
theihna dingun = (i:1) (t:conj) (f:everyday) (w:so that they can/in order that they may) (d:<theihna>, here not knowledge but <thei>, be able, with <na>, and <dingun>, for them to: placed after a verb with <a> before it, so that they may be able to do it) (r:zd:23191/zd:22849) (q:draft)
theihnading = (i:1) (t:phrase) (f:everyday) (w:so as to be able to/in order to know) (d:<theih> and <nading> written as one word: after a verb, so that it can be done, in order to be able to; after a noun, in order to know it) (j:theih/nading) (r:zd:17527/zd:23590/zd:15035) (q:draft)
theihnadingin = (i:1) (t:phrase) (f:everyday) (w:so that it can/in order to be able to) (d:<theihnading> and <in> written as one word after a verb: so that the action can be done) (j:theihnading/in) (r:zd:17374/zd:15833) (q:draft)
theihnang = (i:1) (t:phrase) (f:everyday) (w:so that one can/in order to be able) (d:<theih>, be able, with <nang>, a short form of <nading>, written as one word after a verb: so that it can be done, in order to be able to) (j:theih/nading) (r:zd:11224/zd:14615/zd:16428) (q:draft)
theihnate = (i:2) (t:n) (f:everyday/work) (w:abilities/capabilities/being able to) (d:after a verb, <theih> in its meaning can: the things one is able to do, or the possibility of doing them, as {hih theihnate}, what one can do, and {sepkhop theihnate}, being able to work together; not what one knows) (r:zd:11714/zd:10726) (q:draft)
theihngeiloh = (i:1) (t:adj) (f:everyday) (w:never known before/unknown/unfamiliar) (d:<theihngei>, have ever known, with <loh>, not, written as one word before a noun: that one has never known) (j:theihngei/loh) (r:zd:12561/zd:21837) (q:draft)
theihnopleh = (i:1) (t:phrase) (f:everyday) (w:if one wants to know) (d:<theihnop>, want to know, and <leh>, if, written as one word; mostly {na theihnopleh}, if you want to know) (j:theihnop/leh) (r:zd:19578/zd:15724) (q:draft)
theihnoploh = (i:1) (t:v) (f:everyday/education) (w:not want to know/unwillingness to know) (d:<theihnop> and <loh> written as one word: not wanting to know, set against <theihloh>, not knowing) (j:theihnop/loh) (r:zd:20172/zd:22171) (q:draft)
theihpah = (i:2) (t:v) (f:everyday) (w:know at once/realize at once) (d:<theih> in its meaning know, not able, with <pah> at once: understand a thing immediately; the thing known stands before it, often ending in <lam>, and no other verb comes directly before {theihpah}) (r:zd:14498) (q:draft, low confidence)
theihpak = (i:1) (t:v) (f:everyday) (w:know right away/be able right away) (d:<theih>, know or be able, and <pak>, quickly, written as one word: know offhand, or be able to do at once) (j:theih/pak) (r:zd:20697/zd:21063) (q:draft, low confidence)
theihpen = (i:1) (t:phrase) (f:everyday) (w:being able to/what can be) (d:<theih>, be able or know, and the topic marker <pen> written as one word: the fact of being able to do something, or what one knows, taken as the topic) (j:theih/pen) (r:zd:17899/zd:20516) (q:draft, low confidence)
theihpen = (i:2) (t:adv) (f:everyday) (j:theipen) (r:ts:3125/zd:24801) (q:draft)
theihphet = (i:1) (t:v) (f:everyday) (w:as soon as known/the moment it is known) (d:<theih>, know, and <phet>, as soon as, written as one word: {aki theihphet in} is as soon as it became known) (j:theih/phet) (r:zd:14678) (q:draft, low confidence)
theihpih = (i:3) (t:v) (f:politics/social) (w:recognize/acknowledge) (d:of a government or other authority: accept a body or a person as lawful and registered; {kumpi theihpih} before a noun is recognized by the government) (r:zd:25572/zd:16052) (q:draft)
theihpihlo = (i:1) (t:v) (f:social/everyday) (w:not understand/not be aware of) (d:<theihpih> and <lo>, not, written as one word: not know a matter along with someone, not understand what a person feels or does) (j:theihpih/lo) (r:zd:14883) (q:draft, low confidence)
theihpihloh = (i:1) (t:adj) (f:politics/everyday) (w:unrecognized/not acknowledged/without the knowledge of) (d:<theihpih>, know of or recognize, with <loh>, not, written as one word: not known of or not recognized by the one named before it, as in {kumpi theihpihloh}, not recognized by the government) (j:theihpih/loh) (r:zd:25115/zd:9454) (q:draft)
theihpihna = (i:1) (t:n) (f:social/politics) (w:recognition/acknowledgement/approval) (d:<theihpih> with the noun suffix {-na}: official recognition or acknowledgement, as given by a government) (b:theihpih) (r:zd:26565/zd:15637) (q:draft)
theihsa ciat = (i:1) (t:phrase) (f:everyday) (w:as we all know/known to everyone) (d:<theihsa>, already known, and <ciat>, each one: a thing that every one of us already knows; it follows <i> or <ih>, we, and closes a statement with {ahi hi}, or opens one as {ih theihsa ciat mah bang in}, just as we all know) (r:zd:24165/zd:16651) (q:draft)
theihsa tek = (i:1) (t:phrase) (f:everyday/media) (w:as we all know/known to everyone) (d:<theihsa>, already known, and <tek>, each one: what each of us already knows; stands after <i> or <ih>, we, and mostly before {mah bangin} or <mahbangin>, just as, to open a statement with a fact the reader knows) (r:zd:18171/zd:17275) (q:draft)
theihsakding = (i:1) (t:v) (f:media/social) (w:should inform/to make known) (d:<theihsak>, make known, and <ding> written as one word: to inform, that someone is to be told, often before <kisam>, it is necessary) (j:theihsak/ding) (r:zd:11285/zd:21601) (q:draft)
theihsaknopna = (i:1) (t:n) (f:media/social) (w:wish to inform/intention to make known) (d:<theihsaknop>, want to make known, with the noun suffix <na>: the purpose of letting people know) (j:theihsaknop/na) (r:zd:14686) (q:draft)
theihsasa = (i:1) (t:adj) (f:everyday/social) (w:already known/once known) (d:<theih>, know, with <sasa>, already, written as one word: what or who was already known before) (j:theih/sasa) (r:zd:22136) (q:draft, low confidence)
theihsawm = (i:1) (t:v) (f:everyday/education) (w:try to know/seek to understand/find out) (d:<theih> and <sawm>, intend, written as one word: make an effort to know or learn about something) (j:theih/sawm) (r:zd:21869/zd:21063/zd:23191) (q:draft)
theihsiam = (i:1) (t:v) (f:everyday/social) (w:understand/appreciate/be understanding) (d:<theih>, know, with <siam>, skilled: grasp a matter rightly, or understand a person's situation with sympathy) (r:zd:21664/zd:25923/zd:20789) (q:draft)
theihsun = (i:1) (t:phrase) (f:everyday) (w:as far as one knows/what one knows) (d:<theih>, know, with the ending {-sun}, the full extent, after <ka>, <na> or a pronoun: all that one knows, as far as one knows; {ka theihsun tawm} is the little that I know) (b:theih) (r:zd:17725/zd:15514) (q:draft)
theihte = (i:3) (t:n) (f:everyday/education) (w:what one knows/things known/those known) (d:<theih>, know, with plural <te>, after <a> or <ka> and not after another verb: the things or the people that someone knows or has learned, where {nek theihte} is of what can be done) (r:zd:24933/zd:25687/zd:20410) (q:draft)
theihtek = (i:1) (t:v) (f:everyday) (w:each know/all know) (d:<theih>, know, and <tek>, each, written as one word: each one knows, every one of us knows) (j:theih/tek) (r:zd:23129/zd:23929) (q:draft)
theihthamloh = (i:1) (t:adv) (f:everyday) (w:unnoticed/without being noticed) (d:<theih>, know, and <thamloh> written as one word, followed by <in>: without the other person noticing it) (j:theih/thamloh) (r:zd:23985) (q:draft, low confidence)
theihtheih = (i:3) (t:v) (f:everyday) (w:know well/be familiar with) (d:<theih>, know, said twice: know as a matter of common knowledge, not be able to know; {i theihtheih sa} is what we all know already) (r:zd:19663/zd:17106/zd:22371) (q:draft)
theihtuak = (i:1) (t:adj) (f:everyday/media) (w:worth knowing/that ought to be known) (d:<theih>, know, and <tuak>, be fitting, written as one word: that people should know or have a right to know) (j:theih/tuak) (r:zd:21137/zd:12096) (q:draft)
theihuai = (i:1) (t:adj) (f:everyday/education) (w:worth knowing/noteworthy) (d:<thei>, know, with <huai>, worthy of, written as one word: that ought to be known) (j:thei/huai) (r:zd:20477) (q:draft, low confidence)
theihzawh = (i:2) (t:v) (f:social/time) (w:have known each other for/be acquainted since) (d:after <ki> and before a length of time: the time since two people came to know each other, as {kaki theihzawh uh kum 20}, we have known each other for 20 years; here <zawh> means since and not be able) (r:zd:11545/zd:12217/zd:13188) (q:draft)
theihzia = (i:1) (t:n) (f:everyday/education) (w:way of being able/how one can) (d:<theih>, be able, and <zia>, way, written as one word after a verb: the way in which something can be done) (j:theih/zia) (r:zd:17348) (q:draft)
theiin = (i:1) (t:v) (f:everyday) (w:knowing/being aware of) (d:<thei>, know, and the linking <in>, written as one word: knowing it, and so doing what follows) (j:thei/in) (r:zd:9448/zd:9433) (q:draft)
theiin = (i:2) (t:v) (f:everyday) (w:being able to/managing to) (d:<thei>, be able, and the linking <in>, written as one word after a verb: the action could be done, and what follows resulted) (j:thei/in) (r:zd:20389) (q:draft, low confidence)
theikei = (i:1) (t:v) (f:everyday) (w:cannot/be unable) (d:<thei>, able, and <kei>, not, written as one word and placed after a verb: cannot, is not able to) (j:thei/kei) (r:zd:12510/zd:22922/zd:24276) (q:draft)
theikeng = (i:1) (t:v) (f:everyday) (w:I do not know/I cannot) (d:<thei> with the ending {-keng}, the negative of the first person singular, written as one word: I do not know; after a verb, I cannot) (r:zd:15243/zd:19665/zd:13149) (q:draft)
theikhalo = (i:1) (t:v) (f:everyday) (w:not know/be unaware/not notice) (d:<theikha> and <lo> written as one word: not come to know of something, be unaware of it) (j:theikha/lo) (r:zd:19871/zd:15715/zd:24420) (q:draft)
theikhial = (i:1) (t:v) (f:everyday) (w:misunderstand/mistake/take wrongly) (d:<thei>, know, and <khial>, wrongly, written as one word: understand or take something wrongly; {ki theikhial} is be mistaken for or wrongly held to be so) (j:thei/khial) (r:zd:20176/zd:12835) (q:draft)
theikhiapan = (i:1) (t:v) (f:everyday) (w:come to know/find out) (d:<theikhia> with <pan>, here only then, written as one word: came to know at that point, found out for the first time) (j:theikhia/pan) (r:zd:15922/zd:12285) (q:draft)
theikhin = (i:2) (t:v) (f:everyday) (w:have been able to/have managed to) (d:after another verb, <thei>, be able, with <khin>, already: the action has already been achieved, as in {kikankhia theikhin}, has already been found out; here <thei> is not know) (r:zd:15568/zd:13295) (q:draft)
theikhollo = (i:1) (t:v) (f:everyday) (w:not know beforehand/not know in advance) (d:<theikhol>, know beforehand, and <lo>, not, written as one word, often after <bangmah>, nothing) (j:theikhol/lo) (r:zd:19215/zd:16696) (q:draft)
theilai = (i:2) (t:v) (f:everyday) (w:still know/still remember) (d:<thei.1>, know, with <lai>, still, after a subject marker such as <na>: still know or remember something; not the {theilai} that follows another verb and means still able) (r:zd:26097/zd:23204) (q:draft, low confidence)
theilaiding = (i:1) (t:v) (f:everyday) (w:will still be able to/may still) (d:<thei>, able, and <laiding> written as one word after a verb: will still be able to, may yet) (j:thei/laiding) (r:zd:14842/zd:20257) (q:draft)
theile = (i:1) (t:v) (f:everyday) (w:if able/if one can) (d:<thei>, able, and <le>, if, written as one word after a verb: if one can do it; before <uhcin> it is a polite wish, if you could) (j:thei/le) (r:zd:22830/zd:20257) (q:draft)
theilecin = (i:1) (t:phrase) (f:everyday) (w:if you can/if you are able to) (d:<thei>, able, and <lecin>, if you, written as one word after a verb) (j:thei/lecin) (r:zd:24276/zd:21075) (q:draft)
theileh = (i:1) (t:phrase) (f:everyday) (w:if able/if possible) (d:<thei> and <leh> written as one word after a verb: if it can be done; {hi theileh} is if possible) (j:thei/leh) (r:zd:21298/zd:24276) (q:draft)
theilel = (i:1) (t:v) (f:everyday) (w:can simply/can just) (d:<thei>, can, with <lel>, merely, written as one word after a verb: can do it just like that, with nothing more needed) (j:thei/lel) (r:zd:18927/zd:21918) (q:draft)
theileng = (i:1) (t:v) (f:everyday) (w:if we can/if we know) (d:<thei>, know or be able, and <leng>, if, written as one word: after a verb, if we could do it; alone, if we know; often followed by a statement that this would be good) (j:thei/leng) (r:zd:19516/zd:21056/zd:15554) (q:draft)
theiloding = (i:1) (t:v) (f:everyday/politics) (w:will not be able/cannot) (d:<theilo>, unable, and <ding> written as one word after a verb: will not be able to, is not to; with <in>, so that one cannot) (j:theilo/ding) (r:zd:16061/zd:19231/zd:20394) (q:draft)
theiloh = (i:2) (t:adj) (f:social) (w:unknown/unfamiliar) (d:<thei>, know, with the negative <loh>, placed before a noun: that one does not know, as {theiloh mite}, people one does not know; the other sense follows a verb and means that cannot be done) (r:zd:20537) (q:draft, low confidence)
theiloin = (i:1) (t:adv) (f:everyday) (w:without knowing/unable to) (d:<thei>, know or be able, with <loin>, without, written as one word: without knowing, and after a verb without being able to do it) (j:thei/loin) (r:zd:14824/ts:6004/zd:25477) (q:draft)
theiloliang = (i:1) (t:adj) (f:everyday) (w:not even able/unable even) (d:<theilo>, unable, with <liang>, even, written as one word after a verb: so much that one cannot even do it; with a clause before it, not even know) (j:theilo/liang) (r:zd:18911/zd:17818) (q:draft)
theilote = (i:2) (t:n) (f:everyday) (w:those who cannot/those unable to) (d:<theilo.1> unable with the plural <te>, placed after a verb: the people who are not able to do what the verb says, as {laisim theilote}, those who cannot read) (b:theilo) (r:zd:22095/zd:24276/zd:24480) (q:draft)
theilua = (i:1) (t:adj) (f:everyday) (w:very possible/can well/can easily) (d:<thei>, able, and <lua>, very much, written as one word after a verb: it can very well happen or be done; after <hong> it can also be <thei>, know: know very well) (j:thei/lua) (r:zd:24411/zd:24638) (q:draft)
theimah = (i:1) (t:v) (f:everyday) (w:can indeed/may well/surely know) (d:<thei>, know or be able, and the emphatic <mah> written as one word: can certainly, may well; of knowing, know indeed) (j:thei/mah) (r:zd:23784/zd:23977) (q:draft)
theimahmah = (i:1) (t:v) (f:everyday) (w:can very well/know well) (d:<thei> and <mahmah> written as one word: after a verb, be very able to or very apt to; alone, know very well) (j:thei/mahmah) (r:zd:16608/zd:16308) (q:draft)
theimai = (i:1) (t:adv) (f:everyday) (w:may well/can simply) (d:<thei>, can, and <mai>, simply, written as one word after a verb: it can simply be so, it may well happen) (j:thei/mai) (r:zd:11809/zd:15358) (q:draft)
theimawk = (i:1) (t:v) (f:everyday) (w:can/may well) (d:<thei> and <mawk> written as one word after a verb: can, may even, said of something surprising or not expected) (j:thei/mawk) (r:zd:17152/zd:23977) (q:draft)
Thein = (i:1) (t:num) (f:work) (w:hundred thousand/lakh) (d:the Burmese unit of one hundred thousand, used in counting money and people: {Thein 2} is 200,000; also a part of Burmese personal names) (o:Burmese, thein) (r:zd:24322/zd:24691) (q:draft)
theina = (i:1) (t:n) (f:everyday) (w:ability/possibility/means) (d:<thei>, able, with the noun suffix <na>, placed after a verb: being able to do it, or the place or way in which it can be done; {khawl theina ding} is so as to be able to stop) (b:thei) (r:zd:14650/zd:22524) (q:draft)
theinai = (i:1) (t:v) (f:everyday) (w:be able yet) (d:<thei>, able, and <nai>, yet, written as one word and followed by <kei> or <lo>: not yet able to, cannot yet) (j:thei/nai) (r:zd:25111/zd:24140) (q:draft)
theinailo = (i:1) (t:v) (f:everyday) (w:not yet know/not yet be able) (d:<thei> and <nailo> written as one word: not know yet; after another verb, not yet be able to, as in {gencian theinailo}, cannot yet say for certain) (j:thei/nailo) (r:zd:17326/zd:23984/zd:17750) (q:draft)
theinawn = (i:1) (t:v) (f:everyday) (w:can any longer/know any more) (d:<thei> and <nawn> written as one word, followed by a negative such as <lo> or <kei>: can no longer, or no longer know) (j:thei/nawn) (r:zd:23896/zd:23136/zd:20997) (q:draft)
theinawnlo = (i:1) (t:v) (f:everyday) (w:can no longer/be no longer able) (d:<thei> and <nawnlo> written as one word after a verb: can no longer do it; standing alone, no longer know) (j:thei/nawnlo) (r:zd:20854/zd:19671/zd:20725) (q:draft)
theinawnloding = (i:1) (t:v) (f:everyday) (w:will no longer be able) (d:<theinawnlo> and <ding> written as one word after a verb: will not be able to do it any more) (j:theinawnlo/ding) (r:zd:12261/zd:14877) (q:draft)
theingei = (i:1) (t:v) (f:everyday) (w:have known/know from before) (d:<thei>, know, with <ngei>, ever, written as one word: have known or experienced before; {ki theingei} is have known each other before) (j:thei/ngei) (r:zd:15807/zd:20627) (q:draft)
theinuamta = (i:1) (t:v) (f:everyday) (w:want to know) (d:<theinuam> and <ta> written as one word; found in {a theinuamta ding in}, for those who want to know) (j:theinuam/ta) (r:zd:16040) (q:draft, low confidence)
theipahding = (i:1) (t:v) (f:everyday) (w:will be able at once/will know at once) (d:<theipah> and <ding> written as one word: will know a thing at once; after another verb, will be able to do it straight away) (j:theipah/ding) (r:zd:12990/zd:13102) (q:draft)
theipak = (i:1) (t:v) (f:everyday) (w:be able right away/know at once) (d:<thei>, be able or know, with <pak>, quickly or for now, written as one word: can readily happen or be done, can be said for the moment, or notice in time) (j:thei/pak) (r:zd:11761/zd:15487) (q:draft, low confidence)
theipaklo = (i:1) (t:v) (f:everyday) (w:not know at once/not be able right away) (d:<thei> and <paklo> written as one word: not know straight away, as in {acihnading theipaklo}, not know at once what to do; after another verb, not be able to do it readily) (j:thei/paklo) (r:zd:15056/zd:15178/zd:11752) (q:draft)
theipan = (i:1) (t:v) (f:everyday) (w:only then can/only then know/come to know) (d:<thei>, know or be able, with <pan>, here only then, written as one word: only at that point come to know, or become able to do what the verb before it says) (j:thei/pan) (r:zd:17622/zd:13155/zd:21286) (q:draft)
theipanding = (i:1) (t:v) (f:everyday/time) (w:will only then be able/can only after that) (d:<thei>, <pan> and <ding> written as one word after a verb: will be able to do it only then, not before the time or condition just named) (j:thei/pan/ding) (r:zd:18054/zd:21968) (q:draft)
theipen = (i:1) (t:adv) (f:everyday) (w:as much as possible/the most that can be) (d:<thei> able with the superlative ending {-pen}, most, written as one word after a describing word and usually followed by <in>: as much so as possible, as in {ahoih theipen in}, as well as possible) (j:thei/pen) (r:zd:15642/zd:15671/zd:13181) (q:draft)
theipha = (i:1) (t:v) (f:everyday) (w:be well able/may well/manage to) (d:<thei>, be able, with <pha>, written as one word after a verb: well able to, quite likely to, or just manage to do it) (r:zd:21864/zd:25914) (q:draft, low confidence)
theipipi = (i:1) (t:adv) (f:everyday) (w:knowingly/wittingly) (d:<thei> and <pipi> written as one word: while knowing it, in spite of knowing; often followed by <mah> or <in>) (j:thei/pipi) (r:zd:12835/zd:23148) (q:draft)
theipuam = (i:2) (t:n) (f:food/nature) (w:produce/fruit/fruit and vegetables) (d:fruit and garden produce of every kind, as the second half of the pairs {anteh theipuam}, vegetables and fruit, and {singgah theipuam}, fruit of all kinds; not only the unripe fruit of the first sense) (r:zd:17722/zd:21510/zd:25075) (q:draft)
theisaknuam = (i:1) (t:v) (f:everyday/media) (w:want to inform/wish to make known) (d:<theisak>, make known, and <nuam>, want, written as one word; {kong theisaknuam uhhi} is we wish to let you know) (j:theisak/nuam) (r:zd:15445/zd:13096) (q:draft)
theisam = (i:1) (t:v) (f:everyday) (w:manage to/be able after all) (d:<thei>, able, with a softening second part, after a verb: be able to do it after all or to some degree; {theisam lo} is not really able either) (r:zd:22364/zd:22178) (q:draft, low confidence)
theisiam = (i:1) (t:v) (f:everyday/social) (w:understand/be understanding) (d:<thei> know with <siam> skilled: understand well what someone means or feels, and so bear with him) (r:zd:23556/zd:25916/zd:21313) (q:draft)
theisuak = (i:1) (t:v) (f:everyday) (w:come to be able/can as a result) (d:<thei>, be able or know, with <suak> written as one word, placed after a verb: come to be able, can then or still be done) (j:thei/suak) (r:zd:23910/zd:24242) (q:draft, low confidence)
theitading = (i:1) (t:v) (f:everyday) (w:will now be able/can now) (d:<thei> and <tading> written as one word after a verb: will now be able to, can from now on) (j:thei/tading) (r:zd:16515/zd:15816) (q:draft)
theitek = (i:1) (t:v) (f:everyday) (w:each know/all know) (d:<thei>, know, and <tek>, each, written as one word: every one of them knows) (j:thei/tek) (r:zd:25342/zd:25909) (q:draft)
theitel = (i:1) (t:v) (f:everyday/education) (w:understand/know fully/discern) (d:know a matter clearly and completely) (s:teltheih/tel) (q:draft)
theithei = (i:2) (t:adv) (f:everyday) (w:as possible/as much as possible) (d:placed after a word of quality or amount, as in {a manlang theithei in}, as quickly as possible, and {a tam theithei}, as many as possible: to the highest degree that can be reached) (r:zd:21232/zd:23249/zd:24202) (q:draft)
theithei dingin = (i:1) (t:adv) (f:everyday) (w:as much as possible/as far as possible) (d:<theithei>, <thei>, able, said twice, as far as can be, and <dingin>, so as to: stands after <a> and a word of quality or state and means so that it is as much so as possible; {a sawt theithei dingin} is for as long as possible) (r:ts:3125/zd:20264/zd:21989) (q:draft)
theitheiding = (i:1) (t:v) (f:everyday) (w:as much as possible/as far as can be) (d:<theithei>, as far as can be, and <ding> written as one word after a verb: so that it may be so as much as possible, as in {ahoih theitheiding}, to be as good as possible) (j:theithei/ding) (r:zd:15239/zd:17735) (q:draft)
theituan = (i:1) (t:v) (f:everyday) (w:know/be able) (d:<thei>, know or be able, with <tuan> written as one word, used before a negative: {theituan lo} is not know either, not know or notice any more than before) (j:thei/tuan) (r:zd:25916/zd:17685) (q:draft)
theituanlo = (i:1) (t:v) (f:everyday) (w:be unable after all/not know) (d:<thei>, know or be able, <tuan> and <lo>, not, written as one word: not be able even so, in spite of trying; {acihnading theituanlo} is not knowing what to do) (j:thei/tuan/lo) (r:zd:21341/zd:18054/zd:20859) (q:draft)
theitui = (i:1) (t:n) (f:food) (w:fruit juice/juice) (d:the juice of fruit as a drink; <thei> here is fruit in general, not only the fig) (r:zd:16216/zd:10674) (q:draft)
theivetlo = (i:1) (t:v) (f:everyday) (w:not know at all/know nothing of) (d:<thei>, know, and <vetlo>, not at all, written as one word) (j:thei/vetlo) (r:zd:17232/zd:23479) (q:draft)
theivetlo = (i:2) (t:v) (f:everyday) (w:cannot at all/be quite unable) (d:<thei>, able, and <vetlo>, not at all, written as one word after a verb: not able to do it at all) (j:thei/vetlo) (r:zd:13233) (q:draft, low confidence)
theizah = (i:1) (t:phrase) (f:everyday) (w:as much as possible/as many as can) (d:<thei>, able, and <zah>, amount, written as one word after a verb: the amount or number that is possible; {ahih theizah} is as much as possible) (j:thei/zah) (r:zd:23198/zd:24365) (q:draft)
theizahin = (i:1) (t:adv) (f:everyday) (w:as far as possible/as much as one can) (d:<thei>, able, with <zahin>, as much as, written as one word; after <ahi>: {ahi theizahin} is as far as possible) (j:thei/zahin) (r:zd:10742/zd:20545) (q:draft)
theizel = (i:1) (t:adv) (f:everyday) (w:sometimes/at times/tend to) (d:<thei>, can, and <zel>, repeatedly, written as one word after a verb: it can happen now and again, it tends to happen) (j:thei/zel) (r:zd:14954/zd:13007) (q:draft)
thek = (i:1) (t:v) (f:everyday) (w:prop/wedge/support) (d:hold a thing up or steady from below, as a small stone wedged under a big one; known here from the proverb that even a big stone is propped by a small stone) (r:zd:23554) (q:draft, low confidence)
thelnah = (i:1) (t:n) (f:social/media) (w:letter) (d:word of songs and poetic letters for a letter that someone sends, as in {na thelnah}, your letter; in one story it seems to name leaves by the path) (r:zd:20351/zd:20280) (q:draft, low confidence)
thelthal = (i:1) (t:adv) (f:body/everyday) (d:descriptive word placed after a verb or describing word, used of hair: dry, loose and untidy, sticking out in all directions) (r:zd:19330/zd:9425) (q:draft, low confidence)
themcikcik = (i:1) (t:adv) (f:everyday) (w:a tiny bit/very little/little by little) (d:<them>, a bit, and <cikcik>, tiny, written as one word: only a very small amount; of movement, only a little at a time) (s:themcik) (j:them/cikcik) (r:zd:17067/zd:14822) (q:draft)
themciklik = (i:1) (t:adv) (f:everyday) (w:narrowly/by a hair/only just) (d:<themcik>, a little, with an intensifying ending: by the very least bit, said of a narrow escape) (b:themcik) (r:zd:14799/zd:18181) (q:draft)
themcilik = (i:1) (t:n) (f:everyday) (w:tiny bit/particle) (d:a very small piece or amount of something; also after a noun, very small, as in {letsong themcilik}, a small gift) (b:them) (r:zd:24355) (q:draft, low confidence)
themneng = (i:1) (t:n) (f:everyday) (w:fragment/small piece/bit/debris) (d:small broken pieces or scraps of something; {vanleng themneng} is the wreckage of an aircraft) (s:them/neng) (r:zd:13039/zd:11941) (q:draft)
themvei = (i:1) (t:n) (f:time) (w:short while/little while/moment) (d:<them>, a bit, with <vei>, time: a short stretch of time, used with <sung>, within, or {khit ciangin}, after) (s:tawmvei) (r:zd:15474/zd:22683) (q:draft)
Thenzang = (i:1) (t:name) (c:khua) (f:social/nature) (w:Thenzang) (d:a Zomi village, named together with Vongmual and Kahgen) (r:zd:10863/zd:10860) (q:draft, low confidence)
theologian = (i:1) (t:n) (f:religion/education) (w:theologian) (d:a scholar of theology, one learned in the things of God) (o:English) (r:zd:22873) (q:draft)
theology = (i:1) (t:n) (f:religion/education) (w:theology) (d:the study and teaching of God and of religious belief, explained in the articles as {Pasian thu}; also in names of degrees and schools) (o:English) (r:zd:13066/zd:23432) (q:draft)
theory = (i:1) (t:n) (f:education) (w:theory) (d:a set of ideas that explains something; writers often put it beside <ngaihsutna> to make the meaning clear) (s:ngaihsutna) (o:English) (r:zd:16615/zd:24289/zd:22683) (q:draft)
ThePaper = (i:1) (t:name) (f:media) (w:The Paper) (d:a Chinese online news site, thepaper.cn, quoted as a source of news from China) (r:zd:18244) (q:draft)
thesis = (i:1) (t:n) (f:education) (w:thesis/dissertation) (d:the long paper written to complete a university degree) (o:English) (r:zd:24361) (q:draft)
thiamthiam = (i:1) (t:adv) (f:everyday) (w:sparingly/carefully/little by little) (d:placed after a verb: doing it with care and in small measure, making a little go far, as in sharing out or stretching what there is) (r:zd:19518/zd:17437) (q:draft, low confidence)
thilthial = (i:1) (t:adv) (f:everyday) (w:scantily/barely any/very few) (d:placed after <tawm>, few, or a word built on it, to stress how very few or how little there is, as in {kitawm thilthial}, there are very few indeed) (r:zd:25068/zd:24592) (q:draft)
Thingangyun = (i:1) (t:name) (c:place) (f:travel) (w:Thingangyun) (d:a township of the city of Yangon) (r:zd:16741) (q:draft)
Thingyan = (i:1) (t:name) (f:social/time) (w:Thingyan) (d:the Burmese New Year water festival in April, in Zolai <tuibuahpawi>) (o:Burmese) (r:zd:12164/zd:12115) (q:draft)
thithe = (i:1) (t:adv) (f:everyday/time) (w:repeatedly/often/again and again/constantly) (d:placed after a verb: the action is done time after time or keeps happening) (r:zd:20060/zd:22860/ts:10215) (q:draft)
Thlantlang = (i:1) (t:name) (c:place) (f:travel/politics) (w:Thantlang/Thlantlang) (d:a town and township of Chin State in Myanmar, named among the nine townships of the state) (r:zd:24714/ts:3503) (q:draft)
tho = (i:2) (t:n) (c:animal) (f:nature) (w:fly/insect) (d:a fly or other small flying insect that settles on people or bites them; a noun apart from the verb {tho}, rise, found also in the plural <thote>) (r:zd:24072/zd:20496) (q:draft, low confidence)
thoh = (i:1) (t:v) (f:work) (w:withdraw/draw out/collect) (d:take out what is kept or issued somewhere: money from a bank or an account, or goods such as medicine that are handed out; {sum thoh} is withdraw money) (o:Burmese) (r:zd:23446/zd:20859/zd:24042) (q:draft)
thohak = (i:1) (t:v) (f:everyday/time) (w:rise late/get up late) (d:<tho>, rise, with <hak>, slow: get up late in the morning, the opposite of <thobaih>) (a:thobaih) (j:tho/hak) (r:zd:24276/zd:24089) (q:draft)
thohkhia = (i:1) (t:v) (f:work) (w:withdraw/draw out/take out) (d:<thoh>, withdraw, and <khia>, out, written as one word: take money out of a bank; also issue or bring out goods) (j:thoh/khia) (r:zd:12437/zd:12742) (q:draft)
thohna = (i:1) (t:n) (f:work/media) (w:issuing/distribution/withdrawal) (d:<thoh>, draw out, with the noun suffix <na>: the drawing or giving out of something, as money from a machine, supplies, medicine, or an issue of a magazine) (b:thoh) (o:Burmese) (r:zd:14706/zd:22803) (q:draft, low confidence)
thoih = (i:1) (t:v) (f:religion) (w:propitiate/appease/make an offering to) (d:make an offering to a spirit or power to satisfy it and turn away harm, as in {dawi thoih}, appease the spirits; also make atonement for a wrong) (r:ts:3366/zd:13354/zd:12177) (q:draft)
thoihna = (i:1) (t:n) (f:religion) (w:sacrifice/offering) (d:noun of <thoih>, offer a sacrifice: a sacrifice made to a spirit or to God; {dawi thoihna} is sacrifice to the spirits and {mawh thoihna} is a guilt offering) (s:kithoihna) (b:thoih) (r:zd:23394/zd:12177/zd:21175) (q:draft)
tholh = (i:1) (t:v) (f:health/body) (w:purge/have loose bowels) (d:said with <sung>, the inside: {sung tholh} is empty the bowels, have loose bowels, and {sung tholh za} is a purgative) (r:zd:12541) (q:draft, low confidence)
tholiang = (i:1) (t:v) (f:body/everyday) (w:even stand up/rise up) (d:<tho>, rise, with <liang>, even, written as one word, said of the body hair in {khuasikmul bang tholiang}: the hair even stands on end) (j:tho/liang) (r:zd:20769) (q:draft, low confidence)
thong kum = (i:1) (t:n) (f:politics) (w:years in prison/prison term/years of imprisonment) (d:<thong>, prison, and <kum>, year: years of imprisonment, followed by the number of years; {thong kum 3 kia} is to be sentenced to three years in prison) (r:zd:24322) (q:draft)
thongcingpa = (i:1) (t:n) (f:politics/work) (w:jailer/prison guard) (d:<thongcing>, jailer, with <pa> for a man, written as one word) (j:thongcing/pa) (r:zd:19193/zd:22415) (q:draft)
thongdaan = (i:1) (t:n) (f:politics) (w:prison sentence/imprisonment/jail term) (d:punishment by prison, from <thong>, prison, and <daan>, punishment; named beside <liausum>, a fine) (r:zd:12519/zd:17544) (q:draft)
thongkhia = (i:1) (t:v) (f:politics) (w:imprison/put in prison/jail) (d:put someone in prison; also written for <thongkia>, be in prison, as in {thongkhia mi}, a prisoner) (r:zd:24413) (q:draft)
thongkia = (i:2) (t:n) (f:politics/social) (w:prisoner/inmate) (d:the word used alone as a noun for a person held in prison, mostly with the plural <te>, where the verb sense says that someone is in prison) (s:thongkia mi) (r:zd:16619/zd:10798) (q:draft)
thongkia mi = (i:1) (t:n) (f:politics/social) (w:prisoner/inmate/detainee) (d:<thongkia>, be in prison, and <mi>, person: a person held in prison; a number or <khat> follows it) (r:zd:19275/ts:4831) (q:draft)
thongkiading = (i:1) (t:v) (f:politics) (w:be sentenced to prison/will be imprisoned) (d:<thongkia>, be imprisoned, and <ding>, will, written as one word; after a length of time: is to be in prison for that long) (j:thongkia/ding) (r:zd:15848/zd:19745) (q:draft)
thongkiatding = (i:1) (t:phrase) (f:politics/social) (w:to be imprisoned/prison term) (d:<thongkiat>, be imprisoned, and <ding> written as one word: that one will be imprisoned, the imprisonment to be served) (j:thongkiat/ding) (r:zd:18139/zd:16131) (q:draft)
thongkiathei = (i:1) (t:v) (f:politics) (w:may be imprisoned/can be jailed) (d:<thongkia>, be imprisoned, and <thei>, can, written as one word: may be sentenced to prison, usually after a length of time) (j:thongkia/thei) (r:zd:12611/zd:16502) (q:draft)
thongkiatkum = (i:1) (t:n) (f:politics) (w:prison term/years of imprisonment) (d:<thongkiat>, be in prison, and <kum>, year, written as one word: the number of years of a prison sentence) (j:thongkiat/kum) (r:zd:17526) (q:draft)
thonglam = (i:1) (t:n) (f:politics/social) (w:prison matters/detention matters) (d:<thong>, prison, and <lam>, side, written as one word: what concerns prison and people held in detention; found in headings of community reports) (j:thong/lam) (r:zd:13165/zd:19520) (q:draft, low confidence)
thongpan = (i:1) (t:adv) (f:politics/social) (w:from prison/out of prison) (d:<thong>, prison, and <pan>, from, written as one word: out of prison, as with being released or set free) (j:thong/pan) (r:zd:19579/zd:22983) (q:draft)
Thongpi = (i:1) (t:n) (f:politics) (w:central prison/main prison) (d:<thong>, prison, with <pi>, great, written as one word: the large main prison, as {Insein Thongpi}, Insein Central Prison) (j:thong/pi) (r:zd:25260/zd:24322) (q:draft)
thongpuan = (i:1) (t:n) (f:home/politics) (w:prison clothes/prison uniform) (d:<thong>, prison, and <puan>, clothes, written as one word: the clothes a prisoner is made to wear) (j:thong/puan) (r:zd:16869/zd:20302) (q:draft)
thongsung = (i:1) (t:n) (f:politics) (w:prison/inside of a prison) (d:<thong> and <sung> written as one word: the inside of a prison; {thongsung ah} is in prison and {thongsung lut} is go to prison) (j:thong/sung) (r:zd:23488/zd:12613/zd:12557) (q:draft)
thongsungah = (i:1) (t:adv) (f:politics) (w:in prison/into prison) (d:<thongsung>, the inside of a prison, and <ah> written as one word: in or into prison) (b:thongsung) (j:thongsung/ah) (r:zd:21657/zd:21268/zd:14844) (q:draft)
thongtang = (i:1) (t:n) (f:politics/social) (w:prisoner/detainee) (d:a person held in prison or detention, often as {thongtang mi}) (r:zd:19237/zd:20720) (q:draft)
thongvai = (i:1) (t:n) (f:politics) (w:prison affairs/prison matters) (d:<thong>, prison, with <vai>, affair, written as one word: what concerns a prison or imprisonment) (j:thong/vai) (r:zd:25686) (q:draft, low confidence)
thongzong = (i:1) (t:phrase) (f:politics) (w:prison also/imprisonment as well) (d:<thong>, prison, and <zong>, also, written as one word: a prison term as well, said beside <liausum>, a fine) (j:thong/zong) (r:zd:12774/zd:17262) (q:draft)
thophet = (i:1) (t:adv) (f:time/everyday) (w:just after getting up/on rising) (d:<tho>, get up, and <phet>, as soon as, written as one word: the moment one gets up, mostly after <zingsang>, morning) (j:tho/phet) (r:zd:23036/zd:15298) (q:draft)
thopuan = (i:1) (t:n) (f:home/health) (w:mosquito net) (d:a net hung over the bed to keep out mosquitoes, <thokang>) (r:zd:24276/zd:22695) (q:draft)
thote = (i:2) (t:n) (f:nature/health) (w:mosquitoes/biting insects) (d:in a health article {thote} are the small flying insects that look for people to bite, drawn by sweat, drink and perfume, where English says mosquitoes; they come with <pet>, bite, unlike the flies that settle on food) (r:zd:20496) (q:draft, low confidence)
thoza = (i:1) (t:n) (f:health/home) (w:insecticide/mosquito repellent/fly poison) (d:a substance used to kill or keep away flies and mosquitoes, sprayed or used in the house) (r:zd:16177/zd:16695) (q:draft)
thu = (i:5) (t:n) (f:media) (w:news/report/word) (d:what is told or heard about an event; {cih thu kiza hi} at the end of a news sentence is it is reported that) (r:ts:8304/ts:4734) (q:draft)
thu = (i:6) (t:n) (f:religion) (w:word/message/teaching) (d:what someone says or teaches, after the one who speaks; {Pasian thu} is the word of God) (r:zd:25927/ts:4569) (q:draft)
thu kibawlding = (i:1) (t:v) (f:politics/media) (w:will be prosecuted/will be charged) (d:<thu>, matter or case, and <kibawlding>, will be made: a case will be brought, the person will be prosecuted; from {thu bawl}, bring a case against someone in law. The law or charge stands before it with <tawh>, and a news report closes it with <cihi> or {cih kiza hi}) (r:zd:20234/zd:16580) (q:draft)
thu kikum = (i:1) (t:v) (f:social) (w:discuss/confer/hold a discussion) (d:<thu>, matter, and <kikum>, confer: discuss a matter together; the question discussed stands before it, often ending in <cih>) (r:zd:21925/zd:10833) (q:draft)
thu kikup = (i:1) (t:v) (f:social) (w:discuss/hold a discussion/confer) (d:<thu>, matter, and <kikup>, discuss together: to talk a matter over together, to hold a discussion; also the discussion itself, and with <na> the noun {thu kikup na}) (r:zd:14530/zd:18196) (q:draft)
thu laigil = (i:1) (t:n) (f:everyday/education) (w:essence/main point/core/heart of the matter) (d:<thu>, word or matter, and <laigil>, core: the central point or essence of a matter or teaching; the matter stands before it, as in {Pasian' thu laigil}, the heart of the word of God) (r:zd:20786/zd:23129/zd:24186) (q:draft)
thu tangkona = (i:1) (t:n) (f:religion) (w:preaching/proclamation) (d:<thu>, word, and <tangkona>, proclamation: the preaching of a message; the message is named before it, most often in {lungdamna thu tangkona}, the preaching of the gospel, evangelism) (r:zd:18200/zd:24234) (q:draft)
thuah = (i:2) (t:v) (f:health/home) (w:wear/put on/fit) (d:used as the main verb with a thing put over the face or body: put on or wear a mask, as in <maituam> {thuah}, or fit a brace; not the adverb after another verb) (r:zd:24299) (q:draft)
thuahbehding = (i:1) (t:v) (f:everyday/media) (w:will be added/to fit more) (d:<thuah>, fit or add, with the ending {-beh}, in addition, and <ding>, written as one word: more are to be fitted or added to what is there) (r:zd:13184) (q:draft, low confidence)
thuahding = (i:1) (t:v) (f:everyday/it) (w:to add/to fit/to install) (d:<thuah>, add or fit something on, and <ding> written as one word: will be added or fitted, is to be installed) (j:thuah/ding) (r:zd:13184/zd:15184) (q:draft)
thuahin = (i:2) (t:v) (f:health/home) (w:wearing/putting on) (d:<thuah.2> wear with the linking ending <in>, joining it to the next verb: wearing a mask or gloves while doing something; the thing worn stands before it, where the adverb follows another verb) (r:zd:15178/zd:12785) (q:draft)
thuahkawm = (i:1) (t:v) (f:everyday) (w:do at the same time/do alongside/combine with) (d:<thuah>, in addition, and <kawm>, while, written as one word: do or have one thing along with another; the other thing is marked by <tawh>) (j:thuah/kawm) (r:zd:21288/zd:19271) (q:draft, low confidence)
thuahna = (i:1) (t:n) (f:health/home) (w:wearing/putting on) (d:<thuah> with {-na}: the putting on or wearing of something over the face or body, as a mask; {ki thuahna} is keeping company with others) (b:thuah) (r:zd:24489/zd:24918/zd:24432) (q:draft)
thuahpih = (i:1) (t:v) (f:social) (w:accompany/keep company with/be together with) (d:the second part of <kithuahpih> where the prefix <ki> is written as a separate word: {ki thuahpih}, be together with someone, be a companion of) (r:zd:23148/zd:21989/zd:25919) (q:draft)
thuahsa = (i:1) (t:v) (f:everyday) (w:wearing/having on/plugged in) (d:with a thing already put on or fitted in place, said of a mask, earphones or a cable, mostly as {thuahsa in}) (r:zd:15629/zd:12776) (q:draft, low confidence)
thuahsak = (i:1) (t:v) (f:everyday/home) (w:install/fit/put on/add) (d:<thuah>, in addition, with the causative <sak>: put one thing onto or into another, as install a device in a place or dress someone in something; with <ki> also of a penalty laid on someone) (r:zd:15759/zd:12685/zd:15305) (q:draft)
thuahsakding = (i:1) (t:v) (f:home/work) (w:to install/will install/will fit) (d:<thuahsak> and <ding> written as one word: will install or fit equipment for someone, or what is to be installed) (j:thuahsak/ding) (r:zd:20543/zd:17668) (q:draft)
thuahte = (i:2) (t:n) (f:social) (w:those who combine/those joined with) (d:<thuah>, add or join, with the plural <te>, after <a> or <aki>: the people who join one quality to another, as {pil leh ciim a thuahte}, those who combine knowledge and wisdom, or those who are together with someone or something marked by <tawh>; not the gifts of the other sense) (b:thuah) (r:zd:22495/zd:12325) (q:draft, low confidence)
thuahthei = (i:1) (t:v) (f:it/everyday) (w:can be fitted/can be added/can be put on) (d:<thuah>, put on or add, and <thei>, able, written as one word: can be put on, fitted or added) (j:thuah/thei) (r:zd:15097/zd:12257) (q:draft)
thuaka = (i:1) (t:v) (f:everyday/health) (w:suffer/bear/undergo) (d:<thuak> with the linking <a> written as one word: suffers or bears it and, before the sentence goes on) (j:thuak/a) (r:zd:9242/zd:16441) (q:draft)
thuakdan = (i:1) (t:n) (f:everyday/social) (w:way of suffering/experience/how one feels) (d:<thuak>, suffer or bear, and <dan>, way, written as one word: how a person feels or goes through something) (j:thuak/dan) (r:zd:14583/zd:22775) (q:draft)
thuakden = (i:1) (t:v) (f:everyday/social) (w:keep suffering/suffer constantly) (d:<thuak> and <den> written as one word: undergo something again and again or all the time) (j:thuak/den) (r:zd:19052/zd:12571) (q:draft)
thuakdikdek = (i:1) (t:v) (f:everyday/politics) (w:suffer severely/undergo thoroughly) (d:<thuak>, undergo, and <dikdek>, thoroughly, written as one word: get the full force of a beating, an inquiry or another hard thing) (j:thuak/dikdek) (r:zd:12538/zd:15301) (q:draft)
thuakding = (i:1) (t:v) (f:everyday/politics) (w:will suffer/will undergo/will face) (d:<thuak>, suffer or undergo, and <ding>, will, written as one word: will undergo, or what one is to undergo, especially a punishment; {thusitna thuakding} is will stand trial) (j:thuak/ding) (r:zd:14660/zd:16869) (q:draft)
thuakgawp = (i:1) (t:v) (f:everyday) (w:suffer badly/suffer severely) (d:<thuak>, suffer, and <gawp>, severely, written as one word; {vuak thuakgawp} is be badly beaten) (j:thuak/gawp) (r:zd:12891) (q:draft)
thuakhaksa = (i:1) (t:adj) (f:everyday) (w:hard to bear/hard to endure) (d:<thuak> and <haksa> written as one word: difficult to bear or put up with) (j:thuak/haksa) (r:zd:20919/zd:24276) (q:draft)
thuakkhakna = (i:1) (t:n) (f:health) (w:exposure/suffering) (d:noun of <thuakkhak>: the fact of having come to suffer something, as {khuavot a thuakkhakna}, exposure to cold) (b:thuakkhak) (r:zd:21557) (q:draft, low confidence)
thuakkhop = (i:1) (t:v) (f:social) (w:suffer together/bear together) (d:<thuak>, bear, with <khop>, together, written as one word; {thuakkhop pih dingte} are those who will suffer along with one) (j:thuak/khop) (r:zd:13154) (q:draft, low confidence)
thuaklah = (i:1) (t:v) (f:everyday/health) (w:suffer/be badly affected/be hard hit) (d:suffer much from something and find it hard to bear, as smoke, heat, pain or ill treatment; built on <thuak>, bear; {thuaklah mahmah} is suffer greatly) (r:zd:15286/zd:12267/zd:16137) (q:draft)
thuaklahlua = (i:1) (t:v) (f:health/everyday) (w:suffer unbearably/be unable to bear/be overcome) (d:<thuaklah>, find hard to bear, with <lua>, too much, written as one word: suffer more than one can bear, from pain, heat, smoke or hunger) (j:thuaklah/lua) (r:zd:15481/zd:12532/zd:20518) (q:draft)
thuaklai = (i:1) (t:v) (f:everyday) (w:still suffer/still endure/bear for now) (d:<thuak> and <lai.3>, still, written as one word: go on bearing or suffering) (j:thuak/lai) (r:zd:23937/zd:21040) (q:draft)
thuakleh = (i:1) (t:v) (f:everyday) (w:if one suffers/when one undergoes) (d:<thuak>, suffer or undergo, and <leh>, if, written as one word: if or when someone suffers something) (j:thuak/leh) (r:zd:23902) (q:draft)
thuaklel = (i:1) (t:v) (f:everyday) (w:suffer/bear the consequences) (d:<thuak>, suffer, with <lel>: have to suffer something, be left to bear it) (r:zd:17152) (q:draft, low confidence)
thuaklo = (i:1) (t:v) (f:everyday) (w:not suffer/not bear) (d:<thuak>, suffer or bear, and <lo>, not, written as one word; {bek in thuaklo} is not only that one suffers) (j:thuak/lo) (r:zd:23603/zd:16779) (q:draft)
thuakngam = (i:1) (t:v) (f:everyday/religion) (w:dare to suffer/be willing to endure) (d:<thuak> and <ngam>, dare, written as one word: have the courage to bear suffering) (j:thuak/ngam) (r:zd:23928/zd:22701) (q:draft)
thuakngei = (i:1) (t:v) (f:everyday) (w:have suffered/have undergone/have experienced) (d:<thuak>, suffer or undergo, and <ngei>, ever, written as one word: have at some time gone through something; with <kei>, never) (j:thuak/ngei) (r:zd:15366) (q:draft)
thuaknop = (i:1) (t:adj) (f:everyday/health) (w:bearable/easy to bear/tolerable) (d:<thuak>, bear, with <nop>, the form of <nuam>, pleasant, written as one word: easy to bear; {thuaknop zaw} is easier to bear) (j:thuak/nop) (r:zd:24476) (q:draft, low confidence)
thuakpihna = (i:1) (t:n) (f:social) (w:sympathy/compassion) (d:<thuakpih>, suffer with, with the noun suffix {-na}: the sharing of another person's suffering, sympathy; in messages of condolence beside <dahpihna>) (b:thuakpih) (r:zd:24221/zd:12681) (q:draft)
thuaksak = (i:2) (t:v) (f:religion) (w:suffer for/bear for/suffer in place of) (d:<thuak> with <sak> in its use of doing a thing for someone: bear in another's place what that one should suffer, said of Christ; with {ei tangin} or {ei thuak ding}, and not making someone suffer) (r:zd:23928/zd:23907) (q:draft)
thuaksakding = (i:1) (t:v) (f:politics/social) (w:to make suffer/will be made to undergo) (d:<thuaksak>, make suffer, and <ding> written as one word: is to be made to suffer or undergo something, as a punishment) (j:thuaksak/ding) (r:zd:12817/zd:12097) (q:draft)
thuaksiam = (i:1) (t:v) (f:social/everyday) (w:bear patiently/be forbearing/put up with) (d:<thuak>, bear, and <siam>, skilled, written as one word: know how to bear hardship or other people; {kithuaksiam} is bear with each other) (j:thuak/siam) (r:zd:21108/zd:21340) (q:draft)
thuakte = (i:2) (t:n) (f:everyday) (w:sufferings/what one suffers) (d:after <ka>, <i> or <a> with the person already named: the hardships themselves that someone goes through, not the people who suffer) (r:zd:22127/zd:9425) (q:draft, low confidence)
thuakthei = (i:1) (t:v) (f:everyday) (w:can suffer/be liable to/be able to bear) (d:<thuak> and <thei> written as one word: can undergo or suffer something, be exposed to it) (j:thuak/thei) (r:zd:20816/zd:17202) (q:draft)
thuakzawhna = (i:2) (t:n) (f:health/body) (w:resistance/immunity/stamina) (d:after <pumpi>, body: the power of the body to withstand illness and strain, which food and medicine can strengthen or weaken; not patience of the mind) (r:zd:22740/zd:23935) (q:draft)
thuakzolo = (i:1) (t:v) (f:everyday/health) (w:cannot bear/be unable to endure) (d:<thuak> and <zolo> written as one word: not able to bear or withstand something, give way under it) (j:thuak/zolo) (r:zd:20747/zd:12835) (q:draft)
Thuamvum = (i:1) (t:name) (c:mountain) (f:nature/travel) (w:Thuamvum/Kennedy Peak) (d:a mountain near Tedim in Chin State, in English Kennedy Peak) (r:zd:14824/ts:11738) (q:draft)
thuapthuap = (i:1) (t:adv) (f:everyday) (w:layer upon layer/level by level/again and again) (d:<thuap>, layer, said twice: in layers one on another, at each level, or time after time) (b:thuap) (r:zd:26565) (q:draft, low confidence)
thubaih = (i:1) (t:n) (f:everyday) (w:easy matter/simple thing) (d:<thu>, matter, with <baih>, easy: something easy to do, mostly in the negative {thubaih hilo}, it is no easy matter) (r:zd:25078/zd:25015/zd:25609) (q:draft)
thubawl = (i:1) (t:v) (f:politics) (w:prosecute/charge/take legal action/sue) (d:<thu>, case, with <bawl>, make: bring a case against someone under the law, said of the police, the government or a private party) (r:zd:20412/zd:11918/zd:20222) (q:draft)
thubawlding = (i:1) (t:v) (f:politics) (w:prosecute/take legal action/charge) (d:<thu> <bawl>, bring a case against someone, with <ding>, will, written as one word: will prosecute, in order to charge) (j:thu/bawl/ding) (r:zd:17818/zd:21057) (q:draft)
thubawlna = (i:1) (t:n) (f:politics/social) (w:legal action/proceedings/prosecution/action) (d:<thu>, matter or case, with <bawlna>, doing: action taken against someone, mostly by the police or a court) (j:thu/bawlna) (r:ts:9881/ts:1215) (q:draft)
thubek = (i:1) (t:phrase) (f:everyday) (w:only the matter of/only the word of/merely) (d:<thu.1> and <bek> written as one word: only the matter, word or will of the one named before it; {ama thubek} is only his own way) (j:thu/bek) (r:zd:11548/zd:25687/zd:25275) (q:draft, low confidence)
thubu = (i:1) (t:n) (f:religion) (w:scripture/book of the word) (d:<thu>, word, with <bu>, book: a book that holds a message; {Pasian thubu} is the word of God as a book, the Bible) (r:ts:9862/zd:23896) (q:draft)
thubuai = (i:1) (t:n) (f:social/politics) (w:dispute/trouble/incident) (d:<thu>, matter, with <buai>, be troubled: a quarrel, case or disturbance that has to be settled) (r:zd:22492/zd:15431/zd:25109) (q:draft)
thubuaina = (i:1) (t:n) (f:social/politics) (w:trouble/conflict/dispute/incident) (d:<thubuai>, dispute or trouble, with the noun suffix {-na}: a matter that causes trouble, a conflict) (s:buaina) (b:thubuai) (r:zd:16690/zd:22701) (q:draft)
thubuaite = (i:1) (t:n) (f:social/politics) (w:disputes/troubles/conflicts) (d:plural of <thubuai>: disputes, troubles or conflicts) (b:thubuai) (j:thubuai/te) (r:zd:22922) (q:draft)
thubulphuh = (i:1) (t:n) (f:religion/social) (w:theme/main topic/motto) (d:<thu>, word, with <bulphuh>, base on: the theme on which a sermon, a meeting or a year's programme is based) (s:thubul) (r:zd:22604/ts:9530) (q:draft)
thubulpite = (i:1) (t:n) (f:social/politics) (w:main points/principles/fundamentals/root issues) (d:<thubulpi> with the plural <te>: the main matters or basic principles of something) (b:thubulpi) (r:zd:19379/ts:10637) (q:draft)
thuciamlui = (i:1) (t:n) (c:testament) (f:religion) (j:Thuciam lui) (r:zd:24673/zd:23843) (q:draft)
thuciamthak = (i:1) (t:n) (c:testament) (f:religion) (j:Thuciam thak) (r:zd:22544/zd:12333) (q:draft, a name, written Thuciamthak with a capital in the articles)
thucian = (i:1) (t:n) (f:everyday/media) (w:exact facts/details) (d:<thu>, matter, with <cian>, clearly: the exact and full facts of a matter) (r:zd:22877/zd:19305) (q:draft, low confidence)
thuciapteh = (i:1) (t:n) (f:education/everyday) (w:memory/record/note) (d:<thu> and <ciapteh> written as one word: keeping things in mind or on record; {thuciapteh theihna} is the ability to remember, memory) (j:thu/ciapteh) (r:zd:24276/zd:21616) (q:draft)
thuciaptehna = (i:1) (t:n) (f:work/media) (j:thuciamtehna) (r:zd:23249/zd:26658) (q:draft)
thuciin = (i:1) (t:n) (f:social/education) (w:saying/proverb/oral tradition) (d:a saying or teaching handed down by word of mouth from earlier generations) (s:paunak) (r:zd:22556/zd:15541) (q:draft)
thucin = (i:1) (t:n) (f:social) (w:chat/small talk/casual talk) (d:used in the pair {thucin thutang}: talk about this and that, casual conversation; {thucin thutang gen} is to chat) (r:zd:26050/zd:13302) (q:draft)
thudik = (i:2) (t:n) (f:everyday/social) (w:truth/the truth/what is right) (d:used as a noun, often paired with <thuman> or set against <zuau>, a lie: what is true and right, the truth of a matter) (r:zd:22557/zd:24064/zd:15714) (q:draft)
thudiklo = (i:1) (t:adj) (f:social/politics) (w:untrue/unfair/not valid) (d:<thudik> and <lo> written as one word: not true or not right, unfair) (j:thudik/lo) (r:zd:21040/zd:19858) (q:draft)
thudonlo = (i:1) (t:v) (f:everyday/social) (w:pay no attention/ignore/take no notice) (d:<thudon>, pay attention, and <lo>, not, written as one word: take no notice of what is said or what happens) (j:thudon/lo) (r:zd:17279/zd:18067) (q:draft)
thudonloh = (i:1) (t:v) (f:everyday) (w:not heed/pay no attention/neglect) (d:<thudon>, pay attention, and <loh>, not, written as one word, the form used before <man>: {thudonloh man}, because of not heeding) (j:thudon/loh) (r:zd:18208/zd:16254) (q:draft)
thudot = (i:3) (t:n) (f:social/politics) (w:question/questioning/inquiry) (d:a question put to someone, or the questioning of a person in an inquiry, not a request for advice; it stands before <nei> or <bawl>, and {thudot thusitna} is questioning and investigation by the police) (r:zd:12621/zd:16055/zd:22778) (q:draft)
thudotpi = (i:1) (t:n) (f:politics/work) (w:adviser/counsellor) (d:<thudot.2>, asking for advice, with <pi.3>, chief: the person a ruler or a body turns to for advice; {gambup thudotpi} is the State Counsellor of Myanmar) (r:zd:24303/zd:17838/zd:21327) (q:draft)
thudotpiteng = (i:1) (t:n) (f:politics/work) (w:all the advisers/the advisers) (d:<thudotpi>, adviser, and <teng>, here all of them, written as one word) (j:thudotpi/teng) (r:zd:12695) (q:draft, low confidence)
thuduh = (i:1) (t:adj) (f:social) (w:contentious/eager to argue/hungry for words) (d:<thu>, word or matter, with <duh>, crave: eager for talk or dispute, pressing one's own point; in religious writing also hungry for the word) (r:zd:25127/zd:11571) (q:draft, low confidence)
thugelh = (i:1) (t:n) (f:education/media) (w:writing/written piece/article) (d:<thu>, word or matter, with <gelh>, write: something written, a piece of writing, set beside <thugen>, speech) (r:zd:11452/zd:24394) (q:draft)
thugelhte = (i:1) (t:n) (f:media/education) (w:writings/articles) (d:<thugelh>, a piece of writing, with plural <te>: the things someone has written) (b:thugelh) (j:thugelh/te) (r:zd:19201/zd:23086) (q:draft)
thugen = (i:1) (t:v) (f:everyday/social) (w:speak/say) (d:<thu>, word, with <gen>, say: speak to someone, address people; also used as a noun for what a person says) (s:gen)
thugena = (i:1) (t:n) (f:social/media) (j:thugenna) (r:zd:11092) (q:draft)
thugendan = (i:1) (t:n) (f:social/education) (w:way of speaking/manner of speech/speaking) (d:<thugen>, speak, and <dan>, manner, written as one word: the way a person speaks, and the art of speaking to people) (j:thugen/dan) (r:zd:23985/zd:17152) (q:draft)
thugending = (i:1) (t:v) (f:social/religion) (w:to speak/to give a talk/to preach) (d:<thugen>, speak, and <ding>, to, written as one word: to speak before people, to give a talk or sermon) (j:thugen/ding) (r:zd:20412/zd:11715) (q:draft)
thugenna nei = (i:1) (t:v) (f:social/religion) (w:give a speech/deliver an address/speak) (d:<thugenna>, speech, and <nei>, have: hold a speech, give an address or a talk at a meeting or service; the speaker stands before it with <in>, the place with <ah>) (r:zd:13181/zd:17939/zd:18927) (q:draft)
thugenpi = (i:2) (t:n) (f:politics/media) (w:spokesperson/spokesman) (d:the person who speaks to the press for an army, an armed group or an organisation, whose name stands before {thugenpi}; not the main speaker at a meeting) (r:ts:3707/ts:5396/ts:5171) (q:draft)
thugenpipa = (i:1) (t:n) (f:politics/media) (w:spokesman/spokesperson) (d:<thugen>, speak, with <pipa>, chief man: the man who speaks to the public for an organisation or armed group) (b:thugen) (r:ts:4528/ts:1395) (q:draft)
thugensiam = (i:1) (t:n) (f:social/education) (w:good speaker/eloquent speaker/orator) (d:<thugen>, speak, and <siam>, skilled, written as one word: a person who speaks well, and being good at speaking) (j:thugen/siam) (r:zd:21063/zd:9250) (q:draft)
Thugensiamna = (i:1) (t:n) (f:social/education) (w:public speaking/eloquence/skill in speaking) (d:<thugensiam>, good at speaking, with the noun ending {-na}: the skill of speaking well before people; written with a capital only in titles) (s:gensiamna) (b:thugensiam) (r:zd:21063/zd:21741) (q:draft)
thugente = (i:2) (t:n) (f:social/religion) (w:speakers) (d:<thugen>, speak, with the plural <te> for persons: the people who speak at a meeting or in a conversation, named beside <lasa>, singers; sense 1 is the things said) (r:zd:15818/zd:23223) (q:draft, low confidence)
thugil = (i:1) (t:n) (f:education/religion) (w:essence/substance/core/principle) (d:the deep or essential part of a matter, its real content; {dinpih thugil} is a principle one stands on, and said of writing it means having substance) (r:zd:26163/ts:9862) (q:draft)
thugilte = (i:1) (t:n) (f:religion/education) (w:deep truths/core teachings/principles/doctrines) (d:plural of <thugil>: the deep or essential matters of a subject, as {upna thugilte}, the doctrines of the faith) (b:thugil) (r:zd:9236/zd:24214) (q:draft)
thuginalo = (i:1) (t:n) (f:social/media) (w:bad thing/wrongdoing/scandal) (d:<thu>, matter, and <ginalo>, no good, written as one word: improper or shameful matters, bad news or worthless talk) (j:thu/ginalo) (r:zd:16695/zd:16998/zd:12142) (q:draft)
thuging = (i:1) (t:n) (f:media/social) (w:rumour/report/hearsay) (d:news that is going round and is heard but not confirmed; {cih thuging kiza hi} is it is heard said that) (r:zd:20014/zd:16157) (q:draft)
thugingte = (i:1) (t:n) (f:media) (w:reports/news/rumours) (d:plural of <thuging>: the news and reports that are going round) (b:thuging) (j:thuging/te) (r:zd:24915/zd:22880) (q:draft)
thugui = (i:1) (t:n) (f:social/education) (w:principle/doctrine/guiding rule) (d:a basic rule or teaching that other things follow from; {thugui paipi} and {thugui pi} are a main principle) (r:zd:8668/zd:17177) (q:draft)
thuguilet = (i:1) (t:n) (f:politics) (w:policy/guiding principle) (d:the set line or principle that a government or organisation follows) (s:policy) (r:zd:21327) (q:draft, low confidence)
thuguipi = (i:1) (t:n) (f:politics/social/religion) (w:principle/main point/fundamental/tenet) (d:<thu>, matter, with <guipi>, main stem: a basic principle on which other things rest, or a main topic of a discussion) (r:zd:25020/zd:19416/zd:24303) (q:draft)
thuguipite = (i:1) (t:n) (f:politics/social/religion) (w:principles/main points) (d:<thuguipi>, principle or main point, with the plural <te>, written as one word) (b:thuguipi) (j:thuguipi/te) (r:zd:22922/zd:19416) (q:draft)
thuguk = (i:1) (t:n) (f:everyday/social) (w:secret) (d:something kept hidden from others; also the hidden key to something, as {lawhcinna thuguk}, the secret of success) (r:zd:20572/zd:12023) (q:draft)
thuh = (i:3) (t:v) (f:politics/work) (w:sign) (d:after <letmat> or the English <sign>, put one's signature to a form, a letter or an agreement; the present-day use beside pressing a seal in sense 1) (r:zd:22586/zd:21547/zd:19097) (q:draft)
thuhawih = (i:1) (t:n) (f:everyday/religion) (j:thuhoih) (r:zd:21626/zd:20545) (q:draft)
thuhding = (i:1) (t:v) (f:politics/work) (w:will sign/to sign) (d:<thuh>, sign, and the future marker <ding> written as one word, after <letmat>: will put a signature to a document) (j:thuh/ding) (r:zd:11427/zd:11010) (q:draft)
thuhilhding = (i:1) (t:v) (f:family/education) (w:will teach/to instruct/to discipline) (d:<thuhilh> and <ding> written as one word: will teach or correct someone, or in order to do so) (j:thuhilh/ding) (r:zd:11193/zd:15443) (q:draft)
Thuhilhkikna = (i:1) (t:name) (c:book) (f:religion) (j:Thu Hilhkikna) (r:zd:17374) (q:draft)
thuhilhsiam = (i:1) (t:n) (f:religion) (w:gifted preacher/able preacher/skilled teacher) (d:<thuhilh>, preach or teach, and <siam>, skilled, written as one word: a person who preaches or teaches well) (j:thuhilh/siam) (r:zd:9233/zd:9224) (q:draft)
thuhkikna = (i:2) (t:n) (f:social/media) (w:response/reply/feedback) (d:an answer given back to a speaker or writer, without any thought of revenge: the reply to a letter, or the feedback that listeners give, as in {thuhkikna la}, take feedback) (r:zd:21063) (q:draft, low confidence)
thuhkikziading = (i:1) (t:n) (f:politics/media) (w:way to respond/how to strike back) (d:<thuhkik>, repay or strike back, and <ziading>, the way to do it, written as one word: how to respond to an attack) (j:thuhkik/ziading) (r:zd:15811) (q:draft, low confidence)
thuhna = (i:3) (t:n) (f:politics/work) (w:signing) (d:the putting of a signature on a document, after <letmat>, signature, or the English word sign; {letmat thuhna nei} is sign, hold a signing; a present-day use beside the pressing of a seal) (b:thuh) (r:zd:12521/zd:19824) (q:draft)
thuhoihlo = (i:1) (t:n) (f:everyday/media) (w:bad news/bad thing/evil matter) (d:<thu>, word or matter, with <hoihlo>, not good, written as one word: bad news, or a bad thought or matter) (a:thuhoih) (j:thu/hoihlo) (r:zd:15514/zd:20697) (q:draft)
thuhsa = (i:1) (t:adj) (f:work/politics) (w:signed/stamped/sealed) (d:<thuh>, stamp or seal, and <sa> in its use for something already done, written as one word; {letmat thuhsa} is bearing a signature, signed) (j:thuh/sa) (r:zd:12336) (q:draft, low confidence)
thuin = (i:2) (t:n) (f:everyday) (w:the matter/the thing) (d:<thu>, matter, word, written together with the marker <in> after a verb, not after a possessive: the thing that is said or remembered, as {ka phawk thuin}, what comes to my mind is) (b:thu) (r:zd:23022/zd:10793) (q:draft, low confidence)
thuk = (i:4) (t:adj) (f:food/everyday) (w:sour) (d:sour or acid in taste) (r:zai:acetic) (q:draft, low confidence)
thuk = (i:5) (t:adj) (f:everyday/nature) (w:deep/profound) (d:deep, of a valley or the night, and of the mind, love or words, as in {lungsim thuk}; {thuk takin} is deeply; the same word as <thuuk> and <athuk>, not the taste or the paying back) (s:thuuk) (r:zd:24742/zd:19630/zd:21343) (q:draft)
thukaan = (i:1) (t:v) (f:education) (j:thukan) (r:zd:20572) (q:draft, low confidence)
Thukai = (i:1) (t:v) (f:media) (w:gather news/compile) (d:<thu> news with <kai> pull, gather; {thukai khawm} at the foot of a news article names those who gathered the news together) (r:zd:24579) (q:draft, low confidence)
thukan = (i:3) (t:n) (f:media) (w:reporter/journalist/correspondent) (d:one who gathers news for a newspaper, radio or television, beside the older meaning of a secret spy; often with the name of the news service before it or <te> after it) (r:zd:19295/zd:15514/zd:11112) (q:draft)
thukanna = (i:2) (t:n) (f:education/media) (w:research/study/survey) (d:a study that gathers facts and figures on a subject and reports its findings, as in {thukanna khat ah}, in one study, and {thukanna pan}, from research; not the inquiry of police or a court into a wrong) (s:kantelna) (r:zd:24396/zd:23729/zd:24060) (q:draft)
thukante = (i:2) (t:n) (f:media) (w:reporters/investigators/observers) (d:in the news, people who look into events and report what they find, such as journalists and analysts, not spies sent out in secret; often before <genna> or <gen>, what they say) (r:zd:19295/ts:8689) (q:draft)
thukantelna = (i:1) (t:n) (f:education/media) (w:research/survey/investigation/study) (d:<thu>, matter, and <kantelna> written as one word: a careful inquiry into a matter, a survey or piece of research) (s:kantelna) (j:thu/kantelna) (r:zd:21605/zd:12944) (q:draft)
thukawng = (i:1) (t:n) (f:social/politics) (w:course of a matter/direction/subject) (d:the direction that a matter or a talk is taking; {thukawng hei} and {thukawng hek}, turn it, mean change course or change the subject) (r:zd:23985/zd:24932) (q:draft, low confidence)
thuken = (i:1) (t:v) (f:politics) (j:thukhen) (r:zd:2072) (q:draft, low confidence)
thukhaam = (i:1) (t:n) (f:politics/religion) (j:thukham) (r:zd:23113/zd:11110) (q:draft)
thukhat = (i:2) (t:n) (f:everyday) (w:one thing/a matter/something) (d:<thu>, matter, with <khat>, one: one matter, point or thing that is said, asked or thought of, not a rule or law; {thukhat peuhpeuh} is any matter and {thukhat ah} is on one point) (r:zd:23352/zd:21869/zd:16148) (q:draft)
thukhatpeuh = (i:1) (t:n) (f:everyday) (w:something/anything/some matter) (d:<thukhat>, a matter, and <peuh>, any, written as one word: some matter or other, anything; {thukhatpeuh hangin} is for some reason) (j:thukhat/peuh) (r:zd:13179/zd:17538) (q:draft)
thukhel = (i:1) (t:n) (f:media) (w:odd news/oddity/unusual matter) (d:<thu>, matter, with a second part meaning out of the ordinary: an odd or unusual matter, used together with <thulamdang> for weird news) (r:zd:10823/zd:15427) (q:draft)
thukhempeuh = (i:1) (t:n) (f:everyday) (w:everything/all matters/all the details) (d:<thu> and <khempeuh> written as one word: all things, every matter, all that there is to know about something) (j:thu/khempeuh) (r:zd:20432/zd:24276) (q:draft)
thukhending = (i:1) (t:v) (f:politics/social) (w:be the judge/be to judge) (d:<thukhen>, judge, and <ding> written as one word: the one who is to judge; {thukhending hilecin} is if you were the judge) (j:thukhen/ding) (r:zd:14613/zd:14928) (q:draft)
thukhenmang = (i:1) (t:n) (f:politics) (w:judge/magistrate) (d:<thukhen>, judge, with <mang>, lord or official: a judge of a law court) (s:thukhenpa) (b:thukhen) (r:zd:22644/zd:21568/zd:15214) (q:draft)
thukhennasate = (i:1) (t:n) (f:politics) (w:past rulings/earlier decisions/precedents) (d:plural of <thukhennasa>: judgments already given, as in {abeisa thukhennasate}, the rulings of the past) (b:thukhennasa) (r:zd:24536) (q:draft, low confidence)
thukhensat = (i:1) (t:n) (f:social/politics) (w:decision/resolution) (d:<thu>, matter, with <khensat>, decide, written as one word: a decision or resolution of a meeting or body, and the deciding of a matter) (s:thukhensatna) (j:thu/khensat) (r:zd:25127/zd:25914/zd:16719) (q:draft)
thukhentat = (i:1) (t:n) (f:politics/work) (w:decision/ruling) (d:<thu>, matter, with <khentat>, decide: what an officer, court or meeting has decided) (j:thu/khentat) (r:zd:12269) (q:draft, low confidence)
thukhenzia = (i:1) (t:n) (f:politics/religion) (w:way of judging/manner of judgment) (d:<thukhen>, judge, and <zia>, manner, written as one word: how a case or a matter is judged and decided) (j:thukhen/zia) (r:zd:21624/zd:21125) (q:draft)
thukhenzum = (i:1) (t:n) (f:politics) (w:court/law court) (d:<thukhen>, judge, with <zum>, office: a court of law) (r:zd:10722/zd:25710) (q:draft)
thukhenzumpi = (i:1) (t:n) (f:politics) (w:court/high court) (d:<thukhenzum>, court, with the augmentative <pi>: a court of law, mostly a high or international court) (b:thukhenzum) (r:zd:23475/zd:22422) (q:draft)
thukhun = (i:1) (t:n) (f:politics/social) (w:rule/regulation/law/principle) (d:a rule or the rules that must be followed, as the law of a government or the rules of an organisation; {thukhun om bangin} is according to the law) (r:zd:22813/zd:24219/zd:24248) (q:draft)
thukhun ombang = (i:1) (t:adv) (f:politics) (w:according to the law/under the law/as the rules stand) (d:<thukhun>, rule or law, with <ombang>, as there is: followed by <in>, in accordance with the law in force; after the name of an act or section, under that provision, as in reports of charges brought) (r:zd:25111/zd:14797) (q:draft)
thukhunpi = (i:1) (t:n) (f:politics) (w:constitution) (d:<thukhun> with <pi>, great or chief: the basic law of a country, or the constitution of an organisation) (r:zd:25110/zd:19662/zd:24194) (q:draft)
thukhunpite = (i:1) (t:n) (f:politics) (w:constitutions/main principles) (d:plural of <thukhunpi>: constitutions, or the chief rules and principles of something) (b:thukhunpi) (r:zd:21517) (q:draft)
thukhuntawh = (i:1) (t:phrase) (f:politics) (w:with the law/under the law) (d:<thukhun>, law, and <tawh>, with, written as one word; {thukhuntawh kizui in} is in accordance with the law named before it) (j:thukhun/tawh) (r:zd:16729/zd:11060) (q:draft)
thukhunte = (i:1) (t:n) (f:social/politics) (w:rules/regulations/terms) (d:<thukhun>, a rule or agreed regulation, with the plural ending <te>: the rules of an organisation, a law or an agreement) (r:zd:24060/zd:24327/zd:21717) (q:draft)
thukhunthak = (i:1) (t:n) (f:politics) (w:new law/new rule/new regulation) (d:<thukhun>, a rule or law, and <thak>, new, written as one word: a rule newly made by the authorities; in church writing also the New Testament) (j:thukhun/thak) (r:zd:11778/zd:15822) (q:draft)
thukhunzui = (i:1) (t:v) (f:politics) (w:follow the law/act under a law) (d:<thukhun>, law, and <zui>, follow, written as one word; {thukhunzui in} after the name of a law is according to, under that law) (j:thukhun/zui) (r:zd:20021/zd:20526) (q:draft)
thuki = (i:1) (t:phrase) (f:everyday) (d:<thu>, matter or word, written together with the prefix <ki> of the verb that follows, as in {thuki kupna} for {thu kikupna}, discussion of a matter, and {thuki za} for {thu kiza}, it is heard that) (j:thu/ki) (r:zd:20213/zd:21075) (q:draft)
thukibawl = (i:1) (t:v) (f:politics) (w:be charged/be prosecuted) (d:<thu> and <kibawl> written as one word: a case is made against a person, he is charged or tried in court) (j:thu/kibawl) (r:zd:14768/ts:6210) (q:draft)
thukibawlding = (i:1) (t:v) (f:politics) (w:will be charged/will be prosecuted) (d:<thukibawl> and <ding> written as one word: will be charged, a case will be brought, the law or the offence standing before it with <tawh>) (j:thukibawl/ding) (r:zd:12816/zd:12678) (q:draft)
thukician = (i:1) (t:n) (f:media) (w:reliable information/confirmed news/definite facts) (d:<thu>, word or matter, and <kician>, firm, written as one word: information that is definite and can be relied on) (j:thu/kician) (r:ts:1919/ts:5498) (q:draft)
thukicing = (i:1) (t:n) (f:media/everyday) (w:full information/complete details) (d:<thu>, news or matter, and <kicing>, complete, written as one word: the full account of a matter) (j:thu/kicing) (r:zd:21596/zd:22850) (q:draft)
thukigen = (i:1) (t:n) (f:social/media) (w:talk/what is said/report) (d:<thu>, word or matter, with <kigen>, be said, written as one word: what is being said, the things talked about or discussed) (j:thu/kigen) (r:zd:16678/zd:24223) (q:draft)
thukik = (i:1) (t:v) (f:social/religion) (j:thukkik) (r:zd:20782/zd:15243) (q:draft)
thukikhen = (i:1) (t:v) (f:politics) (w:be sentenced/be judged) (d:<thu> and <kikhen> written as one word: judgment is given, a person is sentenced by a court; the penalty stands before it with {ding in}) (j:thu/kikhen) (r:zd:14595) (q:draft)
thukikum = (i:1) (t:v) (f:social/politics) (w:discuss/confer/hold talks) (d:<thu>, matter, and <kikum>, discuss, written as one word: talk a matter over together; <tawh> marks the other party) (j:thu/kikum) (r:zd:19749/zd:10797/ts:12498) (q:draft)
thukikup = (i:1) (t:v) (f:social/politics) (w:discuss/consult/hold talks) (d:<thu>, matter, and <kikup>, discuss, written as one word: talk a matter over together; also used as a noun, discussion) (j:thu/kikup) (r:zd:11006/zd:9426) (q:draft)
thukikupna = (i:1) (t:n) (f:social/politics) (w:discussion/talks/consultation/meeting) (d:<thu> and <kikupna> written as one word: a discussion of a matter, a meeting held for talks) (s:kikupna) (j:thu/kikupna) (r:zd:26566/zd:11244) (q:draft)
thukim = (i:1) (t:v) (f:social) (w:agree/consent) (d:be of one mind about a matter, or accept what is asked or proposed, from <thu>, matter, and <kim>, complete) (s:kithutuak) (a:nial) (q:draft)
thukimlo = (i:1) (t:v) (f:social) (w:disagree/not consent/refuse) (d:<thukim>, agree, and <lo>, not, written as one word: not agree to what is asked or proposed) (j:thukim/lo) (r:zd:23616/ts:3271/zd:21509) (q:draft)
thukimloh = (i:1) (t:v) (f:social/politics) (w:not agree/without consent) (d:<thukim>, agree, and the negative <loh> written as one word, mostly before <in>: without the agreement or consent of the one named) (j:thukim/loh) (r:zd:24906/zd:21843) (q:draft)
thukimna kinei = (i:1) (t:v) (f:social/politics) (w:it was agreed/an agreement was made) (d:<thukimna>, agreement, and <kinei>, here the passive of <nei>, have: an agreement is reached; follows a clause ending in <dingin> that says what was agreed, and closes reports of meetings) (r:zd:15275) (q:draft)
thukimna nei = (i:1) (t:v) (f:social/politics) (w:reach an agreement/agree/make a deal) (d:<thukimna>, agreement, and <nei>, have: come to an agreement or decide together; what is agreed stands before it, mostly as a clause ending in <ding> or <dingin>) (s:thukim) (r:zd:24458/zd:21357/zd:25602) (q:draft)
thukimnate = (i:1) (t:n) (f:social/politics) (w:agreements/resolutions) (d:plural of <thukimna>: the points agreed on, the resolutions of a meeting or conference) (b:thukimna) (r:zd:22365/zd:16385) (q:draft)
thukin = (i:3) (t:adj) (f:everyday/politics) (w:urgent/emergency/pressing) (d:<thu> matter with <kin> urgent: an urgent matter, and before a noun urgent or emergency, as in {thukin tangkona} urgent announcement, {thukin kikupna} emergency meeting and {a thukin lua} very urgent; not the {thukin} that means deep) (r:zd:23629/zd:25625/zd:19262) (q:draft)
thukipia = (i:1) (t:v) (f:politics/media) (w:be sentenced/be ordered) (d:<thu>, word or order, and <kipia>, be given, written as one word: a ruling is given, said in news reports of a court that sentences someone, as in {thong kiading in thukipia}, sentenced to prison) (j:thu/kipia) (r:zd:19745/zd:17357) (q:draft)
thukiza = (i:1) (t:phrase) (f:media) (w:it is reported/word is heard) (d:<thu> and <kiza> written as one word, at the end of a news report after <cih>: news is heard that, it is reported that; also the report that was heard) (j:thu/kiza) (r:ts:2424/zd:20080/zd:15554) (q:draft)
thukizakna = (i:1) (t:n) (f:media/social) (w:communication/news/news service) (d:<thu>, word or news, with <kizak>, be heard, and the noun suffix {-na}: the passing of news among people, communication, also a news outlet) (r:zd:24306/zd:23770/zd:24149) (q:draft)
thukizasak = (i:1) (t:v) (f:media/social) (w:notify/inform/let one another know) (d:<thu>, word, with <kizasak>, be made heard: send word to someone or pass news to one another) (j:thu/kizasak) (r:zd:16724/ts:4827) (q:draft)
thukkik = (i:2) (t:v) (f:social/everyday) (w:reply/answer/respond) (d:<thuk.3>, reply, with <kik>, back: answer a message, a letter or a question, with no thought of paying back a deed) (r:zd:12021) (q:draft, low confidence)
thukkikna = (i:2) (t:n) (f:everyday/social) (w:response/reaction) (d:the way one answers or reacts to what happens or to what another does, with no thought of paying back; in science writing the reaction that answers an action) (r:zd:20682) (q:draft)
thuklut = (i:1) (t:v) (f:everyday) (w:go deep into/penetrate/get deep inside) (d:<thuk>, deep, with <lut>, enter: enter deeply into a place, a group or the heart) (r:zd:24331/zd:23990) (q:draft, low confidence)
thukna = (i:3) (t:n) (f:nature/work) (w:acidity/sourness) (d:<thuk> in its meaning sour, with the noun suffix <na>: how acid something is; {leitangh thukna alna}, sourness and saltiness of the soil, is its acidity and alkalinity, given as a pH; not depth and not repayment) (r:zd:21006/zd:20747) (q:draft)
thukoh = (i:1) (t:n) (f:media) (w:report) (d:<thu>, news, with <koh>, bring up or present: a written report; seen only in the title of one article series, where it is glossed Report) (r:zd:17860) (q:draft, low confidence)
thukong = (i:1) (t:n) (f:social/religion) (w:opening/introduction/theme) (d:<thu>, word or matter, with <kong>, door: the opening of a matter; {thukong honna} is the opening speech of a meeting, and a {thukong} can be chosen as the theme for reflection) (r:zd:11447/zd:23483/zd:23880) (q:draft)
thukpitak = (i:1) (t:adv) (f:everyday/nature) (w:very deep/deeply) (d:<thukpi>, very deep, and <tak> written as one word: at or to a great depth, as in the ground) (j:thukpi/tak) (r:zd:19390/zd:12450) (q:draft)
thuksa = (i:1) (t:adj) (f:food) (w:dished out/served) (d:of food, already scooped out into a dish and ready to eat, from <thuk>, here ladle out, with <sa>, already: {an thuksa} is rice that has been dished out) (r:zd:22683/zd:23385) (q:draft, low confidence)
thuksuk = (i:1) (t:v) (f:nature/everyday) (w:go down deep/be deep) (d:<thuk>, deep, and <suk>, down, written as one word: reach down to the depth named) (j:thuk/suk) (r:zd:11219/zd:19109) (q:draft)
thuktak = (i:1) (t:adv) (f:everyday/education) (w:deeply/profoundly/in depth) (d:deep with <tak>: deeply, in depth, also as an adjective for a deep meaning; often followed by <a> or <in>) (r:zd:23943/zd:25339/zd:24499) (q:draft)
thukzawsem = (i:1) (t:adj) (f:everyday/religion) (w:even deeper/deeper still) (d:<thukzaw>, deeper, with <sem>, which after a comparative means still more, written as one word) (j:thukzaw/sem) (r:zd:17634) (q:draft)
thulaakna = (i:1) (t:n) (f:media) (w:source/news source) (d:<thu>, news, with <laakna>, taking, written as one word: the place a report is taken from, written before the name of the source) (j:thu/laakna) (r:zd:21288) (q:draft, low confidence)
thulaigil = (i:1) (t:n) (f:education/media) (w:main point/essence/core message) (d:<thu> and <laigil> written as one word: the central point of a matter, a story or a writing) (j:thu/laigil) (r:zd:21780/zd:21593) (q:draft)
thulam = (i:1) (t:n) (f:everyday/religion) (w:matter/aspect/side) (d:<thu>, matter, with <lam>, side, written as one word: the side or field of a matter; {Pasian thulam} is the things of God) (j:thu/lam) (r:zd:23784/zd:23543) (q:draft, low confidence)
thulamdang = (i:1) (t:n) (f:media/everyday) (w:strange thing/strange news/wonder/marvel) (d:<thu>, matter or news, and <lamdang>, strange, written as one word: a strange or astonishing event, or the report of one) (j:thu/lamdang) (r:zd:21876/zd:10992/zd:17595) (q:draft)
thulamdangpi = (i:1) (t:n) (f:everyday/media) (w:marvel/wonder/very strange thing) (d:<thu>, matter, and <lamdangpi>, very strange, written as one word: a very strange or amazing thing) (j:thu/lamdangpi) (r:zd:15174/zd:14587) (q:draft)
thuleh = (i:1) (t:phrase) (f:everyday) (w:matter and/word and) (d:<thu>, word or matter, and <leh>, and, written as one word, before a second noun) (j:thu/leh) (r:zd:17383) (q:draft)
thulehla = (i:1) (t:n) (f:social/education) (w:information/matters/affairs) (d:<thu>, <leh> and <la> written as one word, literally word and song: matters and information of every kind, what there is to know or deal with) (j:thu/leh/la) (r:zd:20003/zd:21198) (q:draft)
thulehlate = (i:1) (t:n) (f:social/education) (w:matters/information/affairs) (d:plural of <thulehla>: matters and pieces of information) (b:thulehla) (r:zd:21096/zd:11648) (q:draft)
thulela = (i:1) (t:n) (f:social) (w:ideas and advice/information/matters) (d:{thu le la}, word and song, written as one word: what one has to say, ideas, advice and information in general, often set against <sumlepai>, money) (j:thu/le/la) (r:zd:23959/zd:24028/zd:19521) (q:draft, low confidence)
thulelate = (i:1) (t:n) (f:social) (w:matters/affairs/issues) (d:plural of <thulela>, matters and information in general) (b:thulela) (r:zd:22595/zd:23207) (q:draft)
thuleng = (i:1) (t:n) (f:media/social) (w:rumor/hearsay) (d:<thu>, word, with <leng>, fly: news that flies about without being confirmed, a rumor) (a:thutak) (r:zd:22970/zd:24172) (q:draft)
thulianpi = (i:1) (t:n) (f:social) (w:great matter/big issue/serious matter) (d:<thulian>, great matter, with the strengthening ending <pi>: a very important or serious matter) (b:thulian) (r:zd:21347/zd:25673/zd:15848) (q:draft)
thulo = (i:1) (t:phrase) (f:everyday) (w:without/apart from) (d:<thu> and <lo> written as one word after a noun or pronoun: without it, leaving it out) (j:thu/lo) (r:zd:24289/zd:19239) (q:draft, low confidence)
thulu = (i:1) (t:n) (f:media/education) (w:title/heading/topic) (d:<thu>, matter, with <lu>, head: the title or heading of a writing, song or talk, and also its subject) (r:zd:15259/zd:9242/zd:19201) (q:draft)
thuluanzia = (i:1) (t:n) (f:education/social) (w:course of a matter/flow of thought/procedure) (d:<thu> matter with <luan> flow and <zia> manner: the way a matter or an argument runs from one step to the next) (r:zd:25678/zd:25687) (q:draft, low confidence)
thului = (i:1) (t:n) (f:media/education) (w:article/essay/write-up) (d:a written piece on one subject, as printed in a magazine, a journal or on a website) (r:zd:22803/zd:14703/zd:23860) (q:draft)
thulupi = (i:1) (t:n) (f:media/education) (w:main topic/theme/headline/main heading) (d:<thulu>, heading or topic, with {-pi}, chief: the main subject of a meeting or discussion, or the headline of a piece of news) (b:thulu) (r:zd:26658/zd:23361/zd:25020) (q:draft)
thulut = (i:1) (t:adj) (f:social/politics) (w:valid/official/accepted) (d:of a matter, a case or a statement: having force, counting as valid or official, being accepted) (r:zd:18234) (q:draft, low confidence)
thulute = (i:1) (t:n) (f:media/education) (w:topics/subjects/titles) (d:<thulu>, topic or title, with the plural <te>) (b:thulu) (r:zd:12871) (q:draft)
thuluui = (i:1) (t:n) (f:media/education) (j:thului) (r:zd:20538) (q:draft)
thuma = (i:1) (t:n) (f:everyday/media) (w:introduction/what comes before) (d:<thu>, matter, with <ma>, before: what comes before a matter, and as a heading the introduction; {thunung thuma} is the before and after of a matter, its background and its consequences) (r:zd:23554/zd:12389) (q:draft, low confidence)
thumaan = (i:2) (t:n) (f:everyday/religion) (w:truth/what is right) (d:{thumaan} standing alone as a noun, without <thutak> and not describing a person or thing: the truth, what is true and right, which one knows, speaks, hates or lacks) (r:zd:25153/zd:25266) (q:draft)
thumaan thutak = (i:1) (t:n) (f:social/religion) (w:truth/truth and righteousness) (d:<thumaan>, right, and <thutak>, truth, said as a pair: the truth, what is right and true; also written <thuman thutak>) (s:thuman thutak) (r:zd:21843/zd:25469) (q:draft)
thumaanin = (i:1) (t:adv) (f:religion/everyday) (w:rightly/justly/truthfully/in righteousness) (d:<thumaan>, truth or what is right, and <in> written as one word: in a true and upright way) (j:thumaan/in) (r:zd:9210/zd:9433) (q:draft)
thumaanlo = (i:1) (t:adj) (f:social) (j:thumanlo) (r:zd:25015/zd:19603) (q:draft)
thumah = (i:2) (t:phrase) (f:everyday/religion) (w:a matter indeed/the very word) (d:<thu>, word or matter, with the emphatic <mah>, written as one word: {a hithei thumah} is a thing that can indeed be, {Pasian' thumah} the word of God itself; not the number three of the other sense) (r:zd:20481/zd:15122) (q:draft, low confidence)
thumal = (i:1) (t:n) (f:education) (w:word/term) (d:<thu>, word or matter, with <mal>, a single unit: one word of a language) (s:kammal) (r:zd:19772/ts:1278/zd:20410) (q:draft)
thuman = (i:2) (t:n) (f:everyday/social) (w:truth) (d:used as a noun: the truth, what is right and true, standing as the subject of a sentence or before <tawh> or <pen>, where the adjective describes a person or a word) (r:zd:22046) (q:draft, low confidence)
thuman thutak = (i:1) (t:n) (f:social/religion) (w:truth/truth and justice/what is right and true) (d:<thuman>, what is right, and <thutak>, truth: a pair of words with one meaning, the truth, what is true and right) (r:zd:20902/zd:15794/zd:17976) (q:draft)
thumanglo = (i:1) (t:adj) (f:social/family) (w:disobedient/unruly) (d:<thumang>, obey, and <lo>, not, written as one word: not obeying parents, the law or those in authority) (j:thumang/lo) (r:zd:19571/zd:19621) (q:draft)
thumangte = (i:1) (t:n) (f:social/religion) (w:the obedient/those who obey) (d:<thumang>, obey, with the plural <te>: people who obey) (b:thumang) (r:zd:9433/zd:24064) (q:draft)
thumanlo = (i:2) (t:adj) (f:politics/social) (w:illegal/unlawful) (d:against the law, of an act or of the way something is done, often explained by the English word illegal; {thumanlo in} is illegally and {thumanlo gamtatna} illegal conduct) (r:zd:16720/zd:11310) (q:draft)
thumanlo = (i:3) (t:adj) (f:media/everyday) (w:untrue/false) (d:not in agreement with the facts, of news or of what is said or written, the opposite of <thuman> in its meaning true; also used as a noun, an untruth) (r:zd:19327/zd:15274/zd:20798) (q:draft)
thumanloh = (i:1) (t:v) (f:social) (w:be dishonest/be unfaithful/cheat) (d:<thuman>, true and honest, with the negative <loh>, written as one word: not be honest or faithful, act dishonestly) (j:thuman/loh) (r:zd:24314) (q:draft, low confidence)
Thumanlohna = (i:2) (t:n) (f:social/politics) (w:dishonesty/cheating/corruption) (d:an act of not being honest in an office, an exam or a deal, as {laihuanna thumanlohna}, cheating in an exam; said of single acts that can be punished, where the other sense is injustice as a state) (r:zd:12403/zd:15095) (q:draft)
thumanlopi = (i:1) (t:adv) (f:everyday/media) (w:falsely/untruthfully/unjustly) (d:<thuman>, true, and <lopi>, without, written as one word: without being true or right; with a verb of writing or saying, what is untrue) (j:thuman/lopi) (r:zd:11850/zd:14581) (q:draft)
thumasa = (i:1) (t:n) (f:media/education) (w:introduction/preface/foreword) (d:<thu>, word, with <masa>, first, written as one word: the opening part of an article, book or speech, often set as its first heading) (j:thu/masa) (r:zd:19577/ts:3737) (q:draft)
thumbang = (i:1) (t:num) (f:everyday) (w:about three/some three/as many as three) (d:<thum>, three, and <bang>, about, written as one word: three or so, as many as three) (j:thum/bang) (r:zd:12192) (q:draft)
thumeilet = (i:1) (t:n) (f:politics/social) (w:principle/policy/guiding rule) (d:a basic principle or standing rule that a person or an organisation holds to and acts by; listed beside <thukhun>, rules) (r:zd:24336/zd:23345) (q:draft, low confidence)
thumeilette = (i:1) (t:n) (f:politics/social) (w:principles/policies) (d:<thumeilet>, principle, with the plural <te>) (b:thumeilet) (r:zd:23742) (q:draft, low confidence)
thumlo = (i:1) (t:v) (f:everyday/body) (w:not moan/not complain) (d:<thum>, here groan or plead in pain or hardship, and <lo>, not, written as one word: without moaning or complaining, beside <tau>, groan) (j:thum/lo) (r:zd:19657/zd:21853) (q:draft, low confidence)
thumsung = (i:1) (t:adv) (f:time) (w:for three/during three) (d:<thum> and <sung> written as one word after a word of time: for three hours, days or the like) (j:thum/sung) (r:zd:21850) (q:draft)
thumtak = (i:1) (t:num) (f:everyday) (w:three/as many as three) (d:<thum>, three, with the strengthening <tak> written as one word after a noun: three of them, as many as three) (j:thum/tak) (r:zd:14626/zd:17143) (q:draft)
thumteng = (i:1) (t:num) (f:everyday) (w:all three) (d:<thum>, three, with <teng>, here all of: all three of the ones just named, placed after the noun) (r:zd:22350/zd:24641) (q:draft)
thumthum = (i:3) (t:v) (f:everyday/social) (w:moan/grumble/complain) (d:of a person, keep moaning or complaining about what one lacks or suffers; {a thumthum mi} is a person who is always moaning; not a request to someone, and not the sound of doves) (r:zd:21918/zd:16148) (q:draft, low confidence)
thumu = (i:2) (t:adj) (f:social/politics) (w:insightful/far-sighted/discerning) (d:used to describe a person or as the predicate, without <pa>: having insight into matters; {thumu makai} is a leader with insight and {thumu kisa} is think oneself insightful) (r:zd:25063/zd:21586/zd:23437) (q:draft)
thun = (i:2) (t:v) (f:work/everyday) (w:deposit/pay in/top up) (d:put money into an account, a machine or a phone balance, after <sum>, money; {sum thunna} is the place where money is paid in, and the first sense is putting a thing into a container) (r:zd:16660/zd:17126/zd:17327) (q:draft)
thun = (i:3) (t:v) (f:media) (w:score) (d:put the ball into the goal in football, after <goal>; {goal tam a thun pen} is the one who has scored the most goals) (r:zd:20145) (q:draft, low confidence)
thunawngkai = (i:1) (t:n) (f:social/media) (w:trouble/problem/incident) (d:<thu>, matter, with <nawngkai>, be troubled, written as one word: a troublesome matter, a problem, disturbance or incident that causes difficulty) (j:thu/nawngkai) (r:zd:12482/zd:21145/zd:19586) (q:draft)
thunbehding = (i:1) (t:v) (f:work) (w:to refill/to top up/to put more in) (d:<thun>, put in, with a middle part meaning in addition as in {thun beh}, and <ding>, to, written as one word: in order to put more money into a cash machine) (r:zd:15065) (q:draft, low confidence)
thunding = (i:1) (t:v) (f:work/travel) (w:to put in/to fill/to deposit) (d:<thun> and <ding> written as one word: in order to put in, of fuel into a vehicle or money into a machine) (j:thun/ding) (r:zd:15568/zd:12072) (q:draft)
thundingin = (i:1) (t:v) (f:travel/everyday) (w:to fill/to put in) (d:<thun>, put in, and <dingin>, in order to, written as one word: in order to put in; {datsi thundingin} is to fill up with fuel) (j:thun/dingin) (r:zd:18943) (q:draft)
Thunei = (i:2) (t:n) (f:politics) (w:official/authority/person in charge) (d:a person who holds authority in a government, the police, an armed group or an institution, after words such as <kumpi> and <palik>; with <te> the authorities; not a matter brought to be judged) (r:zd:22223/ts:4005/zd:21072) (q:draft)
thuneihnate = (i:1) (t:n) (f:politics/social) (w:powers/authorities/rights) (d:plural of <thuneihna>, authority) (b:thuneihna) (r:zd:25110/zd:21701) (q:draft)
thuneihnop = (i:1) (t:v) (f:politics/social) (w:want power/desire authority) (d:<thuneih>, have authority, and <nop>, want, written as one word; {thuneihnop luatna} is too great a desire for power) (j:thuneih/nop) (r:zd:20945/zd:25461) (q:draft)
thuneikhat = (i:1) (t:phrase) (f:politics/work) (w:an official/an officer in charge) (d:{thunei}, one who holds authority, compare <thuneite>, with <khat>, one, written as one word: an official or person in charge, of the police or another body) (r:zd:16934/zd:20122) (q:draft)
thuneipa = (i:1) (t:n) (f:politics/work) (w:official/officer in charge/man in authority) (d:the man who holds authority over something; {palik thuneipa} is a police official or spokesman, and with {tung a} before it, the one who has power over something) (r:zd:19906/zd:21232/zd:24004) (q:draft)
thuneipi = (i:1) (t:n) (f:politics/social) (w:chief authority/head/top leader/person in charge) (d:{thunei}, one who has authority, with {-pi}, great or chief: the person who holds the highest authority in a country, an army, a hospital or an organisation) (r:zd:17501/ts:8105/ts:4564) (q:draft)
thuneipipa = (i:1) (t:n) (f:politics/work) (w:chief/head/commander) (d:<thuneipi>, chief authority, with <pa> for a man: the man at the head, as {palik thuneipipa}, police chief; of God, sovereign) (s:thuneipi) (j:thuneipi/pa) (r:zd:21803/zd:18144) (q:draft)
thuneiten = (i:1) (t:n) (f:politics) (w:authorities/officials) (d:<thuneite>, the authorities, with the agent marker <in> shortened to <n>: the authorities as the ones who act or speak, as in {thuneiten gen hi}, the authorities said) (b:thuneite) (r:ts:4042/ts:3307) (q:draft)
thungai = (i:2) (t:v) (f:religion/social) (w:listen/hear/attend) (d:listen to a sermon or a speech as one of the audience, without the idea of obeying; {thungai mite} and {thungai dingte} are the listeners, as in <thungaite>) (r:zd:21063/zd:19206/zd:12337) (q:draft)
thungaihsutzia = (i:1) (t:n) (f:education/social) (w:way of thinking/philosophy/mindset) (d:<thungaihsut>, thinking, and <zia>, manner, written as one word: the way a person thinks about things) (j:thungaihsut/zia) (r:zd:21605/zd:22649) (q:draft)
thungena = (i:1) (t:v) (f:religion) (w:pray) (d:<thungen>, pray, with the linking <a> written on to it: prayed and, praying) (j:thungen/a) (r:zd:24604/zd:9219) (q:draft)
thungending = (i:1) (t:v) (f:religion) (w:to pray/in order to pray) (d:<thungen>, pray, and <ding> written as one word: to pray, going to pray) (j:thungen/ding) (r:zd:16794/zd:18289) (q:draft)
thungenna = (i:1) (t:n) (f:religion) (w:prayer) (d:<thungen>, pray, with the noun suffix {-na}: a prayer, or the prayer as a part of a meeting; the same as <thungetna>) (s:thungetna) (b:thungen) (r:zd:15865/zd:23629) (q:draft, low confidence)
thunget khopna = (i:1) (t:n) (f:religion) (w:joint prayer/prayer meeting/praying together) (d:<thunget>, pray, and <khopna>, doing together: prayer by several people together, a prayer meeting; often the object of <nei>, hold) (r:zd:14801/zd:20874) (q:draft)
thungetna kinei = (i:1) (t:v) (f:religion/social) (w:prayer is held/a prayer meeting is held) (d:<thungetna>, prayer, and <kinei>, here the passive of <nei>, have or hold: prayer is held, a prayer meeting takes place; the place with <ah> and the purpose with <adingin> stand before it) (r:zd:17126/zd:23005) (q:draft)
thungetpih = (i:1) (t:v) (f:religion) (w:pray for/pray with) (d:<thu> and <ngetpih> written as one word: pray for someone or pray together with someone; also of the people one prays with) (j:thu/ngetpih) (r:ts:8130/zd:11386) (q:draft)
thungkuah = (i:1) (t:n) (f:home/travel) (w:shoulder bag/sling bag/handbag) (d:a bag worn on a strap over the shoulder; in the articles it glosses sling bag, backpack and handbag; compare <thung-ip> and <kuah>, strap on) (r:zd:22683/zd:15178/zd:17262) (q:draft)
thunial = (i:1) (t:v) (f:social/politics) (w:defy/disobey/argue back) (d:<thu>, word or order, with <nial>, refuse, written as one word: refuse what one is told, defy an authority; also of one who is quick to contradict) (j:thu/nial) (r:zd:10910/zd:23432) (q:draft)
thunih = (i:1) (t:n) (f:everyday) (w:two things/two matters) (d:<thu> and <nih> written as one word: two matters, two points) (j:thu/nih) (r:zd:19654/zd:16035) (q:draft)
thunihte = (i:1) (t:n) (f:everyday) (w:the two matters/the two points) (d:<thunih>, two matters, with the plural marker <te>: the two things spoken of) (b:thunih) (j:thunih/te) (r:zd:17437/zd:21279) (q:draft)
thunlaitak = (i:1) (t:v) (f:travel/everyday) (w:while filling/while putting in) (d:<thun>, put in, and <laitak>, while, written as one word: at the very time of putting in, as fuel into a vehicle) (j:thun/laitak) (r:zd:18943/zd:17947) (q:draft)
thunman = (i:1) (t:n) (f:work) (w:filling charge/refill price) (d:<thun>, put in or fill, and <man>, price, written as one word: the price paid for filling something, as a gas cylinder; in one article the word seems to be a misspelling of <thuman>) (j:thun/man) (r:zd:22502) (q:draft, low confidence)
thunna = (i:1) (t:n) (f:everyday/travel) (w:filling/place for filling/thing for putting in) (d:<thun>, put into or fill, with the noun ending {-na}: the act, place or device of putting something in; {datsi thunna} is a petrol station and {sum thunna} a place for paying in money) (b:thun) (r:zd:13161/zd:16660) (q:draft)
thunolhna = (i:1) (t:n) (f:politics/social) (w:disobedience/refusal to obey) (d:<thu>, word or order, with <nolh>, refuse, and the noun ending {-na}: refusing to obey; {tangpi' thunolhna} is civil disobedience, the Zolai wording for CDM) (r:ts:4831) (q:draft)
thunsak = (i:1) (t:v) (f:work/everyday) (w:put in for/pay in/deposit) (d:<thun>, put into, and <sak.1> written as one word: put something into a container, or pay money into an account or fund, for someone or at their request) (b:thun) (j:thun/sak) (r:zd:17021/zd:23367/zd:22439) (q:draft)
thunthun = (i:1) (t:v) (f:everyday/work) (w:keep putting in/put in again and again) (d:<thun>, put into, said twice: go on putting or pouring something in, as water into a pot or money into a bank or a phone) (b:thun) (r:zd:11135/zd:24022) (q:draft, low confidence)
thunuai = (i:1) (t:n) (f:politics/social) (w:authority/rule/control) (d:<thu>, word or authority, and <nuai>, under, written as one word and followed by <ah>: under the rule, command or control of the one named before it) (j:thu/nuai) (r:zd:23893/zd:22713/ts:838) (q:draft)
thunuam = (i:3) (t:adj) (f:social) (w:good-natured/kind/amiable/easy to get on with) (d:of a person's character, pleasant and easy to deal with, as in {mi thunuam}, a good-natured person, often with <mahmah>; a lasting quality, not kindness shown to one person with <tungah>) (r:zd:14814/zd:23086/zd:23319) (q:draft)
thunung = (i:1) (t:n) (f:everyday/social) (w:consequence/outcome/aftermath) (d:what comes after a matter, from <thu> and <nung>; mostly in the pair {thunung thuma}, what follows a matter and what goes before it, all its ins and outs) (r:zd:23554/zd:22565) (q:draft)
thupai = (i:1) (t:n) (f:everyday/social) (w:course of things/way things go/process) (d:<thu>, matter, with <pai>, go: how a matter proceeds, mostly as {thupai zia} or {thupai dan}, the way things work; in some articles also a phrase or expression beside <laimal>, a word) (r:zd:26565/zd:24034) (q:draft, low confidence)
thupaizia = (i:1) (t:n) (f:everyday/politics) (w:procedure/course of a matter/process) (d:<thu>, matter, and <paizia>, way of going, written as one word: how a matter proceeds, the proper order in which it is dealt with) (j:thu/paizia) (r:zd:24931/zd:20239) (q:draft)
thupatna = (i:1) (t:n) (f:education/media) (w:introduction/opening) (d:<thu>, matter, with <patna>, beginning: the opening part of an article, sermon or speech) (a:thukhupna) (r:zd:21075/zd:21083) (q:draft)
thupawlkhat = (i:1) (t:n) (f:everyday/media) (w:some things/some matters/a few points) (d:<thu>, matter, and <pawlkhat>, some, written as one word: some matters, a number of things to say or to know) (j:thu/pawlkhat) (r:zd:24276/zd:13026/zd:22217) (q:draft)
thupen = (i:1) (t:n) (f:everyday) (w:the matter/the subject) (d:<thu>, matter, with the topic marker <pen> written as one word: as for the matter, mostly as {hih thupen}, this matter) (j:thu/pen) (r:zd:10731/zd:20829) (q:draft)
thupha hongpia = (i:1) (t:v) (f:religion) (w:bless us/bless you) (d:<thupha>, blessing, and <hongpia>, give us or give you: bless; the closing wish of a letter or notice, with {Topa'n} before it and <hen> or <tahen> after it, may the Lord bless you) (r:zd:21520/zd:14992) (q:draft)
thupha pia = (i:1) (t:v) (f:religion) (w:bless/give a blessing) (d:<thupha>, blessing, and <pia>, give: bless; the one who blesses stands before it with <in> and the one blessed stands directly before it or with <tungah>) (a:hamsiat) (r:zd:23777/zd:25484/zd:19663) (q:draft)
thupha piakna = (i:1) (t:n) (f:religion) (w:benediction/blessing) (d:<thupha>, blessing, and <piakna>, giving: the benediction, the blessing that a minister speaks to close a service or a gathering; the name of the minister stands before it, and {tawpna thupha piakna} is the closing benediction) (r:zd:21771/ts:10085) (q:draft)
thuphabawl = (i:1) (t:v) (f:social/religion) (w:do good to/do a favour/bless) (d:<thupha>, blessing, with <bawl>, do, written as one word: do good to someone, show kindness) (j:thupha/bawl) (r:zd:15243) (q:draft, low confidence)
thuphamawh = (i:1) (t:n) (f:media/everyday) (w:urgent matter/emergency/breaking news) (d:<thu>, matter, with <phamawh>, serious, written as one word: a serious or urgent matter) (j:thu/phamawh) (r:zd:23767/zd:19295) (q:draft)
thuphangah = (i:1) (t:adj) (f:religion) (w:blessed) (d:<thupha> and <ngah> written as one word: having received blessing, blessed; {thuphangah minam} is a blessed people) (j:thupha/ngah) (r:zd:8668/zd:16989) (q:draft)
thuphapiakna = (i:1) (t:n) (f:religion) (w:blessing/benediction) (d:<thupha> and <piakna> written as one word: the giving of a blessing, the benediction in a service) (j:thupha/piakna) (r:zd:10794/zd:9243) (q:draft)
thupi kasa = (i:1) (t:v) (f:social) (w:I value/I appreciate/I hold in high regard) (d:<thupi>, important, and <kasa>, I find: I regard the person or thing named before it as important, said in thanks and tribute; often followed by <mahmah>) (r:zd:17291/zd:23311) (q:draft)
thupi kisa = (i:1) (t:v) (f:social/everyday) (w:be highly regarded/be admired/be thought important) (d:<thupi>, important or great, and <kisa>, be considered: be thought great, be held in high regard; the person or deed that is admired stands before it, often with <pen>, and <mahmah> often follows) (r:zd:22828/zd:12113/zd:21706) (q:draft)
thupiak = (i:2) (t:n) (f:social/religion/politics) (w:command/order/commandment) (d:used as a noun after the one who gives it: an order of a ruler, the police or God, as in {Pasian thupiak}, the command of God, and {Thupiak 10}, the Ten Commandments; sense 1 is the verb) (r:zd:23394/zd:24064/zd:16450) (q:draft)
thupiang ahihi = (i:1) (t:phrase) (f:media) (w:it happened/it took place) (d:<thupiang>, a happening, and <ahihi>, it is: the closing formula of a news report, it is a thing that happened; the time or place with <in> or <ah> stands before it, and the report often opens with {hih thupiang pen}, this incident) (r:zd:12427/zd:19445/zd:10992) (q:draft)
thupiang kici = (i:1) (t:phrase) (f:media) (w:reportedly happened/is said to have happened) (d:<thupiang>, event, here used as a verb, the matter happened, with <kici>, it is said: closing formula of a news report, after the place with <ah> and the day with <in>, and followed by <hi>) (r:zd:15125/zd:20767) (q:draft)
thupiangpen = (i:1) (t:phrase) (f:media) (w:the incident/the event) (d:<thupiang>, event, and the topic marker <pen> written as one word: marks the incident as what the sentence is about; {hih thupiangpen} is as for this incident) (j:thupiang/pen) (r:zd:18110/zd:14778) (q:draft)
thupiangsa = (i:1) (t:n) (f:everyday/media) (w:past event/what has happened) (d:<thupiang> with <sa>, here already, written as one word: something that has already happened, a past event or experience) (b:thupiang) (r:zd:8375/zd:14611) (q:draft)
thupibawl = (i:1) (t:v) (f:social) (w:honour/esteem/treat as important) (d:<thupi>, important, and <bawl>, make, written as one word: treat someone as important, give honour to) (j:thupi/bawl) (r:zd:19998/zd:21110) (q:draft)
thupiding = (i:1) (t:adj) (f:everyday) (w:will be important/be essential) (d:<thupi> and <ding> written as one word, mostly after a verb with <ding>: it is important to do so) (j:thupi/ding) (r:zd:15949/zd:20498) (q:draft)
thupiit = (i:1) (t:adj) (f:everyday/social) (j:thupit) (r:zd:20728/zd:24672) (q:draft)
thupiitsak = (i:1) (t:v) (f:social) (j:thupitsak) (r:zd:19850) (q:draft)
thupil = (i:1) (t:n) (f:social/education) (w:proverb/wise saying/maxim) (d:a short saying that holds wisdom, <thu> with <pil>, wise; often paired with <paunak>) (s:paunak) (r:zd:23835/zd:11163) (q:draft)
thupilo = (i:1) (t:adj) (f:everyday) (w:unimportant/trivial/not important) (d:<thupi>, important, and <lo>, not, written as one word) (j:thupi/lo) (r:zd:12391/zd:25580/zd:23635) (q:draft)
thupilua = (i:1) (t:adj) (f:everyday) (w:very important/so important) (d:<thupi> and <lua> written as one word; with <lo> or <ahilo>, not so important) (j:thupi/lua) (r:zd:20979/zd:14787) (q:draft)
thupina = (i:2) (t:n) (f:everyday/education) (w:importance/significance) (d:how much a thing matters, said of everyday things such as food, health or a habit and not of the splendor of a person; usually {a thupina}, its importance, after a verbal noun, or beside <manphatna>) (r:zd:22740/zd:9430/zd:20410) (q:draft)
thupingaihsut = (i:1) (t:n) (f:social/religion) (w:values/priority) (d:<thupi>, important, and <ngaihsut>, consider, written as one word: what a person or group counts as important; once glossed with English values) (j:thupi/ngaihsut) (r:zd:21140) (q:draft, low confidence)
thupisa = (i:1) (t:v) (f:everyday/social) (w:value/consider important/think highly of) (d:<thupi>, important, with <sa>, here feel or consider: regard a person or thing as important) (j:thupi/sa) (r:zd:24068/zd:9221/zd:21978) (q:draft)
thupisakin = (i:1) (t:v) (f:everyday/social) (w:valuing highly/regarding as important) (d:<thupisak> and <in> written as one word: holding something to be important, and so doing what follows) (b:thupisak) (j:thupisak/in) (r:zd:20979/zd:24202) (q:draft)
thupisakna = (i:1) (t:n) (f:social) (w:esteem/valuing/regard) (d:<thupisak>, value highly, with the noun suffix <na>: treating something as important, the high value set on it) (b:thupisak) (r:zd:15794/zd:9449) (q:draft)
thupisakzaw = (i:1) (t:v) (f:everyday/social) (w:value more/regard as more important) (d:<thupisak>, value highly, and <zaw>, more, written as one word; the thing compared stands before it with <sangin>) (j:thupisak/zaw) (r:zd:9241/zd:23343) (q:draft)
thupisimlo = (i:1) (t:v) (f:social/everyday) (w:disregard/not take seriously/slight) (d:<thupisim>, take seriously, and <lo>, not, written as one word) (j:thupisim/lo) (r:zd:11466/zd:24392) (q:draft)
thupit = (i:1) (t:adj) (f:everyday/social) (w:important/great) (d:form of <thupi>, important, used before words such as <lam>, <sak>, <ngaihsut> and <luatna>; {a thupit lam} is how important it is) (b:thupi) (r:zd:22650/zd:21142/zd:25390) (q:draft)
thupitak = (i:1) (t:adv) (f:everyday/social) (w:greatly/grandly/solemnly) (d:<thupi>, great or important, and <tak> written as one word: in a great, grand or solemn way, mostly as {thupitak in}; before a noun, great) (j:thupi/tak) (r:zd:20747/zd:25908/zd:10743) (q:draft)
thupitakin = (i:1) (t:adv) (f:social) (w:grandly/solemnly/with honour) (d:<thupitak> with <in>, written as one word: in a grand, solemn or important way) (j:thupitak/in) (r:zd:23767/zd:21904) (q:draft)
thupitna = (i:2) (t:n) (f:everyday/social) (w:importance/significance/value) (d:<thupi>, important, with the noun suffix <na>: how much a person, thing or matter counts, as in {hun thupitna}, the importance of time; not the majesty of God or a king) (r:zd:21463/zd:21224/zd:20719) (q:draft)
thupitsak = (i:1) (t:v) (f:social) (w:value highly/regard as important/esteem) (d:form of <thupisak> used before <ding> and when the verb stands as a noun: {ih thupitsak} is what we hold important) (s:thupisak) (r:zd:10777/zd:18958/zd:16404) (q:draft)
thupitzia = (i:1) (t:n) (f:everyday/social) (w:importance/greatness) (d:<thupit> with <zia>, manner, written as one word: how important or great someone or something is) (j:thupit/zia) (r:zd:19621/zd:24336) (q:draft)
thupoimawh = (i:1) (t:n) (f:everyday/social) (w:important matter/urgent matter) (d:<thu>, matter, and <poimawh>, important, written as one word) (j:thu/poimawh) (r:ts:11162/zd:15818) (q:draft)
thupom = (i:1) (t:n) (f:religion/social) (w:doctrine/belief/tenet) (d:<thu> with <pom>, hold fast: what a person or a church holds to be true, a doctrine or conviction) (r:zd:22581/zd:22709/ts:9862) (q:draft)
thupomzia = (i:1) (t:n) (f:religion/education) (w:belief/doctrine/view/conviction) (d:the way a matter is held, from <thu>, <pom>, hold fast, and <zia>, manner: what a person or a church believes about something) (r:zd:24304/zd:25749/zd:22858) (q:draft)
thupomziate = (i:1) (t:n) (f:religion/education) (w:beliefs/views/convictions) (d:<thupomzia>, belief or view, with the plural <te>: the beliefs or views a person holds) (b:thupomzia) (r:zd:21605/zd:21225) (q:draft)
thupuakna = (i:1) (t:n) (f:media/social) (w:message/statement/announcement) (d:<thupuak>, message, with the noun ending {-na}: the sending of a message, or the message or statement sent out) (b:thupuak) (r:ts:1666) (q:draft)
thupulaakna = (i:1) (t:n) (f:media/politics) (j:thupulakna) (r:zd:14577/zd:16150) (q:draft)
thupulak = (i:1) (t:v) (f:media/social) (w:announce/make an announcement) (d:<thu>, word, with <pulak>, make known: announce something to a gathering or to the public; in a programme also the heading for the one who makes the announcements; <thupulakna> is the announcement) (r:zd:21908) (q:draft)
thupulakna = (i:1) (t:n) (f:media/politics) (w:announcement/statement/press release) (d:<thu>, word, with <pulakna>, announcement: a public statement by an organisation or office; {thupulakna nei} is issue a statement) (s:pulakna) (r:ts:5907/zd:15664/zd:20084) (q:draft)
Thursday = (i:1) (t:n) (c:ni) (f:time) (w:Thursday) (s:laiziing/khani) (o:English) (r:zd:15461/zd:19788) (q:draft)
thusa = (i:1) (t:v) (f:social/everyday) (w:regard as important/care about/mind) (d:count something as a matter that counts; {ama thu bek thusa} is to regard only his own matter as important) (r:zd:21911/zd:11135/zd:19381) (q:draft)
thusa = (i:2) (t:n) (f:social/family) (w:spokesman/adviser) (d:a role in Zo custom: the person appointed to speak and advise for a household or clan in its affairs; {beh thusa} is the one of a clan) (r:zd:23990) (q:draft, low confidence)
thusai = (i:1) (t:n) (f:politics/work) (w:person in charge/authority/official/management) (d:<thu>, matter, with <sai>, be in charge of: the one who is in charge of a matter or place, often plural as {thusai te}, the authorities) (r:zd:15487/zd:13155) (q:draft)
thusapi = (i:1) (t:n) (f:social/work) (w:secretary/general secretary) (d:the chief secretary of an organisation, named beside the president; writers add the English word secretary or Secretary-General to it) (r:zd:25392) (q:draft)
thusate = (i:1) (t:n) (f:social/family) (w:spokesmen/advisers) (d:plural of <thusa.2>: the persons who speak and arrange matters on behalf of a household in Zo custom) (b:thusa) (j:thusa/te) (r:zd:23990) (q:draft, low confidence)
thusau = (i:1) (t:n) (f:everyday) (w:long matter/long story) (d:<thu>, matter, with <sau>, long, written as one word: a matter that is long or reaches far ahead; {thusau khual} is taking the long view) (j:thu/sau) (r:zd:20929/zd:25399) (q:draft, low confidence)
thusaupi = (i:1) (t:n) (f:everyday/education) (w:long story/long matter/long account) (d:<thu>, word or matter, and <saupi>, very long, written as one word: a long thing to tell or think about; before another noun, long-term) (j:thu/saupi) (r:zd:23268/zd:16428) (q:draft)
thusia lasia = (i:1) (t:n) (f:social/everyday) (w:bad things/evils/troubles/bad news) (d:<thusia>, a bad matter, doubled with {lasia}, bad song, after the pair {thu le la}, word and song: bad things of every kind, evil happenings, wrongdoing and bad news; the opposite is {thu hoih la hoih}) (r:zd:16254/zd:24481) (q:draft)
thusiam = (i:1) (t:adj) (f:social) (w:courteous/kind/polite/hospitable) (d:pleasant and considerate in the way one speaks to and treats others; {thusiam lo} is impolite, unkind) (r:zd:22658/zd:17291/zd:26643) (q:draft)
thusiamna = (i:1) (t:n) (f:social) (w:courtesy/kindness/invitation) (d:a kind arrangement made for someone; {thusiamna tawh} is by courtesy of, at the kind invitation of the one who arranges a visit) (b:thusiam) (r:zd:24594/zd:25616/ts:301) (q:draft, low confidence)
thusim = (i:2) (t:n) (f:everyday) (w:secret/mystery) (d:a matter that is hidden or known to few, as a noun after <a> or <tua> and before <khat>: {thusim khat} is a secret, unlike the verb of regard) (s:thuthuk) (r:zd:24253/zd:17328/zd:21362) (q:draft)
thusimlo = (i:1) (t:v) (f:social/everyday) (w:disregard/ignore/pay no heed/disrespect) (d:<thusim> and <lo> written as one word: take no notice of a person, an order or a custom; {mi thusimlo} is a heedless person) (j:thusim/lo) (r:zd:16009/zd:21341/zd:23680) (q:draft)
thusimsak = (i:1) (t:v) (f:social) (w:regard/respect/take notice of) (d:<thusim>, pay regard, with <sak>: give regard to a person or to what he does or says; {thusimsak lo} is take no account of) (b:thusim) (r:zd:20941/zd:24313) (q:draft)
thusin = (i:1) (t:v) (f:education/religion) (w:study/learn/attend a course) (d:<thu> and <sin> written as one word: study a subject or attend teaching or training, also as a noun, a lesson or course; {thusin hun} is the time of the class and {thusin mi} a participant) (j:thu/sin) (r:zd:17723/zd:24574/zd:10966) (q:draft)
thusinna = (i:1) (t:n) (f:education/religion) (w:lesson/study/training/teaching session) (d:<thu> with <sinna>, learning: a lesson, class or training in which a subject is taught and studied, as in Sunday school, a seminar or a course; {thusinna pia} is give a training) (r:zd:9430/zd:20403/zd:26643) (q:draft)
thusinnate = (i:1) (t:n) (f:education/religion) (w:lessons/studies/trainings) (d:<thusinna>, lesson or study, with the plural <te>) (b:thusinna) (j:thusinna/te) (r:zd:20775) (q:draft)
thusit = (i:2) (t:v) (f:politics/social) (w:interrogate/question) (d:question a person who is held, as the police or soldiers do, sometimes with beating; {thusit thudotna} is an interrogation and {thusit thuak} is be interrogated, where the first sense is a trial in court) (r:zd:19465/zd:14701/zd:18014) (q:draft)
thusitding = (i:1) (t:v) (f:politics) (w:to question/to interrogate/for questioning) (d:<thusit> and <ding> written as one word: in order to question someone or examine a case) (j:thusit/ding) (r:zd:14797) (q:draft)
thusitna kinei = (i:1) (t:v) (f:politics/media) (w:be questioned/be interrogated/be examined) (d:<thusitna>, examination of a case, and <kinei>, be held: questioning is held, said of a suspect who is questioned by the police or brought before a court; the person questioned stands before it) (r:zd:17145/zd:17149) (q:draft)
thusitna nei = (i:1) (t:v) (f:politics) (w:question/examine/investigate) (d:<thusitna>, examination, and <nei>, have: of police, officials or a court, question or examine people, check them or try their case; the persons examined stand before it) (r:zd:17524/zd:13255) (q:draft)
thusittel = (i:1) (t:v) (f:work/politics) (w:investigate/examine/analyse) (d:<thu>, matter, with <sittel>, examine: look closely into a matter; also the work of doing so) (j:thu/sittel) (r:zd:15681/zd:16406) (q:draft, low confidence)
thusuah = (i:1) (t:n) (f:politics/media) (w:statement/announcement/declaration) (d:<thu>, word, with <suah>, bring out: something made public in writing, as a statement of an organisation or a post on social media; {kumpi thusuah} is an edict) (r:zd:25022/zd:16210/zd:25461) (q:draft)
thusuahna = (i:2) (t:n) (f:media/politics) (w:statement/announcement/press release) (d:a public statement put out by an organisation or authority, mostly in <thusuahna nei> or {thusuahna bawl}, issue a statement; not an account given before a judge) (r:ts:4549/ts:8561/ts:4005) (q:draft)
thusuahna nei = (i:1) (t:v) (f:media/politics) (w:issue a statement/make an announcement) (d:<thusuahna>, statement, and <nei>, have: an organisation puts out a public statement or press release; the organisation stands before it with <in>, and what is stated comes first, often closed by {cih thu} or {ci-in}) (r:ts:4549/zd:15329/ts:8561) (q:draft)
thusuak = (i:1) (t:n) (f:media/religion) (w:revelation/insight/report) (d:a word or message that comes out: an insight or revelation that a person receives, as in {thusuak ngah}, and a statement or report that is issued; also used as a verb, be reported) (r:zd:15272/zd:24375) (q:draft, low confidence)
thusun = (i:1) (t:n) (f:social/politics) (w:proposal/motion/submission) (d:a matter put before a meeting to be discussed or decided, or a statement presented there) (r:zd:9142/zd:12341) (q:draft, low confidence)
thusung = (i:1) (t:v) (f:social/education) (w:present/give a talk/put forward) (d:<thu>, matter, with a verb meaning pour out: present a subject or put a matter forward at a meeting or seminar; also the one who presents) (r:zd:23361/zd:16150) (q:draft, low confidence)
thusung = (i:2) (t:n) (f:education/media) (w:content/substance) (d:<thu> and <sung>, inside, written as one word: what a text or matter contains, its substance) (j:thu/sung) (r:zd:11170/zd:15047) (q:draft, low confidence)
thusungah = (i:1) (t:phrase) (f:religion) (w:in the word) (d:<thu>, word, and <sungah>, inside, written as one word: in the word, mostly after <Pasian> or {Topa'}, in the word of God) (j:thu/sungah) (r:zd:23432/zd:17087) (q:draft)
thusunna = (i:1) (t:n) (f:politics/social) (w:statement/address/submission) (d:what a person puts forward in words before a meeting or the public, such as a member's address or motion in parliament) (r:zd:26658/zd:16150) (q:draft, low confidence)
thusunte = (i:1) (t:n) (f:media/politics) (w:proposals/submissions/pieces) (d:<thusun> with the plural <te>: things put forward for others to consider, as proposals or written pieces sent to a paper) (b:thusun) (r:zd:17344) (q:draft, low confidence)
thutam = (i:1) (t:adj) (f:everyday/social) (w:much to say/involved) (d:<thu>, matter or word, and <tam>, many, written as one word: there is much to say, the matter has many sides) (j:thu/tam) (r:zd:25043/zd:23112) (q:draft)
thutampi = (i:1) (t:phrase) (f:everyday) (w:many things/many matters/much) (d:<thu> and <tampi> written as one word: many matters, many things to say or think about) (j:thu/tampi) (r:zd:20798/zd:17000) (q:draft)
thutangko = (i:1) (t:v) (f:media/religion) (w:proclaim/announce) (d:<thu> and <tangko> written as one word: proclaim a message, make an announcement; with <na> it is the announcement itself) (j:thu/tangko) (r:zd:12231/zd:11062) (q:draft, low confidence)
thutangkona = (i:1) (t:n) (f:media/social) (w:announcement/proclamation) (d:<thu> and <tangkona> written as one word: a public announcement of news or a message) (j:thu/tangkona) (r:zd:15031) (q:draft)
thutawh = (i:1) (t:phrase) (f:everyday/religion) (w:with the word/with the matter) (d:<thu>, word or matter, and <tawh>, with, written as one word: {Pasian thutawh} is with the word of God, {tua thutawh kisai} is concerning that matter, and <zawhthawh thutawh> is by force) (j:thu/tawh) (r:zd:15941/zd:21657/zd:19308) (q:draft)
thuthak = (i:1) (t:n) (f:social) (w:news/new message/new thing) (d:<thu>, word or matter, with <thak>, new; {thuthak hoih} is good news) (s:thuzak/thupuak) (q:draft)
thuthak tomkim = (i:1) (t:n) (f:media) (w:news in brief/news summary/brief news) (d:<thuthak>, news, and <tomkim>, brief and complete: the short summary of news, used as the heading of a column of short news items) (r:zd:24643) (q:draft)
thuthang = (i:1) (t:n) (f:media) (w:news/report/rumour) (d:what is being told about a place or an event, the news of it, whether confirmed or not) (s:thuzak) (r:zd:14965/zd:14652/zd:12407) (q:draft)
thuthangkhat = (i:1) (t:n) (f:media) (w:a news story/a piece of news/a report) (d:<thuthang>, news, and <khat>, one, written as one word) (j:thuthang/khat) (r:zd:22728/zd:19906) (q:draft)
thuthangpen = (i:1) (t:n) (f:media) (w:the news/the report) (d:<thuthang> and the topic marker <pen> written as one word: this news or report, as the subject of the sentence) (j:thuthang/pen) (r:zd:19197/zd:17547) (q:draft)
thuthuk = (i:2) (t:n) (f:religion/education) (w:theology/doctrine) (d:in {Pasian thuthuk}, the deep things of God as a subject of study, <theology>; {Pasian thuthuk sinna} is theological study or a theological school) (r:zd:19093/zd:10966/zd:25891) (q:draft)
thuthuk = (i:3) (t:adj) (f:everyday/education) (w:profound/deep) (d:of a matter, a speech or a thought, deep and hard to grasp; used as a describing word before <mahmah> or before a noun, as in {thuthuk ngaihsutna}, deep thinking) (r:zd:12785/zd:20786) (q:draft)
thuthum = (i:1) (t:phrase) (f:everyday) (w:three things/three points) (d:<thu>, matter, and <thum>, three, written as one word: three matters or points) (j:thu/thum) (r:ts:3366/zd:16989) (q:draft)
thuthuuk = (i:1) (t:n) (f:religion/education) (j:thuthuk) (r:zd:16428) (q:draft)
thutom = (i:1) (t:n) (f:social/media) (w:short speech/brief remarks/brief statement) (d:<thu>, word, with <tom>, short: a short speech or a statement in brief; {thutom gen} is give a short speech) (j:thu/tom) (r:zd:15011/zd:25118) (q:draft)
thutuah = (i:1) (t:v) (f:social) (w:agree/be of one mind/be united) (d:used with <ki> as {ki thutuah}: agree with one another, be reconciled and united) (s:thutuak) (r:zd:19322/zd:25342) (q:draft)
thutuahna = (i:1) (t:n) (f:social/family) (w:unity/agreement/harmony) (d:the being of one mind with each other, used with <ki> as {ki thutuahna}) (b:thutuah) (r:zd:20888) (q:draft)
thutuak = (i:1) (t:v) (f:social) (w:agree/be of one mind/be united) (d:used with <ki> as {ki thutuak}, the same as <kithutuak>: agree with one another, be united) (r:zd:12337/zd:20888/zd:11176) (q:draft)
thutuam = (i:1) (t:n) (f:everyday) (w:another matter/separate matter) (d:<thu>, matter, and <tuam>, separate, written as one word: a different matter, something to be kept apart from what is discussed; {thutuam in koih} is set aside) (j:thu/tuam) (r:zd:25457/zd:15884/zd:24731) (q:draft)
thutuamin = (i:1) (t:adv) (f:everyday) (w:as a separate matter/aside) (d:<thutuam> and <in> written as one word: as a separate matter; with <koih>, set aside) (j:thutuam/in) (r:zd:24253/zd:24491) (q:draft)
thutuamtuam = (i:1) (t:n) (f:media) (w:various news/miscellaneous matters) (d:<thu> and <tuamtuam> written as one word: news or matters of various kinds, common at the end of a headline) (j:thu/tuamtuam) (r:zd:24488/zd:22590) (q:draft)
thuuk = (i:1) (t:adj) (f:everyday/nature) (w:deep/profound) (d:deep, of a valley, mud or water, and of thought, language or a relationship; the same word as <thuk> in <athuk>, written with a long vowel; {thuuk sak} is deepen) (a:sang) (r:zd:21027/zd:9433/zd:22827) (q:draft)
thuukpi = (i:1) (t:adj) (f:nature/everyday) (w:very deep/profound) (d:<thuuk>, deep, with the suffix {-pi}, great: very deep, of a place far down and of a matter or thought; as a noun a deep gorge) (b:thuuk) (r:zd:18147) (q:draft)
thuumkik = (i:1) (t:v) (f:social) (w:apologize/beg pardon) (d:<thuum>, plead, and <kik>, back, written as one word: say sorry after a mistake, beg to be forgiven) (j:thuum/kik) (r:zd:14581/zd:11396) (q:draft, low confidence)
thuumkik = (i:2) (t:v) (f:politics) (w:appeal/plead again) (d:<thuum> and <kik>, again, written as one word: plead once more after a refusal, as in an appeal against a rejected case) (j:thuum/kik) (r:zd:17393) (q:draft, low confidence)
thuumlo = (i:1) (t:adj) (f:religion) (w:unbelieving/unbeliever) (d:<thu>, <um> and <lo> written as one word: not believing the word, said of people without faith; {thuumlo mite} are unbelievers and {thuummi} is a believer) (j:thu/um/lo) (r:zd:23079) (q:draft, low confidence)
thuumna = (i:3) (t:n) (f:social/media) (w:apology) (d:in news reports, a public expression of regret by a company, an office or an official for a wrong done; {mipi tungah thuumna nei} is apologise to the public) (r:zd:16947/zd:19906/zd:19932) (q:draft)
thuumthuum = (i:2) (t:v) (f:everyday/social) (w:plead/beg) (d:repeated form of <thuum>, plead: keep pleading with someone, who is marked by <tungah>) (r:zd:14498) (q:draft, low confidence)
thuvaanpi = (i:1) (t:n) (f:work/social) (w:director/executive director/manager) (d:the person who directs the affairs of an organisation, glossed in the articles as Executive Director; also the managing board) (r:zd:26026) (q:draft, low confidence)
thuvai = (i:1) (t:n) (f:politics/social) (w:affairs/matters/politics) (d:<thu>, matter, with <vai>, business: public affairs and the handling of them; {gamsung thuvai} is national politics) (r:zd:17021) (q:draft, low confidence)
thuvanpi = (i:2) (t:n) (f:politics) (w:prime minister/premier) (d:after <gambup>: {gambup thuvanpi} is the prime minister, the head of a parliamentary government, not a keeper of records) (r:zd:10824) (q:draft, low confidence)
thuza = (i:1) (t:v) (f:social/it) (w:keep in touch/contact/communicate) (d:<thu>, word, with <za>, hear: hear from one another; mostly as {ki thuza}, be in contact and exchange news) (r:zd:12925/zd:13020/zd:23863) (q:draft)
thuzakna = (i:1) (t:n) (f:media/social) (w:communication/contact/news) (d:<thuzak>, what is heard, with the noun suffix <na>: news received of someone or something; {ki thuzakna} is contact or communication between people) (b:thuzak) (r:zd:12936/ts:1919/zd:15627) (q:draft)
thuzawhna = (i:1) (t:n) (f:social/politics) (w:influence/authority/control/persuasion) (d:<thuzawh>, prevail over by words, with the noun suffix <na>: the power to make others follow one's word, by authority, pressure or persuasion) (b:thuzawh) (r:zd:13076/zd:24630/zd:23332) (q:draft)
thuzawhna = (i:2) (t:n) (f:social/religion) (w:resolution/decision) (d:what a meeting or conference has settled, its resolutions; in headings such as {Thuzawhna le Tangkona}, resolutions and declaration) (r:zd:25194) (q:draft, low confidence)
thuzeek = (i:1) (t:n) (f:work/politics) (w:secretary) (d:the secretary of a group or organisation, the one who manages its affairs; <thuzeekpi> is the chief secretary) (r:zd:13154/zd:16556) (q:draft, low confidence)
thuzeekpi = (i:1) (t:n) (f:politics/work) (w:secretary/chief secretary/general secretary) (d:the chief secretary of an organisation or a government office; a word proposed in place of {lai-atpa}) (r:zd:22381/ts:261) (q:draft)
thuzong = (i:1) (t:phrase) (f:everyday) (d:<thu> and <zong> written as one word: the word, matter or news also; {cih thuzong kiza hi} is it is also heard that) (j:thu/zong) (r:zd:24641/zd:12050) (q:draft)
thuzuih = (i:1) (t:n) (f:religion/social) (w:obedience/following) (d:<thu>, word, and <zuih>, follow, written as one word: the following of a teaching, a religion or what leaders say; {thuzuih theihna} is the ability to obey) (j:thu/zuih) (r:zd:11714/zd:15859) (q:draft)
thuzuite = (i:1) (t:n) (f:religion) (w:followers/believers/disciples) (d:plural of <thuzui>: those who follow the word, mostly as {Pasian thuzuite}, followers of God) (b:thuzui) (r:zd:21701/zd:21815) (q:draft)
Tianjin = (i:1) (t:name) (c:city) (f:travel) (w:Tianjin) (d:port city in the north of China) (r:zd:15790/zd:16367) (q:draft)
Tibet = (i:1) (t:name) (c:land) (f:travel) (w:Tibet) (d:the high land north of the Himalaya, often written {Tibet gam}) (r:zd:25115/zd:22356) (q:draft)
ticket = (i:1) (t:n) (f:travel) (w:ticket) (o:English) (r:zd:19812/zd:19051/zd:22691) (q:draft)
tiilteel = (i:1) (t:adv) (f:everyday) (w:steadfastly/consistently/firmly) (d:placed after a verb: doing it steadily and without wavering, all along; also written <tilteel> and <tiltel>) (r:zd:16420/zd:22396) (q:draft, low confidence)
Tiktok = (i:1) (t:name) (f:it/media) (w:TikTok) (d:a phone application for sharing short videos, and the company that owns it) (r:zd:24399) (q:draft)
tilteel = (i:1) (t:adv) (f:everyday) (w:decidedly/without fail/persistently) (d:placed after a verb: the action is done firmly and without wavering, as in {deih tilteel}, decidedly prefer) (r:zd:10957) (q:draft, low confidence)
tiltel = (i:1) (t:adv) (f:everyday) (w:in fine detail/minutely/bit by bit) (d:placed after a verb or noun, of what is small and many or is done piece by piece: {khen tiltel} is divide up finely, {tuat tiltel} is reckon in detail, and {naupang tiltel} is little children one after another) (r:zd:17745/zd:20592) (q:draft, low confidence)
timing = (i:1) (t:n) (f:time) (w:timing/time) (d:the right or set time for something, or the tempo of a song) (s:hun) (o:English) (r:zd:15047/zd:21461) (q:draft)
tingteng = (i:1) (t:adv) (f:everyday) (w:immediately/at once/straight away) (d:placed after a verb: the action is done at once and without hesitation; its use after a noun, as in {pasal tingteng}, is not clear from the articles) (r:zd:21961/zd:20037) (q:draft, low confidence)
tintan = (i:1) (t:n) (f:education) (w:course/class/training course) (d:a course of lessons outside ordinary school, such as a training or holiday class; {tintan kah} is attend a course) (o:Burmese, thintan) (r:zd:22576/zd:21837/zd:23972) (q:draft)
tinten = (i:1) (t:adv) (f:everyday) (w:firmly/steadfastly/persistently) (d:placed after a verb: do it firmly and keep to it without giving way; {ci tinten} is insist) (r:zd:16832/zd:22719/zd:16340) (q:draft)
Tio = (i:1) (t:name) (c:river/khua) (f:travel) (w:Tio/Tiau) (d:river on the border of Chin State and India, and the village on it that is now the town of Rihkhawdar) (r:zd:25357) (q:draft, low confidence)
tissue = (i:1) (t:n) (f:health/home) (w:tissue/paper tissue) (d:a piece of soft paper for wiping the nose, mouth or hands) (o:English) (r:zd:23935/zd:23727/zd:14734) (q:draft)
Titanic = (i:1) (t:name) (f:travel) (w:Titanic) (d:the passenger ship that sank in the Atlantic in 1912) (r:zd:19661/zd:20486) (q:draft)
tiuteu = (i:1) (t:adv) (f:body/health) (w:glowingly/plumply) (d:descriptive word after <thau>, fat, and <san>, red: plump and glowing with health; one article has it after a verb of running off, so it may also describe a brisk movement) (r:zd:19826) (q:draft, low confidence)
Tlaisun = (i:1) (t:name) (c:people) (f:social/politics) (w:Tlaisun/Tashon) (d:a Chin people of the Falam area in Chin State, Myanmar, also written Tashon, and their chiefdom in former times) (r:zd:24227) (q:draft, low confidence)
TNLA = (i:1) (t:name) (f:politics) (w:Ta'ang National Liberation Army/TNLA) (d:armed group of the Ta'ang people in the north of Shan State, Myanmar; in Zolai also {Ta'ang galkap}) (r:ts:3882/zd:16262) (q:draft)
to = (i:4) (t:part) (f:everyday) (w:on/onward/further) (d:placed after a verb to show that the action goes on or moves forward step by step and not upward: {zom to} is continue on, and the doubled {to to} with <zel> is keep on doing) (r:zd:23489/zd:17574) (q:draft)
to semsem = (i:1) (t:adv) (f:everyday) (w:more and more/increasingly/progressively) (d:<to>, upward or onward, and <semsem>, more and more: placed after a verb or adjective, it says that the state keeps growing step by step; {hoih to semsem} is to get better and better) (r:zd:25863/zd:19154/zd:22749) (q:draft)
tohtohna = (i:1) (t:n) (f:everyday) (w:continuing/going on) (d:<tohtoh>, on and on, with the noun suffix {-na}: placed after a verb for doing something continually or step by step; {hanciam tohtohna} is keeping on striving) (b:tohtoh) (r:zd:17055/zd:26650) (q:draft)
Toilet = (i:1) (t:n) (f:home) (w:toilet/lavatory) (d:a toilet, the room or the seat; English word used in Zolai sentences, often written with a capital) (s:ekbuk) (o:English) (r:zd:13089/zd:15732) (q:draft)
tokaaina = (i:1) (t:n) (f:politics) (w:subjection/vassalage/servitude) (d:the state of being under a master or a foreign ruler; a dictionary gives it for vassal) (r:zd:11110) (q:draft, low confidence)
Tokyo = (i:1) (t:name) (c:city) (f:travel) (w:Tokyo) (d:capital city of Japan) (r:zd:17432/zd:25918) (q:draft)
tolh = (i:3) (t:v) (f:body/nature) (w:run down/slide down/slip back) (d:move downwards by sliding or flowing: of tears after <khitui> and of a running nose after <naptui>, of snow or earth sliding down a slope; {nung tolh} is slip back, fall behind) (r:zd:20083/zd:14734/zd:12187) (q:draft)
tolhsuk = (i:1) (t:v) (f:nature/travel) (w:slide down/slip down) (d:<tolh>, slide, and <suk>, downward, written as one word: slide or slip down a slope, of earth, a vehicle or a person; {lei tolhsuk} is a landslide) (j:tolh/suk) (r:zd:21563/zd:15693) (q:draft)
tolhtolh = (i:1) (t:v) (f:body/everyday) (w:keep running down/keep slipping back) (d:<tolh.3> said twice: go on running or sliding down, of a running nose after <naptui>, or of a person sliding back little by little, {nung tolhtolh}) (b:tolh) (r:zd:21690) (q:draft)
tom = (i:1) (t:adj) (f:everyday) (w:short) (d:short in length, distance or time: {lampi tom} is a short road and {hun tom} a short time) (a:sau/sawt) (r:24.25.23) (q:draft)
tomahmah = (i:1) (t:adj) (f:everyday/home) (w:very durable/long-lasting) (d:<to>, here durable, lasting long in use, with <mahmah>, very, written as one word; this is not the <to> that means up or onward) (j:to/mahmah) (r:zd:11506) (q:draft, low confidence)
tomcik = (i:1) (t:adj) (f:everyday/time) (w:very short/brief) (d:<tom>, short, made stronger: very short, brief; {hun tomcik} is a very short time and {tomcik in} is briefly) (b:tom) (r:zd:9429/ts:4885/zd:17818) (q:draft)
tomcing = (i:1) (t:adj) (f:media/education) (w:concise/brief) (d:short but complete, said of an account: {tangthu tomcing} is a concise history and {a tomcing in} is in brief) (s:tomkim) (r:zd:25947/zd:17965) (q:draft)
tomkaal = (i:1) (t:n) (f:time) (j:tomkal) (r:zd:18164/zd:24712) (q:draft)
tomkal = (i:1) (t:n) (f:time) (w:short time/short term/short while) (d:<tom>, short, with <kal> in the sense of interval: a short span of time; {tomkal sung} is for a short while) (r:zd:11860/zd:22023/zd:21340) (q:draft)
tomkim = (i:1) (t:adj) (f:media/education) (w:brief/concise/in summary) (d:short but complete; placed after a noun, as in {thu tomkim}, a brief account or summary) (r:zd:10788/zd:11434/zd:23170) (q:draft)
tomkimcing = (i:1) (t:adj) (f:media/education) (w:brief/concise/in summary) (d:short yet complete; {tomkimcing in} is in brief, in summary) (s:tomkim) (r:zd:17639/zd:16302) (q:draft)
tomlak = (i:1) (t:n) (f:education/media) (w:summary/abridgement/excerpt) (d:<tom>, short, with <lak>, take: a short version of a speech or writing, and as a verb, summarise; {a tomlak in} is in short, abbreviated) (r:zd:25110/zd:17051/zd:22646) (q:draft)
tomlakna = (i:1) (t:n) (f:education/media) (w:summary/abridgement/abbreviation) (d:<tom>, short, with <lakna>, taking: a short version of a speech or a text; also the short form of a longer name) (r:zd:9212/zd:24931/zd:12948) (q:draft)
tomlawhna = (i:1) (t:n) (f:education/media) (w:abbreviation/short form/short name) (d:<tom>, short, with <lawhna>, name: the short way of calling something, mostly as {aki tomlawhna}, the short form of a longer name) (r:zd:11289/zd:12414) (q:draft)
tomlua = (i:1) (t:adj) (f:everyday/time) (w:too short/very short) (d:<tom>, short, with <lua>, too much, written as one word: too short in time or length) (j:tom/lua) (r:zd:15324/zd:20197) (q:draft)
tommahmah = (i:1) (t:adj) (f:everyday) (w:very short) (d:<tom>, short, and <mahmah>, very, written as one word) (j:tom/mahmah) (r:zd:21075/zd:15732) (q:draft)
tomnono = (i:1) (t:adj) (f:everyday) (w:short/brief) (d:<tom> and <nono> written as one word: short ones, said of several things that are each short) (j:tom/nono) (r:zd:24786/zd:21308) (q:draft)
tomte = (i:1) (t:adj) (f:everyday) (w:short) (d:<tom>, short, with the plural <te>: the short ones; {tangthu tomte} is short stories and {thau tomte} short guns) (b:tom) (r:zd:21063/ts:2963) (q:draft)
tomthei = (i:1) (t:adj) (f:everyday) (w:short) (d:<tom> and <thei> written as one word: {a tomthei penin} is as briefly as possible) (j:tom/thei) (r:zd:24641) (q:draft, low confidence)
tomvei = (i:1) (t:n) (f:time) (w:short while/short time) (d:<tom>, short, and <vei>, time, written as one word: a short time; {tomvei sung} is for a short while) (j:tom/vei) (r:zd:23828/zd:13305/zd:24214) (q:draft)
tomzaw = (i:1) (t:adj) (f:everyday/travel) (w:shorter) (d:<tom>, short, with <zaw>, more: shorter in length, distance or time) (a:sauzaw) (b:tom) (r:zd:23252/zd:16035) (q:draft)
ton = (i:2) (t:n) (f:work) (w:ton/tonne) (d:the unit of weight, placed before a number or after {metric}, as in {ton khat}, one ton; not {ton} accompany) (o:English, ton) (r:zd:20959/zd:19875/zd:22159) (q:draft)
tona = (i:1) (t:n) (f:social) (w:challenge) (d:something that tests or defies a person or group; in the articles mostly followed by the English word challenge in brackets, and {tona lianpi} is a great challenge) (r:zd:23893) (q:draft)
tong = (i:2) (t:n) (f:social) (w:manner/conduct/ways/character) (d:the second word of the pair {zia le tong} or {zia leh tong}, the ways, character and customs of a person or a people; in this meaning {tong} is not used without <zia>) (r:zd:21461/zd:22639/zd:17655) (q:draft)
Tongciin = (i:1) (t:name) (c:khua) (f:travel) (w:Tongciin) (d:a Zomi village in the Tedim and Tonzang area of Chin State) (r:ts:4885) (q:draft, low confidence)
Tongciin = (i:2) (t:n) (f:social/politics) (w:peace envoy) (d:in former times, the people whom a village defeated in war sent to speak for peace) (r:zd:21201) (q:draft, low confidence)
tongdam = (i:1) (t:n) (f:social/media) (w:word/speech/gentle words) (d:word of songs and poetry for speech or words, especially kind or comforting words; {Nisim Tongdam} is the title of a book of daily readings) (r:zd:22683/zd:24253) (q:draft, low confidence)
Tonglawn = (i:1) (t:name) (c:khua) (f:travel) (w:Tonglawn) (d:village in Manipur in India) (r:ts:301) (q:draft, low confidence)
