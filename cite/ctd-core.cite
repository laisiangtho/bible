lamthakna = (i:1) (t:n) (f:work/politics) (w:rebuilding/new construction) (d:<lamthak>, build new, with the noun ending {-na}, used after <ki>: the building of something new or anew, also of a party rebuilding itself) (b:lamthak) (r:zd:19602) (q:draft, low confidence)
lamto = (i:2) (t:n) (f:travel) (w:uphill road/ascent/upward slope) (d:<lam>, way, with <to>, upward: a stretch of road that goes up, the opposite of <lamsuk>; {lamto ah} is on the way up, not the verb of lifting) (a:lamsuk) (r:zd:22784/zd:21254) (q:draft)
lamtung = (i:1) (t:n) (f:travel/nature) (w:upper side of the road/above the road) (d:<lam>, road, and <tung>, above, written as one word: the ground or the road on the uphill side, the opposite of <lamnuai>, below the road) (j:lam/tung) (r:zd:19166/zd:12765) (q:draft)
lamuh = (i:1) (t:phrase) (f:everyday) (d:<lam>, here the fact that, and the plural marker <uh> written as one word after a verb: the fact that you or they are or do so, as in {na hih lamuh}, that you are) (j:lam/uh) (r:zd:9448/zd:24427) (q:draft, low confidence)
