zanggam = (i:1) (t:n) (f:nature/travel) (w:plain/plains/lowland) (d:level land as a <gam>, country: the plains, set against {mualtung gam}, the hill country; in news the lowland of Myanmar or the valley of Manipur) (r:ts:1428/ts:3375/zd:26708) (q:draft)
zangh = (i:1) (t:v) (f:everyday) (j:zang) (r:zd:19159/zd:24068/zd:10761) (q:draft)
zangkhial = (i:1) (t:v) (f:everyday/social) (w:misuse/use wrongly/abuse) (d:<zang>, use, with <khial>, wrong: use something in a wrong way or for a wrong purpose) (j:zang/khial) (r:zd:13305/zd:9434/zd:20875) (q:draft)
Zangkong = (i:1) (t:name) (c:city) (f:travel) (w:Yangon/Rangoon) (d:the Zolai name of Yangon, the largest city of Myanmar) (s:Yangon) (r:zd:22941/zd:16288) (q:draft)
Zangkung = (i:1) (t:name) (c:city) (f:travel) (w:Yangon/Rangoon) (d:Zolai name of Yangon, the largest city and former capital of Myanmar) (r:zd:20176/zd:19239) (q:draft)
zangsiam = (i:1) (t:v) (f:everyday/work) (w:use well/make good use of/use skilfully) (d:<zang> and <siam> written as one word: use a thing, a time or a skill well) (j:zang/siam) (r:zd:19455/zd:20125) (q:draft)
zangta = (i:1) (t:v) (f:everyday) (w:now use/have come to use) (d:<zang>, use, with <ta>, which marks what has now come about; as a word of songs and of a dance, {zangta lam}, its meaning is not determined) (b:zang) (r:zd:22446/zd:15324) (q:draft)
zangtheiding = (i:1) (t:v) (f:everyday/it) (w:will be able to use/can be used) (d:<zangthei> and <ding> written as one word: will be able to use; after <ki> it is passive, can be used) (j:zangthei/ding) (r:zd:16302/zd:11768/zd:20095) (q:draft)
Zangtui = (i:1) (t:name) (c:khua) (f:travel/social) (w:Zangtui) (d:apparently a village of the Zomi area: written after personal names as the home village and named in a traditional song) (r:ts:301) (q:draft, low confidence)
zangzang = (i:1) (t:v) (f:everyday) (w:keep using/use all along) (d:<zang>, use, said twice: go on using, have been using all along) (r:zd:21925/zd:24068) (q:draft, low confidence)
zangzang = (i:2) (t:adv) (f:everyday) (w:continually/on and on) (d:placed after a verb: the action goes on without stopping, as singing or the flowing of tears) (r:zd:11135/zd:16121) (q:draft, low confidence)
zankhat = (i:1) (t:n) (f:time) (w:one night/a night) (d:<zan>, night, and <khat>, one, written as one word: a single night; {zankhat thu in} is overnight, in one night) (j:zan/khat) (r:zd:17426/zd:18046) (q:draft)
zankim = (i:1) (t:n) (f:time) (w:midnight) (d:<zan>, night, with <kim>, half: the middle of the night; {zankim lai takin} is right at midnight) (a:sunkim)
zankimlam = (i:1) (t:n) (f:time) (w:around midnight/late at night) (d:<zankim>, midnight, and <lam>, toward, written as one word: the time around midnight, the late night hours; {zankimlam in} is around midnight) (j:zankim/lam) (r:zd:11081/zd:15896/zd:19164) (q:draft)
zanlam = (i:1) (t:n) (f:time) (w:night/night-time/at night) (d:<zan>, night, with <lam>, side: the night part of the day; after the name of a day, on the night of that day, and before a clock time, at night) (r:zd:11899/zd:12464/zd:17551) (q:draft)
zanni = (i:1) (t:n) (f:time/everyday) (w:yesterday) (d:the day before today; with <in>, {zanni-in}, it tells when something happened) (q:draft)
zannitak = (i:1) (t:adv) (f:time) (w:last night/yesterday evening) (d:<zan> and <nitak> written as one word: in the evening or night of yesterday) (j:zan/nitak) (r:ts:7320/zd:19176) (q:draft)
zanpuan = (i:1) (t:n) (f:home) (w:blanket/bedcover) (d:a cloth to cover oneself with when sleeping, <zan>, night, with <puan>, cloth) (r:zd:21826/zd:26411/zd:19826) (q:draft)
zantawh = (i:1) (t:adv) (f:time) (w:by night/at night) (d:<zan>, night, and <tawh>, with, written as one word; found in the pair {suntawh zantawh}, day and night, without a break) (j:zan/tawh) (r:zd:20997/zd:21869/zd:14652) (q:draft)
zanvak = (i:1) (t:n) (f:religion) (w:carolling/Christmas carol singing) (d:going round at night at Christmas to sing and bring greetings; {zanvak la} is a Christmas carol) (r:zd:26097/zd:16506) (q:draft, low confidence)
zanzan = (i:1) (t:adv) (f:everyday) (d:placed after a verb, often with <peuh> before it: just, readily, without much thought, as people are apt to do or say) (r:zd:25749/zd:20594) (q:draft, low confidence)
zasakkhin = (i:1) (t:v) (f:media/everyday) (w:have informed/have notified) (d:<zasak>, inform, and <khin>, already, written as one word; after <ki> it is passive, {ki zasakkhin}, has been informed) (j:zasak/khin) (r:zd:20263/zd:14738) (q:draft)
zasakna = (i:1) (t:n) (f:media/social) (w:announcement/notice/notification) (d:<zasak>, make known, with the noun ending {-na}: an announcement; {zasakna nei} is make an announcement) (b:zasak) (r:ts:5635/zd:15629/zd:17344) (q:draft)
zasakpah = (i:1) (t:v) (f:everyday/media) (w:inform at once/notify immediately/report at once) (d:<zasak>, inform, and <pah>, at once, written as one word: let someone know straight away, said mostly of calling the police or an ambulance) (j:zasak/pah) (r:zd:12490/zd:12488/zd:12040) (q:draft)
zasaksawn = (i:1) (t:v) (f:media/social) (w:pass on/inform/let others know) (d:<zasak>, inform, and <sawn>, on, written as one word: pass news on to others, let someone know) (j:zasak/sawn) (r:zd:14694/zd:17872/zd:15180) (q:draft)
zatam = (i:1) (t:adj) (f:everyday) (w:many/countless/multitude of) (d:<za> hundred with <tam> many, placed after a noun: very many, in their hundreds; a word of songs and elevated style, as in {mi zatam}, the multitude of people) (r:zd:9429/zd:22962) (q:draft, low confidence)
zatang = (i:1) (t:n) (f:health) (w:pill/tablet) (d:medicine in the form of a small solid grain that is swallowed, set against <zatui>, liquid medicine) (r:zd:21664/zd:22151/zd:20908) (q:draft)
zatdan = (i:1) (t:n) (f:everyday) (w:way of using/use/usage) (d:<zat>, use, with <dan>, way: how something is used or is to be used; {sum zatdan} is how to use money) (s:zatzia/zatna) (r:zd:21991/zd:17344/zd:15857) (q:draft)
zatding = (i:1) (t:phrase) (f:everyday/work) (w:to use/for use/to be used) (d:<zat>, use, and <ding>, the marker of what is to come, written as one word: that is to be used, for use; {zatding sum} is money to spend) (j:zat/ding) (r:zd:20917/zd:12420) (q:draft)
zatdingin = (i:1) (t:v) (f:everyday/work) (w:to use/for use/in order to use) (d:<zat>, use, and <dingin>, in order to, written as one word: for use, to be used, to be observed) (j:zat/dingin) (r:zd:17822/zd:20254/zd:22707) (q:draft)
zateep = (i:1) (t:n) (f:health/everyday) (w:cigarette/cigar/tobacco) (d:tobacco rolled for smoking, a cigarette or cigar; {zateep teep} is smoke a cigarette) (r:zd:10929/zd:20764) (q:draft)
zatep = (i:1) (t:n) (f:health/everyday) (w:tobacco/cigarette/smoking) (d:tobacco that is smoked, a cigarette; {zatep tep} is to smoke) (r:zd:12774/zd:22734/zd:13112) (q:draft)
zatepna = (i:1) (t:n) (f:health) (w:smoking/tobacco smoking) (d:the act or habit of smoking tobacco; <zatep>, smoke tobacco, with the noun ending {-na}) (r:zd:24276/zd:16259/zd:12746) (q:draft)
zathuai = (i:1) (t:adj) (f:everyday) (w:worth using/fit to use/useful) (d:<zat>, use, with <huai>, worthy of: good or proper to use; {zathuai lo} is not fit to be used) (b:zat) (r:zd:23780/zd:21032/zd:22136) (q:draft)
zatkhiat = (i:1) (t:v) (f:work/everyday) (w:spend/use up/put to use) (d:<zat>, use, with <khiat>, out: spend money or put something to use; {sum zatkhiat na} is spending, expenditure) (j:zat/khiat) (r:zd:25928/zd:25916) (q:draft)
zatkhop = (i:1) (t:v) (f:social/everyday) (w:use together/share) (d:<zat>, use, and <khop>, together, written as one word: use or have in common, share with others) (j:zat/khop) (r:zd:9449/zd:24217/zd:18164) (q:draft)
zatloh = (i:1) (t:v) (f:everyday) (w:not use/avoid using) (d:<zat> and <loh> written as one word: not using something; {zatloh ding} is should not be used) (j:zat/loh) (r:zd:24252/zd:14650/zd:24395) (q:draft)
zato kipuak = (i:1) (t:v) (f:health) (w:be taken to hospital/be hospitalized) (d:<zato>, doctor or hospital, and <kipuak>, be carried or sent: be taken to hospital, said of an injured or sick person; <zato> stands without a place marker and the person taken stands before the pair) (r:zd:20966/ts:6573/zd:15157) (q:draft)
zato lupna = (i:1) (t:n) (f:health) (w:hospital bed/hospital) (d:<zato>, here hospital, and <lupna>, bed: a hospital bed; a number after it gives the size of a hospital, {zato lupna 100} is a hospital of 100 beds, and with a place name before it the pair names that hospital) (r:zd:17168/zd:24016) (q:draft)
zatolum = (i:1) (t:v) (f:health) (w:be in hospital/be hospitalised/be an in-patient) (d:<zato>, here the hospital, and <lum>, lie down, written as one word: lie in hospital as a patient; also the patient who is admitted, as in {cina zatolum}) (j:zato/lum) (r:zd:17474/zd:14640/zd:17641) (q:draft)
zatopi = (i:1) (t:n) (f:health) (w:hospital/general hospital) (d:<zato> with the augmentative {-pi}: a hospital, especially the main hospital of a town) (b:zato) (r:zd:24158/zd:24572/zd:23533) (q:draft)
zatpih = (i:1) (t:v) (f:everyday/social) (w:use with/spend with/share the use of) (d:<zat>, use, with <pih>, together with: use something with or for someone; {hun zatpih} is spend time with someone) (b:zat) (r:zd:25512/zd:23554/zd:25221) (q:draft)
zatsa = (i:1) (t:adj) (f:everyday) (w:used/already used/customary) (d:<zat>, use, with the ending {-sa}, already: that has been used, as used things to be thrown away or recycled; also what someone has always used or practised) (r:zd:23935/zd:21815/zd:21075) (q:draft)
zatsawm = (i:1) (t:v) (f:everyday) (w:intend to use/try to use/plan to use) (d:<zat>, use, and <sawm>, intend, written as one word) (j:zat/sawm) (r:zd:18086/zd:15414) (q:draft)
zatsiam = (i:1) (t:v) (f:everyday) (w:use well/use skilfully/make good use of) (d:<zat> and <siam> written as one word: know how to use something and use it well, as time, money or technology) (j:zat/siam) (r:zd:22023/zd:23367/zd:24862) (q:draft)
zattang = (i:1) (t:n) (f:everyday) (w:substitute/common use) (d:a thing used in the place of another, or what is in ordinary use; {zattang in} is in place of, serving as) (r:zd:17607/zd:24303) (q:draft, low confidence)
zattheihding = (i:1) (t:v) (f:everyday/it) (w:be able to use/can be used) (d:<zattheih>, can be used, and <ding> written as one word: so that it can be used, or that it will be usable) (j:zattheih/ding) (r:zd:11827/zd:15505/zd:11506) (q:draft)
zattheihna = (i:1) (t:n) (f:everyday) (w:ability to use/usability/use) (d:<zattheih>, can be used, with the noun ending {-na}: the ability or right to use something, or the place or way in which it can be used; {a ki zattheihna mun} is a place where it can be used) (b:zattheih) (r:zd:21239/zd:24089/zd:23022) (q:draft)
zatui kibawl = (i:1) (t:v) (f:health) (w:be treated/receive treatment) (d:<zatui>, medicine, and <kibawl>, be done: be given medical treatment; the hospital or clinic stands before it with <ah>, and the active form is {zatui bawl}, treat a patient) (r:zd:13131/zd:17794) (q:draft)
zatui kibawlding = (i:1) (t:phrase) (f:health) (w:for medical treatment/to be treated) (d:<zatui>, medicine, and <kibawlding>, will be done: to be given medical treatment; followed by <in>, in order to be treated, before a verb of taking to hospital such as <kipuak>) (r:zd:15577/zd:14523) (q:draft)
zatui zaha = (i:1) (t:n) (f:health) (w:medicines/medical supplies/medication) (d:<zatui>, medicine, with <zaha>, here an echo word that only pairs with it: medicines of every kind, medicine and medical supplies as a whole) (r:zd:25189/zd:23729/ts:2690) (q:draft)
zatuite = (i:1) (t:n) (f:health) (w:medicines/drugs) (d:plural of <zatui>: medicines, also drugs) (b:zatui) (r:zd:23729/zd:24276) (q:draft)
zatzat = (i:1) (t:v) (f:everyday) (w:keep using/use regularly) (d:<zat> said twice: use again and again, or what one habitually uses) (b:zat) (r:zd:23910/zd:20135/zd:22650) (q:draft)
zavat = (i:1) (t:n) (f:health) (w:epidemic/plague/pestilence) (d:a deadly disease that spreads quickly among many people, used with <pul>, <pulpi> and <natna>; {sungpai zavat} is cholera) (r:zd:24250/zd:23889) (q:draft)
zavom = (i:1) (t:n) (f:health/politics) (w:opium) (d:<za>, drug, with <vom>, black: opium, the black drug, often named together with <zakang>, the white drug, heroin; {zavom ciing} is grow opium) (r:zd:10797/zd:25488) (q:draft, low confidence)
zaw = (i:1) (t:prep) (f:everyday) (w:than/more) (d:marks the comparative, more or rather; it follows the describing word, and the thing compared stands before it with <sangin>)
zaw hamtang = (i:1) (t:adv) (f:everyday) (w:rather/all the more/in fact) (d:<zaw>, more or rather, and <hamtang>, insistently: placed after a verb or describing word and before <hi>, states firmly that the thing is rather so, or so all the more, against what might be expected) (r:zd:21085/zd:12167/zd:16312) (q:draft, low confidence)
zawdeuhta = (i:1) (t:adv) (f:everyday) (w:somewhat more now/rather better now) (d:<zawdeuh>, somewhat more, with <ta>, here the marker of a change that has now come about, written as one word after a describing word: has now become rather more so) (j:zawdeuh/ta) (r:zd:14850/zd:11927/zd:15795) (q:draft)
zawding = (i:1) (t:adv) (f:everyday) (w:more/rather) (d:<zaw> and <ding> written as one word after a verb or describing word: will be more so, would rather) (j:zaw/ding) (r:zd:15949/zd:22989/zd:14947) (q:draft)
zawh ciang = (i:1) (t:conj) (f:time) (w:after/once finished) (d:<zawh>, finish, and <ciang>, when: placed after a verb, a noun of time or <tua>, after it is done or after that time; {tua zawh ciang} is after that) (r:zd:23037/zd:24144/ts:11162) (q:draft)
zawh kum = (i:1) (t:phrase) (f:time) (w:years since/years after) (d:<zawh>, here having finished, and <kum>, year: placed after a verb and before a number, that many years since or after the action; {a tun zawh kum 5} is five years since he arrived) (r:zd:22802/zd:9220/ts:3284) (q:draft)
zawh nading = (i:1) (t:conj) (f:everyday) (w:in order to be able to/so that one can) (d:<zawh>, here the form of <zo>, be able, manage, and <nading>, for the purpose of: placed after a verb, in order to be able to do it, so that it can be done; often followed by <in> and a main clause that names what is needed or done) (r:zd:22556/zd:19408) (q:draft)
zawh nadingin = (i:1) (t:conj) (f:everyday) (w:so that one can/in order to be able to/in order to manage) (d:<zawh>, form of the verb win that after another verb means be able or manage to, and <nadingin>, in order to: placed after a verb and closing the clause of purpose, so that the action can be achieved; without a verb before it, in order to defeat or to finish something) (r:zd:20778/zd:14791) (q:draft)
zawh nang = (i:1) (t:conj) (f:everyday) (w:in order to be able to/so as to manage/so that one can) (d:<zawh>, form of the verb win that after another verb means be able or manage to, and <nang>, here not the pronoun you but the short form of <nading>, for the purpose of: placed after a verb, in order to be able to do it; a noun or a verb of striving or preparing follows) (s:zawh nadingin) (r:zd:21271/zd:22157) (q:draft)
Zawhang = (i:1) (t:name) (c:male) (f:religion) (w:John) (d:the name John in an older spelling, of John the Baptist and of the Gospel of John printed in 1923; the Bible text writes <Johan>) (r:zd:22544/zd:17168/zd:20324) (q:draft)
zawhciangin = (i:1) (t:conj) (f:time) (w:after/when finished) (d:<zawh>, finish, and <ciangin>, when, written as one word after a verb or <tua>: after doing so, when it was done; {tua zawhciangin} is after that) (j:zawh/ciangin) (r:zd:24142/zd:24739/zd:23797) (q:draft)
zawhding = (i:1) (t:v) (f:everyday) (w:be able to/can be done) (d:<zawh> and <ding> written as one word after a verb: that can be done or finished; {gen zawhding hilo} is that cannot be told) (j:zawh/ding) (r:zd:20202/zd:19856/zd:19455) (q:draft)
zawhloh lungdamna = (i:1) (t:n) (f:social) (w:inexpressible gratitude/thanks beyond words) (d:<zawhloh>, that cannot be done, and <lungdamna>, joy or thanks: used after <gen>, say, as {gen zawhloh lungdamna}, thanks that cannot be told; a formula of public acknowledgement to donors and helpers, who stand before it with <tungah>) (r:zd:14887/zd:15275) (q:draft)
zawhlohna = (i:1) (t:n) (f:everyday) (w:inability/failure) (d:the fact of not being able, placed after a verb: {up zawhlohna} is inability to believe and {ngah zawhlohna} is failure to get) (b:zawhloh) (r:zd:21262/zd:24347/zd:23823) (q:draft)
zawhna dingin = (i:1) (t:conj) (f:everyday) (w:in order to be able to/so as to manage to) (d:<zawhna>, being able or overcoming, and <dingin>, in order to: placed after a verb, so that the action can be accomplished; {neih zawhna dingin} is in order to be able to have) (r:zd:21410/zd:19599) (q:draft)
zawhngeu = (i:1) (t:n) (f:nature/home) (w:cat) (r:zai:cat) (q:draft)
zawhthawh thutawh = (i:1) (t:adv) (f:social/politics) (w:by force/forcibly/under compulsion) (d:<zawhthawh>, force, and <thutawh>, by way of: placed before a verb, do it to someone by force or against that person's will) (r:zd:19145/zd:19398) (q:draft)
zawhthawhthu = (i:1) (t:n) (f:social/politics) (w:force/compulsion) (d:<zawhthawh> and <thu> written as one word; {zawhthawhthu tawh} is by force) (j:zawhthawh/thu) (r:zd:23670/zd:19990) (q:draft)
zawi = (i:1) (t:n) (f:travel/nature) (w:path/track/trail) (d:a narrow path or track made by people or animals passing; also a way or channel, as in {thupha zawi}, a path of blessing) (r:zd:18107/zd:24320) (q:draft)
zawkzawk = (i:1) (t:adv) (f:everyday) (d:<zawk>, more, said twice after a verb of wanting such as <deih> or <ut>: whichever one prefers) (b:zawk) (r:zd:23479/zd:21939) (q:draft)
zawlo = (i:1) (t:adv) (f:everyday) (w:not more/not rather) (d:<zaw> and <lo> written as one word after a verb or describing word: not more so, not rather; {thupi zawlo} is not the more important thing) (j:zaw/lo) (r:zd:15324/zd:11831/zd:20518) (q:draft)
zawmawk = (i:1) (t:adv) (f:everyday) (w:rather/instead/in fact) (d:<zaw>, more or rather, and <mawk>, unexpectedly, written as one word after a verb or describing word: it turns out rather to be so, against what was expected) (j:zaw/mawk) (r:zd:12869/zd:12756/zd:24386) (q:draft)
zawn phapha = (i:1) (t:v) (f:social) (w:earnestly invite/urge/appeal to) (d:a verb written like <zawn>, be poor, but here meaning invite or call upon, and <phapha>, well: a closing formula of notices, {kong zawn phapha uh hi}, we earnestly invite or urge you, after a clause that says what the readers are asked to do) (r:zd:13291/zd:21906) (q:draft, low confidence)
zawng = (i:1) (t:adj) (f:everyday/work) (w:poor/needy) (d:having little money or property; also used as a verb, be poor or become poor) (s:cimawh/genthei) (a:hau) (q:draft)
zawngkhaal = (i:1) (t:adj) (f:body/health) (j:zawngkhal) (r:zd:21198) (q:draft)
zawngtah = (i:1) (t:n) (c:plant) (f:food/nature) (w:tree bean/stink bean) (d:a tree, Parkia, grown in the Zomi hills for its long edible pods, and the pods themselves) (r:zd:22448/zd:18258) (q:draft)
zawsawp = (i:1) (t:adv) (f:everyday) (j:zawsop) (r:zd:19425/zd:25926) (q:draft, low confidence)
zawta = (i:1) (t:adv) (f:everyday) (w:more now/even more) (d:<zaw>, more, and the particle <ta> written as one word, after a verb or describing word: it has now become more so) (j:zaw/ta) (r:zd:21974/zd:23025/zd:21421) (q:draft)
zawzaw = (i:1) (t:part) (f:everyday) (d:<zaw>, more, said twice: whichever is the more so; {khat zawzaw} is either one, one or the other) (b:zaw) (r:zd:12695/zd:22780) (q:draft)
ZBCM = (i:1) (t:name) (f:religion) (w:Zomi Baptist Convention of Myanmar/ZBCM) (d:a body of Zomi Baptist churches with its head office in Myanmar, written with its initials; also in the names of its member churches abroad) (r:zd:14579/zd:25268) (q:draft)
ZCA = (i:1) (t:name) (f:religion/social) (w:ZCA) (d:English abbreviation of a Zomi church body; the articles write it out both as Zomi Christian Alliance and as Zomi Christian Assembly) (o:English) (r:zd:15379/zd:15407) (q:draft, low confidence)
ZCD = (i:1) (t:name) (f:politics) (w:ZCD/Zomi Congress for Democracy) (d:abbreviation of Zomi Congress for Democracy, a Zomi political party in Myanmar) (r:zd:23071/zd:24481/zd:12337) (q:draft)
ZCDC = (i:1) (t:name) (f:social) (w:ZCDC/Zomi Community Development Center) (d:abbreviation of Zomi Community Development Center, a building project of the Zomi community) (r:zd:24358/zd:24649) (q:draft, low confidence)
ZCLS = (i:1) (t:name) (f:religion/education) (w:Zomi Christian Literature Society) (d:abbreviated name of the Zomi Christian Literature Society, a publisher and bookshop of Zolai books with its office in Kalaymyo) (r:zd:20142/zd:21502) (q:draft)
Zealand = (i:1) (t:name) (c:land) (f:travel/politics) (w:New Zealand) (d:second word of the name New Zealand, a country in the Pacific; written {New Zealand gam}) (o:English) (r:zd:20484/zd:12630) (q:draft)
Zechariah = (i:1) (t:name) (f:religion) (j:Zekhariah) (r:zd:21845) (q:draft)
zeek = (i:1) (t:v) (f:work/home) (w:manage/budget/use carefully) (d:handle money, time or goods with care so that they are well used; {sum zeek} is manage money) (r:zd:25919/zd:24119/zd:24751) (q:draft)
zeelzeel = (i:1) (t:adv) (f:everyday/time) (j:zelzel) (r:zd:23077/zd:24733) (q:draft)
zeetna = (i:1) (t:n) (f:religion) (j:ze-etna) (r:zd:17488/zd:15662) (q:draft)
Zeisu Khazih = (i:1) (t:name) (c:male) (f:religion) (w:Jesus Christ) (d:<Zeisu>, Jesus, and <Khazih>, Christ: the name and title together, as used by the churches that write the name in this spelling; often after <Topa>, Lord) (r:zd:23394/zd:24064) (q:draft)
zekai = (i:1) (t:v) (f:everyday/time) (w:be slow/be late/delay) (d:be late or slow in doing something, put it off; mostly with a negative, {zekai lo}, without delay) (a:kinawh) (r:10.20.5) (q:draft)
zelding = (i:1) (t:adv) (f:everyday) (d:<zel>, repeatedly or in turn, with <ding>, will, written as one word after a verb: will do or be so again and again, or in turn) (j:zel/ding) (r:zd:20814/zd:19676/zd:16463) (q:draft)
zelna = (i:1) (t:n) (f:everyday) (w:repeated doing/habit) (d:<zel>, repeatedly, with the noun suffix {-na}, placed after a verb: the doing of it again and again, or the place where it is usually done; {nong phawk zelna uh} is your remembering me time after time) (b:zel) (r:zd:23428/zd:20792) (q:draft)
zelzel = (i:1) (t:adv) (f:everyday/time) (w:repeatedly/again and again/often) (d:placed after a verb to show that the action happens over and over) (s:zel/zeel/kikkik/tamvei) (r:18.33.29) (q:draft)
zelzelding = (i:1) (t:adv) (f:everyday/time) (w:will keep on/again and again/regularly) (d:<zelzel>, repeatedly, and <ding>, will, written as one word after a verb: will or should go on doing it time after time) (j:zelzel/ding) (r:zd:12908/zd:18289/zd:16442) (q:draft)
zelzelkhat = (i:1) (t:phrase) (f:everyday) (d:<zelzel> and <khat> written as one word after a verb: one who does it again and again, a person or thing that habitually does so) (j:zelzel/khat) (r:zd:18154/zd:21332) (q:draft)
zen tam = (i:1) (t:part) (f:everyday) (w:I wonder/how very) (d:the emphatic <zen>, really, with <tam>, here a question word at the end of a sentence and not many: closes a question or exclamation that begins with a word such as <bang> or <bangzah>, I wonder what, how very much) (r:zd:21925/zd:25484) (q:draft, low confidence)
zenzen hangin = (i:1) (t:conj) (f:everyday) (w:even though/even if/although indeed) (d:<zenzen>, really, at all, and <hangin>, although: placed after a verb or a clause, even though that is really so, even if it comes to that; the main statement follows) (r:zd:25711/zd:21511) (q:draft)
zenzenin = (i:1) (t:conj) (f:everyday) (w:if by chance/in case/supposing) (d:<zenzen> and <in> written as one word; {a zenzenin} at the start of a sentence introduces a supposed case: if it should happen that) (j:zenzen/in) (r:zd:16340/zd:21257) (q:draft)
zenzenleh = (i:1) (t:conj) (f:everyday) (w:if by any chance/in case/should it happen) (d:<zenzen> by chance with <leh> if, placed after the verb: if it should happen that; after <kei> if it should not) (j:zenzen/leh) (r:zd:19550/zd:23867) (q:draft)
zenzenlo = (i:1) (t:adv) (f:everyday) (w:not at all/by no means/not really) (d:<zenzen> and <lo> written as one word after a verb: not at all; {hi zenzenlo} is it is by no means so) (j:zenzen/lo) (r:zd:24481/zd:24381/zd:25203) (q:draft)
zepgawp = (i:1) (t:v) (f:social) (w:whip severely/cane/thrash) (d:<zep> in the sense whip or beat with a cane, belt or rod, not decorate, with <gawp>, severely, written as one word: beat hard and many times) (j:zep/gawp) (r:zd:12255/zd:20461) (q:draft)
Zero = (i:1) (t:num) (f:everyday/education) (w:zero/nought) (d:the number 0, or the point 0 on a scale such as temperature) (o:English) (r:zd:12831) (q:draft)
zeuhzeuh = (i:1) (t:adv) (f:everyday) (w:now and then/from time to time/occasionally) (d:placed after a verb: the action happens at intervals, again and again but not all the time; often with {khat veivei}, sometimes, or <zel>) (r:zd:24276/zd:11715/zd:13181) (q:draft)
zezen = (i:1) (t:adv) (f:everyday) (w:even/really/to that extent) (d:emphatic word placed after a verb or describing word: even, to such a degree; with a negative, not even, not at all; compare <zenzen>) (r:zd:22858/zd:23130) (q:draft, low confidence)
Zhejiang = (i:1) (t:name) (c:land) (f:travel) (w:Zhejiang) (d:province on the east coast of China) (r:zd:11466/zd:14521) (q:draft)
Zhou = (i:1) (t:name) (f:politics/social) (w:Zhou) (d:the Zhou dynasty of ancient China, from which some writers on Zomi history derive the name Zo; also a Chinese family name) (r:zd:8375/zd:19159) (q:draft)
zi = (i:1) (t:n) (f:family) (w:wife) (d:a married woman in relation to her husband; {zi la} or {zi-in la} is take a wife, marry) (a:pasal)
ziading = (i:1) (t:n) (f:everyday/media) (w:way/manner) (d:<zia>, way, and <ding>, to be, written as one word after a verb: the way something is to be done, how to do it; common in headings) (j:zia/ding) (r:zd:23191/zd:25749/zd:24038) (q:draft)
ziah = (i:1) (t:adv) (f:everyday) (d:used doubled, {ziah ziah}, after a verb: steadily, in a continuous flow, one after another without holding back; the same as <ziahziah> written as two words) (r:zd:23037/zd:11262) (q:draft)
ziahziahna = (i:1) (t:n) (f:everyday) (w:profusion/bustle) (d:<ziahziah>, freely and in great numbers, with the noun suffix <na>, placed after a verb: the doing of it by many or without stop, and before <mun> or a place word the place where this goes on) (b:ziahziah) (r:zd:18918/zd:16410) (q:draft)
ziak = (i:1) (t:n) (f:everyday) (w:reason/cause/because of) (d:the reason or cause of something; after a noun or clause, usually as {ziak in} or {ziak-a}, because of, and {tua ziak in} is therefore; it stands where the Bible text has <hang>) (s:hang) (r:zd:21340/zd:12074/zd:21079) (q:draft)
ziakai = (i:1) (t:v) (f:everyday/time) (j:zekai) (r:zd:9212/zd:15067/zd:23974) (q:draft)
ziakaisak = (i:1) (t:v) (f:travel/time) (w:delay/make late/hold up) (d:<ziakai>, be late, with the causative <sak>: cause a flight, a train or a journey to be late; also used for be delayed) (r:zd:17430/zd:17624/zd:12309) (q:draft)
ziakin = (i:1) (t:ppm) (f:everyday) (w:because of/on account of) (d:placed after a noun or a clause to give the cause; {tua ziakin} is because of that, therefore) (r:zd:16157/zd:16521) (q:draft)
ziau lel = (i:1) (t:part) (f:everyday) (w:just/simply/without more ado) (d:<ziau>, at once or easily, and <lel>, here the particle merely, not be defeated: placed after a verb, the action is done simply, offhand, with no further thought) (r:zd:25928/zd:21605) (q:draft, low confidence)
ziauna = (i:1) (t:n) (f:everyday) (d:<ziau> with the noun suffix <na>, after a verb: the act of simply or readily doing it, as in {up ziauna}, mere believing, and {sim ziauna}, just reading) (j:ziau/na) (r:zd:25571/zd:19816/zd:11697) (q:draft, low confidence)
ZIDCA = (i:1) (t:name) (f:social) (w:ZIDCA/Zomi Innkuan DC Area) (d:abbreviation of Zomi Innkuan DC Area, the association of the Zomi community in the Washington D.C. area of the United States) (r:zd:24910/zd:25912) (q:draft)
zihziah = (i:1) (t:adv) (f:everyday) (w:in great numbers/all over/everywhere) (d:expressive word placed after a verb, showing that many people or things do it together or that it happens all over a place: {dim zihziah} is full everywhere, crowded) (r:zd:18927/ts:10085/zd:20486) (q:draft)
zii = (i:1) (t:n) (f:work/everyday) (w:market/bazaar) (d:a market or shop where food and goods are bought; {zii pai} is go to the market, go shopping) (s:sumbuk) (o:Burmese) (r:zd:22203/zd:23756/zd:25918) (q:draft)
zii = (i:2) (t:n) (f:family) (j:zi) (r:zd:21853/zd:21079) (q:draft)
ziingsang = (i:1) (t:n) (f:time) (j:zingsang) (r:zd:21003/zd:21279/zd:17860) (q:draft)
zin = (i:2) (t:n) (f:social) (w:guest/stranger/traveller) (d:one who is away from home, a guest in a house or a foreigner in a land; {zin do} is to show hospitality and {zin tunna inn} is a guest room or an inn) (s:khualmi/leengla/mikhual) (r:60.4.9) (q:draft)
zin kawikawi = (i:1) (t:v) (f:travel) (w:travel around/tour/journey about) (d:<zin>, here a verb, to travel or be away from home, and <kawikawi>, about: to travel from place to place, to tour, as a preacher, a trader or a leader does; the places stand before it with <ah> or the purpose with <in>) (r:zd:21978/zd:15681) (q:draft)
zinbuk = (i:1) (t:n) (f:travel) (w:guest house/inn/hotel/lodge) (d:<zin>, guest or traveller, with <buk>, hut: a house where travellers pay to stay) (r:zd:24188/ts:301/zd:23957) (q:draft)
zinding = (i:1) (t:v) (f:travel/politics) (w:will visit/to travel/to visit) (d:<zin>, travel, and <ding> written as one word: will travel to a place, is to visit it; common in headlines about official visits) (j:zin/ding) (r:zd:15726/zd:16663/zd:17192) (q:draft)
zing an = (i:1) (t:phrase) (f:food/time) (w:breakfast) (d:the morning meal) (r:zai:breakfast) (q:draft)
zingan = (i:1) (t:n) (f:food/time) (j:zing an) (r:zd:22868/zd:22019) (q:draft)
zingciang = (i:1) (t:adv) (f:time/everyday) (w:tomorrow/the next day) (d:also the day after an event: {a zingciang ni}) (a:zani) (q:draft)
zinglam = (i:1) (t:n) (f:time) (w:morning/in the morning) (d:<zing>, morning, with <lam>, side: the morning part of the day, also used before a clock time) (s:zingsang) (r:zd:16678/zd:12695) (q:draft)
zingsang = (i:1) (t:n) (f:time) (w:morning) (d:the early part of the day; {a zingsang ciangin} is in the morning or the next morning, and {zingsang tungin} is early in the morning) (a:nitak)
zingsang khuavak = (i:1) (t:n) (f:time) (w:daybreak/dawn/morning light) (d:<zingsang>, morning, with <khuavak>, daylight: the time when it grows light in the morning; followed by a word of time, as in {zingsang khuavak dong}, until daybreak, and {zingsang khuavak phetin}, as soon as day breaks) (s:phalvak) (r:zd:19826/zd:22779/zd:17060) (q:draft)
zingsanglam = (i:1) (t:n) (f:time) (w:morning/morning time) (d:<zingsang> and <lam> written as one word: the morning part of the day; with <in>, in the morning) (j:zingsang/lam) (r:zd:16373/zd:17917) (q:draft)
zingsangtung = (i:1) (t:n) (f:time) (w:early morning/dawn) (d:<zingsang>, morning, and <tung> written as one word: the early part of the morning; {zingsangtung in} is early in the morning) (j:zingsang/tung) (r:zd:14826/zd:15292/zd:18125) (q:draft)
zingsangtunglam = (i:1) (t:adv) (f:time) (w:early in the morning/in the early hours) (d:<zingsang> <tung> <lam> written as one word: around the earliest part of the morning, before or about dawn) (j:zingsang/tung/lam) (r:zd:17058/zd:14969/zd:21466) (q:draft)
zingtung = (i:1) (t:n) (f:time) (w:early morning/daybreak) (d:the early part of the morning, about daybreak; {zingtung an} is breakfast) (r:zd:21876/zd:23022) (q:draft)
zingvai = (i:1) (t:n) (f:social/family) (w:affairs/plans/future) (d:the affairs and coming days of a household or a people, literally the business of the morning, often paired with {nitak vai}; {zingvai hawm} is to deliberate and plan together) (r:zd:9448/zd:25110) (q:draft, low confidence)
zinmang = (i:1) (t:n) (f:social) (w:chief guest/guest of honour) (d:the honoured guest at a festival or meeting, from <zin>, guest) (r:zd:22357/zd:15865) (q:draft)
zinmangpi = (i:1) (t:n) (f:social) (w:chief guest/guest of honour) (d:<zin>, guest, with <mangpi>, lord: the chief guest of a festival or public gathering) (r:zd:15622/zd:17877/zd:22357) (q:draft)
zintunbuk = (i:1) (t:n) (f:travel) (w:hotel/guest house/inn) (d:<zintun>, lodge as a guest, with <buk>, here a hut or shelter: a house where travellers pay to stay; writers often add the English word Hotel beside it) (s:zintunna) (r:zd:13262/zd:12007) (q:draft)
zintung = (i:1) (t:v) (f:travel) (w:lodge/stay as a guest/put up) (d:<zin>, guest, with <tung>, arrive: stay somewhere as a traveller or guest, in a hotel or in another person's house; <zintun> is the form used before endings) (s:zintun) (r:ts:4831/zd:15842/zd:23086) (q:draft)
zintung = (i:2) (t:n) (f:travel) (w:guest/lodger) (d:a person who is staying in a hotel or a house as a guest, often {zintung te}) (r:zd:13262/zd:22040) (q:draft)
ZIOK = (i:1) (t:name) (f:social) (w:ZIOK) (d:short name of a Zomi community organisation in the United States, apparently <Zomi Innkuan> of Oklahoma; {ZIOK kipawlna} is the ZIOK organisation) (r:zd:26238/zd:11387) (q:draft, low confidence)
ZIS = (i:1) (t:name) (f:social) (w:ZIS) (d:abbreviated name of the Zomi community organisation in Singapore) (r:zd:17120/zd:21241) (q:draft, low confidence)
ZIUSA = (i:1) (t:name) (f:social) (w:Zomi Innkuan USA/ZIUSA) (d:abbreviation of Zomi Innkuan USA, the national association of the Zomi communities in the United States) (r:zd:16813/zd:13207) (q:draft)
ZNC = (i:1) (t:name) (f:politics) (w:Zomi National Congress/ZNC) (d:a Zomi political party in Myanmar, later named Zomi Congress for Democracy, ZCD) (r:zd:26252/zd:24481) (q:draft)
ZNTV = (i:1) (t:name) (f:media) (w:ZNTV/Zomi National TV) (d:short for Zomi National TV, a Zomi television and news channel) (r:zd:24024/zd:24594) (q:draft)
zo nawn = (i:1) (t:phrase) (f:everyday) (w:no longer able/cannot any more) (d:<zo>, be able, and <nawn>, any longer: placed after a verb and before a negative such as <lo>, <kei> or <keng>, no longer able to do it) (r:zd:20771/zd:22683/ts:6842) (q:draft)
zo tuan = (i:1) (t:part) (f:everyday) (w:still not able/not able even so) (d:<zo>, be able, and <tuan>, even so: placed after a verb and followed by a negative such as <lo> or <kei>, the action still cannot be done, in spite of what was said before) (r:zd:25357/zd:21246) (q:draft)
Zodial = (i:1) (t:n) (f:social/home) (w:Zomi scarf/Zomi sash) (d:a band of Zomi traditional cloth, <dial>, worn round the neck or over the shoulders and hung on guests and leaders as a mark of honour) (r:zd:26097/zd:26708/zd:20587) (q:draft)
zoding = (i:1) (t:v) (f:everyday) (w:will be able to/can manage) (d:<zo>, in its use after a verb for being able to do it, and <ding> written as one word: will be able to, will manage to) (j:zo/ding) (r:zd:22736/zd:23311/zd:15586) (q:draft)
Zogam = (i:1) (t:name) (c:land) (f:social/politics) (w:Zogam/Zoland) (d:{Zo} with <gam>, country: the homeland of the <Zomi>) (r:zd:23554/zd:24682/zd:24471) (q:draft)
Zogamah = (i:1) (t:adv) (f:travel/social) (w:in Zogam/to Zogam) (d:<Zogam>, the land of the Zomi, and the place marker <ah> written as one word: in or to Zogam) (j:Zogam/ah) (r:zd:15527/zd:17168/zd:22371) (q:draft)
Zoheisa = (i:1) (t:n) (c:plant) (f:nature) (w:Zoheisa flower) (d:a wild flower of the Zo hills, described as bright red and growing on large trees; also the name of a magazine and of groups; the English name of the plant is not known from the articles) (r:zd:17081/zd:21822) (q:draft, low confidence)
Zokam = (i:1) (t:name) (f:social/education) (w:Zo language/Zomi language) (d:{Zo} with <kam>, mouth or speech: the language of the Zomi) (s:Zopau) (r:zd:16958/zd:24217) (q:draft)
zokei = (i:1) (t:v) (f:everyday) (w:cannot/be unable/not manage) (d:<zo>, here be able or manage to, and the negative <kei>, written as one word after a verb: not be able to do it, not manage it) (j:zo/kei) (r:zd:21918/zd:17448/zd:21458) (q:draft)
Zola = (i:1) (t:n) (f:media/social) (w:Zo song/Zomi song/Zomi music) (d:a song of the Zo people or in their language, {Zo} with <la>, song) (b:la) (r:zd:17162/zd:16442) (q:draft)
Zolai = (i:1) (t:name) (f:education/social) (w:Zolai/Zomi writing/Zomi language) (d:the written language of the Zomi, Tedim Chin, and writing in it; {Zo}, Zomi, with <lai>, writing; {Zolai simbu} is the Zolai primer) (r:zd:17204/zd:19201/zd:21815) (q:draft)
zolai simbu = (i:1) (t:n) (f:education) (w:Zolai reader/Zolai primer) (d:Zolai, the Zomi written language, and <simbu>, here a book for reading, from <sim>, read, and <bu>, book, and not the bird: the school reader from which children learn to read Zolai, first made by J. H. Cope and issued by grade, as in {Zolai simbu tan thum}, the reader for grade three) (r:zd:11891/zd:23717/zd:23207) (q:draft)
Zoland = (i:1) (t:name) (c:land) (f:politics) (w:Zoland) (d:English-style name for the homeland of the Zo people, <Zogam>; in news mostly in the name of the armed group PDF Zoland) (s:Zogam) (r:zd:23436/ts:7016) (q:draft)
Zolei = (i:1) (t:name) (c:land) (f:social/nature) (w:Zo land/Zomi homeland) (d:the land of the Zomi; said as a pair with <Zogam>, as {Zogam Zolei}, in solemn and poetic speech) (r:zd:24026/zd:23729) (q:draft)
zoleng = (i:1) (t:v) (f:everyday) (w:if we can/if one manages to) (d:<zo>, here be able or manage, and <leng>, if, written as one word after a verb: if I or we manage to do it; the clause that follows says what will come of it) (j:zo/leng) (r:zd:16940/zd:20026/zd:12337) (q:draft)
Zolengthe = (i:1) (t:name) (c:place) (f:travel/social) (w:Zolengthe) (d:a quarter in the centre of Tedim town, also called Myoma, and the clock tower that stands there as a landmark of the town) (r:zd:20131/zd:22444) (q:draft, low confidence)
Zolia = (i:1) (t:n) (f:social) (w:Zomi young woman/Zo maiden) (d:{Zo}, Zomi, with {lia}, young unmarried woman: a young Zomi woman; paired with <Zotaang>, the young Zomi man) (r:zd:19964/zd:23363/zd:19474) (q:draft)
zolote = (i:1) (t:n) (f:everyday) (w:those unable/those who cannot) (d:<zolo>, cannot, and the plural <te> written as one word after a verb: the people who are not able to do it) (j:zolo/te) (r:zd:23554/zd:22140/zd:17672) (q:draft)
zolzol = (i:1) (t:v) (f:everyday/social) (w:coax/persuade/urge) (d:<zol> doubled: coax or persuade again and again, keep on urging) (b:zol) (r:zd:12565/zd:15073/zd:22595) (q:draft)
zom toto = (i:1) (t:v) (f:everyday/media) (w:carry on/keep on/continue) (d:<zom>, continue, and <toto>, onward: go on with something already begun; {zom toto lai ni}, let us go on, closes one part of a serial article in the sense of to be continued) (r:ts:12490/zd:19108/zd:25348) (q:draft)
Zomi = (i:1) (t:name) (c:people) (f:social) (w:Zomi/Zo people) (d:the Zo people: the name that the speakers of Zolai and their kin in Myanmar and India use for themselves) (r:ts:3372/zd:23398/zd:11908) (q:draft)
Zomi Idol = (i:1) (t:name) (f:media/social) (w:Zomi Idol) (d:<Zomi> with the English word <Idol>: the name of a singing competition of the Zomi community, modelled on American Idol; also said of the event of one year or place, as in {Zomi Idol Malaysia}) (r:zd:23130) (q:draft)
Zomi Innkuan = (i:1) (t:name) (f:social) (w:Zomi Innkuan/Zomi community organisation) (d:<Zomi> and <innkuan>, family: the name that the Zomi community organisations abroad carry, followed by the country or city, as {Zomi Innkuan USA}) (r:zd:24649/zd:25789) (q:draft)
zomi namni = (i:1) (t:n) (f:social/time) (w:Zomi National Day) (d:<Zomi> and {namni}, national day: the national day of the Zomi people, kept each year on 20 February with a festival) (r:zd:11011) (q:draft)
Zomibup = (i:1) (t:n) (f:social/politics) (w:all Zomi/the whole Zomi people) (d:<Zomi> with <bup>, whole, written as one word: the Zomi as a whole, all Zomi everywhere) (j:Zomi/bup) (r:zd:23832/zd:23129/zd:15871) (q:draft)
Zominam = (i:1) (t:name) (c:people) (f:social/politics) (w:Zomi people/Zomi nation) (d:<Zomi> with <nam>, kind, here people or nation, written as one word; {Zominam ni} is Zomi National Day, 20 February) (b:Zomi) (r:zd:22371/zd:25573/zd:8668) (q:draft)
Zomipih = (i:1) (t:n) (f:social) (w:fellow Zomi) (d:<Zomi> with the ending of <mipih>, fellow countryman: a person who is Zomi like oneself, the Zomi as one's own people) (b:Zomi) (r:zd:23538/ts:9859) (q:draft)
Zomipihte = (i:1) (t:n) (f:social) (w:fellow Zomi) (d:Zomi with {-pih}, fellow, and the plural <te>: one's fellow Zomi, the people of one's own nation; compare <mipihte>) (r:zd:21120/zd:21159) (q:draft)
Zomite = (i:1) (t:name) (c:people) (f:social) (w:the Zomi/Zomi people) (d:<Zomi> with the plural <te>: the Zomi as a people) (b:Zomi) (r:zd:24392/zd:24978/ts:3375) (q:draft)
Zomiten = (i:1) (t:phrase) (f:social) (w:the Zomi/we Zomi) (d:<Zomite>, the Zomi, with the subject marker <in> shortened to <n> and written as one word: the Zomi as the ones who do or have something) (b:Zomite) (j:Zomi/te/in) (r:zd:9449/zd:16263) (q:draft)
zomkik = (i:1) (t:v) (f:everyday) (w:resume/continue again/rejoin) (d:<zom> and <kik> written as one word: take up again what was stopped; of things or relations that were parted, join them again) (j:zom/kik) (r:zd:20264/zd:12632) (q:draft)
ZOMUS = (i:1) (t:name) (f:media/social) (w:ZOMUS/Zomi Music Uplift Society) (d:short name of the Zomi Music Uplift Society, an association that promotes Zomi music) (r:zd:23355/zd:23090) (q:draft)
ZoMWA = (i:1) (t:name) (f:media) (w:ZoMWA/Zomi Media and Writers Association) (d:short name of the Zomi Media and Writers Association) (r:zd:19704/zd:18252) (q:draft)
zonailo = (i:1) (t:adv) (f:everyday) (w:not yet able/not yet managed) (d:<zo>, be able, and <nailo> not yet written as one word after a verb: has not yet been able to do it) (j:zo/nailo) (r:zd:26565/zd:17141) (q:draft)
zonawnlo = (i:1) (t:v) (f:everyday) (w:can no longer/be no longer able to) (d:<zo>, be able, and <nawnlo>, no longer, written as one word after a verb: no longer able to do it) (j:zo/nawnlo) (r:zd:14689/zd:12057/zd:19455) (q:draft)
zone = (i:1) (t:n) (f:politics/everyday) (w:zone/area) (d:an area marked off for a purpose or under one administration, mostly in fixed English phrases such as comfort zone and industrial zone) (o:English) (r:zd:25919) (q:draft, low confidence)
ZoNet = (i:1) (t:name) (f:it/media) (w:ZoNet) (d:name of an internet forum of the Zomi on which writings were posted and discussed) (r:zd:24574/zd:25562) (q:draft, low confidence)
zong = (i:1) (t:adv) (f:everyday) (w:also) (d:placed after the word or phrase it adds: this one as well as those already named)
zong hithei = (i:1) (t:phrase) (f:everyday) (w:it may be that/may also be/possibly) (d:<zong>, also, and <hithei>, can be: placed after a noun or a whole clause and before the final <hi>, it says that this too is possible, it may be that; {zong hithei hilo thei} is it may be so or it may not) (r:zd:20498/zd:23148/zd:15869) (q:draft)
zongah = (i:1) (t:ppm) (f:everyday) (w:also in/also at) (d:<zong>, also, and the place marker <ah> written as one word after a noun: in or at that place too) (j:zong/ah) (r:ts:3654/ts:3737/ts:1348) (q:draft)
