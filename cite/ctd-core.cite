innhuangsung = (i:1) (t:n) (f:home) (w:house compound/yard/grounds) (d:<inn> and <huangsung> written as one word: the space inside the fence of a house; {innhuangsung ah} is in the compound of the house) (j:inn/huangsung) (r:zd:17568/zd:11133) (q:draft)
innka = (i:1) (t:n) (f:home) (w:veranda/open platform/deck) (d:the raised open platform at the front of a traditional Zomi house, where people sit, rest and receive visitors) (r:zd:14804/ts:479/zd:26097) (q:draft)
innkaa = (i:1) (t:n) (f:home) (j:innka) (r:zd:11110/ts:3369) (q:draft)
innkang = (i:1) (t:n) (f:home) (w:house fire/fire) (d:<inn>, house, with <kang>, burn: the burning of a house or building) (r:zd:13009/zd:16739) (q:draft)
Innkangpi = (i:1) (t:name) (c:place) (f:politics) (w:White House) (d:<inn>, house, <kang>, white, and <pi>, great: the White House, the residence and office of the President of the United States) (j:inn/kang/pi) (r:zd:16340) (q:draft)
innkhan = (i:1) (t:n) (f:home) (w:room) (d:a room of a house or building; {innkhan sung} is the inside of the room) (s:dei) (r:zd:23972/zd:24014/zd:23590) (q:draft)
innkhat = (i:1) (t:n) (f:home) (w:a house/one house) (d:<inn> and <khat> written as one word: a house, one house) (j:inn/khat) (r:zd:15296/zd:11148/zd:19381) (q:draft)
innkhatkhit = (i:1) (t:phrase) (f:home/everyday) (w:house after house/from house to house) (d:<innkhat> and <khit> written as one word; in {innkhatkhit innkhat}, after one house another, house by house) (j:innkhat/khit) (r:zd:14545/zd:20401) (q:draft)
innkhum = (i:1) (t:n) (f:home) (w:roof) (d:the top of a house; {innkhum zang} is the flat roof, {innkhum dawn} the rooftop) (s:khum/innkhumzang/tungkhum) (q:draft)
innkicim = (i:1) (t:n) (f:home/media) (w:building collapse/collapsed building) (d:<inn>, house, and <kicim>, collapse, written as one word: the collapse of a building, or the building that has collapsed) (j:inn/kicim) (r:zd:15296/zd:17645/zd:20488) (q:draft)
innkong = (i:1) (t:n) (f:home) (w:house door/front door/door) (d:<inn>, house, and <kong>, door, written as one word: the door of a house or flat) (j:inn/kong) (r:zd:22932/zd:15019) (q:draft)
innkongkhak = (i:1) (t:n) (f:home) (w:house door/front door) (d:<inn> and <kongkhak> written as one word: the door of a house) (j:inn/kongkhak) (r:zd:11823/zd:22932/zd:17028) (q:draft)
innkuahpih = (i:1) (t:n) (f:family) (j:innkuanpih) (r:zd:15727/zd:12660) (q:draft, low confidence; probably a misspelling of innkuanpih)
innkuan = (i:1) (t:n) (f:family/home) (w:family) (d:the people of one house and line, parents and children together) (s:innkuanpih)
innkuan lutang = (i:1) (t:n) (f:family) (w:head of household/head of the family) (d:<innkuan>, family, and <lutang>, head: the person who stands for a household, as in lists and registrations of members) (r:zd:25789) (q:draft)
innkuanbup = (i:1) (t:n) (f:family) (w:whole family/entire family) (d:<innkuan> and <bup> written as one word: the whole family, all the members of a household) (j:innkuan/bup) (r:zd:19953/zd:12336) (q:draft)
innkuankhat = (i:1) (t:n) (f:family) (w:one family/same family) (d:<innkuan>, family, and <khat>, one, written as one word: one family, people of the same family) (j:innkuan/khat) (r:zd:11148/zd:11335) (q:draft)
innkuanpen = (i:1) (t:n) (f:family) (w:family) (d:<innkuan>, family, and the topic marker <pen> written as one word: the family, as the topic of the sentence) (j:innkuan/pen) (r:zd:16332/zd:18077) (q:draft)
innkuansungah = (i:1) (t:adv) (f:family/home) (w:in the family/in the household) (d:<innkuansung>, household, and the place marker <ah> written as one word: in the family, within the household) (j:innkuansung/ah) (r:zd:25200/zd:12774) (q:draft)
innkuanun = (i:1) (t:adv) (f:family) (w:as a family/the whole family together) (d:<innkuan>, family, and <un>, the marker of a plural subject, written as one word: the family as the ones who act, all of them together; {a innkuanun} is he and his family) (j:innkuan/un) (r:zd:9227/zd:14804) (q:draft)
innlawi = (i:1) (t:n) (c:animal) (f:nature/home) (w:cockroach) (r:zd:17497/zd:12698) (q:draft)
innlehlo = (i:1) (t:n) (f:home/work) (w:home and land/homestead/house and fields) (d:<inn>, house, <leh>, and, and <lo>, field, written as one word: a household with its house and farmland, what a family lives in and from) (j:inn/leh/lo) (r:zd:25866/zd:12717) (q:draft)
innluh = (i:1) (t:v) (f:home/politics) (w:break into a house/burgle/rob a house) (d:<inn>, house, with <luh>, break into: enter a house by force to steal; {innluh guta} is a burglar) (r:zd:16998/zd:15764) (q:draft)
innlui = (i:1) (t:n) (f:home) (w:old house/old building) (d:<inn> and <lui> written as one word: an old house or building) (j:inn/lui) (r:zd:24139/zd:19002/zd:14954) (q:draft)
innlum = (i:1) (t:n) (f:home) (w:home/shelter/dwelling) (d:the shelter of a house; mostly in the pair {innlum lolum}, house and home, all that a household lives in and lives from) (r:zd:23037/zd:12033) (q:draft, low confidence)
innmai = (i:1) (t:n) (f:home) (w:front of the house/front yard) (d:<inn>, house, with <mai>, front: the space in front of a house; paired with <innnung>, behind the house) (r:zd:16321/zd:25918/zd:10866) (q:draft)
innmun = (i:1) (t:n) (f:home/work) (w:house plot/building site/homestead) (d:<inn>, house, with <mun>, place: the piece of land on which a house stands or can be built; often paired with <logam>, farmland, as a family's property) (r:zd:24594/zd:16728/zd:25143) (q:draft)
innnasem = (i:1) (t:n) (f:work/home) (w:domestic worker/maid/house servant) (d:<inn>, house, with <nasem>, worker, written as one word: a person, mostly a woman, employed to do the work of a household) (j:inn/nasem) (r:zd:10722/zd:15103) (q:draft)
innnasemnu = (i:1) (t:n) (f:work/home) (w:housemaid/female domestic worker) (d:<inn> and <nasemnu> written as one word: a woman or girl employed as a servant in a house) (j:inn/nasemnu) (r:zd:12841) (q:draft)
innnei = (i:1) (t:n) (f:home) (w:householder/house owner/occupant) (d:<inn>, house, with <nei>, have: the one who has the house, its owner or the household living in it) (s:innteek) (r:zd:20514/zd:24242) (q:draft)
innneilo = (i:1) (t:adj) (f:home/social) (w:homeless) (d:<inn> and <neilo> written as one word: having no house, and the people who have none) (j:inn/neilo) (r:zd:18012/zd:19960) (q:draft)
innneipa = (i:1) (t:n) (f:home) (w:house owner/landlord/householder) (d:<inn> and <neipa> written as one word: the man who owns the house) (s:innteek) (j:inn/neipa) (r:zd:15021/zd:11872) (q:draft)
innngak = (i:1) (t:n) (f:home/family) (w:housekeeper/house-sitter/caretaker) (d:<inn> house and <ngak> wait or keep watch, written as one word: one who stays at home to look after the house, and staying at home in that way; {innngak kumpi} is a caretaker government) (j:inn/ngak) (r:zd:20177/zd:17028/zd:15019) (q:draft)
innnuai = (i:1) (t:n) (f:home) (w:downstairs/ground floor/lower floor) (d:<inn> and <nuai> written as one word: the lower floor of a house or the space under it, the opposite of <inntung>, upstairs) (j:inn/nuai) (r:zd:16294/zd:15803/zd:13009) (q:draft)
innnuam = (i:1) (t:n) (f:home/religion) (w:pleasant home/happy home) (d:<inn>, home, and <nuam>, pleasant, written as one word: a pleasant, comfortable home; {van innnuam} is the heavenly home) (j:inn/nuam) (r:zd:11988/zd:24542) (q:draft)
innnung = (i:1) (t:n) (f:home) (w:back of the house/behind the house) (d:<inn>, house, with <nung>, back: the rear of a house and the space behind it; {innnung kongkhak} is the back door) (a:innmai) (j:inn/nung) (r:zd:12901/zd:10866) (q:draft)
innnunglam = (i:1) (t:n) (f:home) (w:back of the house/behind the house) (d:<inn>, house, and <nunglam>, back side, written as one word: the back of a house or building, the space behind it) (j:inn/nunglam) (r:zd:21793/zd:11285/zd:16617) (q:draft)
innnupi = (i:1) (t:n) (f:home/family) (w:housewife/woman of the house) (d:<inn>, house, with <nupi>, married woman: the wife who keeps the house and has no outside work; the man of the house is {innpapi}) (r:zd:14622/zd:16321) (q:draft)
innpaam = (i:1) (t:n) (f:home) (w:surroundings of the house/area around the house) (d:<inn> and <paam> written as one word: the ground around a house; mostly paired as {innkiim innpaam}, the house and all its surroundings) (j:inn/paam) (r:zd:15996/zd:10866) (q:draft)
innpam = (i:1) (t:n) (f:home/social) (w:neighbourhood/surroundings of a house) (d:<inn>, house, with <pam>, vicinity; used in the pair {inn kiim innpam}, all around the house, the neighbourhood) (j:inn/pam) (r:zd:20968) (q:draft)
innpan = (i:1) (t:adv) (f:home/everyday) (w:from home/from the house/out of the house) (d:<inn> and <pan> written as one word: from the house, from home) (j:inn/pan) (r:zd:25111/zd:12319/zd:12717) (q:draft)
innpanin = (i:1) (t:adv) (f:home/everyday) (w:from home/from the house) (d:<inn>, house, and <panin>, from, written as one word: from the house, from home) (j:inn/panin) (r:zd:18152/zd:16772) (q:draft)
innpawlkhat = (i:1) (t:n) (f:home) (w:some houses) (d:<inn> and <pawlkhat> written as one word: some houses, a number of houses) (j:inn/pawlkhat) (r:zd:17416/zd:17911) (q:draft)
innpen = (i:1) (t:n) (f:home) (w:the house/the building) (d:<inn>, house, and the topic marker <pen> written as one word: the house as the thing the sentence is about) (j:inn/pen) (r:zd:14969/zd:14952) (q:draft)
innphiat = (i:1) (t:v) (f:home/work) (w:sweep the house/clean the house) (d:<inn>, house, and <phiat>, sweep, written as one word: sweep or clean a house or building, and the work of doing so; {innphiat numei} is a cleaning woman) (j:inn/phiat) (r:zd:21908/zd:25932/zd:12220) (q:draft)
innphual = (i:1) (t:n) (f:home) (w:home/homestead/house premises) (d:<inn>, house, with <phual>, place: the home and its ground, the place where one lives; also a building or hall used for an activity) (r:zd:18001/zd:11431) (q:draft, low confidence)
innpi = (i:2) (t:n) (f:politics) (w:assembly/parliament/house) (d:a law-making assembly of a country or a state and one of its houses, not a building: <gambup innpi> is the Union Assembly, and {Manipur gamkee innpi} the assembly of Manipur State) (r:zd:21327/zd:11720) (q:draft)
innpikhat = (i:1) (t:n) (f:home/media) (w:a large building/a big building) (d:<innpi>, great house, and <khat>, one, written as one word: a large building) (j:innpi/khat) (r:zd:17729/zd:16912) (q:draft)
Innpipa = (i:1) (t:n) (f:social) (w:chief/headman) (d:<innpi>, great house, with <pa>, man: the head of the chief's house, title of a hereditary Zomi chief placed before his name; his wife is {Innpinu}) (r:zd:15996) (q:draft)
innpualam = (i:1) (t:adv) (f:home) (w:outside the house/outdoors) (d:<inn>, house, and <pualam>, outside, written as one word: the outside of the house, out of doors) (j:inn/pualam) (r:zd:16926/zd:14509) (q:draft)
innsaap = (i:1) (t:n) (f:home) (w:house rent/rented house/rental housing) (d:<inn>, house, with <saap>, hire: the renting of a house, the rent paid for it, or a house that is rented) (r:zd:12647/zd:20339) (q:draft)
innsaapna = (i:1) (t:n) (f:home) (w:rented house/rented room/lodging) (d:{inn saap}, rent a house, with the noun suffix <na>: the house or room that a person rents and lives in) (r:zd:20595/zd:12373) (q:draft)
innsang = (i:1) (t:n) (f:home) (w:tall building/high-rise) (d:<inn>, house, with <sang>, high, written as one word: a tall building of many storeys) (j:inn/sang) (r:zd:11438/zd:18166) (q:draft)
innsangdawn = (i:1) (t:n) (f:home) (w:rooftop/top of a tall building) (d:<inn>, house, <sang>, high, and <dawn>, top: the top or roof of a high building) (r:zd:11172/zd:13022) (q:draft)
innsangpi = (i:1) (t:n) (f:home) (w:tall building/high-rise/skyscraper) (d:<inn>, house, with <sangpi>, very high: a very tall building of many floors) (j:inn/sangpi) (r:zd:14559/zd:13009/zd:12319) (q:draft)
innsangtung = (i:1) (t:phrase) (f:home/everyday) (w:top of a tall building/up on a high-rise) (d:<innsang>, tall building, with <tung>, on or top, written as one word; mostly with <pan> or <panin>, from the top of a tall building) (j:innsang/tung) (r:zd:13046/zd:21611) (q:draft)
innsap = (i:1) (t:n) (f:home/work) (w:house rent/rented house/renting a house) (d:<inn>, house, with <sap> in the sense of rent: living in a rented house, a rented house, and the rent paid for it) (r:zd:26620/zd:12166/zd:20999) (q:draft)
innsung = (i:1) (t:n) (f:home/family) (w:home/household) (d:<inn>, house, with <sung>, inside: the inside of a house, and so the home and the people who live in it) (s:innkuan/innkuansung) (q:draft)
innsungpan = (i:1) (t:adv) (f:home) (w:from the house/from inside the home/from a household) (d:<innsung>, the inside of a house or a household, and <pan>, from, written as one word) (j:innsung/pan) (r:zd:12093/zd:15095) (q:draft)
innsungteng = (i:1) (t:n) (f:home) (w:the whole house/all through the house) (d:<innsung>, the inside of a house, with <teng> in the sense all, written as one word: every part of the inside of the house) (j:innsung/teng) (r:zd:22162/zd:11700/zd:12208) (q:draft)
innteek = (i:2) (t:n) (f:social) (w:host) (d:the person, church, town or country that receives guests or holds an event for others; {innteek sem} is to act as host and {innteek pawlpi} is the host church) (r:zd:16038/zd:12168/zd:18086) (q:draft)
innteekna = (i:1) (t:n) (f:social) (w:hosting/being host) (d:<innteek>, householder, with {-na}: being the host of an event; {innteekna tawh} after the name of a group means hosted by that group) (b:innteek) (r:ts:2844/zd:10743) (q:draft)
innteeknu = (i:1) (t:n) (f:home/family) (w:lady of the house/hostess/housewife/landlady) (d:<innteek>, house owner, with <nu> marking a woman: the woman to whom a house belongs or who keeps it) (b:innteek) (r:zd:16634/zd:9249/zd:16321) (q:draft)
innteekpa = (i:1) (t:n) (f:home/work) (w:master of the house/house owner/landlord/employer) (d:<innteek> and <pa> written as one word: the man who owns the house, also the master for whom a household worker works) (j:innteek/pa) (r:zd:20470/zd:16294) (q:draft)
innteekte = (i:1) (t:n) (f:home/social) (w:house owners/hosts/landlords) (d:<innteek> with the plural {-te}: the people to whom a house belongs, the hosts who receive guests, or the owners who rent a house out) (b:innteek) (r:zd:22827/zd:25470) (q:draft)
innteeng = (i:1) (t:n) (f:work/home) (w:domestic worker/housemaid/live-in helper) (d:one who lives in the house of an employer and does the housework; built from <inn>, house, and <teeng>, live; mostly in <innteeng nasem>, domestic worker) (r:zd:17936/zd:16657/zd:15956) (q:draft)
innteeng nasem = (i:1) (t:n) (f:work/home) (w:domestic worker/housemaid/maid) (d:<innteeng>, one who lives in the house of an employer, and <nasem>, worker: a person employed to do the housework and living in the house; with <in> and a verb such as <om> it says that someone works as a maid) (r:zd:12992/zd:15761) (q:draft)
innteeng nasemnu = (i:1) (t:n) (f:work/home) (w:housemaid/domestic helper/live-in maid) (d:<innteeng>, one who lives in the house, with <nasemnu>, female servant: a woman employed to live in a household and do its work, the usual news term for a foreign domestic helper) (r:zd:16580/zd:15575) (q:draft)
inntek = (i:1) (t:n) (f:home/social) (w:host/householder/house owner) (d:the people of the house or place that receives guests or holds an event; another spelling of <innteek>; {inntek te} are the hosts, the family of the house) (s:innteek) (r:zd:25616/zd:18241) (q:draft)
inntek = (i:2) (t:v) (f:social) (w:be at home/act as owner) (d:behave as the owner of a place or a cause: be fully at home in it or take a leading part in it, mostly as {inntek mahmah}) (r:zd:24481/zd:20227) (q:draft, low confidence)
inntekna = (i:1) (t:n) (f:social/home) (w:hosting/ownership) (d:<inntek>, host or owner of the house, with the noun suffix <na>: being the host or the owner, hosting) (b:inntek) (r:zd:26708/zd:15637) (q:draft, low confidence)
innteknu = (i:1) (t:n) (f:home/work) (w:mistress of the house/female employer/landlady) (d:<innteek>, house owner, with <nu> for a woman, in a shorter spelling: the woman who owns the house, also the woman for whom a maid works) (b:innteek) (r:zd:11941) (q:draft)
inntekpa = (i:1) (t:n) (f:home/family) (w:householder/master of the house/house owner/host) (d:the man who owns or heads a house, and so the host of a guest; another spelling of {innteek pa}) (s:innteek) (r:zd:14804/zd:14530) (q:draft)
inntekte = (i:1) (t:n) (f:home/family) (w:householders/hosts/family of the house) (d:the people to whom a house belongs: the hosts as against their guests, or the household concerned, as a bereaved family; plural of <inntek>, also spelled <innteek>) (b:innteek) (r:zd:12487/zd:21175) (q:draft)
innteng = (i:1) (t:n) (f:work/home) (w:domestic worker/housemaid/live-in maid) (d:a person who lives in an employer's house and does the housework there; {innteng nasep} is domestic work) (r:zd:21662/zd:20975/zd:10722) (q:draft)
innthak = (i:1) (t:n) (f:home) (w:new house/new home) (d:<inn> and <thak> written as one word: a new house; {innthak honna} is the opening of a new house) (j:inn/thak) (r:zd:24594/zd:20512/zd:17655) (q:draft)
inntuan = (i:2) (t:v) (f:politics) (w:secede/break away/become independent) (d:of a people or a region, leave a country and set up a state of its own, as a son leaves the family house; with <pan>, break away from) (r:zd:23241/zd:24847) (q:draft)
inntuan = (i:3) (t:v) (f:family) (w:set up a separate household/move out) (d:of a married son, leave the house of the parents and live in a house of his own, without the thought of dividing property) (r:zd:21991) (q:draft, low confidence)
inntung = (i:1) (t:n) (f:home) (w:upstairs/upper floor/roof/rooftop) (d:<inn>, house, with <tung>, top: the upper part of a house, either the floor upstairs or the roof; the opposite is <innnuai>, downstairs) (r:zd:16294/zd:11375) (q:draft)
inntungah = (i:1) (t:adv) (f:home) (w:on the roof/on the house/upstairs) (d:<inntung>, roof or upper floor, and <ah> written as one word: on top of the house, or to the floor upstairs) (j:inntung/ah) (r:zd:19427/zd:14952) (q:draft)
inntungdawl = (i:1) (t:n) (f:home) (w:upper floor/upstairs/storey) (d:<inntung>, the upper part of a house, with <dawl>, floor: a floor above the ground floor; a number after it counts the storey) (j:inntung/dawl) (r:zd:11285/zd:16344) (q:draft)
inntungdawn = (i:1) (t:n) (f:home) (w:rooftop/top of a building/upper floor) (d:<inn>, house, with <tung>, upon, and <dawn>, top: the top of a house or building, its roof or a high storey) (r:zd:14904/zd:12605) (q:draft)
inntungkhuh = (i:1) (t:n) (f:home) (w:roof/roofing) (d:<inn>, house, with <tungkhuh>, covering: the roof of a house and the sheets it is made of) (s:innkhum) (j:inn/tungkhuh) (r:zd:12717/zd:13326/zd:14547) (q:draft)
inntungpan = (i:1) (t:adv) (f:home) (w:from the top of a building/from the roof) (d:<inn>, house, and <tungpan>, from upon, written as one word: from the roof or an upper floor of a building, mostly of a fall) (j:inn/tungpan) (r:zd:16634) (q:draft)
innvak = (i:1) (t:v) (f:social/travel) (w:go from house to house/visit homes) (d:<inn>, house, with a verb for going about: go round visiting houses one after another) (r:zd:23170/zd:20595) (q:draft)
innveng = (i:1) (t:n) (f:social/home) (w:neighbourhood/neighbour) (d:the houses near one's own and those who live there) (s:veng) (q:draft)
innvuah = (i:1) (t:adv) (f:home) (w:at our house/at your house/at their house) (d:<inn> and <vuah> written as one word, after <ka>, <na> or <a>: in or at the house of several people, at our home) (j:inn/vuah) (r:zd:21174/zd:16216) (q:draft)
