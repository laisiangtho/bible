style = (i:1) (t:n) (f:media/everyday) (w:style/manner/fashion) (d:the way something is made, sung or done) (o:English) (r:zd:21102/zd:16216) (q:draft, low confidence)
suah seh = (i:1) (t:phrase) (f:education/everyday) (w:out of/parts of) (d:<suah>, make into, and <seh>, part: the middle of a fraction, in the frame {seh thum suah seh nih}, of three parts two, two thirds; the first number is the whole and the second the share) (r:zd:17613/zd:23301) (q:draft)
suahding = (i:1) (t:v) (f:everyday) (w:to become/will become) (d:<suah>, become, and <ding> written as one word: to become, becoming something in time to come) (j:suah/ding) (r:zd:21063/zd:20971/zd:12715) (q:draft)
suahin = (i:3) (t:v) (f:everyday) (w:bringing out/putting forth) (d:<suah.3>, bring out, with the linking ending <in>: bringing out something one has, such as gifts, or putting forth all one knows, before the next action) (r:ts:8980) (q:draft, low confidence)
suahkha = (i:1) (t:n) (f:time/family) (w:month of birth/birth month) (d:<suah>, be born, with <kha>, month: the month in which a person was born, usually named together with <suahni>, the day of birth) (j:suah/kha) (r:zd:12280/zd:25789) (q:draft)
suahkhia = (i:3) (t:v) (f:media) (w:publish/release/post/issue) (d:make news, a report, a photo or a statement public in a newspaper or online; the thing published or the place, as {newspaper ah}, stands before {suahkhia}) (r:zd:14949/ts:6677/zd:11175) (q:draft)
suahkhiasak = (i:1) (t:v) (f:everyday/body) (w:make take off/have removed) (d:<suahkhia> and <sak> written as one word: make someone take off clothes or shoes) (j:suahkhia/sak) (r:zd:20132) (q:draft)
suahkhiat = (i:3) (t:v) (f:home/everyday) (w:take off/remove/strip off) (d:take clothes or shoes off the body, with the thing worn as object, as {puan suahkhiat} or {khedap suahkhiat}; with <sak>, make someone take them off) (r:zd:23928/zd:17055) (q:draft)
suahkhiat = (i:4) (t:v) (f:media/politics) (w:issue/publish/bring out) (d:put something out to the public, as a magazine publishes a report or a government issues a law; the object is the thing made public) (r:zd:11083/ts:6677) (q:draft, low confidence)
Suahlim = (i:1) (t:name) (c:khua) (f:travel) (w:Suahlim) (d:a village of the Sizang area in Tedim Township, northern Chin State, Myanmar) (r:zd:10743/ts:3168) (q:draft, low confidence)
suahna = (i:4) (t:n) (f:social) (w:becoming/being made) (d:noun of <suah> in its meaning become, not be born or rise: the becoming of what the words before it name, as {makai suahna} becoming a leader and {pumkhat suahna} becoming one) (r:ts:9856/zd:18915/zd:24963) (q:draft)
suahni = (i:1) (t:n) (f:time/family) (w:birthday/date of birth/day of birth) (d:<suah> and <ni> written as one word: the day on which someone was born, or the day on which an organisation was founded) (j:suah/ni) (r:zd:21739/zd:16820/zd:15905) (q:draft)
suahpih = (i:2) (t:adj) (f:family) (w:born of the same parents/full) (d:born together with someone of the same mother and father, said of brothers and sisters, beside <sanggam> or <unau>; not a thing a person has from birth) (r:zd:23148/zd:14760) (q:draft)
suahpih = (i:3) (t:v) (f:everyday) (w:bring out to/lead up to) (d:<suah>, come out, with <pih>, together with: bring someone out at a place, in the articles after <mual> and <hong> for bringing a people up to the hilltop of success) (r:zd:24712/zd:21473) (q:draft, low confidence)
suahsak = (i:3) (t:v) (f:media) (w:publish/post/issue) (d:put a piece of news or writing out for the public in a paper, a book or on the internet; {kong suahsak} is I publish here for you) (r:zd:24594/zd:25461/zd:15695) (q:draft)
suahsawm = (i:1) (t:v) (f:everyday/social) (w:try to become/aim to be) (d:<suah>, become, with <sawm>, intend, written as one word: set out to become something) (j:suah/sawm) (r:zd:19841/zd:13077/zd:20481) (q:draft)
suahtaak = (i:1) (t:v) (f:everyday/politics) (j:suahtak) (r:zd:19308/zd:25678) (q:draft)
suahtaakna = (i:1) (t:n) (f:politics) (j:suahtakna) (r:zd:25712/zd:23488/zd:25678) (q:draft)
suahtak = (i:2) (t:n) (f:politics) (w:independence/freedom) (d:the freedom of a country from foreign rule, used as a noun without the suffix {-na} in {suahtak ni}, Independence Day, and {suahtak ngah}, gain independence) (s:suahtakna) (r:zd:17106/zd:19208) (q:draft)
suahtakna ngah = (i:1) (t:v) (f:politics) (w:gain independence/become free/be released) (d:<suahtakna>, freedom, and <ngah>, get: of a country, gain independence from a ruling power, and of a person, be set free; {suahtakna ngah khit ciang} is after independence) (r:zd:17106/zd:24743/zd:23792) (q:draft)
suahtakpih = (i:1) (t:v) (f:everyday/social) (w:rescue/bring to safety/escape with) (d:<suahtak>, escape, with <pih>, together with: get away taking someone along, set someone free) (j:suahtak/pih) (r:zd:20083/zd:16457) (q:draft)
suai = (i:1) (t:v) (f:media/education) (w:draw/paint/depict) (d:make a picture; {lim suai} is draw or paint a picture) (r:zd:17466/zd:23113) (q:draft)
suai = (i:2) (t:n) (f:politics/work) (w:signature) (d:a signature, said with <kai>, draw: {suai kai} is sign one's name, and {thukimna suai kai} is sign an agreement) (r:ts:12274/zd:17760/zd:21421) (q:draft)
suaih = (i:1) (t:v) (f:education/media) (w:draw/paint/sketch) (d:draw or paint a picture, {lim suaih}; said also of drawing up a budget; also written <suai>) (r:zd:17466/zd:16078/zd:22747) (q:draft)
suaihsak = (i:1) (t:v) (f:education/media) (w:draw for/have drawn/paint for) (d:<suaih>, draw, with <sak>: draw or paint something for someone, or have something drawn, as a plan, a picture or a tattoo) (j:suaih/sak) (r:zd:24649/zd:20317) (q:draft)
suaikai = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature) (d:write one's name on a document or an agreement to approve it; {thukimna suaikai} is sign an agreement) (r:ts:3375/zd:21659/zd:11463) (q:draft)
suaikaih = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature to) (d:<suai>, signature, with <kaih>, draw: sign a document or agreement; the form used before <na> and <lai>, and <suaikaihna> is the signing) (r:ts:12498/zd:17722) (q:draft)
suaikaihna = (i:1) (t:n) (f:politics/work) (w:signing/signature) (d:<suaikaih>, sign, with the noun suffix {-na}: the signing of an agreement, {suaikaihna nei} is hold a signing; also the signature itself) (b:suaikaih) (r:zd:25392/ts:5888/zd:16114) (q:draft)
suaikailo = (i:1) (t:v) (f:politics) (w:not sign/non-signatory) (d:<suaikai>, sign, and <lo>, not, written as one word: not signing; before a noun or <teng>, those who have not signed an agreement) (j:suaikai/lo) (r:zd:24535/zd:14924) (q:draft)
suaikhi = (i:1) (t:n) (f:home) (w:necklace/gold necklace/neck chain) (d:a chain worn round the neck as jewellery, usually of gold; named with <bilbah>, earrings) (s:khamkhi) (r:zd:21121/zd:14941) (q:draft)
suaisai = (i:1) (t:n) (f:work/everyday) (w:gold shop/jewellery shop/goldsmith's shop) (d:a shop that sells gold and jewellery) (o:Burmese, shwe hsaing) (r:zd:12063/zd:19872) (q:draft)
suaisak = (i:1) (t:v) (f:media/education) (w:have drawn/draw for/have someone draw) (d:<suai>, draw or sign, with <sak>: have a picture drawn or get someone to draw; {lim suaisak} is have a portrait drawn) (j:suai/sak) (r:zd:23201) (q:draft, low confidence)
suaisuai = (i:1) (t:v) (f:media/education) (w:keep painting/draw at length) (d:doubled <suai.1>: paint or draw on and on; after verbs of going and speaking the same form is an adverb whose exact sense is not determined here) (b:suai) (r:zd:15653) (q:draft, low confidence)
suaizuakna = (i:1) (t:n) (f:work) (w:goldsmith shop/jewellery shop) (d:a shop that sells gold and jewellery; the first part is a Burmese loan for gold, joined with <zuakna>, selling) (o:Burmese) (r:zd:12063/zd:19738) (q:draft)
suak = (i:3) (t:v) (f:everyday/family) (w:be born/come out/rise) (d:come out or come forth: of a person, be born in a place, as in {Kawlgam suak}, born in Burma; of the sun or a thought, rise or come up; nothing is named that the subject turns into) (s:piang) (r:zd:24536/zd:24978/zd:25170) (q:draft)
suaka = (i:1) (t:v) (f:everyday/family) (w:be born/become) (d:<suak>, be born or come to be, and the linking <a>, written as one word: was born and, became and; the sentence then goes on) (j:suak/a) (r:zd:9256/zd:22807) (q:draft)
suakcil = (i:1) (t:adj) (f:family/health) (w:newborn/just born) (d:<suak>, here be born, with <cil>, at the beginning: just born; {naungek suakcil} is a newborn baby) (r:zd:12014/zd:15984) (q:draft)
suakding = (i:1) (t:v) (f:everyday) (w:will become/will turn into/will come out) (d:<suak>, become or come forth, and <ding>, will, written as one word) (j:suak/ding) (r:zd:11373/zd:24570) (q:draft)
suakding = (i:2) (t:v) (f:everyday) (w:will go on/will continue) (d:<suak>, placed after a verb for an action that carries on or is done for good, and <ding>, will, written as one word: {kinei suakding} is will go on being held, {khakcip suakding} is will be closed for good) (j:suak/ding) (r:zd:17549) (q:draft)
suakhi = (i:1) (t:v) (f:everyday) (w:become/turn into) (d:<suak>, become, and the sentence ending <hi> written as one word: became, has become) (j:suak/hi) (r:zd:23797/zd:23356) (q:draft)
suakhi = (i:2) (t:v) (f:family/everyday) (w:be born) (d:<suak>, be born, and the sentence ending <hi> written as one word: was born) (j:suak/hi) (r:zd:20484/zd:22873) (q:draft)
suakin = (i:3) (t:v) (f:family/everyday) (w:being born) (d:<suak> in its meaning be born, with the linking ending <in>: born, and then; brought out by a place with <ah> or a year before it, as in {khua ah suakin}, born in the village) (r:zd:22544/ts:296/zd:13228) (q:draft)
suakkhiavat = (i:1) (t:v) (f:everyday) (w:come out suddenly/appear suddenly/dart out) (d:<suakkhia>, come out, with <vat>, here suddenly, written as one word: come out or appear all at once and unexpectedly) (j:suakkhia/vat) (r:zd:20076/zd:21030/zd:15890) (q:draft)
suakkhinta = (i:1) (t:v) (f:everyday) (w:have become/have already become) (d:<suak>, become, and <khinta>, already done, written as one word: have now become what is named before it; in one sentence, of a person, was already born) (j:suak/khinta) (r:zd:12470/zd:15679) (q:draft)
suaklai = (i:1) (t:v) (f:everyday) (w:still become/still be) (d:<suak>, become or come out, with the word for still, written as one word: is still becoming, even turns into) (j:suak/lai) (r:zd:24749/zd:17872) (q:draft, low confidence)
suaklo = (i:1) (t:v) (f:everyday) (w:not become/not turn out/not appear) (d:<suak> and <lo> written as one word: not become something; also not come out or not show) (j:suak/lo) (r:zd:17577/zd:19997/zd:12794) (q:draft)
suaklu = (i:1) (t:n) (c:plant) (f:food/nature) (w:gooseberry/Indian gooseberry) (d:a sour fruit and its tree; the dictionary data gives gooseberry, and the thought of it is said to make the mouth water) (r:zd:21922) (q:draft, low confidence)
suakpah = (i:2) (t:adv) (f:everyday) (w:straight away/right then/directly) (d:after another verb, as in {kiman suakpah} and {kipuak suakpah}: the action follows at once and goes right through, with no step between; <suak> in its use after a verb, with <pah>, at once) (r:zd:15943/zd:17999/zd:16676) (q:draft)
suaksak = (i:2) (t:v) (f:media) (w:publish/put out/release/issue) (d:<suak>, come out, with the causative <sak>: make something come out to the public, as news in a paper, a post on social media or a new song; not make become) (r:zd:16438/zd:18198) (q:draft)
suakta takin = (i:1) (t:adv) (f:social/politics) (w:freely/in freedom/at liberty) (d:<suakta>, be free, and <takin>, which makes an adverb: placed before a verb, do it freely, without restraint) (r:zd:23148/zd:22695/zd:21706) (q:draft)
suaktaakna = (i:1) (t:n) (f:politics/social) (j:suaktakna) (r:zd:25569/zd:23488) (q:draft)
suaktading = (i:1) (t:v) (f:politics/everyday) (w:will be released/will be freed) (d:<suakta>, be set free, and <ding> written as one word: will be released, as from prison) (j:suakta/ding) (r:zd:19674/zd:19671) (q:draft)
suaktakna = (i:1) (t:n) (f:politics/social) (w:freedom/liberty/independence) (d:<suaktak>, be free, with the noun suffix <na>: freedom of a person, or the independence of a country) (s:suahtakna) (b:suaktak) (r:ts:3168/zd:22877) (q:draft)
suaktalo = (i:1) (t:v) (f:politics/everyday) (w:not be released/not get free) (d:<suakta>, be set free, and <lo>, not, written as one word: not be released, not get out) (j:suakta/lo) (r:zd:20418) (q:draft)
suaktatak = (i:1) (t:adv) (f:everyday/politics) (w:freely/at liberty) (d:<suakta>, be free, with <tak>, written as one word: freely, without hindrance; often {suaktatak in}) (j:suakta/tak) (r:zd:17383/zd:11712/ts:2189) (q:draft)
suaktathei = (i:1) (t:v) (f:everyday) (w:manage to escape/get away safely/survive) (d:<suakta> and <thei> written as one word: be able to get away, come out of an accident or attack alive or unhurt) (j:suakta/thei) (r:zd:20663/zd:13138) (q:draft)
suakthak = (i:1) (t:adj) (f:everyday/family) (w:newborn/newly arisen/new) (d:<suak>, be born or become, with <thak> new: newly born, as {naungek suakthak}, a newborn baby, or newly come into being) (j:suak/thak) (r:zd:19734/zd:25616) (q:draft)
suakziau = (i:1) (t:v) (f:everyday) (w:become at once/turn into/end up as) (d:<suak>, become, and <ziau> written as one word: come to be something suddenly or simply as a result) (j:suak/ziau) (r:zd:15727/zd:22830) (q:draft)
suakzolo = (i:1) (t:v) (f:everyday) (w:cannot become/fail to become/cannot come out) (d:<suak>, become or come out, with <zolo>, cannot, written as one word: not manage to become something, or of a voice, not come out properly) (j:suak/zolo) (r:zd:18248/zd:15260) (q:draft)
sual = (i:1) (t:n) (f:home) (w:floor) (d:the floor of a house or room; {sual puan} is a rug spread on the floor) (a:innsun) (r:26.41.16) (q:draft)
suallo = (i:1) (t:adv) (f:everyday) (w:without fail/surely/exactly) (d:used as {suallo in}: without missing, unfailingly, just as expected) (r:zd:25390/zd:19239) (q:draft, low confidence)
sualtung = (i:1) (t:n) (f:home) (w:floor/surface of the floor) (d:<sual> and <tung> written as one word; {sualtung ah} is on the floor) (j:sual/tung) (r:zd:18020/zd:12723) (q:draft)
sualtungah = (i:1) (t:adv) (f:home) (w:on the floor/on the ground) (d:<sualtung> and the place marker <ah> written as one word: on the floor, also on the ground or the road surface) (j:sualtung/ah) (r:zd:11698/zd:17143) (q:draft)
suamlup = (i:1) (t:v) (f:politics/media) (w:assassinate/attack and kill/murder) (d:form of <suamlum>, attack and kill, used before words such as <laitak>, <pen> and <khak>; {aki suamlup} is the one who was assassinated, {ki suamlupna} the assassination) (b:suamlum) (r:zd:19324/zd:15498) (q:draft)
suamlupding = (i:1) (t:v) (f:politics/media) (w:will assassinate/to be assassinated) (d:<suamlup>, attack and kill, with <ding>, will, written as one word; {aki suamlupding} is that he or she will be assassinated) (j:suamlup/ding) (r:zd:11378) (q:draft)
suamlupkhit = (i:1) (t:v) (f:politics/media) (w:after being assassinated/have assassinated) (d:<suamlup> and <khit> written as one word: once the attack and killing was done; after <ki> it is passive, after he was assassinated) (j:suamlup/khit) (r:zd:11627) (q:draft)
suamlupna = (i:1) (t:n) (f:politics/media) (w:assassination/murder/killing) (d:<suamlup>, the form of <suamlum>, attack and kill, used before an ending, with the noun suffix <na>: the killing of a person by an attack, an assassination) (b:suamlum) (r:zd:11433/zd:12171) (q:draft)
suamlupsawm = (i:1) (t:v) (f:politics) (w:try to kill/attempt to assassinate) (d:<suamlup>, the form of <suamlum>, attack and kill, used before <sawm>, intend: try to kill; with <ki> before it, be the target of an attempt on one's life, or try to kill oneself) (b:suamlum) (r:zd:20653/zd:11821) (q:draft)
suamna = (i:1) (t:n) (f:politics/social) (w:attack/assault/raid) (d:<suam>, attack, with the noun suffix {-na}: an armed attack on people or a place; a dictionary also gives robbery) (b:suam) (r:zd:10798/zd:10727) (q:draft)
suamsak = (i:1) (t:v) (f:politics) (w:attack/raid/break into) (d:<suam>, attack, with <sak>: make an attack on what belongs to someone, as a post or a computer system) (j:suam/sak) (r:zd:10740) (q:draft, low confidence)
suang = (i:3) (t:n) (f:nature/everyday) (w:stone/rock) (d:a stone or rock, the material and a single piece of it; {suang manpha} is a precious stone, {suang tawh deng} is throw stones at, and {suang tunga kilam} is built on rock) (s:suangtum) (r:zd:21551/zd:11508/zd:15847) (q:draft)
suang = (i:4) (t:v) (f:social) (w:rely on/depend on/trust in) (d:lean on something as one’s strength or support, after the thing relied on; {thatang suang} is relying on force, by force) (r:zd:11714) (q:draft, low confidence)
suangbawl = (i:1) (t:n) (f:work) (w:gem trade/gem trader) (d:<suang>, stone, with <bawl>, make: dealing in gems or jade, said beside <sumbawl>, trade; also a person who does so) (r:zd:14604/zd:22396) (q:draft, low confidence)
Suanghoih = (i:1) (t:name) (c:khua) (f:travel) (w:Suanghoih) (d:a village in the Tonzang area of Chin State) (r:zd:19293) (q:draft)
suanglak = (i:1) (t:n) (f:nature) (w:rocky place/among the rocks) (d:the first part of <suangtum>, stone, with <lak>, among: stony ground, a place among rocks, named together with {kenlak}, among cliffs, and <leilak>, on bare earth) (r:zd:23332/zd:17635) (q:draft)
suangmanpha zuakna = (i:1) (t:n) (f:work/everyday) (w:jewellery shop/jeweller's/goldsmith shop) (d:<suangmanpha>, precious stone, and <zuakna>, place of selling: a shop that sells jewellery and gold) (r:zd:16733/zd:17260) (q:draft)
suangmeihol = (i:1) (t:n) (f:nature/work) (w:coal) (d:mineral coal dug from the ground, literally stone charcoal, <meihol>) (r:zd:21605/zd:10990/zd:23016) (q:draft)
suangsi = (i:1) (t:n) (f:work/nature) (w:gravel/crushed stone) (d:small broken stones used with sand and cement in building and for surfacing roads) (r:zd:17000/zd:22479/zd:18121) (q:draft)
suangtat = (i:1) (t:n) (f:home/work) (w:whetstone/sharpening stone) (d:a stone on which knives and tools are sharpened; in the old saying {suangtat sat ngam}, daring to strike a whetstone, of fearless warriors) (r:ts:4885) (q:draft)
suangtawh = (i:1) (t:phrase) (f:everyday) (w:with stones/with a stone) (d:<suang>, stone, and <tawh>, with, written as one word; {suangtawh deng} is throw stones at, stone) (j:suang/tawh) (r:zd:11936/zd:17517/zd:24224) (q:draft)
Suangthu = (i:1) (t:n) (f:home) (w:hearthstone/trivet stone) (d:one of the three stones set around the fire on which the cooking pot stands; used as a picture of three things that are all needed) (r:zd:24733) (q:draft)
suanna = (i:3) (t:n) (f:everyday/social) (w:step/taking a step) (d:after <kal>, step: {kal khat suanna} is the taking of one step, also of a step forward in progress; a spaced form of <kalsuanna>, not planting or reliance) (r:zd:21343/zd:17634) (q:draft)
Subang = (i:1) (t:name) (c:city) (f:travel) (w:Subang/Subang Jaya) (d:Subang and Subang Jaya, a town in Selangor, Malaysia, near Kuala Lumpur; one sentence names another Subang in West Java, Indonesia) (r:zd:16235/zd:16660) (q:draft)
subject = (i:1) (t:n) (f:education) (w:subject) (d:a branch of study taught at school or university; in letters also the English heading Subject before the matter of the letter) (o:English) (r:zd:20979/zd:11748/zd:23016) (q:draft)
submarine = (i:1) (t:n) (f:politics/travel) (w:submarine) (d:a warship that travels under water, in Zolai also described as {tuinuai teembaw}) (o:English) (r:zd:10988) (q:draft, low confidence)
submit = (i:1) (t:v) (f:work/it) (w:submit/hand in) (d:hand in a form, a plan or an application; used with <ki> as {ki submit}, be submitted) (o:English) (r:zd:24091/zd:16851) (q:draft, low confidence)
Sudan = (i:1) (t:name) (c:land) (f:politics) (w:Sudan) (d:country in north-east Africa; {South Sudan} is its southern neighbour) (r:ts:7140/zd:10855) (q:draft)
Suez = (i:1) (t:name) (c:place) (f:travel/politics) (w:Suez) (d:the Suez Canal in Egypt, and the war of 1956 named after it) (r:zd:25109/zd:11697) (q:draft)
suhkhiat = (i:1) (t:v) (f:politics) (w:seize/take by force/overthrow) (d:<suh>, take by force, with <khiat>, away: take something from its holder by force; {ukna suhkhiat} is seize power, said of a military coup) (r:ts:5339/zd:25063/zd:24966) (q:draft)
suhsak = (i:1) (t:v) (f:social) (w:rob/snatch/seize from) (d:<suh>, take by force, and <sak> written as one word: take from a person by force what belongs to him) (j:suh/sak) (r:zd:16676/zd:15084/zd:9136) (q:draft)
suhsawm = (i:1) (t:v) (f:politics/media) (w:try to rob/attempt to snatch) (d:<suh>, take by force, with <sawm>, intend or try, written as one word: try to rob someone of something) (j:suh/sawm) (r:zd:12072/zd:21588) (q:draft)
sui = (i:3) (t:v) (f:media/everyday) (w:kick/play) (d:kick with the foot, and so play football or a match, unlike the senses of cutting and of stumbling: {bawlung sui} is play football and {match sui} is play a match) (r:zd:20145/zd:17963/zd:16556) (q:draft)
Suicide = (i:1) (t:n) (f:health/social) (w:suicide) (d:the killing of oneself; the English word is set beside the Zolai {amah leh amah kithat} and stands in {Suicide Bomb}) (o:English) (r:zd:10940/zd:11654) (q:draft, low confidence)
suih = (i:3) (t:v) (f:media/everyday) (w:kick/play football) (d:kick with the foot, mostly of a ball: {bawlung suih} or {bawhlung suih} is playing football, and {suih leh bet} is kicks and blows; not carving or stumbling) (r:zd:24119/zd:20486/zd:22967) (q:draft)
suihna = (i:1) (t:n) (f:media) (w:kicking/playing football) (d:the kicking of a ball, almost always in {bawlung suihna}, the playing of football; the noun of <sui> in its sense strike with the foot) (r:zd:16379/zd:23653) (q:draft)
suikhia = (i:1) (t:v) (f:everyday/social) (w:search out/trace/find out) (d:<sui>, here search or trace, with <khia>, out, written as one word: search until something is found or brought to light) (r:zd:23022/zd:17891) (q:draft, low confidence)
suit = (i:1) (t:n) (f:everyday) (w:suit) (d:a set of clothes of jacket and trousers) (o:English) (r:zd:25572/zd:16236) (q:draft)
Suitcase = (i:1) (t:n) (f:travel/home) (w:suitcase) (d:a case with a handle for carrying clothes and goods on a journey) (o:English) (r:zd:15095/zd:15554) (q:draft)
sukham = (i:2) (t:v) (f:politics/media) (w:detonate/set off/explode) (d:after the word <bomb>: make a bomb go off; {bomb ki sukham} is a bomb was set off) (r:zd:19851/zd:12759) (q:draft)
suksia = (i:1) (t:v) (f:everyday) (w:do harm/be badly affected/get worse) (d:harm or be harmed badly, grow worse; {a suksia pen} is the one worst affected; compare <susia>, destroy) (r:zd:24469/zd:24271/zd:19662) (q:draft, low confidence)
suksuk = (i:2) (t:adv) (f:everyday) (w:steadily downward/further and further down/on and on) (d:after a verb, not of generations: going on downward in place or in amount, as in {kiam suksuk} keep decreasing, {kia suksuk} keep falling and {pai suksuk} walk on down) (r:zd:21042/zd:22815/zd:16148) (q:draft)
sukziau = (i:1) (t:adv) (f:everyday) (w:straight off/abruptly/just like that) (d:<suk> and <ziau> written as one word after a verb: the action is done at once and without more ado, often to the surprise of others) (j:suk/ziau) (r:zd:20177/zd:15639) (q:draft, low confidence)
