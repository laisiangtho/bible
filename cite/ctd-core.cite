mechanic = (i:1) (t:n) (f:work/travel) (w:mechanic) (d:a person whose work is repairing cars and machines) (o:English) (r:zd:17483/zd:17450) (q:draft)
Medal = (i:1) (t:n) (f:social) (w:medal) (d:a metal disc given as a prize in a contest or as an honour) (o:English) (r:zd:15352/zd:20557/zd:12336) (q:draft)
Medicaid = (i:1) (t:name) (f:health/politics) (w:Medicaid) (d:the health insurance programme of the United States government for people with low income) (o:English) (r:zd:26208) (q:draft)
mee = (i:1) (t:n) (f:politics) (w:vote/ballot) (d:a vote given in an election or a poll; <mee pia> is cast a vote, {mee ngah} is receive votes) (o:Burmese) (r:zd:23479/zd:24641/zd:24331) (q:draft)
mee pia = (i:1) (t:v) (f:politics) (w:vote/cast a vote) (d:<mee>, a vote, and <pia>, give: vote in an election; the party or person voted for stands before it, and <thei> after it says who is entitled to vote) (r:zd:23479/zd:22652/zd:24641) (q:draft)
meei = (i:1) (t:n) (f:nature) (j:meii) (r:zd:25227/zd:22557) (q:draft)
meekuang = (i:1) (t:n) (f:politics) (w:ballot box/election) (d:the ballot box, from <mee>, vote, a Burmese loan, with <kuang>, box or trough; {meekuang lui} is to contest an election, to stand as a candidate) (r:zd:24325/zd:24494/zd:24630) (q:draft, low confidence)
meel = (i:2) (t:part) (f:everyday) (w:seem/appear) (d:placed after a verb and before <lo>, not: there is no sign of the action, it does not seem to happen, as in {kibang pha meel lo}, do not seem to be quite the same; not the look or face of a person) (r:zd:11891/zd:23272/zd:22023) (q:draft, low confidence)
meello = (i:1) (t:adv) (f:everyday) (w:hardly/scarcely/not really) (d:<meel> and <lo> written as one word and placed after a verb: there is no sign of it, it is hardly so at all; {om meello} is there is hardly any) (j:meel/lo) (r:zd:23780) (q:draft, low confidence)
meeltheih = (i:1) (t:n) (f:social/family) (w:acquaintance/kin) (d:a person one knows by face, an acquaintance; named together with <tanau>, relative, for the people one is connected with) (r:zd:18071/zd:23590/zd:21237) (q:draft)
meetang = (i:1) (t:n) (f:politics) (w:vote/ballot) (d:a single vote cast in an election; <mee>, vote, is a loan from Burmese) (s:mee) (r:zd:24630/zd:22818/zd:24277) (q:draft)
meetbawl = (i:1) (t:v) (f:work) (w:make a profit/invest/profit from) (d:<meet>, profit, and <bawl>, make, written as one word: make money grow, earn a profit on it; also take advantage of something) (j:meet/bawl) (r:zd:20922/zd:25919) (q:draft)
meeting = (i:1) (t:n) (f:social/work) (w:meeting) (d:a coming together of the members or leaders of a body to discuss and decide; {meeting nei} is hold a meeting) (s:kikhopna) (o:English) (r:zd:14579/zd:23156/zd:18196) (q:draft)
meeting kinei = (i:1) (t:v) (f:social/politics) (w:a meeting is held/hold a meeting/meet) (d:<meeting> and <kinei>, here the passive of <nei>, have or hold, and not regard oneself: a meeting is held, the usual wording of headlines and reports; the body or the place stands before it, with <tawh> the other party) (r:zd:10742/zd:18196/zd:24531) (q:draft)
megachurch = (i:1) (t:n) (f:religion) (w:megachurch) (d:a very large church, one with two thousand or more people at worship each week; in Zolai {pawlpi lian}) (o:English) (r:zd:21042) (q:draft, low confidence)
Meghalaya = (i:1) (t:name) (c:land) (f:travel/politics) (w:Meghalaya) (d:state in the north-east of India) (r:ts:301/ts:3506) (q:draft)
mehbawl = (i:1) (t:v) (f:food/home) (w:cook dishes/prepare food) (d:<meh>, the dish eaten with rice, and <bawl>, make, written as one word: prepare the dishes of a meal, often paired with <anhuan>, cook rice) (j:meh/bawl) (r:zd:2072) (q:draft)
mehgah = (i:1) (t:n) (f:food) (w:vegetable/fruit vegetable) (d:a vegetable that is the fruit of a plant, <meh> with <gah>; the pair {mehteh mehgah} is vegetables of all kinds, leaf and fruit) (r:zd:21284/zd:22740/zd:17126) (q:draft)
mehgahte = (i:1) (t:n) (f:food) (w:vegetables/fruit vegetables) (d:<meh>, cooked dish, with <gahte>, fruits: vegetables that are fruits or pods; mostly in the pair {mehteh mehgahte}, leaf and fruit vegetables, vegetables of every kind) (r:zd:19593/zd:22830/zd:23729) (q:draft)
mehhuan = (i:1) (t:n) (f:food) (w:cooking/cooking of a dish) (d:<meh>, a cooked dish, with <huan>, cook: the cooking of a dish to eat with rice, and the dish being cooked; {mehhuan gim} is the smell of cooking) (r:zd:19981/zd:15157) (q:draft)
mehhuan = (i:2) (t:n) (f:food/nature) (w:vegetable garden) (d:<meh>, here vegetables for a dish, with <huan>, garden: a garden where vegetables are grown; {mehhuan bawl} is work a vegetable garden) (r:zd:20120) (q:draft, low confidence)
mehlim = (i:1) (t:n) (f:food) (w:tasty dish/delicacy/good curry) (d:<meh>, the dish eaten with the staple, with <lim>, tasty: a tasty dish; often paired with <anlim> as {anlim mehlim}, good food) (r:zd:24276/zd:19355/zd:20516) (q:draft)
mehte = (i:1) (t:n) (f:food) (w:dishes/side dishes) (d:<meh>, cooked dish, with the plural <te>, written as one word; {an leh mehte} is rice and the dishes eaten with it) (b:meh) (r:zd:24276/zd:26588) (q:draft)
mehteh = (i:1) (t:n) (f:food) (w:vegetable/leaf vegetable/herbs) (d:leaf vegetables eaten as a cooked dish with the staple) (s:anteh) (q:draft)
mehtehmehgah = (i:1) (t:n) (f:food/health) (w:vegetables/greens) (d:vegetables of every kind, <mehteh>, leaf vegetable, with <mehgah>, vegetable that is a fruit or pod) (r:zd:24276/zd:21298) (q:draft)
mehthuk = (i:1) (t:n) (f:food) (w:tomato) (d:<meh>, cooked dish, with <thuk>, sour: the tomato) (r:zd:23896/zd:24276) (q:draft)
mehtui = (i:1) (t:n) (f:food) (w:soup/broth) (d:<meh>, a cooked dish, with <tui>, water: the liquid of a stew, broth) (s:satui) (q:draft)
mei = (i:1) (t:n) (f:home/nature) (w:fire) (d:fire, the flame that burns; also a lamp or light, and the first part of many words such as <meikuang>, flame, and <meikhu>, smoke) (s:meikuang) (r:3.9.11) (q:draft)
meidet = (i:1) (t:n) (f:social/home) (w:torch/torchlight) (d:a burning torch carried for light, from <mei>, fire; {meidet pawi} is the torch festival, a name of the Khuado festival, and the word is also used as a picture, as the torch of revival) (r:zd:16640/zd:21141) (q:draft, low confidence)
meigit = (i:1) (t:n) (f:home/everyday) (w:match/matchstick) (d:a match for lighting fire; {meigit tang khat} is one matchstick) (r:zd:23828/zd:13340) (q:draft)
meigong = (i:1) (t:n) (f:family/social) (w:widow) (d:a woman whose husband has died, also said as {meigong numei}; often named together with {pa nei lote}, the fatherless) (s:meigongnu) (r:42.21.2)
meihal = (i:2) (t:v) (f:everyday/social) (w:set fire to/set on fire/burn) (d:<mei>, fire, with <hal>, burn, used as a verb: set something on fire on purpose; {meihal te} are those who set the fire, and as a charge it is arson) (r:zd:14783/zd:12736/zd:15301) (q:draft)
meihtu = (i:1) (t:n) (f:work/education) (w:copy/photocopy) (d:a copy of a document, such as a card or a certificate, kept or handed in beside the original) (s:copy) (o:Burmese, meit-tu) (r:zd:13194/zd:18939) (q:draft)
meikai = (i:1) (t:n) (f:nature) (w:mist/fog/low cloud) (d:mist or cloud that hangs low and hides the view; {guahzu meikai nuai} is under rain and mist; also said of something too hazy to understand) (r:zd:21991/zd:17733/zd:14824) (q:draft, low confidence)
meikang = (i:3) (t:n) (f:everyday/media) (w:fire/blaze) (d:an outbreak of fire in a building, a vehicle or a forest, as reported in news; {meikang akipan} is the fire started and <gamsung meikang> is a forest fire, not a wound made by fire) (r:zd:12736/zd:18157/zd:15820) (q:draft)
meikanggawp = (i:1) (t:v) (f:media/everyday) (w:burn down/be destroyed by fire/be badly burned) (d:<meikang>, here catch fire and burn, and <gawp>, severely, written as one word: be burned down or badly burned; common in news headlines) (j:meikang/gawp) (r:zd:11148/zd:13316/zd:14692) (q:draft)
meikangpen = (i:1) (t:phrase) (f:media/everyday) (w:the fire) (d:<meikang>, here a fire that burns a building, and the topic marker <pen>, written as one word: the fire, as for the fire) (j:meikang/pen) (r:zd:17917/zd:16739) (q:draft)
meikangtum = (i:1) (t:v) (f:media/home) (w:burn down/be destroyed by fire) (d:<mei>, fire, and <kangtum>, burn up, written as one word: be completely burnt by fire) (j:mei/kangtum) (r:zd:12761/zd:13161/zd:17800) (q:draft)
meikat = (i:2) (t:n) (f:everyday/media) (w:fire/blaze) (d:used as a noun in news reports: a fire that breaks out in a building or vehicle, after <hih> or <tua> and before <kipatna>, the start, or <buaina>, the trouble) (r:zd:13220/zd:13230/zd:16239) (q:draft)
meikatvai = (i:1) (t:n) (f:media) (w:fire incident/case of fire) (d:<meikat>, burn, and <vai>, matter, written as one word: the matter of a fire, a fire as an event in the news) (j:meikat/vai) (r:zd:13222/zd:22162) (q:draft)
meikhau = (i:1) (t:n) (f:home/it) (w:electric wire/power line/cable) (d:a wire or cable that carries electricity, from <mei>, fire or light, and <khau>, cord) (r:zd:15677/zd:17175/zd:13264) (q:draft)
meikhuam = (i:2) (t:n) (f:home/travel) (w:lamp post/electric pole/utility pole) (d:a post by the road that carries a street light or the electric wires, from <mei>, here electric light or power, and <khuam>, post; {lampi meikhuam} is a street lamp post) (r:zd:13320/zd:15920/zd:14662) (q:draft)
meikuang akipan = (i:1) (t:phrase) (f:media) (w:fire broke out/a fire started) (d:<meikuang>, flame, with {a kipan}, it began, written as one word: a fire broke out, the set wording of a news report; the place stands before it with <ah> or <panin>, and <akipan> is here the verb and not the marker from or since) (r:zd:15461/zd:17729) (q:draft)
meikuanggawp = (i:1) (t:v) (f:everyday/media) (w:burst into flames/burn up/be burnt out) (d:<meikuang> and <gawp> written as one word: catch fire and burn fiercely, to the point of ruin; said of vehicles and houses) (j:meikuang/gawp) (r:zd:19157/zd:18911/zd:13324) (q:draft)
meikuangpen = (i:1) (t:n) (f:everyday/nature) (w:the fire/the blaze) (d:<meikuang>, fire, and the topic marker <pen> written as one word: the fire, as the thing spoken about) (j:meikuang/pen) (r:zd:20369/zd:11606/zd:15410) (q:draft)
meikuangsa = (i:1) (t:adj) (f:everyday) (w:burning/alight/on fire) (d:<meikuang>, flame, with the ending {-sa}, already: already set alight, burning) (r:zd:15029) (q:draft)
meileeng = (i:1) (t:n) (f:travel) (w:train/railway train) (d:<mei>, fire, with <leeng>: a railway train; {meileeng lampi} is a railway) (r:zd:10952/zd:18147/zd:23653) (q:draft)
