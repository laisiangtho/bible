overstaying = (i:1) (t:v) (f:travel/politics) (w:overstay) (d:stay in a country after the visa or permit has run out; used in reports on immigration arrests in Malaysia) (o:English) (r:zd:15165) (q:draft, low confidence)
overtime = (i:1) (t:n) (f:work) (w:overtime) (d:work done beyond the regular hours, and the pay for it) (o:English) (r:zd:17060/zd:13291) (q:draft)
Owensboro = (i:1) (t:name) (c:city) (f:travel) (w:Owensboro) (d:a city in the state of Kentucky in the United States, where Zomi live) (r:zd:12119) (q:draft)
Oxford = (i:1) (t:name) (c:city) (f:education) (w:Oxford) (d:city in England, named mostly for its university) (o:English) (r:zd:23329/zd:21288) (q:draft)
oxygen = (i:1) (t:n) (f:health/nature) (w:oxygen) (d:the gas in the air that living things need to breathe, also given to the sick from a cylinder, <oxygen bung>) (o:English) (r:zd:25184/zd:25134/zd:22584) (q:draft)
oxygen bung = (i:1) (t:n) (f:health) (w:oxygen cylinder/oxygen tank) (d:<oxygen> with <bung>, here a container or tank: a cylinder of oxygen for the sick to breathe from, counted with a numeral after it) (r:zd:25184/zd:18186) (q:draft)
ozone = (i:1) (t:n) (f:nature) (w:ozone) (d:the gas that forms a layer high in the air and keeps off harmful rays of the sun; {Ozone Dalpi} is the ozone layer) (o:English) (r:zd:13057/zd:24119) (q:draft)
pa = (i:1) (t:n) (f:family) (w:father) (d:male parent; with a possessive, as in {ka pa}, my father, and {a pa}, his father) (a:nu)
pa = (i:5) (t:n) (f:social) (w:Mr/Mister) (d:title of respect written with a capital before the name of a grown man, as {Pa Khai Khai}; not his father and not the masculine marker after a noun) (a:nu) (r:ts:3737/zd:23993) (q:draft)
paa = (i:1) (t:v) (f:everyday) (w:be included/have with) (d:be included or be taken along, mostly with <lo>: {paa lo} is without, not included; the same spelling is also written for <pa>, father) (o:Burmese, pa) (r:zd:15501/zd:18081) (q:draft, low confidence)
paai = (i:1) (t:v) (f:everyday) (w:throw/cast/throw away) (d:throw, cast or throw away) (s:lawn/paii/lot) (r:43.10.11) (q:draft)
paai = (i:4) (t:n) (f:everyday/work) (w:money/wealth/funds) (d:only in the pair {sum leh paai} or {sum le paai}, money and means, where it stands beside <sum> and adds no separate meaning: funds, finances; not a sheath and not the verb throw) (r:zd:22479/zd:24313/zd:22019) (q:draft)
paaibawlna = (i:1) (t:n) (f:work) (w:business/money-making) (d:used in the pair {sumbawl paaibawlna}, trade and business, the earning of a living by buying and selling) (r:zd:16844/zd:24496) (q:draft, low confidence)
paaizonna = (i:1) (t:n) (f:work) (w:livelihood/earning a living/economy) (d:<paai>, here wealth, as in {sum le paai}, money and wealth, with <zonna>, seeking: found only as the second half of the pair {sumzon paaizonna}, the earning of money and a living, economic life) (b:zonna) (r:zd:10902/zd:21001/zd:17021) (q:draft)
paak = (i:3) (t:v) (f:nature) (w:bloom/flower) (d:of a plant, come into flower; the verb beside the noun {paak}, flower) (s:pak) (r:zd:21822) (q:draft, low confidence)
paakhuan = (i:1) (t:n) (f:nature/home/travel) (w:flower garden/park/garden) (d:<paak>, flower, and <huan>, garden, written as one word: a flower garden, also a public park) (j:paak/huan) (r:zd:24649/zd:16777/zd:22680) (q:draft)
paakkual = (i:1) (t:n) (f:social) (w:wreath/garland) (d:<paak>, flower, with <kual>, ring: a wreath or garland of flowers, sent to a funeral as a sign of sympathy or given to honour someone) (r:zd:10908/zd:24183) (q:draft)
paakpalh = (i:1) (t:n) (f:nature) (j:pakpalh) (r:zd:23823/zd:19681) (q:draft)
paakta = (i:1) (t:v) (f:social) (j:pakta) (r:zd:21279/zd:17858) (q:draft)
Paakzang = (i:1) (t:name) (c:khua) (f:travel/social) (w:Paakzang) (d:Zomi village in the Tedim area; written in brackets after a personal name it shows the home village of the person) (r:ts:301) (q:draft, low confidence)
paal = (i:1) (t:v) (f:nature/social) (w:bloom/blossom/flourish) (d:come into flower, and of a person, a people or a land be in the bloom of life, flourish; a word of songs and elevated speech, and also a personal name) (r:zd:23896/zd:21690/zd:23531) (q:draft, low confidence)
paallun = (i:1) (t:v) (f:social/nature) (w:flourish/prosper/bloom) (d:be in full bloom; said of a land or people that thrives and prospers, as in {Zogam hong paallun ding hi}) (r:zd:23554/zd:22464/zd:11571) (q:draft)
paalo = (i:1) (t:prep) (f:everyday) (w:without/not included) (d:<paa>, be included, with <lo>, not, written as one word after the thing that is missing: without it) (j:paa/lo) (o:Burmese, pa) (r:zd:15501) (q:draft)
paamte = (i:1) (t:n) (f:social) (w:neighbours/those around) (d:<paam> and the plural <te> written as one word, used in the pair {a veng a paamte}: the neighbours, the people living around) (j:paam/te) (r:zd:21850/zd:21862) (q:draft)
Pabedan = (i:1) (t:name) (c:place) (f:travel) (w:Pabedan) (d:a township in the centre of Yangon) (r:zd:22686/zd:21410) (q:draft)
Pacific = (i:1) (t:name) (c:place) (f:nature/travel) (w:Pacific) (d:the Pacific Ocean, mostly as {Pacific tuipi}, and the region around it) (r:zd:16828/zd:19262) (q:draft)
packet = (i:1) (t:n) (f:everyday/work) (w:packet/pack) (d:a small package of goods, counted with a number placed after it) (o:English) (r:zd:15475/zd:18876) (q:draft, low confidence)
padenpauh = (i:1) (t:n) (f:home) (w:window) (d:Burmese word for a window, written beside <tawlet> in the articles) (s:tawlet) (o:Burmese) (r:zd:17495) (q:draft)
Page = (i:1) (t:n) (f:it/media) (w:page) (d:a page of a person or group on Facebook or other social media, where news and notices are posted) (o:English) (r:ts:9299/zd:22688) (q:draft)
Pagoda = (i:1) (t:n) (f:religion) (w:pagoda) (d:a Buddhist shrine or temple tower) (o:English) (r:zd:24469/zd:16101) (q:draft)
Pagu = (i:1) (t:name) (f:travel) (j:Bago) (r:zd:14790) (q:draft)
pah vingveng = (i:1) (t:adv) (f:everyday) (w:straight away/at once/without delay) (d:<pah>, immediately, strengthened by <vingveng>, hurriedly: placed after a verb, mostly a verb of going, to say that it is done at once and in haste) (r:zd:20935/zd:25625/zd:24594) (q:draft)
Pahang = (i:1) (t:name) (c:land) (f:travel) (w:Pahang) (d:a state of Malaysia; also in Jalan Pahang, a street of Kuala Lumpur named in addresses) (r:zd:17777/zd:14628) (q:draft)
pahding = (i:1) (t:part) (f:everyday) (w:at once/right away) (d:<pah> and <ding> written as one word after a verb: will or should do it at once, or it will follow as a matter of course) (j:pah/ding) (r:zd:10960/zd:19676/zd:14523) (q:draft)
pahhi = (i:1) (t:adv) (f:everyday) (w:at once/immediately/right away) (d:<pah> and the sentence-final <hi> written as one word after a verb: it was done at once, and so it followed) (j:pah/hi) (r:zd:11140/zd:16259/zd:21340) (q:draft)
pahlel = (i:1) (t:adv) (f:everyday) (w:readily/simply) (d:<pah>, at once, with <lel>, merely, written as one word after a verb: the thing follows readily, simply as a matter of course) (j:pah/lel) (r:zd:20176/zd:24276) (q:draft, low confidence)
pahlian = (i:1) (t:adv) (f:everyday) (w:right away/readily/straight away) (d:<pah>, at once, with the emphatic <lian>, placed after a verb: the action follows at once or readily) (r:zd:12370/zd:23733) (q:draft, low confidence)
pahlo = (i:1) (t:adv) (f:everyday) (w:not at once/not necessarily) (d:<pah>, at once, with <lo>, not, written as one word after a verb: it does not happen right away, it does not follow as a matter of course) (j:pah/lo) (r:zd:20926/zd:25078/zd:8668) (q:draft)
pahloh = (i:1) (t:adv) (f:everyday) (w:not at once/not right away) (d:<pah>, at once, and the negative <loh> written as one word; after a verb: not doing it straight away) (j:pah/loh) (r:zd:24244/zd:25928) (q:draft, low confidence)
pahna = (i:1) (t:n) (f:everyday) (d:<pah>, at once, with the noun ending {-na}, written after a verb: the doing of the action at once or as a direct consequence, as in {kipat pahna}, the immediate start, and {suah pahna}, becoming straight away) (b:pah) (r:ts:9570/zd:22238) (q:draft)
pahpahding = (i:1) (t:part) (f:everyday) (w:at once/right away/readily) (d:<pahpah>, at once, and <ding> written as one word after a verb: will or should do it immediately or each time without delay) (j:pahpah/ding) (r:zd:12072/zd:12115) (q:draft)
pahpahna = (i:1) (t:n) (f:everyday) (d:<pahpah>, readily or again and again, with the noun ending {-na}, placed after a verb: the doing of it often or too readily; {heh pahpahna} is being quick to anger) (b:pahpah) (r:zd:22778/zd:22923) (q:draft)
pahpahthei = (i:1) (t:adv) (f:everyday) (w:readily/easily/be apt to) (d:<pahpah>, readily, and <thei>, able, written as one word after a verb: can easily do or become so, tends to) (j:pahpah/thei) (r:zd:18099/zd:15822) (q:draft)
pahphot = (i:1) (t:adv) (f:everyday) (w:first of all/to begin with/at the outset) (d:<pah>, at once, and <phot>, first, written as one word: before anything else, as the first thing) (j:pah/phot) (r:zd:16994/zd:11394) (q:draft, low confidence)
pahpih = (i:1) (t:v) (f:social) (w:support/encourage/back) (d:stand behind someone with approval and encouragement, cheer on) (r:zd:14751/zd:25560/zd:21050) (q:draft)
pahtah = (i:1) (t:v) (f:family/education) (j:pattah) (r:zd:21013/zd:21886) (q:draft)
pahuh = (i:1) (t:adv) (f:everyday) (w:immediately/at once/right away) (d:<pah> and <uh> written as one word, placed after a verb: they do it at once) (j:pah/uh) (r:zd:11459/zd:14678) (q:draft)
pai = (i:2) (t:v) (f:everyday/travel) (w:go) (d:move from one place to another, go or walk to a place)
pai = (i:1) (t:v) (f:everyday/travel) (w:come) (d:move toward the speaker or the place spoken of, usually with <hong> before it: {hong pai}, come here)
paibawlna = (i:1) (t:n) (f:work) (w:trade/business dealings) (d:found in the pair {sumbawl paibawlna}, trade and commerce, where it echoes <sumbawl>: buying, selling and doing business) (r:zd:25228/ts:3372) (q:draft, low confidence)
paiciang = (i:1) (t:phrase) (f:everyday/health) (w:when it goes/when it comes) (d:<pai>, go, and <ciang>, when, written as one word: when it goes or passes; seen only in one headline, of a woman's monthly period) (j:pai/ciang) (r:zd:11965) (q:draft, low confidence)
paidan = (i:1) (t:n) (f:everyday/social) (w:way of going/course/procedure/manner) (d:<pai>, go, with <dan>, way: how something goes or proceeds, as the course of events, the working of an office or a way of thinking; of a person or animal also the gait) (r:zd:23830/zd:20418/zd:17655) (q:draft)
paiden = (i:1) (t:v) (f:everyday/travel) (w:go regularly/keep going/keep coming) (d:<pai> and <den> written as one word: go or come all the time, as a habit or without stopping) (j:pai/den) (r:zd:21904/zd:10743/zd:24248) (q:draft)
paidiakna = (i:1) (t:n) (f:social/travel) (w:favourite haunt/place most visited) (d:<pai>, go, <diak>, especially, and the noun suffix <na> written as one word: the place where a group of people mostly goes) (j:pai/diak/na) (r:zd:10892) (q:draft, low confidence)
paiding = (i:1) (t:v) (f:travel/everyday) (w:will go/be going to go) (d:<pai> and <ding> written as one word: will go, about to go; also going, the act of going to a place) (j:pai/ding) (r:zd:25318/zd:25046/zd:19518) (q:draft)
paidingin = (i:1) (t:phrase) (f:travel) (w:in order to go/to go) (d:<pai>, go, and <dingin>, in order to, written as one word: so as to go to the place or event named before it) (j:pai/dingin) (r:zd:10881/zd:16757) (q:draft)
paih = (i:2) (t:v) (f:social/religion) (w:send/give/wish) (d:after <thupha>, blessing: send or pronounce a blessing or good wishes on someone, as in {thupha kong paih hi}, I send you my blessing, at the end of a greeting or message) (r:zd:22815/zd:23481/zd:21070) (q:draft)
paihna = (i:2) (t:n) (f:social/media) (w:sending/conveying) (d:the sending of good wishes to someone, not a throwing away: after <thupha>, blessing, {thupha paihna} is a message of greeting or congratulation) (r:zd:24807/zd:21811) (q:draft, low confidence)
paihte = (i:1) (t:n) (f:everyday/home) (w:those who throw away/things thrown away) (d:<paih>, throw away, with the plural ending <te>: the people who throw something away, or the things thrown away; written with a capital, {Paihte} is another spelling of the name of the Paite people of Manipur and their speech) (b:paih) (r:zd:22875/zd:17387) (q:draft)
paii = (i:3) (t:n) (f:work/everyday) (w:goods/property/wealth) (d:the second word of the pair {sum le paii} or {sum leh paii}, money and goods, which stands for money, funds and wealth as a whole; not used alone in this meaning) (s:sumlepai) (r:zd:25156/zd:20798/ts:1498) (q:draft)
paiin = (i:1) (t:v) (f:everyday/travel) (w:going/go and) (d:<pai>, go, and the linking <in> written as one word: going, having gone, he went and) (j:pai/in) (r:zd:15384/zd:22784) (q:draft)
paikawikawi = (i:1) (t:v) (f:travel) (w:go about/go around/go from place to place) (d:<pai>, go, and <kawikawi>, about, written as one word: go here and there, from one place to another) (j:pai/kawikawi) (r:zd:12827/zd:14716) (q:draft)
paikhialhna = (i:1) (t:n) (f:social/religion) (w:going astray/error/wrong course) (d:noun of <paikhial>, go astray: a wrong course taken by a person, a party or a church) (b:paikhial) (r:zd:20410/zd:11798) (q:draft)
paikhiapah = (i:1) (t:v) (f:everyday/travel) (w:go out at once/leave immediately) (d:<paikhia>, go out, and <pah>, at once, written as one word) (j:paikhia/pah) (r:zd:18289/zd:17645) (q:draft)
paikik = (i:1) (t:v) (f:everyday/travel) (w:return/go back/come back) (d:<pai>, go or come, with <kik>, back or again: go back or come back to where one was; {hong paikik} is come back) (s:ciahkik/kilehkik) (b:pai) (q:draft)
paikul = (i:1) (t:v) (f:travel/everyday) (w:must go/have to go) (d:<pai>, go, and <kul>, must, written as one word: it is necessary to go) (j:pai/kul) (r:zd:14927/zd:11775/zd:16216) (q:draft)
pailai = (i:2) (t:v) (f:travel/everyday) (w:be on the way/be moving) (d:<pai> go with <lai>, while: in the middle of going or coming, said of a person on the way or a vehicle in motion, often {pailai tak in}; not about something still to come) (r:zd:12287/zd:21876) (q:draft, low confidence)
paileh = (i:1) (t:v) (f:everyday/travel) (w:if one goes/when one went) (d:<pai>, go, and <leh>, if or when, written as one word) (j:pai/leh) (r:zd:20932/zd:16900) (q:draft)
pailo = (i:1) (t:v) (f:everyday/travel) (w:not go/not come) (d:<pai> and <lo> written as one word: does not go, did not come) (j:pai/lo) (r:zd:23935/ts:2731/zd:22877) (q:draft)
pailoh = (i:1) (t:v) (f:travel/everyday) (w:not go/not come) (d:<pai>, go, with the negative <loh>, written as one word: not going or not coming, the form used before words such as <nading>, <ding> and <hang>) (j:pai/loh) (r:zd:9429/zd:15583) (q:draft)
paima = (i:1) (t:phrase) (f:travel/everyday) (w:before going) (d:<pai> and <ma> written as one word: before going, as in {na paima in}, before you go) (j:pai/ma) (r:zd:19520/zd:11908) (q:draft)
painading = (i:1) (t:phrase) (f:travel/everyday) (w:for going/for walking/in order to go) (d:<pai>, go, and <nading>, for, written as one word: for going or travelling, meant for something to go on) (j:pai/nading) (r:zd:17560/zd:11666) (q:draft)
paipi = (i:1) (t:n) (f:education/social) (w:principle/main theme/essence/doctrine) (d:the main line or central point of a matter, teaching or aim; {a thu paipi} is the gist of it) (r:zd:25461/zd:24320/zd:16748) (q:draft)
paipih = (i:2) (t:v) (f:everyday/travel) (w:brought/bring/take/lead) (d:go taking a person or thing along: {hong paipih} is bring here, and {paipih} with a place is take or lead there) (b:pai) (r:1.2.22)
paipihding = (i:1) (t:v) (f:everyday/travel) (w:will take/to take along/to bring) (d:<paipih>, go taking someone along, and <ding>, will or to, written as one word) (j:paipih/ding) (r:zd:15067/zd:16998) (q:draft)
paipihpah = (i:1) (t:v) (f:travel/health) (w:take at once/rush to) (d:<paipih>, take along, with <pah>, at once: take someone somewhere immediately, mostly to a hospital) (j:paipih/pah) (r:zd:17694/zd:21793/zd:24276) (q:draft)
paipihsuak = (i:1) (t:v) (f:travel) (w:take straight to/take on to) (d:<paipih> and <suak> written as one word: take a person straight on to a place, such as a hospital or a police station) (j:paipih/suak) (r:zd:16332/zd:14776) (q:draft)
paisa = (i:1) (t:adj) (f:time/everyday) (w:past/gone/departed) (d:<pai>, go, with <sa> marking a finished act: that has gone or come already; {hun paisa} is time past, {kum 20 a paisa} is twenty years ago, and {a paisa} of persons is those who have passed away) (b:pai) (r:zd:24939/zd:24029/zd:12280) (q:draft)
paisakding = (i:1) (t:v) (f:everyday/travel) (w:will send/will let go) (d:<paisak>, make go, and <ding> written as one word: will send or will make go; {ki paisakding} is will be sent) (j:paisak/ding) (r:zd:19719/zd:17632) (q:draft)
paisaklo = (i:1) (t:v) (f:everyday/travel) (w:not let go/not allow to go/not let pass) (d:<paisak>, let go, and <lo>, not, written as one word: not allow someone to go to a place or to pass) (j:paisak/lo) (r:zd:17250/zd:22864/zd:17860) (q:draft)
paisakpah = (i:1) (t:v) (f:everyday/work) (w:send at once/dispatch immediately) (d:<paisak>, send, and <pah>, at once, written as one word: send people or vehicles to a place without delay; with <ki>, be sent at once) (j:paisak/pah) (r:zd:13098/zd:16137) (q:draft)
paisuak = (i:3) (t:v) (f:travel) (w:go straight on/go directly/go through) (d:<pai>, go, with <suak>: as the main verb after a place, go straight on to it without stopping or turning aside on the way; the other senses stand after another verb) (r:zd:16745/zd:22479/zd:17152) (q:draft)
paite = (i:2) (t:n) (f:work) (w:money/means/wealth) (d:the second half of the pair {sum leh paite}, money and means, with the plural {-te}; it follows <sum> and has nothing to do with <pai>, go) (r:zd:17685/zd:22941) (q:draft)
paitheilo = (i:1) (t:v) (f:travel/everyday) (w:cannot go/be unable to go) (d:<pai>, go, and <theilo>, unable, written as one word: be unable to go, move or walk) (j:pai/theilo) (r:zd:20399/zd:14521) (q:draft)
paito = (i:2) (t:v) (f:time) (w:go on/pass/advance) (d:of time, after {hun hong}: go on, move forward; here <to> means onward and not upward to a higher place) (r:ts:11162/zd:19332) (q:draft)
paitoto = (i:1) (t:v) (f:everyday/time) (w:go on/continue/keep going) (d:<pai>, go, and <toto>, onward, written as one word: keep going on, continue; of time, pass on) (j:pai/toto) (r:zd:24965/zd:25221/zd:23389) (q:draft)
paizai = (i:1) (t:n) (f:social/work) (j:paizia) (r:zd:20264/zd:10732) (q:draft, low confidence)
paiziau = (i:1) (t:v) (f:everyday/travel) (w:just go/go straight/go off) (d:<pai>, go, and <ziau>, swiftly and lightly, written as one word: simply go, go straight on or straight there) (j:pai/ziau) (r:zd:12630/zd:17876) (q:draft)
paiziau = (i:2) (t:v) (f:everyday) (w:throw away/dump/abandon) (d:<pai>, here throw away, with <ziau>, in one light movement, written as one word: cast off or leave something or someone in a place) (j:pai/ziau) (r:zd:12733) (q:draft, low confidence)
pak leng = (i:1) (t:part) (f:everyday) (w:let us briefly) (d:<pak>, here for a moment, and <leng>, if we or let us: placed after a verb, let us do it briefly; a writer uses it to introduce the next point) (r:zd:23079/zd:25177) (q:draft)
