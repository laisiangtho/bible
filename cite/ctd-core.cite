sialkhau = (i:1) (t:n) (f:social/home) (w:tether rope/rope) (d:a strong rope, by origin the rope with which a mithun is tied or led; {sialkhau kisuh} is tug of war, and {mittaw sialkhau let}, a blind man holding the rope, is a saying for following blindly) (r:zd:24932/zd:24955) (q:draft)
siallum = (i:1) (t:n) (f:politics) (w:shield) (d:word of songs for a shield, with <lum>, shield; also part of the place name {Siallum}) (r:ts:301) (q:draft, low confidence)
sialna = (i:1) (t:n) (f:travel/work) (w:clearing/preparing/laying out) (d:<sial>, clear or make ready, with the noun suffix {-na}: {lampi sialna} is the making of a road, and also the laying out of a plan) (b:sial) (r:zd:10912) (q:draft, low confidence)
sialpi = (i:1) (t:n) (c:animal) (f:nature/social) (w:mithun/mithun cow) (d:a full-grown mithun, the large cattle of the Chin hills, strictly the cow; given as a gift, paid as a fine and killed at feasts, and a figure of what is big) (r:zd:24574/zd:25734/ts:3168) (q:draft)
Sialsawm = (i:1) (t:name) (f:social) (w:Sialsawm) (d:a traditional festival of the <Zomi>, {Sialsawm pawi}, kept with feasting and named together with <Khuado>; also called {Lawm anneek}) (r:ts:479/zd:26708/zd:23129) (q:draft)
sialsawm pawi = (i:1) (t:n) (f:social) (w:Sialsawm festival) (d:<Sialsawm> with <pawi>, festival: the traditional Sialsawm festival of the <Zomi>, named together with {Khuado pawi}) (r:zd:23129/ts:3375) (q:draft)
Sialtaang = (i:1) (t:name) (c:place) (f:nature/travel) (w:Sialtaang/Sialtang) (d:a place with a spring that supplies water to Tedim town; also written <Sialtang>) (r:zd:19086/zd:25390) (q:draft, low confidence)
sialtal = (i:1) (t:n) (f:nature) (w:bull mithun/male mithun) (d:the male of the mithun, the large cattle kept by the Zomi and killed at feasts; named together with <bawngtal>, bull, and <keeltal>, he-goat) (r:zd:14824/ts:301) (q:draft)
Sialtang = (i:1) (t:name) (c:place) (f:nature/home) (w:Sialtang) (d:the water source from which water is piped to Tedim town; {Sialtang tui} is the water that comes from it) (r:zd:16862/zd:17215) (q:draft, low confidence)
sialte = (i:1) (t:n) (c:animal) (f:nature/social) (w:mithuns/gayals) (d:<sial>, here the name of the mithun or gayal, with the plural <te>: the large half-tame cattle of the hills, prized in Zomi custom and festivals) (r:zd:25114/zd:19226) (q:draft)
sialte = (i:2) (t:n) (f:social/religion) (w:those who prepare/pioneers) (d:<sial>, prepare or clear a way, with the plural <te>: those who cleared the way for others; {lampi a sialte} are the ones who opened the road) (b:sial) (r:zd:9435) (q:draft, low confidence)
sialua = (i:1) (t:adj) (f:everyday) (w:too bad/very bad) (d:<sia>, bad, and <lua>, too much, written as one word: very bad, of weather, roads, conduct or a damaged body) (j:sia/lua) (r:zd:17554/zd:15695/zd:10863) (q:draft)
sialvom = (i:1) (t:n) (f:nature/social) (w:black mithun) (d:a black mithun, <sial>, here the mithun, with <vom>, black; the saying {sialvom leh sialvom kingai} means that those who are alike keep together, birds of a feather flock together) (r:zd:25919/zd:26565) (q:draft)
siama = (i:1) (t:n) (f:education) (j:siamah) (r:zd:20496) (q:draft)
siamah = (i:1) (t:n) (f:education) (w:female teacher/woman teacher) (d:a woman who teaches, in a school or a Sunday school; also a title before her name; the man is <siapa>) (a:siapa) (o:Burmese, sayama) (r:zd:23678/zd:22928) (q:draft)
siamah = (i:2) (t:n) (f:health) (w:nurse) (d:a woman nurse, often with <zato> or <Nurse> before it and paired with <siavuan>, doctor) (o:Burmese, sayama) (r:zd:11924/zd:23773) (q:draft)
siamahnu = (i:1) (t:n) (f:education/religion) (w:woman teacher/lady teacher) (d:a woman who teaches, in school or in the church, from Burmese sayama with <nu>, woman; also a title of respect for her) (o:Burmese, sayama) (r:zd:15107/zd:23773) (q:draft)
siamahte = (i:1) (t:n) (f:health/education) (w:nurses/women teachers) (d:plural of <siamah>, a woman who is a nurse or a teacher; {siavuan siamahte} is doctors and nurses) (b:siamah) (r:zd:19223/zd:23822) (q:draft)
siamate = (i:1) (t:n) (f:health/work) (w:nurses) (d:<siama>, nurse, with the plural <te>, named beside <siavuan>, doctor) (b:siama) (o:Burmese, sayama) (r:zd:22803/zd:26411) (q:draft)
siamding = (i:1) (t:v) (f:everyday/education) (w:be skilled/know how to) (d:<siam>, skilled, and <ding> written as one word after a verb: to be good at it, should know how to do it; {kidop siamding} is to know how to be careful) (j:siam/ding) (r:zd:15547/zd:15354/zd:19897) (q:draft)
siamleh = (i:1) (t:phrase) (f:everyday) (w:if skilled/if one knows how) (d:<siam>, be skilled, and <leh>, if, written as one word after a verb: if one does it well, if one knows how to; in {siamleh siamlo} the same spelling is <siam> with <leh>, and: skilled and unskilled) (j:siam/leh) (r:zd:24036/zd:21085/zd:22140) (q:draft)
siamleng = (i:1) (t:v) (f:everyday) (w:if one knows how/if done well) (d:<siam> and <leng> written as one word, after a verb: if we know how to do it, if it is done with skill) (j:siam/leng) (r:zd:20058/zd:22751) (q:draft)
siamlo = (i:1) (t:adj) (f:everyday/work) (w:unskilled/not good at/inexpert) (d:<siam>, skilled, and <lo>, not, written as one word and placed after the skill or action named) (j:siam/lo) (r:zd:21866/zd:18048/zd:21829) (q:draft)
siamloh = (i:1) (t:v) (f:everyday/education) (w:not be skilled/be unable/lack skill) (d:<siam>, skilled, with <loh>, the form of not used before <manin>, <hangin> and <ciang>: not being good at something, lack of skill) (j:siam/loh) (r:zd:18048/zd:20516/zd:19166) (q:draft)
siamlohna = (i:1) (t:n) (f:everyday/work) (w:lack of skill/inability/incompetence) (d:<siam>, skilled, and <lohna>, the state of not being, written as one word: not knowing how to do something well) (j:siam/lohna) (r:zd:22849/zd:25461) (q:draft)
siamlote = (i:1) (t:n) (f:everyday/work) (w:the unskilled/those who are not good at) (d:<siamlo>, unskilled, with the plural <te> written as one word, usually after <a>: those who are not skilled or cannot do the thing named) (j:siamlo/te) (r:zd:21224/zd:23590) (q:draft)
siammahmah = (i:1) (t:adj) (f:everyday/work) (w:very skilled/very good at/expert) (d:<siam>, skilled, and <mahmah>, very, written as one word) (j:siam/mahmah) (r:zd:11929/zd:23977) (q:draft)
siampen = (i:1) (t:adj) (f:everyday) (w:most skilled/best) (d:<siam>, skilled, with <pen>, most, written as one word after the skill named: the most skilled, the best at it; {la makaih siampen} is the best song leader) (j:siam/pen) (r:zd:9247/zd:21156/zd:9260) (q:draft)
siampite = (i:2) (t:n) (f:religion) (w:priests/clergy) (d:<siampi>, priest, with the plural <te>: those who serve at the altar for the people, in the articles the priests of Israel and also Catholic priests, {RC siampite}; not prophets) (r:zd:23022/zd:25475/zd:12333) (q:draft)
siampiza = (i:1) (t:n) (f:religion) (w:ordination/office of minister) (d:<siampi>, priest or minister, with <za>, rank: the office of an ordained minister; {siampiza pia} is ordain) (s:ordination) (j:siampi/za) (r:zd:23138) (q:draft)
siampu = (i:1) (t:n) (f:religion/social) (w:priest/village priest) (d:the priest of the traditional religion, who makes the offerings for a village or household; compare <siampi>) (r:zd:10730/zd:21853) (q:draft)
siampu = (i:2) (t:n) (f:work/health) (w:specialist/expert/practitioner) (d:a person skilled in a profession; {zato siampu} is a physician) (r:zd:17383) (q:draft, low confidence)
siamsak = (i:1) (t:v) (f:education/everyday) (w:make skilled/enable/train) (d:<siam>, skilled, with the causative <sak>, written as one word: make someone good at something) (j:siam/sak) (r:zd:19139/zd:11135/zd:21866) (q:draft)
Siamsin = (i:1) (t:n) (f:education) (w:student/learner) (d:a student, especially of a college or university; {Zomi Siamsin Kipawlna} is the Zomi students association; often written with a capital letter) (r:zd:20971/zd:24068) (q:draft)
Siamsin Kipawlna = (i:1) (t:n) (f:education/social) (w:student union/students' association) (d:{siamsin}, student, and <kipawlna>, association: an organisation of students, as in the name {Zomi Siamsin Kipawlna}, Zomi Students' Association, followed by a university or town) (r:zd:19273) (q:draft)
siamsinna = (i:1) (t:n) (f:education) (w:education/study/schooling/training) (d:{siamsin}, study or a student, with the noun suffix {-na}: the pursuit of learning, education; {siamsinna lam} is the field of education) (r:zd:25628/zd:10973/ts:10291) (q:draft)
Siamsinte = (i:1) (t:n) (f:education) (w:students/university students) (d:plural of {siamsin}, a student in higher education; {Zomi Siamsinte} are the Zomi students and their association) (r:zd:25039/zd:20102) (q:draft)
siamtawp = (i:1) (t:n) (f:everyday/work) (w:best of one's ability/utmost skill) (d:<siam> and <tawp> written as one word: the limit of what one can do; {ka siamtawp} is as well as I can) (j:siam/tawp) (r:zd:24594/zd:21108/zd:24733) (q:draft)
siamthei = (i:1) (t:adj) (f:everyday/education) (w:skilled/good at/capable) (d:<siam>, skilled, with <thei>, able, written as one word after the skill named: good at it, able to do it well) (j:siam/thei) (r:zd:10973/zd:18134/zd:11409) (q:draft)
siang = (i:1) (t:adj) (f:everyday/home) (w:clean/pure) (d:clean, free from dirt; the opposite of <nin>, dirty) (s:siangtho) (a:nin/nit) (q:draft)
sianggen = (i:1) (t:v) (f:everyday/social) (w:speak plainly/say frankly/be frank) (d:<siang>, clean, with <gen>, say: say a thing openly and plainly, hiding nothing; {sianggen leng} is to speak frankly) (r:zd:22459/zd:22595) (q:draft)
sianglo = (i:1) (t:adj) (f:everyday/home) (w:unclean/not clean/unclear) (d:<siang>, clean, and <lo>, not, written as one word: not clean, dirty; of speech or sound, not clear) (a:siang) (j:siang/lo) (r:zd:16951/zd:23388) (q:draft)
siangsak = (i:2) (t:v) (f:social/work) (w:settle/clear up/resolve) (d:bring a matter to a clean end: settle a quarrel, an account or business so that nothing is left open, with objects such as <buaina>, <sazian> and <vai>) (r:zd:25177/zd:14760/zd:10957) (q:draft)
Siangsawn = (i:1) (t:name) (c:khua) (f:travel) (w:Siangsawn) (d:a village near Tedim in Chin State) (r:zd:16728/zd:11170) (q:draft)
siangta = (i:1) (t:v) (f:everyday/time) (w:be finished/be completed/be settled) (d:<siang>, clear, with the ending <ta>, now or already, written as one word: be cleared away, completely finished; {kizo siangta} is it has been brought to a close) (j:siang/ta) (r:zd:15855/zd:22470/zd:22334) (q:draft)
siangtak = (i:2) (t:adv) (f:everyday/media) (w:clearly/plainly/openly) (d:as {siangtak in} before a verb of saying, seeing or knowing: in a clear and plain way, hiding nothing) (r:zd:20817/zd:23655/zd:15324) (q:draft)
siangtak = (i:3) (t:adv) (f:health/body) (w:clean/thoroughly) (d:as {siangtak in} before a verb of washing, such as <sil> or <sawp>: until clean, mostly of the hands, {khut siangtak in sil}) (r:zd:23512/zd:23538) (q:draft)
siangtakin = (i:2) (t:adv) (f:everyday/health) (w:cleanly/clean/thoroughly) (d:with a verb of washing or cleaning such as <sawp>, so that the thing becomes clean; with <gen> the word means plainly) (r:zd:23848) (q:draft, low confidence)
siangtholo = (i:1) (t:adj) (f:health/food) (w:unclean/unhygienic/dirty) (d:<siangtho>, clean, with <lo>, not, written as one word: not clean, said of food, hands and places, and of meat that a religion forbids) (j:siangtho/lo) (r:zd:22193/zd:11915/zd:21869) (q:draft)
siangthona = (i:2) (t:n) (f:health/home) (w:cleanliness/hygiene/purity) (d:the state of being clean and free from dirt, from <siangtho.2>: said of the body, a house or a village, as in {pumpi siangthona}, bodily hygiene, and beside <cidamna>, health; apart from the religious meaning holiness) (b:siangtho) (r:ts:3375/zd:23935/ts:3125) (q:draft)
sianin = (i:1) (t:phrase) (f:religion) (d:{Sian}, short form of <Pasian>, God, used in songs and blessings, with the agent marker <in>: God, as the one who acts; {sianin hong siam ta hen} is may God bless you) (r:zd:11224/zd:24939) (q:draft)
Sianmang = (i:1) (t:n) (f:religion) (w:God/the Lord) (d:word of songs and poetic language for <Pasian>, God, often {Tung Sianmang}, God above; also in the title {Sianmang' Hawmtel} of a Zomi film and book) (r:zd:19381/zd:24452) (q:draft, low confidence)
siansuah = (i:2) (t:v) (f:home/health) (w:clean/clean up/clear/disinfect) (d:make a house, a street or a thing clean in the plain sense, by washing, sweeping or killing germs, or clear a place of what should not be there; no ritual meaning) (r:zd:16398/zd:15575/zd:26708) (q:draft)
siansuahding = (i:1) (t:v) (f:everyday/politics) (w:will clean up/will clear out) (d:<siansuah> and <ding> written as one word: is to be made clean; in news said of cleaning a place and of the authorities clearing out drugs or criminals) (j:siansuah/ding) (r:zd:12647/zd:13129/zd:11078) (q:draft)
siansuahna = (i:2) (t:n) (f:home/everyday) (w:cleaning/clean-up/clearing) (d:the plain cleaning or clearing of a place such as a compound or a road, with no ritual meaning; the place is named before {siansuahna}) (r:zd:20026/zd:19925) (q:draft, low confidence)
siansuahna = (i:3) (t:n) (f:politics/media) (w:clearance operation/crackdown/sweep) (d:an operation by soldiers or police to clear an area of people or to search it thoroughly; {minam siansuahna} is ethnic cleansing and {gamsung siansuahna} a crackdown across the country) (r:zd:14979/zd:17357) (q:draft)
siansuahsak = (i:1) (t:v) (f:home/everyday) (w:clean/clean up/cleanse) (d:<siansuah>, make clean, and the causative <sak> written as one word: clean a place or thing, in news mostly in the plain sense of cleaning up) (j:siansuah/sak) (r:zd:13197/zd:20444) (q:draft)
sianu = (i:1) (t:n) (f:education/religion) (w:woman teacher/female teacher) (d:<sia>, teacher, with <nu>, woman: a woman who teaches; also a title before the name of a woman teacher or church worker, and of the wife of a teacher or pastor) (a:siapa) (b:sia) (r:zd:19779/zd:22850) (q:draft)
siapa = (i:2) (t:n) (f:religion) (w:pastor/minister/reverend) (d:respectful word for a pastor or preacher, said of him or to him in place of his name; {pawlpi kem siapa} is the pastor in charge of a church, and {Topa'n siapa hong zang tahen} is a blessing said to a pastor) (r:zd:17978/zd:12695/zd:11999) (q:draft)
Siapinu = (i:1) (t:n) (f:education) (w:headmistress/woman principal/woman head teacher) (d:a woman who is the head of a school, the female counterpart of <siapipa>; also used for a senior woman teacher) (r:zd:23653) (q:draft, low confidence)
siapipa = (i:1) (t:n) (f:education/religion) (w:headmaster/principal/head teacher) (d:<sia>, teacher, and <pipa>, chief, written as one word: the head of a school; also a respectful word for a senior teacher or pastor) (j:sia/pipa) (r:zd:24595/zd:24502/zd:22185) (q:draft)
siapite = (i:1) (t:n) (f:education/religion) (w:teachers/masters/senior teachers) (d:<sia>, teacher, with {-pi}, great, and the plural <te>: the teachers or learned people of a subject, and one's own teachers; {Laisiangtho siapite} are the teachers of the Bible) (b:sia) (r:zd:23591/zd:17673/zd:21617) (q:draft)
siasemsem = (i:1) (t:v) (f:everyday) (w:get worse and worse/worsen) (d:<sia>, bad, and <semsem>, more and more, written as one word: become worse and worse) (j:sia/semsem) (r:zd:11557/zd:15435) (q:draft)
siata = (i:1) (t:v) (f:everyday) (w:have gone bad/be ruined/be worn out) (d:<sia>, bad, with <ta>, now or already, written as one word: has become bad, spoiled or decayed) (j:sia/ta) (r:zd:9428/zd:21408) (q:draft)
siatlam = (i:1) (t:n) (f:everyday/nature) (w:way of ruin/direction of destruction) (d:<siat>, be ruined, and <lam>, direction, written as one word; {siatlam manawh} is head toward ruin, grow worse, the opposite of <hoihlam>) (j:siat/lam) (r:zd:19318/zd:21605) (q:draft)
siatluatna = (i:1) (t:n) (f:nature) (w:severe badness/great severity) (d:<siat>, bad, with <luatna>, excess, written as one word: being very bad; {khuahun siatluatna} is bad weather) (j:siat/luatna) (r:zd:20155/zd:13039) (q:draft)
siattatna = (i:1) (t:n) (f:social/politics) (w:wrongdoing/evil-doing/crime/violence) (d:<siattat>, do harm or evil, with the noun ending {-na}: harmful or criminal conduct) (b:siattat) (r:zd:22228/zd:22095) (q:draft)
siatvat = (i:1) (t:n) (f:social) (w:condolence visit/mourning visit) (d:a visit to a house where someone has died, to mourn with the family; named beside <natveh>, visiting the sick) (r:zd:25192) (q:draft, low confidence)
siatvatna = (i:1) (t:n) (f:social/family) (w:condolence gift/condolence money/condolence visit) (d:the custom of visiting a bereaved family and giving them money or help, and the money so given; in news also a payment made by a government to the family of someone who died) (r:zd:25192/zd:19160) (q:draft)
siau = (i:1) (t:v) (f:work/politics) (w:apply/apply for) (d:ask for something in the set way, as a visa, a job, a scholarship or a post; {nasep siau} is apply for a job) (o:Burmese, shauk) (r:zd:22264/zd:18208/zd:22652) (q:draft)
siau = (i:2) (t:v) (f:travel/everyday) (w:walk along/stroll) (d:go along on foot; {lam siau} is walk along the road) (o:Burmese, shauk) (r:zd:20902) (q:draft, low confidence)
siauh = (i:1) (t:v) (f:work/travel) (w:apply/apply for) (d:make a formal application, as for a visa, a job or a place in another country) (o:Burmese) (r:zd:22264/zd:18234) (q:draft)
siauh = (i:2) (t:v) (f:everyday/health) (w:walk/take a walk) (d:go on foot, in the phrase {lam siauh}, take a walk) (o:Burmese) (r:zd:12541/zd:24276) (q:draft)
siauhna = (i:1) (t:n) (f:work/education) (w:application/applying) (d:the act of applying for a job, a place at school or a status, and the application itself, from <siau>, apply; {siauhna lai} is a written application; in {lam siauhna} the word means walking) (o:Burmese) (r:zd:15275/zd:24248/zd:25262) (q:draft)
Siaunuamte = (i:1) (t:n) (f:work/politics) (w:those who want to apply/applicants) (d:<siau>, apply, and <nuamte> written as one word: those who wish to apply for a post) (j:siau/nuamte) (r:zd:19606) (q:draft, low confidence)
siavuan siamah = (i:1) (t:n) (f:health) (w:doctors and nurses/medical staff) (d:<siavuan>, doctor, and <siamah>, here a nurse: doctors and nurses together, the medical staff; mostly followed by <te>) (r:zd:24418/zd:19302/zd:19342) (q:draft)
siavuanpi = (i:1) (t:n) (f:health) (w:senior doctor/specialist/chief physician) (d:<siavuan>, doctor, with <pi>, great or chief: a senior doctor or a specialist) (r:zd:24610/zd:21864) (q:draft)
siavuanpipa = (i:1) (t:n) (f:health) (w:chief doctor/chief medical officer) (d:<siavuan> doctor and <pipa> chief written as one word: the doctor in charge of a hospital or of the health service of a township) (j:siavuan/pipa) (r:zd:11953/zd:25203/zd:24234) (q:draft)
siavuansiam = (i:1) (t:n) (f:health) (w:specialist doctor/specialist/expert physician) (d:<siavuan>, doctor, and <siam>, skilled, written as one word: a doctor expert in one branch, named after the branch as in {naupang siavuansiam}, pediatrician) (j:siavuan/siam) (r:zd:16170/zd:16332) (q:draft)
siazan = (i:1) (t:v) (f:everyday) (w:be damaged/be wrecked) (d:be badly damaged or broken, mostly as {siazan gawp}, be wrecked) (r:zd:14509/zd:16637) (q:draft, low confidence)
Siberia = (i:1) (t:name) (c:place) (f:travel/nature) (w:Siberia) (d:the vast cold region of Russia in northern Asia) (r:zd:12942/zd:24933) (q:draft)
Sibu = (i:1) (t:name) (c:city) (f:travel) (w:Sibu) (d:town in the state of Sarawak in Malaysia) (r:zd:16617/zd:15405) (q:draft)
Sichuan = (i:1) (t:name) (c:land) (f:travel/politics) (w:Sichuan) (d:province in the south-west of China) (r:zd:14802/zd:12101) (q:draft)
siding = (i:1) (t:v) (f:everyday/health) (w:will die) (d:<si>, die, and <ding>, will, written as one word: will die, is going to die) (j:si/ding) (r:zd:15274/zd:13260) (q:draft)
Siengtho = (i:1) (t:adj) (f:religion) (j:Siangtho) (r:zd:25808/zd:25484) (q:draft)
sigal = (i:1) (t:n) (f:social/family) (w:funeral visit/mourning gathering) (d:the going to the house of someone who has died and the gathering there to mourn; {sigal mi} are the mourners and {sigal pai} is go to a funeral) (r:zd:9254/zd:14805) (q:draft)
sign = (i:1) (t:n) (f:work/politics) (w:signature/sign) (d:the writing of one's name on a document to approve it; {sign thuh} or <sign thu> is put a signature, sign; it is also used for a sign or symbol) (o:English) (r:zd:19097/zd:20256/ts:7972) (q:draft)
sign thu = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature to) (d:the English word <sign>, signature, and <thu>, here a verb, to put on or affix: to sign a document, a law or an order; the thing signed stands before it) (r:zd:24453/zd:23982) (q:draft)
signal = (i:1) (t:n) (f:travel/it) (w:signal) (d:a sign given to others, as the turn signal of a vehicle or a railway signal, or the reception of a phone; {signal la} is give a signal) (o:English) (r:zd:15471/zd:11882/zd:17603) (q:draft)
signboard = (i:1) (t:n) (f:social/work) (w:signboard/sign) (d:a board with the name or notice of an office, shop or organisation) (o:English) (r:zd:24595/zd:24017) (q:draft)
signed = (i:1) (t:v) (f:politics) (w:sign) (d:the English form signed used as a Zolai verb: sign an agreement, be a signatory, mostly of the ceasefire agreement; {a signed lo teng} is those who have not signed) (o:English) (r:zd:20315/zd:11463) (q:draft)
sigui = (i:1) (t:n) (f:body/health) (w:blood vessel/vein/nerve) (d:a vessel of the body, named together with <thagui>; a dictionary also gives it for nerve, so the exact sense is not certain) (r:zd:25223/zd:21510) (q:draft, low confidence)
sihbawl = (i:1) (t:v) (f:health/social) (w:kill oneself/commit suicide) (d:<sih>, die, with <bawl>, make; used with the prefix <ki> and often after {amah leh amah}, he himself: take one's own life) (r:zd:12992/zd:20592) (q:draft)
sihbawlsawm = (i:1) (t:v) (f:health/social) (w:attempt to take one's life/try to kill) (d:<sih>, die, <bawl>, make, and <sawm>, intend, written as one word; with {amah leh amah aki}, try to take one's own life) (j:sih/bawl/sawm) (r:zd:19428) (q:draft)
sihbeh = (i:1) (t:v) (f:media/health) (w:die in addition/more die) (d:<sih> die with the ending {-beh}, in addition, written as one word: more people die, a further death is added to those counted before) (b:sih) (r:zd:11265/zd:15223/zd:14858) (q:draft)
sihdan = (i:1) (t:n) (f:politics) (w:death sentence/death penalty/capital punishment) (d:the punishment of death given by a court; {sihdan pia} is sentence to death and {sihdan ngah} is be sentenced to death) (r:zd:20945/zd:11225) (q:draft)
sihdan = (i:2) (t:n) (f:everyday) (w:manner of death/way of dying) (d:<sih>, die, with <dan>, way: how a person dies) (r:zd:25517) (q:draft, low confidence)
sihding = (i:1) (t:v) (f:health/everyday) (w:to die/will die/dying) (d:<sih>, die, and <ding> written as one word: going to die, or dying as a thing spoken of; {sihding launa} is fear of dying) (j:sih/ding) (r:zd:21869/zd:11477/zd:11827) (q:draft)
sihdong = (i:1) (t:adv) (f:time/everyday) (w:until death/to the death) (d:<sih> and <dong> written as one word: until one dies, for the whole of life) (j:sih/dong) (r:zd:25397) (q:draft)
sihgalna = (i:1) (t:n) (f:social/family) (w:condolence/condolence gift/funeral aid) (d:<sih>, die, with <galna>, condolence visit: mourning with the family of a dead person, and the money given to that family; {sihgalna sum} is condolence money) (r:zd:25232/zd:12767) (q:draft)
sihi = (i:1) (t:v) (f:everyday/health) (w:die) (d:<si>, die, and the sentence ending <hi> written as one word: died, is dead) (j:si/hi) (r:zd:14507/zd:21294/zd:24289) (q:draft)
sihkhat = (i:1) (t:adv) (f:everyday/media) (w:in one death/dying together) (d:<sih>, die, and <khat>, one, written as one word and followed by <in>: several die together in the same event, {sihkhat in si}) (j:sih/khat) (r:zd:14664/zd:15974) (q:draft)
sihkhiat = (i:1) (t:v) (f:everyday/family) (w:die/pass away) (d:<sih> and <khiat> written as one word: depart in death; {a sihkhiat dong} is until he died, to the end of his life) (j:sih/khiat) (r:zd:9263/zd:9209) (q:draft)
sihkohna = (i:1) (t:n) (f:social/media) (w:death notice/obituary/announcement of a death) (d:<sih>, die, with <kohna>, announcing: the notice by which a death is made known to the community) (j:sih/kohna) (r:zd:14864/zd:25912) (q:draft)
sihlawhden = (i:1) (t:v) (f:health/media) (w:keep dying/die regularly) (d:<sihlawh> and <den> written as one word: people die of a cause again and again, as every year) (j:sihlawh/den) (r:zd:17750/zd:19543/zd:21020) (q:draft)
sihlawhkhin = (i:1) (t:v) (f:everyday/media) (w:have died/have been killed) (d:<sihlawh>, die as a result of something, and <khin>, already, written as one word: have died from the cause named; common in news headlines) (j:sihlawh/khin) (r:zd:11534/zd:20518/zd:15820) (q:draft)
sihlawhliang = (i:1) (t:v) (f:health/media) (w:die as a result/lose one's life/be fatal) (d:<sihlawh>, die because of something, with a following emphatic word meaning even, to that extent: actually die from an injury, accident or ill-treatment; {sihlawhliang nading} is life-threatening) (b:sihlawh) (r:zd:16410/zd:20611/zd:13131) (q:draft)
sihlawhmawk = (i:1) (t:v) (f:health/media) (w:die as a result/lose one's life) (d:<sihlawh> and <mawk> written as one word: died because of it, <mawk> adding that the death is striking or regrettable) (j:sihlawh/mawk) (r:zd:11285/zd:11617) (q:draft)
sihlawhngei = (i:1) (t:v) (f:everyday) (w:have died from it before) (d:<sihlawh>, die because of something, and <ngei>, ever, written as one word: people have died in such an event before) (j:sihlawh/ngei) (r:zd:17645/zd:15613) (q:draft)
sihlawhpah = (i:1) (t:v) (f:everyday/health) (w:die at once/die on the spot) (d:<sihlawh>, die as a result of something, and <pah>, at once, written as one word: be killed at once by an accident or an attack) (j:sihlawh/pah) (r:zd:17748/zd:15043) (q:draft)
sihloh = (i:1) (t:v) (f:health/everyday) (w:not die) (d:<sih>, die, and <loh>, not, written as one word; {sihloh phamawh} is cannot but die, death is certain, and {sihloh nang} is so that it does not die) (j:sih/loh) (r:zd:11440/zd:15770) (q:draft)
sihma = (i:1) (t:adv) (f:time/health) (w:before dying/before death) (d:<sih>, die, and <ma>, before, written as one word; {a sihma in} is before he died) (j:sih/ma) (r:zd:21616/zd:23773/zd:21180) (q:draft)
sihna tuak = (i:1) (t:v) (f:everyday/media) (w:die/be killed/lose one's life) (d:<sihna>, death, and <tuak>, here meet with or undergo: to meet death, to die, the usual wording of news for deaths in accidents, attacks and epidemics; the subject with <in> stands before it, and {sihna tuak mi} or {sihna tuakte} are the dead) (r:zd:24399/zd:10923/zd:25115) (q:draft)
sihnavai = (i:1) (t:n) (f:social/media) (w:death case/matter of the death) (d:<sihna>, death, with <vai>, matter, written as one word: the case or circumstances of a person's death) (j:sihna/vai) (r:zd:11627/zd:13292) (q:draft)
sihni = (i:1) (t:n) (f:time/family) (w:day of death) (d:<sih> and <ni> written as one word: the day on which someone dies or died) (j:sih/ni) (r:zd:13183/zd:23086/zd:17861) (q:draft)
sihpih = (i:2) (t:adj) (f:politics/media) (w:suicide) (d:before <bomb>: of an attack in which the attacker dies together with the victims; {sihpih bomb} is a suicide bomb) (r:zd:10719/zd:10740) (q:draft)
sihsia = (i:1) (t:n) (f:everyday/health) (w:bad death/violent death/unnatural death) (d:<sih>, die, with <sia>, bad: a death that is not natural, as by accident or violence; paired with <natsia>, bad sickness) (j:sih/sia) (r:zd:22046/zd:26962) (q:draft)
sihui = (i:1) (t:n) (f:body/health) (w:blood vessel/vein/artery) (d:a tube that carries blood through the body; {lungtang sihui} is the blood vessels of the heart) (r:zd:21284/zd:24082/zd:24276) (q:draft)
sihvui = (i:1) (t:n) (f:social/religion) (w:funeral/burial) (d:<sih> die with <vui> bury: the burial of a dead person and the service held for it; {sihvui hun} is the time of the funeral) (r:zd:15846/zd:11712) (q:draft)
sihvuina = (i:1) (t:n) (f:social/religion) (w:funeral/burial) (d:<sih>, die, with <vuina>, burial, written as one word: the burial of a dead person and the gathering held for it; {sihvuina sum} is money paid toward a funeral) (j:sih/vuina) (r:zd:25219/zd:12311/zd:22489) (q:draft)
Sihzang = (i:1) (t:name) (c:people) (f:social) (w:Sizang/Siyin) (d:one of the Zomi groups of the Tedim area, their home region and their dialect; {Sihzang pau} or {Sihzang kam} is the Sizang dialect) (r:zd:24303/zd:22802) (q:draft)
siikan = (i:1) (t:n) (f:social/education) (w:discipline/rules) (d:orderly conduct under rules, self-discipline) (o:Burmese) (r:zd:21783) (q:draft, low confidence)
siiksan = (i:1) (t:n) (f:social/everyday) (w:stepping stone/foothold/basis) (d:something stepped on to get up or across, and so the thing a person or a claim rests on or is helped up by; {siiksan in} is using as a stepping stone) (r:zd:23513/zd:25470/zd:25515) (q:draft, low confidence)
Siing = (i:1) (t:n) (c:plant) (f:food/health) (w:ginger) (d:the root used as a spice and a medicine; also occurs as part of personal names) (r:zd:23729/zd:11167) (q:draft)
sik = (i:3) (t:v) (f:work/religion) (w:pay for/cover/provide) (d:take a cost or a need upon oneself for someone else: {sum sik} is bear the expenses, and {Topa in hong sik} is the Lord provides; not the stepping of the foot) (r:zd:22383/zd:21550/zd:23835) (q:draft)
sikan = (i:1) (t:n) (f:social/education) (w:discipline/rule/regulation) (d:rules of conduct and the self-control of keeping them; also the rules of a thing, as of writing) (o:Burmese, si kan) (r:zd:15758) (q:draft)
sikdat = (i:1) (t:n) (f:health/food) (w:iron) (d:<sik>, iron, with <dat>, substance: iron as a nutrient in food) (r:zd:22740/zd:20433) (q:draft)
sikding = (i:1) (t:v) (f:everyday/travel) (w:to step on/will step on/to press) (d:<sik>, step on, and the future marker <ding> written as one word: to step on, meaning to press with the foot, as the brake of a car) (j:sik/ding) (r:zd:11177/zd:15207) (q:draft)
sikh = (i:2) (t:n) (f:religion) (w:Sikh) (d:the English word, written with a capital: a follower of the religion from India, or before <biakna> that religion itself; not the verb {sikh}, provide) (r:zd:24388/zd:12656) (q:draft)
sikhan = (i:1) (t:n) (f:health) (w:clinic) (d:a small medical centre where the sick are seen and treated) (s:Clinic) (o:Burmese) (r:zd:22212/zd:23663) (q:draft)
sikhang = (i:1) (t:n) (f:health) (w:high blood pressure/hypertension) (d:<si>, blood, with <khang>, rise; often as {sikhang natna}) (r:zd:20778/zd:20433/zd:23729) (q:draft)
sikhat = (i:1) (t:adj) (f:family/social) (w:of one blood/kindred) (d:<si>, blood, with <khat>, one; used in the pair {sikhat sakhat}, of one blood and one flesh: close kin, of the same stock) (j:si/khat) (r:zd:25461/zd:25097) (q:draft)
sikhinding = (i:1) (t:v) (f:everyday/media) (w:will have died/be believed dead) (d:<sikhin>, have died, and <ding> written as one word: will have died, must be dead; in news reports of people believed to have died) (j:sikhin/ding) (r:zd:13041/zd:17474) (q:draft)
sikhinta = (i:1) (t:v) (f:health/everyday) (w:have died/be dead) (d:<si>, die, and <khinta>, already done, written as one word: has already died) (s:sikhin) (j:si/khinta) (r:zd:23727/zd:19002/zd:14856) (q:draft)
sikhum = (i:1) (t:n) (f:health) (w:diabetes/high blood sugar) (d:sweet blood, sugar in the blood; named together with <zunkhum>, sweet urine, for diabetes) (r:zd:20747/zd:14586/zd:15527) (q:draft)
sikkang = (i:1) (t:n) (f:home) (w:corrugated iron sheet/tin roofing/zinc sheet) (d:<sik>, iron, with <kang>, white: thin galvanised metal sheet used for roofs and walls; {sikkang inn} is a house roofed with it) (r:zd:13239/zd:17495/zd:14985) (q:draft)
sikkeu = (i:2) (t:n) (f:home/food) (w:spoon) (d:a spoon for eating; the row of the Bible lexicon has the sense fork) (r:zai:spoon) (q:draft)
sikkha = (i:1) (t:v) (f:everyday) (w:step on/tread on by accident) (d:<sik>, step on, and <kha>, happen to, written as one word: step on something without meaning to, or have the foot land on it) (j:sik/kha) (r:ts:3492/zd:14892/zd:11172) (q:draft)
sikkhau = (i:2) (t:n) (f:media/it) (w:telegram/telegraph/wire) (d:a message sent along a wire, and the telegraph itself; with <sat>, strike, {sikkhau sat} is send a telegram) (r:zd:25918/zd:23556) (q:draft)
sikkhau = (i:3) (t:n) (f:home/it) (w:wire) (d:metal wire, as for fencing or for a telephone line, where the other sense is a chain of links) (r:zd:22709) (q:draft, low confidence)
sikkhial = (i:1) (t:v) (f:everyday/travel) (w:misstep/step on by mistake/lose footing) (d:<sik>, step on, with <khial>, wrongly: put the foot in the wrong place, or step by mistake on a pedal or a mine) (j:sik/khial) (r:zd:15317/ts:5635/zd:21826) (q:draft)
sikkongkhak = (i:1) (t:n) (f:home) (w:iron door/metal gate/metal shutter) (d:<sik>, iron, with <kongkhak>, door, written as one word: a door, gate or shutter made of metal) (j:sik/kongkhak) (r:zd:15301/zd:12788) (q:draft)
siklei = (i:1) (t:n) (f:travel) (w:steel bridge/iron bridge) (d:<sik>, iron, and <lei>, here bridge, written as one word: a bridge built of steel) (j:sik/lei) (r:zd:16735) (q:draft, low confidence)
siklik = (i:1) (t:n) (f:health/body) (w:wart/callus) (d:a small hard growth on the skin of the hands or feet) (r:zd:24276) (q:draft, low confidence)
siklik = (i:2) (t:n) (f:everyday/health) (w:cigarette) (s:zatep) (o:Burmese) (r:zd:23767) (q:draft, low confidence)
sikmanlo = (i:1) (t:v) (f:travel) (w:fail to brake in time) (d:<sik>, step on, <man>, here manage in time, and <lo>, not, written as one word: with <Brake>, not manage to step on the brake in time) (j:sik/man/lo) (r:zd:15429/zd:17603) (q:draft)
siksak = (i:1) (t:v) (f:work/social) (w:pay for/cover the cost of) (d:bear a cost for someone else, as fuel for a journey or the expenses of a funeral) (r:zd:16754/zd:20446) (q:draft, low confidence)
siksak = (i:2) (t:v) (f:social/politics) (w:base on/rely on) (d:in {siksak in}, on the basis of; used like <siksan>, of which it may be a spelling) (r:zd:24847) (q:draft, low confidence)
siksakol = (i:1) (t:n) (f:travel) (w:bicycle/bike) (d:literally iron horse, <sik> with <sakol>: a bicycle) (s:saikel) (r:zd:23748/zd:16148) (q:draft)
siksan = (i:2) (t:n) (f:everyday) (w:basis/ground/footing) (d:used as a noun, the thing one stands on or relies on, as in {siksan kician}, a firm basis, and {na siksan}, your footing) (r:zd:20160/zd:21473) (q:draft)
siksik = (i:1) (t:v) (f:everyday/work) (w:keep demanding/dun) (d:ask for money again and again, as a lender presses for payment; a doubled form) (r:zd:21876) (q:draft, low confidence)
siktukilh = (i:1) (t:n) (f:home/work) (w:nail/iron nail) (d:a metal nail driven in to fasten wood; the word contains <sik>, iron, and <kilh>, fasten) (r:zd:17779/zd:23907/zd:14521) (q:draft)
sikzawn = (i:1) (t:n) (f:travel/work) (w:iron bar/rail/steel bar) (d:a long bar of iron or steel, from <sik>, iron: the rail of a railway track, {meileng sikzawn}, the bars fitted across a window, and the steel bars used in building) (r:zd:16851/zd:15243/zd:18074) (q:draft)
sikzum = (i:1) (t:n) (f:home/work) (w:metal spike/iron spike/pointed piece of metal) (d:<sik>, iron, with <zum>, pointed, written as one word: a sharp pointed piece of iron or other metal) (j:sik/zum) (r:zd:19550/zd:15400) (q:draft)
sil = (i:1) (t:v) (f:everyday/body/home) (w:wash/bathe) (d:wash the body or a part of it, such as the hands and feet, with water) (s:sawp) (q:draft)
silbawl = (i:1) (t:n) (f:work) (w:activity/undertaking/work) (d:the things a person does or makes; found paired with <nasep>, work, as {nasep silbawl}, work and activities, what one does for a living) (r:zd:24658/ts:479) (q:draft)
silbawlna = (i:1) (t:n) (f:work) (w:work/activity/undertaking) (d:what a person does; found in the pair {nasep silbawlna}, work and all that one does) (r:zd:12167/zd:19984) (q:draft)
silehnai = (i:1) (t:n) (f:body/health) (w:blood/gore/blood and pus) (d:<si>, blood, <leh>, and, <nai>, here pus, written as one word: blood and gore; {silehnai tawh kidim} is covered all over with blood) (s:silenai) (j:si/leh/nai) (r:zd:11435/zd:14959/zd:11992) (q:draft)
silh = (i:1) (t:v) (f:everyday/home) (w:dress/clothe/wear/put on) (d:put on or wear clothes; {puan silh} is wear a garment) (s:puansilh) (a:suahkhia)
silhding = (i:1) (t:v) (f:everyday/home) (w:to wear/to put on) (d:<silh>, wear, and <ding> written as one word: to wear, what is to be worn; {puan silhding} is clothes to wear) (j:silh/ding) (r:zd:12403/zd:26097) (q:draft)
silhleten = (i:1) (t:n) (f:home/everyday) (w:clothing/attire/dress) (d:{silh le ten}, what is worn on the upper and the lower body, written as one word: clothing, the way one dresses) (r:zd:17468/zd:23972) (q:draft)
silhvetlo = (i:1) (t:v) (f:everyday/body) (w:wear nothing at all/not wear at all) (d:<silh>, wear, and <vetlo>, not at all, written as one word) (j:silh/vetlo) (r:zd:17127/zd:12630) (q:draft)
Silk = (i:1) (t:n) (f:home) (w:silk) (d:silk cloth, {puan silk}; elsewhere mostly part of English names such as Silk Road) (o:English) (r:zd:24119) (q:draft, low confidence)
silo = (i:1) (t:v) (f:health/everyday) (w:not die/survive) (d:<si> and <lo> written as one word: did not die, is not dead) (j:si/lo) (r:zd:11148/zd:16899/zd:20535) (q:draft)
silsial = (i:1) (t:adv) (f:nature/everyday) (w:brightly/gleaming) (d:placed after a verb of shining or appearing, as in {tang silsial} and {ni suak silsial}: with a clear, bright shine; also seen after words for flowing water and for cold) (r:zd:19242/zd:19812) (q:draft, low confidence)
sim = (i:1) (t:v) (f:everyday/education) (w:read) (d:read what is written, silently or aloud before others) (s:laisim) (q:draft)
sim = (i:4) (t:det) (f:time/everyday) (w:every/each) (d:placed after a word for a time or an event, often followed by <a> or <in>: every one, each time, as in <nisim>, every day, and {meeting sim}, every meeting; not the verb read or count) (r:zd:25127/zd:23727) (q:draft)
simawk = (i:1) (t:v) (f:health/everyday) (w:die/pass away) (d:<si>, die, and <mawk> written as one word: died, said of a death that came unexpectedly or is reported with regret) (j:si/mawk) (r:zd:14664/zd:16038) (q:draft)
simbeh = (i:1) (t:v) (f:education) (w:read more/read further) (d:<sim>, read, with the ending <beh>, in addition: read more about a matter than one has already read) (b:sim) (r:zd:21288/zd:21340) (q:draft)
simbu = (i:2) (t:n) (f:education) (w:reader/primer/textbook) (d:<sim>, read, with the second part of <laibu>, book: a school book for learning to read, not the owl; nearly always {Zolai simbu}, the Zolai reader used in the schools) (r:zd:11891/zd:21179/zd:18171) (q:draft)
simcard = (i:1) (t:n) (f:it) (w:SIM card) (d:the small card that connects a mobile phone to a network and carries its number) (o:English, SIM card) (r:zd:21257/zd:25052/zd:14767) (q:draft)
simdan = (i:1) (t:n) (f:education) (w:way of reading/reading) (d:<sim>, read, and <dan>, way, written as one word: how something is read, and reading as a skill) (j:sim/dan) (r:zd:12867/zd:24303/zd:21607) (q:draft)
simding = (i:1) (t:v) (f:education/media) (w:to read/will read/reading matter) (d:<sim>, read, and <ding> written as one word: will read, or something meant to be read; {nungak te simding} is for girls to read) (j:sim/ding) (r:zd:14941/zd:21826) (q:draft)
simding = (i:2) (t:v) (f:social) (w:to attend) (d:<sim> for <siim>, attend a feast, and <ding> written as one word: in order to attend; {mopawi simding} is to attend a wedding) (j:siim/ding) (r:zd:11133) (q:draft, low confidence)
simhuai = (i:1) (t:adj) (f:education/media) (w:worth reading/readable) (d:<sim>, read, with <huai>, worthy of: that deserves to be read) (j:sim/huai) (r:zd:24028/zd:20142/zd:20538) (q:draft)
simin = (i:3) (t:adv) (f:everyday) (w:by the/in) (d:<sim>, count, with <in>, after a number word in the pattern {a tul a simin}, by the thousands, in numbers counted in thousands) (r:zd:21939/zd:23301) (q:draft)
simin = (i:4) (t:v) (f:education/religion) (w:reading) (d:<sim>, read, with the linking ending <in>: reading a text and then going on to the next action, often after the name of a book or a verse) (r:zd:26385/zd:21066) (q:draft, low confidence)
simkhak = (i:1) (t:v) (f:education/media) (w:happen to read/come upon in reading) (d:the form of <simkha> used before <ciangin> and in relative clauses: happen to read, have read) (b:simkha) (r:zd:11410/zd:20142) (q:draft)
simkhiatna = (i:1) (t:n) (f:education/social) (w:reading out/reading aloud/public reading) (d:<simkhiat>, read out, with the noun ending {-na}: the reading aloud of a text before others; {simkhiatna nei} is to read out) (b:simkhiat) (r:zd:11325/zd:11425) (q:draft)
simlei = (i:1) (t:n) (f:nature/media) (w:earth/world) (d:word of songs and poems for the earth, the world where people live; set against <thangvan>, the sky above) (s:leitung) (r:zd:23902/zd:25601) (q:draft)
simlo = (i:1) (t:v) (f:education/everyday) (w:not read) (d:<sim>, read, and <lo>, not, written as one word: does not read, without reading) (j:sim/lo) (r:zd:19679/zd:14941) (q:draft)
