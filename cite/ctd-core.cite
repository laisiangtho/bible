uihlua = (i:1) (t:v) (f:everyday/body) (w:stink badly/smell very bad) (d:<uih> and <lua> written as one word: smell very bad, mostly before <mahmah>) (j:uih/lua) (r:zd:19981) (q:draft)
uii = (i:1) (t:v) (f:health) (w:steam/sterilise by steam) (d:treat instruments with steam or boiling heat so that they are free of germs; {a ki uii theilo vante} are the things that cannot be treated so) (r:zd:15182) (q:draft, low confidence)
uikhat = (i:1) (t:n) (f:nature/home) (w:a dog) (d:<ui>, dog, and <khat>, one, written as one word: a dog, one dog) (j:ui/khat) (r:zd:15848/zd:19398) (q:draft)
uino = (i:1) (t:n) (c:animal) (f:nature/home) (w:puppy/little dog/doggy) (d:<ui>, dog, with the diminutive ending {-no}: a young or small dog) (b:ui) (r:zd:17992/zd:20930/zd:15358) (q:draft)
uipen = (i:1) (t:phrase) (f:nature/home) (w:the dog) (d:<ui>, dog, and the topic marker <pen> written as one word: the dog, as the thing spoken about) (j:ui/pen) (r:zd:15848/zd:15283) (q:draft)
uipi = (i:1) (t:n) (c:animal) (f:nature/home) (w:female dog/bitch/mother dog) (d:<ui>, dog, with the ending {-pi}, female or full-grown: a female dog, a dog that has pups; in stories also a big dog) (b:ui) (r:zd:19295/zd:15283) (q:draft)
uipil = (i:1) (t:n) (c:animal) (f:nature/work) (w:trained dog/sniffer dog/police dog) (d:<ui>, dog, with <pil>, clever: a clever or trained dog, in news mostly one used by police or customs to search) (r:zd:11792/zd:21291/zd:15344) (q:draft)
uisa = (i:1) (t:n) (f:food) (w:dog meat) (d:<ui>, dog, with <sa>, meat) (b:ui) (r:zd:13133/zd:15283) (q:draft)
uital = (i:1) (t:n) (c:animal) (f:nature/home) (w:male dog/dog) (d:<ui>, dog, with <tal>, male: a male dog) (j:ui/tal) (r:ts:301) (q:draft)
uital = (i:2) (t:n) (f:politics) (w:junta troops/military council) (d:scornful name, literally male dog, for the army of the military council of Myanmar, as in {Uital galkapte}, the junta soldiers) (r:ts:1368) (q:draft, low confidence)
uitui = (i:1) (t:v) (f:social) (w:be on good terms/be close/get along) (d:used with the prefix <ki>, as {ki uitui}: be close to one another, be on friendly terms with someone) (r:zd:24594/zd:19671/zd:25488) (q:draft)
uk = (i:5) (t:v) (f:everyday) (w:be keen on/be fond of/like) (d:have a strong liking for a thing or a pastime such as music or jokes, often with <mahmah> or <lua>; a spelling of <uuk> and not the {uk} of ruling) (s:uuk) (r:zd:16442/zd:21529) (q:draft)
ukcipna = (i:1) (t:n) (f:politics) (w:domination/oppressive rule/subjugation) (d:<ukcip>, bring fully under one's rule, with the noun suffix <na>: rule that holds a people down by force; {ukcipna nuai} is under the domination of) (b:ukcip) (r:zd:10957/zd:25099/zd:22293) (q:draft)
