County = (i:1) (t:n) (f:politics/travel) (w:county) (d:a county, a division of a state or province, written after its name) (o:English) (r:zd:24453/zd:15305) (q:draft)
course = (i:1) (t:n) (f:education) (w:course) (d:a course of study or training at a school, college or centre) (o:English) (r:zd:14554/zd:14856) (q:draft)
Court = (i:1) (t:n) (f:politics) (w:court/law court) (d:a court of law, in the names of courts and beside the Zolai word <thukhenzum>) (s:thukhenzum) (o:English) (r:zd:24278/zd:11672/zd:19624) (q:draft)
Cousin = (i:1) (t:n) (f:family) (w:cousin) (d:a child of one's uncle or aunt, often added after <tanau>, relative, to say which kind of relative) (o:English) (r:zd:16749/zd:15609) (q:draft)
Covid = (i:1) (t:name) (f:health) (w:Covid-19/Covid) (d:the disease Covid-19, mostly written with the number, and the pandemic of 2020) (o:English) (r:zd:24635/zd:24250) (q:draft)
crackdown = (i:1) (t:n) (f:politics) (w:crackdown/raid) (d:an operation by the authorities to find and arrest people, in the articles mostly workers without papers; with <bawl>, carry out a crackdown) (o:English) (r:zd:12587/zd:21968) (q:draft)
Crane = (i:1) (t:n) (f:work) (w:crane) (d:the tall machine that lifts heavy loads on a building site) (o:English) (r:zd:15298/zd:15741) (q:draft)
Cream = (i:1) (t:n) (f:health/food) (w:cream) (d:a soft paste rubbed on the skin as medicine or cosmetic; in {ice cream} the frozen sweet food) (o:English) (r:zd:12364/zd:22650) (q:draft, low confidence)
Crew = (i:1) (t:n) (f:travel/work) (w:crew) (d:the people who work on an aircraft, train or ship, or a team such as an ambulance crew; mostly in {Cabin Crew}) (o:English) (r:zd:12124/zd:16851) (q:draft)
Crimea = (i:1) (t:name) (c:land) (f:politics) (w:Crimea) (d:peninsula on the Black Sea, taken from Ukraine by Russia in 2014) (r:zd:11085/zd:23513) (q:draft)
Criminal = (i:1) (t:n) (f:politics) (w:criminal) (d:a person who has committed a crime; before another English noun, of crime, as in {criminal case}, a case under criminal law) (o:English) (r:zd:17896/zd:23513) (q:draft, low confidence)
Croatia = (i:1) (t:name) (c:land) (f:politics/travel) (w:Croatia) (d:a country in south-eastern Europe, a member of the European Union since 2013) (r:zd:20444/zd:25601) (q:draft)
Croydon = (i:1) (t:name) (c:place) (f:travel/social) (w:Croydon) (d:a suburb in the east of Melbourne in Australia where Zomi live; in the articles mostly in addresses) (r:zd:15519) (q:draft, low confidence)
CRPH = (i:1) (t:name) (f:politics) (w:CRPH) (d:Committee Representing Pyidaungsu Hluttaw, the body formed by elected members of the Myanmar parliament after the military coup of 2021) (o:English) (r:zd:25020/zd:25063) (q:draft)
Crusade = (i:1) (t:n) (f:religion) (w:crusade/evangelistic meeting) (d:a series of public evangelistic meetings, as in {crusade bawl}, hold a crusade; also the Crusades, the medieval wars for the Holy Land) (o:English) (r:zd:15398/zd:23038) (q:draft)
Cuba = (i:1) (t:name) (c:land) (f:travel/politics) (w:Cuba) (d:island country in the Caribbean Sea) (r:zd:22609/zd:19860) (q:draft)
Cup = (i:1) (t:n) (f:media) (w:cup/tournament) (d:a sports competition played for a trophy, and the trophy itself; mostly after a name, as in Zomi Cup and World Cup) (o:English) (r:zd:21598/zd:17463/zd:16192) (q:draft)
Curfew = (i:1) (t:n) (f:politics) (w:curfew) (d:an order that nobody may be outside during set hours, mostly at night; {curfew thoh} is impose a curfew) (o:English) (r:zd:25046/zd:22641) (q:draft)
custom = (i:1) (t:n) (f:travel/politics) (w:customs) (d:the customs service at a border or airport and its officers, as in {custom officer}; in brackets after a Zolai word it is the English word for a custom or tradition) (o:English) (r:zd:15247) (q:draft, low confidence)
Customer = (i:1) (t:n) (f:work) (w:customer) (d:a person who buys goods or a service from a shop, restaurant or business) (o:English) (r:zd:17538/zd:17886) (q:draft)
Customers = (i:1) (t:n) (f:work) (w:customers) (d:people who buy from a shop or business; the English plural is used as it is, often followed by <te>) (o:English) (r:zd:14665/zd:12858/zd:20095) (q:draft)
Cutter = (i:1) (t:n) (f:work) (w:cutter/cutting tool) (d:a tool for cutting metal, used by rescue workers) (o:English) (r:zd:16741) (q:draft, low confidence)
Cyberjaya = (i:1) (t:name) (c:city) (f:travel) (w:Cyberjaya) (d:town in the state of Selangor, Malaysia, south of Kuala Lumpur) (r:zd:14808/zd:18007) (q:draft)
cycle = (i:1) (t:n) (f:travel) (w:motorcycle/motorbike) (d:a motorcycle, as the word is used in Myanmar, also {motor cycle}; {cycle hawl} is ride a motorcycle and {cycle lukhu} a helmet) (o:English) (r:zd:11831/zd:21220/zd:15571) (q:draft)
Cyclone = (i:1) (t:n) (f:nature) (w:cyclone) (d:a violent tropical storm from the sea, usually written {Cyclone huihpi}) (s:huihpi) (o:English) (r:zd:19960/zd:19920) (q:draft)
cylinder = (i:1) (t:n) (f:home/health) (w:cylinder/gas cylinder) (d:a metal container for gas, as for cooking gas or oxygen) (o:English) (r:zd:15354/zd:25148/zd:25146) (q:draft)
Cyprus = (i:1) (t:name) (c:land) (f:politics/travel) (w:Cyprus) (d:island country in the eastern Mediterranean Sea) (o:English) (r:zd:21027/zd:24532) (q:draft)
Czech = (i:1) (t:name) (c:land) (f:politics/travel) (w:Czech) (d:in the name Czech Republic, a country in central Europe) (r:zd:25359/zd:25584) (q:draft)
daak = (i:1) (t:v) (f:everyday) (j:dak) (r:zd:20936/zd:24086) (q:draft)
daal = (i:1) (t:v) (f:health/everyday) (j:dal) (r:zd:15730/zd:24283/zd:12112) (q:draft)
daan = (i:2) (t:n) (f:everyday) (w:way/manner/method) (d:the way in which something is done or is, a spelling of <dan>, after a verb or a clause; {zat daan} is the way of using) (s:dan) (r:zd:24324/zd:22802/zd:25390) (q:draft)
dah = (i:1) (t:v) (f:everyday/social) (w:mourn/grieve/be sad) (d:feel sorrow, above all over a death or a loss; the opposite of <lungdam>, be glad) (a:lungdam/kipak) (r:1.27.41)
dah akap = (i:1) (t:phrase) (f:social/religion) (w:the bereaved/those who mourn and weep) (d:<dah>, grieve, and {a kap}, who weeps, written as one word: with <a> before it, as {a dah akap}, those who grieve and weep, the bereaved family; a formula of condolence notices, followed by <khempeuh>, all, or <te>) (r:zd:23471/zd:20263) (q:draft)
dahmahmah = (i:1) (t:v) (f:everyday/social) (w:be very sad/grieve deeply) (d:<dah>, be sad, and <mahmah>, very, written as one word) (j:dah/mahmah) (r:zd:17461/zd:15114) (q:draft)
dahna kahna = (i:1) (t:n) (f:social/everyday) (w:mourning/grief/sorrow and weeping) (d:<dahna>, sorrow, and <kahna>, weeping, said as a pair: grief and mourning, above all over a death or a disaster; {dahna kahna hun} is a time of mourning) (r:zd:16071/zd:24176) (q:draft)
dahni = (i:1) (t:phrase) (f:everyday) (w:let us not) (d:<dah>, the word of refusal after a verb, and <ni>, let us, written as one word: let us not do it, I had better not) (j:dah/ni) (r:zd:24427/zd:14585) (q:draft)
dahni = (i:2) (t:n) (f:social/time) (w:day of sorrow/time of mourning) (d:<dah>, grieve, and <ni>, day, written as one word; paired with {nopni}, a day of joy) (j:dah/ni) (r:zd:9448/zd:24167) (q:draft)
Dahpa = (i:1) (t:name) (c:male) (f:social) (w:Dahpa) (d:main character of well-known Zomi folk tales, told as {Dahpa tangthu}; {Dahpa khuang}, the drum of Dahpa, is used as a saying) (r:ts:4831/zd:19501) (q:draft, low confidence)
dahpihna = (i:1) (t:n) (f:social) (w:condolence/sympathy) (d:<dahpih>, mourn with, with the noun suffix <na>: sympathy shown to the family of someone who has died; {dahpihna pulak} is express condolence) (b:dahpih) (r:ts:1343/zd:21462/zd:18234) (q:draft)
dahpihna ipulak = (i:1) (t:phrase) (f:social/media) (w:we express our condolences) (d:<dahpihna>, condolence, and <ipulak>, we make known: the closing formula of a death notice issued by a group, followed by <hi>; the group is named before it with <mintawh>, in the name of) (r:zd:25872) (q:draft)
DAHPIHNA LAI = (i:1) (t:n) (f:social/media) (w:condolence letter/letter of condolence/message of sympathy) (d:<dahpihna>, condolence, and <lai>, letter: a letter of sympathy that a person or an association sends or publishes for the family of someone who has died; it is used as the heading of such a letter, with the sender before it and <pan>, from) (r:zd:12629/zd:19657) (q:draft)
Dahpihna Lianpitawh = (i:1) (t:phrase) (f:social) (w:with deep sympathy/with deepest condolences) (d:<dahpihna>, condolence, and <Lianpitawh>, with great: the closing formula of a message of condolence, written before the name of the sender) (r:zd:21591) (q:draft)
dai = (i:1) (t:adj) (f:everyday) (w:quiet/calm/silent/still) (d:without noise or movement, of people, wind or sea; also as a verb, be quiet, fall silent, die down; {dai takin} is quietly, <dai dide> utterly still) (s:daii/gamdai/daicip) (r:19.107.29) (q:draft)
dai dide = (i:1) (t:v) (f:everyday) (w:be utterly silent/fall silent/keep still) (d:<dai>, quiet, and <dide>, the adverb of stillness that goes with it: be completely silent, say nothing at all; with <in> and <om> it means stay silent) (r:zd:22059/zd:22683/zd:23162) (q:draft)
daidai = (i:1) (t:adv) (f:everyday) (w:hastily/in a rush) (d:placed after a verb: do it at once and eagerly, without waiting or thinking, as someone who fears to lose something) (r:zd:12541/zd:20581) (q:draft, low confidence)
daidam = (i:1) (t:adj) (f:nature/time) (w:cold/chilly) (d:cold and still, said of the winter season in {phalbi daidam}, the cold of winter) (r:zd:17215/zd:22962) (q:draft, low confidence)
daidide = (i:1) (t:v) (f:everyday) (j:dai dide) (r:zd:25908/zd:15082) (q:draft)
daih = (i:2) (t:v) (f:everyday) (w:last/be enough/go far) (d:be enough for a need or hold out for a length of time, mostly negated as {daih lo} or {daih zo lo}; said of time, money or a state, not of noise) (r:zd:25915/zd:11163/zd:23893) (q:draft)
daihlaih = (i:1) (t:v) (f:health/home) (w:get an electric shock/be electrocuted) (d:be struck by an electric current; {daihlaih in si} is die of an electric shock) (o:Burmese, dat laik) (r:zd:14856/zd:14662) (q:draft)
dailen = (i:1) (t:v) (f:body/health) (w:go to the toilet/relieve oneself/defecate) (d:polite word for emptying the bowels; {dailen buk} is a toilet) (r:zd:25478/zd:23727) (q:draft)
dailenbuk = (i:1) (t:n) (f:home/body) (w:toilet/restroom/lavatory) (d:a toilet, the room or the seat; a polite word, from <dailen>, relieve oneself, and <buk>, hut) (s:ekbuk) (r:zd:12337/zd:12181/zd:17301) (q:draft)
dailengbuk = (i:1) (t:n) (f:home/body) (j:dailenbuk) (r:zd:13288/zd:17694) (q:draft)
dailengding = (i:1) (t:v) (f:body/everyday) (w:to relieve oneself/to go to the toilet) (d:{daileng}, go out to relieve oneself, with <ding> written as one word, mostly followed by <in>: in order to go to the toilet) (r:zd:16617/zd:21793) (q:draft)
daipam = (i:1) (t:n) (f:social) (w:the lowly/the destitute/outcast) (d:a person of the lowest standing who lives at the margin of the community, named together with the poor, widows and orphans, as in {mizawng daipam}; apparently from the edge outside the village fence) (r:zd:14552/zd:13354) (q:draft, low confidence)
daipamte = (i:1) (t:n) (f:social) (w:the lowly/the marginalised/the needy) (d:people at the edge of society, with the plural <te>; named after <mizawng>, the poor, or <meigong>, widows, as in {mizawng daipamte}, the poor and lowly) (r:zd:21978/zd:21761) (q:draft)
daitansakna = (i:1) (t:n) (f:religion/social) (w:committal service/burial service) (d:a part of a funeral named beside or in place of <vuina>, burial, held at the cemetery; it seems to be the service by which the dead is laid to rest) (r:zd:11080/zd:24029) (q:draft, low confidence)
Dakdung = (i:1) (t:name) (c:place) (f:travel) (w:Dakdung) (d:a place name of the Tedim area, used of a village and of a town quarter; {Dakdung mi} is a person from Dakdung) (r:zd:22136) (q:draft, low confidence)
Dakota = (i:1) (t:name) (c:land) (f:travel) (w:Dakota) (d:in {South Dakota} and {North Dakota}, two states of the United States) (r:zd:25189/zd:20334) (q:draft)
dal = (i:4) (t:v) (f:everyday/health) (w:prevent/block/hinder/stop) (d:stand in the way of a person or of a thing that is coming and keep it from going on, as in {natna dal}, prevent a disease; here what is named before {dal} is the one stopped, not the one protected) (r:zd:24253/zd:24918/zd:23659) (q:draft)
dalan = (i:1) (t:n) (f:politics) (w:informer/spy) (d:a person who secretly passes information to the army or the authorities; explained in the articles as {thupuak sim}) (o:Burmese) (r:zd:25357/zd:25314) (q:draft)
Dalkhai = (i:1) (t:name) (c:khua) (f:travel) (w:Dalkhai) (d:village in the Tonzang area of Chin State, near the border with India) (r:zd:15743/zd:19516) (q:draft)
dalkhat = (i:1) (t:phrase) (f:everyday/work) (w:one sheet/one note) (d:<dal>, counting word for flat things, and <khat>, one, written as one word: one sheet of paper or one banknote) (j:dal/khat) (r:zd:20287/zd:20911) (q:draft)
dalkhol = (i:1) (t:v) (f:health/everyday) (w:prevent/ward off in advance) (d:<dal>, shield, with <khol>, beforehand: keep something bad, such as illness or damage, from happening by acting before it comes) (b:dal) (r:zd:22364/zd:12121) (q:draft)
dalkholhna = (i:1) (t:n) (f:health/everyday) (w:precaution/prevention) (d:<dal> and <kholhna> written as one word: a guarding against harm beforehand; mostly {ki dalkholhna}, and {dalkholhna in} is as a precaution) (j:dal/kholhna) (r:zd:16061/zd:19927) (q:draft)
Dallas = (i:1) (t:name) (c:city) (f:travel) (w:Dallas) (d:city in the state of Texas in the United States, where a Zomi community lives) (r:zd:11899/zd:19271) (q:draft)
dalna = (i:2) (t:n) (f:health/everyday) (w:prevention/protection/defence) (d:the act of keeping something harmful off, not a thing that screens: <natna dalna> is the prevention of disease, <dalna zatui> a vaccine, and {thautang dalna} bulletproof) (s:kidalna) (r:zd:24918/zd:20640/zd:25191) (q:draft)
dalna zatui = (i:1) (t:n) (f:health) (w:vaccine/vaccination) (d:<dalna>, barrier or prevention, and <zatui>, medicine: medicine that prevents a disease; in full {natna dalna zatui}, and to give it by injection is {dalna zatui sut}) (r:zd:24918/zd:24276) (q:draft)
dalnih = (i:1) (t:phrase) (f:everyday) (w:two sheets/two layers/two slices) (d:<dal.3>, the counting word for flat things, and <nih> written as one word: two sheets, layers or slices) (j:dal/nih) (r:zd:21633/zd:19423) (q:draft)
dalzo = (i:1) (t:v) (f:health/everyday) (w:be able to prevent/ward off/hold back) (d:<dal>, shield or block, and <zo>, manage to, written as one word: be able to keep off a danger such as illness, storm or fire) (j:dal/zo) (r:zd:19915/zd:21119) (q:draft)
dam = (i:1) (t:v) (f:health/everyday) (w:be well/be healed/recover) (d:be in good health or get well again; of a sickness, wound or sorrow, heal; {na dam hiam}, are you well, is a greeting) (a:nat) (r:24.8.18) (q:draft)
dam = (i:3) (t:adj) (f:nature) (w:cold/cool) (d:of the weather, with <khua>: {khua dam} is it is cold, as in <khuadam>; not the sense of health) (r:zd:25454) (q:draft, low confidence)
damaih = (i:1) (t:n) (f:social) (w:robbery/robber) (d:robbery with force or a weapon, and also the robber; {damaih taih} is to rob someone and {damaih te} are robbers) (o:Burmese) (r:zd:19237/zd:11410) (q:draft)
Damansara = (i:1) (t:name) (c:place) (f:travel) (w:Damansara) (d:an area near Kuala Lumpur in Malaysia where Zomi live; {Kota Damansara} is one part of it) (r:zd:21282) (q:draft)
Damascus = (i:1) (t:name) (c:city) (f:politics/religion) (j:Damaskas) (r:zd:21027/zd:10890) (q:draft)
damdam = (i:2) (t:adv) (f:everyday) (w:slowly/gradually/gently) (d:before <in> or <a>, at a slow pace or little by little, as {damdam in pai}, go slowly; the same word as <damdamin> written apart, and not the rumbling of sense 1) (s:damdamin) (r:zd:22775/zd:14824/zd:22658) (q:draft)
damdawi = (i:1) (t:n) (f:health) (w:cure/remedy) (d:what heals a sickness or a trouble, its remedy; from <dam>, be healed) (r:zd:12436/zd:25670) (q:draft, low confidence)
damiah = (i:1) (t:n) (f:social/politics) (w:robber/armed robber/robbery) (d:a person who robs by force or threat, and the robbery itself; often paired with <guta>, thief, and {damiah taih} is to commit a robbery) (o:Burmese) (r:zd:15056/zd:19320/zd:17030) (q:draft)
damiah ataih = (i:1) (t:v) (f:social/politics) (w:rob/commit robbery/hold up) (d:<damiah>, robbery, and <ataih>, hit, the form of <taih> with <a>: commit a robbery, hold someone up; the place or the victim stands before it, and before a noun it means who robbed) (r:zd:14917/zd:20191) (q:draft)
damiah kitaih = (i:1) (t:v) (f:social/media) (w:be robbed/be held up) (d:<damiah>, robber, and <kitaih.2>, from Burmese: an armed robbery takes place; the place or person robbed stands before it, and with a plural subject it means to carry out a robbery) (r:zd:15913/zd:12063) (q:draft)
damiah lut = (i:1) (t:v) (f:social/media) (w:be robbed/robbers break in/armed robbery) (d:<damiah>, robber, as the subject of <lut>, enter: robbers break into a place, a robbery takes place there; the place stands before it, with <ah> or without a marker, as in {Bank khat damiah lut}, a bank is robbed) (r:zd:17661/zd:17260/zd:11868) (q:draft)
damiah lutin = (i:1) (t:v) (f:social/politics) (w:rob/hold up/break in and rob) (d:<damiah>, robber, and <lutin>, entering: robbers break into a place and rob it; in news headlines it stands after the place with <ah> or <sungah> and before what was taken) (r:zd:11352/zd:15084) (q:draft)
damiah taihin = (i:1) (t:v) (f:politics) (w:commit robbery/rob/hold up) (d:<damiah>, robber, and <taihin>, from the Burmese expression for committing robbery: robbing by force; the place or person robbed stands before it and the main verb of the sentence follows) (r:zd:11130/zd:15178) (q:draft)
damiahpa = (i:1) (t:n) (f:politics/social) (w:robber/armed robber) (d:<damiah>, robber or robbery, with <pa>, the man who: a man who robs by force) (o:Burmese) (r:zd:20522/zd:17260) (q:draft)
damkim = (i:1) (t:v) (f:health/everyday) (w:all be well/be wholly well) (d:<dam> and <kim>, all or fully, written as one word: all are in good health, or well in every part; used in greetings and wishes) (j:dam/kim) (r:zd:19168/zd:20102) (q:draft)
damlo = (i:1) (t:adj) (f:health) (w:sick/ill/unwell) (d:<dam> and <lo> written as one word: not well, sick; {damlo te} are the sick, patients) (s:cina) (j:dam/lo) (r:zd:23528/zd:23538/zd:19846) (q:draft)
damloh = (i:1) (t:v) (f:health) (w:be unwell/be sick/be ill) (d:<dam> and <loh> written as one word: not be well, the form of {dam lo} used before words such as <hun>, <lai> and <ciangin>; {damloh hun} is a time of sickness) (j:dam/loh) (r:zd:12292/zd:20162/zd:22469) (q:draft)
damlohna = (i:1) (t:n) (f:health) (w:illness/sickness/ill health) (d:<dam> and <lohna> written as one word: the state of not being well, an illness or disorder) (s:natna) (j:dam/lohna) (r:zd:23799/zd:23266) (q:draft)
damlote = (i:1) (t:n) (f:health) (w:the sick/patients/sick people) (d:<damlo>, sick, with the plural <te>: those who are sick, patients; {lungsim damlote} are the mentally ill) (b:damlo) (r:zd:11206/zd:22928/zd:10743) (q:draft)
dammahmah = (i:1) (t:v) (f:everyday/health) (w:be very glad/be very well) (d:<dam> with <mahmah>, very, written as one word: after <lung>, heart, as in {kalung dammahmah}, I am very glad or thankful; of the body, be in very good health) (j:dam/mahmah) (r:zd:19619/zd:16676) (q:draft)
Dammaw = (i:1) (t:intj) (f:everyday/social) (w:hello/how are you) (d:<dam>, be well, and the question word <maw>, written as one word: are you well, the usual Zolai greeting) (j:dam/maw) (r:zd:16031/zd:12196) (q:draft)
dammawh = (i:1) (t:adj) (f:health) (w:sick/ill/unwell) (d:not well, from <dam>, be well; also the sick and sickness, as in {dammawh puakna motor}, a vehicle that carries the sick, an ambulance) (r:zd:11648/zd:15748) (q:draft, low confidence)
dammawhna = (i:1) (t:n) (f:health) (w:sickness/ill health/illness) (d:<dammawh>, sick, with the noun ending <na>: the state of being unwell) (s:cidamlohna/natna) (b:dammawh) (r:zd:12112/zd:11648) (q:draft)
Dampi = (i:1) (t:name) (c:khua) (f:travel) (w:Dampi) (d:a Zomi village, written {Dampi khua} in the articles) (r:zd:14751) (q:draft, low confidence)
dampih = (i:1) (t:v) (f:family/health) (w:still be alive with/live on with) (d:<dam>, be well, and <pih>, together with, written as one word: remain alive and well with others; with <hong> said of parents or elders who are still living among their family) (j:dam/pih) (r:zd:24119/zd:14910) (q:draft)
damsung = (i:1) (t:n) (f:time) (w:lifetime/whole life) (d:<dam>, be well and so be alive, and <sung>, during, written as one word: the time that one lives, as long as one lives) (j:dam/sung) (r:zd:20716/zd:24636) (q:draft)
damtui = (i:1) (t:n) (f:social) (w:water of well-being/healing water) (d:<dam>, be well, with <tui>, water; a word of songs and fine speech: {nunnop damtui luang} is that a good life flows like water) (r:zd:16588) (q:draft, low confidence)
dan siam = (i:1) (t:v) (f:everyday/education) (w:know how to/be good at) (d:<dan>, way, and <siam>, skilled: after a verb, know the way to do it, be good at doing it, as in {lai-at dan siam}, be good at writing; {dan siam kei} is not know how to) (r:zd:21626/zd:21340/zd:18952) (q:draft)
dana = (i:1) (t:adv) (f:everyday) (w:as if/like/in the manner of) (d:<dan>, manner, with the ending <a>, written as one word and placed after a verb or noun: in the way of, as though) (j:dan/a) (r:zd:20172/zd:20060/zd:11135) (q:draft)
dandan = (i:2) (t:adv) (f:everyday) (w:just as/according to/however) (d:<dan>, manner, doubled: in whatever way, exactly in keeping with what the verb before it says, as in {amau ut dandan in}, just as they please, and {ngaihsut dandan}, just as one thinks; not the trail of something that passes) (s:bangbang) (r:zd:23896/zd:20403/zd:12341) (q:draft)
dandanin = (i:1) (t:adv) (f:everyday) (w:just as/according to/in whatever way) (d:<dan>, manner, said twice with <in>: after a verb, just in the way that, exactly according to; {i ut dandanin} is just as we please; compare <danin>) (b:dan) (r:zd:9433/zd:24236/zd:15697) (q:draft)
danding = (i:1) (t:n) (f:everyday) (w:way to/how to) (d:<dan>, way, and <ding> written as one word after a verb: the way something is to be done, how to do it; common in headings) (j:dan/ding) (r:zd:25923/zd:25180/zd:25924) (q:draft)
dangdang = (i:3) (t:adj) (f:everyday) (w:other/various other) (d:<dang> other said twice for several things, placed after a noun, often with <te> after it, or as {a dangdang}, the others: the other ones, not the one spoken of) (s:dang) (r:zd:12264/zd:20586/zd:20534) (q:draft)
dangin = (i:2) (t:adv) (f:everyday) (w:in another/in other/otherwise) (d:<dang>, other, with {-in} after a noun other than <ni>: by another one or in another one, as {kammal dangin}, in other words, and {a lam dangin}, in another way) (r:zd:23432/zd:19968/zd:12925) (q:draft)
dangkhat = (i:1) (t:adj) (f:everyday) (w:another/a different one) (d:<dang>, other, and <khat>, one, written as one word after a noun: another; {a dangkhat} is the other one) (j:dang/khat) (r:zd:23394/zd:21796/zd:23943) (q:draft)
dangnal = (i:1) (t:adj) (f:social) (w:eloquent/fluent/smooth-tongued) (d:fluent and ready in speech, said of a person who speaks well and boldly before others) (r:zd:16897) (q:draft)
dangtaak = (i:1) (t:adj) (f:everyday/food/body) (j:dangtak) (r:zd:22643/zd:22650) (q:draft)
dangtak = (i:1) (t:adj) (f:everyday/food/body) (w:thirsty) (d:be thirsty, often paired with <gilkial>, hungry; also thirst) (s:tuiduh/duh) (r:20.25.25) (q:draft)
dangtawh = (i:1) (t:phrase) (f:everyday) (w:with another/with other) (d:<dang>, other, and <tawh>, with, written as one word after a noun: with another one, with other ones) (j:dang/tawh) (r:zd:24276/zd:17618) (q:draft)
dangten = (i:1) (t:pron) (f:everyday) (w:others/the others) (d:<dangte>, others, with the subject marker <in> written as one word, short for {dangte in}: the others, as the ones who act) (j:dangte/in) (r:zd:22065/zd:24035) (q:draft)
Dangwangi = (i:1) (t:name) (c:place) (f:politics/travel) (w:Dang Wangi) (d:Dang Wangi, a district of Kuala Lumpur in Malaysia with a police station and lockup, named in notices about Zomi who are detained there) (r:zd:16799/zd:22825) (q:draft)
Danial = (i:1) (t:name) (f:religion) (j:Daniel) (r:zd:23386/zd:23286) (q:draft)
dankhat = (i:1) (t:phrase) (f:everyday) (w:a kind of/as if) (d:<dan>, way, and <khat>, one, written as one word: a sort of, something like; with <in>, as if, in the manner of) (j:dan/khat) (r:zd:22782/zd:11945) (q:draft)
danmah = (i:1) (t:adv) (f:everyday) (w:just like/in the very way) (d:<dan>, manner, with the emphatic <mah>, written as one word and followed by <in>: in just the way, exactly like; {kei danmah in} is just like me) (j:dan/mah) (r:zd:19205/zd:24124) (q:draft)
dann = (i:1) (t:n) (f:politics/education) (w:punishment/penalty) (d:what is laid on someone for a wrong, by a court or a school; {dann tuak} is be punished and {dann pia} is punish) (s:gawtna) (o:Burmese) (r:zd:23616/zd:19318) (q:draft)
danpiakna = (i:1) (t:n) (f:social/politics) (w:punishment/penalty) (d:<dan>, here punishment, with <piakna>, giving: the giving of a punishment, a penalty) (r:zd:11553/zd:19108) (q:draft)
Dashcam = (i:1) (t:n) (f:it/travel) (w:dashcam/dashboard camera) (d:video camera fitted in a vehicle that records the road) (o:English) (r:zd:19530/zd:12982/zd:18116) (q:draft)
dat = (i:1) (t:n) (f:health/food/nature) (w:substance/element/nutrient) (d:a substance that something contains, placed after its name: {Potassium dat} is potassium and {Vitamin C dat} is vitamin C; also a chemical, and in {dat-line} electric power) (o:Burmese, dat) (r:zd:20004/zd:21168/zd:22499) (q:draft)
data = (i:1) (t:n) (f:it/education) (w:data/information/figures) (d:collected facts and figures, also the internet data of a mobile phone) (o:English) (r:zd:22802/zd:24321/zd:17607) (q:draft)
datdat = (i:1) (t:adv) (f:everyday) (w:one after another/in a stream/steadily) (d:placed after a verb: the action goes on in an unbroken row, one after another, said of tears that fall drop after drop and of people who follow each other) (r:zd:23240/zd:12928/zd:17939) (q:draft, low confidence)
datlaih = (i:1) (t:v) (f:health/home) (w:be electrocuted/get an electric shock) (d:be struck by electric current; also as a noun, electric shock or electrocution) (o:Burmese, dat laik) (r:zd:16249/zd:11362) (q:draft)
datmei = (i:1) (t:n) (f:home/everyday) (w:torch/flashlight) (d:a hand lamp that works with batteries; {datmei de} is shine a torch) (o:Burmese, dat mi) (r:zd:15996/zd:11924/zd:17428) (q:draft)
datsa = (i:1) (t:n) (f:health/food) (w:mineral salt/mineral/electrolyte) (d:the salts and minerals that the body needs and that come from rock and water; {datsa tui} is a drink of rehydration salts) (o:Burmese) (r:zd:25148/zd:23729) (q:draft, low confidence)
datsi = (i:1) (t:n) (f:travel/work) (w:petrol/gasoline/fuel) (d:fuel for motor vehicles; {datsi sai} is a filling station) (o:Burmese) (r:zd:20668/zd:18943) (q:draft)
Datsian = (i:1) (t:n) (f:media) (w:film/movie/cinema) (d:a moving picture, and the film business; {datsian zung} is a cinema, the hall where films are shown) (o:Burmese) (r:zd:25589) (q:draft)
datsisai = (i:1) (t:n) (f:travel/work) (w:petrol station/filling station) (d:a place where fuel for vehicles is sold, from Burmese <datsi>, petrol, and <sai>, shop) (o:Burmese) (r:zd:15366/zd:16826) (q:draft)
datsithawl = (i:1) (t:n) (f:home/travel) (w:petrol bottle/bottle of petrol) (d:<datsi>, petrol, and <thawl>, bottle, written as one word: a bottle filled with petrol) (j:datsi/thawl) (r:zd:15029) (q:draft)
Datuk = (i:1) (t:n) (f:social/politics) (w:Datuk) (d:Malaysian title of honour, placed before the name of the man who holds it) (o:Malay) (r:zd:16205/zd:17605) (q:draft)
daudau = (i:1) (t:adv) (f:everyday) (w:one after another/in a steady stream/on and on) (d:placed after a verb: the action goes on steadily or things come one after another without a break, as thoughts that keep rising or words read straight through) (r:zd:22595/zd:25773) (q:draft, low confidence)
Davao = (i:1) (t:name) (c:city) (f:travel/politics) (w:Davao/Davao City) (d:the largest city of the southern Philippines) (r:zd:16952) (q:draft)
Davuih = (i:1) (t:name) (c:male) (f:religion) (j:David) (r:zd:23138) (q:draft)
Daw = (i:1) (t:n) (f:social) (w:Mrs/Madam/Ms) (d:Burmese title of respect placed before the name of a grown woman) (o:Burmese) (r:zd:15122/zd:20627) (q:draft)
Dawei = (i:1) (t:name) (c:city) (f:travel) (w:Dawei) (d:city in the far south of Myanmar, capital of Tanintharyi Region; also the people of that area) (r:zd:14726/zd:12888) (q:draft)
dawinupi = (i:1) (t:n) (f:social) (w:she-devil/wicked woman) (d:<dawi>, demon, and <nupi>, woman, written as one word: a demon woman, said in news reports of a woman who has done something cruel) (j:dawi/nupi) (r:zd:15994) (q:draft, low confidence)
dawl = (i:2) (t:n) (f:home) (w:floor) (d:a floor or storey of a building)
dawl = (i:4) (t:n) (f:everyday/politics) (w:stage/level/phase/tier) (d:a step or rank in a process or an order, not in a building: a stage of a plan or of a trial, as {dawl masa}, the first stage, or a level of government, as {gambup dawl}, the national level) (r:zd:21803/zd:25078/zd:24417) (q:draft)
dawldawl = (i:1) (t:adv) (f:everyday/social) (w:level by level/in stages/step by step) (d:<dawl>, level, said twice: at each level, one level after another; usually {a dawldawl in}) (b:dawl) (r:zd:22910/zd:25790) (q:draft)
dawlnih = (i:1) (t:adj) (f:home/travel) (w:two-storey/double-decker) (d:<dawl> and <nih> written as one word: with two floors, said of a house or a bus; {dawlnih a pha} is that has two storeys) (j:dawl/nih) (r:zd:17677/zd:24029/zd:19445) (q:draft)
dawlnihna = (i:1) (t:n) (f:home) (w:second floor/second storey) (d:<dawl>, floor, and <nihna>, second, written as one word) (j:dawl/nihna) (r:zd:20425/zd:17164) (q:draft)
dawm = (i:2) (t:v) (f:everyday/health) (w:be careful/take care/be sparing with) (d:after <ki>, written as two words for <kidawm>: watch oneself, take care, and with a thing named before it be careful or sparing with it, as in {zu leh za ki dawm}, be careful with drink and tobacco) (s:kidawm) (r:zd:24276/zd:24742/zd:19525) (q:draft)
dawn = (i:2) (t:v) (f:social/everyday) (w:meet/welcome/go to meet) (d:go out to meet someone who is coming) (s:dawntuah/kimu) (q:draft)
dawn = (i:1) (t:v) (f:everyday/food) (w:drink) (d:take a drink; {tui dawn} is to drink water and {zu dawn} to drink wine or beer) (q:draft)
dawn = (i:4) (t:v) (f:everyday/media) (w:answer/reply/respond) (d:give an answer, the form of <dawng> used before <kik>, back: {dawn kik} is answer back, and {dawn kikna} is a reply) (r:ts:5635/zd:22652/zd:13217) (q:draft)
dawnbang = (i:1) (t:phrase) (f:social) (d:word of songs and elevated speech used before <tuah>, meet: {dawnbang tuah} is to meet one another or come together again; its own sense apart from that phrase is not clear) (r:zd:11110/zd:14507) (q:draft, low confidence)
dawndan = (i:1) (t:n) (f:everyday/social) (w:way of answering/answer/response) (d:<dawn>, here the form of <dawng>, answer, with <dan>, manner, written as one word: the way in which someone answers a question or responds) (j:dawn/dan) (r:zd:9447/zd:12196) (q:draft)
dawnding = (i:1) (t:adj) (f:food) (w:for drinking/to drink) (d:<dawn>, drink, and <ding> written as one word: that is to be drunk, for drinking; {dawnding tui} is drinking water, and beside <nekding> it means things to eat and to drink) (j:dawn/ding) (r:zd:12042/zd:17120/zd:17575) (q:draft)
dawng = (i:1) (t:v) (f:everyday) (w:answer/reply) (d:give an answer to a person or to a question) (s:dawngkik) (a:dong/dot) (r:24.21.3) (q:draft)
dawnga = (i:1) (t:v) (f:everyday) (w:answer/reply) (d:<dawng>, answer, with the linking <a> written as one word: answered and) (j:dawng/a) (r:zd:9219/zd:17391) (q:draft)
dawnglo = (i:1) (t:v) (f:everyday) (w:not answer/not reply) (d:<dawng> and <lo> written as one word: does not answer) (j:dawng/lo) (r:zd:22159/zd:19805) (q:draft)
dawnlo = (i:1) (t:v) (f:food/everyday) (w:not drink) (d:<dawn>, drink, and <lo>, not, written as one word) (j:dawn/lo) (r:zd:24036/zd:22019/zd:19749) (q:draft)
dawnloh = (i:1) (t:v) (f:food/health) (w:not drink/not drinking) (d:<dawn>, drink, and <loh>, not, written as one word: not drinking, the form used before a following word, as in {zu dawnloh}, not drinking alcohol) (j:dawn/loh) (r:zd:9423/zd:24276) (q:draft)
dawnna = (i:3) (t:n) (f:everyday/education) (w:answer/reply/response) (d:what is said or written in reply, from <dawng>, answer; paired with <dotna>, question, as {dotna leh dawnna}, questions and answers; not drinking and not a meeting) (r:zd:25111/zd:24966/zd:20160) (q:draft)
dawntheih = (i:1) (t:n) (f:food) (w:drink/beverage) (d:<dawn>, drink, and <theih>, can, written as one word: something that can be drunk, a drink; often paired with <nektheih>, food) (j:dawn/theih) (r:zd:16776/zd:17897) (q:draft)
dawp = (i:1) (t:v) (f:social/work) (w:contact/inquire/approach) (d:get in touch with a person or an office about a matter, to ask or to report; {vai dawp} is bring a matter to an office) (r:zd:23538/zd:24119/zd:23543) (q:draft)
dawptheih = (i:1) (t:v) (f:work/social) (w:can contact/can inquire) (d:<dawp>, contact or inquire, with <theih>, be able, written as one word; {dawptheih ni} is the days on which an office may be approached) (j:dawp/theih) (r:zd:10892) (q:draft, low confidence)
dawtgawp = (i:1) (t:v) (f:media) (w:stab repeatedly/stab severely) (d:<dawt>, stab, with <gawp>, severely, written as one word: stab again and again or stab badly) (j:dawt/gawp) (r:zd:15531/zd:21030) (q:draft)
dawtkha = (i:1) (t:v) (f:health/everyday) (w:pierce/prick/stab) (d:<dawt>, pierce, with <kha>, happen to: of a sharp thing, come to pierce or prick a part of the body, often by accident) (j:dawt/kha) (r:zd:21954/zd:17085) (q:draft)
dawtliam = (i:1) (t:v) (f:media/health) (w:stab and wound/wound by stabbing) (d:<dawt> and <liam> written as one word: stab a person so that he is wounded, beside <dawtlum>, stab to death) (j:dawt/liam) (r:zd:15537/zd:17641) (q:draft)
dawtliamgawp = (i:1) (t:v) (f:health/media) (w:stab and wound badly/stab severely) (d:<dawt>, stab, and <liamgawp>, be badly wounded, written as one word: stab someone so that he is badly wounded) (j:dawt/liamgawp) (r:zd:20472) (q:draft)
dawtlum = (i:1) (t:v) (f:politics/media) (w:stab to death) (d:<dawt>, stab, with <lum>: stab a person so that he dies) (b:dawt) (r:zd:15537/zd:21352) (q:draft)
dawtlup = (i:1) (t:v) (f:media) (w:stab/stab down) (d:<dawt>, stab, with <lup>, lie down: stab a person so that the person falls; {dawtlup thuak} is be stabbed) (r:zd:11814) (q:draft, low confidence)
dawtsak = (i:1) (t:v) (f:body/everyday) (w:stab) (d:<dawt>, stab, with <sak> written as one word: stab a person in a named part of the body with a knife) (j:dawt/sak) (r:zd:18244/zd:20055) (q:draft)
Deacon = (i:1) (t:n) (f:religion) (w:deacon) (d:a church officer who serves under the pastor and elders; also written without a capital) (o:English) (r:ts:1180/zd:25674) (q:draft)
Deadline = (i:1) (t:n) (f:time/work) (w:deadline/closing date) (d:the last day on which something can be handed in or applied for) (o:English) (r:zd:13186/zd:17651) (q:draft)
dear = (i:1) (t:adj) (f:social) (w:dear) (d:opening word of a letter or address, placed before those who are addressed) (o:English) (r:zd:11549) (q:draft, low confidence)
debate = (i:1) (t:n) (f:politics/social) (w:debate) (d:a formal argument of a question between two sides, as in a parliament; {debate bawl} is hold a debate) (o:English) (r:zd:25062/zd:24800/zd:24831) (q:draft)
dee = (i:1) (t:v) (f:everyday/home) (w:light/kindle) (d:light a torch so that it burns, written also <de>, as in <de-in>; {meilah dee-in tawi} is carry a lighted torch) (r:zd:15996) (q:draft, low confidence)
deep = (i:1) (t:v) (f:social) (w:engulf/swallow up/overwhelm) (d:spread over and take in completely, as a stronger people, language or culture does to a weaker one; a Zolai word, not the English word deep, which occurs in the articles only inside English phrases) (r:zd:23893/zd:11367) (q:draft, low confidence)
Deepavali = (i:1) (t:name) (f:religion) (w:Deepavali/Diwali) (d:Hindu festival of lights, a public holiday in Malaysia; {Deepavali pawi} is the Deepavali festival) (r:zd:15884/zd:17062) (q:draft)
deficit = (i:1) (t:n) (f:work/politics) (w:deficit/shortfall) (d:the amount by which spending is greater than income, or imports greater than exports; set against <sumval>, surplus) (o:English) (r:zd:23904/zd:11005) (q:draft, low confidence)
definition = (i:1) (t:n) (f:education) (w:definition) (d:statement of what a word or idea means; the English word, used mostly beside <khiatna>) (s:khiatna) (o:English) (r:zd:21690/zd:15047) (q:draft, low confidence)
degree = (i:1) (t:n) (f:education) (w:degree/academic degree) (d:a title given by a university or college to a person who completes a course of study; {degree ngah} is get a degree) (o:English) (r:zd:20979/zd:23551) (q:draft)
degree = (i:2) (t:n) (f:nature) (w:degree) (d:a unit for measuring temperature, as in {degree Celsius}) (o:English) (r:zd:23896/zd:25115) (q:draft)
dei = (i:1) (t:n) (f:home) (w:room/chamber) (d:a room of a house or building; {dei tungnung} is an upstairs room) (s:inndei/adei) (r:44.20.8)
deidanlo = (i:1) (t:adv) (f:social) (w:without discrimination/impartially/without favouritism) (d:<deidan>, show favouritism, and <lo>, not, written as one word, mostly before <in>: without treating one differently from another) (j:deidan/lo) (r:zd:23935/zd:11057/zd:24220) (q:draft)
deih = (i:2) (t:v) (f:everyday) (w:want/desire/wish) (d:wish to have something or wish that something happens; the thing or clause wanted comes before it) (s:lunggulh)
deih = (i:1) (t:v) (f:everyday) (w:like/love) (d:be fond of or take pleasure in someone or something) (s:lunggulh) (a:mudah/hua)
deihbang = (i:1) (t:adv) (f:everyday) (w:as one wishes/according to the will of) (d:<deih>, want, and <bang>, like, written as one word, placed after the one who wants: in the way that person wishes) (j:deih/bang) (r:zd:20410/zd:20484/zd:25126) (q:draft)
deihbangin = (i:1) (t:adv) (f:everyday) (w:as one wishes/as desired) (d:<deih>, want, with <bangin>, according to, written as one word: the way someone wants it; {ka deihbangin} is as I wish) (j:deih/bangin) (r:zd:20892/zd:19577/zd:21989) (q:draft)
deihbawl = (i:1) (t:v) (f:social/everyday) (w:wish/wish well/favour) (d:<deih>, want, with <bawl>: wish that something may be so for someone, as in greetings, or be well disposed to someone) (s:deihsak) (r:zd:16813/zd:15187) (q:draft)
deihdan = (i:1) (t:n) (f:everyday/social) (w:wish/preference/will/taste) (d:<deih> and <dan> written as one word: the way someone wants a thing to be, what one wishes or prefers; {Pasian deihdan} is the will of God) (j:deih/dan) (r:zd:25923/zd:24217/zd:23655) (q:draft)
deihkaih = (i:1) (t:v) (f:social) (w:be biased/slant/take one's own way) (d:<deih>, want, with <kaih>, pull: draw a matter toward what one wants, take or tell it in a one-sided way; in {deihkaih ing} a writer says what he wishes and urges) (r:zd:15859/zd:25569) (q:draft, low confidence)
deihkaihna = (i:1) (t:n) (f:social) (w:bias/partiality/self-will) (d:<deihkaih> with the noun suffix {-na}: pulling a matter toward what one wants, bias or one's own will) (b:deihkaih) (r:zd:24804/zd:25567) (q:draft)
deihkei = (i:1) (t:v) (f:everyday) (w:not want/dislike/refuse) (d:<deih>, want, and the negative <kei>, written as one word: do not want) (s:deihlo) (j:deih/kei) (r:zd:23479/zd:19257) (q:draft)
deihkhat = (i:1) (t:n) (f:everyday) (w:something wanted/what one wants) (d:<deih> and <khat> written as one word: a thing that one wants; {na deihkhat} is what you want) (j:deih/khat) (r:zd:19983/zd:23706) (q:draft)
deihleh = (i:1) (t:v) (f:everyday) (w:if one wants/if you want) (d:<deih> and <leh> written as one word: if someone wants or wishes for something) (j:deih/leh) (r:zd:21044/zd:13340) (q:draft)
deihlo = (i:1) (t:v) (f:everyday) (w:not want/dislike/reject) (d:<deih> and <lo> written as one word: not want, not like) (j:deih/lo) (r:zd:24064/zd:26700) (q:draft)
deihloh = (i:1) (t:adj) (f:everyday) (w:unwanted/not wanted/disliked) (d:<deih> and <loh> written as one word: not wanting, or what someone does not want; {a deihloh thu} is a thing he does not want, and {deihloh pen in} introduces something one hopes will not happen) (j:deih/loh) (r:zd:24751/zd:20410/zd:20646) (q:draft)
deihlohna = (i:2) (t:n) (f:politics/social) (w:opposition/rejection/disapproval) (d:the attitude of not wanting a person, a government or an act, which is named just before {deihlohna}; with <lungphona> it is a protest against that person or thing) (r:zd:19662/ts:6531/zd:20315) (q:draft)
deihlohpen = (i:1) (t:n) (f:everyday) (w:worst case/the thing least wanted) (d:<deih>, want, <loh>, not, and <pen>, here most, written as one word: what is wanted least; {deihlohpen in} opens a clause about something bad that may happen, if the worst comes) (j:deih/loh/pen) (r:zd:13030/zd:25516) (q:draft)
deihlohte = (i:1) (t:n) (f:everyday) (w:unwanted things/those who do not want) (d:<deihloh> and the plural <te> written as one word: the things one does not want, or the people who do not want someone) (b:deihloh) (j:deihloh/te) (r:zd:24072/zd:24064/zd:25110) (q:draft)
deihlote = (i:1) (t:n) (f:social/politics) (w:those who do not want/opponents) (d:<deihlo>, not want, with the plural <te>: the people who do not want or do not like someone or something) (b:deihlo) (r:zd:25110/zd:24059) (q:draft)
deihmahmah = (i:1) (t:v) (f:everyday) (w:want very much/like very much/be very fond of) (d:<deih>, want or like, with <mahmah>, very, written as one word) (j:deih/mahmah) (r:zd:10901/zd:21074) (q:draft)
deihna bangin = (i:1) (t:prep) (f:everyday) (w:according to the will of/as one wishes/as desired) (d:<deihna>, wish or will, and <bangin>, like or accordingly: placed after the person whose wish it is, in the way that person wants) (r:zd:22861/zd:23792/zd:20525) (q:draft)
deihna bulpi = (i:1) (t:n) (f:everyday/social) (w:main aim/chief purpose/basic intention) (d:<deihna>, wish or purpose, and <bulpi>, base or main: the main purpose or underlying aim of a person, a group or an action; a possessor stands before it, as in {a deihna bulpi}) (r:zd:21063/zd:12688/zd:23298) (q:draft)
deihnawnlo = (i:1) (t:v) (f:everyday/social) (w:no longer want/not want any more) (d:<deih> and <nawnlo> written as one word: not want someone or something any longer) (j:deih/nawnlo) (r:zd:17372/zd:11477) (q:draft)
deihpen = (i:1) (t:adj) (f:everyday) (w:favourite/most wanted/most liked) (d:<deih>, like or want, with <pen>, most: what someone likes or wants most) (b:deih) (r:zd:9215/zd:25016/zd:9432) (q:draft)
deihsaklo = (i:1) (t:v) (f:social) (w:not wish well/not care for/begrudge) (d:<deihsak> and <lo> written as one word: not want good for someone, not care for) (j:deihsak/lo) (r:zd:17285/zd:17264) (q:draft)
deihsakna lianpi = (i:1) (t:phrase) (f:social) (w:best wishes/kind regards) (d:<deihsakna>, goodwill, and <lianpi>, great: with <tawh>, with, it is the closing formula of a letter or notice, {deihsakna lianpi tawh}, with great goodwill, followed by the name of the writer) (r:zd:24131/zd:25019) (q:draft)
deihsakna tawh = (i:1) (t:phrase) (f:social) (w:with best wishes/with goodwill/kind regards) (d:<deihsakna>, goodwill, and <tawh>, with: with goodwill; a formula that closes a letter, notice or column before the name of the writer, and that goes with an invitation or request, {deihsakna tawh kong zawn uh hi}, we kindly invite you) (r:zd:17674/zd:23832) (q:draft)
deihtak = (i:1) (t:adv) (f:everyday) (w:earnestly/intensely/hard/firmly) (d:<deih> with <tak>, placed before a verb: with full will or force; {deihtak thungen} is pray earnestly) (s:deihtakin) (r:zd:25046/zd:12487/zd:26097) (q:draft)
deihteel = (i:1) (t:v) (f:everyday) (w:choose/pick/choose freely) (d:<deih>, want, with <teel>, choose: pick what one likes from among others; {deihteel thei} is be able to choose; also as a noun, {ama deihteel}, his own choice) (r:zd:25139/zd:24542) (q:draft)
deihteelna = (i:1) (t:n) (f:everyday/religion) (w:choice/free choice/free will) (d:<deihteel>, choose freely, with the noun ending <na>: what a person chooses for himself, his own free choice) (b:deihteel) (r:zd:23604/zd:25139) (q:draft)
deihtel = (i:1) (t:v) (f:social/politics) (w:choose/choose freely) (d:choose what one wants, from <deih>, want, with <teel>, choose; {deihtel theihna} is the power or freedom to choose, and the noun is <deihtelna>) (r:zd:21989/zd:9142/zd:9429) (q:draft)
deihtelna = (i:1) (t:n) (f:social/politics) (w:free choice/choice/free will) (d:<deih>, want, with <teelna>, choosing: the choosing of what one wants, one's own free choice; {mipi deihtelna} is the choice of the people) (r:zd:19600/zd:24673/zd:23893) (q:draft)
deihzah = (i:1) (t:n) (f:everyday) (w:amount wanted/as much as one wants) (d:<deih>, want, and <zah>, amount, written as one word: the amount or number that someone wants) (j:deih/zah) (r:zd:23904/zd:16799) (q:draft)
deihzahzah = (i:1) (t:adv) (f:everyday) (w:as much as one wants/as many as one wants) (d:<deih>, want, and <zahzah>, as much as, written as one word: whatever amount a person wishes) (j:deih/zahzah) (r:zd:21876/zd:12070) (q:draft)
dek = (i:2) (t:v) (f:health/everyday) (w:abstain from/avoid/refrain) (d:after <ki>, {ki dek}: hold oneself back from a food, a drink or a habit; a verb of its own, not the particle that follows a verb) (r:zd:21557/zd:24276/zd:22019) (q:draft)
dekdekta = (i:1) (t:adv) (f:everyday) (w:almost/nearly/about to) (d:<dekdek>, almost, and <ta>, the marker of a change, written as one word after a verb: is now on the point of, has almost) (j:dekdek/ta) (r:zd:11172/zd:21369/zd:21348) (q:draft)
dekin = (i:1) (t:adv) (f:everyday) (w:almost/nearly) (d:<dek> and <in> written as one word after a describing word or verb: being almost so, as in {aguaktang dekin}, almost naked) (j:dek/in) (r:zd:15264) (q:draft, low confidence)
dekliang = (i:1) (t:adv) (f:everyday) (w:almost/nearly/very nearly) (d:<dek>, almost, and <liang>, even, written as one word after a verb: so much that it very nearly happens) (j:dek/liang) (r:zd:12289/zd:15019) (q:draft)
dekphial = (i:1) (t:adv) (f:everyday) (w:almost/nearly) (d:<dek> and <phial> written as one word, after a verb or an amount: almost, very nearly) (s:dektak) (j:dek/phial) (r:zd:14877/zd:16063/zd:13250) (q:draft)
deksuai = (i:1) (t:adv) (f:everyday) (w:nowhere near/not at all) (d:stronger form of <dek>, nearly, used after a verb and followed by a negative such as <lo> or <kei>: far from it, not at all, by no means) (r:zd:24199/zd:23311/zd:12370) (q:draft)
dekta = (i:1) (t:adv) (f:everyday) (w:almost/nearly/about to) (d:<dek>, nearly, and <ta>, now or already, written as one word after a verb: the action is now about to happen or has nearly happened) (j:dek/ta) (r:zd:22586/zd:18943/zd:15331) (q:draft)
Delaware = (i:1) (t:name) (c:land) (f:travel/politics) (w:Delaware) (d:a state in the east of the United States) (r:zd:25610) (q:draft)
deldal = (i:1) (t:adv) (f:everyday) (w:sprawled/in full view/spread out) (d:placed after a verb for lie or stand, as in {lum deldal} and {din deldal}: lying or standing spread out in the open where everyone sees it, often of something unseemly) (r:zd:16148/zd:25927) (q:draft, low confidence)
delegate = (i:1) (t:n) (f:politics/social) (w:delegate/representative) (d:a person sent to a meeting to speak for a group or a village) (s:taangmi/palai) (o:English) (r:zd:23311/zd:25915) (q:draft)
delete = (i:1) (t:v) (f:it) (w:delete/remove) (d:remove a post, picture or message from a phone, computer or website; with <ki>, be deleted) (s:phiat) (o:English) (r:zd:14728/zd:20501) (q:draft)
delhdelh = (i:1) (t:v) (f:everyday) (w:keep chasing/pursue on and on) (d:<delh>, chase, said twice: go on chasing or following without stopping) (b:delh) (r:zd:22785/zd:17195) (q:draft)
delhhuan = (i:1) (t:v) (f:everyday) (w:chase after/give chase/go after) (d:<delh>, chase, formed in the same way as <bawhhuan>, rush at: set off after someone in order to catch or reach him) (b:delh) (r:zd:19554/zd:23773) (q:draft, low confidence)
Delhi = (i:1) (t:name) (c:city) (f:travel/politics) (w:Delhi/New Delhi) (d:the capital city of India, where a Zomi community lives) (r:zd:26565/zd:17274) (q:draft)
delhkhiapah = (i:1) (t:v) (f:everyday) (w:rush out at once/set out after at once) (d:<delhkhia> and <pah> written as one word: go out after something or someone immediately, said of firefighters hurrying to a fire and of people running out after someone) (j:delhkhia/pah) (r:zd:15507/zd:15953/zd:16815) (q:draft)
delhpah = (i:1) (t:v) (f:everyday/media) (w:rush to/hurry after/go at once) (d:<delh> and <pah> written as one word: go after someone or hurry to a place at once, as police and firefighters to the scene) (j:delh/pah) (r:zd:20721/zd:15631) (q:draft)
delhphei = (i:1) (t:v) (f:everyday/travel) (w:rush over/run to/chase after) (d:<delh>, go after or hurry to, with <phei>, here across or over to: hurry over to a person or place, to help, to catch or to stop someone) (b:delh) (r:zd:17455/zd:17023/zd:18122) (q:draft)
delhpheipah = (i:1) (t:v) (f:everyday/travel) (w:rush over at once/run after at once) (d:<delhphei>, rush over to or run after, and <pah>, at once, written as one word) (j:delhphei/pah) (r:zd:12479/zd:19468/zd:15368) (q:draft)
delhsakpah = (i:1) (t:v) (f:work/everyday) (w:dispatch at once/send immediately) (d:<delhsak>, send after, and <pah>, at once, written as one word: send firefighters, police or medical teams to a place straight away) (j:delhsak/pah) (r:zd:15773/zd:13300) (q:draft)
delhto = (i:1) (t:v) (f:travel/everyday) (w:follow after/go after/follow up) (d:<delh>, go after, and <to>, up, written as one word: follow someone who has gone ahead, travel after them to the place where they are) (j:delh/to) (r:zd:16148/zd:11259) (q:draft)
deliver = (i:1) (t:v) (f:work) (w:deliver) (d:bring goods to the buyer; seen only in one repeated job notice) (o:English) (r:zd:11587) (q:draft, low confidence)
delivery = (i:1) (t:n) (f:work) (w:delivery) (d:the work of carrying goods or food to the buyer; in Zolai {van puak}) (o:English) (r:zd:12108/zd:15790) (q:draft)
dem = (i:2) (t:v) (f:politics/media) (w:compete/contest/run for) (d:take part in a competition, or stand as a candidate in an election, in order to win; no defiance is meant, and {a dem ding} is one who will compete, {President dem} is run for president) (s:kidem) (r:zd:25474/zd:23389/zd:24468) (q:draft)
demand = (i:1) (t:n) (f:politics/work) (w:demand) (d:what a group demands from others; also the demand of buyers for goods or a service) (s:ngetna) (o:English) (r:zd:21105/zd:20095) (q:draft, low confidence)
demdem = (i:1) (t:v) (f:work/social) (w:keep competing/vie) (d:<dem>, contend with, doubled; with the prefix <ki>, {ki demdem}, keep competing with one another, as rival companies do) (b:dem) (r:zd:19449/zd:11662) (q:draft)
Democracy = (i:1) (t:n) (f:politics) (w:democracy) (o:English) (r:zd:25110/zd:20256/zd:22746) (q:draft)
Democrat = (i:1) (t:name) (f:politics) (w:Democrat/Democratic Party) (d:the Democratic Party of the United States or one of its members; {Democrat te} is the Democrats) (o:English) (r:zd:23479/zd:24831) (q:draft)
Democrats = (i:1) (t:name) (f:politics) (w:Democrats/Democratic Party) (d:the members of the Democratic Party of the United States, one of the two main parties there) (r:zd:10906/zd:24909) (q:draft)
den = (i:1) (t:adv) (f:everyday/time) (w:always/continually/constantly) (d:placed after a verb: keep on doing, or remain so without change) (s:niloh/ngitnget/gige) (r:19.7.11) (q:draft)
dena = (i:1) (t:adv) (f:everyday) (w:always and/continually and) (d:<den>, always, and the linking <a> written as one word at the end of a clause: it keeps on being so, and the sentence goes on) (j:den/a) (r:zd:9244/zd:9215/zd:9212) (q:draft)
denden = (i:1) (t:adv) (f:everyday/time) (w:continually/again and again/all the time) (d:<den> said twice for emphasis, placed after a verb: keep on doing, without stopping) (b:den) (r:zd:25109/zd:20829/zd:23745) (q:draft)
dending = (i:1) (t:adv) (f:everyday/time) (w:always/continually) (d:<den>, always, and <ding>, will, written as one word after a verb: will or must keep on doing it) (j:den/ding) (r:zd:25927/zd:15617/zd:23872) (q:draft)
dengkhalo = (i:1) (t:v) (f:everyday) (w:not hit/miss) (d:<dengkha>, hit, and <lo>, not, written as one word: a falling or thrown thing does not hit a person) (j:dengkha/lo) (r:zd:16645/zd:11755) (q:draft)
Dengkil = (i:1) (t:name) (c:place) (f:travel) (w:Dengkil) (d:a town in Selangor, Malaysia; in the articles in the name of a Zomi church fellowship there) (r:zd:15379) (q:draft, low confidence)
denglumkha = (i:1) (t:v) (f:health/media) (w:strike dead/hit and kill) (d:<denglum>, strike dead, with <kha>, showing that it happened without intention, written as one word: a falling or flying thing hits a person and kills him) (j:denglum/kha) (r:zd:12287/zd:11133) (q:draft)
dengsia = (i:1) (t:v) (f:everyday/media) (w:fall on and damage/hit and wreck/smash) (d:<deng> and <sia> written as one word: of a falling or thrown thing, strike something and ruin it) (j:deng/sia) (r:zd:15403/zd:12287) (q:draft)
dengsukkha = (i:1) (t:v) (f:media) (w:fall on and hit/crash down onto/strike from above) (d:<deng>, strike, <suk>, down, and <kha>, happen to, written as one word: of a falling thing or person, come down on and hit what is below) (j:deng/suk/kha) (r:zd:20170/zd:11532/zd:19692) (q:draft)
Dengue = (i:1) (t:n) (f:health) (w:dengue/dengue fever) (d:a fever carried by mosquitoes, often written Dengue Fever) (o:English) (r:zd:14650/zd:16177) (q:draft)
denhi = (i:1) (t:adv) (f:everyday/time) (w:always) (d:<den>, always, and the sentence ending <hi> written as one word, after a verb: {om denhi} is always is) (j:den/hi) (r:zd:22652) (q:draft)
denkeei = (i:1) (t:adv) (f:everyday) (w:always/constantly/all the time) (d:<den>, always, and the emphatic <keei> written as one word after a verb: keep on doing, do nothing but) (j:den/keei) (r:zd:16035/zd:12341) (q:draft)
denkeii = (i:1) (t:adv) (f:everyday/time) (w:always/constantly) (d:<den>, always, and the emphatic <keii> written as one word, placed after a verb: all the time, without ever stopping) (j:den/keii) (r:zd:9253/zd:9239) (q:draft, low confidence)
denlo = (i:1) (t:adv) (f:everyday) (w:not always/not for good) (d:<den>, always, and <lo>, not, written as one word after a verb: not always, not permanently) (j:den/lo) (r:zd:12364/zd:10732) (q:draft)
denmah = (i:1) (t:adv) (f:time) (w:just now/a moment ago/in a moment) (d:a very short time from now, mostly a short time ago; {denmah in kiza hi} is it has just been heard) (r:zd:12105/zd:11422) (q:draft, low confidence)
Denmark = (i:1) (t:name) (c:land) (f:travel/politics) (w:Denmark) (d:a country in northern Europe) (r:zd:11329/zd:20145/zd:10908) (q:draft)
denna = (i:4) (t:n) (f:everyday) (w:constant doing/always being) (d:<den>, always, with <na> after a verb: the fact of always doing or always being so, as {ngaihsut denna}, always thinking, and {hoih denna mun}, a place where it is always good; not the {denna} of throwing) (r:zd:23767/zd:24224/zd:24276) (q:draft)
denomination = (i:1) (t:n) (f:religion) (w:denomination) (d:a branch of the Christian church with its own name and order, in Zolai {biakna pawl} or <pawlpi>; often added in brackets after the Zolai word) (o:English) (r:zd:22390) (q:draft, low confidence)
Denpasar = (i:1) (t:name) (c:city) (f:travel) (w:Denpasar) (d:city on the island of Bali, Indonesia, with an international airport) (r:zd:17947/zd:14498) (q:draft)
dente = (i:1) (t:phrase) (f:everyday) (w:those who always) (d:<den> and <te> written as one word, after a verb: those who always or continually do it) (j:den/te) (r:zd:24069/zd:24276) (q:draft)
dentist = (i:1) (t:n) (f:health) (w:dentist) (d:a doctor who treats the teeth; the Zolai expression is <ha siavuan>) (o:English) (r:zd:26531/zd:14856) (q:draft)
Denver = (i:1) (t:name) (c:city) (f:travel) (w:Denver) (d:city in the state of Colorado in the United States) (r:zd:17058) (q:draft)
denzaw = (i:1) (t:adv) (f:everyday/time) (w:usually/mostly) (d:<den>, always, and <zaw>, rather, written as one word after a verb: do so as a rule, for the most part) (j:den/zaw) (r:zd:20012/zd:9243) (q:draft)
dep = (i:2) (t:part) (f:everyday) (w:indeed/actually) (d:placed after the verb and before <hi> or {uh hi}, it marks what is said as notable or a little surprising, often with <bang> after the subject, as in {kei bang}, I for one; it is not the verb {dep}, choke) (r:zd:10912/zd:14910) (q:draft, low confidence)
Department = (i:1) (t:n) (f:politics/work) (w:department) (d:a department of a government or an organisation, mostly after its name) (o:English) (r:zd:25130/zd:20490) (q:draft)
Depayin = (i:1) (t:name) (c:khua) (f:travel) (w:Depayin) (d:town and township in Sagaing Region, Myanmar) (r:zd:17299) (q:draft)
Deportation = (i:1) (t:n) (f:politics/travel) (w:deportation) (d:sending a foreigner back to his or her own country by order of the authorities; {Deportation bawl} is deport) (s:hawlkhiatna) (o:English) (r:zd:11585/zd:13270/zd:20012) (q:draft)
Depot = (i:1) (t:n) (f:politics/travel) (w:depot/detention depot) (d:in news from Malaysia, an immigration centre where arrested foreigners are held) (o:English) (r:zd:14505/zd:14599) (q:draft, low confidence)
depression = (i:1) (t:n) (f:health) (w:depression) (d:the illness of lasting low spirits, also said {lungkiat natna}) (s:lungkiatna) (o:English) (r:zd:12436/zd:11335/zd:23594) (q:draft)
design = (i:1) (t:n) (f:work) (w:design/pattern) (d:the planned form or pattern of a thing such as a building or a cloth; {design bawl} is make a design) (o:English) (r:zd:21102/zd:22303/zd:23993) (q:draft)
Designer = (i:1) (t:n) (f:work) (w:designer) (d:a person whose work is to design things, as buildings, software or clothes) (o:English) (r:zd:21458/zd:16883) (q:draft)
det = (i:2) (t:adv) (f:everyday) (w:regularly/steadily/constantly) (d:placed after a verb: doing it regularly or keeping on with it, as in {bawl det} do regularly; not the {det} of {kha det}, new moon) (r:zd:14734/zd:25343/zd:11714) (q:draft)
detail = (i:1) (t:adj) (f:everyday/work) (w:detailed/in detail) (d:English word used in {a detail in} and {detail takin}, in detail, point by point) (o:English) (r:zd:21219/zd:23993) (q:draft)
detding = (i:1) (t:phrase) (f:everyday) (w:should always/must firmly) (d:<det>, here firmly or constantly, placed after a verb, with <ding>: the action should be done steadily and without fail, as {phawk detding}, should always keep in mind) (r:zd:25927/zd:20547) (q:draft, low confidence)
detna = (i:1) (t:n) (f:everyday) (d:form of <den>, always, with the noun suffix {-na}, placed after a verb: the regular or constant doing of it, or the place where it is always done; {a bawl detna} is what is regularly made) (b:den) (r:zd:25027/zd:15998) (q:draft)
Detroit = (i:1) (t:name) (c:city) (f:travel) (w:Detroit) (d:city in the state of Michigan in the United States) (r:zd:17983) (q:draft)
deudeu = (i:1) (t:adv) (f:everyday) (w:instead/rather/all the more/straight on) (d:placed after a verb: the action goes further than expected or the other way, rather, instead, simply going on to do it; perhaps <deuh> doubled) (r:zd:19603/zd:18927) (q:draft, low confidence)
deuhdeuh = (i:1) (t:adv) (f:everyday) (w:more and more/all the more/increasingly) (d:<deuh> said twice, placed after a verb or describing word: more and more, all the more; after a noun it means especially) (s:semsem) (b:deuh) (r:zd:24645/zd:22713/zd:14930) (q:draft)
deuhna = (i:1) (t:n) (f:everyday) (w:being more/greater degree) (d:<deuh>, rather or more, with the noun suffix <na>, after a describing word or verb: the being more so, or the place or case in which it is more so; {i tam deuhna} is where we are more numerous and {tuam deuhna} is a speciality) (b:deuh) (r:zd:12306/zd:24287) (q:draft)
deuhse = (i:1) (t:adv) (f:everyday) (w:rather/mostly/tend to) (d:<deuh> and <se> written as one word after a verb or describing word: rather so, more so than others, tending to be so) (j:deuh/se) (r:zd:11409/zd:12341) (q:draft, low confidence)
develop = (i:1) (t:v) (f:it/education) (w:develop) (d:create and work out something new, such as software, a font standard or a line of thought) (o:English) (r:zd:23049/zd:23432) (q:draft, low confidence)
devotion = (i:1) (t:n) (f:religion) (w:devotion/devotional) (d:a short time of prayer, Bible reading and worship, mostly in the morning, alone or as a group) (o:English) (r:zd:22686/zd:16150) (q:draft)
devotional = (i:1) (t:adj) (f:religion) (w:devotional) (d:of writing or reading meant for personal worship and prayer; {devotional laibu} is a devotional book) (o:English) (r:zd:9213/zd:17051) (q:draft)
Dhaka = (i:1) (t:name) (c:city) (f:travel/politics) (w:Dhaka) (d:capital city of Bangladesh) (r:zd:12387/ts:3506) (q:draft)
DHS = (i:1) (t:name) (f:politics/travel) (w:Department of Homeland Security/DHS) (d:department of the United States government whose officers interview refugees before they are resettled in the United States) (r:zd:13066/zd:22825) (q:draft)
dia = (i:1) (t:part) (f:everyday) (d:sentence-final question word of spoken style, short for {ding hiam}: will it, shall I, would you; {hi lo dia} is will it not be so) (s:diam) (r:zd:23037/zd:16442/zd:22450) (q:draft)
diabetes = (i:1) (t:n) (f:health) (w:diabetes) (d:the English name of the disease, mostly written as a gloss beside <zunkhum>) (s:zunkhum) (o:English) (r:zd:18058) (q:draft, low confidence)
diadiak = (i:1) (t:adv) (f:everyday) (j:diakdiak) (r:zd:22459) (q:draft, low confidence)
diadiakin = (i:1) (t:adv) (f:everyday) (w:especially/above all/in particular) (d:found as {a diadiakin} at the head of a sentence, a spelling of {a diakdiakin}, <diak> doubled with <in>: most especially) (b:diak) (r:zd:22652) (q:draft, low confidence)
diaidiai = (i:1) (t:adv) (f:everyday) (w:steadily/gradually/smoothly) (d:placed after a verb for a movement or change that goes on smoothly without a stop, mostly a going down: {kiamsuk diaidiai} is decline steadily) (r:zd:21670/zd:19779) (q:draft, low confidence)
diakdiak = (i:1) (t:adv) (f:everyday) (w:especially/in particular/above all) (d:<diak>, especially, said twice and written as one word: most especially; {a diakdiak in} opens a sentence, above all, and after a noun it singles that one out) (b:diak) (r:zd:20979/zd:24657) (q:draft)
diakna = (i:1) (t:n) (f:everyday) (d:<diak>, especially, with the noun suffix {-na}: placed after a verb or describing word, the place or thing that is so more than the rest, as in {painop diakna}, the place people most like to go) (b:diak) (r:zd:15679/zd:16608) (q:draft)
dialect = (i:1) (t:n) (f:education/social) (w:dialect) (d:a form of a language spoken in one area or by one group; mostly in the English name Kamhau dialect for Tedim speech) (o:English) (r:zd:21179/zd:24165) (q:draft, low confidence)
dialkang = (i:1) (t:n) (f:politics) (w:white flag) (d:<dial>, flag, and <kang>, white, written as one word: the white flag raised as a sign of surrender; {dialkang khai} is raise the white flag) (j:dial/kang) (r:ts:12506) (q:draft)
diamdiamna = (i:1) (t:n) (f:social) (w:harmony/mutual doing) (d:<diamdiam> with the noun ending {-na}, after a verb with <ki>: the doing of something together or to one another in a kindly way, as in {kithuman diamdiamna}, cooperation) (b:diamdiam) (r:zd:25200/ts:3125) (q:draft, low confidence)
diangto = (i:1) (t:v) (f:everyday) (w:jump up/leap up/shoot up) (d:<diang> and <to> written as one word: jump or leap upward; of a price, shoot up) (j:diang/to) (r:zd:20796/zd:19530) (q:draft)
diaper = (i:1) (t:n) (f:family/home) (w:diaper/nappy) (o:English) (r:zd:23356/zd:12267) (q:draft)
diary = (i:1) (t:n) (f:education/everyday) (w:diary/journal) (d:a book in which one writes down each day what happened; also {diary bu}) (o:English) (r:zd:22784/zd:25909) (q:draft)
Dickson = (i:1) (t:name) (c:city) (f:travel) (w:Port Dickson) (d:second word of the name Port Dickson, a coastal town in the state of Negeri Sembilan in Malaysia) (r:zd:19351/zd:12488) (q:draft)
dictatorship = (i:1) (t:n) (f:politics) (w:dictatorship) (d:rule by one person or group with all power, explained in Zolai as {ukcip nopna}) (o:English) (r:zd:23306/zd:16661) (q:draft)
didek = (i:1) (t:part) (f:everyday) (w:almost/nearly/about to) (d:{di}, short for <ding>, with <dek>, placed after a verb: on the point of, nearly) (j:ding/dek) (r:zd:19394/zd:17589) (q:draft, low confidence)
diesel = (i:1) (t:n) (f:travel/work) (w:diesel/diesel fuel) (d:the fuel oil burned in diesel engines) (o:English) (r:zd:14628) (q:draft)
dignity = (i:1) (t:n) (f:social) (w:dignity/worth) (d:the worth of a person; mostly added in brackets to explain <vaang>, seldom a word of its own) (s:vaang) (o:English) (r:zd:21090) (q:draft, low confidence)
dih un = (i:1) (t:part) (f:everyday) (d:<dih>, the softening particle of a request, and <un>, the ending of a command to several people: placed after a verb, a friendly or urging request to more than one person, please do, do just; to one person it is {dih in}) (r:zd:25137/zd:24990/zd:21690) (q:draft)
dihdih = (i:1) (t:adv) (f:everyday) (w:just/simply/really) (d:placed after a verb or a number: just like that, simply, there and then; with a negative, not really, not simply) (r:zd:16312/zd:23039/zd:15879) (q:draft, low confidence)
dihni = (i:1) (t:part) (f:everyday/social) (w:let us) (d:<dih> and <ni>, here let us, written as one word after a verb: a friendly call to do something together, let us just do it) (j:dih/ni) (r:zd:23039/zd:19396/zd:22444) (q:draft)
dihve = (i:1) (t:part) (f:everyday) (w:please/just/do) (d:<dih> and <ve> written as one word, after a verb in a request: please do, go on and do) (j:dih/ve) (r:zd:19338/zd:16337) (q:draft)
diikna = (i:1) (t:n) (f:body/health) (w:breathing/inhalation/breath) (d:<diik>, breathe in, with the noun ending <na>: the drawing in of breath or air) (b:diik) (r:zd:9246/zd:24500) (q:draft)
diimdiam = (i:1) (t:adv) (f:everyday) (j:dimdiam) (r:zd:19850) (q:draft, low confidence)
diing = (i:1) (t:part) (f:everyday) (j:ding) (r:zd:23780/zd:10973) (q:draft)
dik = (i:1) (t:adj) (f:everyday) (w:right/correct/just/honest) (d:right or correct, as it ought to be; of a person upright and honest) (s:thuman/thutang) (a:gilo/thumanlo) (r:19.11.7) (q:draft)
dik = (i:3) (t:v) (f:body/health) (w:breathe/breathe in/inhale) (d:a spelling of <diik>, draw in breath, used after <huih>, air: {huih dik} is breathe air; not the right or correct of the other senses) (s:diik) (r:zd:20195/zd:12276/zd:16687) (q:draft)
dikkha = (i:1) (t:v) (f:body/health) (w:inhale/breathe in/smell) (d:a verb for drawing in with the breath, with <kha>, happen to: breathe in smoke, bad air or a smell) (r:zd:18211/zd:20798/zd:15286) (q:draft)
diklo = (i:1) (t:adj) (f:everyday/social) (w:wrong/incorrect/unjust/dishonest) (d:<dik>, right, with <lo>, not: not right or not true; of conduct, wrong or dishonest) (s:manlo) (a:dik) (b:dik) (r:zd:14965/zd:21096/zd:21221) (q:draft)
dikna = (i:2) (t:n) (f:body/health) (w:breathing/inhaling) (d:<dik>, breathe in, with the noun suffix <na>: the drawing in of air, said after <huih>, air; {huih dikna lampi} is the airway and has nothing to do with being righteous) (r:zd:23538) (q:draft)
diksalo = (i:1) (t:v) (f:everyday/social) (w:disapprove/object to/not accept) (d:<diksa> and <lo> written as one word: not regard as right, disapprove of something) (j:diksa/lo) (r:zd:15498/zd:20263) (q:draft)
diktak = (i:1) (t:adj) (f:everyday/social) (w:true/real/genuine/proper) (d:<dik>, right, with <tak>, true, written as one word and placed after a noun: the real and proper kind of that thing; of a person, upright) (b:dik) (r:zd:25573/zd:21327/zd:23022) (q:draft)
dildial = (i:1) (t:adv) (f:nature) (w:lushly/verdantly) (d:used in {nim dildial}, lush green, to picture leaves, trees or a whole landscape as fresh and richly green) (r:zd:9422/zd:22305) (q:draft)
dim = (i:1) (t:adj) (f:everyday) (w:full) (d:holding as much as there is room for; with <tawh> it says what something is full of) (a:awng/hawm/hawmguak)
dimcip = (i:1) (t:adj) (f:everyday) (w:completely full/packed/filled up) (d:<dim>, full, and <cip>, completely, written as one word: full right up, of a road covered with water or packed with cars) (j:dim/cip) (r:zd:12811/zd:14906) (q:draft)
dimdim = (i:1) (t:adv) (f:everyday) (w:fully/to the full) (d:<dim>, full, said twice, after a verb or noun: filling the whole place or the whole mouth; of sound, resounding) (b:dim) (r:zd:17886/zd:24236) (q:draft, low confidence)
dimkhin = (i:1) (t:adj) (f:everyday) (w:already full/filled up) (d:<dim>, full, with <khin>, already, written as one word: already full, or having filled a place) (j:dim/khin) (r:zd:11135/zd:15846) (q:draft)
Dimpi = (i:1) (t:name) (c:khua) (f:travel) (w:Dimpi) (d:a Zomi village in the Tedim area; also used as a personal name) (r:ts:3372/zd:14992) (q:draft)
Dimtui = (i:1) (t:name) (c:khua) (f:social/media) (w:Tedim) (d:name used in songs and solemn writing for the town of Tedim, mostly as {Dimtui vangkhua}) (r:zd:22565/zd:18179) (q:draft, low confidence)
dimzihziah = (i:1) (t:v) (f:everyday/media) (w:be full all over/be crowded/be strewn everywhere) (d:<dim>, full, with the intensifying <zihziah>: a place is filled or covered all over with people or things) (j:dim/zihziah) (r:zd:12608/zd:19197/zd:19583) (q:draft)
ding = (i:2) (t:v) (f:everyday/body) (w:stand) (r:zai:stand) (q:draft)
ding = (i:3) (t:part) (f:everyday) (w:to/for) (d:after a verb or a noun in {-na} it marks what is to be done or what a thing is for, as in {neih ding kisam hi}, it is necessary to have, and {kepna ding mun}, a place for keeping; the sense will or shall closes a statement before <hi>) (r:ts:12490/ts:9677/ts:11998) (q:draft)
ding kisam = (i:1) (t:v) (f:everyday) (w:need to/must/have to) (d:<ding>, the marker of what is to be done, and <kisam>, be necessary: placed after a verb, it is necessary to do it, one must do it) (r:ts:3506/ts:7972/ts:261) (q:draft)
dinga = (i:2) (t:conj) (f:everyday) (w:will and/and) (d:<ding>, will, with the linking <a>, and: closes a clause about what will happen and joins it to the next clause, which often ends in {ding hi}; here no noun follows as in the sense for or to) (b:ding) (r:zd:23394/ts:3280) (q:draft)
dingaa = (i:1) (t:part) (f:everyday) (w:will and/to) (d:<ding>, will, with the linking <a> written with a long vowel: closes a clause about what will or should happen and joins it to the next one, will do this and; before a noun or verb also to, for, the same as <dinga>) (j:ding/a) (r:zd:21085/zd:21568) (q:draft)
dingbang = (i:1) (t:adv) (f:everyday) (w:about/something like/as if going to) (d:<ding> and <bang> written as one word: after a number, about that many; after a verb, as if it were going to happen, something like what will be) (j:ding/bang) (r:zd:21117/zd:19327) (q:draft)
dingbek = (i:1) (t:adv) (f:everyday) (w:only to/only for/just to) (d:<ding>, will or for, with <bek>, only: after a verb or a noun in {-na}, only in order to, for that purpose alone) (j:ding/bek) (r:zd:24276/zd:19665) (q:draft)
dingbel = (i:1) (t:part) (f:everyday) (d:<ding> and <bel> written as one word after a verb: as for what will or should be done, giving weight to that part of the sentence) (j:ding/bel) (r:zd:16337/zd:25924) (q:draft, low confidence)
dingci = (i:1) (t:v) (f:everyday/media) (w:say that will) (d:<ding> and <ci> written as one word: says that something will or should be done, it is said that it will) (j:ding/ci) (r:zd:21866/zd:15121) (q:draft)
dingciangin = (i:1) (t:conj) (f:everyday/time) (w:when about to/when going to) (d:<ding> and <ciangin> written as one word after a verb: when someone is going to do it) (j:ding/ciangin) (r:zd:21664) (q:draft)
dingcih = (i:1) (t:phrase) (f:everyday) (d:<ding>, will, and <cih>, that, written as one word after a verb: that or whether something will be done, as in a decision or an indirect question) (j:ding/cih) (r:zd:21085/zd:24236) (q:draft)
dingdan = (i:1) (t:n) (f:everyday) (w:way to/how to) (d:<ding> and <dan> written as one word after a verb: the way in which something is to be done or is going to be, how to) (j:ding/dan) (r:zd:19523/zd:24167) (q:draft)
dingdang = (i:1) (t:phrase) (f:everyday) (w:anything else to/something else to) (d:<ding> and <dang>, other, written as one word, placed after a verb: another thing to do or say, as in {cihna dingdang thei lo}, not know what else to say) (j:ding/dang) (r:zd:23428/zd:23043) (q:draft)
dinghi = (i:1) (t:part) (f:everyday) (w:will/shall) (d:<ding>, the marker of the future, and the sentence-final <hi> written as one word: closes a statement about what will or is to happen) (j:ding/hi) (r:zd:23825/zd:14954/zd:23863) (q:draft)
dinghiam = (i:1) (t:part) (f:everyday) (w:will/shall) (d:<ding> and <hiam> written as one word at the end of a question about the future: will it, shall we) (s:diam) (j:ding/hiam) (r:zd:9134/zd:21715) (q:draft)
dingin lamen = (i:1) (t:v) (f:everyday) (w:expect that/hope that) (d:<dingin>, to be, and <lamen>, expect: placed after a clause, expect or hope that it will be so; the person ending follows, as in {om dingin lamen ing}, I expect there will be) (r:zd:12134/zd:21175/zd:11899) (q:draft)
dingkhat = (i:1) (t:phrase) (f:everyday) (w:one thing to/one that will) (d:<ding> and <khat>, one, written as one word after a verb: one thing that is to be done or one that will be so; {na theih dingkhat} is one thing for you to know) (j:ding/khat) (r:zd:15324/zd:11135) (q:draft)
dingkhia = (i:2) (t:v) (f:social) (w:be founded/arise/come into being) (d:of an organisation or a people, stand up and come into being, not leave a place; the subject is a body such as <pawlpi> or <gam>, often with a year) (r:zd:13268/zd:9445) (q:draft, low confidence)
dingkip = (i:1) (t:v) (f:everyday/social) (w:stand firm/stand fast/be stable) (d:<ding>, stand, with <kip>, firm, written as one word: stand firm on one's feet or in a promise; of a country, stand secure) (j:ding/kip) (r:zd:25139/zd:15264/zd:9141) (q:draft)
dingkisam = (i:1) (t:v) (f:everyday) (w:need to/must/be necessary) (d:<ding> and <kisam> written as one word after a verb: it is necessary to do so, one needs to) (j:ding/kisam) (r:zd:25919/zd:25923) (q:draft)
dinglah = (i:1) (t:part) (f:everyday) (d:<ding> and the emphatic particle <lah> written as one word after a verb: as for doing it, and yet to do it; it sets one thing to be done beside another or beside a difficulty) (j:ding/lah) (r:zd:20503/zd:23616) (q:draft, low confidence)
dingleh = (i:1) (t:conj) (f:everyday) (d:<ding>, will, and <leh>, written as one word after a verb: with <leh> as and it joins two things that are to be done or to happen, what to think and what to do; with <leh> as if it makes a condition, if it will be so) (j:ding/leh) (r:zd:21876/zd:19309) (q:draft)
dingmah = (i:1) (t:adv) (f:everyday) (w:surely to/precisely for/indeed for) (d:<ding>, will or for, with the emphatic <mah>: after a verb, sure to, bound to; after a noun in {-na}, for that very thing) (j:ding/mah) (r:zd:21869/zd:21388) (q:draft, low confidence)
dingmaw = (i:1) (t:part) (f:everyday) (w:shall/will) (d:<ding>, the future marker, and the question word <maw> written as one word at the end of a question: shall it be, is one to) (j:ding/maw) (r:zd:21063/zd:24088) (q:draft)
dingmun = (i:1) (t:n) (f:everyday/travel) (w:place for/destination/venue) (d:<ding>, will, with <mun>, place, written as one word after a verb or noun: the place where something will be or is to be done) (j:ding/mun) (r:zd:11697/zd:19915) (q:draft)
dingpen = (i:1) (t:phrase) (f:everyday) (w:what is to be/what will be) (d:<ding>, the marker of what is to happen, with the topic marker <pen>, written as one word after a verb: makes the clause the topic of the sentence, what is to be done, the thing that will happen) (j:ding/pen) (r:zd:21918/zd:21529) (q:draft)
dingtawh = (i:1) (t:phrase) (f:everyday) (d:<ding>, will or to, with <tawh>, with, written as one word after a verb: {dingtawh kisai} is concerning what is to be done, and {dingtawh kibang} is as if about to) (j:ding/tawh) (r:zd:23935/zd:20213/zd:19271) (q:draft)
dingten = (i:1) (t:part) (f:everyday) (w:those who will/those who are to) (d:<dingte>, those who will, and the marker <in> written as one word in a short form: those who are to do something, as the doers of what follows) (j:dingte/in) (r:zd:17958/zd:10687) (q:draft)
dingthu = (i:1) (t:n) (f:everyday) (w:matter to be/thing to be) (d:<ding>, will or to be, and <thu>, matter, written as one word after a verb: a matter that is to be done or that will happen, as in {theih dingthu}, things to know) (j:ding/thu) (r:zd:21369/zd:22967) (q:draft)
dingthupi = (i:1) (t:phrase) (f:everyday) (w:be important to/it is important that) (d:<ding>, which closes a clause of what should be done, and <thupi>, important, written as one word: it is important to do so; {gamtat loh dingthupi} is it is important not to act so) (j:ding/thupi) (r:zd:25927/zd:23663) (q:draft)
dinguh = (i:1) (t:part) (f:everyday) (w:will/shall) (d:<ding> with the plural <uh>, written as one word: placed after a verb, they will, you will, for them to) (j:ding/uh) (r:zd:25200/zd:25062/zd:23746) (q:draft)
dingzong = (i:1) (t:phrase) (f:everyday) (w:also to/as well) (d:<ding> and <zong> written as one word after a verb or noun: also to do, also something that is to be; {dingzong kisam hi} is it is also necessary to) (j:ding/zong) (r:zd:15123/zd:19676/zd:17630) (q:draft)
dinkhawlsak = (i:1) (t:v) (f:work/politics) (w:suspend/stop/halt) (d:<dinkhawl>, come to a halt, with the causative <sak>: make something stop for a time; {nasep ki dinkhawlsak} is be suspended from work) (b:dinkhawl) (r:zd:19141/zd:18112) (q:draft)
dinkhop = (i:1) (t:v) (f:social) (w:stand together/stand united) (d:<din>, stand, with <khop>, together: the form of <dingkhawm> used before words such as <ding>, <hun> and <loh>) (s:dingkhawm) (j:din/khop) (r:zd:24861/zd:25399) (q:draft)
dinmun = (i:1) (t:n) (f:social/politics) (w:situation/position/status/standing) (d:<din>, stand, with <mun>, place: where one stands, the state of affairs or the rank of a person, a people or a country) (r:zd:26385/zd:22746/zd:18086) (q:draft)
dinmunah = (i:1) (t:adv) (f:social/everyday) (w:in the situation/in the position) (d:<dinmun> and <ah> written as one word: in the situation or position named before it; {tu dinmunah} is at present, as things now stand) (j:dinmun/ah) (r:zd:10673/zd:20145/zd:25063) (q:draft)
dinmunh = (i:1) (t:n) (f:social) (j:dinmun) (r:zd:16321/zd:17022) (q:draft)
dinmunte = (i:1) (t:n) (f:social/work) (w:positions/situations/conditions) (d:plural of <dinmun>: positions or ranks in work, or the conditions and circumstances of a matter) (b:dinmun) (r:zd:21908/zd:22830) (q:draft)
dinner = (i:1) (t:n) (f:food/social) (w:dinner/evening meal/banquet) (d:the evening meal, also a festive meal held for an occasion) (s:nitak an) (o:English) (r:zd:16038/zd:23641) (q:draft)
Dinosaur = (i:1) (t:n) (c:animal) (f:nature/education) (w:dinosaur) (o:English) (r:zd:22203/zd:11072) (q:draft)
dinpih = (i:1) (t:v) (f:social/politics) (w:stand for/stand by/uphold/support) (d:<din>, stand, with the suffix <pih>: stand with a person or hold to a cause or principle; {ka dinpih thu} is what I stand for) (b:din) (r:zd:24544/zd:19219/zd:26700) (q:draft)
dinpihnate = (i:1) (t:n) (f:social) (w:support/acts of support) (d:plural of {dinpihna}, standing with someone: the ways in which people have stood by and supported; {nong dinpihnate} is your support of us) (r:zd:22019) (q:draft)
Diocese = (i:1) (t:n) (f:religion) (w:diocese) (d:the district of churches under one bishop) (o:English) (r:zd:21723/zd:15393) (q:draft)
dipdep = (i:1) (t:adv) (f:everyday) (w:completely/utterly/all over) (d:placed after a verb: wholly, all of it together with nothing left out, as in {guallel dipdep}, utterly defeated, and {hing dipdep}, green all over) (r:zd:17745/zd:25157/zd:10833) (q:draft, low confidence)
Diploma = (i:1) (t:n) (f:education) (w:diploma) (d:a certificate given for completing a course of study, ranked below a degree) (o:English) (r:zd:24029/zd:17409) (q:draft)
diplomat = (i:1) (t:n) (f:politics) (w:diplomat) (d:an official who represents a government in another country) (o:English) (r:zd:25772/zd:21400/zd:10696) (q:draft)
Diplomatic = (i:1) (t:adj) (f:politics) (w:diplomatic) (d:of the dealings between governments; mostly inside English phrases such as Diplomatic Passport, and {diplomatic lam tawh} is by diplomatic means) (o:English) (r:zd:15303/zd:25560) (q:draft, low confidence)
dipsak = (i:1) (t:v) (f:everyday/religion) (w:refill/replenish/make up) (d:fill up again what has been emptied or spent; in a blessing, may God make up many times over what someone has given) (r:zd:11224) (q:draft, low confidence)
direct = (i:1) (t:adv) (f:everyday/travel) (w:directly/direct/straight) (d:without anything or anyone in between, mostly as {direct in}; also in English phrases such as Direct Deposit) (o:English) (r:zd:23904/zd:23957/zd:23844) (q:draft)
direction = (i:1) (t:n) (f:travel) (w:direction) (d:the way in which something moves or faces; the Zolai word is <lam>) (o:English) (r:zd:12733/zd:11438) (q:draft)
director = (i:1) (t:n) (f:work/politics) (w:director) (d:the head of a department, office or organisation) (o:English) (r:zd:12928/zd:17745/zd:24181) (q:draft)
Disaster = (i:1) (t:n) (f:nature/politics) (w:disaster) (d:a sudden event that causes great loss, as an earthquake, a flood or a fire, the English word; also written with <tuahsiatna> after it) (o:English) (r:zd:14638/zd:21563) (q:draft, low confidence)
discipline = (i:1) (t:n) (f:education/social) (w:discipline) (d:training and self-control under rules; mostly written beside the Zolai <kikhalna> as its English gloss) (s:kikhalna) (o:English) (r:zd:20979) (q:draft)
Discount = (i:1) (t:n) (f:work) (w:discount/price reduction) (d:a reduction of the price; {Discount pia} is give a discount and {Discount ngah} is get one) (o:English) (r:zd:11011/zd:19775) (q:draft)
Disney = (i:1) (t:name) (f:media/work) (w:Disney) (d:the American film and entertainment company, named in lists of large companies) (r:zd:22341) (q:draft, low confidence)
dissertation = (i:1) (t:n) (f:education) (w:dissertation/thesis) (d:the long written work handed in for a higher degree) (o:English) (r:zd:20437) (q:draft)
distinction = (i:1) (t:n) (f:education) (w:distinction) (d:the highest mark in a subject of the grade 10 examination in Myanmar; {all distinction} is a distinction in every subject) (o:English) (r:zd:9266/zd:23554) (q:draft)
District = (i:1) (t:n) (f:politics) (w:district) (d:an administrative division of a state or region, mostly after its name, as in Tedim District) (o:English) (r:zd:22818/zd:24574/zd:19702) (q:draft)
Diver = (i:1) (t:n) (f:media/work) (w:diver) (d:a person trained to work under water, often written beside the Zolai <tuisunglutsiam>, one skilled at going into the water) (o:English) (r:zd:20387/zd:20289) (q:draft)
Divider = (i:1) (t:n) (f:travel) (w:road divider/median barrier) (d:the barrier that separates the two directions of a main road, mostly as Road Divider; explained in Zolai as {lamzikpi akikhenna}) (o:English) (r:zd:19351/zd:16063) (q:draft)
Division = (i:1) (t:n) (f:politics) (w:division) (d:a division: one of the large administrative areas of Myanmar beside the States, as in Sagaing Division, now called Region; also a division of an army or of the police) (o:English) (r:zd:23252/zd:25097/zd:24469) (q:draft)
DNA = (i:1) (t:n) (f:health) (w:DNA) (d:the material in the body that carries what is inherited from the parents; {DNA sit} is to test it) (o:English) (r:zd:20902/ts:3280) (q:draft)
Doctor = (i:1) (t:n) (f:health) (w:doctor/physician) (d:a person trained to treat the sick; also the academic title, as in {Doctor of Divinity}) (s:zato/siavuan) (o:English) (r:zd:17779/zd:19858/zd:24570) (q:draft)
doctorate = (i:1) (t:n) (f:education) (w:doctorate/doctoral degree) (d:the highest university degree) (o:English) (r:zd:21260/zd:26566) (q:draft)
Doctors = (i:1) (t:n) (f:health) (w:doctor/doctors) (d:the English plural of doctor, used in news reports for medical doctors, also with a number: {Doctors nih} is two doctors) (s:siavuan) (o:English) (r:zd:11929/zd:18112) (q:draft)
doctrine = (i:1) (t:n) (f:religion) (w:doctrine/teaching) (d:what a church holds and teaches as its belief; in Zolai also explained as <upna> or <thupom>) (o:English) (r:zd:20999/zd:21866) (q:draft)
Document = (i:1) (t:n) (f:work/travel) (w:document/papers) (d:an official paper, mostly an identity or travel paper; glossed with <laidal>) (o:English) (r:zd:21843/zd:12504/zd:10951) (q:draft)
documentary = (i:1) (t:n) (f:media) (w:documentary) (d:a film that reports facts about real people and events) (o:English) (r:zd:12999/zd:21255) (q:draft, low confidence)
Documents = (i:1) (t:n) (f:work/travel/politics) (w:document/papers) (d:the English plural used in Zolai text for official papers, above all the {Travel Documents} that a foreigner must hold) (o:English) (r:zd:25400/zd:14947) (q:draft)
doding = (i:1) (t:v) (f:politics/everyday) (w:to fight/to resist) (d:<do> and <ding> written as one word: to fight, to be fought or resisted) (j:do/ding) (r:zd:9124/zd:23937) (q:draft)
Doha = (i:1) (t:name) (c:city) (f:travel) (w:Doha) (d:capital city of Qatar) (r:zd:16085/zd:12016) (q:draft)
dokhawm = (i:1) (t:v) (f:politics) (w:fight together/attack jointly) (d:<do> and <khawm> written as one word: several groups fight or attack an enemy together) (j:do/khawm) (r:ts:6525/ts:9312/zd:24955) (q:draft)
dollar = (i:1) (t:n) (f:work) (w:dollar) (d:the dollar as a unit of money, mostly the US dollar; the number follows the word, as in {dollar khat}, one dollar) (o:English) (r:zd:22451/zd:17162/zd:17025) (q:draft)
dollars = (i:1) (t:n) (f:work) (w:dollars) (d:the English plural of dollar, written before or after an amount of money) (o:English) (r:zd:21670/zd:25638) (q:draft)
Dominican = (i:1) (t:name) (c:land) (f:travel/religion) (w:Dominican) (d:in the English name Dominican Republic, a country in the Caribbean; also of the Dominican order of Catholic friars) (r:zd:11794/zd:15810) (q:draft, low confidence)
domsang = (i:1) (t:v) (f:everyday/social) (w:lift up/raise/exalt) (d:<dom>, lift up, with <sang>, high: raise a person up, give him a higher place or build him up) (j:dom/sang) (r:zd:11571/zd:24003) (q:draft)
dona = (i:2) (t:n) (f:social/home) (w:reception/hospitality/entertaining) (d:<do> in the sense receive a guest, as in {zin do}, with the noun suffix <na>: the receiving and entertaining of guests, after <lengla> or {zin le leng}, guests) (r:zd:19826/zd:13354) (q:draft)
dong = (i:2) (t:v) (f:everyday) (w:ask/inquire/question) (d:put a question to someone or seek advice; the form <dot> is used in dependent clauses) (s:thudong/kan) (a:dawng) (q:draft)
donga = (i:2) (t:v) (f:everyday) (w:ask) (d:<dong>, ask, with the linking <a>: asked, and then; it follows the one who asks or {ci'n} and stands before the question or the next action, while the until sense follows a time or an amount) (r:zd:21174/zd:16580) (q:draft, low confidence)
dongbang = (i:1) (t:adv) (f:time/everyday) (w:until about/up to about/as much as) (d:<dong>, until, with <bang>, about, written as one word after a time or number: up to about that much) (j:dong/bang) (r:zd:20588/zd:21459) (q:draft)
dongbek = (i:1) (t:adv) (f:time) (w:only until/until only) (d:<dong>, until, and <bek>, only, written as one word after a date or time: up to that time and no later) (j:dong/bek) (r:zd:11253/zd:20505/zd:13218) (q:draft)
dongciang = (i:1) (t:prep) (f:time/everyday) (w:until/up to/as far as) (d:<dong> and <ciang>, both until, written as one word after a word of time or a clause; {tu dongciang} is until now) (j:dong/ciang) (r:zd:16038/zd:11798) (q:draft)
dongdong = (i:1) (t:v) (f:everyday) (w:keep asking/ask again and again) (d:<dong>, ask, said twice and written as one word: go on asking; {thu dongdong} is keep asking questions) (b:dong) (r:zd:19600/zd:14910) (q:draft)
dongdong = (i:2) (t:prep) (f:everyday) (w:up to/as far as) (d:<dong>, until, said twice and written as one word after a place or an amount: right up to, as much as) (b:dong) (r:zd:16032) (q:draft, low confidence)
dongh = (i:1) (t:v) (f:everyday) (w:ask/inquire/question) (d:put a question to someone; another spelling of <dong> in this sense) (s:dong) (r:zd:21869/zd:21032) (q:draft)
