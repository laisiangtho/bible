singpuak = (i:1) (t:v) (f:work/home) (w:carry firewood/fetch wood) (d:<sing>, wood, with <puak>, carry: carry firewood home; said together with {lo khawh}, farming, for the daily work of village life) (j:sing/puak) (r:zd:21974/zd:16606/zd:22941) (q:draft)
singset = (i:1) (t:n) (f:work) (w:sawmill/timber mill) (d:<sing>, wood, and <set>, machine, written as one word: a mill where timber is sawn) (j:sing/set) (r:zd:20627/zd:12277) (q:draft)
