sang = (i:3) (t:adj) (f:everyday) (w:high) (d:high above the ground or in position, said of mountains, clouds and the sun; the opposite of <niam>, low) (s:sangpi) (a:niam)
sang = (i:2) (t:n) (f:education) (w:school) (s:sanginn)
sang = (i:4) (t:prep) (f:everyday) (w:than) (d:short form of <sangin>, placed after the thing compared, often as {sang in} and with <zaw> on the describing word: than, compared with) (s:sangin) (r:zd:25919/zd:20560) (q:draft)
sang = (i:5) (t:v) (f:social/religion) (w:accept/receive) (d:take or admit a person or what is offered, also written <saang>; not {sang}, high, and not {sang}, school) (s:saang) (r:zd:20920/zd:23271) (q:draft, low confidence)
sang akah = (i:1) (t:v) (f:education) (w:attend school/go to school/be a student) (d:<sang>, school, and <kah>, go up, with the subject marker <a> written onto the verb: he or she attends school, or one who attends school; the place stands before it with <ah> or <panin>, and {sang akah lai tak} is still at school now) (s:sangkah) (r:zd:19160/zd:20414) (q:draft)
sangaa = (i:1) (t:prep) (f:everyday) (w:than/more than) (d:<sang>, than, and <aa> written as one word after the thing compared, as {sang in}; {mi 10 sangaa a tam zaw} is more than ten people) (j:sang/aa) (r:zd:24141/zd:24226) (q:draft)
sangaa = (i:2) (t:adv) (f:everyday) (w:high) (d:<sang>, high, and the linking <aa> written as one word before a verb: {a sangaa leng} is fly high) (j:sang/aa) (r:zd:21918) (q:draft, low confidence)
sangah = (i:2) (t:adv) (f:education) (w:at school/to school/in school) (d:<sang.2>, school, with the place marker <ah>: at, in or to a school; told from {sangah}, on high, by a school name before it or by <kah>, <sangkah> or <sin> after it) (r:zd:20241/zd:25110/zd:23590) (q:draft)
Sangai = (i:1) (t:n) (c:animal) (f:nature) (w:deer) (d:a wild animal taken in hunting, probably a kind of deer; the Sangai Express is a newspaper of Imphal named after the sangai deer of Manipur) (r:ts:3168/ts:301) (q:draft, low confidence)
sangam = (i:1) (t:n) (f:family) (j:sanggam) (r:zd:20507/zd:21179) (q:draft)
sangamte = (i:1) (t:n) (f:family) (j:sanggamte) (r:zd:25768) (q:draft)
sangbangin = (i:1) (t:prep) (f:everyday) (w:than/rather than/compared with) (d:<sang>, than, and <bangin>, like, written as one word after the thing compared, usually with <zaw> on the word that follows: rather than, more than) (j:sang/bangin) (r:zd:19654/zd:24604) (q:draft, low confidence)
sangdawnding = (i:1) (t:phrase) (f:education/family) (w:to fetch from school) (d:<sang>, school, <dawn>, go to meet, and <ding>, in order to, written as one word, after the person fetched: to collect a child from school) (j:sang/dawn/ding) (r:zd:20629/zd:12669) (q:draft)
sangding = (i:1) (t:v) (f:everyday) (w:will be high) (d:<sang> and <ding> written as one word: will be high, said of a height that is estimated) (j:sang/ding) (r:zd:11229) (q:draft, low confidence)
sanggam = (i:1) (t:n) (f:family) (w:brother/sister) (d:a brother or sister, a child of the same parents; {sanggam pasal} is a brother and {sanggam numei} a sister)
sanggam = (i:3) (t:n) (f:social/religion) (w:brother/brethren/fellow member) (d:a fellow member of one’s people or church, not a relative by birth; often a form of address to hearers or readers, as <sanggam aw> and {sanggam u leh nau te}) (r:zd:24064/zd:20080/zd:12333) (q:draft)
sanggam aw = (i:1) (t:intj) (f:social/religion) (w:dear brother/dear sister/dear friend) (d:<sanggam>, brother or sister, and <aw>, here the calling word placed after the one addressed: a warm way to address a reader or hearer, at the start or end of a sentence, common in sermons and advice) (r:zd:18920/zd:12333) (q:draft)
sanggam laizom = (i:1) (t:n) (f:family) (w:full sibling/own brother or sister/siblings) (d:<sanggam>, brother or sister, and <laizom>, sibling of the same mother, said as a pair: a brother or sister of the same parents, or the brothers and sisters of one family together; stands after a possessive such as <ka> or <a>) (r:zd:20537/zd:24447) (q:draft)
sanggamkhat = (i:1) (t:n) (f:family) (w:own brothers and sisters/siblings of one family) (d:<sanggam> and <khat>, one, written as one word, after <unau>: brothers and sisters of one and the same family) (j:sanggam/khat) (r:zd:11433) (q:draft, low confidence)
sanggamnu = (i:1) (t:n) (f:family) (w:sister) (d:<sanggam> brother or sister with <nu>, which marks a woman: a sister) (a:sanggampa) (b:sanggam)
sanggampa = (i:1) (t:n) (f:family) (w:brother) (d:<sanggam> brother or sister with <pa>, which marks a man: a brother) (s:sangampa) (a:sanggamnu) (b:sanggam)
sangh = (i:2) (t:prep) (f:everyday) (w:than) (d:a spelling of <sang.4>, than: it follows the thing compared, and the describing word that comes after it carries <zaw>, as in {hih sangh anuam zaw}, more pleasant than this) (s:sangin) (r:zd:17047/zd:17208/zd:13291) (q:draft)
sanghoih = (i:1) (t:n) (f:education) (w:good school) (d:<sang>, school, and <hoih>, good, written as one word: a good school) (j:sang/hoih) (r:zd:26097/zd:23591) (q:draft)
sanghuangsung = (i:1) (t:n) (f:education) (w:school grounds/campus) (d:<sang>, school, and <huangsung>, the space inside an enclosure, written as one word: the grounds of a school or university) (j:sang/huangsung) (r:zd:12146/zd:13151) (q:draft)
sanginn huangsung = (i:1) (t:n) (f:education) (w:school grounds/school campus/school compound) (d:<sanginn>, school building, with <huangsung>, the space inside a fence: the grounds of a school or university, the campus) (r:zd:11995/zd:13151) (q:draft)
sanginnkhat = (i:1) (t:n) (f:education) (w:a school/one school) (d:<sanginn> and <khat> written as one word: a school, one school building) (j:sanginn/khat) (r:zd:15221/zd:15301) (q:draft)
sanginnlam = (i:1) (t:n) (f:education/travel) (w:way to school/direction of the school) (d:<sanginn>, school, and <lam>, side or direction, written as one word; with <zuan>, heading toward the school) (j:sanginn/lam) (r:zd:20629/zd:14848) (q:draft)
sanginnpi = (i:1) (t:n) (f:education) (w:school/school building/main school) (d:<sanginn>, school building, with the augmentative <pi>: a school and its large building, as {Tedim sanginnpi}, the school of Tedim) (j:sanginn/pi) (r:zd:19371/zd:19964) (q:draft, low confidence)
sanginnsung = (i:1) (t:phrase) (f:education) (w:inside the school/in school) (d:<sanginn>, school, and <sung>, inside, written as one word: inside the school, also before a noun as in {sanginnsung buaina}, trouble at a school) (j:sanginn/sung) (r:zd:17750/zd:17556) (q:draft)
sanginnte = (i:1) (t:n) (f:education) (w:schools/school buildings) (d:plural of <sanginn>, school) (b:sanginn) (r:zd:25107/ts:10764) (q:draft)
sangkah = (i:1) (t:v) (f:education) (w:attend school/go to school/study) (d:<sang>, school, with <kah>, go up: go to school, be a pupil or student; also as a noun, schooling) (r:zd:21876/zd:16820/zd:15681) (q:draft)
sangkahding = (i:1) (t:v) (f:education) (w:go to school/attend school) (d:<sang>, <kah> and <ding> written as one word: to attend school, in order to go to school; often followed by <in>) (j:sang/kah/ding) (r:zd:16688/zd:26495/zd:13186) (q:draft)
sangkahlai = (i:1) (t:v) (f:education) (w:be still at school/while studying) (d:<sangkah>, attend school, and <lai>, still or while, written as one word: be still a student, or at the time of attending school) (j:sangkah/lai) (r:zd:15186/zd:17204) (q:draft)
sangkahlo = (i:1) (t:v) (f:education) (w:not attend school/be absent from school) (d:<sangkah> and <lo> written as one word: not go to school, be absent from school or have no schooling) (j:sangkah/lo) (r:zd:12619/zd:21341) (q:draft)
sangkahna = (i:1) (t:n) (f:education) (w:schooling/school attendance/education) (d:<sang>, school, with <kah>, go up to or attend, and the noun ending {-na}: going to school, the schooling of a person) (r:zd:9228/zd:16216/zd:22429) (q:draft)
