telloh = (i:1) (t:v) (f:everyday/education) (w:not understand/not understood) (d:<tel> and the negative <loh> written as one word: not understanding, or what is not understood; {telloh a om leh} is if there is anything not understood) (j:tel/loh) (r:zd:15881/zd:20875) (q:draft)
telmel = (i:1) (t:v) (f:everyday) (w:understand properly/grasp clearly) (d:understand clearly what is said or meant; seen only as {telmel lopi in}, without really understanding; probably <tel>, understand, with a second element that strengthens it) (r:zd:22652/zd:22459) (q:draft, low confidence)
telpih = (i:1) (t:v) (f:social) (w:understand/appreciate/sympathize with) (d:<tel>, understand, with the suffix <pih>: understand what concerns someone, such as a hardship, an ability or a plan) (b:tel) (r:zd:22563/zd:22807) (q:draft, low confidence)
telsiam = (i:1) (t:v) (f:everyday/education) (w:understand well/understand) (d:<tel>, understand, with <siam>, skilled: understand rightly, grasp well; also be understanding toward someone) (j:tel/siam) (r:zd:19654/zd:20503/zd:23006) (q:draft)
telsiamna = (i:1) (t:n) (f:social/education) (w:understanding/comprehension) (d:<tel>, understand, with <siamna>, ability: the ability to understand a text, a matter or another person) (r:zd:19139/zd:24804/zd:24954) (q:draft)
teltak = (i:1) (t:adv) (f:everyday) (w:clearly/plainly/distinctly) (d:<tel> and <tak> written as one word, usually followed by <in>: clearly, so that it is well understood or seen) (s:teltakin) (j:tel/tak) (r:zd:19976/zd:20829/zd:20576) (q:draft)
teltal = (i:1) (t:adv) (f:everyday) (w:steadily/firmly/solidly) (d:descriptive word placed after a verb or adjective: staying firmly and plainly in place, as in {om teltal}, remain steadfast; of shape, small and plump or round) (r:zd:16425/zd:23043) (q:draft, low confidence)
teltuam = (i:1) (t:v) (f:religion/social) (w:choose specially/set apart/elect) (d:pick out and set apart from the rest; {Pasian teltuam} is chosen by God, God's chosen people; also of a member specially selected to a body) (s:teel) (r:zd:21183/zd:24120/zd:20319) (q:draft)
telzia = (i:1) (t:n) (f:education) (w:way of choosing/how to choose) (d:<tel>, here a spelling of <teel>, choose, with <zia>, way, written as one word: how to choose, as a subject of study) (j:teel/zia) (r:zd:20137/zd:20979) (q:draft)
telzia = (i:2) (t:n) (f:education/everyday) (w:way of understanding/understanding) (d:<tel>, understand, with <zia>, way, written as one word: how a matter is understood) (j:tel/zia) (r:zd:21018) (q:draft, low confidence)
telzo = (i:1) (t:v) (f:everyday/education) (w:be able to understand/grasp/comprehend) (d:<tel>, understand, with <zo>, be able, written as one word; {telzo lo} is not be able to understand) (j:tel/zo) (r:zd:17313/zd:17577/zd:25186) (q:draft)
tem = (i:1) (t:n) (f:home) (w:knife/blade) (d:a knife or blade for cutting) (s:temta) (r:6.5.3) (q:draft)
tembawpi = (i:1) (t:n) (f:travel) (w:ship/large ship) (d:<tembaw>, ship, with <pi>, big: a large ship such as a liner or a warship) (s:gunkuangpi) (b:tembaw) (r:zd:19661/zd:23676) (q:draft)
tembawte = (i:1) (t:n) (f:travel) (w:ships/boats) (d:<tembaw>, ship, with the plural <te>) (b:tembaw) (r:zd:22970/zd:22650) (q:draft)
temperature = (i:1) (t:n) (f:nature/health) (w:temperature) (d:degree of heat or cold of the weather or of the body, given in degrees) (o:English) (r:zd:17241/zd:12831/zd:11236) (q:draft)
Temple = (i:1) (t:n) (f:religion) (w:temple) (d:a temple of a religion other than Christianity, such as a Hindu or Buddhist temple; a Christian church is <biakinn>) (o:English) (r:zd:17164/zd:11803) (q:draft)
temta = (i:1) (t:n) (f:home) (w:knife/razor) (d:a knife; also a small knife for cutting a scroll and a razor for shaving) (s:tem) (b:tem) (q:draft)
temtawh = (i:1) (t:adv) (f:everyday/media) (w:with a knife/by the knife) (d:<tem> and <tawh> written as one word: with a knife, by means of a knife; in news reports before verbs of stabbing and cutting) (j:tem/tawh) (r:zd:20537/zd:16811) (q:draft)
temtawi = (i:1) (t:adj) (f:politics/media) (w:armed with a knife/knife-wielding) (d:<tem>, knife, and <tawi>, hold, written as one word: holding a knife, said of a person; {pasal temtawi} or {temtawi pasal} is a man with a knife) (j:tem/tawi) (r:zd:12649/zd:21599) (q:draft)
temtawipa = (i:1) (t:n) (f:politics/social) (w:knifeman/man with a knife) (d:<tem> and <tawipa> written as one word: the man holding a knife, in news the attacker armed with a knife) (j:tem/tawipa) (r:zd:15537/zd:12649) (q:draft)
temteh = (i:1) (t:n) (f:home) (w:scissors/shears) (d:a tool with two blades for cutting hair, cloth or paper) (r:zd:13016) (q:draft)
tender = (i:1) (t:n) (f:work/politics) (w:tender/bid) (d:an offer to carry out public work for a stated price, and the contract that the government gives to the company that wins; {tender ngah} is win a tender) (o:English) (r:zd:16724/zd:10863) (q:draft)
teng = (i:1) (t:v) (f:everyday/home) (w:live/dwell/settle) (d:have a home in a place or settle there; {teng uh hi} is they lived or settled) (s:teeng)
tengh = (i:1) (t:num) (f:work) (w:lakh/hundred thousand) (d:a hundred thousand, used in counting Myanmar kyats: {tengh 100} is ten million kyats) (s:lakhs/tulza) (o:Burmese) (r:zd:25146/zd:25287/zd:25135) (q:draft)
tengmah = (i:1) (t:det) (f:everyday) (w:all of/every one of) (d:<teng>, all, and the emphatic <mah> written as one word and placed after a noun phrase: all of those, those very ones without exception) (j:teng/mah) (r:zd:17309/zd:25919) (q:draft)
tengpen = (i:1) (t:phrase) (f:everyday) (w:all of these/all those) (d:<teng>, all of the ones named, with the topic marker <pen>, written as one word after a noun or number: all of those, as the topic of the sentence) (r:zd:15317/zd:11635/zd:11148) (q:draft)
tengtawh = (i:1) (t:phrase) (f:everyday) (w:with all that/in that state) (d:<teng>, all of those, and <tawh>, with, written as one word; <tuabang tengtawh> is in that condition, with all that) (r:zd:21850/zd:19810) (q:draft)
tengzong = (i:1) (t:adv) (f:everyday) (w:all also/even all) (d:<teng>, here in its sense of all of, with <zong>, also, written as one word: placed after a noun, all of it too, the whole of them as well) (j:teng/zong) (r:zd:13324/zd:13129/zd:12717) (q:draft)
tenih = (i:1) (t:phrase) (f:everyday) (w:the two/both) (d:<te> and <nih> written as one word, after a noun: the two of them; {hih numei tenih} is these two women) (j:te/nih) (r:zd:19396/zd:12290) (q:draft)
Tennessee = (i:1) (t:name) (c:land) (f:travel) (w:Tennessee) (d:state of the United States of America) (o:English) (r:zd:10667/zd:24648) (q:draft)
Tennis = (i:1) (t:n) (f:media) (w:tennis) (d:the game of tennis; mostly in the English name Table Tennis, table tennis) (o:English) (r:zd:24141/zd:23005) (q:draft)
tepan = (i:1) (t:phrase) (f:everyday/media) (w:from) (d:<te> and <pan> written as one word after a plural noun: from them, from those named, as in {News tepan kiza hi}, it is heard from the news agencies) (j:te/pan) (r:zd:17872/zd:16247/zd:11644) (q:draft)
tepawl = (i:1) (t:n) (f:everyday) (w:the kind of/such as/and the like) (d:<te> and <pawl> written as one word, placed after a name, noun or clause: those of that kind, people or things such as these; after a personal name, that person and those with him) (j:te/pawl) (r:zd:25687/zd:25909/zd:21022) (q:draft)
tepen = (i:1) (t:part) (f:everyday) (d:the plural <te> and the topic marker <pen> written as one word after a noun: marks several people or things as what the sentence is about) (j:te/pen) (r:zd:11844/zd:21552) (q:draft)
Terengganu = (i:1) (t:name) (c:land) (f:travel) (w:Terengganu) (d:a state on the east coast of the Malay Peninsula, in Malaysia) (r:zd:19902/zd:15165) (q:draft)
term = (i:1) (t:n) (f:politics/work) (w:term/term of office) (d:the fixed length of time for which a person or a government holds office, the English word; {term khat} is one term) (o:English) (r:zd:12414/zd:9221/zd:24677) (q:draft)
Terminal = (i:1) (t:n) (f:travel) (w:terminal) (d:a bus station or a building of an airport, mostly as {Bus Terminal} or with a number) (o:English) (r:zd:21294/zd:12494) (q:draft, low confidence)
terrorism = (i:1) (t:n) (f:politics) (w:terrorism) (d:violence used against ordinary people for a political aim, explained in Zolai as {hiam gamtatna}; it occurs mostly in English phrases such as {International Terrorism}) (o:English) (r:zd:17147/zd:12222) (q:draft, low confidence)
terrorist = (i:1) (t:n) (f:politics) (w:terrorist) (d:a person who uses violence against ordinary people for a political or religious aim, the English word; often followed by <migilo>, evildoer) (o:English) (r:zd:20250/zd:13100) (q:draft)
Terrorists = (i:1) (t:n) (f:politics) (w:terrorist) (d:the English plural used as a Zolai noun for one or more terrorists, mostly followed by <te>; often explained by <migilo>, evil men) (o:English) (r:zd:20129/zd:12307) (q:draft)
test = (i:1) (t:n) (f:health/education) (w:test/examination) (d:a check made to find something out, such as a medical test or a test of ability; <test bawl> is do a test) (o:English) (r:zd:15437/zd:23933) (q:draft)
test = (i:2) (t:v) (f:health) (w:test/be tested) (d:carry out a test on someone or something, or take a test oneself) (o:English) (r:zd:24454/zd:23659) (q:draft)
test bawl = (i:1) (t:v) (f:health) (w:test/do a test/get tested) (d:the English word <test> and <bawl>, make or do: to carry out a test or to have oneself tested, in the news mostly a medical test for a disease; the kind of test stands before it) (r:zd:24648/zd:23851) (q:draft)
testimony = (i:1) (t:n) (f:religion) (w:testimony) (d:a personal account of faith or of what one has witnessed) (o:English) (r:zd:25056/zd:24055) (q:draft, low confidence)
testing = (i:1) (t:n) (f:health) (w:testing/test) (d:the testing of people for a disease, mostly with <bawl>, do) (o:English) (r:zd:24489/zd:24369) (q:draft, low confidence)
teta = (i:1) (t:adv) (f:everyday) (w:steadily/firmly/persistently) (d:placed after a verb: keep on doing it without letting go or giving up, as in {ngak teta}, keep waiting, and {semsuak teta}, carry the work through) (r:zd:16412/zd:12267) (q:draft, low confidence)
tetawh = (i:1) (t:ppm) (f:everyday) (w:with/with the) (d:<te>, the plural marker, and <tawh>, with, written as one word after a noun: together with those people or things; {tetawh kisai in} is concerning them) (j:te/tawh) (r:zd:16688/zd:14947/zd:15566) (q:draft)
tetawhzong = (i:1) (t:phrase) (f:everyday) (w:also with/with them too) (d:the plural <te>, <tawh>, with, and <zong>, also, written as one word after a noun: with those too) (j:te/tawh/zong) (r:zd:15374/zd:11495/zd:12843) (q:draft)
tetek = (i:1) (t:adv) (f:everyday) (w:more and more/steadily/increasingly) (d:placed after a verb or describing word: the state grows or continues step by step, as in {khanto tetek}, keep on growing) (r:zd:23241/zd:16157/zd:24750) (q:draft)
teti = (i:1) (t:n) (f:social/religion) (j:teci) (r:zd:24598/zd:17673) (q:draft)
tettan = (i:1) (t:n) (f:social/politics) (w:validity period/term/validity) (d:the length of time for which a card, permit or office is valid; {tettan bei} is expired and {tettan tuu} is to extend or renew it) (o:Burmese, thettan) (r:zd:13287/zd:11289/zd:13066) (q:draft)
tetti = (i:1) (t:n) (f:religion/politics) (w:testimony/evidence/witness) (d:what a person tells of what he has seen or lived through, and proof for a claim; {tetti panna} is the giving of a testimony, as in church, and one writer keeps <teci> for witness and {tetti} for testimony) (r:zd:24055/zd:23394/zd:19262) (q:draft)
tetung = (i:1) (t:phrase) (f:everyday) (w:to/upon/on) (d:the plural marker <te> and <tung>, upon, written as one word after a noun: to or upon those people, as an announcement or a request directed to them) (j:te/tung) (r:zd:11175/zd:19373) (q:draft)
Texas = (i:1) (t:name) (c:land) (f:travel) (w:Texas) (d:a state in the south of the United States of America) (r:zd:14942/zd:24691) (q:draft)
textbook = (i:1) (t:n) (f:education) (w:textbook) (d:a book written for teaching a subject in school or college) (o:English) (r:zd:9244/zd:9263/zd:9232) (q:draft)
tezong = (i:1) (t:part) (f:everyday) (w:also/too) (d:the plural marker <te> and <zong>, also, written as one word after a noun: they also, those too) (j:te/zong) (r:zd:11508/zd:11615/zd:16026) (q:draft)
tha kingah = (i:1) (t:v) (f:social/everyday) (w:be encouraged/be heartened/gain strength) (d:<tha>, strength, with <kingah>, be obtained: one is encouraged or given new heart by something heard or seen; the people who feel so stand before it with <in>) (r:zd:11447/zd:16173/zd:20587) (q:draft)
tha kipia = (i:1) (t:v) (f:social/everyday) (w:encourage oneself/encourage one another/be encouraged) (d:<tha>, strength, and <kipia>, the form of <pia>, give, with {ki-}: give strength to oneself or to one another, take heart, the reflexive of <thapia>; {amah leh amah} or {ei leh ei} often stands before it) (r:zd:14554/zd:23742) (q:draft)
thaang = (i:1) (t:n) (f:nature) (j:thang) (r:zd:15942) (q:draft, low confidence)
thabei = (i:1) (t:v) (f:body/health) (w:be exhausted/be weak/lose strength) (d:<tha>, strength, with <bei>, come to an end: have no strength left, from tiredness, hunger or illness; also the noun weakness, as a sign of illness) (r:zd:10893/zd:13243/zd:25918) (q:draft)
thagum tawh = (i:1) (t:adv) (f:everyday) (w:by force/forcibly) (d:{thagum}, force or strength, and <tawh>, with: by force, against the will of the person concerned; placed before the verb, as in {thagum tawh sawl}, to compel) (r:zd:9124/zd:18102) (q:draft)
thahat = (i:2) (t:adj) (f:everyday/body) (w:strong) (d:having strength of body or of faith; {thahat un} is the command be strong, and {thahat lote} are the weak) (s:hat/thakhauh) (a:thanem/thaneem)
thahding = (i:1) (t:v) (f:politics/everyday) (w:to kill/will kill) (d:<thah>, kill, and <ding>, will, written as one word: to kill, in order to kill; {thahding in thukhen} is sentence to death) (j:thah/ding) (r:zd:15941/zd:15080) (q:draft)
Thahdo = (i:1) (t:name) (c:people) (f:social) (w:Thadou/Thado) (d:a Kuki people of Manipur and the Kabaw valley, and their language) (r:zd:24303/zd:19080) (q:draft)
thahlupna = (i:1) (t:n) (f:social/politics) (w:killing/slaughter/murder) (d:<thahlup>, kill outright, with the noun ending {-na}: the killing of a person or animal, or the place where it was killed) (s:thahna) (b:thahlup) (r:zd:12053/zd:14859) (q:draft)
thahlupsawm = (i:1) (t:v) (f:everyday) (w:try to kill/attempt to kill) (d:<thahlup> and <sawm> written as one word: intend or attempt to kill; {amahleh amah ki thahlupsawm} is attempt to kill oneself) (j:thahlup/sawm) (r:zd:11477/zd:12450) (q:draft)
thai kumpi = (i:1) (t:n) (f:politics) (w:Thai government/Thai authorities) (d:{Thai}, of Thailand, and <kumpi>, king, in the news the government: the government of Thailand; a country name before <kumpi> names the government of that country, and it is followed by <in> as the subject or by {thunei te}, the authorities) (r:zd:11931/zd:19442) (q:draft)
Thailand = (i:1) (t:name) (c:land) (f:travel/politics) (w:Thailand) (d:country in Southeast Asia, east of Myanmar) (r:zd:20889/zd:19100/zd:19285) (q:draft)
thak = (i:1) (t:adj) (f:everyday) (w:new/fresh) (d:new, not old or used before, also fresh; placed after the noun, as in {la thak}, a new song) (a:lui) (r:42.5.38) (q:draft)
thakkhat = (i:1) (t:phrase) (f:everyday) (w:a new/a new one) (d:<thak> and <khat> written as one word, after a noun: a new one, as in {ngaihsutna thakkhat}, a new idea) (j:thak/khat) (r:zd:22282/zd:11504) (q:draft)
thakpen = (i:1) (t:adj) (f:everyday) (w:the new/newest) (d:<thak>, new, and <pen> written as one word after a noun: the new one, as the thing the sentence is about; in some sentences it can also be read as the newest) (j:thak/pen) (r:zd:11587/zd:15517) (q:draft, low confidence)
thakthak = (i:1) (t:adj) (f:everyday) (w:new/ever new/various new) (d:<thak>, new, doubled: new ones one after another, new things of many kinds, often as {a thakthak}; after a verb, afresh) (b:thak) (r:zd:12948/zd:21605/zd:15652) (q:draft)
thala = (i:1) (t:v) (f:everyday/social) (w:take courage/take heart/be encouraged) (d:<tha> strength taken up: draw strength or courage from something, the opposite of <lungkia>) (r:zd:19245/zd:20697) (q:draft)
thalakna = (i:1) (t:n) (f:social/media) (w:encouragement/inspiration) (d:<tha>, strength, with <lakna>, taking: drawing strength or courage from a story, a life or a word, common in titles as {tungpan thalakna}, encouragement drawn from) (j:tha/lakna) (r:zd:20801/zd:20058) (q:draft)
thalawpna = (i:1) (t:n) (f:everyday/social) (w:enthusiasm/zeal/morale/motivation) (d:eagerness and energy for a task, the noun of <thalawp>) (b:thalawp) (r:zd:16695/zd:23554/zd:21362) (q:draft)
Thalmual = (i:1) (t:name) (c:khua) (f:travel/social) (w:Thalmual) (d:a Zomi village; written after the name of a person it shows the village the person comes from) (r:zd:23054/zd:24297) (q:draft)
thamloh = (i:1) (t:part) (f:everyday) (j:thamlo) (r:zd:17883/zd:24545/zd:22785) (q:draft)
thamloin = (i:1) (t:conj) (f:everyday) (w:not only/besides) (d:<thamlo> and <in> written as one word, after <bek>: {tua bek thamloin} opens a sentence as not only that, moreover) (j:thamlo/in) (r:zd:14927/zd:22336) (q:draft)
thampi = (i:1) (t:n) (c:animal) (f:nature) (w:python) (d:a very large snake that kills by coiling around its prey and swallows it whole) (r:zd:12434/zd:11350) (q:draft)
thamtham = (i:1) (t:adv) (f:everyday) (w:by far/far more/considerably) (d:placed after a comparison with <zaw> or after an amount: by a wide margin, well beyond) (r:zd:20875/zd:25353/zd:12487) (q:draft)
thanem = (i:1) (t:adj) (f:everyday/body) (w:weak/feeble) (d:<tha> strength with <nem> soft: having little strength) (s:thaneem/zawngkhal) (a:thahat/hat) (r:23.16.14) (q:draft)
thanemnate = (i:1) (t:n) (f:everyday/social) (w:weaknesses/failings/shortcomings) (d:<thanemna>, weakness, with the plural <te>) (b:thanemna) (r:zd:13076/zd:22858/zd:21166) (q:draft)
thangah huai = (i:1) (t:adj) (f:social/everyday) (w:gratifying/exciting/admirable/heartening) (d:<thangah>, here a verb, be thrilled, feel glad and proud, not the noun in a trap, with <huai>, worthy of: giving cause for joy and pride; {thangah huai sa} is find something gratifying, {thangah huai takin} is in a rousing way) (r:zd:24563/zd:22925/zd:17824) (q:draft, low confidence)
Thangkai = (i:1) (t:name) (c:place) (f:travel) (w:Thangkai) (d:name of a village tract, {Thangkai kual}, in Tedim township, and of its community association and football team abroad) (r:zd:24049/ts:12403) (q:draft, low confidence)
Thangmual = (i:1) (t:name) (c:mountain) (f:travel/nature) (w:Thangmual/Fort White) (d:a mountain ridge and former fort on the road from the Kale plain up to Tedim in Chin State, called Fort White in English) (r:zd:24227/zd:23428/zd:11347) (q:draft)
thangpaih = (i:1) (t:v) (f:everyday/social) (w:be angry/be indignant/resent) (d:form of <thangpai>, be angry, used before endings and following words such as {-na}, <huai> and <kei>; {thangpaih huai} is infuriating) (s:heh) (b:thangpai) (r:zd:23538/zd:22874/zd:18081) (q:draft)
Thantlang = (i:1) (t:name) (c:khua) (f:travel/politics) (w:Thantlang) (d:town and township in Chin State in Myanmar, west of Hakha) (r:ts:8728/zd:24595) (q:draft)
thapaai = (i:1) (t:adv) (f:everyday) (j:thapai) (r:zd:24231/zd:10777) (q:draft, in the articles also after other verbs than night and day: continually, on and on)
thapaih = (i:1) (t:adv) (f:everyday) (w:over and over/continually/keep on) (d:placed after a verb: keep on doing the same thing, again and again without change, as {et thapaih}, keep looking at; related to <thapai>) (r:zd:25919/zd:17618/zd:24311) (q:draft, low confidence)
thapia = (i:1) (t:v) (f:social/everyday) (w:encourage/support) (d:<tha>, strength, and <pia>, give, written as one word: give strength to someone by words or help, encourage, back up) (j:tha/pia) (r:zd:15384/zd:22658/zd:23422) (q:draft)
thapiak = (i:1) (t:v) (f:social) (w:encourage/support/give strength) (d:<tha>, strength, and <piak>, give, written as one word: give someone courage or support; the form used before <ding> and other endings, and as a noun encouragement) (j:tha/piak) (r:zd:21908/zd:19245/zd:17979) (q:draft)
thapiakna = (i:1) (t:n) (f:social) (w:encouragement/support) (d:{tha pia}, give strength, with the noun suffix <na>: words or help that give someone heart) (r:zd:19729/zd:22590/zd:16312) (q:draft)
thasan = (i:1) (t:v) (f:everyday/work) (w:strive/exert oneself/make an effort) (d:put one's strength into something, <tha> strength; {thasan ni} is let us press on) (s:hanciam) (r:zd:12167/zd:21661/zd:24236) (q:draft)
thasial = (i:1) (t:v) (f:everyday/work) (w:be reluctant/hold back/spare oneself) (d:be unwilling to spend one's <tha>, strength, on something; mostly negated, as in {thasial lo}, without holding back, willingly) (r:zd:23090/zd:24854/zd:23348) (q:draft)
thatding = (i:1) (t:v) (f:politics/everyday) (w:will kill/to kill) (d:<that>, kill, with the future marker <ding> written as one word: will kill, in order to kill) (j:that/ding) (r:zd:21201/zd:11848) (q:draft)
thau lawng = (i:1) (t:n) (f:politics) (w:gun/firearm/rifle) (d:<thau>, here gun, and <lawng>, here the counting word for guns: a gun as one piece; a number follows, {thau lawng 6}, six guns) (r:ts:1822/ts:301) (q:draft)
thauging = (i:1) (t:n) (f:everyday/politics) (w:gunshot/sound of gunfire) (d:<thau>, gun, with <ging>, sound: the sound of a gun being fired) (r:zd:20049/ts:5396/zd:12845) (q:draft)
thaukap = (i:1) (t:n) (f:politics) (w:shooting/gunfire/gunman/shooter) (d:<thau>, here gun, with <kap>, shoot: the firing of a gun, and the person who fires; {thaukap pa} is the gunman and {thaukap siam} a marksman) (r:zd:16406/zd:24001) (q:draft)
thaukappa = (i:1) (t:n) (f:social/media) (w:gunman/shooter) (d:the man who shoots with a gun: <thau>, here gun and not fat, with <kappa>, shooter) (j:thau/kappa) (r:zd:20219/zd:19868) (q:draft)
thaukikap = (i:1) (t:n) (f:politics/media) (w:shooting/gunfire) (d:<thau>, here a gun, and <kikap>, be shot, written as one word: a shooting, an exchange of gunfire) (j:thau/kikap) (r:zd:17748/zd:14919) (q:draft)
thaukikapna = (i:1) (t:n) (f:politics/media) (w:shooting/gunfire/gunfight) (d:<kikapna>, shooting at one another, with the word for gun before it: a shooting incident or an exchange of gunfire) (b:kikapna) (r:zd:20252/zd:12146) (q:draft)
thaulua = (i:1) (t:adj) (f:body/health) (w:too fat/overweight/obese) (d:<thau> and <lua> written as one word: too fat) (j:thau/lua) (r:zd:23972/zd:21306) (q:draft)
thauluatna = (i:1) (t:n) (f:health/body) (w:obesity/being overweight/excess fat) (d:<thau>, fat, and <luatna>, excess, written as one word: being too fat) (j:thau/luatna) (r:zd:20747/zd:22019) (q:draft)
thaumuk = (i:1) (t:n) (f:politics) (w:gun barrel/muzzle/the gun) (d:<thau>, here gun, with <muk>, mouth: the muzzle of a gun; it stands for armed force, as in {thaumuk tawh uk}, rule by the gun) (r:zd:22992/zd:25043/zd:20673) (q:draft)
thauneu = (i:1) (t:n) (f:politics) (w:handgun/pistol/small arms) (d:<thau>, gun, with <neu>, small: a pistol or revolver, and in war reports small arms as against <thaupi>, heavy guns) (a:thaupi) (r:zd:10735/ts:7798/zd:19973) (q:draft)
thaupi = (i:1) (t:n) (f:politics) (w:cannon/artillery/heavy weapon) (d:a big gun; <thau>, gun, with <pi>, big: artillery, and in news also a missile or rocket) (r:ts:5913/ts:5480/ts:7798) (q:draft)
thautang = (i:1) (t:n) (f:politics) (w:bullet/cartridge/ammunition) (d:the shot fired from a gun; {thau leh thautang} is guns and ammunition) (r:zd:12274/ts:9163/zd:12621) (q:draft)
thautawh = (i:1) (t:adv) (f:politics/everyday) (w:with a gun/by shooting) (d:<thau>, here in the sense gun, and <tawh>, with, written as one word: with a gun, mostly before <kap>, shoot) (j:thau/tawh) (r:zd:18030/zd:12437) (q:draft)
thautawi = (i:1) (t:n) (f:politics) (w:armed person/gunman/armed group) (d:the word for gun with <tawi>, carry: one who carries a gun; before a noun it means armed, as in <thautawi kipawlna>, armed organisation, and <mualmi thautawi> is an ethnic armed group) (r:zd:25043/zd:21262/zd:19308) (q:draft)
thautawi kipawlna = (i:1) (t:n) (f:politics) (w:armed organisation/armed group) (d:<thautawi>, one who carries a gun, armed, and <kipawlna>, organisation: an armed organisation, the usual term for the ethnic and resistance armies of Myanmar; {minam thautawi kipawlna} is an ethnic armed organisation) (r:zd:25043/zd:21509/zd:25562) (q:draft)
thautawi migilo = (i:1) (t:n) (f:politics/media) (w:gunman/armed criminal/armed militant) (d:<thautawi>, one who carries a gun, and <migilo>, wicked person: an armed attacker, used in news for gunmen, armed robbers and armed militant groups; <te> follows for the plural) (r:zd:12159/zd:17032) (q:draft)
thautawipa = (i:1) (t:n) (f:politics) (w:gunman/armed man) (d:<tawipa>, the man who carries, after the word for gun: a man carrying a gun, the shooter in a report of a shooting) (r:zd:15170) (q:draft)
thautawite = (i:1) (t:n) (f:politics) (w:armed groups/armed men/gunmen) (d:plural of <thautawi>, one who carries a gun: armed men, and in news of Myanmar the armed groups of the ethnic peoples, {minam thautawite}) (b:thautawi) (r:ts:6525/zd:24966) (q:draft)
thauvan = (i:1) (t:n) (f:politics) (w:firearm/gun/weapon) (d:<thau>, here gun, with <van>, here goods: guns and the things that belong to them, firearms) (r:zd:22298/zd:15554) (q:draft)
thauvui = (i:1) (t:n) (f:politics/work) (w:gunpowder/explosive/ammunition) (d:the powder that fires a gun or makes a bomb explode; <thauvui thautang> is powder and bullets, ammunition) (r:zd:22371/zd:24532/ts:7742) (q:draft)
thauvui thautang = (i:1) (t:n) (f:politics) (w:ammunition/arms and ammunition/munitions) (d:<thauvui>, gunpowder, and <thautang>, bullet, set side by side without <leh>: ammunition, and more loosely firearms and armed force; often after <galvan>, weapons) (r:zd:22371/zd:14696) (q:draft)
thawlhawm = (i:1) (t:n) (f:home) (w:empty bottle) (d:<thawl>, bottle, and <hawm>, empty, written as one word: an empty bottle, as collected and sold again) (j:thawl/hawm) (r:zd:22805/zd:21330) (q:draft)
thaza = (i:1) (t:n) (f:health/food) (w:tonic/supplement/vitamin) (d:<tha>, strength, with the first part of <zatui>, medicine: something taken to build up strength, a tonic or vitamin) (r:zd:19593/zd:15857/zd:16695) (q:draft)
thehzak = (i:1) (t:v) (f:media/everyday) (w:scatter/spread about/strew) (d:scatter or spread over a wide area; mostly with <ki> as {ki thehzak}, the same as <kithehzak>: be scattered about, and of a video or a piece of news, be spread widely) (s:thehthang) (r:zd:17375/zd:17164/zd:17677) (q:draft)
thehzakgawp = (i:1) (t:v) (f:media/it) (w:spread widely/go viral/scatter all over) (d:<thehzak>, scatter, with <gawp>, thoroughly; with the prefix <ki>, mostly written apart, be spread everywhere, said of a video or photo that goes viral on social media; compare <kithehzak>) (j:thehzak/gawp) (r:zd:20490/zd:17886) (q:draft)
thehzakpah = (i:1) (t:v) (f:media/it) (w:spread at once/go viral) (d:written after <ki>, as {ki thehzakpah}: <kithehzak>, be scattered, with <pah>, at once; of a photo, video or piece of news, spread quickly and widely on social media) (r:zd:14981/zd:13326/zd:18125) (q:draft)
thei = (i:1) (t:v) (f:everyday) (w:know) (d:know a person, a fact or a way; {thei kei} is not know) (a:theilo)
thei = (i:2) (t:adj) (f:everyday) (w:able/capable of/qualified to) (d:placed after a verb: able to do it, can; {thei lo} is unable) (a:theilo)
thei keng = (i:1) (t:phrase) (f:everyday) (w:I do not know/I cannot) (d:<thei>, know or be able, and <keng>, here not the verb carry but the negative <kei> run together with <ing>, the ending of the first person: I do not know, closing a sentence, often after a question clause; after another verb, I cannot) (r:zd:13217/zd:20618/zd:23281) (q:draft)
theician = (i:1) (t:v) (f:everyday/education) (w:know clearly/know for certain/know exactly) (d:<thei>, know, with <cian>, clearly: know exactly; {ki theician nailo} is it is not yet known for certain) (r:zd:11564/zd:21063/zd:10939) (q:draft)
theicianlo = (i:1) (t:v) (f:everyday/media) (w:not know clearly/be unclear/be unconfirmed) (d:<thei>, know, <cian>, clearly, and <lo>, not, written as one word; in news reports {ki theicianlo hi} is it is not known for certain) (j:thei/cian/lo) (r:zd:12776/zd:12290/zd:15255) (q:draft)
theiden = (i:1) (t:adv) (f:everyday) (w:can always/always able) (d:<thei> and <den> written as one word, placed after a verb: always able to do it, can at any time) (j:thei/den) (r:zd:20964/zd:10892) (q:draft)
theiding = (i:1) (t:v) (f:everyday) (w:will be able/can/will know) (d:<thei> and <ding> written as one word: after a verb, will be able to, so as to be able to; alone, will know) (j:thei/ding) (r:zd:22850/zd:19320/zd:24271) (q:draft)
theih nadingin = (i:1) (t:conj) (f:everyday) (w:so that it may be possible/in order to be able to) (d:<theih>, be able, and <nadingin>, in order to: placed after a verb, so that it can be done, in order to be able to do it; by itself after an object, so that it may be known) (r:zd:24673/zd:16779) (q:draft)
theih nadingun = (i:1) (t:conj) (f:everyday) (w:so that they can/so that they may know) (d:<theih>, know or be able, and <nadingun>, in order that, with a plural subject: placed after a verb it closes a clause of purpose, so that they can do it; after a noun as object, so that they may know it) (s:theih nadingin) (r:zd:11891/zd:22040) (q:draft)
theih nangin = (i:1) (t:conj) (f:everyday) (w:so that one can/in order to be able to) (d:<theih>, be able, with <nangin>, here a short form of <nadingin>, in order to, and not the pronoun you: placed after a verb, so that the action can be done; the same as <theih nadingin>) (r:zd:20410/zd:23935/zd:19953) (q:draft)
theihbeh = (i:1) (t:v) (f:everyday/education) (w:know more/learn more/find out more) (d:<theih>, know, with the ending {-beh}, more, in addition: come to know more; {theihbeh nop a om leh} is if anyone wishes to know more) (r:zd:16928/zd:19435) (q:draft)
theihbehnop = (i:1) (t:v) (f:everyday/media) (w:want to know more) (d:<theihnop>, want to know, and {theih beh}, know further, written as one word: wish to know more about a matter) (r:zd:22778/zd:23155) (q:draft)
theihcian = (i:1) (t:v) (f:everyday/education) (w:know clearly/know for certain/understand fully) (d:<theih>, know, and <cian>, clearly, written as one word: know a thing exactly and for certain; {ki theihcian} is be found out for certain) (j:theih/cian) (r:zd:9429/zd:16625/zd:12906) (q:draft)
theihding = (i:1) (t:v) (f:everyday/education) (w:to know/be able to) (d:<theih> and <ding> written as one word: what is to be known, things one should know; after another verb, so as to be able to) (j:theih/ding) (r:zd:20035/zd:23108/zd:25932) (q:draft)
theihhuai = (i:1) (t:adj) (f:everyday/media) (w:worth knowing/good to know/noteworthy) (d:<theih>, know, and <huai>, worthy of, written as one word: that ought to be known; {a theihhuai} is the things worth knowing) (j:theih/huai) (r:zd:11702/zd:20595/zd:16949) (q:draft)
theihi = (i:1) (t:v) (f:everyday) (w:can/be able/be possible) (d:<thei>, able, and the sentence-final <hi> written as one word after a verb: closes a statement that something can be done or may happen) (j:thei/hi) (r:zd:22695/zd:12736/zd:11251) (q:draft)
theihiam = (i:1) (t:phrase) (f:everyday) (d:<thei>, can, and the question particle <hiam> written as one word: could it, how could it; closes an indirect question, as in {banghangin puakkham theihiam}, why it could explode) (j:thei/hiam) (r:zd:11897/zd:22717) (q:draft)
theihkei = (i:1) (t:v) (f:everyday) (w:cannot/be unable) (d:<theih>, be able, and the negative <kei> written as one word, after a verb and mostly before <leh>, if: {theihkei leh} is if one cannot) (j:theih/kei) (r:zd:25932/zd:20875/zd:20801) (q:draft)
theihleh = (i:1) (t:v) (f:everyday) (w:if able/if possible) (d:<theih> and <leh> written as one word: if one can; {ahih theihleh} is if possible) (j:theih/leh) (r:zd:19846/zd:22543) (q:draft)
theihlo = (i:1) (t:v) (f:everyday) (w:not know/unknown) (d:<theih> know and <lo> not written as one word: not knowing, not known, without someone knowing) (j:theih/lo) (r:zd:23479/zd:12096) (q:draft)
theihloh = (i:1) (t:v) (f:everyday) (w:not know/be unable/cannot) (d:<theih> and <loh> written as one word, the form of {thei lo} used before a noun or <ding>: after a verb, that cannot be done; alone, not knowing or what is not known) (j:theih/loh) (r:zd:23896/zd:24186/zd:23882) (q:draft)
theihloh kalin = (i:1) (t:adv) (f:everyday) (w:unawares/without noticing/before one knows it) (d:<theihloh>, not knowing, and <kalin>, while: while one does not know or notice, unawares; stands at the head of a clause or after a subject marker, as in {i theihloh kalin}, without our noticing) (r:zd:20264/zd:24217/zd:24375) (q:draft)
theihlohkal = (i:1) (t:adv) (f:everyday) (w:unawares/without knowing/unnoticed) (d:<theih>, know, <loh>, not, and <kal>, interval, written as one word: while someone does not know or notice; after a possessive and before <in>, as in {na theihlohkal in}, without your noticing) (j:theih/loh/kal) (r:zd:22474/zd:14792) (q:draft)
theihna dingin = (i:1) (t:conj) (f:everyday) (w:so that it may be possible/in order to be able to) (d:<theihna>, here being able, and <dingin>, in order to: placed after a verb, so that it can be done; another way of writing <theih nadingin>) (r:zd:22151/ts:5396) (q:draft)
theihna dingun = (i:1) (t:conj) (f:everyday) (w:so that they can/in order that they may) (d:<theihna>, here not knowledge but <thei>, be able, with <na>, and <dingun>, for them to: placed after a verb with <a> before it, so that they may be able to do it) (r:zd:23191/zd:22849) (q:draft)
theihnading = (i:1) (t:phrase) (f:everyday) (w:so as to be able to/in order to know) (d:<theih> and <nading> written as one word: after a verb, so that it can be done, in order to be able to; after a noun, in order to know it) (j:theih/nading) (r:zd:17527/zd:23590/zd:15035) (q:draft)
theihnang = (i:1) (t:phrase) (f:everyday) (w:so that one can/in order to be able) (d:<theih>, be able, with <nang>, a short form of <nading>, written as one word after a verb: so that it can be done, in order to be able to) (j:theih/nading) (r:zd:11224/zd:14615/zd:16428) (q:draft)
theihpihna = (i:1) (t:n) (f:social/politics) (w:recognition/acknowledgement/approval) (d:<theihpih> with the noun suffix {-na}: official recognition or acknowledgement, as given by a government) (b:theihpih) (r:zd:26565/zd:15637) (q:draft)
theihsa ciat = (i:1) (t:phrase) (f:everyday) (w:as we all know/known to everyone) (d:<theihsa>, already known, and <ciat>, each one: a thing that every one of us already knows; it follows <i> or <ih>, we, and closes a statement with {ahi hi}, or opens one as {ih theihsa ciat mah bang in}, just as we all know) (r:zd:24165/zd:16651) (q:draft)
theihsa tek = (i:1) (t:phrase) (f:everyday/media) (w:as we all know/known to everyone) (d:<theihsa>, already known, and <tek>, each one: what each of us already knows; stands after <i> or <ih>, we, and mostly before {mah bangin} or <mahbangin>, just as, to open a statement with a fact the reader knows) (r:zd:18171/zd:17275) (q:draft)
theihsawm = (i:1) (t:v) (f:everyday/education) (w:try to know/seek to understand/find out) (d:<theih> and <sawm>, intend, written as one word: make an effort to know or learn about something) (j:theih/sawm) (r:zd:21869/zd:21063/zd:23191) (q:draft)
theihsiam = (i:1) (t:v) (f:everyday/social) (w:understand/appreciate/be understanding) (d:<theih>, know, with <siam>, skilled: grasp a matter rightly, or understand a person's situation with sympathy) (r:zd:21664/zd:25923/zd:20789) (q:draft)
theikei = (i:1) (t:v) (f:everyday) (w:cannot/be unable) (d:<thei>, able, and <kei>, not, written as one word and placed after a verb: cannot, is not able to) (j:thei/kei) (r:zd:12510/zd:22922/zd:24276) (q:draft)
theikhalo = (i:1) (t:v) (f:everyday) (w:not know/be unaware/not notice) (d:<theikha> and <lo> written as one word: not come to know of something, be unaware of it) (j:theikha/lo) (r:zd:19871/zd:15715/zd:24420) (q:draft)
theileh = (i:1) (t:phrase) (f:everyday) (w:if able/if possible) (d:<thei> and <leh> written as one word after a verb: if it can be done; {hi theileh} is if possible) (j:thei/leh) (r:zd:21298/zd:24276) (q:draft)
theilel = (i:1) (t:v) (f:everyday) (w:can simply/can just) (d:<thei>, can, with <lel>, merely, written as one word after a verb: can do it just like that, with nothing more needed) (j:thei/lel) (r:zd:18927/zd:21918) (q:draft)
theileng = (i:1) (t:v) (f:everyday) (w:if we can/if we know) (d:<thei>, know or be able, and <leng>, if, written as one word: after a verb, if we could do it; alone, if we know; often followed by a statement that this would be good) (j:thei/leng) (r:zd:19516/zd:21056/zd:15554) (q:draft)
theiloding = (i:1) (t:v) (f:everyday/politics) (w:will not be able/cannot) (d:<theilo>, unable, and <ding> written as one word after a verb: will not be able to, is not to; with <in>, so that one cannot) (j:theilo/ding) (r:zd:16061/zd:19231/zd:20394) (q:draft)
theiloin = (i:1) (t:adv) (f:everyday) (w:without knowing/unable to) (d:<thei>, know or be able, with <loin>, without, written as one word: without knowing, and after a verb without being able to do it) (j:thei/loin) (r:zd:14824/ts:6004/zd:25477) (q:draft)
theilua = (i:1) (t:adj) (f:everyday) (w:very possible/can well/can easily) (d:<thei>, able, and <lua>, very much, written as one word after a verb: it can very well happen or be done; after <hong> it can also be <thei>, know: know very well) (j:thei/lua) (r:zd:24411/zd:24638) (q:draft)
theimah = (i:1) (t:v) (f:everyday) (w:can indeed/may well/surely know) (d:<thei>, know or be able, and the emphatic <mah> written as one word: can certainly, may well; of knowing, know indeed) (j:thei/mah) (r:zd:23784/zd:23977) (q:draft)
theimawk = (i:1) (t:v) (f:everyday) (w:can/may well) (d:<thei> and <mawk> written as one word after a verb: can, may even, said of something surprising or not expected) (j:thei/mawk) (r:zd:17152/zd:23977) (q:draft)
Thein = (i:1) (t:num) (f:work) (w:hundred thousand/lakh) (d:the Burmese unit of one hundred thousand, used in counting money and people: {Thein 2} is 200,000; also a part of Burmese personal names) (o:Burmese, thein) (r:zd:24322/zd:24691) (q:draft)
theina = (i:1) (t:n) (f:everyday) (w:ability/possibility/means) (d:<thei>, able, with the noun suffix <na>, placed after a verb: being able to do it, or the place or way in which it can be done; {khawl theina ding} is so as to be able to stop) (b:thei) (r:zd:14650/zd:22524) (q:draft)
theinailo = (i:1) (t:v) (f:everyday) (w:not yet know/not yet be able) (d:<thei> and <nailo> written as one word: not know yet; after another verb, not yet be able to, as in {gencian theinailo}, cannot yet say for certain) (j:thei/nailo) (r:zd:17326/zd:23984/zd:17750) (q:draft)
theinawnlo = (i:1) (t:v) (f:everyday) (w:can no longer/be no longer able) (d:<thei> and <nawnlo> written as one word after a verb: can no longer do it; standing alone, no longer know) (j:thei/nawnlo) (r:zd:20854/zd:19671/zd:20725) (q:draft)
theipan = (i:1) (t:v) (f:everyday) (w:only then can/only then know/come to know) (d:<thei>, know or be able, with <pan>, here only then, written as one word: only at that point come to know, or become able to do what the verb before it says) (j:thei/pan) (r:zd:17622/zd:13155/zd:21286) (q:draft)
theipanding = (i:1) (t:v) (f:everyday/time) (w:will only then be able/can only after that) (d:<thei>, <pan> and <ding> written as one word after a verb: will be able to do it only then, not before the time or condition just named) (j:thei/pan/ding) (r:zd:18054/zd:21968) (q:draft)
theipen = (i:1) (t:adv) (f:everyday) (w:as much as possible/the most that can be) (d:<thei> able with the superlative ending {-pen}, most, written as one word after a describing word and usually followed by <in>: as much so as possible, as in {ahoih theipen in}, as well as possible) (j:thei/pen) (r:zd:15642/zd:15671/zd:13181) (q:draft)
theisiam = (i:1) (t:v) (f:everyday/social) (w:understand/be understanding) (d:<thei> know with <siam> skilled: understand well what someone means or feels, and so bear with him) (r:zd:23556/zd:25916/zd:21313) (q:draft)
theitel = (i:1) (t:v) (f:everyday/education) (w:understand/know fully/discern) (d:know a matter clearly and completely) (s:teltheih/tel) (q:draft)
theithei dingin = (i:1) (t:adv) (f:everyday) (w:as much as possible/as far as possible) (d:<theithei>, <thei>, able, said twice, as far as can be, and <dingin>, so as to: stands after <a> and a word of quality or state and means so that it is as much so as possible; {a sawt theithei dingin} is for as long as possible) (r:ts:3125/zd:20264/zd:21989) (q:draft)
theituanlo = (i:1) (t:v) (f:everyday) (w:be unable after all/not know) (d:<thei>, know or be able, <tuan> and <lo>, not, written as one word: not be able even so, in spite of trying; {acihnading theituanlo} is not knowing what to do) (j:thei/tuan/lo) (r:zd:21341/zd:18054/zd:20859) (q:draft)
theizel = (i:1) (t:adv) (f:everyday) (w:sometimes/at times/tend to) (d:<thei>, can, and <zel>, repeatedly, written as one word after a verb: it can happen now and again, it tends to happen) (j:thei/zel) (r:zd:14954/zd:13007) (q:draft)
theologian = (i:1) (t:n) (f:religion/education) (w:theologian) (d:a scholar of theology, one learned in the things of God) (o:English) (r:zd:22873) (q:draft)
theology = (i:1) (t:n) (f:religion/education) (w:theology) (d:the study and teaching of God and of religious belief, explained in the articles as {Pasian thu}; also in names of degrees and schools) (o:English) (r:zd:13066/zd:23432) (q:draft)
theory = (i:1) (t:n) (f:education) (w:theory) (d:a set of ideas that explains something; writers often put it beside <ngaihsutna> to make the meaning clear) (s:ngaihsutna) (o:English) (r:zd:16615/zd:24289/zd:22683) (q:draft)
thesis = (i:1) (t:n) (f:education) (w:thesis/dissertation) (d:the long paper written to complete a university degree) (o:English) (r:zd:24361) (q:draft)
Thingangyun = (i:1) (t:name) (c:place) (f:travel) (w:Thingangyun) (d:a township of the city of Yangon) (r:zd:16741) (q:draft)
Thingyan = (i:1) (t:name) (f:social/time) (w:Thingyan) (d:the Burmese New Year water festival in April, in Zolai <tuibuahpawi>) (o:Burmese) (r:zd:12164/zd:12115) (q:draft)
thithe = (i:1) (t:adv) (f:everyday/time) (w:repeatedly/often/again and again/constantly) (d:placed after a verb: the action is done time after time or keeps happening) (r:zd:20060/zd:22860/ts:10215) (q:draft)
thoh = (i:1) (t:v) (f:work) (w:withdraw/draw out/collect) (d:take out what is kept or issued somewhere: money from a bank or an account, or goods such as medicine that are handed out; {sum thoh} is withdraw money) (o:Burmese) (r:zd:23446/zd:20859/zd:24042) (q:draft)
thoih = (i:1) (t:v) (f:religion) (w:propitiate/appease/make an offering to) (d:make an offering to a spirit or power to satisfy it and turn away harm, as in {dawi thoih}, appease the spirits; also make atonement for a wrong) (r:ts:3366/zd:13354/zd:12177) (q:draft)
thoihna = (i:1) (t:n) (f:religion) (w:sacrifice/offering) (d:noun of <thoih>, offer a sacrifice: a sacrifice made to a spirit or to God; {dawi thoihna} is sacrifice to the spirits and {mawh thoihna} is a guilt offering) (s:kithoihna) (b:thoih) (r:zd:23394/zd:12177/zd:21175) (q:draft)
thong kum = (i:1) (t:n) (f:politics) (w:years in prison/prison term/years of imprisonment) (d:<thong>, prison, and <kum>, year: years of imprisonment, followed by the number of years; {thong kum 3 kia} is to be sentenced to three years in prison) (r:zd:24322) (q:draft)
thongdaan = (i:1) (t:n) (f:politics) (w:prison sentence/imprisonment/jail term) (d:punishment by prison, from <thong>, prison, and <daan>, punishment; named beside <liausum>, a fine) (r:zd:12519/zd:17544) (q:draft)
thongkia mi = (i:1) (t:n) (f:politics/social) (w:prisoner/inmate/detainee) (d:<thongkia>, be in prison, and <mi>, person: a person held in prison; a number or <khat> follows it) (r:zd:19275/ts:4831) (q:draft)
thongkiading = (i:1) (t:v) (f:politics) (w:be sentenced to prison/will be imprisoned) (d:<thongkia>, be imprisoned, and <ding>, will, written as one word; after a length of time: is to be in prison for that long) (j:thongkia/ding) (r:zd:15848/zd:19745) (q:draft)
thonglam = (i:1) (t:n) (f:politics/social) (w:prison matters/detention matters) (d:<thong>, prison, and <lam>, side, written as one word: what concerns prison and people held in detention; found in headings of community reports) (j:thong/lam) (r:zd:13165/zd:19520) (q:draft, low confidence)
thongsung = (i:1) (t:n) (f:politics) (w:prison/inside of a prison) (d:<thong> and <sung> written as one word: the inside of a prison; {thongsung ah} is in prison and {thongsung lut} is go to prison) (j:thong/sung) (r:zd:23488/zd:12613/zd:12557) (q:draft)
thongvai = (i:1) (t:n) (f:politics) (w:prison affairs/prison matters) (d:<thong>, prison, with <vai>, affair, written as one word: what concerns a prison or imprisonment) (j:thong/vai) (r:zd:25686) (q:draft, low confidence)
thongzong = (i:1) (t:phrase) (f:politics) (w:prison also/imprisonment as well) (d:<thong>, prison, and <zong>, also, written as one word: a prison term as well, said beside <liausum>, a fine) (j:thong/zong) (r:zd:12774/zd:17262) (q:draft)
thu kibawlding = (i:1) (t:v) (f:politics/media) (w:will be prosecuted/will be charged) (d:<thu>, matter or case, and <kibawlding>, will be made: a case will be brought, the person will be prosecuted; from {thu bawl}, bring a case against someone in law. The law or charge stands before it with <tawh>, and a news report closes it with <cihi> or {cih kiza hi}) (r:zd:20234/zd:16580) (q:draft)
thu kikum = (i:1) (t:v) (f:social) (w:discuss/confer/hold a discussion) (d:<thu>, matter, and <kikum>, confer: discuss a matter together; the question discussed stands before it, often ending in <cih>) (r:zd:21925/zd:10833) (q:draft)
thu kikup = (i:1) (t:v) (f:social) (w:discuss/hold a discussion/confer) (d:<thu>, matter, and <kikup>, discuss together: to talk a matter over together, to hold a discussion; also the discussion itself, and with <na> the noun {thu kikup na}) (r:zd:14530/zd:18196) (q:draft)
thu laigil = (i:1) (t:n) (f:everyday/education) (w:essence/main point/core/heart of the matter) (d:<thu>, word or matter, and <laigil>, core: the central point or essence of a matter or teaching; the matter stands before it, as in {Pasian' thu laigil}, the heart of the word of God) (r:zd:20786/zd:23129/zd:24186) (q:draft)
thu tangkona = (i:1) (t:n) (f:religion) (w:preaching/proclamation) (d:<thu>, word, and <tangkona>, proclamation: the preaching of a message; the message is named before it, most often in {lungdamna thu tangkona}, the preaching of the gospel, evangelism) (r:zd:18200/zd:24234) (q:draft)
thuahna = (i:1) (t:n) (f:health/home) (w:wearing/putting on) (d:<thuah> with {-na}: the putting on or wearing of something over the face or body, as a mask; {ki thuahna} is keeping company with others) (b:thuah) (r:zd:24489/zd:24918/zd:24432) (q:draft)
thuahpih = (i:1) (t:v) (f:social) (w:accompany/keep company with/be together with) (d:the second part of <kithuahpih> where the prefix <ki> is written as a separate word: {ki thuahpih}, be together with someone, be a companion of) (r:zd:23148/zd:21989/zd:25919) (q:draft)
thuahsak = (i:1) (t:v) (f:everyday/home) (w:install/fit/put on/add) (d:<thuah>, in addition, with the causative <sak>: put one thing onto or into another, as install a device in a place or dress someone in something; with <ki> also of a penalty laid on someone) (r:zd:15759/zd:12685/zd:15305) (q:draft)
thuakding = (i:1) (t:v) (f:everyday/politics) (w:will suffer/will undergo/will face) (d:<thuak>, suffer or undergo, and <ding>, will, written as one word: will undergo, or what one is to undergo, especially a punishment; {thusitna thuakding} is will stand trial) (j:thuak/ding) (r:zd:14660/zd:16869) (q:draft)
thuaklah = (i:1) (t:v) (f:everyday/health) (w:suffer/be badly affected/be hard hit) (d:suffer much from something and find it hard to bear, as smoke, heat, pain or ill treatment; built on <thuak>, bear; {thuaklah mahmah} is suffer greatly) (r:zd:15286/zd:12267/zd:16137) (q:draft)
thuaklahlua = (i:1) (t:v) (f:health/everyday) (w:suffer unbearably/be unable to bear/be overcome) (d:<thuaklah>, find hard to bear, with <lua>, too much, written as one word: suffer more than one can bear, from pain, heat, smoke or hunger) (j:thuaklah/lua) (r:zd:15481/zd:12532/zd:20518) (q:draft)
thuakzolo = (i:1) (t:v) (f:everyday/health) (w:cannot bear/be unable to endure) (d:<thuak> and <zolo> written as one word: not able to bear or withstand something, give way under it) (j:thuak/zolo) (r:zd:20747/zd:12835) (q:draft)
Thuamvum = (i:1) (t:name) (c:mountain) (f:nature/travel) (w:Thuamvum/Kennedy Peak) (d:a mountain near Tedim in Chin State, in English Kennedy Peak) (r:zd:14824/ts:11738) (q:draft)
thubaih = (i:1) (t:n) (f:everyday) (w:easy matter/simple thing) (d:<thu>, matter, with <baih>, easy: something easy to do, mostly in the negative {thubaih hilo}, it is no easy matter) (r:zd:25078/zd:25015/zd:25609) (q:draft)
thubawl = (i:1) (t:v) (f:politics) (w:prosecute/charge/take legal action/sue) (d:<thu>, case, with <bawl>, make: bring a case against someone under the law, said of the police, the government or a private party) (r:zd:20412/zd:11918/zd:20222) (q:draft)
thubawlding = (i:1) (t:v) (f:politics) (w:prosecute/take legal action/charge) (d:<thu> <bawl>, bring a case against someone, with <ding>, will, written as one word: will prosecute, in order to charge) (j:thu/bawl/ding) (r:zd:17818/zd:21057) (q:draft)
thubawlna = (i:1) (t:n) (f:politics/social) (w:legal action/proceedings/prosecution/action) (d:<thu>, matter or case, with <bawlna>, doing: action taken against someone, mostly by the police or a court) (j:thu/bawlna) (r:ts:9881/ts:1215) (q:draft)
thubek = (i:1) (t:phrase) (f:everyday) (w:only the matter of/only the word of/merely) (d:<thu.1> and <bek> written as one word: only the matter, word or will of the one named before it; {ama thubek} is only his own way) (j:thu/bek) (r:zd:11548/zd:25687/zd:25275) (q:draft, low confidence)
thubu = (i:1) (t:n) (f:religion) (w:scripture/book of the word) (d:<thu>, word, with <bu>, book: a book that holds a message; {Pasian thubu} is the word of God as a book, the Bible) (r:ts:9862/zd:23896) (q:draft)
thubuai = (i:1) (t:n) (f:social/politics) (w:dispute/trouble/incident) (d:<thu>, matter, with <buai>, be troubled: a quarrel, case or disturbance that has to be settled) (r:zd:22492/zd:15431/zd:25109) (q:draft)
thubulphuh = (i:1) (t:n) (f:religion/social) (w:theme/main topic/motto) (d:<thu>, word, with <bulphuh>, base on: the theme on which a sermon, a meeting or a year's programme is based) (s:thubul) (r:zd:22604/ts:9530) (q:draft)
thubulpite = (i:1) (t:n) (f:social/politics) (w:main points/principles/fundamentals/root issues) (d:<thubulpi> with the plural <te>: the main matters or basic principles of something) (b:thubulpi) (r:zd:19379/ts:10637) (q:draft)
thuciamthak = (i:1) (t:n) (c:testament) (f:religion) (j:Thuciam thak) (r:zd:22544/zd:12333) (q:draft, a name, written Thuciamthak with a capital in the articles)
thuciin = (i:1) (t:n) (f:social/education) (w:saying/proverb/oral tradition) (d:a saying or teaching handed down by word of mouth from earlier generations) (s:paunak) (r:zd:22556/zd:15541) (q:draft)
thucin = (i:1) (t:n) (f:social) (w:chat/small talk/casual talk) (d:used in the pair {thucin thutang}: talk about this and that, casual conversation; {thucin thutang gen} is to chat) (r:zd:26050/zd:13302) (q:draft)
thudonlo = (i:1) (t:v) (f:everyday/social) (w:pay no attention/ignore/take no notice) (d:<thudon>, pay attention, and <lo>, not, written as one word: take no notice of what is said or what happens) (j:thudon/lo) (r:zd:17279/zd:18067) (q:draft)
thudotpi = (i:1) (t:n) (f:politics/work) (w:adviser/counsellor) (d:<thudot.2>, asking for advice, with <pi.3>, chief: the person a ruler or a body turns to for advice; {gambup thudotpi} is the State Counsellor of Myanmar) (r:zd:24303/zd:17838/zd:21327) (q:draft)
thugen = (i:1) (t:v) (f:everyday/social) (w:speak/say) (d:<thu>, word, with <gen>, say: speak to someone, address people; also used as a noun for what a person says) (s:gen)
thugenna nei = (i:1) (t:v) (f:social/religion) (w:give a speech/deliver an address/speak) (d:<thugenna>, speech, and <nei>, have: hold a speech, give an address or a talk at a meeting or service; the speaker stands before it with <in>, the place with <ah>) (r:zd:13181/zd:17939/zd:18927) (q:draft)
thugensiam = (i:1) (t:n) (f:social/education) (w:good speaker/eloquent speaker/orator) (d:<thugen>, speak, and <siam>, skilled, written as one word: a person who speaks well, and being good at speaking) (j:thugen/siam) (r:zd:21063/zd:9250) (q:draft)
thugil = (i:1) (t:n) (f:education/religion) (w:essence/substance/core/principle) (d:the deep or essential part of a matter, its real content; {dinpih thugil} is a principle one stands on, and said of writing it means having substance) (r:zd:26163/ts:9862) (q:draft)
thuginalo = (i:1) (t:n) (f:social/media) (w:bad thing/wrongdoing/scandal) (d:<thu>, matter, and <ginalo>, no good, written as one word: improper or shameful matters, bad news or worthless talk) (j:thu/ginalo) (r:zd:16695/zd:16998/zd:12142) (q:draft)
thuging = (i:1) (t:n) (f:media/social) (w:rumour/report/hearsay) (d:news that is going round and is heard but not confirmed; {cih thuging kiza hi} is it is heard said that) (r:zd:20014/zd:16157) (q:draft)
thugui = (i:1) (t:n) (f:social/education) (w:principle/doctrine/guiding rule) (d:a basic rule or teaching that other things follow from; {thugui paipi} and {thugui pi} are a main principle) (r:zd:8668/zd:17177) (q:draft)
thuguipi = (i:1) (t:n) (f:politics/social/religion) (w:principle/main point/fundamental/tenet) (d:<thu>, matter, with <guipi>, main stem: a basic principle on which other things rest, or a main topic of a discussion) (r:zd:25020/zd:19416/zd:24303) (q:draft)
Thuhilhkikna = (i:1) (t:name) (c:book) (f:religion) (j:Thu Hilhkikna) (r:zd:17374) (q:draft)
thuhsa = (i:1) (t:adj) (f:work/politics) (w:signed/stamped/sealed) (d:<thuh>, stamp or seal, and <sa> in its use for something already done, written as one word; {letmat thuhsa} is bearing a signature, signed) (j:thuh/sa) (r:zd:12336) (q:draft, low confidence)
thuk = (i:4) (t:adj) (f:food/everyday) (w:sour) (d:sour or acid in taste) (r:zai:acetic) (q:draft, low confidence)
Thukai = (i:1) (t:v) (f:media) (w:gather news/compile) (d:<thu> news with <kai> pull, gather; {thukai khawm} at the foot of a news article names those who gathered the news together) (r:zd:24579) (q:draft, low confidence)
thukawng = (i:1) (t:n) (f:social/politics) (w:course of a matter/direction/subject) (d:the direction that a matter or a talk is taking; {thukawng hei} and {thukawng hek}, turn it, mean change course or change the subject) (r:zd:23985/zd:24932) (q:draft, low confidence)
thukhenmang = (i:1) (t:n) (f:politics) (w:judge/magistrate) (d:<thukhen>, judge, with <mang>, lord or official: a judge of a law court) (s:thukhenpa) (b:thukhen) (r:zd:22644/zd:21568/zd:15214) (q:draft)
thukhensat = (i:1) (t:n) (f:social/politics) (w:decision/resolution) (d:<thu>, matter, with <khensat>, decide, written as one word: a decision or resolution of a meeting or body, and the deciding of a matter) (s:thukhensatna) (j:thu/khensat) (r:zd:25127/zd:25914/zd:16719) (q:draft)
thukhenzum = (i:1) (t:n) (f:politics) (w:court/law court) (d:<thukhen>, judge, with <zum>, office: a court of law) (r:zd:10722/zd:25710) (q:draft)
thukhun = (i:1) (t:n) (f:politics/social) (w:rule/regulation/law/principle) (d:a rule or the rules that must be followed, as the law of a government or the rules of an organisation; {thukhun om bangin} is according to the law) (r:zd:22813/zd:24219/zd:24248) (q:draft)
thukhun ombang = (i:1) (t:adv) (f:politics) (w:according to the law/under the law/as the rules stand) (d:<thukhun>, rule or law, with <ombang>, as there is: followed by <in>, in accordance with the law in force; after the name of an act or section, under that provision, as in reports of charges brought) (r:zd:25111/zd:14797) (q:draft)
thukhunpi = (i:1) (t:n) (f:politics) (w:constitution) (d:<thukhun> with <pi>, great or chief: the basic law of a country, or the constitution of an organisation) (r:zd:25110/zd:19662/zd:24194) (q:draft)
thukhunte = (i:1) (t:n) (f:social/politics) (w:rules/regulations/terms) (d:<thukhun>, a rule or agreed regulation, with the plural ending <te>: the rules of an organisation, a law or an agreement) (r:zd:24060/zd:24327/zd:21717) (q:draft)
thukhunthak = (i:1) (t:n) (f:politics) (w:new law/new rule/new regulation) (d:<thukhun>, a rule or law, and <thak>, new, written as one word: a rule newly made by the authorities; in church writing also the New Testament) (j:thukhun/thak) (r:zd:11778/zd:15822) (q:draft)
thuki = (i:1) (t:phrase) (f:everyday) (d:<thu>, matter or word, written together with the prefix <ki> of the verb that follows, as in {thuki kupna} for {thu kikupna}, discussion of a matter, and {thuki za} for {thu kiza}, it is heard that) (j:thu/ki) (r:zd:20213/zd:21075) (q:draft)
thukibawl = (i:1) (t:v) (f:politics) (w:be charged/be prosecuted) (d:<thu> and <kibawl> written as one word: a case is made against a person, he is charged or tried in court) (j:thu/kibawl) (r:zd:14768/ts:6210) (q:draft)
thukician = (i:1) (t:n) (f:media) (w:reliable information/confirmed news/definite facts) (d:<thu>, word or matter, and <kician>, firm, written as one word: information that is definite and can be relied on) (j:thu/kician) (r:ts:1919/ts:5498) (q:draft)
thukikupna = (i:1) (t:n) (f:social/politics) (w:discussion/talks/consultation/meeting) (d:<thu> and <kikupna> written as one word: a discussion of a matter, a meeting held for talks) (s:kikupna) (j:thu/kikupna) (r:zd:26566/zd:11244) (q:draft)
thukim = (i:1) (t:v) (f:social) (w:agree/consent) (d:be of one mind about a matter, or accept what is asked or proposed, from <thu>, matter, and <kim>, complete) (s:kithutuak) (a:nial) (q:draft)
thukimlo = (i:1) (t:v) (f:social) (w:disagree/not consent/refuse) (d:<thukim>, agree, and <lo>, not, written as one word: not agree to what is asked or proposed) (j:thukim/lo) (r:zd:23616/ts:3271/zd:21509) (q:draft)
thukimna kinei = (i:1) (t:v) (f:social/politics) (w:it was agreed/an agreement was made) (d:<thukimna>, agreement, and <kinei>, here the passive of <nei>, have: an agreement is reached; follows a clause ending in <dingin> that says what was agreed, and closes reports of meetings) (r:zd:15275) (q:draft)
thukimna nei = (i:1) (t:v) (f:social/politics) (w:reach an agreement/agree/make a deal) (d:<thukimna>, agreement, and <nei>, have: come to an agreement or decide together; what is agreed stands before it, mostly as a clause ending in <ding> or <dingin>) (s:thukim) (r:zd:24458/zd:21357/zd:25602) (q:draft)
thukimnate = (i:1) (t:n) (f:social/politics) (w:agreements/resolutions) (d:plural of <thukimna>: the points agreed on, the resolutions of a meeting or conference) (b:thukimna) (r:zd:22365/zd:16385) (q:draft)
thukipia = (i:1) (t:v) (f:politics/media) (w:be sentenced/be ordered) (d:<thu>, word or order, and <kipia>, be given, written as one word: a ruling is given, said in news reports of a court that sentences someone, as in {thong kiading in thukipia}, sentenced to prison) (j:thu/kipia) (r:zd:19745/zd:17357) (q:draft)
thukiza = (i:1) (t:phrase) (f:media) (w:it is reported/word is heard) (d:<thu> and <kiza> written as one word, at the end of a news report after <cih>: news is heard that, it is reported that; also the report that was heard) (j:thu/kiza) (r:ts:2424/zd:20080/zd:15554) (q:draft)
thukizakna = (i:1) (t:n) (f:media/social) (w:communication/news/news service) (d:<thu>, word or news, with <kizak>, be heard, and the noun suffix {-na}: the passing of news among people, communication, also a news outlet) (r:zd:24306/zd:23770/zd:24149) (q:draft)
thuklut = (i:1) (t:v) (f:everyday) (w:go deep into/penetrate/get deep inside) (d:<thuk>, deep, with <lut>, enter: enter deeply into a place, a group or the heart) (r:zd:24331/zd:23990) (q:draft, low confidence)
thukong = (i:1) (t:n) (f:social/religion) (w:opening/introduction/theme) (d:<thu>, word or matter, with <kong>, door: the opening of a matter; {thukong honna} is the opening speech of a meeting, and a {thukong} can be chosen as the theme for reflection) (r:zd:11447/zd:23483/zd:23880) (q:draft)
thulamdang = (i:1) (t:n) (f:media/everyday) (w:strange thing/strange news/wonder/marvel) (d:<thu>, matter or news, and <lamdang>, strange, written as one word: a strange or astonishing event, or the report of one) (j:thu/lamdang) (r:zd:21876/zd:10992/zd:17595) (q:draft)
thulehla = (i:1) (t:n) (f:social/education) (w:information/matters/affairs) (d:<thu>, <leh> and <la> written as one word, literally word and song: matters and information of every kind, what there is to know or deal with) (j:thu/leh/la) (r:zd:20003/zd:21198) (q:draft)
thulela = (i:1) (t:n) (f:social) (w:ideas and advice/information/matters) (d:{thu le la}, word and song, written as one word: what one has to say, ideas, advice and information in general, often set against <sumlepai>, money) (j:thu/le/la) (r:zd:23959/zd:24028/zd:19521) (q:draft, low confidence)
thuleng = (i:1) (t:n) (f:media/social) (w:rumor/hearsay) (d:<thu>, word, with <leng>, fly: news that flies about without being confirmed, a rumor) (a:thutak) (r:zd:22970/zd:24172) (q:draft)
thulianpi = (i:1) (t:n) (f:social) (w:great matter/big issue/serious matter) (d:<thulian>, great matter, with the strengthening ending <pi>: a very important or serious matter) (b:thulian) (r:zd:21347/zd:25673/zd:15848) (q:draft)
thulu = (i:1) (t:n) (f:media/education) (w:title/heading/topic) (d:<thu>, matter, with <lu>, head: the title or heading of a writing, song or talk, and also its subject) (r:zd:15259/zd:9242/zd:19201) (q:draft)
thuluanzia = (i:1) (t:n) (f:education/social) (w:course of a matter/flow of thought/procedure) (d:<thu> matter with <luan> flow and <zia> manner: the way a matter or an argument runs from one step to the next) (r:zd:25678/zd:25687) (q:draft, low confidence)
thului = (i:1) (t:n) (f:media/education) (w:article/essay/write-up) (d:a written piece on one subject, as printed in a magazine, a journal or on a website) (r:zd:22803/zd:14703/zd:23860) (q:draft)
thuma = (i:1) (t:n) (f:everyday/media) (w:introduction/what comes before) (d:<thu>, matter, with <ma>, before: what comes before a matter, and as a heading the introduction; {thunung thuma} is the before and after of a matter, its background and its consequences) (r:zd:23554/zd:12389) (q:draft, low confidence)
thumaan thutak = (i:1) (t:n) (f:social/religion) (w:truth/truth and righteousness) (d:<thumaan>, right, and <thutak>, truth, said as a pair: the truth, what is right and true; also written <thuman thutak>) (s:thuman thutak) (r:zd:21843/zd:25469) (q:draft)
thumaanlo = (i:1) (t:adj) (f:social) (j:thumanlo) (r:zd:25015/zd:19603) (q:draft)
thuman thutak = (i:1) (t:n) (f:social/religion) (w:truth/truth and justice/what is right and true) (d:<thuman>, what is right, and <thutak>, truth: a pair of words with one meaning, the truth, what is true and right) (r:zd:20902/zd:15794/zd:17976) (q:draft)
thumanglo = (i:1) (t:adj) (f:social/family) (w:disobedient/unruly) (d:<thumang>, obey, and <lo>, not, written as one word: not obeying parents, the law or those in authority) (j:thumang/lo) (r:zd:19571/zd:19621) (q:draft)
thumasa = (i:1) (t:n) (f:media/education) (w:introduction/preface/foreword) (d:<thu>, word, with <masa>, first, written as one word: the opening part of an article, book or speech, often set as its first heading) (j:thu/masa) (r:zd:19577/ts:3737) (q:draft)
thumeilet = (i:1) (t:n) (f:politics/social) (w:principle/policy/guiding rule) (d:a basic principle or standing rule that a person or an organisation holds to and acts by; listed beside <thukhun>, rules) (r:zd:24336/zd:23345) (q:draft, low confidence)
thunawngkai = (i:1) (t:n) (f:social/media) (w:trouble/problem/incident) (d:<thu>, matter, with <nawngkai>, be troubled, written as one word: a troublesome matter, a problem, disturbance or incident that causes difficulty) (j:thu/nawngkai) (r:zd:12482/zd:21145/zd:19586) (q:draft)
thuneikhat = (i:1) (t:phrase) (f:politics/work) (w:an official/an officer in charge) (d:{thunei}, one who holds authority, compare <thuneite>, with <khat>, one, written as one word: an official or person in charge, of the police or another body) (r:zd:16934/zd:20122) (q:draft)
thuneipa = (i:1) (t:n) (f:politics/work) (w:official/officer in charge/man in authority) (d:the man who holds authority over something; {palik thuneipa} is a police official or spokesman, and with {tung a} before it, the one who has power over something) (r:zd:19906/zd:21232/zd:24004) (q:draft)
thuneipi = (i:1) (t:n) (f:politics/social) (w:chief authority/head/top leader/person in charge) (d:{thunei}, one who has authority, with {-pi}, great or chief: the person who holds the highest authority in a country, an army, a hospital or an organisation) (r:zd:17501/ts:8105/ts:4564) (q:draft)
thuneiten = (i:1) (t:n) (f:politics) (w:authorities/officials) (d:<thuneite>, the authorities, with the agent marker <in> shortened to <n>: the authorities as the ones who act or speak, as in {thuneiten gen hi}, the authorities said) (b:thuneite) (r:ts:4042/ts:3307) (q:draft)
thunget khopna = (i:1) (t:n) (f:religion) (w:joint prayer/prayer meeting/praying together) (d:<thunget>, pray, and <khopna>, doing together: prayer by several people together, a prayer meeting; often the object of <nei>, hold) (r:zd:14801/zd:20874) (q:draft)
thungetna kinei = (i:1) (t:v) (f:religion/social) (w:prayer is held/a prayer meeting is held) (d:<thungetna>, prayer, and <kinei>, here the passive of <nei>, have or hold: prayer is held, a prayer meeting takes place; the place with <ah> and the purpose with <adingin> stand before it) (r:zd:17126/zd:23005) (q:draft)
thungkuah = (i:1) (t:n) (f:home/travel) (w:shoulder bag/sling bag/handbag) (d:a bag worn on a strap over the shoulder; in the articles it glosses sling bag, backpack and handbag; compare <thung-ip> and <kuah>, strap on) (r:zd:22683/zd:15178/zd:17262) (q:draft)
thunih = (i:1) (t:n) (f:everyday) (w:two things/two matters) (d:<thu> and <nih> written as one word: two matters, two points) (j:thu/nih) (r:zd:19654/zd:16035) (q:draft)
thunsak = (i:1) (t:v) (f:work/everyday) (w:put in for/pay in/deposit) (d:<thun>, put into, and <sak.1> written as one word: put something into a container, or pay money into an account or fund, for someone or at their request) (b:thun) (j:thun/sak) (r:zd:17021/zd:23367/zd:22439) (q:draft)
thunung = (i:1) (t:n) (f:everyday/social) (w:consequence/outcome/aftermath) (d:what comes after a matter, from <thu> and <nung>; mostly in the pair {thunung thuma}, what follows a matter and what goes before it, all its ins and outs) (r:zd:23554/zd:22565) (q:draft)
thupaizia = (i:1) (t:n) (f:everyday/politics) (w:procedure/course of a matter/process) (d:<thu>, matter, and <paizia>, way of going, written as one word: how a matter proceeds, the proper order in which it is dealt with) (j:thu/paizia) (r:zd:24931/zd:20239) (q:draft)
thupatna = (i:1) (t:n) (f:education/media) (w:introduction/opening) (d:<thu>, matter, with <patna>, beginning: the opening part of an article, sermon or speech) (a:thukhupna) (r:zd:21075/zd:21083) (q:draft)
thupawlkhat = (i:1) (t:n) (f:everyday/media) (w:some things/some matters/a few points) (d:<thu>, matter, and <pawlkhat>, some, written as one word: some matters, a number of things to say or to know) (j:thu/pawlkhat) (r:zd:24276/zd:13026/zd:22217) (q:draft)
thupen = (i:1) (t:n) (f:everyday) (w:the matter/the subject) (d:<thu>, matter, with the topic marker <pen> written as one word: as for the matter, mostly as {hih thupen}, this matter) (j:thu/pen) (r:zd:10731/zd:20829) (q:draft)
thupha hongpia = (i:1) (t:v) (f:religion) (w:bless us/bless you) (d:<thupha>, blessing, and <hongpia>, give us or give you: bless; the closing wish of a letter or notice, with {Topa'n} before it and <hen> or <tahen> after it, may the Lord bless you) (r:zd:21520/zd:14992) (q:draft)
thupha pia = (i:1) (t:v) (f:religion) (w:bless/give a blessing) (d:<thupha>, blessing, and <pia>, give: bless; the one who blesses stands before it with <in> and the one blessed stands directly before it or with <tungah>) (a:hamsiat) (r:zd:23777/zd:25484/zd:19663) (q:draft)
thupha piakna = (i:1) (t:n) (f:religion) (w:benediction/blessing) (d:<thupha>, blessing, and <piakna>, giving: the benediction, the blessing that a minister speaks to close a service or a gathering; the name of the minister stands before it, and {tawpna thupha piakna} is the closing benediction) (r:zd:21771/ts:10085) (q:draft)
thuphangah = (i:1) (t:adj) (f:religion) (w:blessed) (d:<thupha> and <ngah> written as one word: having received blessing, blessed; {thuphangah minam} is a blessed people) (j:thupha/ngah) (r:zd:8668/zd:16989) (q:draft)
thupi kasa = (i:1) (t:v) (f:social) (w:I value/I appreciate/I hold in high regard) (d:<thupi>, important, and <kasa>, I find: I regard the person or thing named before it as important, said in thanks and tribute; often followed by <mahmah>) (r:zd:17291/zd:23311) (q:draft)
thupi kisa = (i:1) (t:v) (f:social/everyday) (w:be highly regarded/be admired/be thought important) (d:<thupi>, important or great, and <kisa>, be considered: be thought great, be held in high regard; the person or deed that is admired stands before it, often with <pen>, and <mahmah> often follows) (r:zd:22828/zd:12113/zd:21706) (q:draft)
thupiang ahihi = (i:1) (t:phrase) (f:media) (w:it happened/it took place) (d:<thupiang>, a happening, and <ahihi>, it is: the closing formula of a news report, it is a thing that happened; the time or place with <in> or <ah> stands before it, and the report often opens with {hih thupiang pen}, this incident) (r:zd:12427/zd:19445/zd:10992) (q:draft)
thupiang kici = (i:1) (t:phrase) (f:media) (w:reportedly happened/is said to have happened) (d:<thupiang>, event, here used as a verb, the matter happened, with <kici>, it is said: closing formula of a news report, after the place with <ah> and the day with <in>, and followed by <hi>) (r:zd:15125/zd:20767) (q:draft)
thupiangpen = (i:1) (t:phrase) (f:media) (w:the incident/the event) (d:<thupiang>, event, and the topic marker <pen> written as one word: marks the incident as what the sentence is about; {hih thupiangpen} is as for this incident) (j:thupiang/pen) (r:zd:18110/zd:14778) (q:draft)
thupilo = (i:1) (t:adj) (f:everyday) (w:unimportant/trivial/not important) (d:<thupi>, important, and <lo>, not, written as one word) (j:thupi/lo) (r:zd:12391/zd:25580/zd:23635) (q:draft)
thupingaihsut = (i:1) (t:n) (f:social/religion) (w:values/priority) (d:<thupi>, important, and <ngaihsut>, consider, written as one word: what a person or group counts as important; once glossed with English values) (j:thupi/ngaihsut) (r:zd:21140) (q:draft, low confidence)
thupisa = (i:1) (t:v) (f:everyday/social) (w:value/consider important/think highly of) (d:<thupi>, important, with <sa>, here feel or consider: regard a person or thing as important) (j:thupi/sa) (r:zd:24068/zd:9221/zd:21978) (q:draft)
thupisakna = (i:1) (t:n) (f:social) (w:esteem/valuing/regard) (d:<thupisak>, value highly, with the noun suffix <na>: treating something as important, the high value set on it) (b:thupisak) (r:zd:15794/zd:9449) (q:draft)
thupit = (i:1) (t:adj) (f:everyday/social) (w:important/great) (d:form of <thupi>, important, used before words such as <lam>, <sak>, <ngaihsut> and <luatna>; {a thupit lam} is how important it is) (b:thupi) (r:zd:22650/zd:21142/zd:25390) (q:draft)
thupitak = (i:1) (t:adv) (f:everyday/social) (w:greatly/grandly/solemnly) (d:<thupi>, great or important, and <tak> written as one word: in a great, grand or solemn way, mostly as {thupitak in}; before a noun, great) (j:thupi/tak) (r:zd:20747/zd:25908/zd:10743) (q:draft)
thupitsak = (i:1) (t:v) (f:social) (w:value highly/regard as important/esteem) (d:form of <thupisak> used before <ding> and when the verb stands as a noun: {ih thupitsak} is what we hold important) (s:thupisak) (r:zd:10777/zd:18958/zd:16404) (q:draft)
thupomzia = (i:1) (t:n) (f:religion/education) (w:belief/doctrine/view/conviction) (d:the way a matter is held, from <thu>, <pom>, hold fast, and <zia>, manner: what a person or a church believes about something) (r:zd:24304/zd:25749/zd:22858) (q:draft)
thupulakna = (i:1) (t:n) (f:media/politics) (w:announcement/statement/press release) (d:<thu>, word, with <pulakna>, announcement: a public statement by an organisation or office; {thupulakna nei} is issue a statement) (s:pulakna) (r:ts:5907/zd:15664/zd:20084) (q:draft)
Thursday = (i:1) (t:n) (c:ni) (f:time) (w:Thursday) (s:laiziing/khani) (o:English) (r:zd:15461/zd:19788) (q:draft)
thusa = (i:1) (t:v) (f:social/everyday) (w:regard as important/care about/mind) (d:count something as a matter that counts; {ama thu bek thusa} is to regard only his own matter as important) (r:zd:21911/zd:11135/zd:19381) (q:draft)
thusa = (i:2) (t:n) (f:social/family) (w:spokesman/adviser) (d:a role in Zo custom: the person appointed to speak and advise for a household or clan in its affairs; {beh thusa} is the one of a clan) (r:zd:23990) (q:draft, low confidence)
thusapi = (i:1) (t:n) (f:social/work) (w:secretary/general secretary) (d:the chief secretary of an organisation, named beside the president; writers add the English word secretary or Secretary-General to it) (r:zd:25392) (q:draft)
thusia lasia = (i:1) (t:n) (f:social/everyday) (w:bad things/evils/troubles/bad news) (d:<thusia>, a bad matter, doubled with {lasia}, bad song, after the pair {thu le la}, word and song: bad things of every kind, evil happenings, wrongdoing and bad news; the opposite is {thu hoih la hoih}) (r:zd:16254/zd:24481) (q:draft)
thusiam = (i:1) (t:adj) (f:social) (w:courteous/kind/polite/hospitable) (d:pleasant and considerate in the way one speaks to and treats others; {thusiam lo} is impolite, unkind) (r:zd:22658/zd:17291/zd:26643) (q:draft)
thusiamna = (i:1) (t:n) (f:social) (w:courtesy/kindness/invitation) (d:a kind arrangement made for someone; {thusiamna tawh} is by courtesy of, at the kind invitation of the one who arranges a visit) (b:thusiam) (r:zd:24594/zd:25616/ts:301) (q:draft, low confidence)
thusimlo = (i:1) (t:v) (f:social/everyday) (w:disregard/ignore/pay no heed/disrespect) (d:<thusim> and <lo> written as one word: take no notice of a person, an order or a custom; {mi thusimlo} is a heedless person) (j:thusim/lo) (r:zd:16009/zd:21341/zd:23680) (q:draft)
thusin = (i:1) (t:v) (f:education/religion) (w:study/learn/attend a course) (d:<thu> and <sin> written as one word: study a subject or attend teaching or training, also as a noun, a lesson or course; {thusin hun} is the time of the class and {thusin mi} a participant) (j:thu/sin) (r:zd:17723/zd:24574/zd:10966) (q:draft)
thusinna = (i:1) (t:n) (f:education/religion) (w:lesson/study/training/teaching session) (d:<thu> with <sinna>, learning: a lesson, class or training in which a subject is taught and studied, as in Sunday school, a seminar or a course; {thusinna pia} is give a training) (r:zd:9430/zd:20403/zd:26643) (q:draft)
thusitna kinei = (i:1) (t:v) (f:politics/media) (w:be questioned/be interrogated/be examined) (d:<thusitna>, examination of a case, and <kinei>, be held: questioning is held, said of a suspect who is questioned by the police or brought before a court; the person questioned stands before it) (r:zd:17145/zd:17149) (q:draft)
thusitna nei = (i:1) (t:v) (f:politics) (w:question/examine/investigate) (d:<thusitna>, examination, and <nei>, have: of police, officials or a court, question or examine people, check them or try their case; the persons examined stand before it) (r:zd:17524/zd:13255) (q:draft)
thusuah = (i:1) (t:n) (f:politics/media) (w:statement/announcement/declaration) (d:<thu>, word, with <suah>, bring out: something made public in writing, as a statement of an organisation or a post on social media; {kumpi thusuah} is an edict) (r:zd:25022/zd:16210/zd:25461) (q:draft)
thusuahna nei = (i:1) (t:v) (f:media/politics) (w:issue a statement/make an announcement) (d:<thusuahna>, statement, and <nei>, have: an organisation puts out a public statement or press release; the organisation stands before it with <in>, and what is stated comes first, often closed by {cih thu} or {ci-in}) (r:ts:4549/zd:15329/ts:8561) (q:draft)
thusuak = (i:1) (t:n) (f:media/religion) (w:revelation/insight/report) (d:a word or message that comes out: an insight or revelation that a person receives, as in {thusuak ngah}, and a statement or report that is issued; also used as a verb, be reported) (r:zd:15272/zd:24375) (q:draft, low confidence)
thusun = (i:1) (t:n) (f:social/politics) (w:proposal/motion/submission) (d:a matter put before a meeting to be discussed or decided, or a statement presented there) (r:zd:9142/zd:12341) (q:draft, low confidence)
thusung = (i:1) (t:v) (f:social/education) (w:present/give a talk/put forward) (d:<thu>, matter, with a verb meaning pour out: present a subject or put a matter forward at a meeting or seminar; also the one who presents) (r:zd:23361/zd:16150) (q:draft, low confidence)
thusung = (i:2) (t:n) (f:education/media) (w:content/substance) (d:<thu> and <sung>, inside, written as one word: what a text or matter contains, its substance) (j:thu/sung) (r:zd:11170/zd:15047) (q:draft, low confidence)
thusunna = (i:1) (t:n) (f:politics/social) (w:statement/address/submission) (d:what a person puts forward in words before a meeting or the public, such as a member's address or motion in parliament) (r:zd:26658/zd:16150) (q:draft, low confidence)
thutampi = (i:1) (t:phrase) (f:everyday) (w:many things/many matters/much) (d:<thu> and <tampi> written as one word: many matters, many things to say or think about) (j:thu/tampi) (r:zd:20798/zd:17000) (q:draft)
thutawh = (i:1) (t:phrase) (f:everyday/religion) (w:with the word/with the matter) (d:<thu>, word or matter, and <tawh>, with, written as one word: {Pasian thutawh} is with the word of God, {tua thutawh kisai} is concerning that matter, and <zawhthawh thutawh> is by force) (j:thu/tawh) (r:zd:15941/zd:21657/zd:19308) (q:draft)
thuthak = (i:1) (t:n) (f:social) (w:news/new message/new thing) (d:<thu>, word or matter, with <thak>, new; {thuthak hoih} is good news) (s:thuzak/thupuak) (q:draft)
thuthak tomkim = (i:1) (t:n) (f:media) (w:news in brief/news summary/brief news) (d:<thuthak>, news, and <tomkim>, brief and complete: the short summary of news, used as the heading of a column of short news items) (r:zd:24643) (q:draft)
thuthang = (i:1) (t:n) (f:media) (w:news/report/rumour) (d:what is being told about a place or an event, the news of it, whether confirmed or not) (s:thuzak) (r:zd:14965/zd:14652/zd:12407) (q:draft)
thutuak = (i:1) (t:v) (f:social) (w:agree/be of one mind/be united) (d:used with <ki> as {ki thutuak}, the same as <kithutuak>: agree with one another, be united) (r:zd:12337/zd:20888/zd:11176) (q:draft)
thutuam = (i:1) (t:n) (f:everyday) (w:another matter/separate matter) (d:<thu>, matter, and <tuam>, separate, written as one word: a different matter, something to be kept apart from what is discussed; {thutuam in koih} is set aside) (j:thu/tuam) (r:zd:25457/zd:15884/zd:24731) (q:draft)
thutuamtuam = (i:1) (t:n) (f:media) (w:various news/miscellaneous matters) (d:<thu> and <tuamtuam> written as one word: news or matters of various kinds, common at the end of a headline) (j:thu/tuamtuam) (r:zd:24488/zd:22590) (q:draft)
thuvaanpi = (i:1) (t:n) (f:work/social) (w:director/executive director/manager) (d:the person who directs the affairs of an organisation, glossed in the articles as Executive Director; also the managing board) (r:zd:26026) (q:draft, low confidence)
thuza = (i:1) (t:v) (f:social/it) (w:keep in touch/contact/communicate) (d:<thu>, word, with <za>, hear: hear from one another; mostly as {ki thuza}, be in contact and exchange news) (r:zd:12925/zd:13020/zd:23863) (q:draft)
thuzakna = (i:1) (t:n) (f:media/social) (w:communication/contact/news) (d:<thuzak>, what is heard, with the noun suffix <na>: news received of someone or something; {ki thuzakna} is contact or communication between people) (b:thuzak) (r:zd:12936/ts:1919/zd:15627) (q:draft)
thuzawhna = (i:1) (t:n) (f:social/politics) (w:influence/authority/control/persuasion) (d:<thuzawh>, prevail over by words, with the noun suffix <na>: the power to make others follow one's word, by authority, pressure or persuasion) (b:thuzawh) (r:zd:13076/zd:24630/zd:23332) (q:draft)
thuzawhna = (i:2) (t:n) (f:social/religion) (w:resolution/decision) (d:what a meeting or conference has settled, its resolutions; in headings such as {Thuzawhna le Tangkona}, resolutions and declaration) (r:zd:25194) (q:draft, low confidence)
thuzeekpi = (i:1) (t:n) (f:politics/work) (w:secretary/chief secretary/general secretary) (d:the chief secretary of an organisation or a government office; a word proposed in place of {lai-atpa}) (r:zd:22381/ts:261) (q:draft)
thuzong = (i:1) (t:phrase) (f:everyday) (d:<thu> and <zong> written as one word: the word, matter or news also; {cih thuzong kiza hi} is it is also heard that) (j:thu/zong) (r:zd:24641/zd:12050) (q:draft)
Tibet = (i:1) (t:name) (c:land) (f:travel) (w:Tibet) (d:the high land north of the Himalaya, often written {Tibet gam}) (r:zd:25115/zd:22356) (q:draft)
ticket = (i:1) (t:n) (f:travel) (w:ticket) (o:English) (r:zd:19812/zd:19051/zd:22691) (q:draft)
tiltel = (i:1) (t:adv) (f:everyday) (w:in fine detail/minutely/bit by bit) (d:placed after a verb or noun, of what is small and many or is done piece by piece: {khen tiltel} is divide up finely, {tuat tiltel} is reckon in detail, and {naupang tiltel} is little children one after another) (r:zd:17745/zd:20592) (q:draft, low confidence)
timing = (i:1) (t:n) (f:time) (w:timing/time) (d:the right or set time for something, or the tempo of a song) (s:hun) (o:English) (r:zd:15047/zd:21461) (q:draft)
tintan = (i:1) (t:n) (f:education) (w:course/class/training course) (d:a course of lessons outside ordinary school, such as a training or holiday class; {tintan kah} is attend a course) (o:Burmese, thintan) (r:zd:22576/zd:21837/zd:23972) (q:draft)
tinten = (i:1) (t:adv) (f:everyday) (w:firmly/steadfastly/persistently) (d:placed after a verb: do it firmly and keep to it without giving way; {ci tinten} is insist) (r:zd:16832/zd:22719/zd:16340) (q:draft)
tissue = (i:1) (t:n) (f:health/home) (w:tissue/paper tissue) (d:a piece of soft paper for wiping the nose, mouth or hands) (o:English) (r:zd:23935/zd:23727/zd:14734) (q:draft)
Titanic = (i:1) (t:name) (f:travel) (w:Titanic) (d:the passenger ship that sank in the Atlantic in 1912) (r:zd:19661/zd:20486) (q:draft)
TNLA = (i:1) (t:name) (f:politics) (w:Ta'ang National Liberation Army/TNLA) (d:armed group of the Ta'ang people in the north of Shan State, Myanmar; in Zolai also {Ta'ang galkap}) (r:ts:3882/zd:16262) (q:draft)
to semsem = (i:1) (t:adv) (f:everyday) (w:more and more/increasingly/progressively) (d:<to>, upward or onward, and <semsem>, more and more: placed after a verb or adjective, it says that the state keeps growing step by step; {hoih to semsem} is to get better and better) (r:zd:25863/zd:19154/zd:22749) (q:draft)
Toilet = (i:1) (t:n) (f:home) (w:toilet/lavatory) (d:a toilet, the room or the seat; English word used in Zolai sentences, often written with a capital) (s:ekbuk) (o:English) (r:zd:13089/zd:15732) (q:draft)
Tokyo = (i:1) (t:name) (c:city) (f:travel) (w:Tokyo) (d:capital city of Japan) (r:zd:17432/zd:25918) (q:draft)
tom = (i:1) (t:adj) (f:everyday) (w:short) (d:short in length, distance or time: {lampi tom} is a short road and {hun tom} a short time) (a:sau/sawt) (r:24.25.23) (q:draft)
tomcik = (i:1) (t:adj) (f:everyday/time) (w:very short/brief) (d:<tom>, short, made stronger: very short, brief; {hun tomcik} is a very short time and {tomcik in} is briefly) (b:tom) (r:zd:9429/ts:4885/zd:17818) (q:draft)
tomkal = (i:1) (t:n) (f:time) (w:short time/short term/short while) (d:<tom>, short, with <kal> in the sense of interval: a short span of time; {tomkal sung} is for a short while) (r:zd:11860/zd:22023/zd:21340) (q:draft)
tomkim = (i:1) (t:adj) (f:media/education) (w:brief/concise/in summary) (d:short but complete; placed after a noun, as in {thu tomkim}, a brief account or summary) (r:zd:10788/zd:11434/zd:23170) (q:draft)
tomlak = (i:1) (t:n) (f:education/media) (w:summary/abridgement/excerpt) (d:<tom>, short, with <lak>, take: a short version of a speech or writing, and as a verb, summarise; {a tomlak in} is in short, abbreviated) (r:zd:25110/zd:17051/zd:22646) (q:draft)
tomlakna = (i:1) (t:n) (f:education/media) (w:summary/abridgement/abbreviation) (d:<tom>, short, with <lakna>, taking: a short version of a speech or a text; also the short form of a longer name) (r:zd:9212/zd:24931/zd:12948) (q:draft)
tona = (i:1) (t:n) (f:social) (w:challenge) (d:something that tests or defies a person or group; in the articles mostly followed by the English word challenge in brackets, and {tona lianpi} is a great challenge) (r:zd:23893) (q:draft)
tongdam = (i:1) (t:n) (f:social/media) (w:word/speech/gentle words) (d:word of songs and poetry for speech or words, especially kind or comforting words; {Nisim Tongdam} is the title of a book of daily readings) (r:zd:22683/zd:24253) (q:draft, low confidence)
Tongluan = (i:1) (t:name) (f:media/religion) (w:Tongluan) (d:name of a publication, mostly as {Zonu Tongluan}, a periodical of Zomi church women named beside other church magazines) (r:zd:16052) (q:draft, low confidence)
Tongsan = (i:1) (t:name) (f:media) (w:Tongsan) (d:Tongsan Media Group, a Zomi news site that publishes in Zolai) (r:ts:3179/ts:11162) (q:draft)
Tongsial = (i:1) (t:name) (c:khua) (f:travel/social) (w:Tongsial) (d:a village of the Tedim area; often added after a personal name to show where the person comes from) (r:zd:23304/zd:22862/zd:15947) (q:draft)
Tongzang = (i:1) (t:name) (f:travel) (j:Tonzang) (r:zd:24058) (q:draft)
tonkhop = (i:1) (t:v) (f:social) (w:go together with/accompany/keep in step with) (d:<ton> and <khop> written as one word, the form of <tonkhawm> used before words such as <kei>, <theih> and <ciang>; <tawh>, with, marks the companion) (j:ton/khop) (r:zd:21137/ts:4827/zd:22868) (q:draft)
Tonsim = (i:1) (t:name) (c:khua) (f:travel) (w:Champhai/Tonsim) (d:Zolai name of Champhai, a town in Mizoram, India, near the border of Myanmar) (r:zd:21233/zd:14867/zd:20673) (q:draft)
Tonzaang = (i:1) (t:name) (f:travel) (j:Tonzang) (r:zd:11416/zd:22124) (q:draft)
Topa Jesu = (i:1) (t:name) (c:male) (f:religion) (w:Lord Jesus/the Lord Jesus) (d:<Topa>, Lord, and <Jesu>, Jesus: the title and name together, the Lord Jesus; {i Topa Jesu} is our Lord Jesus) (r:zd:25138/zd:16428) (q:draft)
Topa Jesuh = (i:1) (t:name) (c:male) (f:religion) (w:the Lord Jesus/Lord Jesus) (d:<Topa>, Lord, and <Jesuh>, Jesus: the title and name by which Jesus is spoken of in sermons and church writing, often {i Topa Jesuh}, our Lord Jesus, and {Topa Jesuh Khrist}) (r:zd:21125/zd:11163) (q:draft)
Topa Zeisu = (i:1) (t:name) (f:religion) (w:Lord Jesus/the Lord Jesus) (d:<Topa>, Lord, as a title before <Zeisu>, Jesus: the Lord Jesus, the usual way to name him in church writing) (r:zd:25454/zd:22544/zd:23394) (q:draft)
Topan = (i:1) (t:n) (f:religion) (w:the Lord) (d:<Topa> with the subject marker <in> shortened to {-n}: the Lord as the one who acts, common in blessings) (j:Topa/in) (r:zd:24913/zd:21520/zd:25210) (q:draft)
topan thupha = (i:1) (t:phrase) (f:religion) (w:the Lord bless/may the Lord bless) (d:<Topan>, the Lord as the one who acts, and <thupha>, blessing: opens the closing wish of a letter, article or speech, {Topan thupha hong pia ta hen}, may the Lord bless you; the one blessed stands before it) (r:ts:4827/zd:11425) (q:draft)
Tornado = (i:1) (t:n) (f:nature) (w:tornado) (d:a violent whirling wind; often written with <huihpi>, storm, as {Tornado huihpi}) (o:English) (r:zd:16352/zd:19176) (q:draft)
Toronto = (i:1) (t:name) (c:city) (f:travel) (w:Toronto) (d:the largest city of Canada, in the province of Ontario) (r:zd:24832/zd:19851) (q:draft)
totoding = (i:1) (t:v) (f:everyday/time) (w:will continue/will keep on) (d:<toto>, onward, and the future marker <ding> written as one word; after a verb: will go on doing it, will keep doing it more and more) (j:toto/ding) (r:zd:11778/zd:15745/zd:17597) (q:draft)
totothei = (i:1) (t:adv) (f:everyday) (w:may go on/can keep on) (d:<toto> and <thei> written as one word after a verb: the action can go on further; {ki behlap totothei} is may go on increasing) (j:toto/thei) (r:zd:15554/zd:15782) (q:draft)
Tourism = (i:1) (t:n) (f:travel/work) (w:tourism) (d:the business of receiving visitors who travel for pleasure; found mostly in headlines and in the names of ministries) (o:English) (r:zd:15822) (q:draft, low confidence)
Tourist = (i:1) (t:n) (f:travel) (w:tourist) (d:a foreign visitor who travels for pleasure; mostly before another noun, as in {Tourist Bus}) (o:English) (r:zd:12982) (q:draft, low confidence)
Tourists = (i:1) (t:n) (f:travel) (w:tourist/tourists) (d:the English plural used in Zolai news for people who travel for pleasure, often after <gamdangmi>, foreigner) (o:English) (r:zd:11265/zd:19318) (q:draft, low confidence)
Tournament = (i:1) (t:n) (f:media) (w:tournament) (d:a sports competition of several teams) (o:English) (r:zd:12226/zd:19166/zd:15519) (q:draft)
towel = (i:1) (t:n) (f:home) (w:towel) (o:English) (r:zd:21047/zd:13224) (q:draft)
township = (i:1) (t:n) (f:politics) (w:township) (d:an administrative division of Myanmar below the state or region, a town with the villages around it) (o:English) (r:zd:24325/zd:12341/zd:17339) (q:draft)
townships = (i:1) (t:n) (f:politics) (w:townships) (d:English plural of township, the administrative division below the district in Myanmar, used in Zolai text without the plural <te>) (o:English) (r:zd:25357/zd:21067) (q:draft)
Toyota = (i:1) (t:name) (f:travel) (w:Toyota) (d:a Japanese make of car) (r:zd:17450/zd:12517) (q:draft)
Traffic = (i:1) (t:n) (f:travel) (w:traffic/traffic light) (d:the movement of vehicles on a road; also short for the traffic lights, as in {Traffic khawlna}, the stop at the lights) (o:English) (r:zd:14709/zd:14781/zd:11825) (q:draft, low confidence)
Trailer = (i:1) (t:n) (f:travel) (w:trailer truck/articulated lorry/trailer) (d:a large goods lorry that pulls a trailer, also {Trailer mawtaw}) (o:English) (r:zd:21411/zd:20982) (q:draft)
trailer mawtawpi = (i:1) (t:n) (f:travel) (w:trailer truck/articulated lorry/semi-trailer) (d:{trailer}, the English word, and <mawtawpi>, truck: a large truck that draws a long trailer; the usual name of this vehicle in reports of road accidents) (r:zd:20982/zd:21164) (q:draft)
training = (i:1) (t:n) (f:education/work) (w:training/course) (d:a course of training for a job, a skill or military service) (o:English) (r:zd:20572/ts:6525) (q:draft)
transfer = (i:1) (t:v) (f:work) (w:transfer/be transferred) (d:move or be moved to another place of work, or send money through a bank) (o:English) (r:zd:24029/zd:19166/zd:14646) (q:draft)
transgender = (i:1) (t:n) (f:social) (w:transgender person/transgender) (o:English) (r:zd:24913/zd:25323) (q:draft, low confidence)
Transit = (i:1) (t:n) (f:travel) (w:transit) (d:passing through a country or an airport on the way to another place; {Transit ding} is to pass through and {Transit Visa} a visa for passing through) (o:English) (r:zd:11627/zd:11612/zd:25918) (q:draft)
translate = (i:1) (t:v) (f:education/media) (w:translate) (d:the English verb used in Zolai sentences, often with <bawl> or <sak>: put a text into another language; writers also gloss {kaleh} and {kiteisawn} with it) (o:English) (r:zd:17921/ts:7528/zd:12093) (q:draft)
Transportation = (i:1) (t:n) (f:travel) (w:transportation/transport) (d:the carrying of people and goods, and the vehicles and roads for it; mostly in {public transportation}) (o:English) (r:zd:22686/zd:21961) (q:draft, low confidence)
Treatment = (i:1) (t:n) (f:health) (w:treatment/medical treatment) (d:medical care given to a sick or injured person, used beside {zatui bawl}) (o:English) (r:zd:21067/zd:15123) (q:draft, low confidence)
trial = (i:1) (t:n) (f:health) (w:trial/clinical trial) (d:the testing of a medicine or vaccine on people) (o:English) (r:zd:24369) (q:draft)
trial = (i:2) (t:n) (f:politics) (w:trial/court trial) (d:the hearing of a case in a court of law) (o:English) (r:zd:23513) (q:draft, low confidence)
Tribe = (i:1) (t:n) (f:social/politics) (w:tribe) (d:a tribe, especially as an officially recognised group in India) (s:minam) (o:English) (r:zd:24157/zd:11945) (q:draft)
trillion = (i:1) (t:num) (f:work/education) (w:trillion) (d:the number one million million, mostly of sums of money) (o:English) (r:zd:10984/zd:24955) (q:draft)
trinity = (i:1) (t:n) (f:religion) (w:Trinity) (d:the Christian teaching that God is one in three persons, in Zolai {tothum gawm khat}) (o:English) (r:zd:9239/zd:23943) (q:draft)
Trophy = (i:1) (t:n) (f:media) (w:trophy/cup) (d:a cup or other prize object given to the winner of a competition) (o:English) (r:zd:14767/zd:20179) (q:draft)
Truck = (i:1) (t:n) (f:travel/work) (w:truck/lorry) (d:a large motor vehicle that carries goods, often written before <mawtawpi>) (o:English) (r:zd:12113/zd:11579) (q:draft)
Tsunami = (i:1) (t:n) (f:nature) (w:tsunami) (d:a great sea wave that floods the coast, usually after an earthquake; also explained as {tuipi zinlin} and {tuihualpi}) (o:English) (r:zd:23784/zd:15089) (q:draft)
tu = (i:2) (t:v) (f:everyday/body) (w:sit) (r:zai:sit) (q:draft)
tu = (i:3) (t:n) (f:family) (w:grandchild) (d:the child of one's son or daughter) (r:zai:grandchild) (q:draft)
tu laitaka = (i:1) (t:adj) (f:time) (w:present/current/of this moment) (d:<tu>, in the sense this or present and not sit, and <laitaka>, at the very time: of right now; stands before a noun or a clause, the present or current one; without the linking <a> the form {tu laitak} is the adverb right now) (s:tuhun) (r:zd:20581/zd:21230) (q:draft)
tu tadih = (i:1) (t:adv) (f:time) (w:for now/for the time being/at present) (d:<tu>, in the sense this or present and not sit, and <tadih>, for now: for the time being, as things stand now; opens a clause, alone or followed by <in>) (r:zd:24573/zd:20358) (q:draft)
tu-in = (i:1) (t:adv) (f:everyday/time) (w:now) (r:zai:now) (q:draft)
tua = (i:1) (t:pron) (f:everyday) (w:that/those) (d:points to a person or thing already mentioned or known; before a noun it means that or those, and {tua ciangin} is then, after that) (a:hih) referring to a specific thing previously mentioned, known, or understood
tua ahihman = (i:1) (t:conj) (f:everyday) (w:therefore/for that reason/so) (d:<tua>, that, and <ahihman>, because it is so: opens a sentence and draws the conclusion from what was said before; it is followed by <in> written apart, {tua ahihman in}) (r:zd:23943/zd:12112) (q:draft)
tua ahihmanin = (i:1) (t:conj) (f:everyday) (w:therefore/for that reason/so) (d:<tua>, that, and <ahihmanin>, because it is so: opens a sentence and draws the conclusion from what was said before) (r:zd:21085/zd:20572) (q:draft)
tua banga = (i:1) (t:adv) (f:everyday) (w:like that/in that way/such) (d:<tua>, that, and <banga>, like: placed before a verb, in that way; before a noun, such, of that kind; it points back to what was just told) (r:zd:20942/zd:9240) (q:draft)
tua bangteng = (i:1) (t:phrase) (f:everyday) (w:all that/all such things) (d:<tua>, that, with <bangteng>, the things of that kind: all those things just described, standing as subject or object or before <tawh>, with all that, amid all that) (r:zd:21869/zd:20117/zd:14824) (q:draft)
tua hikeileh = (i:1) (t:conj) (f:everyday) (w:otherwise/or else/if not) (d:<tua>, that, and <hikeileh>, if it is not: if that is not so; stands at the head of a sentence and says what follows when the thing just named is not done) (r:zd:24276/zd:23985) (q:draft)
tua kawmkal = (i:1) (t:adv) (f:time) (w:meanwhile/in the meantime/during that) (d:<tua>, that, and <kawmkal>, interval: followed by <ah> at the head of a sentence, meanwhile, while that was going on) (r:zd:16157/zd:17067) (q:draft)
tua khitteh = (i:1) (t:conj) (f:everyday/time) (w:after that/then/afterwards) (d:<tua>, that, and <khitteh>, after: after that, then; stands at the start of a sentence and joins it to what was told before) (r:zd:16038/ts:5480) (q:draft)
tuaban = (i:1) (t:adv) (f:everyday) (w:besides that/in addition/moreover) (d:<tua> and <ban> written as one word and followed by <ah> or <in>: on top of that, besides that, after that) (j:tua/ban) (r:zd:17542/zd:17689/zd:15467) (q:draft)
tuabanah = (i:1) (t:conj) (f:everyday) (w:besides that/in addition/moreover) (d:<tua>, that, with <banah>, in addition to, written as one word at the head of a sentence) (j:tua/banah) (r:zd:11702/zd:11224) (q:draft)
tuabang = (i:1) (t:adv) (f:everyday) (w:like that/such/in that way) (d:<tua> and <bang> written as one word: like that, of that kind; {tuabang mah} is just the same) (j:tua/bang) (r:zd:24248/zd:18206/zd:19800) (q:draft)
tuabang tengtawh = (i:1) (t:adv) (f:everyday/media) (w:in that state/like that/with all that) (d:<tuabang>, like that, and <tengtawh>, with all of it: in that condition, things being so; opens a sentence that tells what happened next or how long the state lasted) (r:zd:21850/zd:23343) (q:draft)
tuabangaa = (i:1) (t:adv) (f:everyday) (w:in that way/like that/thus) (d:<tua>, <bang.2> and <aa> written as one word, at the start of a clause: in that way, that being so; <aa> here is the linking word that others write <a> or <in>) (j:tua/bang/aa) (r:zd:19166/zd:22827/zd:20627) (q:draft)
tuabangdan = (i:1) (t:det) (f:everyday) (w:such/that kind of/like that) (d:<tua>, that, <bang>, like, and <dan>, manner, written as one word: of that kind, placed before a noun or used alone for such a thing) (j:tua/bang/dan) (r:zd:19239/zd:12115/zd:21389) (q:draft)
tuabangin = (i:1) (t:adv) (f:everyday) (w:in that way/like that/so) (d:<tua> and <bangin> written as one word: in the way just described) (j:tua/bangin) (r:zd:20092/zd:14824) (q:draft)
tuabangte = (i:1) (t:pron) (f:everyday) (w:such ones/such people/such things) (d:<tua> that and <bangte> written as one word: people or things like that) (j:tua/bangte) (r:zd:19166/zd:15946) (q:draft)
tuabek = (i:1) (t:adv) (f:everyday) (w:only that/that alone) (d:<tua> and <bek> written as one word: that alone; {tuabek hilo} and <tuabek thamlo> open a sentence as not only that, moreover) (j:tua/bek) (r:zd:23972/zd:19964/zd:20545) (q:draft)
tuabek thamlo = (i:1) (t:conj) (f:everyday) (w:not only that/moreover/besides) (d:<tuabek>, that alone, and <thamlo>, not only: opens a sentence that adds a further fact to what was just said) (r:zd:13222/zd:12942) (q:draft)
tuaciang = (i:1) (t:adv) (f:everyday/time) (w:then/after that/at that point) (d:<tua> and <ciang> written as one word, mostly followed by <in>: then, when that had happened, the usual way to begin the next step of a report; {tuaciang dong} is up to that point) (j:tua/ciang) (r:zd:15920/zd:16598/zd:15067) (q:draft)
tuaciangin = (i:1) (t:conj) (f:everyday/time) (w:then/after that/and then) (d:<tua> and <ciangin> written as one word: after that, then; it opens a sentence that tells what happened next) (j:tua/ciangin) (r:zd:20755/zd:24276/zd:21015) (q:draft)
tuadan = (i:1) (t:adv) (f:everyday) (w:like that/that way/such) (d:<tua> and <dan> written as one word: in that way, in that manner; before a noun, that kind of) (j:tua/dan) (r:zd:18206/zd:17599/zd:20834) (q:draft)
tuahang = (i:1) (t:conj) (f:everyday) (w:therefore/because of that/for that reason) (d:<tua> and <hang> written as one word, that reason; it begins a sentence, mostly as {tuahang in}, because of that) (j:tua/hang) (r:zd:15928/zd:20663/zd:14770) (q:draft)
tuahangin = (i:1) (t:conj) (f:everyday) (w:because of that/therefore/for that reason) (d:<tua>, that, and <hangin>, because of, written as one word at the start of a sentence: because of that) (s:tuahang) (j:tua/hangin) (r:zd:21092/zd:13076) (q:draft)
tuahi = (i:1) (t:conj) (f:everyday) (w:therefore/that being so/so) (d:<tua>, that, and <hi>, be, written as one word and followed by <a> or <in>: that being so, opening a sentence that draws a conclusion; {tuahi leh} is if so) (j:tua/hi) (r:zd:17822/zd:24420/zd:19556) (q:draft)
tuahiaa = (i:1) (t:conj) (f:everyday) (w:therefore/so) (d:<tua>, <hi> and <a> written as one word at the head of a sentence, that being so: therefore) (j:tua/hi/a) (r:zd:20896/zd:23888) (q:draft)
tuahileh = (i:1) (t:conj) (f:everyday) (w:then/in that case/if so) (d:<tua>, that, with <hileh>, if it is, written as one word: if that is so, then; opens a sentence that tells what follows) (j:tua/hileh) (r:zd:14826/zd:20657/zd:22740) (q:draft)
tuahkhak thu = (i:1) (t:n) (f:everyday) (w:experience/what one has met with) (d:<tuahkhak>, happen to meet, and <thu>, matter: a thing that has happened to someone, an experience; the one who had it stands before, as in {ka tuahkhak thu}, my experience) (r:zd:20264/zd:16148/zd:23901) (q:draft)
tuahun laitak = (i:1) (t:adv) (f:time) (w:at that very moment/just then/at the time) (d:<tuahun>, at that time, and <laitak>, at the very time: followed by <in>, opens a sentence that tells what was going on at the moment of the event just told) (r:zd:14726/zd:11345) (q:draft)
tuahunlai = (i:1) (t:adv) (f:time) (w:at that time/then/in those days) (d:<tuahun>, that time, and <lai>, while, written as one word: at that time in the past, usually followed by <in>) (s:tuahun) (j:tuahun/lai) (r:zd:16713/zd:12057) (q:draft)
tuahunsung = (i:1) (t:adv) (f:time) (w:during that time/in that period/meanwhile) (d:<tua> and <hunsung> written as one word: within that time) (j:tua/hunsung) (r:zd:13211/zd:15463) (q:draft)
tuailai = (i:1) (t:n) (f:social/family) (w:youth/young people) (d:the young people of a community, often paired with <khangno> or <khangthak>; a word of the northern Zo dialects used also in Zolai writing) (r:zd:24452/zd:20148) (q:draft)
tuakawm = (i:1) (t:conj) (f:everyday) (w:meanwhile/at the same time) (d:<tua>, that, and <kawm>, while, written as one word, mostly followed by <in>: while doing that, at the same time as that) (j:tua/kawm) (r:zd:15274/zd:19335) (q:draft)
tuakhit = (i:1) (t:adv) (f:everyday/time) (w:after that/then) (d:<tua> and <khit> written as one word, mostly as {tuakhit ciangin}: after that) (j:tua/khit) (r:zd:18125/zd:15170) (q:draft)
tuakhitciang = (i:1) (t:conj) (f:everyday/time) (w:after that/then/afterwards) (d:<tua>, that, with <khit> and <ciang>, after, written as one word: after that, then; also followed by <in>) (j:tua/khit/ciang) (r:zd:19351/zd:11904) (q:draft)
tuakhitciangin = (i:1) (t:adv) (f:time) (w:after that/afterwards/then) (d:<tua>, <khit> and <ciangin> written as one word: after that, next) (j:tua/khit/ciangin) (r:zd:11757/zd:11447) (q:draft)
tuakhitzawh = (i:1) (t:adv) (f:time/media) (w:after that/afterwards/then) (d:<tua>, that, and <khitzawh>, after, written as one word, mostly at the start of a sentence: after that) (s:tuazawh) (j:tua/khitzawh) (r:zd:20738/zd:19962) (q:draft)
tuakte = (i:1) (t:n) (f:everyday) (w:those who meet with/those who suffer) (d:<tuak>, meet with, and the plural <te> written as one word: the people who meet with or suffer something, or the things that are met with; {sihna tuakte} are those who died) (j:tuak/te) (r:zd:9430/zd:11046) (q:draft)
tuakte = (i:2) (t:n) (f:everyday) (w:things that ought to be done) (d:<tuak>, be fitting, and the plural <te> written as one word after a verb: the things that it is right to do; {sep tuakte} are the things one ought to do) (j:tuak/te) (r:zd:22371/zd:16500) (q:draft)
tualai = (i:1) (t:adv) (f:time) (w:at that time/then/in those days) (d:<tua>, that, with <lai>, time, written as one word, often followed by <in>: at the time spoken of) (r:zd:24231/zd:19581) (q:draft)
tualai ah = (i:1) (t:adv) (f:everyday/media) (w:there/at that place/on that occasion) (d:<tualai>, that place or time, and the place marker <ah>: at the place or event just spoken of; it opens a sentence that tells what happened there) (r:zd:25203/zd:11827) (q:draft, low confidence)
tualaitak = (i:1) (t:adv) (f:time) (w:at that very time/just then/at that moment) (d:<tua> and <laitak> written as one word: at the very time just spoken of) (j:tua/laitak) (r:zd:15368/zd:16490/zd:15125) (q:draft)
tualak = (i:1) (t:adv) (f:everyday) (w:among them/among those) (d:<tua>, that, with <lak>, midst, written as one word and followed by <ah> or <panin>: among them, from among them) (j:tua/lak) (r:zd:15305/zd:17107/zd:22821) (q:draft)
tualakah = (i:1) (t:adv) (f:everyday) (w:among them/among those) (d:<tua>, that, and <lakah>, among, written as one word: among them, of those just mentioned) (j:tua/lakah) (r:zd:19906/zd:23727) (q:draft)
tualam = (i:1) (t:n) (f:travel/everyday) (w:that direction/that way/that side) (d:<tua> and <lam> written as one word: that direction or side, there; {tualam ah} is that way, toward it) (j:tua/lam) (r:zd:25346/zd:21221) (q:draft)
tualeh = (i:1) (t:conj) (f:everyday) (w:and/and then/moreover) (d:<tua> and <leh> written as one word, at the start of a sentence: and, and then, in that case) (j:tua/leh) (r:zd:21502/zd:19603/zd:14720) (q:draft)
tualgal = (i:1) (t:n) (f:politics) (w:civil war/internal conflict) (d:<tual>, local, with <gal>, war: war inside one country or among one's own people) (r:zd:19662/zd:18142/zd:24743) (q:draft)
tualmi = (i:1) (t:n) (f:social/politics) (w:native/local person/indigenous people) (d:<tual>, native, with <mi>, person: one who belongs to the place, set against <khualmi>, a stranger; {tualmi nam} is an indigenous people of a country) (s:tualsuak) (a:khualmi) (r:zd:22827/zd:15553) (q:draft)
tualniam = (i:1) (t:adj) (f:social) (w:lowly/base/degraded/despised) (d:low in standing or in character, looked down on by others; {tualniam lungsim} is a base mind) (r:ts:9859/zd:21044/zd:22757) (q:draft)
tualnuam = (i:1) (t:n) (f:religion/social) (w:pleasant land/fair home) (d:poetic word, <tual>, open ground of a village, with <nuam>, pleasant: a pleasant dwelling place; in songs and words of mourning it stands for heaven, as in {thangvan tualnuam}, or for a home town) (r:zd:24462/zd:19866) (q:draft, low confidence)
tualo = (i:1) (t:adv) (f:everyday) (w:besides that/apart from that/otherwise) (d:<tua> and <lo> written as one word at the start of a clause: other than that, in addition; {tualo teng} and {tualo te} are the others, the rest) (j:tua/lo) (r:zd:15743/zd:11214) (q:draft)
tualthahna = (i:1) (t:n) (f:politics/social) (w:murder/killing/massacre) (d:the killing of people of one's own community or of people who are not enemies in war; of a whole people, massacre or genocide) (r:zd:16254/zd:20667) (q:draft)
tualthat = (i:1) (t:n) (f:politics/social) (w:murderer/murder/homicide) (d:one who kills a person of his own community, a murderer; also the act itself; often paired with <mithat>) (s:mithat) (r:zd:24221/zd:24115) (q:draft)
tuam = (i:2) (t:adj) (f:everyday) (w:different/separate/apart) (d:separate from the others or different from them: {a tuam} is separately, {tuam om} is live apart, {nu tuam} is of a different mother) (s:tuamdang) (a:kibang) (q:draft)
tuam vilvel = (i:1) (t:adv) (f:everyday) (w:specially/quite separately/distinctly) (d:<tuam>, separate, with the expressive word <vilvel>, which strengthens it: wholly apart from the rest, in a special way of its own; used as {a tuam vilvel in} or {a tuam vilvel a} before a verb, or as {a tuam vilvel} before a noun) (r:zd:9124/zd:20814/ts:3508) (q:draft)
tuama = (i:1) (t:adv) (f:time) (w:before that/previously/earlier) (d:<tua> and <ma> written as one word, mostly followed by <in>: before that, up to then) (j:tua/ma) (r:zd:15501/zd:24574) (q:draft)
tuama = (i:2) (t:adv) (f:everyday) (w:separately/apart) (d:<tuam>, separate, with the ending <a>, written as one word and mostly after <a>: {a tuama}, separately, apart from the rest) (j:tuam/a) (r:zd:25139) (q:draft, low confidence)
tuamahbangin = (i:1) (t:adv) (f:everyday) (w:likewise/in the same way/similarly) (d:<tuamah> and <bangin> written as one word, at the start of a sentence: in that same way, likewise) (j:tuamah/bangin) (r:zd:21097/zd:22116/zd:23343) (q:draft)
tuamding = (i:1) (t:v) (f:everyday/health) (w:should cover/to wrap) (d:<tuam>, cover or wrap, and <ding>, written as one word: must cover, is to be wrapped) (j:tuam/ding) (r:zd:21306/zd:12654) (q:draft)
tuamding = (i:2) (t:part) (f:everyday) (w:will all the more/will be the better for it) (d:<tuam>, here placed after a verb for the more so as a result, and <ding>, will, written as one word: will do or be so all the more because of what was said before) (j:tuam/ding) (r:zd:20239/zd:19340) (q:draft)
tuamtuampan = (i:1) (t:adv) (f:everyday/media) (w:from various) (d:<tuamtuam> and <pan> written as one word after a noun: from various ones, as {media tuamtuampan}, from various media) (j:tuamtuam/pan) (r:zd:18154/zd:14836) (q:draft)
tuamtuamtawh = (i:1) (t:adv) (f:everyday) (w:with various/by various) (d:<tuamtuam> and <tawh> written as one word: with, by or because of various things of the kind named before it) (j:tuamtuam/tawh) (r:zd:17841/zd:21649/zd:14869) (q:draft)
tuamtuamzong = (i:1) (t:adj) (f:everyday) (w:various also/of many kinds too) (d:<tuamtuam> various and <zong> also, written as one word after a noun: different kinds of it as well) (j:tuamtuam/zong) (r:zd:19565/zd:19872/zd:14965) (q:draft)
tuamun = (i:1) (t:n) (f:everyday/travel) (w:that place/there) (d:<tua> and <mun> written as one word: that place, the place just spoken of) (j:tua/mun) (r:zd:17374/zd:15848/zd:19786) (q:draft)
tuangdung = (i:1) (t:n) (f:home) (w:floor platform/house floor) (d:part of the traditional house named with the veranda and the shelves, apparently the planked floor or raised platform of the main room; also the name of a village, written {Tuangdung}) (r:zd:22784/zd:11110) (q:draft, low confidence)
tuangkhawm = (i:1) (t:v) (f:travel) (w:ride together/travel together) (d:<tuang> and <khawm> written as one word: ride on the same vehicle, boat or animal together) (j:tuang/khawm) (r:zd:11649/zd:15790/zd:16757) (q:draft)
tuankei = (i:1) (t:part) (f:everyday) (w:not for all that/not anyway) (d:<tuan> and the negative <kei>, written as one word after a verb: not so in spite of what was done or said, still not, not any the more) (j:tuan/kei) (r:zd:13181/zd:10973/zd:20481) (q:draft)
tuanlo = (i:1) (t:adv) (f:everyday) (w:not for all that/not either/not necessarily) (d:<tuan> and <lo> written as one word after a verb: not so in spite of what was said or expected) (j:tuan/lo) (r:zd:8667/zd:21911/zd:18952) (q:draft, low confidence)
tuansak = (i:1) (t:v) (f:everyday) (w:put on/place upon/set over) (d:<tuan>, form of <tuang>, ride, be on top, and the causative <sak> written as one word: make something be on or above another thing, as an image on money or one matter above another) (j:tuan/sak) (r:zd:20950/zd:15956) (q:draft, low confidence)
tuantual = (i:1) (t:v) (f:social/politics) (w:lag behind/fall behind/be backward) (d:be behind others in progress or development, said of a people, a country or a pupil) (r:zd:24230/zd:20018/zd:18086) (q:draft)
tuap = (i:1) (t:n) (f:body/health) (w:lung/lungs) (d:the organ of breathing in the chest; {tuap natna} is a disease of the lungs) (r:zd:21388/zd:24276/zd:20841) (q:draft)
tuapan = (i:1) (t:adv) (f:everyday/time) (w:from there/from that/after that) (d:<tua>, that, with <pan>, from, written as one word, often followed by <in>: from that place, from that time on, as a result of that) (j:tua/pan) (r:zd:20806/zd:12271/zd:17009) (q:draft)
tuapanin = (i:1) (t:adv) (f:everyday) (w:from there/after that/then) (d:<tua>, that, and <panin>, from, written as one word: from that place, from that point or amount, after that) (j:tua/panin) (r:zd:17605/zd:19569/zd:17572) (q:draft)
tuapapen = (i:1) (t:pron) (f:everyday) (w:that man/he) (d:<tuapa> that man and the topic marker <pen> written as one word: as for that man, he) (j:tuapa/pen) (r:zd:15759/zd:16786/zd:11060) (q:draft)
tuapen = (i:1) (t:pron) (f:everyday) (w:that/that one) (d:<tua> and <pen> written as one word: that, as the topic of the sentence; it takes up what was just said, that is) (j:tua/pen) (r:zd:21075/zd:12341/zd:25919) (q:draft)
tuaphual = (i:1) (t:n) (f:everyday/media) (w:that place/the scene/the spot) (d:<tua>, that, and <phual>, place, written as one word: the place where the thing just told happened; {tuaphual panin} is from the scene) (j:tua/phual) (r:zd:17023/zd:19562) (q:draft)
tuapsung = (i:1) (t:n) (f:body/health) (w:lungs/inside of the lungs) (d:the lungs, the inside of the chest where the breath goes, from <tuap>, lung, with <sung>, inside; {tuapsung natna} is disease of the lungs) (r:zd:20778/zd:23906/zd:13112) (q:draft)
tuasan = (i:1) (t:adv) (f:everyday/travel) (w:there/in that place) (d:<tua>, that, with <san>, place; used in {tuasan takah}, in that very place, there) (b:tua) (r:43.5.5) (q:draft)
tuasang = (i:1) (t:adv) (f:everyday) (w:than that/more than that) (d:<tua>, that, with the comparative word <sangin> shortened, written as one word, with or without <in>: compared with that, more than that; {tuasang in thupi zaw} is more important than that) (b:tua) (r:zd:25924/zd:22638/zd:25919) (q:draft)
tuasangin = (i:1) (t:adv) (f:everyday) (w:more than that/rather than that) (d:<tua> and <sangin> written as one word: than that, usually with <zaw> on the following word, or rather than that) (j:tua/sangin) (r:zd:21876/zd:17202/zd:15292) (q:draft)
tuasung = (i:1) (t:adv) (f:everyday) (w:in that/among them/in it) (d:<tua> and <sung> written as one word: inside that, among those just mentioned; {tuasung ah} is in it and {tuasung pan} is from among them) (j:tua/sung) (r:zd:16796/zd:22293/zd:14665) (q:draft)
tuasungah = (i:1) (t:adv) (f:everyday) (w:in it/in there/therein/among them) (d:<tua>, that, and <sungah>, inside, written as one word: in that, inside it, among those just mentioned) (j:tua/sungah) (r:zd:17297/zd:19754/zd:19520) (q:draft)
tuatawh = (i:1) (t:adv) (f:everyday) (w:with that/thereby/then) (d:<tua> and <tawh> written as one word: with that, by that, following on that; {tuatawh kizui in} is in accordance with that) (j:tua/tawh) (r:zd:16331/zd:15619) (q:draft)
tuatepen = (i:1) (t:pron) (f:everyday) (w:those/they) (d:<tuate>, those, and the topic marker <pen> written as one word: as for those, they) (j:tuate/pen) (r:zd:17794/zd:19927/zd:25924) (q:draft)
tuatezong = (i:1) (t:pron) (f:everyday) (w:they too/those also) (d:<tuate>, those, and <zong>, also, written as one word: those too, they as well) (j:tuate/zong) (r:zd:17094/zd:15243/zd:19860) (q:draft)
tuathu = (i:1) (t:n) (f:everyday) (w:that matter/that event) (d:<tua>, that, and <thu>, matter, written as one word: the matter or event just spoken of) (j:tua/thu) (r:zd:21876/zd:11880/zd:14660) (q:draft)
tuatung = (i:1) (t:adv) (f:everyday) (w:on it/on that/up there) (d:<tua>, that, and <tung>, top, written as one word: on top of the thing just named; {tuatung panin} is from up there, {tuatung ah} is on it) (j:tua/tung) (r:zd:17023/zd:17141) (q:draft)
tuatung = (i:2) (t:adv) (f:time) (w:that time/on that occasion) (d:<tua>, that, with <tung>, time or occasion, written as one word: that time, of an event just named) (j:tua/tung) (r:zd:15368) (q:draft, low confidence)
tuatungtawn = (i:1) (t:adv) (f:everyday) (w:through that/by that means/from there) (d:<tua> and <tungtawn> written as one word: through that, by means of that, and so as a result of it; usually followed by <in>) (j:tua/tungtawn) (r:zd:20132/zd:11308/zd:20363) (q:draft)
tuavai = (i:1) (t:n) (f:everyday/media) (w:that matter/that affair) (d:<tua> and <vai> written as one word: that matter, the affair just spoken of; {tuavai tawh kisai in} is concerning that matter) (j:tua/vai) (r:zd:14770/zd:18144) (q:draft)
tuazawh asawtlo = (i:1) (t:adv) (f:time/media) (w:soon afterwards/shortly after/not long after that) (d:<tuazawh>, after that, with <asawtlo>, not long: opens a sentence and is followed by <in>, shortly after what was just told) (r:zd:22167/zd:20193) (q:draft)
tuazom = (i:1) (t:adv) (f:everyday) (w:next/after that/second to that) (d:<tua>, that, and <zom>, the one that comes next, written as one word and followed by <ah>: next after that in order or rank) (j:tua/zom) (r:zd:12190/zd:13186) (q:draft)
tuazong = (i:1) (t:adv) (f:everyday) (w:that too/even that/also) (d:<tua>, that, and <zong>, also, written as one word: that too, and even that) (j:tua/zong) (r:zd:11630/zd:11846/zd:11327) (q:draft)
tuciang = (i:1) (t:adv) (f:time) (w:until now/up to now/so far) (d:<tu>, now, with <ciang>, up to, written as one word and often followed by <dong>: up to the present; {tuciang in} is at present) (j:tu/ciang) (r:zd:15644/zd:19846/zd:24068) (q:draft)
tuciang dong = (i:1) (t:adv) (f:time) (w:until now/up to now/so far/still) (d:<tuciang>, up to now, and <dong>, until: right up to the present; stands before the verb, which is often negative with <nailo> or <zolo>, not yet) (r:zd:15644/zd:19239) (q:draft)
tuciangciang = (i:1) (t:adv) (f:time) (w:so far/up to now/thus far) (d:<tu> and <ciangciang> written as one word: up to the present time) (j:tu/ciangciang) (r:zd:20387/zd:15481/zd:15385) (q:draft)
tuciangin = (i:1) (t:adv) (f:time) (w:now/nowadays/at present) (d:<tu>, the present, and <ciangin> written as one word: now, at this time, often in contrast with an earlier time) (s:tu-in) (j:tu/ciangin) (r:zd:19166/zd:22922) (q:draft)
tudongmah = (i:1) (t:adv) (f:time) (w:still/even now/to this day) (d:<tudong>, until now, and the emphatic <mah> written as one word: even up to now, still) (j:tudong/mah) (r:zd:11782/zd:12053/zd:11945) (q:draft)
Tuesday = (i:1) (t:n) (c:ni) (f:time) (w:Tuesday) (s:sepkikni/pithai) (o:English) (r:zd:15342/zd:15729) (q:draft)
tuhun ciangin = (i:1) (t:adv) (f:time) (w:nowadays/these days/at present) (d:<tuhun>, the present time, and <ciangin>, when: nowadays, in our time; opens a sentence or clause, often set against an earlier time such as {nidang lai-in}, in former days) (r:zd:20410/zd:11775/zd:23551) (q:draft)
tuhun teh = (i:1) (t:adv) (f:time) (w:nowadays/these days/at present) (d:<tuhun>, the present time, and <teh>, here a word for when or at, not measure: nowadays, placed at the start of a clause and often followed by <ta> on the verb to contrast the present with the past) (s:tulaitak) (r:zd:23301/zd:25451) (q:draft)
tuhunciang = (i:1) (t:adv) (f:time) (w:nowadays/at the present time/these days) (d:<tuhun> and <ciang> written as one word: at the present time, nowadays; often followed by <in>) (j:tuhun/ciang) (r:zd:20984/zd:16580/zd:15280) (q:draft)
tui = (i:1) (t:n) (f:food/nature) (w:water) (d:water, and any liquid; the first part of many compounds, such as <tuikhuk>, well, and <tuipi>, sea)
tui hai = (i:1) (t:n) (f:food/health) (w:glass of water/cup of water) (d:<tui>, water, and <hai>, cup: a cup or glass of water, used as a measure with a number after it, {tui hai khat}, one glass of water; also the cup that water is drunk from) (r:zd:16665/zd:24276/zd:15730) (q:draft)
tui pipe = (i:1) (t:n) (f:home/work) (w:water pipe/water main/water pipeline) (d:<tui>, water, and <pipe>, pipe: the pipe or pipeline that brings water to a town or house; often after the name of the source or town) (r:zd:15855/zd:19652) (q:draft)
tuibang = (i:1) (t:adv) (f:nature/social) (w:like water) (d:<tui>, water, and <bang>, like, written as one word; a figure of songs and sayings, as {tuibang kigawm}, join together like water, be united) (j:tui/bang) (r:zd:16790/zd:23355) (q:draft)
tuibuahpawi = (i:1) (t:n) (f:social/time) (w:water festival/Thingyan) (d:<tuibuah>, pouring water, with <pawi>, festival: the Burmese new year water festival, Thingyan, in April; also said of the same festival in Thailand) (r:zd:12115/zd:19342) (q:draft)
tuibuk = (i:1) (t:n) (f:health/everyday) (w:nicotine water/tobacco water) (d:water charged with tobacco smoke in a pipe, kept in a small gourd and held in the mouth; {tuibuk muam} is to hold it in the mouth) (r:zd:9448/zd:14804) (q:draft)
tuibuk = (i:2) (t:n) (f:home) (w:bathroom/washroom) (d:a room for washing, named beside <ekbuk>, the toilet) (r:zd:24054) (q:draft, low confidence)
tuibuuk = (i:1) (t:n) (f:social/health) (w:nicotine water/tobacco water) (d:water charged with tobacco smoke in a water pipe, which Zomi keep in the mouth and spit out; {tuibuuk muam} is hold it in the mouth; named with tobacco, betel and drink as a habit) (r:zd:25200/zd:17087) (q:draft)
tuibuuk = (i:2) (t:n) (f:home) (w:bathroom/washroom) (d:<tui>, water, with <buuk>, hut or small room: a room for washing, named beside {eekbuuk}, toilet) (r:zd:25115) (q:draft, low confidence)
Tuicinlui = (i:1) (t:name) (c:khua) (f:travel) (w:Tuicinlui) (d:a village of the Tedim area, also written after a personal name to show where the person comes from) (r:zd:21182) (q:draft, low confidence)
tuiduh = (i:1) (t:adj) (f:everyday/food/body) (w:thirsty) (d:<tui>, water, with <duh>, want: wanting water, thirsty; {tuiduh mite} are the thirsty) (s:dangtak) (b:duh)
tuikhanggawp = (i:1) (t:v) (f:nature) (w:be badly flooded/flood severely) (d:<tuikhang>, flood, and <gawp>, severely, written as one word: there is heavy flooding) (j:tuikhang/gawp) (r:zd:15257/zd:12717/zd:16061) (q:draft)
tuikhanna = (i:1) (t:n) (f:nature) (w:flood/flooding) (d:<tuikhang>, flood, with the noun suffix {-na}: the rising and overflowing of water, a flood) (s:tuicin) (b:tuikhang) (r:zd:14942/zd:22650/zd:24490) (q:draft)
Tuikhiang = (i:1) (t:name) (c:khua) (f:travel) (w:Tuikhiang) (d:village in the Tonzang area of Chin State) (r:zd:25479/ts:3168) (q:draft)
tuikholna = (i:1) (t:n) (f:nature/work) (w:reservoir/dam/water tank) (d:<tui>, water, with <kholna>, place of storing: a place built to store water, a reservoir, dam or tank) (s:tuibem/tuibeem) (r:zd:20627/zd:22650) (q:draft)
tuikhulh = (i:1) (t:n) (f:nature) (j:tuikulh) (r:zd:16340/zd:20580) (q:draft)
tuikivung = (i:1) (t:n) (f:nature/home) (w:standing water/pool of water/puddle) (d:water that has collected and stands in one place, from <tui>, water, and {kivung}, be held: the water in a toilet bowl, a puddle by the road, a pond, or stagnant water in which mosquitoes breed) (r:zd:16177/zd:20008/zd:13334) (q:draft)
tuikulhtung = (i:1) (t:phrase) (f:nature/travel) (w:on the island/island) (d:<tuikulh>, island, and <tung>, on, written as one word: on an island, the island as a place, placed after its name) (j:tuikulh/tung) (r:zd:16304/zd:11600) (q:draft)
Tuilang = (i:1) (t:name) (c:khua) (f:travel) (w:Tuilang) (d:a village near Tedim, on the Tedim road) (r:zd:15743/zd:23767) (q:draft)
Tuilangh = (i:1) (t:name) (c:khua) (f:travel) (w:Tuilangh) (d:village of the Tedim area in Chin State; written in brackets after a personal name it tells the home village) (r:zd:16983/zd:11409) (q:draft)
tuilum = (i:1) (t:n) (f:food/health/home) (w:warm water/hot water) (d:<tui>, water, and <lum>, warm, written as one word: warm or hot water for drinking or bathing) (j:tui/lum) (r:zd:22499/zd:24054/zd:21826) (q:draft)
tuinaak = (i:1) (t:n) (f:nature) (j:tuinak) (r:zd:17387/zd:15996) (q:draft)
tuinawl = (i:1) (t:n) (f:nature/travel) (w:water's edge/shore/bank) (d:<tui>, water, with <nawl>, edge: the edge of a river, lake or sea, where the water meets the land) (r:zd:18134/zd:19262) (q:draft)
tuinek = (i:1) (t:n) (f:home/health) (w:drinking water/water supply) (d:<tui>, water, with <nek>, to drink: water for drinking, and the supply of it to a town or village) (j:tui/nek) (r:zd:16862/zd:14790) (q:draft)
tuinin = (i:1) (t:n) (f:home/health) (w:waste water/sewage/drain water) (d:<tui>, water, with <nin>, dirty: used water that runs off from a house, bathroom or sewer) (r:zd:17295/zd:12387) (q:draft)
tuiphum pawlpi = (i:1) (t:n) (f:religion) (w:Baptist church/Baptist denomination) (d:<tuiphum>, baptize by immersion, and <pawlpi>, church: the Baptist church, both the denomination and one congregation of it; the name of a village or people stands before it, {Zomi Tuiphum pawlpi}) (r:zd:21547/zd:24186) (q:draft)
tuipigal = (i:1) (t:n) (f:travel/social) (w:overseas/abroad/land across the sea) (d:<tuipi>, sea, with <gal>, the other side: the countries beyond the sea, named beside <Kawlgam>, Myanmar, and <Vaigam>, India, as the places where Zomi live) (j:tuipi/gal) (r:zd:20507/zd:16588) (q:draft)
tuipinawl = (i:1) (t:n) (f:nature/travel) (w:beach/seashore/coast) (d:<tuipi>, sea, with <nawl>, edge: the land along the sea, a beach) (r:zd:15245/zd:15822/zd:16360) (q:draft)
tuisa = (i:1) (t:n) (f:food/home) (w:hot water/boiling water) (d:<tui>, water, with <sa>, hot: hot or boiling water) (j:tui/sa) (r:zd:15425/zd:25223) (q:draft)
tuisiangtho = (i:1) (t:n) (f:food/health) (w:drinking water/purified water/clean water) (d:<tui>, water, with <siangtho>, here clean and pure: clean water that is safe to drink, also purified or bottled drinking water) (s:tuisiang) (r:zd:14790/zd:25909) (q:draft)
tuisik = (i:1) (t:n) (f:home/food) (w:water/tap water/drinking water) (d:plain water for drinking and washing, and the water supply of a town; set beside <tuisiang>, clean water) (r:zd:17668/zd:18042/zd:17958) (q:draft)
tuisungah = (i:1) (t:adv) (f:nature/everyday) (w:in the water/into the water/under water) (d:<tui>, water, and <sungah>, inside, written as one word: in or into the water) (j:tui/sungah) (r:zd:14301/zd:20747/zd:19427) (q:draft)
tuisunglutsiam = (i:1) (t:n) (f:work/nature) (w:diver) (d:<tuisung>, in the water, <lut>, go in, and <siam>, skilled, written as one word: a person trained to go under water) (j:tuisung/lut/siam) (r:zd:21366/zd:20289) (q:draft)
tuitawh = (i:1) (t:adv) (f:everyday/home) (w:with water) (d:<tui>, water, and <tawh>, with, written as one word: with water, using water) (j:tui/tawh) (r:zd:24276/zd:21417) (q:draft, with a capital Tuitawh is also the name of a Zomi village, written after personal names)
tuition = (i:1) (t:n) (f:education) (w:tuition/private lessons/extra classes) (d:paid lessons outside school hours; {tuition kah} is attend such lessons and {tuition man} is the fee for them) (o:English) (r:zd:23797/zd:20572) (q:draft)
Tuivial = (i:1) (t:name) (c:khua) (f:travel) (w:Tuivial) (d:village of the Thangkai circle in the Tedim area of Chin State, Myanmar; also written after the name of a person who comes from it) (r:zd:24049/zd:18896) (q:draft, low confidence)
Tuizang = (i:1) (t:name) (c:khua) (f:social) (w:Tuizang) (d:a village of the Tedim area, often written in brackets after a person's name as the home village) (r:zd:25734/zd:23278) (q:draft)
tuizawn = (i:1) (t:n) (f:home/work) (w:water pipe/hose/water main) (d:<tui>, water, with <zawn>, here pipe: a pipe or hose that carries water; {ekzawn} is a sewage pipe) (r:zd:17834/zd:23767) (q:draft)
tuk = (i:1) (t:v) (f:everyday) (w:fall/fall down/stumble) (d:fall down or stumble. Of a thing, fall on something) (s:puk/kia) (a:tho/dingto) (r:19.37.24) (q:draft)
tukal = (i:1) (t:adv) (f:time) (w:this week) (d:<tu>, this, with <kal>, week; {tukal sung} is during this week) (r:zd:22883/zd:25115/zd:25211) (q:draft)
tukalsung = (i:1) (t:adv) (f:time) (w:this week/within this week) (d:<tu>, this, <kal>, week, and <sung>, during, written as one word: during the present week) (j:tu/kal/sung) (r:zd:17432/zd:10871) (q:draft)
tukhasung = (i:1) (t:adv) (f:time) (w:this month/within this month) (d:<tu>, this, <kha>, month, and <sung>, during, written as one word: within this month) (j:tu/kha/sung) (r:zd:14954/zd:15485) (q:draft)
tukpeng = (i:1) (t:n) (f:media) (w:football/soccer) (d:the game of football and the ball it is played with, also called <bawlung>; {tukpeng kidemna} is a football tournament) (r:zd:23427/zd:10892/zd:11714) (q:draft)
tuktum = (i:1) (t:n) (f:body) (w:hair bun/topknot/chignon) (d:hair tied up in a knot at the back of the head; a proverb says that even the knot of hair at one's own nape can become an enemy) (r:zd:15697/zd:21745) (q:draft)
tukumsung = (i:1) (t:adv) (f:time) (w:this year/during this year) (d:<tukum>, this year, and <sung>, during, written as one word: in the course of this year) (j:tukum/sung) (r:zd:20173/zd:19558/zd:19567) (q:draft)
tulaai = (i:1) (t:det) (f:time/media) (j:tulai) (r:zd:19659) (q:draft)
tulaitak = (i:1) (t:adv) (f:time) (w:now/at present/currently) (d:<tu>, this, and <laitak>, at the very time, written as one word: at this very time) (s:tu-in) (j:tu/laitak) (r:zd:16337/zd:19860) (q:draft)
tulaitakin = (i:1) (t:adv) (f:time) (w:at present/right now/currently) (d:<tulai>, the present, with <takin>, at the very time, written as one word: at this very time, now) (j:tulai/takin) (r:zd:23148/zd:13020/zd:20963) (q:draft)
tulam = (i:1) (t:adv) (f:time) (w:nowadays/these days/at present) (d:<tu>, present, with <lam>, side: the present time, set against <nidang> or {a beisa}, formerly; nearly always as {tulam ciangin}, nowadays) (r:zd:19151/zd:14859/zd:20526) (q:draft)
tulamlam = (i:1) (t:adv) (f:time) (w:nowadays/these days/lately) (d:in recent times, as things now stand; mostly as {tulamlam ciangin}, nowadays, setting the present against how things were before) (r:zd:17897/zd:15531) (q:draft)
tulian = (i:1) (t:adv) (f:time) (w:right now/at present/currently) (d:found with <laitak>: {tulian laitak} is at this very time, at present) (r:zd:21358/zd:16055/zd:15305) (q:draft)
Tulsa = (i:1) (t:name) (c:city) (f:travel) (w:Tulsa) (d:city in the state of Oklahoma, USA, where many Zomi live) (r:zd:17122/zd:24453/zd:10745) (q:draft)
tultampi = (i:1) (t:num) (f:everyday) (w:thousands/many thousands) (d:<tul>, thousand, and <tampi>, many, written as one word after a noun: thousands of) (j:tul/tampi) (r:zd:12950/zd:17107/zd:14664) (q:draft)
tultampitak = (i:1) (t:num) (f:everyday) (w:many thousands/thousands of) (d:<tul>, thousand, and <tampitak>, very many, written as one word after the thing counted) (j:tul/tampitak) (r:zd:18911/zd:17707/zd:16698) (q:draft)
tum = (i:1) (t:v) (f:everyday/social) (w:play/blow/sound) (d:play a musical instrument or sound a trumpet; the instrument stands before the verb, as {peengkul tum}, blow the trumpet) (s:mut) of instruments
tuma kum = (i:1) (t:adv) (f:time) (w:years ago) (d:<tuma>, before now, and <kum>, year: years ago; a number follows, and then usually <lai> or {lai in}, as {tuma kum 10 lai in}, ten years ago) (r:zd:21925/zd:15459/zd:2072) (q:draft)
tumding = (i:1) (t:v) (f:politics/work) (w:to join/to enlist) (d:<tum> in the sense of enter, go into, with <ding>, written as one word: in order to join; {galkap tumding} is to enlist as a soldier) (j:tum/ding) (r:zd:11906/zd:12103) (q:draft)
tumding = (i:2) (t:v) (f:media) (w:to play) (d:<tum>, play an instrument, with <ding>, written as one word: in order to play it) (j:tum/ding) (r:zd:16442) (q:draft, low confidence)
tumding = (i:3) (t:v) (f:travel/nature) (w:will sink/be about to sink) (d:<tum> in the sense of go down, sink, with <ding>, written as one word; said here of a ship going down in the water) (j:tum/ding) (r:zd:18920) (q:draft, low confidence)
tumging = (i:1) (t:n) (f:media/social) (w:musical instrument/music) (d:<tum>, play, with <ging>, sound: an instrument that is played, and the music made with instruments as distinct from singing) (s:tumtheih) (r:zd:19756/zd:21286/zd:26310) (q:draft)
tumnih = (i:1) (t:n) (f:everyday) (w:two pieces/two parts) (d:<tum>, here a piece, with <nih>, two: two pieces; {tumnih kisuah} is break in two) (r:zd:15372/zd:18005) (q:draft)
tungaa = (i:1) (t:prep) (f:everyday) (j:tunga) (r:zd:20778/zd:23005) (q:draft)
tungah kinga = (i:1) (t:v) (f:everyday) (w:depend on/rest on/be based on) (d:<tungah>, on, and <kinga>, rest on: placed after a noun, depend on it, be founded on it or rely on it) (r:zd:24064/zd:25891/zd:23394) (q:draft)
tungah lungdam = (i:1) (t:v) (f:everyday/social) (w:be grateful to/thank) (d:<tungah>, on or toward, and <lungdam>, glad: be thankful to someone; the person thanked stands before the pair, and <ko>, declare, often follows, as {tungah lungdam ko}, give thanks to) (r:zd:16150/zd:21551/zd:20264) (q:draft)
tungahzong = (i:1) (t:adv) (f:everyday) (w:also on/on it too) (d:<tungah>, on, and <zong>, also, written as one word, placed after the noun) (j:tungah/zong) (r:zd:14566/zd:12148/zd:17450) (q:draft)
tungding = (i:1) (t:v) (f:everyday/time) (w:will arrive/will come) (d:<tung> and <ding> written as one word: will arrive, is to come; {hong tungding} is that which is coming) (j:tung/ding) (r:zd:22474/zd:12186/zd:19117) (q:draft)
tungkawikawi = (i:1) (t:v) (f:nature/travel) (w:reach many places/strike all over) (d:<tung>, arrive, and <kawikawi>, here and there, written as one word: arrive in many places, said above all of floods that strike in one place after another) (j:tung/kawikawi) (r:zd:15986/zd:17628/zd:11915) (q:draft)
tungkhat = (i:1) (t:phrase) (f:everyday/travel) (w:on a/on one) (d:<tung>, on, and <khat>, one, written as one word after a noun and before <ah>: on a certain one of the thing named, as {meileng tungkhat ah}, on a train) (j:tung/khat) (r:zd:16323/zd:16088/zd:12967) (q:draft)
tungkhinta = (i:1) (t:v) (f:travel) (w:have arrived/have already reached) (d:<tung>, arrive, and <khinta>, finished, written as one word: has now arrived) (j:tung/khinta) (r:zd:12717/zd:14869/zd:19662) (q:draft)
tungleh = (i:1) (t:phrase) (f:everyday) (w:on and/to and) (d:<tung>, on or towards, with <leh>, and, written as one word: links two places or persons, as in {Pasian tungleh midang tung ah}, towards God and towards others) (j:tung/leh) (r:zd:15272/zd:19800) (q:draft)
tungleh = (i:2) (t:phrase) (f:time/everyday) (w:when it comes/if it arrives) (d:<tung>, arrive, with <leh>, if or when, written as one word: {hun tungleh} is when the time comes) (j:tung/leh) (r:zd:12287/zd:12215) (q:draft)
tunglo = (i:1) (t:v) (f:everyday/travel) (w:not reach/not arrive) (d:<tung>, arrive, and <lo>, not, written as one word: does not reach or get to a place or a level) (j:tung/lo) (r:zd:16245/zd:12337/zd:23932) (q:draft)
Tungshin = (i:1) (t:name) (c:place) (f:health) (w:Tung Shin) (d:Tung Shin Hospital, a hospital in Kuala Lumpur, Malaysia, named in lists of Zomi patients) (r:zd:19657) (q:draft)
tungtaangin = (i:1) (t:prep) (f:everyday) (j:tungtangin) (r:zd:20176/zd:21843) (q:draft)
tungtawna = (i:1) (t:prep) (f:everyday) (w:through/by means of/as a result of) (d:<tungtawn> with the ending {-a}, placed after a noun or a possessor: through, by means of, arising from) (s:tungtawn/tungtawnin) (b:tungtawn) (r:zd:9231/zd:9224/zd:22603) (q:draft)
tungthei = (i:1) (t:v) (f:travel/everyday) (w:can arrive/be able to reach/can come upon) (d:<tung>, arrive, and <thei>, able, written as one word: be able to get to a place, and of an illness be able to come upon the body) (j:tung/thei) (r:zd:14935/zd:14873/zd:20399) (q:draft)
tuni = (i:1) (t:n) (f:time/everyday) (w:today) (d:this day, from <tu>, this, and <ni>, day; with the time marker <in> it means today, and {tuni dongin} is to this day)
tuni ciangciang = (i:1) (t:adv) (f:time) (w:until today/to this day/up to now) (d:<tuni>, today, and <ciangciang>, as far as: all the time up to the present day; stands at the head of the clause or before the verb, also followed by <ah>) (r:zd:25488/zd:24327) (q:draft)
tuniciang = (i:1) (t:adv) (f:time) (w:until today/to this day) (d:<tuni> and <ciang> written as one word: up to today, often followed by <dong>) (j:tuni/ciang) (r:zd:25433/zd:25712) (q:draft)
tunidong = (i:1) (t:adv) (f:time) (w:until today/to this day/still) (d:<tuni>, today, with <dong>, until, written as one word) (s:tudong) (j:tuni/dong) (r:zd:12002/zd:11400/zd:11335) (q:draft)
tunitan = (i:1) (t:adv) (f:time) (w:until today/to this day/so far) (d:<tuni>, today, and <tan>, as far as, written as one word: up to today) (j:tuni/tan) (r:zd:22606/zd:24934) (q:draft)
tunlawh = (i:1) (t:v) (f:health/everyday) (w:end up in/land in/be brought as a result) (d:<tun>, arrive, with <lawh>, get as a consequence: come to a place or state as the result of something; {zato tunlawh} is end up in hospital) (j:tun/lawh) (r:zd:15370/zd:17538/zd:24750) (q:draft)
Tunnel = (i:1) (t:n) (f:travel) (w:tunnel) (d:a road or railway passage under the ground or through a mountain; explained in Zolai as {leisung lampi}) (o:English) (r:zd:19338/zd:16851) (q:draft)
tunnu = (i:1) (t:n) (f:family) (w:mother) (d:poetic word for mother, used in songs, poems and titles; {tunnu Zogam} is the motherland Zogam) (r:zd:15874/zd:23974) (q:draft)
tuno = (i:1) (t:n) (c:animal) (f:nature/religion) (j:tuuno) (r:zd:20324/zd:16428) (q:draft)
tuntun = (i:1) (t:v) (f:travel/everyday) (w:arrive/reach) (d:<tun>, arrive, said twice: wherever one arrives; {a tuntun na} is every place one comes to, wherever they end up) (b:tun) (r:zd:23554/zd:18952/zd:20862) (q:draft)
tuntunna = (i:1) (t:n) (f:travel/everyday) (w:wherever one arrives/every place reached) (d:<tun>, arrive, said twice, with the noun suffix {-na}: each place that someone comes to; {i tuntunna ah} is wherever we come to) (b:tunna) (r:zd:17264/zd:20125/zd:19915) (q:draft)
Turkey = (i:1) (t:name) (c:land) (f:politics/travel) (w:Turkey) (d:the country of Turkey; {Turkey te} is the Turks) (r:zd:15163/zd:10719/zd:11213) (q:draft)
Turkish = (i:1) (t:name) (c:people) (f:politics/travel) (w:Turkish) (d:of Turkey, its people or its language, used as in English; {Turkish mi} is a Turk) (o:English) (r:zd:11246/zd:12128) (q:draft, low confidence)
tusung = (i:1) (t:adv) (f:time) (w:these days/at present/lately) (d:<tu> and <sung> written as one word: in the present time, during these days; {tusung teng} is all this while) (j:tu/sung) (r:zd:11206/zd:12564/zd:15507) (q:draft)
tusungteng = (i:1) (t:adv) (f:time) (w:these days/lately/at present) (d:<tu>, this or present, with <sungteng>, throughout, written as one word: all through the present time, these days) (j:tu/sungteng) (r:zd:11970/zd:15820/zd:17241) (q:draft)
tutak = (i:3) (t:adj) (f:everyday/time) (w:now)
tutan = (i:1) (t:adv) (f:time) (w:until now/up to now/to this day) (d:<tu>, now, and <tan>, as far as, written as one word: up to the present; also {tutan vei} with the same meaning) (s:tudong) (j:tu/tan) (r:zd:17212/zd:26658/zd:23084) (q:draft)
tutawm = (i:1) (t:adv) (f:time) (w:only now/just recently/all of a sudden) (d:only of late, of recent beginning; mostly denied, as {tutawm in thupiang hi lo}, it did not arise only just now) (r:zd:20850/zd:15853/zd:24646) (q:draft)
tutkhop = (i:1) (t:v) (f:everyday/social) (w:sit together/meet together) (d:<tut>, sit, and <khop>, together, written as one word: the form of <tutkhawm> used before words such as <ciangin>; also a sitting of an assembly) (j:tut/khop) (r:zd:25200/zd:20907/zd:21151) (q:draft)
tutkhopna = (i:1) (t:n) (f:social/family) (w:gathering/sitting together/get-together) (d:<tut>, sit, with <khopna>, being together: a time or place where people sit down together, as a family or a clan) (r:zd:21155/zd:21908/ts:7820) (q:draft)
tutmun = (i:1) (t:n) (f:home/social) (w:seat/place to sit/position) (d:<tut>, sit, with <mun>, place, written as one word: a seat, and so the position a person holds) (s:tutna) (j:tut/mun) (r:zd:16832/zd:20751) (q:draft, low confidence)
tutphah = (i:1) (t:n) (f:home) (w:chair/seat/stool) (d:something to sit on, a chair, seat or stool) (s:tutna/tutphat) (q:draft)
tutpihna = (i:1) (t:n) (f:social/religion) (w:condolence gathering/wake/memorial gathering) (d:<tutpih>, sit with, with the noun suffix <na>: a gathering in which people sit with a bereaved family to comfort them, also held by video call; {hehnep tutpihna} is a gathering of comfort) (b:tutpih) (r:zd:20305/zd:25178/zd:24029) (q:draft)
tuuk = (i:1) (t:n) (f:time/nature) (w:autumn/harvest season) (d:the season after the rains when the crops are gathered in; {tuuk anlak} is the autumn harvest and {tuuk kha} an autumn month) (r:zd:25393/zd:16340) (q:draft)
tuuk = (i:2) (t:v) (f:everyday) (w:fall/collapse) (d:fall down, give way and collapse) (r:zd:19441) (q:draft, low confidence)
tuukpeng = (i:1) (t:n) (f:media) (w:football/soccer/ball) (d:the game of football and the ball it is played with; {tuukpeng kidemna} is a football tournament and {tuukpeng sui} is play football) (s:bawlung) (r:zd:21984/zd:21340) (q:draft)
tuun = (i:1) (t:v) (f:everyday) (w:wrap/cover/pack) (d:wrap something up or cover it with cloth or paper; as a noun, a packet) (r:zd:11924) (q:draft, low confidence)
tuun = (i:2) (t:n) (f:family) (w:mother) (d:word for mother used in songs and poetry, paired with <zua>, father; {tuun sung khat pan piang} is born of one mother) (s:nu) (r:zd:20584) (q:draft, low confidence)
tuunnu = (i:1) (t:n) (f:family) (w:mother) (d:poetic word for mother, used in songs and poems, often beside {zuapa}, father) (s:nu) (r:zd:23974/zd:24086) (q:draft)
tuzing = (i:1) (t:adv) (f:time) (w:this morning) (d:<tu>, this, with the first part of <zingsang>, morning: this morning, also written {tuzing sang}; followed by <nai> and a number for the hour) (r:zd:25119/zd:25138/zd:25046) (q:draft)
