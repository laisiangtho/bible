lotphei = (i:1) (t:v) (f:everyday) (w:throw across/fling over/launch toward) (d:<lot>, throw or shoot, with a second part meaning across or over toward a place: throw a thing over to someone or fire a missile toward a place) (r:zd:15253/zd:16669) (q:draft)
lotsuk = (i:1) (t:v) (f:everyday/politics) (w:throw down/hurl down) (d:<lot>, throw, with <suk>, down: throw something down onto or into a place, in the news of petrol bombs) (j:lot/suk) (r:zd:17164) (q:draft)
Lottery = (i:1) (t:n) (f:social/everyday) (w:lottery) (d:a draw in which a prize of money, or a visa as in the American DV Lottery, goes to tickets or names picked by chance) (o:English) (r:zd:22076/zd:17504) (q:draft)
loudspeaker = (i:1) (t:n) (f:media/it) (w:loudspeaker) (d:device that makes the voice loud for a public announcement) (o:English) (r:zd:25937/zd:13151) (q:draft)
Louisiana = (i:1) (t:name) (c:land) (f:travel/politics) (w:Louisiana) (d:a state in the south of the United States) (r:zd:15054/zd:14975) (q:draft)
Louisville = (i:1) (t:name) (c:city) (f:travel) (w:Louisville) (d:city in Kentucky, United States, where a Zomi community lives) (r:zd:15805/zd:9217) (q:draft)
lovai = (i:1) (t:n) (f:work/home) (w:farm work/field affairs) (d:<lo>, farm or field, and <vai>, affair, written as one word; {innvai lovai} is the work of house and field) (j:lo/vai) (r:zd:17022/zd:26097) (q:draft)
lovegift = (i:1) (t:n) (f:religion) (w:love gift/gift of money/honorarium) (d:a gift of money given out of thanks to a preacher, singer or other servant of the church) (o:English, love gift) (r:zd:25572/zd:19451) (q:draft)
lozaw = (i:2) (t:adv) (f:everyday) (w:rather not/instead not) (d:<lo>, not, with <zaw> in its meaning rather or instead: the thing is rather not so, or is rather not done, with nothing being compared; {lungkim lozaw dinghi} is will rather be displeased) (r:zd:14887/zd:17143) (q:draft)
lozong = (i:1) (t:adv) (f:everyday) (w:also not/even without) (d:<lo>, not, and <zong>, also, written as one word after a verb: it may also be that something was not done) (j:lo/zong) (r:zd:14799) (q:draft, low confidence)
lua = (i:3) (t:adv) (f:everyday) (w:very/so much/greatly) (d:placed after a verb or adjective as a plain intensifier with no idea of excess, often followed by <mahmah> or <takpi>: very, so much, as {nuam lua}, want very much, and {nasia lua}, very fierce) (r:ts:4720/zd:25109/zd:24119) (q:draft)
luading = (i:1) (t:phrase) (f:everyday) (w:will be very/will surely) (d:<lua>, very much or too much, with <ding>, will, written as one word after a verb or describing word: it will be very much so) (j:lua/ding) (r:zd:19676/zd:25275) (q:draft, low confidence)
luahsuk = (i:1) (t:v) (f:family/social) (w:inherit/receive by descent) (d:<luah>, inherit, with <suk>, down: receive something handed down from parents or from those who came before) (b:luah) (j:luah/suk) (r:zd:25734/zd:21657/zd:25917) (q:draft)
luahto = (i:1) (t:v) (f:politics/family) (w:succeed to/take over/inherit) (d:<luah>, inherit, with <to>, up: step up into the office, throne or position that another held) (j:luah/to) (r:zd:11283/zd:21040) (q:draft)
luahuai = (i:1) (t:adj) (f:everyday/body) (w:nauseating/disgusting/sickening/loathsome) (d:<lua>, vomit, with <huai>: making one feel sick, from a great height or from disgust) (r:zd:16035/zd:25569) (q:draft, low confidence)
luahzo = (i:1) (t:v) (f:politics) (w:capture/occupy/take control of) (d:<luah>, occupy, and <zo>, manage to, written as one word: succeed in occupying a town or a position in war) (j:luah/zo) (r:ts:6741/ts:11032) (q:draft)
luai = (i:4) (t:n) (f:home/family) (w:cradle/hammock) (d:a hanging cradle in which a baby is rocked to sleep, as in {luai ah sial}, rock in the cradle; not the seat on which a grown person is carried) (s:nauluai) (r:zd:24119/zd:24086) (q:draft)
luailuai = (i:1) (t:adv) (f:everyday) (w:on and on/merely) (d:placed after a verb: keep on doing it and nothing more, just go along doing it without thought or aim) (r:zd:24411/zd:15894) (q:draft, low confidence)
luaisak = (i:1) (t:v) (f:everyday) (w:picture/bring to mind/call up) (d:make something appear in the mind, with <mitkha>: {mitkha ah luaisak} is picture it in the mind's eye) (r:zd:25768/ts:3160) (q:draft, low confidence)
luaisung = (i:1) (t:adv) (f:home/family) (w:in the cradle/inside the cradle) (d:<luai>, a baby's hanging cradle, and <sung>, inside, written as one word; followed by <ah>, in, or <panin>, out of) (j:luai/sung) (r:zd:20508) (q:draft)
luakei = (i:1) (t:adv) (f:everyday) (w:not too much/not very) (d:<lua> and <kei> written as one word after a verb: not too much; with <in>, do not do it too much) (j:lua/kei) (r:zd:19266/zd:16442) (q:draft, low confidence)
luakhiakik = (i:1) (t:v) (f:health/body) (w:vomit back up/throw up again) (d:<luakhia> and <kik> written as one word: bring back up what was eaten or drunk) (j:luakhia/kik) (r:zd:17605) (q:draft)
luakhollo = (i:1) (t:adv) (f:everyday) (w:not very/not all that/hardly) (d:<lua>, too much, and <khollo>, not much, written as one word after a describing word: not to any great degree) (j:lua/khollo) (r:zd:11587/zd:14856) (q:draft)
luakna = (i:1) (t:n) (f:health) (w:vomiting/emesis) (d:throwing up what is in the stomach, as a sign of illness) (b:luak) (r:zd:11020/zd:12541) (q:draft)
luaksuak = (i:1) (t:v) (f:health) (w:feel sick/be nauseous/vomit) (d:feel like vomiting, or vomit; named among the signs of illness, of pregnancy and of travel sickness) (r:zd:20433/zd:19593) (q:draft)
lualai = (i:1) (t:adv) (f:everyday) (w:still too/too much yet) (d:<lua>, too, with <lai>, still, written as one word, after a describing word: still too much so, as in {manlang lualai}, still too early) (r:zd:12279/zd:23266) (q:draft, low confidence)
lualo = (i:1) (t:adv) (f:everyday) (w:not very/not so much) (d:<lua>, very or too much, and <lo>, not, written as one word after a verb or describing word: not very, not much) (j:lua/lo) (r:zd:18927/zd:21180/zd:24276) (q:draft)
lualua = (i:2) (t:v) (f:health) (w:vomit repeatedly/keep vomiting) (d:<lua> in its sense vomit, doubled: vomit again and again, said of a sick baby; here {lualua} is itself the verb and follows no verb of speaking) (r:zd:19803/zd:16684) (q:draft)
luamahmah = (i:1) (t:adv) (f:everyday) (w:extremely/far too/very much) (d:<lua> and <mahmah> written as one word: placed after a describing word or verb, to a very great or excessive degree) (j:lua/mahmah) (r:zd:14648/zd:15890/zd:11837) (q:draft)
luang = (i:3) (t:n) (f:body) (w:body/corpse/dead body) (d:the body of a person, in the news mostly a dead one: {misi luang} is a corpse, and a number after it counts the dead; not the verb flow) (s:luanghawm/misiluang) (r:zd:9124/zd:15423/ts:6573) (q:draft)
luanga = (i:1) (t:v) (f:body/everyday) (w:flow/stream down) (d:<luang>, flow, with the linking <a>, and, written as one word; {khitui luanga} is with tears flowing, shedding tears and) (j:luang/a) (r:zd:25668/zd:21273) (q:draft)
luanggawp = (i:1) (t:v) (f:health/nature) (w:flow heavily/pour out/bleed heavily) (d:<luang>, flow, with <gawp>, severely, written as one word: of blood or water, flow in great quantity; {si luanggawp} is bleed heavily) (j:luang/gawp) (r:zd:13330/zd:12717) (q:draft)
luanghawmpen = (i:1) (t:phrase) (f:health/media) (w:the body/the corpse) (d:<luanghawm>, dead body, with the topic marker <pen>, written as one word: as for the body) (j:luanghawm/pen) (r:zd:17154) (q:draft)
luangkhaam = (i:1) (t:n) (f:work/health) (w:life insurance) (d:used by one writer as a Zolai word for life insurance, written beside the English term; elsewhere another spelling of <luangkham>, at the risk of life) (s:insurance) (r:zd:16788) (q:draft, low confidence)
luangkham = (i:2) (t:v) (f:everyday/social) (w:risk one's life/stake one's life) (d:used as a verb, put one's own life in danger for someone or something, as in {luangkham ngam}, dare to risk one's life; the other sense is the adverb use with <in>) (r:zd:8375/zd:25414/zd:15528) (q:draft)
luangkhamliang = (i:1) (t:adv) (f:everyday) (w:even at the risk of life) (d:<luangkham>, at the risk of life, with <liang>, even: to the point of risking one's life, usually with <in>) (j:luangkham/liang) (r:zd:16344/zd:26495) (q:draft, low confidence)
luangkhat = (i:1) (t:phrase) (f:everyday) (w:one body/one carcass) (d:<luang>, here body, used in counting dead bodies and whole slaughtered animals, and <khat>, one, written as one word: {misi luangkhat} is one dead body and {vok luangkhat} one whole pig, not the verb flow) (j:luang/khat) (r:zd:23129/zd:12188) (q:draft)
luangkhawm = (i:1) (t:v) (f:everyday/social) (w:flow together/go together/merge) (d:<luang> and <khawm> written as one word: flow together in one stream, and so of matters or people, go together and be at one) (j:luang/khawm) (r:zd:22557/zd:23022) (q:draft)
luangkheng = (i:1) (t:v) (f:politics/everyday) (w:overstep/exceed/go beyond) (d:<luang>, flow, with <kheng>, go beyond: go over a limit, as in {thuneihna luangkheng}, overstep authority) (j:luang/kheng) (r:zd:24714) (q:draft, low confidence)
luangkhiagawp = (i:1) (t:v) (f:body/health) (w:pour out heavily/gush out) (d:<luangkhia> and <gawp> written as one word, said of blood: flow out in great quantity) (j:luangkhia/gawp) (r:zd:16101/zd:15385) (q:draft)
luanglet = (i:1) (t:v) (f:everyday/politics) (w:overflow/go to excess/be extreme) (d:<luang>, flow, with <let.1>, overflow: run over; in the articles used of people or views that go beyond the proper measure, as {a luanglet te}, the extremists) (r:zd:25312/zd:22369/zd:22592) (q:draft, low confidence)
luangliang = (i:1) (t:v) (f:body/everyday) (w:flowing/streaming) (d:<luang>, flow, and <liang>, even, written as one word: to the point that tears or blood flow, as in {khitui luangliang}, with tears streaming) (j:luang/liang) (r:zd:16340/zd:13266) (q:draft)
luangnih = (i:1) (t:phrase) (f:everyday) (w:two bodies/two carcasses) (d:<luang>, here body, and <nih>, two, written as one word: two bodies, counted of dead people or animals) (j:luang/nih) (r:zd:13133/zd:22142) (q:draft)
luangphamna = (i:1) (t:n) (f:social/work) (w:death benefit) (d:money that a community association or its insurance fund pays to the family when a member dies) (r:zd:25265/zd:25789) (q:draft, low confidence)
luangthei = (i:1) (t:v) (f:everyday) (w:can flow/be apt to flow) (d:<luang>, flow, and <thei>, able, written as one word, said here of tears) (j:luang/thei) (r:zd:16321/zd:19526) (q:draft)
luanhun = (i:1) (t:n) (f:nature/time) (w:rainy season) (d:<luan> and <hun> written as one word: the time when something flows; {guahtui luanhun} is the season of the rains, the monsoon) (j:luan/hun) (r:zd:20155/zd:13039) (q:draft)
luankhi = (i:1) (t:n) (f:body) (w:tears/tear) (d:tears, a word of songs and poetic writing; {luankhi nul} is wipe away tears) (s:khitui) (r:zd:22095/zd:15874/zd:12033) (q:draft)
luankhiat = (i:1) (t:v) (f:nature/everyday) (w:flow out/run out) (d:form of <luangkhia>, flow out, used before <loh>, <ciangin> and the noun suffix <na>) (b:luangkhia) (j:luan/khiat) (r:zd:9445/zd:21097) (q:draft)
luansak = (i:1) (t:v) (f:body/religion) (w:shed/make flow) (d:<luan>, form of <luang>, flow, with the causative <sak>: make blood or tears flow, shed) (b:luang) (r:zd:25473/zd:21432) (q:draft)
luanzia = (i:1) (t:n) (f:social/nature) (w:course/flow/trend) (d:<luan>, flow, with <zia>, manner: the way something flows or runs its course; <khuahun luanzia> is the trend of the times) (s:paizia) (r:zd:24765/zd:25863) (q:draft)
luanziate = (i:1) (t:n) (f:social/nature) (w:trends/courses/currents) (d:<luanzia>, course or trend, with the plural <te>: the ways things are going; often {khuahun luanziate}, the trends of the times) (b:luanzia) (r:zd:21252/zd:23084) (q:draft)
luapi = (i:1) (t:adv) (f:everyday) (w:very greatly/extremely) (d:<lua>, very, with the augmentative <pi>, placed after a describing word; in the sentences seen it stands with a negative, as in {huaisia luapi ngahlo}, not all that serious) (j:lua/pi) (r:zd:14689/zd:17917) (q:draft)
luatding = (i:1) (t:phrase) (f:everyday) (w:to be too much/overly) (d:<luat>, too much, and <ding> written as one word after a verb or describing word: to do or be so too much; mostly denied, as {lungmuan luatding hilo}, one should not be too sure) (j:luat/ding) (r:zd:14709/zd:16164) (q:draft)
luatkhia = (i:1) (t:v) (f:social) (w:loot/carry off/take away) (d:take goods away from a place, said of robbers who empty a shop or tray; apparently the same word as <luakkhia>, take out) (r:zd:11352/zd:14981) (q:draft, low confidence)
luatleh = (i:1) (t:conj) (f:everyday) (w:if too much/when too much) (d:<luat>, too much, and <leh>, if, written as one word after a verb or describing word: if it is too much so) (j:luat/leh) (r:zd:22758) (q:draft)
luatloh = (i:1) (t:adv) (f:everyday) (w:not much/not too much) (d:<luat> and <loh> written as one word after a verb: not doing it much, not so very) (j:luat/loh) (r:zd:21085/zd:22780) (q:draft)
luatluat = (i:1) (t:adv) (f:everyday) (w:excessively/overmuch/lavishly) (d:<luat> said twice, after a verb: doing it far too much or again and again) (b:lua) (r:zd:21079) (q:draft, low confidence)
luatman = (i:1) (t:conj) (f:everyday) (w:because of too much) (d:<luat> too much and <man>, because, written as one word after a verb or describing word: because one does or is so too much) (j:luat/man) (r:zd:12341/zd:15600) (q:draft)
luatuanlo = (i:1) (t:adv) (f:everyday) (w:not very/not particularly/not so much) (d:<lua>, very, and <tuanlo> written as one word after a verb or describing word: not much so, not really) (j:lua/tuanlo) (r:zd:15187/zd:12280) (q:draft)
luazen = (i:1) (t:adv) (f:everyday) (w:very much indeed/truly) (d:<lua> and <zen> written as one word after a verb, giving it strong emphasis: so very much, truly so) (j:lua/zen) (r:zd:21780/zd:21929) (q:draft, low confidence)
lubawk = (i:1) (t:n) (f:social/politics) (w:head/top leader/chief) (d:the one at the very head, the topmost leader or the top position; {makai lubawk} is the top leader) (r:zd:25026/zd:20823) (q:draft)
lubawk = (i:2) (t:adj) (f:family) (d:in {tagah lubawk}: said of an orphan who lost a parent in infancy or before birth) (r:zd:14930/zd:20808) (q:draft, low confidence)
Lucifer = (i:1) (t:name) (f:religion) (w:Lucifer) (d:name given to the chief angel who rose against God and became <Satan>) (o:English) (r:zd:20906/zd:16012) (q:draft)
ludam = (i:1) (t:adj) (f:health) (w:healthy/well) (d:second word of the pair {cidam ludam}, in good health in every way; used in greetings, prayers and blessings) (s:cidam) (r:zd:21141/zd:21421) (q:draft)
ludamna = (i:1) (t:n) (f:health/social) (w:health/well-being) (d:noun of <ludam>, second word of the pair {cidam ludamna}: good health in every way, used in greetings and blessings) (b:ludam) (r:zd:24713/zd:22803) (q:draft)
Luggage = (i:1) (t:n) (f:travel) (w:luggage/suitcase/bag) (o:English) (r:zd:21294/zd:12040) (q:draft)
luheek = (i:1) (t:n) (f:social) (w:conduct/behaviour/manners) (d:found only as the second word of the pair {gamtat luheek}, with <gamtat>, behave: the way a person acts and carries himself, behaviour and manners) (r:zd:22639/zd:17152) (q:draft)
luheekdan = (i:1) (t:n) (f:social) (w:behaviour/manners/way of conducting oneself) (d:<luheek>, conduct, and <dan>, way, written as one word: the way a person behaves and carries himself, often paired with <gamtat> or <omdan>) (j:luheek/dan) (r:zd:17152) (q:draft)
luheekna = (i:1) (t:n) (f:social) (w:conduct/behaviour/manners) (d:<luheek> with the noun suffix <na>, found as the second word of the pair {gamtat luheekna}: the way a person acts and carries himself) (b:luheek) (r:zd:24282/zd:17152) (q:draft)
luhek = (i:1) (t:n) (f:social) (w:conduct/behaviour/manners) (d:the way a person carries himself; found after <gamtat> in the pair <gamtat luhek>, conduct and behaviour, character) (r:zd:19900/zd:17896) (q:draft)
luhekna = (i:1) (t:n) (f:social) (w:conduct/behaviour/manners) (d:<luhek> with the noun ending {-na}; mostly in {gamtat luhekna}, conduct and behaviour) (b:luhek) (r:zd:13354/zd:12507) (q:draft)
luhekzia = (i:1) (t:n) (f:social) (w:bearing/manner/behaviour) (d:<luhek>, conduct, with <zia>, way: the way a person carries and conducts himself; often after <gamtat>) (b:luhek) (r:zd:21434/zd:13195) (q:draft)
luhkhia = (i:1) (t:v) (f:politics) (w:raid/storm/rob) (d:<luh>, break into, with <khia>, out: attack and take a camp or position, or break in and carry things off) (b:luh) (r:ts:6842/zd:25094) (q:draft)
lui = (i:2) (t:adj) (f:everyday) (w:old) (d:old, said of things, customs and times, the opposite of <thak>, new; {hun lui} is the days of old) (a:thak) (r:3.25.22) of objects which are just old
luiding = (i:1) (t:v) (f:social/politics) (w:will set out/will serve) (d:<lui> in the sense of set a dish before people, as in <kilui>, with <ding>, written as one word; {ankuang luiding} are those who will give a meal and {mekuang luiding} those who will stand in an election; not the noun stream or the adjective old) (j:lui/ding) (r:zd:24481/zd:12965) (q:draft, low confidence)
luidingte = (i:1) (t:n) (f:politics) (w:candidates) (d:<luiding> with the plural <te> written as one word: those who will contest; {meekuang luidingte} are the candidates in an election) (j:luiding/te) (r:zd:21219) (q:draft)
luidungteng = (i:1) (t:n) (f:nature/travel) (w:all along the river/whole length of the river) (d:<lui>, river, with <dungteng>, the whole length: the whole stretch along a river) (j:lui/dungteng) (r:zd:14914/zd:16421) (q:draft)
luigal = (i:1) (t:n) (f:nature/travel) (w:other side of the stream/across the river) (d:<lui>, stream, and <gal>, the far side, written as one word: the far bank, the land across the stream) (j:lui/gal) (r:zd:17992/zd:19814) (q:draft)
luigei = (i:1) (t:n) (f:nature) (w:riverside/stream bank/riverbank) (d:<lui>, stream, and <gei>, side, written as one word: the land beside a stream or river) (j:lui/gei) (r:zd:14301/zd:14563) (q:draft)
luikhia = (i:1) (t:v) (f:media/social) (w:bring out/bring up/present) (d:bring a matter, a piece of news or a plan out before others, with <khia>, out) (r:zd:11409/zd:21455/zd:16580) (q:draft, low confidence)
luilua = (i:1) (t:adj) (f:everyday) (w:very old/worn out/antiquated) (d:<lui>, old, and <lua>, very, written as one word: very old and worn, said of things such as walls, concrete and trains) (j:lui/lua) (r:zd:19719/zd:15296) (q:draft)
luiluata = (i:1) (t:adj) (f:everyday) (w:too old/worn out) (d:<lui>, old, and <luata>, too much, written as one word: of a thing, very old and worn) (j:lui/luata) (r:zd:17097/zd:17822/zd:17175) (q:draft)
luina = (i:1) (t:n) (f:food/social) (w:feast/shared meal) (d:mostly in {ankuang luina}, a meal that people sit down to together, a dinner given for guests) (r:zd:12862/zd:14579) (q:draft, low confidence)
luipa = (i:1) (t:n) (f:politics/social) (w:former/ex-) (d:<lui> and <pa> written as one word, placed after a title or relation: the man who formerly held it, as {PM luipa}, the former prime minister) (j:lui/pa) (r:zd:19805/zd:20078) (q:draft)
luipang = (i:1) (t:n) (f:nature) (w:riverbank/riverside/bank of a stream) (d:<lui>, stream, with <pang>, side: the land along the edge of a river or stream) (r:zd:12717/zd:20516) (q:draft)
luisung = (i:1) (t:n) (f:nature) (w:river/inside of a river) (d:<lui>, stream or river, with <sung>, inside, written as one word; {luisung ah} is in the river) (j:lui/sung) (r:zd:15389/zd:22609) (q:draft)
luita = (i:1) (t:n) (f:nature) (w:brook/small stream) (d:<lui>, stream, with <ta>, child: a small stream or a branch of a stream) (s:luineu) (b:lui) (r:zd:12564) (q:draft, low confidence)
luite = (i:2) (t:n) (f:everyday) (w:old ones/the old/former ones) (d:<lui>, old, with the plural <te>: the old things or customs, or the former holders of an office, the opposite of {a thakte}, the new ones; found after <a>, <ngeina> or <kumpi> and not the plural of the stream) (r:zd:25078/zd:23129/zd:10955) (q:draft)
lukhu = (i:2) (t:n) (f:home) (w:hat/cap) (r:zai:hat) (q:draft)
lukun = (i:1) (t:v) (f:body/social) (w:bow the head/bow down) (d:<lu>, head, and <kun>, bow, written as one word: bend the head down, in respect, shame or submission) (j:lu/kun) (r:zd:23616/zd:21655/zd:20446) (q:draft)
lum = (i:3) (t:adj) (f:everyday/nature) (w:warm) (d:warm; used with <khua>, the weather or how the body feels: {khua lum} is be warm, keep warm) (a:vot) (r:59.2.16) (q:draft, low confidence)
lum = (i:4) (t:v) (f:everyday) (w:dead/to death) (d:after a verb of killing, as {that lum}, the word <thatlum> written as two words, and {kikap lum}, be shot dead: the blow leaves the victim lying dead) (r:zd:20747) (q:draft, low confidence)
lumlai = (i:1) (t:v) (f:health) (w:still lie/be still in hospital) (d:<lum>, lie, with <lai>, still, written as one word: still lying, said of a patient who is still in hospital, as in {zato lumlai}) (b:lum) (r:zd:17538/zd:16490) (q:draft, low confidence)
lumleh = (i:1) (t:v) (f:everyday) (w:turn over/flip) (d:turn the other side up; {khuttung lumleh bangin} is like the turning over of a hand, said of something that changes quickly and completely) (r:zd:20295/zd:20042) (q:draft, low confidence)
lumletlian = (i:1) (t:v) (f:travel/media) (w:overturn completely/roll right over) (d:<lumlet>, overturn, with <lian> as a word of emphasis, said with <ki> of a vehicle that turns right over in an accident) (j:lumlet/lian) (r:zd:14689/zd:16063) (q:draft, low confidence)
lumletzo = (i:1) (t:v) (f:everyday/politics) (w:be able to overturn/manage to overturn) (d:<lumlet>, overturn, and <zo>, be able to, written as one word: be able to turn a thing upside down or to reverse a decision) (j:lumlet/zo) (r:zd:13013/zd:20477) (q:draft)
lumlua = (i:1) (t:adj) (f:nature) (w:too hot/very hot) (d:<lum>, warm or hot, and <lua>, too much, written as one word; mostly of the weather, {khua lumlua}) (j:lum/lua) (r:zd:23018/zd:11236) (q:draft)
lummahmah = (i:1) (t:adj) (f:nature/everyday) (w:very hot/very warm) (d:<lum>, warm, with <mahmah>, very, written as one word: very hot, said of the weather) (j:lum/mahmah) (r:zd:14822/zd:20518) (q:draft)
lumna = (i:2) (t:n) (f:nature/health) (w:temperature/heat) (d:the measured degree of heat of the weather or of the body, before a number or the word <degree>; {pumpi a lumna} is the body temperature, {khuahun lumna} the temperature of the weather) (r:zd:19875/zd:24276/zd:21557) (q:draft)
lumpah = (i:1) (t:v) (f:health/everyday) (w:lie down at once) (d:<lum>, lie down, and <pah>, at once, written as one word) (j:lum/pah) (r:zd:20841/zd:20946) (q:draft)
lumsak = (i:2) (t:v) (f:body/health) (w:warm/make warm/heat) (d:<lum>, warm, with the causative <sak>: make the body or the weather warm; the thing warmed, such as <pumpi>, the body, stands before it) (r:zd:20496/zd:11167/zd:19392) (q:draft)
lumsuak = (i:1) (t:v) (f:everyday/body) (w:lie where one fell/end up lying) (d:<lum>, lie down, with <suak>, right on, written as one word: fall or lie down in a place and stay lying there, asleep or unconscious) (j:lum/suak) (r:zd:15307) (q:draft, low confidence)
Lumut = (i:1) (t:name) (c:city) (f:travel) (w:Lumut) (d:a town on the coast of Perak in Malaysia, linked with Ipoh by the Ipoh to Lumut road) (r:zd:20915) (q:draft)
luna = (i:2) (t:n) (f:health) (w:headache) (d:pain in the head as one complaint named in a list beside others such as <khuh>, cough, and not the general pair {cina luna}, the sick) (r:zd:23529/zd:9440) (q:draft)
Lunch = (i:1) (t:n) (f:food/time) (w:lunch/midday meal) (d:the midday meal, mostly as an item in the programme of a meeting) (o:English) (r:zd:16038) (q:draft, low confidence)
lung = (i:2) (t:n) (f:nature/health) (w:worm/maggot) (d:a small worm or maggot that eats into something, not the heart; said of decaying teeth as {ha lung nek}, teeth eaten by worms) (r:zd:20814) (q:draft, low confidence)
lungam = (i:2) (t:v) (f:health/body) (w:faint/pass out/collapse) (d:lose consciousness or strength suddenly, from smoke, shock or illness, mostly as {lungam in tuksuk}, faint and fall down; of the body, not of shame) (r:zd:17123/zd:19917/zd:20433) (q:draft)
lungbuai = (i:1) (t:v) (f:everyday/health) (w:be confused/be perplexed/be troubled in mind) (d:<lung>, mind, with <buai>, be in turmoil: not know what to think or do, be worried and unsettled; also the state itself, confusion) (r:ts:3375/zd:12103/zd:22116) (q:draft)
lungdaihna = (i:1) (t:n) (f:everyday/social) (w:peace of mind/calm/peace) (d:<daihna>, quietness, said of the heart: a calm and untroubled mind, and among a people, peace) (r:zd:25004/zd:20125) (q:draft)
lungdam = (i:1) (t:adj) (f:everyday/social) (w:happy/glad/joyful) (d:glad or happy at heart, from <lung>, heart, and <dam>, well) (s:nuam)
lungdam = (i:4) (t:intj) (f:everyday/social) (w:thank you/thanks) (d:said to thank someone; the same word as {lungdam}, glad) (r:zai:thank) (q:draft)
lungdam ing = (i:1) (t:intj) (f:everyday/social) (w:thank you/I am thankful) (d:<lungdam>, be glad, and <ing>, the first person ending: I am glad, the usual way to say thank you; what is thanked for stands before it) (r:zd:17760) (q:draft)
lungdambawl = (i:1) (t:n) (f:religion/time) (w:Christmas) (d:<lungdam>, joy, with <bawl>, make: the feast of the birth of Jesus, Christmas; {Lungdambawl ni} is Christmas Day) (r:zd:25472/zd:16506/zd:26385) (q:draft)
Lungdambawlni = (i:1) (t:n) (f:religion/time) (w:Christmas Day/Christmas) (d:<lungdambawl>, Christmas, and <ni>, day, written as one word) (j:lungdambawl/ni) (r:zd:16956) (q:draft)
lungdamh = (i:1) (t:n) (f:everyday/social) (j:lungdam) (r:zd:18187/zd:24464) (q:draft)
lungdamhang = (i:1) (t:phrase) (f:social) (w:we are glad/we are thankful) (d:<lungdam>, glad, with <hang>, the sentence-final marker for we, written as one word) (j:lungdam/hang) (r:zd:17419) (q:draft)
lungdamko = (i:1) (t:v) (f:social/religion) (w:give thanks/thank) (d:<lungdam>, joy, with <koh>, express, written as one word: give thanks, express gratitude to someone, who is marked with <tungah>) (j:lungdam/koh) (r:zd:23019/zd:16253/zd:22496) (q:draft)
lungdamkoh = (i:1) (t:v) (f:everyday/social) (w:thank/give thanks) (d:express thanks to someone, from <lungdam>, glad, and <koh>, express) (q:draft)
lungdamlo = (i:1) (t:adj) (f:everyday/social) (w:unhappy/not glad/displeased) (d:<lungdam>, glad, and <lo>, not, written as one word) (j:lungdam/lo) (r:zd:21918/zd:19327) (q:draft)
lungdamlua = (i:1) (t:adj) (f:everyday/social) (w:overjoyed/very glad/very thankful) (d:<lungdam> glad and <lua> very much, written as one word: very happy; {lungdamlua ung} is we thank you very much) (j:lungdam/lua) (r:zd:20652/zd:15298/zd:20289) (q:draft)
lungdamna lian = (i:1) (t:phrase) (f:social) (w:be very grateful/great joy) (d:<lungdamna>, joy or thanks, and <lian>, great: a formula of thanks, the joy is great; the person thanked stands before it with <tungah>, and <mahmah> usually follows, as in {ka lungdamna lian mahmah hi}, I am very grateful) (r:zd:19435/zd:11159) (q:draft)
lungdamnathu = (i:1) (t:n) (f:religion) (w:gospel/good news) (d:<lungdamna> and <thu> written as one word: the good news of Christ, the gospel) (j:lungdamna/thu) (r:zd:25751/zd:22544/zd:25451) (q:draft)
lungdamsa = (i:1) (t:adv) (f:everyday/social) (w:gladly/joyfully) (d:<lungdam>, glad, and <sa> written as one word, mostly before <in>: being already glad, in a glad state while doing something) (j:lungdam/sa) (r:zd:20697/zd:21869) (q:draft)
lungdamtak = (i:1) (t:adv) (f:everyday/social) (w:gladly/happily/joyfully) (d:<lungdam>, glad, and <tak> written as one word, usually followed by <in>: in a glad way) (j:lungdam/tak) (r:zd:19841/zd:22282) (q:draft)
lungdamthu = (i:1) (t:n) (f:social/religion) (w:thanks/word of thanks/thanksgiving) (d:<lungdam>, glad or thankful, and <thu>, word, written as one word: words of thanks or of gladness said or sent to someone) (j:lungdam/thu) (r:zd:17685/zd:24253) (q:draft)
lungdeih = (i:1) (t:n) (f:everyday/social) (w:heart's desire/wish/will) (d:<lung>, heart, with <deih>, want: what the heart wishes for; frequent in songs and poetic language) (j:lung/deih) (r:zd:21948/zd:25020) (q:draft)
lungduaitak = (i:1) (t:adv) (f:everyday/social) (w:patiently) (d:<lungduai>, patient, and <tak> written as one word, mostly followed by <in>: patiently, calmly) (s:lungduaitakin) (j:lungduai/tak) (r:zd:20037/zd:20093/zd:18142) (q:draft)
lunggelna = (i:1) (t:n) (f:everyday/education) (w:thought/idea/imagination) (d:<lung>, mind, with <gelna>, plan: what the mind thinks out or pictures, a thought, idea or plan; {sunmang lunggelna} is a daydream) (j:lung/gelna) (r:zd:21837/zd:20479) (q:draft, low confidence)
lunggimlelh = (i:1) (t:n) (f:health) (w:stress) (d:<lunggim>, be weary in heart, with <lelh>, be overcome: being worn down by worry; {lunggimlelh-natna} is the writer's word for stress as an illness, found in one article) (r:zd:17152) (q:draft, low confidence)
lunggul = (i:1) (t:v) (f:everyday) (j:lunggulh) (r:zd:25711) (q:draft)
lunggulh = (i:2) (t:n) (f:everyday) (w:wish/desire/longing) (d:the thing a person longs for, {lunggulh} used as a noun after a possessor or with <nei>, in the same meaning as <lunggulhna>) (s:lunggulhna) (r:zd:19841/zd:23086) (q:draft)
lunggulhhuai = (i:1) (t:adj) (f:everyday/social) (w:desirable/to be wished for) (d:<lunggulh>, long for, with <huai>, worthy of: something one would very much like to see or have; {lunggulhhuai ka sa hi} is I find it desirable) (b:lunggulh) (r:zd:25678/zd:10726) (q:draft)
lunggulhnatawh = (i:1) (t:phrase) (f:everyday/social) (w:with the desire/with longing) (d:<lunggulhna>, desire, and <tawh>, with, written as one word after a clause in <nading> or <ding>: with the wish to do it) (j:lunggulhna/tawh) (r:zd:13338/zd:13178) (q:draft)
lunggulhpen = (i:1) (t:phrase) (f:everyday) (w:what one desires/the desire) (d:<lunggulh> and the topic marker <pen> written as one word: as for what a person longs for) (j:lunggulh/pen) (r:zd:11251) (q:draft, low confidence)
lunggulhte = (i:3) (t:n) (f:everyday/social) (w:desires/longings/wishes) (d:plural of <lunggulh> as a thing: what one longs for, as in {na lunggulhte}, your desires, and {lungput leh lunggulhte}, attitudes and desires; not the persons who desire or are desired) (r:zd:20838/zd:24230) (q:draft)
lunggulhtek = (i:1) (t:v) (f:everyday) (w:each long for/all desire) (d:<lunggulh>, long for, and <tek>, each, written as one word: every one of them longs for it) (j:lunggulh/tek) (r:zd:12715/zd:20167) (q:draft)
lunghi = (i:1) (t:v) (f:everyday) (d:first part of <lunghimawh>, worry or be anxious, when that word is written as two, {lunghi mawh}) (r:zd:22923/zd:23896) (q:draft)
lunghianglo = (i:1) (t:adj) (f:everyday) (w:unhesitating/untroubled/without worry) (d:<lunghiang> and <lo> written as one word: not wavering or troubled in heart; {lunghianglo takin} is without hesitation or worry) (j:lunghiang/lo) (r:zd:25256) (q:draft, low confidence)
lunghihmawhnate = (i:1) (t:n) (f:everyday/religion) (w:worries/anxieties/cares) (d:plural of <lunghihmawhna>, worry) (b:lunghihmawhna) (r:zd:9232/zd:21268) (q:draft)
lunghimawhhuai = (i:1) (t:adj) (f:everyday/health) (w:worrying/worrisome/alarming) (d:<lunghimawh>, worry, with <huai>, causing: giving cause for worry; of an injured person, in a critical condition) (b:lunghimawh) (r:zd:15103/zd:14939) (q:draft)
lunghimawhpih = (i:1) (t:v) (f:social/everyday) (w:be worried about/be concerned for/be anxious over) (d:<lunghimawh>, worry, with <pih>: worry about a person or a matter, feel concern on someone's behalf) (b:lunghimawh) (r:zd:15012/zd:14648) (q:draft)
lungkhamlua = (i:1) (t:v) (f:everyday/health) (w:be very worried/be too distressed/worry too much) (d:<lungkham>, be troubled, and <lua>, too much, written as one word) (j:lungkham/lua) (r:zd:21389/zd:22928) (q:draft)
lungkhauhna = (i:2) (t:n) (f:everyday/social) (w:determination/firmness/resolve/fortitude) (d:in a good sense, strength of mind that does not give up, named beside diligence and faithfulness and set against <lungkiatna>, discouragement) (r:zd:19139/zd:25687) (q:draft)
lungkialo = (i:1) (t:v) (f:everyday) (w:not lose heart/not be discouraged) (d:<lungkia> and <lo> written as one word: not discouraged; with <in>, without losing heart) (j:lungkia/lo) (r:zd:16442/zd:22116) (q:draft)
lungkianai = (i:1) (t:v) (f:everyday) (w:lose heart yet) (d:<lungkia>, lose heart, and <nai>, yet, written as one word; seen only with a negative, {lungkianai tuanlo}, still not discouraged) (j:lungkia/nai) (r:zd:11927) (q:draft, low confidence)
lungkiat = (i:2) (t:n) (f:health) (w:depression) (d:in {lungkiat natna}, the illness of depression: a lasting low state of mind treated as a sickness, not the passing loss of heart of the verb) (r:zd:20908/zd:12187) (q:draft)
lungkiathuai = (i:1) (t:adj) (f:everyday/social) (w:discouraging/disheartening) (d:<lungkiat>, lose heart, with the ending <huai>: causing one to lose heart) (b:lungkiat) (r:zd:16051/zd:11429) (q:draft)
lungkiatloh = (i:1) (t:v) (f:everyday/social) (w:not lose heart/not be discouraged) (d:<lungkiat>, the form of <lungkia>, lose heart, with the negative <loh>, written as one word and followed by <ding> or <nading>: not to lose heart) (j:lungkiat/loh) (r:zd:18204/zd:9453) (q:draft)
lungkiatna = (i:2) (t:n) (f:health) (w:depression) (d:the illness of lasting low mood; in health writing the word given for English depression, named beside <lunggimna> stress and <launa> fear, where the Bible sense is loss of courage) (r:zd:12436) (q:draft, low confidence)
lungkiattuak = (i:1) (t:v) (f:health/everyday) (w:be very discouraged/be downcast/be depressed) (d:<lungkiat>, lose heart, with <tuak> written as one word, mostly before <mahmah>: be in a clearly low and dejected state; what <tuak> adds here is not certain, it seems to strengthen the verb as in {thanemtuak}) (j:lungkiat/tuak) (r:zd:14684/zd:12468) (q:draft, low confidence)
lungkihual = (i:1) (t:v) (f:social) (w:be united/be of one heart/be in harmony) (d:<lung>, heart, with <kihual>, be knit together, written as one word: be united in heart and mind) (j:lung/kihual) (r:zd:11367/zd:24452) (q:draft)
lungkimloh = (i:1) (t:v) (f:social) (w:be dissatisfied/be displeased) (d:<lungkim> be satisfied and <loh> not written as one word: not be content; also the state itself, dissatisfaction, and {lungkimloh lahna} is a protest, a showing of dissatisfaction) (j:lungkim/loh) (r:zd:9434/zd:24579/zd:25924) (q:draft)
lungkimsakna = (i:1) (t:n) (f:social/religion) (w:pleasing/satisfying/appeasement) (d:<lungkimsak>, please or satisfy, with the noun ending {-na}: the pleasing or satisfying of someone; {lungkimsakna dingin} is in order to please) (b:lungkimsak) (r:ts:3375/zd:9433) (q:draft)
lungkimtak = (i:1) (t:adv) (f:everyday) (w:contentedly/gladly/willingly) (d:<lungkim>, be satisfied, with <tak>, usually followed by <in>: with satisfaction, gladly, to one's content) (j:lungkim/tak) (r:zd:15491/zd:16133/zd:24276) (q:draft)
lungkimtakin = (i:1) (t:adv) (f:everyday) (w:contentedly/gladly/willingly) (d:<lungkimtak> and <in> written as one word: with a satisfied heart, gladly) (j:lungkimtak/in) (r:zd:21121/zd:12214) (q:draft)
lunglau = (i:1) (t:v) (f:everyday) (w:be anxious/be worried/be alarmed) (d:<lung> and <lau> written as one word: be afraid at heart, worried or alarmed; {lunglau sak} is to alarm someone) (j:lung/lau) (r:zd:25397/zd:25165) (q:draft)
lungleeng = (i:1) (t:adj) (f:everyday/family) (j:lungleng) (r:zd:15996) (q:draft)
Lunglei = (i:1) (t:name) (c:city) (f:travel/politics) (w:Lunglei) (d:town and district in the south of Mizoram, India) (r:zd:18097/zd:17168) (q:draft)
lunglen = (i:1) (t:v) (f:everyday/social) (w:long for/feel nostalgic/be homesick/miss) (d:feel longing or sadness at heart for a person, place or time that is far away or gone; often paired as {lunglen khuangaih}, and {lunglen huai} is what stirs such longing) (r:zd:23069/zd:26626/zd:22585) (q:draft)
lungleng = (i:1) (t:adj) (f:everyday/family) (w:lonely/homesick/wistful) (d:feeling lonely or sad from missing a person, a place or a time; also as a verb, miss or long for) (r:zd:15459/zd:22808/ts:3369) (q:draft)
lunglenhuai = (i:1) (t:adj) (f:everyday/social) (w:nostalgic/wistful/moving) (d:<lunglen>, long for, with <huai>, causing: that makes one feel longing or sadness at heart) (b:lunglen) (r:zd:25908/zd:24943) (q:draft)
lunglenna = (i:1) (t:n) (f:everyday/social) (w:longing/loneliness/homesickness/melancholy) (d:a sad longing for a person or place that is far away or lost, often named together with <dahna>, grief) (r:zd:22755/zd:24276/zd:25863) (q:draft)
lunglut = (i:1) (t:v) (f:everyday/social) (w:be interested/take an interest) (d:<lung>, mind, with <lut>, enter: have the mind drawn to something; <lunglut huai> is interesting) (r:zd:15845/zd:11394/zd:12110) (q:draft)
lunglut huai = (i:1) (t:adj) (f:everyday/media) (w:interesting/fascinating) (d:<lunglut>, be interested, with the suffix <huai>, causing that feeling: interesting, worth one's attention; stands before a noun with <a> or ends a statement, often with <mahmah>) (r:zd:17437/zd:22695) (q:draft)
lungluthuai = (i:1) (t:adj) (f:everyday/media) (w:interesting) (d:<lunglut>, be interested, with <huai>, worthy of: that draws interest; {a lungluthuai khat} is an interesting thing) (b:lunglut) (j:lunglut/huai) (r:zd:15905/zd:25712) (q:draft)
lunglutna = (i:1) (t:n) (f:everyday/education) (w:interest/attention/enthusiasm) (d:<lung>, mind, with <lutna>, entering: what the mind goes into, interest in or attention to something) (r:zd:21168/zd:15264) (q:draft)
lungluttak = (i:1) (t:adv) (f:everyday/social) (w:with interest/attentively/keenly) (d:<lunglut>, be interested, and <tak> written as one word: with interest, with close attention) (j:lunglut/tak) (r:zd:12470/zd:21869) (q:draft)
lunglutte = (i:1) (t:n) (f:social) (w:those who are interested/interested people) (d:<lunglut>, be interested, with the plural <te>: the people who are interested, usually as {a lunglutte in} in an invitation or notice) (r:zd:19065/zd:23083) (q:draft)
lunglutzaw = (i:1) (t:v) (f:everyday/social) (w:be more interested/care more about) (d:<lunglut>, be interested, and <zaw>, more, written as one word: be more interested in something, or with <ki> be found more interesting) (j:lunglut/zaw) (r:zd:12304) (q:draft)
lunglutzawkzawk = (i:1) (t:phrase) (f:everyday) (d:<lunglut>, be interested, and <zawkzawk> written as one word: whichever one is more interested in) (j:lunglut/zawkzawk) (r:zd:14941) (q:draft, low confidence)
lungluut = (i:1) (t:v) (f:everyday/social) (j:lunglut) (r:zd:19166/zd:17860) (q:draft)
lungmanna = (i:1) (t:n) (f:everyday) (w:perplexity/anxiety/bewilderment) (d:the state of being troubled or at a loss in the heart; the noun in {-na} of <lungmang>, named beside <lungbuai>, confusion) (b:lungmang) (r:zd:23873/zd:25678) (q:draft)
lungmawl = (i:1) (t:adj) (f:everyday/social) (w:simple-minded/ignorant/foolish) (d:<lung>, mind, with <mawl>, dull: slow of understanding, simple or ignorant) (r:zd:21097) (q:draft, low confidence)
lungme = (i:1) (t:n) (c:animal) (f:home/nature) (w:bug/bedbug) (d:a small ugly bug that was found in great numbers in village houses and made people itch at night, probably the bedbug; the article calls it a kind of <lunggam> and says the young no longer know the word; also in the old saying {lungme thahlah}) (r:zd:22922) (q:draft, low confidence)
lungmee = (i:1) (t:n) (c:animal) (f:nature/home) (w:caterpillar/grub) (d:a hairy grub or caterpillar that lives in stored maize stalks, comes out at night and gets into the bedding; named with lice and bedbugs as a pest of an unclean house) (r:zd:22922) (q:draft, low confidence)
lungmuangtak = (i:1) (t:adv) (f:everyday) (w:safely/calmly/at ease) (d:<lungmuang> and <tak> written as one word, followed by <in>: without fear or worry, in safety) (j:lungmuang/tak) (r:zd:11827/zd:11133) (q:draft)
lungmuangtakin = (i:1) (t:adv) (f:everyday) (w:safely/with peace of mind/at ease) (d:<lungmuangtak> and <in> written as one word: without fear or worry) (j:lungmuangtak/in) (r:zd:13291/zd:24431) (q:draft)
lungneu = (i:1) (t:v) (f:everyday/social) (w:be discouraged/lose heart/be downhearted/feel hurt) (d:<lung> heart with <neu> small: feel small and low in spirit, be easily hurt or discouraged; {lungneu sak} is make someone feel so) (r:zd:26626/zd:19898/zd:21305) (q:draft)
lungneuna = (i:1) (t:n) (f:everyday/health) (w:dejection/low spirits/hurt feelings/melancholy) (d:the state of feeling small and hurt in the heart, downcast or aggrieved; named beside <hehna>, anger, and <lunggimna>, weariness of mind) (r:zd:20801/zd:20778/zd:16376) (q:draft)
lungneusak = (i:1) (t:v) (f:social/everyday) (w:discourage/make feel small/belittle) (d:<lungneu>, lose heart, and <sak> written as one word: make someone feel small; with <ki> before it, belittle oneself, feel inferior) (j:lungneu/sak) (r:zd:23487/zd:22715) (q:draft)
lungngulh = (i:1) (t:v) (f:everyday) (j:lunggulh) (r:zd:20892/zd:23803) (q:draft)
lungngulhna = (i:1) (t:n) (f:everyday) (j:lunggulhna) (r:zd:21869/zd:21898/zd:9428) (q:draft)
lungno = (i:2) (t:n) (f:health) (w:germ/virus/microbe) (d:a living thing too small to see that causes illness, a germ or virus, also alone as a short form of <natna lungno>; the Bible sense is a worm that can be seen) (s:natna lungno) (r:zd:23745/zd:12267) (q:draft)
lungnophuai = (i:1) (t:adj) (f:everyday) (w:pleasant/delightful/amusing) (d:<lungnop>, be glad, with the suffix <huai>: causing gladness, pleasant to see) (b:lungnop) (r:zd:24030/zd:23198) (q:draft)
lungnoplohna = (i:1) (t:n) (f:everyday/social) (w:displeasure/unhappiness/dissatisfaction/bad mood) (d:<lungnop>, be glad, with <lohna>, the state of not: the feeling of not being pleased or at ease) (a:lungnopna) (j:lungnop/lohna) (r:zd:19360/zd:21989) (q:draft)
lungnote = (i:1) (t:n) (f:health/nature) (w:germs/microbes/worms) (d:<lungno> with the plural <te>: small living things such as worms and insects, and in writing about health the germs that cause disease, {natna lungnote}) (b:lungno) (r:zd:19330/zd:22803/zd:21239) (q:draft)
lungnoza = (i:1) (t:n) (f:health) (w:disinfectant/antibiotic/germicide) (d:a substance that kills germs or pests, <lungno>, sprayed on things or taken as medicine; {lungnoza kap} is spray disinfectant) (r:zd:16949) (q:draft)
lungnuamlo = (i:1) (t:adj) (f:everyday/social) (w:unhappy/displeased/not at ease) (d:<lungnuam>, be glad, and <lo>, not, written as one word: not happy or not at ease about something) (j:lungnuam/lo) (r:zd:26097/zd:25479) (q:draft)
lungnuamtak = (i:1) (t:adv) (f:everyday) (w:peacefully/happily/at ease) (d:<lungnuam>, be at ease, with <tak>, written as one word and mostly before <in>: with a glad and easy mind) (j:lungnuam/tak) (r:zd:25932/zd:20588) (q:draft)
lungpho = (i:1) (t:v) (f:politics) (w:protest/demonstrate) (d:show opposition in public, as a crowd in the streets; the noun is <lungphona>, a protest) (r:zd:15602/zd:15080/zd:23013) (q:draft)
lungphona = (i:1) (t:n) (f:politics) (w:protest/demonstration) (d:a public show of anger or disagreement by a crowd; <lungphona nei> is to hold a protest) (b:lungpho) (r:zd:23437/zd:20673/zd:24579) (q:draft)
lungphona kinei = (i:1) (t:v) (f:politics) (w:a protest is held/demonstrate) (d:<lungphona>, protest, and <kinei>, here the passive of <nei>, have or hold: a protest is held, people demonstrate; the place or the cause with <hangin> stands before it, and it often ends a headline) (r:zd:17549/zd:22981) (q:draft)
lungphona nei = (i:1) (t:v) (f:politics) (w:protest/demonstrate/hold a protest) (d:<lungphona>, protest, and <nei>, have: hold a protest or demonstration; the place stands before it with <ah>, the protesters with <in>, and <uh> <hi> may follow) (r:zd:25015/zd:25584) (q:draft)
lungphonate = (i:1) (t:n) (f:politics) (w:protests/demonstrations) (d:<lungphona> with the plural <te>) (b:lungphona) (r:zd:23667/zd:25022) (q:draft)
lungphote = (i:1) (t:n) (f:politics) (w:protesters/demonstrators) (d:<lungpho>, protest, with the plural {-te}: those who protest) (b:lungpho) (r:zd:23451) (q:draft)
lungput = (i:1) (t:n) (f:social/everyday) (w:attitude/mindset/outlook) (d:the way a person or group thinks and is disposed towards something; {tualniam lungput} is a parochial mindset) (r:ts:9859/zd:24230) (q:draft)
lungsim cidam = (i:1) (t:n) (f:health) (w:mental health/sound mind/healthy mind) (d:<lungsim>, mind, and <cidam>, healthy: a healthy mind, mental health, often set beside {pumpi cidam}, a healthy body; also said of a person who is sound in mind) (r:zd:24244/zd:17976) (q:draft)
lungsim cidamna = (i:1) (t:n) (f:health) (w:mental health/mental well-being) (d:<lungsim>, mind, and <cidamna>, health: mental health, named beside {pumpi cidamna}, bodily health, and {kha cidamna}, spiritual health) (r:zd:25170/zd:17613/zd:23989) (q:draft)
lungsim ngaihsutna = (i:1) (t:n) (f:everyday/social) (w:thinking/mind/thoughts/mindset) (d:<lungsim>, mind or heart, and <ngaihsutna>, thought, two words of near meaning said together as one: the thinking of a person, the mind and its thoughts; with a possessive before it, as {a lungsim ngaihsutna}, his way of thinking) (r:zd:24056/zd:9428/zd:24276) (q:draft)
lungsim puak = (i:1) (t:n) (f:everyday/social) (w:attitude/mindset/disposition) (d:<lungsim>, mind, and <puak>, here the carrying or bearing of it: the way a person carries the mind, an attitude or mindset; stands after a possessor and often before <zia>, manner, as in {lungsim puak zia}) (r:zd:14525/zd:17488) (q:draft)
lungsim pumpi = (i:1) (t:n) (f:health/body) (w:mind and body) (d:<lungsim>, mind, and <pumpi>, body, joined without <leh>: mind and body together, the whole person, in talk of health, tiredness and rest) (r:zd:25178/zd:25175/zd:22779) (q:draft)
lungsim siangtho = (i:1) (t:n) (f:social/religion) (w:pure heart/clean heart/sincerity) (d:<lungsim>, heart or mind, and <siangtho>, holy or clean: a pure and sincere heart; with <nei> to have one, with <sak> to make the heart pure) (r:zd:24119/zd:24276/zd:22868) (q:draft)
lungsim takpi = (i:1) (t:n) (f:everyday/religion) (w:sincere heart/sincerity/whole heart) (d:<lungsim>, heart or mind, and <takpi>, true: a true heart; nearly always followed by <tawh>, with, and then meaning sincerely, wholeheartedly) (r:zd:22683/zd:20956) (q:draft)
lungsima = (i:1) (t:adv) (f:everyday) (w:in the mind/in the heart) (d:<lungsim>, mind, with <a>, in, written as one word: in the mind or heart) (j:lungsim/a) (r:zd:22858/zd:16340) (q:draft)
lungsimhoih = (i:1) (t:n) (f:social) (w:good heart/kind heart/good intention) (d:<lungsim>, heart, and <hoih>, good, written as one word: a good or kind heart, also kind-hearted) (j:lungsim/hoih) (r:zd:16313/zd:16433) (q:draft)
lungsimkhempeuh = (i:1) (t:phrase) (f:everyday) (w:all the heart/whole heart) (d:<lungsim>, heart or mind, and <khempeuh>, all, written as one word; {na lungsimkhempeuh tawh} is with all your heart) (j:lungsim/khempeuh) (r:zd:20932/zd:19774) (q:draft)
lungsimlam = (i:1) (t:n) (f:health) (w:mental side/matters of the mind/mental health) (d:<lungsim>, mind, with <lam>, field, written as one word: what concerns the mind; {lungsimlam damlo} is mentally ill) (j:lungsim/lam) (r:zd:25215/zd:21989) (q:draft)
lungsimna = (i:1) (t:n) (f:health/everyday) (w:heartache/pain of mind) (d:<lungsim>, mind, with <na>, here be in pain, written as one word: pain of the heart or mind; {a lungsimna mite} is those whose hearts ache) (j:lungsim/na) (r:zd:24537) (q:draft, low confidence)
lungsimnatna = (i:1) (t:n) (f:health) (w:mental pain/distress/heartache/depression) (d:<lungsim>, mind, and <natna>, sickness or pain, written as one word: pain of the mind, also said of mental illness) (j:lungsim/natna) (r:zd:23985/zd:21198) (q:draft)
lungsimpha = (i:1) (t:n) (f:everyday/social) (w:good heart/kind heart) (d:<lungsim>, heart, and <pha>, good, written as one word: a good heart, a kind mind) (j:lungsim/pha) (r:zd:21626) (q:draft)
lungsimpuak = (i:1) (t:n) (f:everyday/social) (w:attitude/mindset/disposition) (d:<lungsim>, mind, with <puak.1>, carry, written as one word: the way one carries the mind, attitude; the same as <lungsimpuakzia>) (s:lungsimpuakzia) (j:lungsim/puak) (r:zd:25569/zd:21037) (q:draft)
lungsimpuakzia = (i:1) (t:n) (f:everyday/social) (w:attitude/mindset/disposition) (d:<lungsim> and <puakzia> written as one word: the way one carries the mind, attitude) (j:lungsim/puakzia) (r:zd:25919/zd:21037/zd:22364) (q:draft)
lungsimsung = (i:1) (t:n) (f:body/religion) (w:inner heart/inside of the mind) (d:<lungsim> and <sung> written as one word: the inside of the heart or mind, in the heart) (j:lungsim/sung) (r:zd:20670/zd:19816) (q:draft)
lungsimsungah = (i:1) (t:adv) (f:everyday) (w:in the mind/in the heart) (d:<lungsim>, mind, and <sungah>, inside, written as one word: in the mind or heart) (j:lungsim/sungah) (r:zd:21741/zd:21837) (q:draft)
lungsimtakpi = (i:1) (t:n) (f:social/everyday) (w:sincere heart/whole heart) (d:<lungsim>, heart, with <takpi>, truly, written as one word: a true heart; {lungsimtakpi tawh} is sincerely, wholeheartedly) (s:lungsimtak) (j:lungsim/takpi) (r:zd:19841/zd:21796) (q:draft)
lungsimtawh = (i:1) (t:phrase) (f:everyday) (w:with the mind/with a heart) (d:<lungsim>, mind or heart, and <tawh>, with, written as one word: with a certain mind or intent; {lungsimtawh kisai pilna} is knowledge that concerns the mind) (j:lungsim/tawh) (r:zd:23977/zd:20670) (q:draft)
lungsimthu = (i:1) (t:n) (f:health/education) (w:matter of the mind/psychology) (d:<lungsim> and <thu> written as one word: what concerns the mind and the inner person) (j:lungsim/thu) (r:zd:21918/zd:17309) (q:draft)
lungsimuh = (i:1) (t:n) (f:everyday/body) (w:their mind/their heart) (d:<lungsim>, mind, and the plural marker <uh> written as one word, after <a>: their mind, their spirit) (j:lungsim/uh) (r:zd:21991) (q:draft)
lungsona = (i:1) (t:n) (f:everyday/social) (w:anger/rage/fury) (d:<lungso>, furious, with the noun suffix <na>: hot anger, the heart burning) (s:hehna) (b:lungso) (r:zd:24804/zd:15422) (q:draft)
lungsungah = (i:1) (t:adv) (f:everyday/body) (w:in the heart/in the mind) (d:<lungsung>, the inside of the heart, and <ah>, in, written as one word, after <ka>, <a> or <i>: in my, his or our heart) (j:lungsung/ah) (r:zd:21876/zd:16655) (q:draft)
lungtai = (i:1) (t:adj) (f:everyday/social) (w:cheerful/glad/light-hearted) (d:glad and at ease at heart; {lungtai takin} is cheerfully) (r:zd:24192/zd:15919/zd:25300) (q:draft)
lungtaina = (i:1) (t:n) (f:everyday/religion) (w:cheerfulness/joy/gladness) (d:a merry, cheerful heart, as in the proverb that it is good medicine; the opposite of <lungkiatna>, low spirits) (r:zd:25808/zd:16428) (q:draft, low confidence)
lungtangin = (i:1) (t:phrase) (f:body/health) (w:the heart/by the heart) (d:<lungtang> and the marker <in> written as one word: the heart as the one that acts) (j:lungtang/in) (r:zd:24276/zd:20778) (q:draft)
lungtangna = (i:1) (t:n) (f:health) (w:heart disease/heart trouble) (d:<lungtang>, heart, with <na>, be ill, written as one word: illness of the heart) (s:lungtangnatna) (j:lungtang/na) (r:zd:16235) (q:draft)
lungtangnat = (i:1) (t:n) (f:health) (w:heart disease/heart attack) (d:<lungtang>, heart, and <nat>, be ill, written as one word: illness of the heart) (j:lungtang/nat) (r:zd:24276) (q:draft)
lungtangnatna = (i:1) (t:n) (f:health) (w:heart disease) (d:<lungtang>, heart, and <natna>, disease, written as one word: illness of the heart) (j:lungtang/natna) (r:zd:24276/zd:20004) (q:draft)
lungtangpan = (i:1) (t:adv) (f:body/health) (w:from the heart) (d:<lungtang>, heart, and <pan>, from, written as one word; in these sentences of blood leaving the heart) (j:lungtang/pan) (r:zd:21306) (q:draft)
lungtangte = (i:1) (t:n) (f:body/religion) (w:hearts) (d:<lungtang>, heart, with the plural ending <te>) (b:lungtang) (r:zd:26385/zd:21273) (q:draft)
lungtho = (i:1) (t:v) (f:everyday/health) (w:be roused/be stirred up/be excited) (d:be stirred or stimulated in mind; {lungtho sak} is rouse someone, and {lungtho zatui} is a stimulant drug) (r:zd:24230/ts:3429) (q:draft, low confidence)
Lungthul = (i:1) (t:name) (c:khua) (f:travel) (w:Lungthul) (d:a village in Singngat subdivision of <Manipur>) (r:zd:19843) (q:draft, low confidence)
lungtuak = (i:1) (t:v) (f:social) (w:be of one mind/be united/agree) (d:<lung>, heart, with <tuak>: be of one heart and mind; {lungtuak in} is with one mind, together; mostly met in the name of the news group Phualva Lungtuak Media) (s:kilungtuak) (r:zd:17485) (q:draft, low confidence)
lungtup = (i:2) (t:n) (f:everyday/politics) (w:goal/aim/aspiration/objective) (d:what a person or a people has set the heart on reaching, a goal or aspiration; with <nei>, have a goal, and with <tung> or <tangtung>, reach it; not a term of endearment) (s:tupna) (r:zd:21285/zd:23706/zd:24807) (q:draft)
lungtupna = (i:1) (t:n) (f:everyday/work) (w:goal/aim/ambition) (d:<lung>, heart, with <tupna>, aim: what a person has set his heart on reaching, a goal in life) (s:tupna) (r:zd:19915/zd:21377) (q:draft)
lunguh = (i:1) (t:n) (f:everyday) (w:our heart/their heart) (d:<lung>, heart, with the plural marker <uh> written as one word, in expressions of feeling said of several people: {ka lunguh dam} is we are glad or thankful) (j:lung/uh) (r:zd:15951/zd:22623) (q:draft)
lungulh = (i:1) (t:v) (f:everyday) (j:lunggulh) (r:zd:24446/zd:22815) (q:draft)
lungulhna = (i:1) (t:n) (f:everyday) (j:lunggulhna) (r:zd:18172/zd:24172) (q:draft)
lungvei = (i:1) (t:v) (f:nature/health) (w:be worm-eaten/be infested with worms/be eaten away) (d:be eaten from inside by worms, <lungno>, said of a pig and of things that decay; also of what eats a person or a people away from within, as {zu lungvei}, addicted to drink, alcoholic) (r:zd:24072/zd:10721) (q:draft, low confidence)
lungzuan = (i:2) (t:v) (f:everyday/social) (w:be sad/grieve/feel lonely) (d:be heavy at heart from loss or loneliness, not longing for something; also as a noun, sorrow, paired with <khuangaihna>, and {lungzuan huai} is saddening) (r:zd:15695/zd:23902/zd:22749) (q:draft)
lungzuanla = (i:1) (t:n) (f:social/media) (w:sad song/song of longing) (d:<lungzuan>, be sad or long for, and <la>, song, written as one word: a sorrowful song of longing or loss) (j:lungzuan/la) (r:zd:14507/zd:17079) (q:draft)
lunmang = (i:1) (t:n) (f:social) (w:lord/chief/noble) (d:word of song language for a chief or a person of high rank, found only in verses of traditional songs) (r:ts:3168) (q:draft, low confidence)
Lunmual = (i:1) (t:name) (c:place) (f:travel) (w:Lunmual) (d:a village and a mountain of that name in the Tedim area of Chin State) (r:zd:21182) (q:draft, low confidence)
lunsim = (i:1) (t:n) (f:body/everyday) (j:lungsim) (r:zd:25106/zd:16989) (q:draft)
lunzia = (i:1) (t:n) (f:social/nature) (j:luanzia) (r:zd:18086/zd:19174) (q:draft, low confidence)
lupding = (i:1) (t:v) (f:everyday/home) (w:go to bed/be about to lie down) (d:<lup>, lie down, and <ding>, the marker of what is to come, written as one word: going to bed, about to lie down; {lupding ciangin} is at bedtime) (j:lup/ding) (r:zd:21876/zd:20874/zd:23388) (q:draft)
luphun = (i:1) (t:n) (f:time/home) (w:bedtime/time to sleep) (d:<lup> and <hun> written as one word: the time for lying down to sleep) (j:lup/hun) (r:zd:21168/zd:24069) (q:draft)
lupkhit = (i:1) (t:v) (f:everyday/health) (w:after lying down/have lain down) (d:<lup>, lie down, and <khit>, after, written as one word: once one has lain down or gone to bed) (j:lup/khit) (r:zd:21869/zd:21616) (q:draft)
lupkhopding = (i:1) (t:v) (f:family/social) (w:to sleep with/to lie with) (d:<lupkhop>, sleep with, and <ding> written as one word: to sleep with someone, sleeping together as what is to be done) (j:lupkhop/ding) (r:zd:16047) (q:draft)
lupkuan = (i:1) (t:n) (f:time/everyday) (w:bedtime) (d:<lup>, go to bed, with <kuan>, set out: the time of going to bed; {lupkuan ciangin} is when going to bed) (r:zd:19931/zd:24276/zd:21869) (q:draft)
luplup = (i:1) (t:v) (f:everyday) (w:keep lying/lie on and on) (d:<lup>, lie down, said twice: lie or sleep on and on; {na luplup kal in} is while you keep lying in bed) (b:lup) (r:zd:20647/zd:24653) (q:draft)
lupma = (i:1) (t:adv) (f:time/home) (w:before going to bed/at bedtime) (d:<lup>, lie down, with <ma>, before, written as one word: before going to sleep; often {nitak lupma in}) (j:lup/ma) (r:zd:24276/zd:24252) (q:draft)
lupmun = (i:1) (t:n) (f:home/health) (w:bed/sickbed/place of lying) (d:<lup>, lie down, and <mun>, place, written as one word: the place where one lies, a bed; {lupmun tungah} is on the bed, said of lying ill) (s:lupna) (j:lup/mun) (r:zd:19327/zd:17666) (q:draft)
lupna = (i:1) (t:n) (f:home) (w:bed/couch) (d:a place to lie on and sleep, a bed) (s:lupphah) (q:draft)
lupnading = (i:1) (t:n) (f:home) (w:place to lie down/place to sleep/sleeping place) (d:<lup>, lie down, and <nading>, for, written as one word: a place or thing for lying down to sleep) (s:lupna) (j:lup/nading) (r:zd:11219/zd:13233) (q:draft)
lupnakhan = (i:1) (t:n) (f:home) (w:bedroom) (d:<lupna>, bed, with a second part that means room: the room of a house in which people sleep) (r:zd:11148/zd:11285) (q:draft)
lupnasung = (i:1) (t:n) (f:home) (w:bedroom) (d:<lupna> and <sung> written as one word: the inside of the sleeping place, the bedroom) (j:lupna/sung) (r:zd:21516) (q:draft)
lupnatung = (i:1) (t:n) (f:home) (w:bed/on the bed) (d:<lupna> and <tung> written as one word: the top of the bed, the bed as the place where one lies; with <ah>, on the bed, in bed) (j:lupna/tung) (r:zd:14597/zd:13262) (q:draft)
luppih = (i:4) (t:v) (f:everyday/home) (w:sleep with/sleep beside/keep in bed) (d:lie down to sleep with a thing or a person beside one, with no sexual meaning, as with a phone or a bicycle kept by the bed; {luppih puan} is the blanket one sleeps with) (r:zd:23240/zd:17000/zd:12061) (q:draft)
lupsa = (i:1) (t:adv) (f:everyday/body) (w:lying down/while lying) (d:<lup>, lie down, with <sa>, in the state of: in a lying position, while lying down) (b:lup) (r:zd:16148/zd:25478) (q:draft, low confidence)
lupsan = (i:1) (t:v) (f:everyday/home) (w:go to bed leaving) (d:<lup>, lie down, with the ending {-san}, leaving behind: go to sleep and leave something or someone as it is) (b:lup) (r:ts:301) (q:draft, low confidence)
Lusei = (i:1) (t:name) (c:people) (f:social) (w:Lusei/Lushai) (d:a Zo people of Mizoram in India and their language, also called Mizo; {Lusei gam} is their land) (r:zd:21066/zd:25478/zd:21105) (q:draft)
Luseite = (i:1) (t:name) (c:people) (f:social) (w:Lushai/Lusei/Mizo) (d:the Lusei or Lushai people of Mizoram, <Lusei> with the plural <te>) (b:Lusei) (r:ts:301/zd:21066) (q:draft)
Lushai = (i:1) (t:name) (c:people) (f:social/politics) (w:Lushai/Lusei/Mizo) (d:older name of the Mizo people and of their country, the Lushai Hills, now Mizoram in India) (r:ts:3168/ts:3506/zd:24227) (q:draft)
Lushei = (i:1) (t:name) (f:social) (j:Lusei) (r:zd:20513/ts:301) (q:draft)
lut = (i:1) (t:v) (f:everyday/travel) (w:enter/go in) (d:go or come into a place; the place entered is usually marked with <sungah>, into, and the opposite is <pusuak>, go out) (s:sungtum) (a:pusuak/paikhiat) (r:40.12.9) (q:draft)
lutangna = (i:1) (t:n) (f:health/body) (w:headache) (d:<lutang>, head, with <na>, be in pain: a headache, named among the signs of an illness) (b:lutang) (r:zd:24054/zd:24476) (q:draft)
lutcil = (i:1) (t:v) (f:everyday/work) (w:first enter/enter at first) (d:<lut>, enter, and <cil>, at the beginning, written as one word: at the time of first entering a land or a job) (j:lut/cil) (r:zd:20805/zd:15859) (q:draft)
lutding = (i:1) (t:v) (f:everyday/travel) (w:will enter/to enter/to join) (d:<lut> and <ding> written as one word: will go in, in order to go in; also of joining a group or a programme) (j:lut/ding) (r:ts:11162/zd:17927/zd:15602) (q:draft)
lutdingin = (i:1) (t:v) (f:everyday/travel) (w:in order to enter/to get in/to join) (d:<lut> and <dingin> written as one word: so as to go into a place or join a group) (j:lut/dingin) (r:zd:21057/zd:11906) (q:draft)
lutgawp = (i:1) (t:v) (f:everyday) (w:rush in/pour in/crowd in) (d:<lut>, enter, and <gawp>, the particle of doing something heavily or all over, written as one word: go in by force or in a mass, as people into hiding places or smoke into a house) (j:lut/gawp) (r:zd:22214/zd:14611) (q:draft)
Lutheran = (i:1) (t:name) (f:religion) (w:Lutheran) (d:the Lutheran church, a Protestant denomination; {Lutheran Pawlpi} is the Lutheran Church) (o:English) (r:zd:24933/zd:14927) (q:draft)
luting = (i:1) (t:n) (f:body) (w:head) (d:the head of a person, as the part that aches; {luting na} is have a headache; the same part as <lu> and <lutang>) (r:zd:19931/zd:25808) (q:draft, low confidence)
lutkawikawi = (i:1) (t:v) (f:everyday/politics) (w:go in from place to place/raid around) (d:<lut>, enter, with <kawikawi>, about, written as one word: enter one place after another, said of rescue workers searching houses and of raids by the authorities) (j:lut/kawikawi) (r:zd:20401/zd:16197) (q:draft)
lutkha = (i:1) (t:v) (f:everyday/health) (w:get into/happen to enter/enter by accident) (d:<lut>, enter, and <kha>, happen to, written as one word: get into something without being meant to, as air, germs or soap into the body or into food, or a car into a shop) (j:lut/kha) (r:zd:11695/zd:14854/zd:22977) (q:draft)
lutkhin = (i:1) (t:v) (f:everyday/travel) (w:have entered/have joined) (d:<lut>, enter, and <khin>, already, written as one word: have already gone in, have already joined) (j:lut/khin) (r:zd:22203/zd:22935) (q:draft)
lutkhuan = (i:1) (t:n) (f:travel/politics) (w:permission to enter/entry permit/admission/right of entry) (d:<lut>, enter, and <khuan>, permission, written as one word: leave to enter a country, a place or a body, such as a visa or membership) (j:lut/khuan) (r:zd:25601/zd:11635/zd:17504) (q:draft)
lutkul = (i:1) (t:v) (f:everyday/travel) (w:must enter/have to go in) (d:<lut> and <kul> written as one word: it is necessary to go into a place or to join a group) (j:lut/kul) (r:zd:20289/zd:19679) (q:draft)
lutlaitak = (i:1) (t:adv) (f:everyday/time) (w:while entering/at the moment of entering) (d:<lut>, enter, and <laitak>, at the very time, written as one word: just when someone enters or breaks in) (j:lut/laitak) (r:zd:11352/zd:14981) (q:draft)
lutleh = (i:1) (t:v) (f:everyday) (w:if it comes in/when it enters) (d:<lut>, enter, and <leh>, if or when, written as one word: if or when someone or something comes in, as a call on a phone) (j:lut/leh) (r:zd:23663/zd:13166) (q:draft)
lutlo = (i:1) (t:v) (f:everyday/social) (w:not enter/not join) (d:<lut> and <lo> written as one word: not go in, not take part in or not become a member of) (j:lut/lo) (r:zd:19571/zd:24064/zd:20905) (q:draft)
lutloh = (i:1) (t:v) (f:everyday) (w:not enter/not join) (d:<lut>, enter, and the negative <loh>, written as one word; {lutloh nadingin} is so that it does not get in) (j:lut/loh) (r:zd:21006/zd:20328) (q:draft)
lutlut = (i:1) (t:v) (f:everyday/travel) (w:keep entering/enter one after another/go in again and again) (d:<lut>, enter, said twice and written as one word: enter repeatedly or one after another) (b:lut) (r:zd:22860/zd:21081) (q:draft)
lutma = (i:1) (t:adv) (f:everyday/travel) (w:before entering/before going in) (d:<lut>, enter, and <ma>, before, written as one word, mostly followed by <in>: before going into a place, or before a matter is taken up) (j:lut/ma) (r:zd:21042/zd:20172/zd:12403) (q:draft)
lutman = (i:1) (t:n) (f:work/social) (w:entrance fee/entry fee/admission) (d:<lut>, enter, with <man>, price: the money paid to enter a place or to take part in a contest) (j:lut/man) (r:zd:23114/zd:22967) (q:draft)
lutmasa = (i:1) (t:v) (f:everyday/travel) (w:enter first/go in first) (d:<lut>, enter, and <masa>, first, written as one word: go in first, or go in for the first time) (j:lut/masa) (r:zd:12063/zd:11677) (q:draft)
lutnading = (i:1) (t:phrase) (f:travel) (w:for entering/entry/entrance) (d:<lut> and <nading> written as one word: for going in; before a noun, the thing by which one enters, as a visa, a road or a gate) (j:lut/nading) (r:zd:11454/zd:12649) (q:draft)
lutnailo = (i:1) (t:v) (f:everyday) (w:have not yet entered/not yet join) (d:<lut> and <nailo> written as one word: has not yet gone in or joined) (j:lut/nailo) (r:zd:23485/zd:11679) (q:draft)
lutngam = (i:1) (t:v) (f:everyday) (w:dare to enter) (d:<lut>, enter, and <ngam>, dare, written as one word; mostly with <lo>, not dare to go in) (j:lut/ngam) (r:zd:24280/ts:3172) (q:draft)
lutol = (i:2) (t:n) (f:religion/politics) (w:Buddhist monk/monk) (d:a Buddhist monk, named for his shaven head, often {Kawl lutol}, a Burmese monk; {lutol buaina} is the monks' uprising of 2007; here no bald crown is meant) (s:phungzi) (r:zd:22782/zd:25322/zd:25562) (q:draft)
lutolte = (i:1) (t:n) (f:religion/politics) (w:Buddhist monks/monks) (d:<lutol>, bald head, with the plural <te> written as one word: Buddhist monks, named for their shaven heads) (b:lutol) (j:lutol/te) (r:zd:18200) (q:draft)
lutphei = (i:1) (t:v) (f:travel/everyday) (w:go in/enter/go across into) (d:<lut>, enter, with <phei> as a direction word, across or over to a place on the same level: go over and into a house, a room or a station) (b:lut) (r:zd:16148/zd:17143/zd:18943) (q:draft)
lutpihding = (i:1) (t:v) (f:everyday/travel) (w:to bring in/will bring in) (d:<lutpih>, bring in, and <ding> written as one word: to bring or take in, what is to be brought in) (j:lutpih/ding) (r:zd:14969/zd:11587) (q:draft)
lutpihsawm = (i:1) (t:v) (f:everyday/travel) (w:try to bring in/intend to take in) (d:<lutpih>, bring in, and <sawm>, intend, written as one word: try or plan to take a person or thing inside) (j:lutpih/sawm) (r:zd:16826/zd:11794) (q:draft)
lutsa = (i:1) (t:adj) (f:everyday/social) (w:already entered/already joined/enrolled) (d:<lut>, enter, with <sa> marking a finished act: that has already entered or joined; {a lutsa innkuan} is a household already enrolled) (b:lut) (r:zd:25789/zd:24158) (q:draft)
lutsakding = (i:1) (t:v) (f:politics/travel) (w:will let in/will admit/to bring in) (d:<lutsak>, let in, and <ding> written as one word: will admit, or to let in) (j:lutsak/ding) (r:zd:15116/zd:11109) (q:draft)
lutsaklo = (i:1) (t:v) (f:everyday/politics) (w:not let in/refuse entry/not admit) (d:<lutsak>, let in, and <lo>, not, written as one word: not allow someone to enter; with <ki>, be refused entry) (j:lutsak/lo) (r:zd:15602/zd:11112/zd:12403) (q:draft)
lutsakloding = (i:1) (t:v) (f:politics/everyday) (w:will not admit/will not be let in) (d:<lutsak>, let in, and <loding>, will not, written as one word: will not let in; after <ki>, will not be allowed to enter) (j:lutsak/loding) (r:zd:11635/zd:12403) (q:draft)
lutsakloh = (i:1) (t:v) (f:politics/travel) (w:not let in/not admit/bar from entering) (d:<lutsak>, let in, and the negative <loh> written as one word: not allow someone to enter a country or an area) (j:lutsak/loh) (r:ts:8311/zd:11055) (q:draft)
lutsaklohding = (i:1) (t:v) (f:politics/travel) (w:not to let in/bar from entering) (d:<lutsak>, let in, and <lohding>, not to, written as one word: that someone is not to be let in, a ban on entry) (j:lutsak/lohding) (r:zd:11216/zd:11053) (q:draft)
lutsawm = (i:1) (t:v) (f:everyday/travel) (w:try to enter/attempt to get in) (d:<lut>, enter, with <sawm>, intend, written as one word: try or set out to get into a place; {aguk lutsawm} is try to sneak in) (j:lut/sawm) (r:zd:11717/zd:15602) (q:draft)
lutsuak = (i:1) (t:v) (f:everyday/travel) (w:go right in/enter straight into) (d:<lut>, enter, with <suak>, right through: go straight into a place without stopping) (j:lut/suak) (r:zd:16998/zd:23036/zd:12146) (q:draft)
lutte = (i:3) (t:n) (f:politics/work) (w:those who join/participants/members) (d:after the name of a movement or body, as in {CDM lutte}: the people who have joined it, not people who go into a place) (r:zd:25273/ts:4831) (q:draft)
lutthak = (i:1) (t:v) (f:social) (w:newly join/newly enter) (d:<lut>, enter, with <thak>, new: have newly come in or joined; {pawl lutthak} is a new member of a group) (r:zd:21042/zd:23731) (q:draft)
lutthakna = (i:1) (t:n) (f:social) (w:new enrolment/new membership) (d:<lutthak>, newly join, with the noun suffix {-na}: the joining of new members; found in the heading {Genvai lutthakna}, new enrolment in the <Genvai> fund) (b:lutthak) (r:zd:25789) (q:draft, low confidence)
luttheihloding = (i:1) (t:v) (f:travel/politics) (w:will not be able to enter/barred from entering) (d:<luttheih>, be able to enter, and <loding>, will not, written as one word; before a noun: that will not be allowed in) (j:luttheih/loding) (r:zd:11074) (q:draft)
