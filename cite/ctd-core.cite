laukha = (i:1) (t:n) (f:religion/social) (w:soul/spirit) (d:word of songs and poems for <kha>, the soul or spirit of a person) (r:ts:3369) (q:draft, low confidence)
Laukkai = (i:1) (t:name) (c:city) (f:politics) (w:Laukkai) (d:town in the north of Shan State, Myanmar, chief town of the Kokang area) (r:zd:11625/ts:5105) (q:draft)
laulo = (i:1) (t:adj) (f:everyday) (w:unafraid/fearless/without fear) (d:<lau>, afraid, and <lo>, not, written as one word; {laulo in} is without fear) (j:lau/lo) (r:zd:21389/zd:20092/zd:17549) (q:draft)
lauloh = (i:1) (t:v) (f:everyday) (w:not fear/be unafraid) (d:<lau>, fear, and the negative <loh> written as one word, before words such as <na> and <ding>: not fearing; {lauloh na} is fearlessness) (j:lau/loh) (r:zd:24231/zd:20899) (q:draft)
lauluat = (i:1) (t:n) (f:everyday) (w:great fear/being too afraid) (d:<lau> and <luat> written as one word: being too much afraid; {lauluat manin} is because of being so afraid) (j:lau/luat) (r:zd:14824/zd:25567) (q:draft)
laumahmah = (i:1) (t:adj) (f:everyday) (w:very afraid/terrified) (d:<lau>, afraid, and <mahmah>, very, written as one word) (j:lau/mahmah) (r:zd:15577/zd:15178) (q:draft)
laupipi = (i:1) (t:adv) (f:everyday) (w:in great fear/fearfully) (d:<lau> and <pipi> written as one word, mostly followed by <in>: while very much afraid) (j:lau/pipi) (r:zd:13334/zd:17758) (q:draft)
lauthawnggawp = (i:1) (t:v) (f:everyday/media) (w:panic/be terrified) (d:<lauthawng>, be struck with fear, and <gawp>, severely, written as one word: be badly frightened, panic; often paired with <patau>) (j:lauthawng/gawp) (r:zd:16595/zd:14875/zd:13063) (q:draft)
lauthawngsak = (i:1) (t:v) (f:everyday/social) (w:frighten/threaten/intimidate/scare) (d:<lauthawng>, sudden fear, with the causative <sak>: make someone afraid, threaten, as with a knife or with a false bomb warning) (s:lausak) (b:lauthawng) (r:zd:19100/zd:16811/zd:20132) (q:draft)
lauthawngsakna = (i:1) (t:n) (f:politics/social) (w:threat/intimidation/scare) (d:<lauthawngsak>, frighten or threaten, with the noun ending {-na}: a threat that makes people afraid, as {Bomb ki lauthawngsakna}, a bomb threat) (b:lauthawngsak) (r:zd:21627/zd:19100) (q:draft)
Lawas = (i:1) (t:name) (c:city) (f:travel) (w:Lawas) (d:a town and district in Sarawak, Malaysia) (r:zd:15746) (q:draft)
lawh = (i:2) (t:adv) (f:everyday) (w:as a result/thereby) (d:placed after a verb to say that what it names comes about as a consequence of something said before, a loss or a gain, not the calling of a name: {sih lawh} is die of it, {ngah lawh} is gain by it) (r:zd:24231/zd:22090/zd:25255) (q:draft)
lawhcingin = (i:1) (t:adv) (f:everyday/work) (w:successfully) (d:<lawhcing>, succeed, with <in> written as one word: successfully, having succeeded) (j:lawhcing/in) (r:zd:11279/zd:17566) (q:draft)
lawhcinglo = (i:1) (t:adj) (f:everyday/work) (w:unsuccessful/failing) (d:<lawhcing> succeed and <lo> not written as one word: not succeed, fail; {a lawhcinglo te} are those who fail) (j:lawhcing/lo) (r:zd:21502/zd:23157) (q:draft)
lawhcingsak = (i:1) (t:v) (f:everyday/work) (w:make successful/cause to succeed/give success) (d:<lawhcing> and <sak> written as one word: make a person or a work succeed) (j:lawhcing/sak) (r:zd:16340/zd:25156) (q:draft)
lawhcingte = (i:1) (t:n) (f:social/work) (w:successful people/the successful) (d:<lawhcing>, succeed, with the plural <te>: those who succeed, mostly as {mi lawhcingte}) (b:lawhcing) (r:zd:16340/zd:16625/zd:21568) (q:draft)
lawhcingzaw = (i:1) (t:adj) (f:work/social) (w:more successful) (d:<lawhcing>, succeed, and the comparative <zaw> written as one word: more successful, succeed more) (j:lawhcing/zaw) (r:zd:18255/zd:21066) (q:draft)
lawhcinlohna = (i:1) (t:n) (f:everyday/work) (w:failure/lack of success) (d:<lawhcin>, succeed, and <lohna>, the state of not doing, written as one word: not succeeding, a failure) (j:lawhcin/lohna) (r:zd:21989/zd:23443) (q:draft)
lawhcinna = (i:1) (t:n) (f:work/everyday) (w:success/achievement) (d:<lawhcin>, succeed, with the noun suffix <na>: success, what a person has achieved) (b:lawhcin) (r:zd:20805/zd:16340) (q:draft)
lawhcinnate = (i:1) (t:n) (f:work/social) (w:successes/achievements) (d:<lawhcinna> with the plural <te>: successes, the things a person has achieved) (b:lawhcinna) (r:zd:22807/zd:23067) (q:draft)
lawhloh = (i:1) (t:v) (f:health/social) (w:not infect/not pass on) (d:<lawh>, here pass on to another or catch from another, with the negative <loh>, before <nadingin>: so that a disease or a bad influence does not spread to someone) (r:zd:23935/zd:21989) (q:draft, low confidence)
lawhna = (i:3) (t:n) (f:everyday/social) (w:name/designation/term/calling) (d:what a person, place or thing is called by some people, the name they use for it: {ei lawhna} is our name for it and {namdangte' hong lawhna} what other peoples call us; not the picking of fruit) (r:ts:4569/zd:21607/zd:23974) (q:draft)
lawhphei = (i:1) (t:v) (f:everyday) (w:spread to/spread across/catch) (d:of fire, disease, an earthquake or bad conduct: pass sideways onto what is near, as <kilawh> is spread; {kilawhphei} is used in the same way) (r:zd:18947/zd:11738/zd:14575) (q:draft)
lawhsam = (i:1) (t:v) (f:everyday/work) (w:fail/be unsuccessful) (d:not achieve what was aimed at; the form <lawhsap> is used before endings such as <na>) (a:lawhcing) (r:zd:25227/zd:19975/zd:16340) (q:draft)
lawhsap = (i:1) (t:v) (f:work/everyday) (w:fail/be unsuccessful) (d:form of <lawhsam>, fail, used before words such as <ni>, <hun> and <loh>; the opposite of <lawhcin>, succeed) (a:lawhcin) (r:zd:21392/zd:25751) (q:draft)
lawhsapna = (i:1) (t:n) (f:everyday/work) (w:failure/disappointment) (d:not succeeding in what was aimed at, the opposite of <lawhcinna>, success) (a:lawhcinna) (r:zd:24313/zd:21502/zd:11279) (q:draft)
lawhthei = (i:1) (t:v) (f:health/everyday) (w:can spread to/be contagious/can infect) (d:<lawh>, pass to or come upon another, with <thei>, can: of a disease, able to pass to others; after <tuahsiat>, accident, and similar words, liable to meet with it) (r:zd:11644/zd:23848) (q:draft, low confidence)
lawhto = (i:1) (t:v) (f:everyday/nature) (w:spread upward) (d:of a fire, catch and spread up to the floors above; {lawhsuk} is spread downward) (r:zd:14559/zd:20624) (q:draft)
lawhzia = (i:1) (t:n) (f:education/media) (w:pronunciation/way of pronouncing) (d:<lawh> and <zia> written as one word: the way a word is called out or pronounced, as in {lamal lawhzia}, pronunciation of the words) (j:lawh/zia) (r:zd:17634) (q:draft, low confidence)
Lawibual = (i:1) (t:name) (c:place) (f:travel/social) (w:Lawibual) (d:a quarter, <veng>, of the town of Tedim in Chin State) (r:zd:12765/zd:20131) (q:draft)
lawm = (i:1) (t:n) (f:social) (w:friend/companion) (d:a friend or companion; {lawm ngaih} is a lover or beloved) (s:lawmpa) (a:gal) (r:20.18.24) (q:draft)
lawm aw = (i:1) (t:intj) (f:everyday/social) (w:my friend/friend) (d:<lawm>, friend, and <aw>, here the calling word placed after the one addressed: used in speech to address a friend or the reader, at the start or end of a sentence) (r:zd:20652/zd:22858) (q:draft)
lawm kingai = (i:1) (t:n) (f:social/family) (w:lovers/sweethearts/courting couple) (d:<lawm>, friend, and <kingai>, love each other: a young man and woman who are in love and courting but not married, as against <nupa>, husband and wife; with <te> for the plural or a number after it) (r:zd:20730/zd:13072) (q:draft)
lawmaker = (i:1) (t:n) (f:politics) (w:lawmaker/member of parliament/legislator) (d:the English word used in news reports for a member of a parliament, often placed before the name) (o:English) (r:zd:17677/zd:11459) (q:draft, low confidence)
lawmakers = (i:1) (t:n) (f:politics) (w:lawmakers/members of parliament/legislators) (d:the English plural of <lawmaker>, used in news reports, often followed by the plural <te>) (b:lawmaker) (o:English) (r:zd:25622/zd:11117) (q:draft, low confidence)
lawmdang = (i:1) (t:n) (f:social) (w:another friend/other friends) (d:<lawm> and <dang> written as one word: a friend or companion other than the ones one has) (j:lawm/dang) (r:zd:17152/zd:21866) (q:draft)
lawmdangte = (i:1) (t:n) (f:social) (w:other friends/the others/fellows) (d:<lawm> and <dangte> written as one word: other friends or companions, also the other peoples or groups beside one's own) (j:lawm/dangte) (r:zd:21421/zd:21866) (q:draft)
lawmhoih = (i:1) (t:n) (f:social) (w:good friend) (d:<lawm>, friend, with <hoih>, good, written as one word: a good friend) (j:lawm/hoih) (r:zd:21085/zd:19841/zd:23902) (q:draft)
lawmit = (i:1) (t:n) (f:social) (w:dear friend/beloved friend/close friend) (d:<lawm> friend and <it> love as one word: a friend one holds dear) (r:zd:25097/zd:21432/zd:21355) (q:draft)
lawmkingai = (i:1) (t:n) (f:social/family) (w:lovers/couple in love/sweethearts) (d:<lawm>, friend, with <kingai>, love each other, written as one word: a man and a woman who are in love but not married) (j:lawm/kingai) (r:zd:21138/zd:16961) (q:draft)
lawmlegual = (i:1) (t:n) (f:social) (w:friends/companions/peers) (d:<lawm>, friend, <le>, and, and <gual>, here one's peers, written as one word: friends and companions as a group) (j:lawm/le/gual) (r:zd:24276/zd:21667/zd:22683) (q:draft)
lawmlegualte = (i:1) (t:n) (f:social) (w:friends/companions) (d:<lawmlegual>, friends and companions, with the plural <te>) (b:lawmlegual) (j:lawmlegual/te) (r:zd:24276/zd:24069) (q:draft)
lawmlehgual = (i:1) (t:n) (f:social) (w:friends/friends and companions/peers) (d:<lawm>, friend, <leh>, and, and <gual>, here peer or companion, written as one word: one's friends and companions taken together) (j:lawm/leh/gual) (r:zd:17309/zd:14720) (q:draft)
lawmlo = (i:1) (t:adj) (f:social) (w:unfitting/improper/unseemly) (d:<lawm>, fitting, as in <kilawm>, with <lo>, not, written as one word after <ki> or a verb: not proper; {et lawmlo} is not fit to look at, unseemly) (r:zd:15602/zd:22652) (q:draft)
lawmngaih = (i:1) (t:n) (f:social/family) (w:lover/sweetheart/boyfriend/girlfriend) (d:<lawm>, friend, with <ngaih>, beloved: the person one is in love with and courting) (r:zd:9231/zd:11714/zd:21432) (q:draft)
lawmngaihnu = (i:1) (t:n) (f:social/family) (w:girlfriend/sweetheart) (d:<lawmngaih>, sweetheart, with <nu> for a woman: the girl or woman someone is in love with) (b:lawmngaih) (r:zd:16133/zd:19425) (q:draft)
lawmngaihpa = (i:1) (t:n) (f:social/family) (w:boyfriend/lover/sweetheart) (d:<lawmngaih>, sweetheart, with <pa> marking a man: the man a woman loves; the woman is <lawmngaihnu>) (b:lawmngaih) (r:zd:20854/zd:24056) (q:draft)
lawmngaihte = (i:1) (t:n) (f:social/family) (w:sweethearts/lovers/partners) (d:plural of <lawmngaih>, sweetheart; also said of the partner or partners of the people spoken of) (b:lawmngaih) (r:zd:21151/zd:19425) (q:draft)
lawmta = (i:2) (t:n) (f:social) (w:couple/pair/lovers) (d:two people who are together as lovers or partners, often after <hih>, <hihte> or <amau>; <nupa> is said of a married couple) (r:zd:22728/zd:12913) (q:draft)
lawmtate = (i:1) (t:n) (f:social) (w:friends/close friends) (d:<lawmta>, friends bound to one another, with the plural <te>) (s:lawmte) (b:lawmta) (r:zd:15376/ts:3369) (q:draft)
lawmten = (i:1) (t:n) (f:social) (w:friends) (d:<lawmte>, friends, with <n>, the short form of <in> that marks the doer of the action, written as one word) (j:lawmte/n) (r:zd:23556/zd:23148) (q:draft)
lawmteng = (i:1) (t:n) (f:social) (w:friends/all the friends) (d:<lawm>, friend, with <teng>, here all, written as one word: the friends as a group, all of one's friends) (j:lawm/teng) (r:zd:21869/zd:16442) (q:draft)
lawn = (i:1) (t:v) (f:everyday) (w:throw/cast/hurl) (d:throw something or someone away from oneself, into or onto a place) (s:lot) (q:draft)
lawn = (i:3) (t:v) (f:everyday/politics) (w:fire/launch/shoot) (d:send off a shot from a weapon or send something up into the air; after <thau>, fire a gun, and of missiles, rockets, fireworks and satellites, launch, the last as {lawn to}) (r:ts:11036/zd:11292/zd:14780) (q:draft)
lawng = (i:2) (t:n) (f:everyday) (w:piece/unit) (d:counting word for guns and other long weapons, placed between the name of the weapon and the number, as in {thau lawng 4}, four guns; not the verb touch) (r:ts:10733/ts:5921/ts:1822) (q:draft)
lawngkhat = (i:1) (t:adv) (f:social) (w:in unison/as one) (d:in one channel or one stream; {lawngkhat in luangkhawm} is flow together as one, and {awkhat lawngkhat} is with one voice, in unison) (r:zd:22557/zd:20971/zd:21369) (q:draft)
Lawngtlai = (i:1) (t:name) (c:khua) (f:travel/politics) (w:Lawngtlai) (d:town and district in the south of <Mizoram>, India) (r:ts:1885/zd:23703) (q:draft)
lawnkhia = (i:2) (t:v) (f:politics) (w:launch/fire) (d:of a weapon: launch a missile or fire a shot, with words such as {thuapi}, <nuclear> or <thau> before it) (r:zd:16416/zd:12425) (q:draft)
lawphuai = (i:1) (t:adj) (f:everyday/social) (w:exciting/enjoyable/inspiring) (d:<lawp>, eager, with <huai>: making people eager and glad, exciting to take part in) (b:lawp) (r:zd:12688/zd:24814) (q:draft)
lawplua = (i:1) (t:adj) (f:everyday) (w:too eager/very excited/overjoyed) (d:<lawp>, eager, and <lua>, too much, written as one word) (j:lawp/lua) (r:zd:20092/zd:24420) (q:draft)
lawpmahmah = (i:1) (t:adj) (f:everyday/social) (w:very eager/very excited/very keen) (d:<lawp>, eager, and <mahmah>, very, written as one word) (j:lawp/mahmah) (r:zd:14912/zd:21083) (q:draft)
lawptak = (i:1) (t:adv) (f:everyday) (w:eagerly/enthusiastically/gladly) (d:<lawp>, eager, with <tak> written as one word, usually followed by <in>: eagerly, with enthusiasm) (s:lawptakin) (j:lawp/tak) (r:zd:24574/zd:18121/zd:13011) (q:draft)
lawyer = (i:1) (t:n) (f:politics/work) (w:lawyer/attorney) (o:English) (r:zd:11452/zd:23329) (q:draft)
Lazarus = (i:1) (t:name) (c:male) (f:religion) (j:Lazaras) (r:zd:12196) (q:draft)
le gual = (i:1) (t:phrase) (f:social/everyday) (w:and companions/and peers) (d:<le>, and, with <gual>, here one of the same rank or age, a peer: the second half of the fixed pair {lawm le gual}, friends and companions, friends of every kind; it stands after <lawm>, friend) (r:zd:20860/zd:23797) (q:draft)
le hangh = (i:1) (t:conj) (f:everyday) (w:if we) (d:<le>, here a short form of <leh>, if, and <hangh>, we including the hearer: placed after a verb at the end of a clause, if we do it; the clause that follows says what then holds or is seen) (r:zd:16243/zd:17374/zd:17976) (q:draft)
lead = (i:1) (t:n) (f:media) (w:lead/lead guitar) (d:the lead part in a music band, usually the lead guitar; {lead tum} is play lead) (o:English) (r:zd:20920) (q:draft, low confidence)
lead = (i:2) (t:n) (f:health/work) (w:lead) (d:the heavy metal lead, named as a poison) (o:English) (r:zd:11860) (q:draft, low confidence)
lecture = (i:1) (t:n) (f:education) (w:lecture/talk) (d:a talk given to teach an audience; {lecture pia} is give a lecture) (o:English) (r:zd:9230/zd:9232) (q:draft)
Lecturer = (i:1) (t:n) (f:education) (w:lecturer/university teacher) (o:English) (r:zd:15624/ts:3375) (q:draft)
leeng = (i:2) (t:conj) (f:everyday) (w:if/even if) (d:another spelling of <leng>, the conditional ending for we or I as subject, placed after the verb: if we; with <zong> it is even if we; not the verb fly) (s:leng) (r:zd:23754/zd:17156/zd:24280) (q:draft)
leeng = (i:3) (t:n) (f:travel) (w:cart/carriage) (d:a vehicle on wheels; {sakol leeng} is a cart drawn by a horse; not the verb fly) (r:zd:9221) (q:draft, low confidence)
leengla = (i:1) (t:n) (f:social) (w:guest/visitor) (d:often paired as {zin le leengla}, guests and strangers; {zin le leengla do} is to show hospitality) (s:zin/zinpa) (a:innteek) (q:draft)
leengnaa = (i:1) (t:n) (f:social/home) (w:sojourner/guest/lodger) (d:one who lives in the house or land of another, set against <innteek>, the owner, and glossed by the writers with <peemta>; perhaps the same word as <leengla>) (s:peemta) (r:zd:19239) (q:draft, low confidence)
leengzong = (i:1) (t:conj) (f:everyday) (w:even if/even though) (d:the conditional ending <leng>, here written with a long vowel, and <zong> written as one word after a verb: even if we, even if one does) (j:leng/zong) (r:zd:25165/zd:16433) (q:draft)
Leentaang = (i:1) (t:name) (c:khua) (f:travel) (w:Leentaang) (d:place on the road from Tedim by way of Maansuang and Laaitui, apparently a village) (r:zd:20545) (q:draft, low confidence)
Leggings = (i:1) (t:n) (f:everyday) (w:leggings) (d:close-fitting stretch trousers, also written {Leggings pheituam}) (o:English) (r:zd:12151/zd:11943) (q:draft, low confidence)
leh = (i:1) (t:conj) (f:everyday) (w:and) (d:joins words and phrases; also written <le>) (s:le)
leh = (i:3) (t:conj) (f:everyday) (w:if/when) (d:placed after the verb of a clause to make it a condition; {bang hang hiam cih leh}, literally if one asks why, means because) (s:aleh/le) (r:1.4.15) (q:term added from the example, Genesis 4.15)
leh apawlte = (i:1) (t:phrase) (f:politics/social) (w:and associates/and company/and allies/and followers) (d:<leh>, and, with {a pawlte}, his group, from <pawl>: placed after the name of a person or country, that one together with the people or countries on the same side) (r:zd:23792/zd:14734) (q:draft)
lehbel = (i:1) (t:conj) (f:everyday) (w:if/in case/if indeed) (d:<leh>, if, and the particle <bel> written as one word, placed at the end of a clause: if that should be the case, as for when) (j:leh/bel) (r:zd:19953/zd:19556) (q:draft)
lehbulh = (i:1) (t:v) (f:everyday) (w:reverse/invert/put the wrong way round) (d:put two things in the opposite order or place; {ki lehbulh} is be reversed, be the opposite of each other, contradict) (r:zd:25467/zd:15996/zd:20406) (q:draft)
lehhen = (i:1) (t:v) (f:politics/everyday) (w:tie behind the back/bind the hands behind) (d:tie the hands of a person together behind the back; <leh> is here turn back and <hen> is here bind) (r:zd:22858/zd:11827) (q:draft)
lehkhiat = (i:1) (t:v) (f:education/media) (w:translate) (d:turn a writing into another language, which is marked with <tawh>; the form of {lehkhia} written before a following word, and also the noun, a translation) (r:zd:25094/zd:25281/zd:14703) (q:draft)
lehkik = (i:1) (t:v) (f:travel) (w:turn back/return) (d:turn round and go back, usually after the prefix <ki>, as in <kilehkik>; said of people and of an aircraft returning to where it took off) (r:zd:23054/zd:22618) (q:draft)
lehkik = (i:2) (t:v) (f:education) (w:translate back/translate) (d:turn a text from another language back into Zolai) (r:zd:25478) (q:draft, low confidence)
lehlah = (i:1) (t:conj) (f:everyday) (w:if on the other hand/and if) (d:<leh>, if, with the emphatic <lah>, written as one word after a verb: if on the other hand, and then again if; often after <kei>, as {om kei lehlah}, and if there is none) (j:leh/lah) (r:zd:16148/zd:19816) (q:draft, low confidence)
lehlam = (i:1) (t:n) (f:everyday) (w:opposite/reverse/other side) (d:the opposite of what was said or the other side of a thing; {a lehlam in} is the other way round, and {a lehlam lehlamah} on both sides) (r:ts:11679/zd:22228) (q:draft)
lehluan = (i:1) (t:v) (f:everyday/nature) (w:flow back) (d:<leh>, here meaning back, with <luan>, flow: flow back the way it came, often with <kik>) (r:zd:19798) (q:draft)
lehsakkik = (i:1) (t:v) (f:travel) (w:turn back/send back) (d:<lehkik>, turn back, with the causative <sak> inside it: make something turn back; with <ki> it is said of an aircraft that is made to return) (b:lehkik) (r:zd:20013/zd:15878) (q:draft)
lehtaigawp = (i:1) (t:v) (f:travel/everyday) (w:run backwards/roll back violently) (d:<lehtai>, run back, with <gawp>, severely: of a machine or vehicle, suddenly run in the reverse direction out of control) (j:lehtai/gawp) (r:zd:11922) (q:draft)
lehtat = (i:1) (t:v) (f:social) (w:go back on/renege/turn against) (d:turn back from what was said or agreed and act against it) (r:zd:21388/zd:22780) (q:draft, low confidence)
lehzong = (i:1) (t:conj) (f:everyday) (w:even if/even though) (d:<leh>, if, and <zong>, also, written as one word and placed after a verb: even if that is so) (j:leh/zong) (r:zd:24276/zd:25919) (q:draft)
lei = (i:3) (t:v) (f:everyday/work) (w:buy) (r:zai:buy) (q:draft)
leibat = (i:1) (t:n) (f:work) (w:debt) (d:money that is owed; {leibat nei} is be in debt and {leibat loh} is pay a debt) (s:leiba) (r:zd:19462/zd:16317/zd:23904) (q:draft)
Leicester = (i:1) (t:name) (c:city) (f:travel) (w:Leicester) (d:city in England) (r:zd:17911/zd:16767) (q:draft)
leiciatna = (i:1) (t:n) (f:work/social) (d:<lei>, buy, and <ciatna> written as one word: the buying by each one; {i leiciatna dingin} is so that each of us buys) (j:lei/ciatna) (r:zd:23171) (q:draft, low confidence)
leicim = (i:1) (t:n) (f:nature) (w:landslide/earth collapse) (d:<lei>, earth, and <cim>, collapse, written as one word: a fall of earth, a landslide; also as a verb, the ground gives way) (s:mencim) (j:lei/cim) (r:zd:22821/zd:14802) (q:draft)
leiding = (i:1) (t:v) (f:work/everyday) (w:to buy/will buy) (d:<lei>, buy, and <ding> written as one word: to buy, going to buy, something to be bought) (j:lei/ding) (r:zd:25616/zd:24530) (q:draft)
leihsa = (i:1) (t:n) (f:everyday) (w:address) (d:the address of a person or a home; in the articles written beside the English word address) (s:address) (o:Burmese) (r:zd:14887) (q:draft, low confidence)
leii = (i:2) (t:n) (f:travel) (w:bridge) (d:a different word from {leii}, tongue: a bridge over a river, after the name of the place, as in {Maansuang leii}; {leiipi} is a large bridge) (s:gunlei) (r:zd:21458/zd:11110) (q:draft)
leikhit = (i:1) (t:v) (f:work/everyday) (w:have bought/after buying) (d:<lei>, buy, and <khit> written as one word: have finished buying; {na leikhit zawh} is after you have bought it) (j:lei/khit) (r:zd:11702/zd:19154) (q:draft)
leikhol = (i:1) (t:v) (f:work) (w:buy in advance/buy beforehand/stock up) (d:<lei>, buy, with <khol>, beforehand or in store: buy a thing ahead of the time it is needed and keep it) (j:lei/khol) (r:zd:19166/zd:14983) (q:draft)
leikhuan = (i:1) (t:n) (f:work/politics) (w:permission to buy/right to buy) (d:<lei>, buy, and <khuan>, permission, written as one word: being allowed to buy something) (j:lei/khuan) (r:zd:16431/zd:11693) (q:draft)
leikul = (i:1) (t:v) (f:work/everyday) (w:have to buy/must buy) (d:<lei>, buy, and <kul>, be necessary, written as one word: it is necessary to buy) (j:lei/kul) (r:zd:22650/zd:23301) (q:draft)
leilam = (i:2) (t:n) (f:travel/politics) (w:land/overland route/ground) (d:the land as a way of travel or of fighting, as against the sea and the air, <vanlam>: {leilam tawh} is by land, overland, and {leilam pan} is from the ground) (r:zd:25094/zd:26495/ts:12074) (q:draft)
leilei = (i:1) (t:v) (f:work/everyday) (w:keep buying/buy and buy) (d:<lei>, buy, said twice: buy again and again, go on buying) (b:lei) (r:zd:22742) (q:draft, low confidence)
leiloh = (i:1) (t:v) (f:everyday/work) (w:not buy) (d:<lei>, buy, with the negative <loh>, written as one word: not buying; {leiloh phamawh} is cannot do without buying, must buy) (j:lei/loh) (r:zd:19814/zd:15971) (q:draft)
Leilum = (i:1) (t:name) (c:khua) (f:travel/social) (w:Leilum) (d:a quarter of Tedim town, called both <veng>, quarter, and <khua>, village, in the articles) (r:zd:22586) (q:draft, low confidence)
leimaitang = (i:1) (t:n) (f:nature) (w:ground surface/surface of the earth/land) (d:<lei> and <maitang> written as one word: the surface of the ground) (j:lei/maitang) (r:zd:16862/zd:24215) (q:draft)
leinading = (i:1) (t:adv) (f:work/everyday) (w:for buying/in order to buy) (d:<lei>, buy, and <nading>, for, written as one word: for buying, in order to buy) (j:lei/nading) (r:zd:13112/zd:21400) (q:draft)
leipi = (i:2) (t:n) (f:travel) (w:bridge/great bridge) (d:<lei>, bridge, with <pi>, great: a large bridge over a river or channel, not the earth; shown by words of crossing such as <kan> and by a place name before it) (r:zd:22686/zd:19814/zd:12950) (q:draft)
leisai = (i:1) (t:n) (f:nature) (w:loose earth/soil/heap of earth) (d:loose earth or soil, as on a grave, at a roadside or in a landslide) (r:zd:20155/zd:15781) (q:draft, low confidence)
leisantang = (i:1) (t:n) (f:home/work) (w:brick) (d:a block of baked red clay used for building) (r:zd:17530) (q:draft, low confidence)
leisate = (i:1) (t:n) (f:work/everyday) (w:those who have bought/buyers) (d:<leisa>, bought, and the plural <te>, written as one word: those who have bought something; {a leisate} is the ones who bought it) (j:leisa/te) (r:zd:17217) (q:draft)
leisawm = (i:1) (t:v) (f:work) (w:plan to buy/seek to buy) (d:<lei>, buy, and <sawm>, intend, written as one word: intend or try to buy; common in headlines) (j:lei/sawm) (r:zd:11329/zd:21567) (q:draft)
leisungah = (i:1) (t:adv) (f:nature) (w:in the ground/underground/into the soil) (d:<leisung> with the place marker <ah> written as one word: in or into the ground) (j:leisung/ah) (r:zd:17335/zd:19875) (q:draft)
leitangh = (i:1) (t:n) (f:nature) (j:leitang) (r:zd:20747/zd:18086) (q:draft)
leitangtung = (i:1) (t:n) (f:nature) (w:ground/soil/surface of the land) (d:<leitang>, land, with <tung>, upon: the ground, the soil of a place or country; {Kawlgam leitangtung ah} is on Burmese soil) (j:leitang/tung) (r:zd:11207/zd:12494) (q:draft)
leitangvai = (i:1) (t:n) (f:social/work) (w:land matter/land affair/property matter) (d:<leitang>, land, and <vai>, matter, written as one word: a matter concerning land or property; {leitangvai kinialna} is a land dispute) (j:leitang/vai) (r:zd:12450) (q:draft)
leitawh = (i:1) (t:adv) (f:everyday/nature) (w:against the ground/with earth) (d:<lei>, ground, and <tawh>, with, written as one word: with or against the ground, with earth) (j:lei/tawh) (r:zd:21248/zd:26124/zd:12450) (q:draft)
leitawh = (i:2) (t:n) (f:travel/nature) (w:south) (d:south, in {leitawh lam}, the south or the southern part; the dictionary writes {leitaw lam}) (r:zd:20730) (q:draft, low confidence)
Leitawhtan = (i:1) (t:name) (c:place) (f:travel) (w:Leitawhtan) (d:a place by Tedim town in Chin State; the name means a cutting dug through the earth, and one article uses it for the Panama Canal) (r:zd:22577/zd:24280) (q:draft)
leitawi = (i:2) (t:v) (f:work/social) (w:borrow) (d:take something on loan, to be paid back later; said of what one does for another person it also means give on loan, lend) (q:draft)
leitawisak = (i:1) (t:v) (f:work/social) (w:lend) (d:<leitawi>, borrow, with the causative <sak>: let someone borrow, lend) (a:leitawi) (b:leitawi) (q:draft)
leitawisawm = (i:1) (t:v) (f:work/politics) (w:plan to borrow/intend to borrow) (d:<leitawi>, borrow, and <sawm>, intend, written as one word: plan to take a loan; seen in one headline) (j:leitawi/sawm) (r:zd:11380) (q:draft, low confidence)
leitawlam = (i:1) (t:n) (c:direction) (f:travel/nature) (w:south/southern part) (d:<leitaw>, south, with <lam>, side or direction: the south, the southern part of a country, or southward) (s:leitaw/khanglam) (a:leilulam) (j:leitaw/lam) (r:zd:13125/zd:19786/zd:17474) (q:draft)
leithei = (i:1) (t:v) (f:work) (w:can buy/be able to buy) (d:<lei> buy and <thei> able, written as one word; {ki leithei} is it can be bought, is on sale) (j:lei/thei) (r:zd:23528/zd:14531/zd:14577) (q:draft)
leitheih = (i:1) (t:v) (f:work/everyday) (w:be able to buy/can be bought) (d:<lei>, buy, and <theih>, be able, written as one word; {leitheih nadingin} is so that it can be bought, and {leitheih hilo} is it cannot be bought) (j:lei/theih) (r:zd:14577/zd:16205/zd:19558) (q:draft)
leitolh = (i:1) (t:n) (f:nature) (w:landslide/landslip) (d:<lei>, earth, with <tolh>, slip out: a slide of earth down a slope; often written <mencim leitolh>) (r:zd:20155/zd:20582) (q:draft)
leitoset = (i:1) (t:n) (f:work) (w:excavator/digger) (d:machine that digs earth, from <lei>, earth, <to>, dig, and <set>, machine) (r:ts:8273/zd:12498) (q:draft)
leitung galpi = (i:1) (t:n) (f:politics) (w:world war) (d:<leitung>, world, and <galpi>, great war: a world war; a number or ordinal follows, as in {leitung galpi nihna}, the Second World War) (r:zd:22046/zd:17990) (q:draft)
leitung gambup = (i:1) (t:n) (f:everyday/media) (w:the whole world/worldwide) (d:<leitung>, world, and <gambup>, the whole land: the whole world; mostly with <ah> as {leitung gambup ah}, worldwide, in all the world, before a statement of rank or number) (r:zd:24500/zd:24369) (q:draft)
leitung khantohna = (i:1) (t:n) (f:social/politics) (w:progress of the world/modern development/worldly advancement) (d:<leitung>, world, and <khantohna>, progress: the advance of the modern world in knowledge, technology and living, the progress of the times; often followed by <tawh> or <hang>, in keeping with it or because of it) (r:zd:24022/ts:3375/zd:9447) (q:draft)
leitung khuahun = (i:1) (t:n) (f:politics/nature) (w:world situation/world affairs/global climate) (d:<leitung>, the world, and <khuahun>, weather or the state of things: the condition of the world, either the course of world affairs, as in {leitung khuahun luanzia}, or the climate of the earth, as in {leitung khuahun kikhelna}, climate change) (r:zd:23992/zd:23729) (q:draft)
leitung pilna = (i:1) (t:n) (f:education) (w:secular knowledge/science/worldly learning) (d:<leitung>, the world, and <pilna>, knowledge or wisdom: the learning of the world, that is science and school education, often set against the knowledge of God or against money) (r:zd:9430/zd:16254) (q:draft)
leitung tangthu = (i:1) (t:n) (f:education/social) (w:world history/history of the world) (d:<leitung>, the world, and <tangthu>, story or history: the history of the world; often followed by <ah> or <sungah>, in world history) (r:zd:20667/zd:26026) (q:draft)
leitungaa = (i:1) (t:phrase) (f:everyday/social) (w:of the world/in the world) (d:<leitung>, world, with <aa>, of, written as one word: belonging to or found in the world, as in {leitungaa mihau belpa}, the richest man in the world) (j:leitung/aa) (r:zd:22922/zd:19683) (q:draft)
leitungbupah = (i:1) (t:adv) (f:everyday/nature) (w:in the whole world/worldwide) (d:<leitungbup>, the whole world, and <ah> written as one word: in or throughout the whole world) (j:leitungbup/ah) (r:zd:24116/zd:23957) (q:draft)
leitungbuppi = (i:1) (t:n) (f:everyday/social) (w:the whole world/all the world) (d:<leitung> and <buppi> written as one word: the whole world, all its countries and people) (s:leitungbup) (j:leitung/buppi) (r:zd:23821/zd:15637/zd:23975) (q:draft)
leitunghun = (i:1) (t:n) (f:time/religion) (w:time of the world/age of the world) (d:<leitung>, world, and <hun>, time, written as one word; {leitunghun bei} is the end of the world) (j:leitung/hun) (r:zd:15382/zd:15294) (q:draft)
leitungin = (i:1) (t:phrase) (f:everyday/social) (w:the world/the whole world) (d:<leitung> and <in> written as one word: the world or the people of the world as the doer of the action) (j:leitung/in) (r:zd:23754/zd:19168) (q:draft)
leitungpi = (i:1) (t:n) (f:nature) (w:the earth/planet earth/the whole world) (d:<leitung>, earth, with <pi>, great: the earth as a whole, the globe) (j:leitung/pi) (r:zd:23823/zd:22557) (q:draft)
leitungthu = (i:1) (t:n) (f:social/religion) (w:worldly matters/secular affairs/world affairs) (d:<leitung>, world, and <thu>, matter, written as one word: the affairs of this world, set against {kha thu}, spiritual matters, and {vantungthu}, heavenly matters) (j:leitung/thu) (r:zd:22046/zd:25790) (q:draft)
leizon = (i:1) (t:v) (f:everyday) (w:search out/hunt for/comb) (d:search a place or a matter thoroughly for something, as rescuers for survivors or a critic for faults) (r:zd:20401/zd:21219) (q:draft)
lek = (i:2) (t:v) (f:education/media) (w:translate/render/draw out) (d:with <khia> or <khiat>, {lek khia}: turn a text or word out of another language or source into one's own, or bring out its meaning; not the weighing sense) (r:zd:16856/zd:17639) (q:draft, low confidence)
lekkim = (i:1) (t:adj) (f:everyday) (w:balanced/even/fair) (d:in balance, giving each side its due weight; also with the prefix, <kilekkim>) (s:kilekkim) (r:zd:19662/zd:26943) (q:draft, low confidence)
leklak = (i:1) (t:adv) (f:everyday) (w:suddenly/all at once) (d:placed after a verb for something that happens or is felt abruptly, as in {phawk leklak}, realise all at once) (r:zd:15571/zd:22059) (q:draft, low confidence)
lel = (i:2) (t:v) (f:everyday/social) (w:lose/be defeated) (d:lose to an enemy or an opponent, the opposite of <zo>, win; {gal lel} is lose a war; the form <lelh> is used before some endings) (s:guallel/kizo) (a:zo/gualzo) (q:draft)
lelah = (i:1) (t:conj) (f:everyday) (w:when/if) (d:<le>, if or when, and the emphatic <lah> written as one word after a verb or clause: when that is so, then; used in proverbs that set one case against another) (j:le/lah) (r:zd:19441/zd:14861) (q:draft, low confidence)
lelding = (i:1) (t:part) (f:everyday) (w:will just/will simply) (d:<lel>, merely, and <ding>, will, written as one word after a verb: will just do so, will simply happen) (j:lel/ding) (r:zd:17395/zd:10687) (q:draft)
lelhi = (i:1) (t:phrase) (f:everyday) (w:it is just so/merely) (d:<lel>, only or merely, and the sentence ending <hi> written as one word: ends a statement, it is just that and nothing more) (j:lel/hi) (r:zd:19474/zd:17437) (q:draft)
lellel = (i:1) (t:adv) (f:everyday/social) (w:mere/merely/just) (d:<lel>, only, said twice, placed after a noun: a mere one, nothing more than that, often belittling, as in {numei lellel}, just a woman) (b:lel) (r:zd:16757/zd:19166) (q:draft)
lem = (i:2) (t:v) (f:everyday) (w:be convenient/be suitable/suit/work out) (d:be convenient, fitting or workable, said of a time, a plan or an arrangement, as in {hun lem}, a suitable time, and {lem lo}, it does not work; not repair) (r:ts:6525/zd:19516/ts:2731) (q:draft)
lemkik = (i:1) (t:v) (f:social/politics) (w:set right again/restore/reconcile) (d:<lem> and <kik> written as one word: put right again what was spoiled; after <ki>, be reconciled again) (j:lem/kik) (r:zd:24490/zd:25687) (q:draft, low confidence)
lemlam = (i:1) (t:adv) (f:everyday) (w:blankly/wide-eyed) (d:descriptive word placed after <en>, look, or <hak>, be awake: with the eyes open and fixed, staring without a word) (r:zd:22773/zd:15571) (q:draft, low confidence)
lemlem = (i:1) (t:v) (f:everyday/education) (w:leaf through/turn over/browse) (d:turn the pages of a book or newspaper one after another, look through it) (r:zd:23240/zd:9138) (q:draft, low confidence)
lemlo = (i:1) (t:adj) (f:everyday) (w:not convenient/not suitable/not workable) (d:<lem>, here be convenient or fitting, and <lo>, not, written as one word; after a verb with <ding>, it is not convenient or not possible to do it) (j:lem/lo) (r:zd:24594/ts:7133) (q:draft)
lemloh = (i:1) (t:adj) (f:everyday) (w:not convenient/not workable/not working out) (d:form of <lemlo>, not convenient, used before words such as <ciangin>, <hangin> and <hun>: when a thing does not work out or does not suit) (b:lemlo) (r:zd:22582/zd:22897) (q:draft)
lemlohna = (i:1) (t:n) (f:social) (w:disagreement/difficulty/inconvenience) (d:<lem>, go well or be agreeable, with <lohna>: something that does not go well, a disagreement between people or a difficulty that hinders a plan; {ki lemlohna} is discord between people) (r:zd:11504/zd:23594/zd:15023) (q:draft)
lemlote = (i:1) (t:n) (f:everyday) (w:those unable/those for whom it does not work out) (d:<lem>, here be convenient or work out, with <lote> written as one word: those for whom something is not possible or does not go well) (j:lem/lote) (r:zd:23709) (q:draft, low confidence)
lemmahmah = (i:1) (t:adj) (f:everyday) (w:very convenient/very handy) (d:<lem>, convenient or suitable, and <mahmah>, very, written as one word: very convenient, working out very well for a purpose) (j:lem/mahmah) (r:zd:14763/zd:13346/zd:22107) (q:draft)
lemna = (i:1) (t:n) (f:social) (w:peace/reconciliation) (d:being on good terms with one another; mostly written after <ki> as {ki lemna}, which is <kilemna>; {lemna bawl} is make peace) (s:kilemna) (r:zd:23984/zd:20682/zd:21125) (q:draft)
lemon = (i:1) (t:n) (f:food) (w:lemon) (o:English) (r:zd:24319/zd:21417) (q:draft)
lempen = (i:1) (t:adj) (f:everyday) (w:most suitable/most convenient/best fitting) (d:<lem>, here suit or be convenient, with <pen> as the superlative ending: the one that suits best; with <tawh>, suit someone best) (r:zd:20197/zd:11798) (q:draft)
lemsak = (i:1) (t:v) (f:social) (w:settle/put right/reconcile) (d:make a matter or a relation come right: settle a difficulty, and with <ki> be reconciled or brought to agree) (r:zd:22484/zd:15073) (q:draft, low confidence)
lemtang = (i:1) (t:adj) (f:everyday) (w:convenient/smooth/favourable/go well) (d:working out easily and without hindrance, of a time, a plan or an affair; also as a verb, go well, become easy) (r:zd:12567/zd:10743/zd:20899) (q:draft)
lemthei = (i:1) (t:v) (f:everyday/social) (w:suit/fit/be able to agree) (d:<lem>, here fit or agree, and <thei>, able, written as one word: be suitable for someone or something, marked by <tawh>, and of people, be able to agree) (j:lem/thei) (r:zd:17152/zd:22157) (q:draft, low confidence)
lemtuah = (i:1) (t:v) (f:social/politics) (w:reconcile/mediate/bring to agreement) (d:bring people or differing aims into agreement, settle a dispute between them; {ki lemtuah} is come to terms with one another) (r:zd:12466/ts:7133) (q:draft)
lemzaw = (i:1) (t:adj) (f:everyday) (w:more convenient/easier/handier) (d:<lem>, here convenient or suitable, and <zaw>, more, written as one word; the Bible text has <lem> only in the sense repair) (j:lem/zaw) (r:zd:24765/zd:25824/zd:12441) (q:draft)
len = (i:2) (t:v) (f:travel/everyday) (w:fly) (d:a form of <leng>, fly, used before <theih> and after the prefix <a>; {na len theih kei leh} is if you cannot fly, and it is not {len} hold) (r:zd:9430) (q:draft, low confidence)
leng hoih = (i:1) (t:phrase) (f:everyday) (w:it is good to/it would be good if/should) (d:<leng>, if, and <hoih>, good: placed after a verb to give advice, it is good to do so, one should do so; {kei leng hoih} after the verb advises against it, and {leng hoih pen hi} is it is best to) (r:zd:21417/zd:22413/zd:25909) (q:draft)
leng kilawm = (i:1) (t:phrase) (f:everyday) (w:it would be fitting to/ought to/might well) (d:<leng>, if I or if we, and <kilawm>, fitting: placed after a verb, it would be right or likely that I or we do so, I had better, I may well; often followed by <sa> and <ing>, I think it fitting) (r:zd:21925/zd:23037) (q:draft, low confidence)
lengding = (i:1) (t:v) (f:travel) (w:will fly/to fly/to depart by plane) (d:<leng>, fly, and <ding> written as one word: will fly, said of an aircraft and of people about to leave by plane, especially refugees leaving for resettlement abroad) (r:zd:21918/zd:14887) (q:draft, low confidence)
Lenggeng = (i:1) (t:name) (c:place) (f:travel/politics) (w:Lenggeng) (d:town in the state of Negeri Sembilan, Malaysia, known for its immigration detention camp) (r:zd:17731/zd:22074) (q:draft)
lengkhawm = (i:1) (t:v) (f:nature/social) (w:fly together/soar together) (d:<leeng>, fly, in a shorter spelling, with <khawm>, together: fly together, and in a figure keep pace with others) (r:zd:24079/zd:21358) (q:draft, low confidence)
lengkhia = (i:3) (t:v) (f:everyday) (w:fly out/jump out/fly off) (d:fly or leap, with <khia>, out: fly out or off, said of a bird leaving a tree, of a person who jumps from a building, with <panin>, and of a thing thrown off by wind or force) (r:zd:21118/zd:13009/zd:18152) (q:draft)
lengkhiading = (i:1) (t:v) (f:travel) (w:will take off/will fly out) (d:<lengkhia> with <ding>, will, written as one word; here in the sense fly off: of an aircraft or a traveller, will depart by air; also be about to leap out) (j:lengkhia/ding) (r:zd:13157/zd:11627) (q:draft)
lengkhiakik = (i:1) (t:v) (f:travel) (w:take off again/fly out again) (d:<leeng>, fly, with <khia> and <kik> written as one word: of an aircraft or its passengers, fly out again, depart again) (j:leeng/khia/kik) (r:zd:16085/zd:17919/zd:10812) (q:draft)
lengkhiasuak = (i:1) (t:v) (f:travel) (w:fly out/shoot out) (d:<leeng>, fly, with <khia> and <suak> written as one word: of a vehicle, fly or shoot right out of a building or off the road) (j:lengkhia/suak) (r:zd:12157/zd:14873) (q:draft, low confidence)
lengla = (i:1) (t:n) (f:social) (j:leengla) (r:zd:25178/zd:25192/zd:22773) (q:draft)
lenglang = (i:1) (t:adv) (f:everyday) (w:dangling/hanging loose/swinging) (d:describes a thing that hangs free in the air, mostly after <kikhai>: {kikhai lenglang} is hang dangling) (r:zd:19763/zd:14662) (q:draft)
lengleng = (i:1) (t:v) (f:travel/nature) (w:fly about/keep flying) (d:the verb <leng>, fly, also written <leeng>, said twice: fly on and on or fly about) (r:zd:25346) (q:draft)
lengleng = (i:2) (t:adv) (f:everyday) (w:trailing along/dangling/on and on) (d:placed after a verb such as <zui>, follow, <kai>, pull, <kikhai>, hang, or <pai>, go: the action goes on in a trailing or dangling way) (r:zd:20942/zd:14591) (q:draft, low confidence)
lengmaw = (i:1) (t:n) (c:plant) (f:food/nature) (w:orange) (d:the orange tree and its fruit; also the colour orange) (r:zd:24276/zd:17450) (q:draft)
lengna = (i:1) (t:n) (f:social/home) (w:guest/visitor) (d:one who comes to a house on a visit) (s:leengla/zin) (r:zd:24365/zd:12479) (q:draft)
lengnakhan = (i:1) (t:n) (f:home) (w:living room/sitting room) (d:the room of a house where people sit and guests are received; written beside the English {living room}) (r:zd:12565/zd:11285) (q:draft)
lengsak = (i:1) (t:v) (f:everyday/family) (w:make wistful/stir longing/make nostalgic) (d:with <lung>, heart, as {lung hong lengsak}: make the heart wander, cause one to feel longing or homesickness; compare <lungleng>) (r:zd:21259/zd:11347) (q:draft)
lengsak = (i:2) (t:v) (f:travel) (w:fly/let fly/operate a flight) (d:cause to fly, <leeng>: of an airline, fly its planes to a place) (r:zd:23603) (q:draft, low confidence)
Lengthe = (i:1) (t:n) (c:animal) (f:nature) (w:cicada) (d:an insect that sings loudly at dusk; {Zo Lengthe} is the name of the clock tower of Tedim, see <Zolengthe>, and of a Zomi singing contest) (r:zd:19381/zd:11510) (q:draft, low confidence)
lengthei = (i:1) (t:v) (f:travel) (w:be able to fly/can fly) (d:<leng>, fly, and <thei>, able, written as one word: be able to fly, also of people travelling by plane) (j:leng/thei) (r:zd:16210/zd:11197) (q:draft)
lengthei = (i:2) (t:n) (f:travel) (w:aircraft/flying craft) (d:a thing that can fly, such as a plane or a balloon) (j:leng/thei) (r:zd:17293) (q:draft, low confidence)
lengtheilo = (i:1) (t:v) (f:travel) (w:cannot fly/be unable to fly) (d:<lengthei>, be able to fly, with <lo>, not, written as one word: of a plane, be unable to fly; of people, be unable to fly to another country) (j:lengthei/lo) (r:zd:17622/zd:11335) (q:draft)
Lengtonghoih = (i:1) (t:name) (f:social/media) (w:Lengtonghoih) (d:the famous beautiful girl of a Zomi folk tale, the only sister of seven brothers who gave her all she wished for; also the name of a music group founded in Manipur) (r:zd:24854/zd:22911) (q:draft, low confidence)
lenkawm = (i:1) (t:v) (f:everyday/body) (w:while holding/holding) (d:<len>, hold, and <kawm>, while, written as one word: holding something in the hand while doing something else) (j:len/kawm) (r:zd:15727/zd:14935) (q:draft)
lenkha = (i:1) (t:v) (f:everyday/body) (w:catch hold of/grab) (d:<len>, grasp, with <kha>, happen to: happen to catch hold of something, often while falling) (j:len/kha) (r:zd:20440/zd:15505) (q:draft)
lenlai = (i:1) (t:n) (f:time/social) (w:youth/young days) (d:a word of songs and poems for youth, the time of being young, and for the young; one writer explains it as <khangno>, the young men and young women) (r:zd:12292) (q:draft, low confidence)
lenlan = (i:1) (t:adv) (f:everyday) (w:just/merely/idly) (d:placed after a verb: do only that and nothing more, without care or effort, as in {om lenlan}, just stay there; often said in reproach) (r:zd:19790/zd:15946) (q:draft, low confidence)
lenlo = (i:1) (t:v) (f:everyday) (w:not hold/not take/not pick up) (d:<len>, hold or take, and <lo>, not, written as one word: not hold or handle a thing, and of a phone, not answer) (j:len/lo) (r:zd:17345/zd:14883) (q:draft)
lenna = (i:1) (t:n) (f:travel) (w:flight/flying) (d:<leeng>, fly, with the noun suffix <na>: flying, a flight; {vanleng lenna} is the flight of an aircraft) (r:zd:22658) (q:draft, low confidence)
lenna = (i:2) (t:n) (f:everyday/social) (w:place of stay/haunt/abode) (d:the place where someone stays or moves about, often in songs: {ka lenna} is the place where I am staying) (r:zd:23828/zd:20131) (q:draft, low confidence)
LenNupa = (i:1) (t:name) (c:place) (f:politics/travel) (w:Lennupa) (d:a scenic place in the land of Kaptel village in the Tedim area of Chin State, mostly written {Lennupa}; the Falam side calls it Buannel and the boundary there is disputed) (r:zd:20550/zd:20513/zd:22547) (q:draft)
lent = (i:1) (t:n) (f:religion/time) (w:Lent) (d:the Christian season of fasting before Easter; {Lent hun} is the time of Lent) (o:English) (r:zd:23784) (q:draft, low confidence)
Lentang = (i:1) (t:name) (c:khua) (f:travel) (w:Lentang) (d:a village and ridge in the Tedim area of Chin State, on a road route toward the India border) (r:zd:20406) (q:draft, low confidence)
lentheih = (i:1) (t:v) (f:travel) (w:be able to fly/can fly) (d:<len>, the form of <leng>, fly, with <theih>, be able, written as one word; {lentheih nading} is so that one can fly) (r:zd:15773/zd:17941) (q:draft)
leptuah = (i:1) (t:v) (f:social) (w:settle/reconcile/negotiate/resolve) (d:put right a quarrel or a matter that is at odds, bring two sides or two things into agreement) (r:zd:16900/zd:25461/ts:7133) (q:draft)
leptuahna = (i:1) (t:n) (f:social/politics) (w:mediation/reconciliation/settlement) (d:<leptuah>, settle or reconcile, with the noun suffix {-na}: the settling of a dispute between two sides) (b:leptuah) (r:ts:4831/zd:21594) (q:draft)
lesbian = (i:1) (t:n) (f:social) (w:lesbian) (d:a woman who is attracted to women; mostly written with a capital letter and often added to explain {numei leh numei}) (o:English) (r:zd:19472) (q:draft, low confidence)
lesson = (i:1) (t:n) (f:education/everyday) (w:lesson) (d:something learned from an event or from experience; {lesson la} is learn a lesson) (o:English) (r:zd:22492/zd:20260) (q:draft)
let = (i:4) (t:v) (f:education/media) (w:translate/render) (d:turn a text into another language, often with <kik> or with the language and <tawh>: {Zolai tawh let} is translate into Zolai; not {let} of water overflowing and not hold) (s:Lailet) (r:zd:21159/zd:24192) (q:draft)
letkhan = (i:1) (t:v) (f:work/social) (w:accept/receive) (d:accept or take in what is handed over, such as money or a guest) (o:Burmese, let khan) (r:zd:24322) (q:draft, low confidence)
letkhia = (i:2) (t:v) (f:education/media) (w:translate/render) (d:put a text into another language, after the name of the language with <tawh> or <ah>, as {Zolai tawh letkhia}, translate into Zolai; the other sense is of water spilling over) (s:teikhia) (r:zd:17841/zd:24303/zd:17826) (q:draft)
letkhiatna = (i:1) (t:n) (f:religion/education) (w:translation) (d:the turning of a text into another language, in {Lai Siangtho letkhiatna}, Bible translation) (r:zd:24447) (q:draft, low confidence)
letkik = (i:1) (t:v) (f:education/media) (w:translate/render) (d:<let>, here turn over, and <kik>, back, written as one word: put a text from another language into Zolai) (j:let/kik) (r:zd:21258/zd:19295) (q:draft)
letmat = (i:2) (t:n) (f:work) (w:signature) (d:a name signed by hand on a document; {letmat thuh} is to sign and {thukimna letmat thuh} is to sign an agreement; not the measure of length) (r:zd:22586/zd:21547) (q:draft)
letmat = (i:3) (t:n) (f:travel) (w:ticket) (d:a ticket for a journey, after the word for the vehicle; {vanleng letmat} is an air ticket and {meileng letmat} is a train ticket) (r:zd:21989/zd:20752) (q:draft)
letna = (i:2) (t:n) (f:education/religion) (w:translation/translating) (d:<let> in the sense of turn into another language, with the noun suffix <na>: the work of translating, after <Laisiangtho>, the Bible, or <kampau>, speech; no holding with the hand is meant) (r:zd:24289) (q:draft, low confidence)
Letpanchaung = (i:1) (t:name) (c:khua) (f:travel) (w:Letpanchaung) (d:a village in Kalay Township in Sagaing Region of Myanmar) (o:Burmese) (r:ts:4491/zd:19624) (q:draft)
letsak = (i:1) (t:v) (f:everyday/body) (w:take hold of/grab/grasp) (d:<let>, a form of <len>, hold, with <sak>: take hold of something of another person, such as the hand, or seize a thing from someone) (j:let/sak) (r:zd:20944/zd:12021) (q:draft)
letsong = (i:1) (t:n) (f:social) (w:gift/present) (d:something given to honor or please a person; {letsong pia} is give a gift) (s:piakkhong) (r:20.18.16) (q:draft)
lettama = (i:1) (t:n) (f:work) (w:carpenter/carpentry) (d:a carpenter, a man who builds with wood, and also his trade; named together with {pazaan} or {payan}, mason) (s:khutsiampa) (o:Burmese, lethama) (r:zd:23428/zd:20902) (q:draft)
letterhead = (i:1) (t:n) (f:work/social) (w:letterhead) (d:the printed heading of the paper on which an organisation writes its letters, with its name and logo) (o:English) (r:zd:24462) (q:draft)
leu = (i:1) (t:adv) (f:everyday) (w:again/in turn) (d:written twice after a verb, {leu leu}, which is <leuleu> written as two words: again, in turn) (r:zd:11323/zd:11367/zd:23037) (q:draft)
leuh = (i:1) (t:conj) (f:everyday) (w:if) (d:<le>, if, and the plural marker <uh> written as one word: if you or they, of several people; often followed by <cin>; at the end of a sentence, if only they would) (j:le/uh) (r:zd:21590/zd:19166) (q:draft)
leulau = (i:1) (t:adv) (f:everyday) (d:descriptive word placed after a verb: lying or left there limp and still, said of a body lying on the ground, a part cut off or a vehicle overturned) (r:zd:14689/zd:22267) (q:draft, low confidence)
leuleu = (i:1) (t:adv) (f:everyday) (w:again) (d:placed after a verb: once more, another time) (s:kik/kikkik)
leuleuding = (i:1) (t:adv) (f:everyday/time) (w:will again/will in turn) (d:<leuleu> and <ding> written as one word after a verb: the action will happen once more, or in its turn) (j:leuleu/ding) (r:zd:12271/zd:20387/zd:11997) (q:draft)
level = (i:1) (t:n) (f:politics/education) (w:level/rank/grade) (d:a level in an order of ranks or grades, as of government, of an organisation or of study; mostly after the word that names it, as in {State level}) (o:English) (r:zd:22586/zd:16442/zd:25130) (q:draft)
Lezang = (i:1) (t:name) (c:khua) (f:travel) (w:Lezang) (d:a Zomi village, listed with villages of the Tedim and Tonzang area of Chin State; written after the name of a person to show the home village) (r:zd:21182) (q:draft)
lezong = (i:1) (t:conj) (f:everyday) (w:even if/even though/although) (d:<le>, if, and <zong>, also, written as one word after the verb of a clause: even if, even though) (j:le/zong) (r:zd:13340/zd:21351/zd:24276) (q:draft)
Lia = (i:1) (t:n) (f:social) (w:Miss) (d:title written before the name of a girl or an unmarried young woman, as {Tg} is written before the name of a young man) (r:zd:24349/zd:25288) (q:draft)
liailiai = (i:2) (t:adv) (f:social/everyday) (w:together/all together/side by side) (d:after <khawm>, together, and after verbs of what a group does: pictures many acting closely together, one with another, with no thought of difficulty; {sem khawm liailiai} is working all together) (r:zd:11548/zd:24199/zd:14930) (q:draft)
liamding = (i:1) (t:v) (f:health) (w:be injured/probably injured) (d:<liam>, be injured, and <ding> written as one word; after a number of people in a report: that many are said or expected to be injured) (j:liam/ding) (r:zd:21330/zd:18024) (q:draft, low confidence)
liamgawpna = (i:1) (t:n) (f:health/body) (w:injury/serious injury) (d:<liamgawp>, be badly wounded, with the noun suffix <na>: an injury, mostly in {bangmah liamgawpna omlo}, without any injury) (b:liamgawp) (r:zd:14687/zd:19465) (q:draft)
liamhi = (i:1) (t:v) (f:health/media) (w:be injured/be wounded) (d:<liam> and the sentence ending <hi> written as one word: was injured) (j:liam/hi) (r:zd:19745/zd:19351) (q:draft)
liamlawhgawp = (i:1) (t:v) (f:health) (w:be badly injured/get hurt badly) (d:<liamlawh>, get hurt as a result, with <gawp>, severely, written as one word: be injured, often many people at once, in an accident or attack) (j:liamlawh/gawp) (r:zd:12972/zd:17558) (q:draft)
liamliam = (i:1) (t:adv) (f:everyday) (w:barely/only just/narrowly) (d:placed after a verb: the thing does happen, but only just, with nothing to spare; {suakta liamliam} is escape narrowly) (r:zd:16245/zd:25105/zd:20264) (q:draft)
liamna ngah = (i:1) (t:v) (f:health/politics) (w:be wounded/be injured/get hurt) (d:<liamna>, a wound, and <ngah>, get: receive an injury, be wounded in fighting or in an accident; stands after the person or the number of persons hurt, and reports set it beside <si>, die) (s:liam) (r:zd:17703/zd:11229/ts:10413) (q:draft)
liamngawh = (i:1) (t:v) (f:health) (w:be seriously injured/be badly hurt) (d:be wounded severely; said of the injured in accidents and attacks) (b:liam) (r:zd:14509/zd:14899/zd:12405) (q:draft)
liamsan = (i:1) (t:v) (f:social) (w:pass away/depart) (d:<liam>, here go out of sight, with <san>, leaving others behind; in {mual hong liamsan}, has gone beyond the hill and left us, a respectful way of saying that someone has died, see <mualliam> and <liamsanta>) (r:zd:17309/zd:9441) (q:draft)
liamsanta = (i:1) (t:v) (f:social) (w:pass away) (d:<liam>, here go out of sight, with <san>, here leaving others behind, and <ta>, now; in {mual liamsanta}, has gone beyond the hill and left us, a respectful way of saying that someone has died) (r:zd:10688) (q:draft)
lian = (i:1) (t:adj) (f:everyday) (w:large) (d:big in size) (s:gol/lianpi) (a:neu)
liana = (i:1) (t:adv) (f:everyday) (w:exactly/just/precisely) (d:<lian>, exactly, with a following <a>, placed after the word it stresses: {ahi bang liana} is exactly as it is; the same spelling is also part of personal names) (r:zd:24303/zd:24029) (q:draft, low confidence)
lianbek = (i:1) (t:adv) (f:everyday) (w:only exactly/nothing but) (d:<lian>, exactly, with <bek>, only, written as one word, after a noun: that very thing and nothing else) (r:zd:20358/zd:20454) (q:draft, low confidence)
lianding = (i:1) (t:adv) (f:everyday/time) (w:just about to/on the point of) (d:placed after a verb, formed with <ding>, will: on the very point of doing or suffering something; {alenkhia lianding} is just about to take off) (r:zd:13030/zd:16164/zd:12061) (q:draft, low confidence)
lianga = (i:1) (t:adv) (f:everyday) (w:to the point of/so much that) (d:<liang>, even, with the linking <a>, written as one word after a verb or clause: to the point of, so far that; {ihmu lo lianga} is to the point of not sleeping) (j:liang/a) (r:zd:10963/ts:4831/zd:26585) (q:draft)
liangaa = (i:1) (t:adv) (f:everyday) (w:even/to the point of) (d:<liang>, even, so much as, with the linking <aa>, written as one word: so much that, to the extent of) (j:liang/aa) (r:zd:20545/zd:20627) (q:draft, low confidence)
liangding = (i:1) (t:adv) (f:everyday) (w:to the point of/so much as to) (d:<liang.2>, even, and <ding> written as one word, mostly as {liangding in} after a verb: so far as to do it; {sihlawh liangding} is so as to die of it) (j:liang/ding) (r:zd:15437/zd:15260) (q:draft)
liangdingin = (i:1) (t:adv) (f:everyday) (w:to the point of/so much as to) (d:<liangding> and <in> written as one word after a verb: so badly or so far as to, as in {sihlawh liangdingin}, to the point of dying of it) (j:liangding/in) (r:zd:18129/zd:13114) (q:draft)
lianghi = (i:1) (t:part) (f:everyday) (d:<liang> even, to the point of, and the sentence ending <hi> written as one word at the end of a sentence: it went so far as that, said with surprise or emphasis) (j:liang/hi) (r:zd:19127/zd:15387) (q:draft)
liangko kikim = (i:1) (t:phrase) (f:social/politics) (w:equality/on equal footing/equal standing) (d:<liangko>, shoulder, and <kikim>, equal: with shoulders level, an idiom for equality of rank and rights between peoples or between women and men; with <in>, <zahin> or <takaa> after it, on an equal footing) (r:zd:20930/zd:19612/zd:20772) (q:draft)
liangvai = (i:1) (t:adj) (f:social) (w:poor/destitute) (d:poor and helpless; a word of songs and poetic speech) (s:zawng) (r:ts:3369) (q:draft, low confidence)
lianin = (i:2) (t:adv) (f:everyday/time) (w:exactly/precisely/right) (d:<lian> in its meaning exact, with the linking ending <in>: exactly or precisely, after a word of time or manner and not about size; {tu lianin} is right now and {bang lianin} is exactly as) (r:zd:10817/zd:9256/zd:25454) (q:draft)
lianleh = (i:1) (t:conj) (f:everyday/time) (w:as soon as/just as/the moment) (d:<lian>, here just or exactly, and <leh>, when, written as one word after a verb: at the very moment that the action happens) (j:lian/leh) (r:zd:17992/zd:14523/zd:20104) (q:draft)
lianlian = (i:2) (t:adv) (f:everyday) (w:exactly/precisely/just) (d:after <bang>, like, or a word of time: exactly so, to the letter, on the dot; {a kammal bang lianlian} is exactly as the words say, and {a hun lianlian in} is exactly on time) (r:zd:21388/zd:16989) (q:draft, low confidence)
lianlo = (i:1) (t:adv) (f:everyday) (w:not exactly/not quite/not really) (d:<lian> and <lo>, not, written as one word after a verb: not exactly, not quite, not really so; <lian> is here the word that stresses exactness, not the word for large) (j:lian/lo) (r:zd:15636/zd:23904/zd:8668) (q:draft)
lianloh = (i:1) (t:adv) (f:everyday) (w:not exactly/not quite/not really) (d:<lian> and <loh>, not, written as one word after a verb: the form of <lianlo> used before <hangin> and before a noun, not exactly, not really so) (j:lian/loh) (r:zd:22913/zd:21706) (q:draft)
lianmahmah = (i:1) (t:adj) (f:everyday) (w:very large/huge/very serious) (d:<lian>, large, and <mahmah>, very, written as one word and placed after the noun: very big, or of a matter or injury very serious) (j:lian/mahmah) (r:zd:12194/zd:12854/zd:12290) (q:draft)
liann = (i:1) (t:adv) (f:everyday) (w:exactly/just/right) (d:placed after a verb or phrase for emphasis: exactly so, right then; a lengthened spelling of the emphatic adverb usually written with one n, compare <lianlian>) (r:zd:20545/zd:19166) (q:draft, low confidence)
lianpenpen = (i:1) (t:adj) (f:everyday) (w:the very largest/the very greatest/biggest of all) (d:<lian>, large or great, and <penpen>, the very most, written as one word) (j:lian/penpen) (r:zd:13169/zd:22650) (q:draft)
lianpikhat = (i:1) (t:phrase) (f:everyday) (w:a big/a great/a major) (d:<lianpi>, great, and <khat>, one, written as one word after a noun: a big one, a great one) (j:lianpi/khat) (r:zd:17607/zd:11988/zd:12685) (q:draft)
lianpitak = (i:1) (t:adj) (f:everyday) (w:very great/very large/huge) (d:<lianpi>, great, with the strengthening <tak>, written as one word; also as an adverb, greatly) (j:lianpi/tak) (r:zd:25060/zd:12510) (q:draft)
Lianpitawh = (i:1) (t:phrase) (f:social) (w:with great/with much) (d:<lianpi>, great, and <tawh>, with, written as one word after a noun: {dahpihna lianpitawh}, with deep sympathy, closes a message of condolence, and {zahtakna lianpitawh} is with great respect) (j:lianpi/tawh) (r:zd:20782) (q:draft)
Liaoning = (i:1) (t:name) (c:land) (f:travel/politics) (w:Liaoning) (d:a province in the north-east of China; also the name of a Chinese aircraft carrier) (r:zd:21274/zd:14904) (q:draft)
liap = (i:1) (t:v) (f:nature) (w:be shaded/be hidden from view) (d:be covered or screened off, as a place the sun does not reach: {ni liap na mun} is a shaded place) (r:zd:20959) (q:draft, low confidence)
liatkhit = (i:1) (t:v) (f:family/time) (w:have grown up/after growing up) (d:<liat>, become big, and <khit>, after, written as one word: {i liatkhit ciangin} is when we have grown up) (j:liat/khit) (r:zd:23443/zd:23616) (q:draft)
liausakding = (i:1) (t:v) (f:politics/work) (w:will be fined/will fine) (d:<liausak>, make pay a fine, and <ding>, will, written as one word; with <ki> before it, will be fined) (j:liausak/ding) (r:zd:15560/zd:18125) (q:draft)
liausakthei = (i:1) (t:v) (f:politics/work) (w:can be fined/may be made to pay) (d:<liausak>, make pay a fine, and <thei>, can, written as one word; mostly after <ki> and an amount: a fine of that sum can be imposed) (j:liausak/thei) (r:zd:16919/zd:15848) (q:draft)
liausumding = (i:1) (t:n) (f:politics/work) (w:fine to be paid) (d:<liausum> and <ding> written as one word: the fine that one will have to pay) (j:liausum/ding) (r:zd:13270) (q:draft)
Liberal = (i:1) (t:adj) (f:politics/religion) (w:liberal) (d:liberal in politics or in theology, the opposite of conservative; {liberal upna} is liberal belief) (o:English) (r:zd:23479/zd:21272/zd:22873) (q:draft)
Licence = (i:1) (t:n) (f:work/travel) (w:licence/permit) (d:an official paper that allows a person to do something, as drive a vehicle or run a business, the English word; {Driving Licence} is a driving licence) (o:English) (r:zd:20534/zd:11913/zd:16592) (q:draft)
license = (i:1) (t:n) (f:work/politics) (w:licence/permit) (d:an official paper that allows a person to do, keep or use something, also called <phalna>, permission) (o:English) (r:zd:16682/zd:14820) (q:draft)
Lieutenant = (i:1) (t:n) (f:politics) (w:lieutenant) (d:an army rank; also the first word of the rank Lieutenant Colonel) (o:English) (r:zd:25097/ts:4309) (q:draft)
lifestyle = (i:1) (t:n) (f:health/everyday) (w:lifestyle/way of life) (d:the way a person lives day by day, mostly said of habits that affect health; often written beside a Zolai wording such as {nisim omdaan}) (o:English) (r:zd:23594) (q:draft, low confidence)
Lift = (i:1) (t:n) (f:home/travel) (w:lift/elevator) (d:the machine that carries people up and down inside a tall building) (o:English) (r:zd:17143/zd:14954) (q:draft)
liimlangh = (i:1) (t:n) (f:home) (j:limlang) (r:zd:19423/zd:10777) (q:draft)
like = (i:1) (t:n) (f:it/media) (w:like) (d:a like given to a post or a page on Facebook and other social media; {like pia} is to give a like and {like ngah} to get one) (o:English) (r:zd:23148/zd:25139) (q:draft)
liklek = (i:1) (t:adv) (f:everyday) (w:brand/quite/very) (d:intensifying word placed after a describing word, most often <thak>, new: {thak liklek} is brand new; also {tom liklek}, very short) (r:zd:16724/zd:22040) (q:draft)
likliak = (i:1) (t:adv) (f:everyday) (w:forlornly/wretchedly/pitifully) (d:placed after a verb: in a poor, thin or forlorn state that moves one to pity, as in {nungta likliak}, live on meagrely) (r:zd:25068/zd:22470) (q:draft, low confidence)
Lillehammar = (i:1) (t:name) (c:city) (f:travel) (w:Lillehammer) (d:Lillehammer, a town in Norway where some Zomi live; the usual spelling is Lillehammer) (r:zd:19826) (q:draft, low confidence)
lim = (i:4) (t:adj) (f:food) (w:delicious/tasty) (d:of food and drink: good to taste, as in {an lim}, delicious food; {lim sa} is find something tasty) (r:zd:19371/zd:23797/zd:23249) (q:draft)
lim = (i:5) (t:n) (f:everyday/social) (w:sign/token/mark) (d:something that shows a fact or a quality that cannot itself be seen, not a likeness or a picture; often at the end of a sentence, as {kiamsukna lim ahi hi}, it is a sign of decline) (r:zd:23556/zd:21081) (q:draft)
Limbang = (i:1) (t:name) (c:city) (f:travel) (w:Limbang) (d:town in the state of Sarawak in Malaysia) (r:zd:19529) (q:draft, low confidence)
limci = (i:2) (t:adj) (f:everyday/social) (w:promising/bright/fine/rich) (d:of things other than food: good and full of promise or blessing, most often in {maban limci}, a bright future, also of a plan, a gift or a relationship) (r:zd:25039/zd:24124/zd:22604) (q:draft)
limet = (i:1) (t:v) (f:media) (w:watch with interest/enjoy watching) (d:look at something with pleasure or close attention, <lim>, here well, with <et>, look; {ki limet mahmah} is it was much watched, said of a popular video) (r:zd:15579/zd:16410) (q:draft)
limetlua = (i:1) (t:v) (f:everyday/it/media) (w:watch too intently/be absorbed in watching) (d:<limet> and <lua> written as one word: look at something, mostly a phone, with too much attention) (j:limet/lua) (r:zd:17143/zd:14635) (q:draft)
limgen = (i:1) (t:v) (f:social/media) (w:emphasise/stress/speak much of) (d:speak of something earnestly and at length, give it weight; {ki limgen} is be much talked about) (r:zd:24396/zd:20771/zd:21803) (q:draft)
limit = (i:1) (t:n) (f:everyday) (w:limit) (d:the point or amount that may not be passed) (s:ciangtan) (o:English) (r:zd:20928/zd:21783) (q:draft)
limkansan = (i:1) (t:v) (f:politics/media) (w:investigate thoroughly/look into closely) (d:<lim>, here well or thoroughly, and <kansan>, investigate, written as one word: said of police and authorities following up a case with care) (j:lim/kansan) (r:zd:12327/zd:14848) (q:draft)
limkat = (i:1) (t:v) (f:health/everyday) (w:be badly burnt/burn severely) (d:be burnt by fire over much or all of a body or building, usually with <mahmah>, very; apparently built on <kat>, burn) (r:zd:13300/zd:19367) (q:draft, low confidence)
limkiatlua = (i:1) (t:v) (f:nature) (w:fall very heavily) (d:<lim>, here greatly, <kiat>, fall, and <lua>, too much, written as one word: fall in very great amount, said of snow in {vuuk limkiatlua}) (j:lim/kiat/lua) (r:zd:17657/zd:17622) (q:draft, low confidence)
limla = (i:1) (t:n) (f:religion/education) (w:symbol/sign/type/emblem) (d:a thing that stands for something else and shows what it is like) (r:zd:24064/zd:16951) (q:draft)
limlak = (i:1) (t:v) (f:media/social) (w:act/portray/show/demonstrate) (d:<lim>, image, with <lak>, show: show something as a picture of it, act a part on stage or in film, or show plainly by what one does) (r:zd:9222/zd:16640) (q:draft)
limlak = (i:2) (t:n) (f:media) (w:photo/picture) (d:a picture taken or shown of someone or something, a photograph) (s:lim) (r:zd:21365/ts:4134) (q:draft)
limlangh = (i:1) (t:n) (f:home) (j:limlang) (r:zd:20092/zd:23737) (q:draft)
limlim = (i:1) (t:part) (f:everyday) (w:whatsoever/at all/any) (d:placed after a noun or clause: any that is such, whatever is called so, without exception; after a verb it presses the statement, by all means, in every case) (r:zd:14704/zd:12998/zd:22860) (q:draft)
limlimin = (i:1) (t:adv) (f:everyday) (w:from the very first/at the very moment/to begin with) (d:<limlim> with <in>, written as one word: after a clause of beginning, as in {a suah tung limlimin}, right from the moment of birth; {a limlimin} is in the first place) (j:limlim/in) (r:zd:9136/zd:18040) (q:draft, low confidence)
limlo = (i:1) (t:adj) (f:food/health) (w:tasteless/not tasty/unappetising) (d:<lim> in its sense tasty, with <lo>, not: of food, not tasting good; {ankam limlo} is having no appetite, a sign of illness) (r:zd:12436/zd:24365/zd:22065) (q:draft)
limnawkkhak = (i:1) (t:v) (f:nature/travel) (w:hit hard/strike badly/crash into) (d:<nawkkhak>, run into or hit, with <lim> before it, here seemingly an intensifier: be hit hard, as by a storm, or crash hard into something) (j:lim/nawkkhak) (r:zd:16105/zd:17299) (q:draft, low confidence)
limnek = (i:1) (t:v) (f:food) (w:eat with relish/enjoy eating) (d:<nek>, eat, with a first part that means tasty, written as one word: eat something with enjoyment; compare <limsa>, find tasty) (j:lim/nek) (r:zd:19447/zd:24276) (q:draft)
limphutkhak = (i:1) (t:v) (f:travel) (w:crash hard/collide violently/hit hard) (d:<phutkhak>, run into, with an intensifying first part, hard: said of vehicles that hit something or each other with great force) (r:zd:15429/zd:11992) (q:draft)
limsiat = (i:1) (t:v) (f:everyday/travel) (w:be badly damaged/be wrecked) (d:be badly damaged, said of vehicles and buildings after a crash, fire or earthquake: <siat>, be ruined, with a first part that strengthens the verb, as in other words for severe harm) (r:zd:12113/zd:15089/zd:12837) (q:draft)
limsit = (i:1) (t:v) (f:politics/everyday) (w:inspect/check thoroughly/scrutinise/search) (d:examine closely and in detail, as officials check persons, luggage, phones or permits; with <sit>, examine) (r:ts:1846/zd:11535) (q:draft)
limsuai = (i:1) (t:v) (f:education/media) (w:draw/paint/sketch) (d:<lim>, picture, with <suai>, draw: make a picture or a plan by drawing or painting; {limsuai siam} is skilled at drawing, an artist) (r:zd:19166/zd:22988) (q:draft)
limsuai = (i:2) (t:n) (f:media/work) (w:painter/artist) (d:a person who draws or paints pictures) (r:zd:9264/zd:17466) (q:draft, low confidence)
limsuaih = (i:1) (t:n) (f:education/media) (w:painting/drawing) (d:the making of pictures as an art or skill, from <lim>, picture, and <suaih>, draw; {limsuaih siam} is a skilled painter, an artist) (r:zd:23037/zd:20317/zd:9264) (q:draft)
limsuaihna = (i:1) (t:n) (f:education/media) (w:painting/drawing/art of painting) (d:<limsuaih> with the noun ending {-na}: the making of pictures, or the work that is made; {limsuaihna innkhan} is a room for painting) (b:limsuaih) (r:zd:22116/zd:20224) (q:draft)
limtaka = (i:1) (t:adv) (f:everyday) (w:carefully/thoroughly/properly) (d:<limtak>, thoroughly, with the adverb ending {-a}: carefully, with full attention, the same as <limtakin>) (s:limtakin) (b:limtak) (r:zd:18958/zd:9231/zd:10938) (q:draft)
limtawh = (i:1) (t:phrase) (f:media) (w:with pictures/with the image) (d:<lim>, picture or image, and <tawh>, with, written as one word: with a picture, illustrated, or bearing the image of someone) (j:lim/tawh) (r:zd:15565/zd:17574) (q:draft)
limzat = (i:1) (t:v) (f:everyday) (w:use widely/use much/favour) (d:use a thing much and gladly; with <ki>, {ki limzat mahmah}, be very widely used, be popular) (r:zd:22686/ts:7364/zd:20920) (q:draft)
limzatluat = (i:1) (t:v) (f:everyday/it) (w:use too much/overuse) (d:<limzat> and <luat> written as one word: use a thing far too much, said of phones) (j:limzat/luat) (r:zd:12776/zd:14635) (q:draft)
limzatzaw = (i:1) (t:v) (f:everyday) (w:be used more/prefer to use) (d:<limzat> and <zaw> written as one word: use one thing more than another; with <ki>, be the more widely used) (j:limzat/zaw) (r:zd:12357/zd:11608) (q:draft)
limzaw = (i:1) (t:adj) (f:food) (w:tastier/more delicious) (d:<lim>, here tasty, and <zaw>, more, written as one word) (j:lim/zaw) (r:zd:21939/zd:20131) (q:draft)
line = (i:1) (t:n) (f:it/travel) (w:line/connection) (d:a telephone, power or pipe line, and the connection it gives: {phone line} is the telephone network; {Line Car} is a bus that runs a regular route) (o:English) (r:zd:22394/zd:15338/zd:24271) (q:draft)
ling = (i:2) (t:v) (f:everyday/nature) (w:tremble/shake/quake) (d:shake: of a person or a voice in fear, and of the earth in an earthquake; a spelling of <liing>, used as a verb after <a> or <hong> and before <keuhkeuh>) (s:liing) (r:zd:17828/zd:16832/zd:15338) (q:draft)
lingkik = (i:1) (t:v) (f:nature) (w:quake again/shake again) (d:<liing>, shake, spelled with a short vowel, with <kik>, again: said of the earth quaking once more, {zin lingkik}) (r:zd:20703/zd:17645) (q:draft)
lingpaak = (i:1) (t:n) (c:plant) (f:nature) (w:rose) (d:<ling>, thorn, with <paak>, flower: the rose, plant and flower) (r:zd:21092) (q:draft)
lingpak = (i:1) (t:n) (c:plant) (f:nature) (w:rose) (d:<ling>, thorn, with <pak>, flower: the rose) (j:ling/pak) (r:zd:16254/zd:23729) (q:draft)
Lingthuk = (i:1) (t:name) (c:khua) (f:travel) (w:Lingthuk) (d:a Zomi village in Chin State, Myanmar; written after a personal name it tells the home village of the person) (r:zd:22877) (q:draft)
link = (i:1) (t:n) (f:it) (w:link) (d:an address on the internet that opens a page or file when it is pressed) (o:English) (r:zd:12948/zd:19430) (q:draft)
linnliann = (i:1) (t:adv) (f:everyday) (j:linlian) (r:zd:17060/zd:20176/zd:21590) (q:draft)
