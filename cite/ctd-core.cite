guuk = (i:1) (t:adv) (f:social/politics) (w:secretly/stealthily/illegally) (d:done by stealth, without permission; {guuk om} is to stay without legal papers and {guuk nasepna} is working illegally; from <gu>, steal) (r:zd:16844) (q:draft)
