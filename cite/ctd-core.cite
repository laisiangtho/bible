simin = (i:3) (t:adv) (f:everyday) (w:by the/in) (d:<sim>, count, with <in>, after a number word in the pattern {a tul a simin}, by the thousands, in numbers counted in thousands) (r:zd:21939/zd:23301) (q:draft)
simin = (i:4) (t:v) (f:education/religion) (w:reading) (d:<sim>, read, with the linking ending <in>: reading a text and then going on to the next action, often after the name of a book or a verse) (r:zd:26385/zd:21066) (q:draft, low confidence)
simkhak = (i:1) (t:v) (f:education/media) (w:happen to read/come upon in reading) (d:the form of <simkha> used before <ciangin> and in relative clauses: happen to read, have read) (b:simkha) (r:zd:11410/zd:20142) (q:draft)
simkhawm = (i:3) (t:v) (f:education/religion) (w:read together) (d:<sim.1>, read, with <khawm>, together: read a text together with others, or read two texts side by side, not count or attack; said of the Bible and of lessons) (r:zd:24303/zd:17437) (q:draft)
simkhiatna = (i:1) (t:n) (f:education/social) (w:reading out/reading aloud/public reading) (d:<simkhiat>, read out, with the noun ending {-na}: the reading aloud of a text before others; {simkhiatna nei} is to read out) (b:simkhiat) (r:zd:11325/zd:11425) (q:draft)
simkhin = (i:1) (t:v) (f:everyday/education) (w:have read/finish reading) (d:<sim>, read, and <khin>, already, written as one word: have already read, read to the end) (j:sim/khin) (r:zd:12512/zd:19139) (q:draft)
simkik = (i:2) (t:v) (f:everyday) (w:count again/recount) (d:<sim>, count, with <kik>, again: count money, people or things once more; the object is what is counted, as in {sum simkik}, not a land or an enemy) (r:zd:20287/zd:17428) (q:draft)
simkik = (i:3) (t:v) (f:education/media) (w:read again/reread) (d:<sim>, read, with <kik>, again: read a text or a report once more) (r:zd:25122) (q:draft, low confidence)
simlam = (i:1) (t:n) (f:nature/travel) (w:south/the lowland side) (d:<sim>, here the warm low country, and <lam>, direction: the direction opposite to <zolam>; taken here as south, the reviewer should confirm the compass point) (a:zolam) (r:zd:23394) (q:draft, low confidence)
simleh = (i:1) (t:v) (f:education/everyday) (w:if one reads/when one reads) (d:<sim>, read, and <leh>, if or when, written as one word: when or if it is read; not {sim leh zo}, lowland and highland) (j:sim/leh) (r:zd:17772/zd:19244) (q:draft)
simlei = (i:1) (t:n) (f:nature/media) (w:earth/world) (d:word of songs and poems for the earth, the world where people live; set against <thangvan>, the sky above) (s:leitung) (r:zd:23902/zd:25601) (q:draft)
simlo = (i:1) (t:v) (f:education/everyday) (w:not read) (d:<sim>, read, and <lo>, not, written as one word: does not read, without reading) (j:sim/lo) (r:zd:19679/zd:14941) (q:draft)
simlo = (i:2) (t:v) (f:everyday/social) (w:not count/not regard) (d:<sim> in the sense count or regard as, with <lo>, not, written as one word: does not count as, does not take seriously) (j:sim/lo) (r:zd:25275/zd:20940) (q:draft, low confidence)
simnop = (i:2) (t:v) (f:education/everyday) (w:want to read/wish to read) (d:<sim>, read, with <nop>, want, after a subject marker: wish to read something, most often in {na simnop leh}, if you want to read it, before a link or a file; not a quality of the writing) (r:zd:12441) (q:draft)
simnuam = (i:2) (t:v) (f:education/everyday) (w:want to read/like to read) (d:<sim>, read, with <nuam>, want: wish or like to read a text or a language; the object is something written, not an enemy) (r:zd:23770/zd:16428/zd:21198) (q:draft)
simpian = (i:1) (t:adv) (f:everyday) (w:rather/quite/fairly) (d:placed after a describing word or a verb: to a fair or considerable degree, as in {haksa simpian}, rather hard, and {kizaknawh simpian}, be heard quite often) (r:zd:11553/zd:15266/zd:19603) (q:draft, low confidence)
simpianta = (i:1) (t:adv) (f:everyday) (w:rather/quite/by now fairly) (d:<simpian> and <ta> written as one word after a verb or describing word: it has by now become rather so, as in {sawt simpianta}, it has been quite a long time) (j:simpian/ta) (r:zd:22444/zd:17868) (q:draft)
simple = (i:1) (t:adj) (f:everyday) (w:simple/plain) (d:plain and without show, or of a mind not complicated) (o:English) (r:zd:24743) (q:draft, low confidence)
simsaklo = (i:1) (t:v) (f:everyday) (w:not regard as/not treat as) (d:<simsak>, regard as, and <lo>, not, written as one word; {thupi simsaklo} is not treating a thing as serious) (j:simsak/lo) (r:zd:20039) (q:draft, low confidence)
simsaklo = (i:2) (t:v) (f:education/everyday) (w:not let read) (d:<simsak>, let read, and <lo>, not, written as one word; after <ki> it is not be allowed to read) (j:simsak/lo) (r:zd:22620) (q:draft, low confidence)
simsim = (i:1) (t:adv) (f:everyday) (w:quite/rather/considerably) (d:placed after a describing word or a verb: to a fair degree, more than a little, as in {tam simsim}, quite many; after a verb of doing, a good deal or on and on) (r:zd:18196/zd:22059/zd:20087) (q:draft, low confidence)
simsimta = (i:1) (t:adv) (f:everyday/time) (w:quite by now/rather already) (d:<simsim>, quite, with <ta>, the marker of a state now reached, written as one word: has become quite so, as in {sawt simsimta}, it has been quite long) (r:zd:19697/zd:15031/zd:12183) (q:draft)
simsuak = (i:1) (t:v) (f:education) (w:read through/read to the end) (d:<sim>, read, with <suak>, right through: read the whole of a book or an article) (j:sim/suak) (r:zd:17577/ts:3280) (q:draft)
simsuk = (i:2) (t:v) (f:education) (w:read on/read down/read further) (d:<sim> in its meaning read, with <suk>, downward: read on down a page or a passage, as in {a nuaiah na simsuk lai in}, read on below; not the sense attack) (r:zd:20410/zd:21140/zd:25932) (q:draft)
simta = (i:1) (t:adv) (f:everyday) (w:rather/quite/by now) (d:placed after a describing word: it has become rather so by now; {sawt simta} is it has been quite a long time already) (r:zd:24594/zd:23877) (q:draft, low confidence)
simtak = (i:1) (t:adj) (f:education/everyday) (w:worth reading/worth reckoning) (d:<sim>, read or count, with <tak>, worthy: worth reading, as a book, or worth counting, to be reckoned with) (r:zd:19201/zd:19139) (q:draft, low confidence)
simte = (i:4) (t:n) (f:education/media) (w:readers/those who read) (d:<sim> in its meaning read, with the plural <te>: the people who read or study something, after <lai>, <laibu> or the name of a book or subject, as {lai a simte}, the readers) (r:zd:19139/zd:21898/zd:22709) (q:draft)
simtham = (i:3) (t:adv) (f:everyday) (w:quite/considerably/rather) (d:after a verb or an adjective: to a degree worth noting, as {kinawhzak simtham}, quite frequent, and {gol simtham}, quite big; not the land or the secret of the other senses) (r:zd:12494/zd:11927/zd:24455) (q:draft)
simtheih = (i:1) (t:v) (f:education) (w:be able to read/can be read/readable) (d:<sim>, read, and <theih>, be able, written as one word: able to read, or that can be read; {simtheih dingin} is so that one can read) (j:sim/theih) (r:zd:18958/zd:23896/zd:22557) (q:draft)
simtheilo = (i:1) (t:adj) (f:education) (w:unable to read/illiterate) (d:<sim>, read, and <theilo>, unable, written as one word: unable to read, as in {lai simtheilo}; {ki simtheilo} is cannot be read) (j:sim/theilo) (r:zd:21817/zd:21908/zd:10892) (q:draft)
simthu = (i:1) (t:n) (f:social/media) (w:news/tidings) (d:word of songs and laments for <thu>, news or report of something) (r:zd:24462) (q:draft, low confidence)
simzawhloh = (i:1) (t:adj) (f:everyday) (w:countless/innumerable/incalculable) (d:<simzawh>, be able to count, and <loh>, not, written as one word: too many to count) (j:simzawh/loh) (r:zd:9452/zd:21155) (q:draft)
simzel = (i:2) (t:v) (f:education/everyday) (w:read regularly/keep reading) (d:<sim>, read, with <zel>, again and again: read something regularly or as a habit, said of books, newspapers and Scripture; not {simzel}, raid repeatedly) (r:zd:15274/zd:20697/zd:14552) (q:draft)
sin = (i:1) (t:v) (f:everyday/education) (w:learn/study) (d:gain knowledge or skill by study or by being taught; {thu sin} is learn a teaching) (q:draft)
sina = (i:1) (t:v) (f:education) (w:study/learn) (d:<sin>, learn, and the linking <a>, written as one word: studied, and then; {pilna sina} is having studied) (j:sin/a) (r:zd:9255/zd:9231/zd:20680) (q:draft, low confidence)
Sinabung = (i:1) (t:name) (c:mountain) (f:nature) (w:Sinabung/Mount Sinabung) (d:volcano on the island of Sumatra in Indonesia) (r:zd:17808/zd:12161) (q:draft)
sinailo = (i:1) (t:v) (f:health/everyday) (w:not yet dead/still alive) (d:<si>, die, and <nailo>, not yet, written as one word: has not died yet) (j:si/nailo) (r:zd:19002/zd:21279) (q:draft)
sinbeh = (i:1) (t:v) (f:education) (w:learn more/study further/keep learning) (d:<sin> learn with the ending <beh>, in addition: go on learning more than one already knows) (b:sin) (r:zd:20814/zd:18208) (q:draft)
sinding = (i:1) (t:phrase) (f:education) (w:to learn/lesson to learn) (d:<sin> and <ding> written as one word: to be learned or studied; {pan sinding} in a title is lessons to learn from) (j:sin/ding) (r:zd:24029/zd:25301/zd:23896) (q:draft)
sing = (i:3) (t:part) (f:everyday) (w:I) (d:sentence-final first person singular ending of songs and familiar speech, a form of <ing>; after <kei> it is I do not, as in {ut kei sing}, I do not want to) (r:zd:25562) (q:draft, low confidence)
singah = (i:1) (t:n) (f:food/nature) (j:singgah) (r:zd:24276/zd:22695) (q:draft)
singam = (i:1) (t:v) (f:everyday) (w:dare to die/be willing to die) (d:<si>, die, and <ngam>, dare, written as one word: be ready to die, also said of doing something to the point of death) (j:si/ngam) (r:zd:23138) (q:draft, low confidence)
Singapore = (i:1) (t:name) (c:land/city) (f:travel) (w:Singapore) (d:island country and city in Southeast Asia, next to Malaysia) (r:zd:21032/zd:21233) (q:draft)
Singaporean = (i:1) (t:name) (c:people) (f:politics/travel) (w:Singaporean) (d:of Singapore, a person of Singapore; often before <gammi>, citizen) (o:English) (r:zd:15073/zd:11110) (q:draft)
Singaporete = (i:1) (t:name) (c:people) (f:social) (w:Singaporeans/people of Singapore) (d:<Singapore> with plural <te>: the people of Singapore) (b:Singapore) (r:zd:21178) (q:draft)
singdawn = (i:1) (t:n) (f:nature) (w:treetop/top of a tree) (d:<sing>, tree, with <dawn>, top: the top of a tree) (r:zd:11384/zd:11558) (q:draft)
singgah = (i:1) (t:n) (f:food/nature) (w:fruit) (d:<sing>, tree, with <gah>, fruit: the fruit of a tree; {singgah kung} is a fruit tree) (s:gah)
singgahtui = (i:1) (t:n) (f:food) (w:fruit juice/juice) (d:<singgah>, fruit, with <tui>, water: the juice of fruit) (b:singgah) (j:singgah/tui) (r:zd:21032/zd:24064) (q:draft)
Singgial = (i:1) (t:name) (c:khua) (f:travel) (w:Singgial) (d:a Zomi village and its land in the Tonzang area of Chin State, Myanmar; written in brackets after a personal name it shows the home village) (r:ts:6443/ts:3168) (q:draft, low confidence)
singhalh = (i:1) (t:n) (f:nature/politics) (w:reserved forest/forest reserve) (d:forest land set apart and protected by the government, where farming and cutting are not allowed; from <sing>, tree, and {halh}; one article glosses it with the Burmese word for reserved forest) (r:zd:22371/zd:24223/zd:25863) (q:draft, low confidence)
singhawm = (i:1) (t:n) (f:nature) (w:hollow tree/tree hollow) (d:<sing>, tree, with <hawm.2>, hollow, written as one word; in the saying {singhawm suanghawm pan a piang ki omlo}, no one is born from a hollow tree or a hollow rock, everyone has a family and a people) (j:sing/hawm) (r:zd:25414) (q:draft)
singhawng = (i:1) (t:n) (f:nature) (w:bark/tree bark) (d:the outer covering of a tree, <sing> with <hawng>; {maitang singhawng belh} is literally stick bark on the face, set shame aside and speak out boldly) (r:zd:20657/zd:14746) (q:draft)
singinn = (i:1) (t:n) (f:home) (w:wooden house) (d:<sing>, wood, and <inn>, house, written as one word: a house built of wood) (j:sing/inn) (r:zd:11571/zd:17917) (q:draft)
