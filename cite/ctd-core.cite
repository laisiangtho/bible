munpan = (i:1) (t:adv) (f:travel/everyday) (w:from the place/from where) (d:<mun> and <pan> written as one word: from the place that is named before it; {tua munpan} is from there) (j:mun/pan) (r:zd:21817/zd:23616/zd:24420) (q:draft)
