pai = (i:1) (t:v) (f:everyday/travel) (w:come) (d:move toward the speaker or the place spoken of, usually with <hong> before it: {hong pai}, come here)
paibawlna = (i:1) (t:n) (f:work) (w:trade/business dealings) (d:found in the pair {sumbawl paibawlna}, trade and commerce, where it echoes <sumbawl>: buying, selling and doing business) (r:zd:25228/ts:3372) (q:draft, low confidence)
paiciang = (i:1) (t:phrase) (f:everyday/health) (w:when it goes/when it comes) (d:<pai>, go, and <ciang>, when, written as one word: when it goes or passes; seen only in one headline, of a woman's monthly period) (j:pai/ciang) (r:zd:11965) (q:draft, low confidence)
paicil = (i:1) (t:v) (f:everyday) (w:first come/begin to go) (d:<pai> and <cil>, at first, written as one word: go, come or flow for the first time, at the beginning) (j:pai/cil) (r:zd:22238) (q:draft, low confidence)
paidan = (i:1) (t:n) (f:everyday/social) (w:way of going/course/procedure/manner) (d:<pai>, go, with <dan>, way: how something goes or proceeds, as the course of events, the working of an office or a way of thinking; of a person or animal also the gait) (r:zd:23830/zd:20418/zd:17655) (q:draft)
paiden = (i:1) (t:v) (f:everyday/travel) (w:go regularly/keep going/keep coming) (d:<pai> and <den> written as one word: go or come all the time, as a habit or without stopping) (j:pai/den) (r:zd:21904/zd:10743/zd:24248) (q:draft)
paidiakna = (i:1) (t:n) (f:social/travel) (w:favourite haunt/place most visited) (d:<pai>, go, <diak>, especially, and the noun suffix <na> written as one word: the place where a group of people mostly goes) (j:pai/diak/na) (r:zd:10892) (q:draft, low confidence)
paiding = (i:1) (t:v) (f:travel/everyday) (w:will go/be going to go) (d:<pai> and <ding> written as one word: will go, about to go; also going, the act of going to a place) (j:pai/ding) (r:zd:25318/zd:25046/zd:19518) (q:draft)
paidingin = (i:1) (t:phrase) (f:travel) (w:in order to go/to go) (d:<pai>, go, and <dingin>, in order to, written as one word: so as to go to the place or event named before it) (j:pai/dingin) (r:zd:10881/zd:16757) (q:draft)
paih = (i:2) (t:v) (f:social/religion) (w:send/give/wish) (d:after <thupha>, blessing: send or pronounce a blessing or good wishes on someone, as in {thupha kong paih hi}, I send you my blessing, at the end of a greeting or message) (r:zd:22815/zd:23481/zd:21070) (q:draft)
paihding = (i:1) (t:v) (f:everyday) (w:to throw away/to discard) (d:<paih>, throw away, and <ding> written as one word: what is to be thrown away or got rid of) (j:paih/ding) (r:zd:23972/zd:25926) (q:draft)
paihi = (i:1) (t:v) (f:everyday/travel) (w:go/went) (d:<pai> and the sentence ending <hi> written as one word: goes, went) (j:pai/hi) (r:zd:15207/zd:20046) (q:draft)
paihna = (i:2) (t:n) (f:social/media) (w:sending/conveying) (d:the sending of good wishes to someone, not a throwing away: after <thupha>, blessing, {thupha paihna} is a message of greeting or congratulation) (r:zd:24807/zd:21811) (q:draft, low confidence)
paihte = (i:1) (t:n) (f:everyday/home) (w:those who throw away/things thrown away) (d:<paih>, throw away, with the plural ending <te>: the people who throw something away, or the things thrown away; written with a capital, {Paihte} is another spelling of the name of the Paite people of Manipur and their speech) (b:paih) (r:zd:22875/zd:17387) (q:draft)
paihtheih = (i:1) (t:v) (f:everyday/home) (w:can be thrown away/be able to discard) (d:<paih> and <theih> written as one word: able to be thrown away or given up; {paihtheih nading} is for throwing away) (j:paih/theih) (r:zd:20131/zd:11367) (q:draft)
paii = (i:3) (t:n) (f:work/everyday) (w:goods/property/wealth) (d:the second word of the pair {sum le paii} or {sum leh paii}, money and goods, which stands for money, funds and wealth as a whole; not used alone in this meaning) (s:sumlepai) (r:zd:25156/zd:20798/ts:1498) (q:draft)
paiin = (i:1) (t:v) (f:everyday/travel) (w:going/go and) (d:<pai>, go, and the linking <in> written as one word: going, having gone, he went and) (j:pai/in) (r:zd:15384/zd:22784) (q:draft)
paikawikawi = (i:1) (t:v) (f:travel) (w:go about/go around/go from place to place) (d:<pai>, go, and <kawikawi>, about, written as one word: go here and there, from one place to another) (j:pai/kawikawi) (r:zd:12827/zd:14716) (q:draft)
paikei = (i:1) (t:v) (f:everyday/travel) (w:not go/do not go) (d:<pai>, go, and the negative <kei> written as one word: {paikei in} is do not go, {paikei leh} is if one does not go) (j:pai/kei) (r:zd:15122/zd:25126) (q:draft)
paikhiakik = (i:1) (t:v) (f:everyday/travel) (w:go back out/leave again) (d:<paikhia> and <kik> written as one word: go out again; with <ki> before it, be taken back out or withdrawn) (j:paikhia/kik) (r:zd:16885) (q:draft)
paikhialhna = (i:1) (t:n) (f:social/religion) (w:going astray/error/wrong course) (d:noun of <paikhial>, go astray: a wrong course taken by a person, a party or a church) (b:paikhial) (r:zd:20410/zd:11798) (q:draft)
paikhialo = (i:1) (t:v) (f:everyday/travel) (w:not go out/not leave/not come out) (d:<paikhia>, go out, and <lo>, not, written as one word) (j:paikhia/lo) (r:zd:19614/zd:14708) (q:draft)
paikhiapah = (i:1) (t:v) (f:everyday/travel) (w:go out at once/leave immediately) (d:<paikhia>, go out, and <pah>, at once, written as one word) (j:paikhia/pah) (r:zd:18289/zd:17645) (q:draft)
paikhiathei = (i:1) (t:v) (f:travel/everyday) (w:can go out/be able to leave) (d:<paikhia> and <thei> written as one word: be able to go out, leave or depart) (j:paikhia/thei) (r:zd:17632/zd:19719) (q:draft)
paikhiatsan = (i:1) (t:v) (f:everyday/travel) (w:leave behind/go away from/walk out on) (d:<paikhiat>, go out, with <san>, away from: go out and leave a person, place or thing behind) (b:paikhiat) (r:zd:9428/zd:14917) (q:draft)
paikhol = (i:1) (t:v) (f:travel/everyday) (w:go beforehand/go ahead/go in advance) (d:<pai>, go, with <khol>, beforehand, written as one word: go ahead of time, before the day or before others) (j:pai/khol) (r:zd:19320/zd:14619) (q:draft)
paikhuan = (i:1) (t:n) (f:travel/politics) (w:permission to go/leave to pass/clearance) (d:<pai>, go, and <khuan>, permission, written as one word: leave to go on or to pass, with <pia>, give) (j:pai/khuan) (r:zd:11936/zd:11271) (q:draft)
paikik = (i:1) (t:v) (f:everyday/travel) (w:return/go back/come back) (d:<pai>, go or come, with <kik>, back or again: go back or come back to where one was; {hong paikik} is come back) (s:ciahkik/kilehkik) (b:pai) (q:draft)
paikul = (i:1) (t:v) (f:travel/everyday) (w:must go/have to go) (d:<pai>, go, and <kul>, must, written as one word: it is necessary to go) (j:pai/kul) (r:zd:14927/zd:11775/zd:16216) (q:draft)
pailai = (i:2) (t:v) (f:travel/everyday) (w:be on the way/be moving) (d:<pai> go with <lai>, while: in the middle of going or coming, said of a person on the way or a vehicle in motion, often {pailai tak in}; not about something still to come) (r:zd:12287/zd:21876) (q:draft, low confidence)
pailaikhat = (i:1) (t:phrase) (f:travel) (w:one that is moving) (d:<pailai> and <khat> written as one word, after a noun such as <mawtaw>: one that is on its way, a moving one) (j:pailai/khat) (r:zd:17560/zd:17289) (q:draft)
paileh = (i:1) (t:v) (f:everyday/travel) (w:if one goes/when one went) (d:<pai>, go, and <leh>, if or when, written as one word) (j:pai/leh) (r:zd:20932/zd:16900) (q:draft)
pailo = (i:1) (t:v) (f:everyday/travel) (w:not go/not come) (d:<pai> and <lo> written as one word: does not go, did not come) (j:pai/lo) (r:zd:23935/ts:2731/zd:22877) (q:draft)
pailoh = (i:1) (t:v) (f:travel/everyday) (w:not go/not come) (d:<pai>, go, with the negative <loh>, written as one word: not going or not coming, the form used before words such as <nading>, <ding> and <hang>) (j:pai/loh) (r:zd:9429/zd:15583) (q:draft)
pailoin = (i:1) (t:v) (f:everyday/travel) (w:without going/not going) (d:<pai> and <loin> written as one word: not going, instead of going) (j:pai/loin) (r:zd:15384/zd:22967) (q:draft)
paima = (i:1) (t:phrase) (f:travel/everyday) (w:before going) (d:<pai> and <ma> written as one word: before going, as in {na paima in}, before you go) (j:pai/ma) (r:zd:19520/zd:11908) (q:draft)
paimang = (i:2) (t:v) (f:everyday/religion) (w:go away/leave) (d:<pai>, go, with <mang>, away and gone: go away and leave someone, said of people, often before <nuam> or <ut>, want) (r:zd:23037) (q:draft)
painading = (i:1) (t:phrase) (f:travel/everyday) (w:for going/for walking/in order to go) (d:<pai>, go, and <nading>, for, written as one word: for going or travelling, meant for something to go on) (j:pai/nading) (r:zd:17560/zd:11666) (q:draft)
painawnlo = (i:1) (t:v) (f:everyday/travel) (w:no longer go/no longer run) (d:<pai>, go, and <nawnlo>, no longer, written as one word: go no more; of water, no longer flow) (j:pai/nawnlo) (r:zd:17645/zd:17876) (q:draft)
paingamlo = (i:1) (t:v) (f:travel/everyday) (w:dare not go/be afraid to go) (d:<pai> and <ngamlo> written as one word: not dare to go) (j:pai/ngamlo) (r:zd:25346) (q:draft)
paingei = (i:2) (t:v) (f:everyday/travel) (w:have been to/have gone before/ever go) (d:<pai>, go, with <ngei> in its meaning of having done something at some time: have gone or come to a place before, not a habit; with <nawnlo>, never go again) (r:zd:25322/zd:12094) (q:draft)
painuamlo = (i:1) (t:v) (f:everyday/travel) (w:not want to go/be unwilling to go) (d:<painuam>, want to go, and <lo>, not, written as one word) (j:painuam/lo) (r:zd:19971/zd:12548/zd:16949) (q:draft)
paipan = (i:1) (t:v) (f:everyday/travel) (w:go only then/then go) (d:<pai>, go, with <pan> after it, written as one word: go or come only then, only after what has just been told; with <hong>, then come) (j:pai/pan) (r:zd:23446/zd:22736) (q:draft, low confidence)
paipi = (i:1) (t:n) (f:education/social) (w:principle/main theme/essence/doctrine) (d:the main line or central point of a matter, teaching or aim; {a thu paipi} is the gist of it) (r:zd:25461/zd:24320/zd:16748) (q:draft)
paipih = (i:2) (t:v) (f:everyday/travel) (w:brought/bring/take/lead) (d:go taking a person or thing along: {hong paipih} is bring here, and {paipih} with a place is take or lead there) (b:pai) (r:1.2.22)
paipihden = (i:1) (t:v) (f:everyday/travel) (w:always take along/keep taking) (d:<paipih>, take along, and <den>, always, written as one word: take someone along to a place again and again) (j:paipih/den) (r:zd:16170) (q:draft)
paipihding = (i:1) (t:v) (f:everyday/travel) (w:will take/to take along/to bring) (d:<paipih>, go taking someone along, and <ding>, will or to, written as one word) (j:paipih/ding) (r:zd:15067/zd:16998) (q:draft)
paipihpah = (i:1) (t:v) (f:travel/health) (w:take at once/rush to) (d:<paipih>, take along, with <pah>, at once: take someone somewhere immediately, mostly to a hospital) (j:paipih/pah) (r:zd:17694/zd:21793/zd:24276) (q:draft)
paipihsuak = (i:1) (t:v) (f:travel) (w:take straight to/take on to) (d:<paipih> and <suak> written as one word: take a person straight on to a place, such as a hospital or a police station) (j:paipih/suak) (r:zd:16332/zd:14776) (q:draft)
paipihte = (i:1) (t:n) (f:everyday/travel) (w:those who take along/those taken along) (d:<paipih>, go taking someone or something along, with the plural <te>: the ones who take others along, or the ones brought along) (b:paipih) (r:zd:10785) (q:draft, low confidence)
paisa = (i:1) (t:adj) (f:time/everyday) (w:past/gone/departed) (d:<pai>, go, with <sa> marking a finished act: that has gone or come already; {hun paisa} is time past, {kum 20 a paisa} is twenty years ago, and {a paisa} of persons is those who have passed away) (b:pai) (r:zd:24939/zd:24029/zd:12280) (q:draft)
paisakding = (i:1) (t:v) (f:everyday/travel) (w:will send/will let go) (d:<paisak>, make go, and <ding> written as one word: will send or will make go; {ki paisakding} is will be sent) (j:paisak/ding) (r:zd:19719/zd:17632) (q:draft)
paisaklo = (i:1) (t:v) (f:everyday/travel) (w:not let go/not allow to go/not let pass) (d:<paisak>, let go, and <lo>, not, written as one word: not allow someone to go to a place or to pass) (j:paisak/lo) (r:zd:17250/zd:22864/zd:17860) (q:draft)
paisakpah = (i:1) (t:v) (f:everyday/work) (w:send at once/dispatch immediately) (d:<paisak>, send, and <pah>, at once, written as one word: send people or vehicles to a place without delay; with <ki>, be sent at once) (j:paisak/pah) (r:zd:13098/zd:16137) (q:draft)
paisate = (i:1) (t:n) (f:time/everyday) (w:past ones/those who have gone) (d:plural of <paisa>: {hun paisate} is past times, {khang paisate} past generations, and {a paisate} those who have gone before) (b:paisa) (r:zd:20958/ts:3375) (q:draft)
paisuak = (i:3) (t:v) (f:travel) (w:go straight on/go directly/go through) (d:<pai>, go, with <suak>: as the main verb after a place, go straight on to it without stopping or turning aside on the way; the other senses stand after another verb) (r:zd:16745/zd:22479/zd:17152) (q:draft)
paita = (i:2) (t:v) (f:time) (w:pass/go by/elapse) (d:of time, have passed: after a number of years, as in {kum tampi paita hi}, many years have gone by, not a person coming) (r:zd:20117/zd:23317) (q:draft)
paite = (i:2) (t:n) (f:work) (w:money/means/wealth) (d:the second half of the pair {sum leh paite}, money and means, with the plural {-te}; it follows <sum> and has nothing to do with <pai>, go) (r:zd:17685/zd:22941) (q:draft)
paitek = (i:1) (t:v) (f:everyday/travel) (w:each go/all go/all come) (d:<pai>, go or come, and <tek>, each, written as one word: every one of them goes or comes) (j:pai/tek) (r:zd:24366/zd:11325) (q:draft)
paiteng = (i:1) (t:phrase) (f:everyday/social) (w:all who came/all who went/those attending) (d:<pai>, go or come, and <teng>, all, written as one word, usually after <a> or <hong>: all those who came) (j:pai/teng) (r:zd:19166/zd:10743) (q:draft)
paitheilo = (i:1) (t:v) (f:travel/everyday) (w:cannot go/be unable to go) (d:<pai>, go, and <theilo>, unable, written as one word: be unable to go, move or walk) (j:pai/theilo) (r:zd:20399/zd:14521) (q:draft)
paito = (i:2) (t:v) (f:time) (w:go on/pass/advance) (d:of time, after {hun hong}: go on, move forward; here <to> means onward and not upward to a higher place) (r:ts:11162/zd:19332) (q:draft)
paitoto = (i:1) (t:v) (f:everyday/time) (w:go on/continue/keep going) (d:<pai>, go, and <toto>, onward, written as one word: keep going on, continue; of time, pass on) (j:pai/toto) (r:zd:24965/zd:25221/zd:23389) (q:draft)
paizai = (i:1) (t:n) (f:social/work) (j:paizia) (r:zd:20264/zd:10732) (q:draft, low confidence)
paizawh = (i:1) (t:phrase) (f:time) (w:after the coming/since coming) (d:<pai>, go or come, and <zawh>, after, written as one word; with <hong> before it and a number of years after it: since someone came, as in the anniversary of an arrival) (j:pai/zawh) (r:zd:10743/zd:25893) (q:draft)
paiziau = (i:1) (t:v) (f:everyday/travel) (w:just go/go straight/go off) (d:<pai>, go, and <ziau>, swiftly and lightly, written as one word: simply go, go straight on or straight there) (j:pai/ziau) (r:zd:12630/zd:17876) (q:draft)
paiziau = (i:2) (t:v) (f:everyday) (w:throw away/dump/abandon) (d:<pai>, here throw away, with <ziau>, in one light movement, written as one word: cast off or leave something or someone in a place) (j:pai/ziau) (r:zd:12733) (q:draft, low confidence)
pak leng = (i:1) (t:part) (f:everyday) (w:let us briefly) (d:<pak>, here for a moment, and <leng>, if we or let us: placed after a verb, let us do it briefly; a writer uses it to introduce the next point) (r:zd:23079/zd:25177) (q:draft)
pakding = (i:1) (t:phrase) (f:everyday) (w:to do briefly/for a moment) (d:the adverb <pak>, quickly or for a short while, and the future marker <ding> written as one word, placed after a verb: will do it briefly, to do it for a short time) (j:pak/ding) (r:zd:13077/zd:20997) (q:draft)
pakhat = (i:1) (t:phrase) (f:family) (w:one father) (d:<pa> and <khat> written as one word: one father; the same spelling also occurs in quotations from Mizo and Hakha, where it is their word for one) (j:pa/khat) (r:zd:15941) (q:draft, low confidence)
pakhuan = (i:1) (t:n) (f:nature/home) (w:flower garden/garden/park) (d:<pak>, flower, with <huan>, garden: a garden of flowers, also a public garden or park) (r:zd:16254/zd:17092) (q:draft)
pakibang = (i:1) (t:adj) (f:family) (w:of the same father) (d:<pa> and <kibang> written as one word: having the same father, said of brothers and sisters, often together with <nukibanglo>) (j:pa/kibang) (r:zd:11366) (q:draft)
pakin = (i:2) (t:adv) (f:time/everyday) (w:briefly/for a moment/for a short while) (d:after a verb of resting, looking or visiting: doing it only for a short time before going on, not doing it fast; {gentehna pakin} is as a brief example) (r:zd:23670/zd:10687/zd:24630) (q:draft)
Pakistan = (i:1) (t:name) (c:land) (f:politics/travel) (w:Pakistan) (d:country in South Asia, west of India) (r:zd:11263/zd:15093/zd:14846) (q:draft)
Pakistani = (i:1) (t:name) (c:people) (f:politics) (w:Pakistani) (d:of <Pakistan> or its people; the English word, placed before a noun such as <gammi>) (o:English) (r:zd:21400/zd:21030) (q:draft)
Pakistante = (i:1) (t:name) (c:people) (f:politics/social) (w:Pakistanis/people of Pakistan) (d:<Pakistan> with plural <te>: the people or the state of Pakistan; before a noun also of Pakistan) (b:Pakistan) (r:zd:11016) (q:draft, low confidence)
pakkung = (i:1) (t:n) (c:plant) (f:nature/home) (w:flowering plant/flower plant) (d:a plant or shrub grown for its flowers, <pak> flower with <kung> plant) (r:zd:22444/zd:14652) (q:draft)
paklo = (i:1) (t:adv) (f:everyday) (w:not readily/not at once) (d:<pak>, at once, and <lo>, not, written as one word after a verb: the action does not come about readily or straight away, as in {kithei paklo}, it is not known at once) (j:pak/lo) (r:zd:26097/ts:5635/zd:11384) (q:draft)
paknam = (i:1) (t:n) (f:home/nature) (w:perfume/fragrance) (d:in {paknam tui}, another way of writing <paknamtui>: perfume or scented oil) (r:zd:18924) (q:draft)
pakni = (i:1) (t:phrase) (f:everyday) (w:let us quickly/let me briefly) (d:<pak>, quickly or for a moment, with the ending <ni>, let us, written as one word after a verb: let us do it at once, let me just do it briefly) (j:pak/ni) (r:zd:20889/zd:20158) (q:draft)
pakpaklo = (i:1) (t:adv) (f:everyday) (w:rarely/not readily/hardly ever) (d:<pakpak>, readily, and <lo>, not, written as one word; after a verb: it does not easily or often happen) (j:pakpak/lo) (r:zd:14537/zd:16200/zd:18248) (q:draft)
pakpih = (i:1) (t:v) (f:social) (w:be proud of/take pride in/rejoice over) (d:written after a separate <ki>: {ki pakpih}, from <kipak>, rejoice, with <pih>, be glad and proud because of someone or something) (r:zd:12876/zd:20131) (q:draft)
Pakzang = (i:1) (t:name) (c:place) (f:travel) (w:Pakzang) (d:a village in the <Tedim> area of Chin State) (r:ts:3341/zd:25233) (q:draft)
palaai = (i:1) (t:n) (f:politics/religion/social) (j:palai) (r:zd:22786/zd:21717/zd:19659) (q:draft)
palai = (i:3) (t:n) (f:politics/social) (w:representative/delegate/member of parliament) (d:a person chosen to speak and act for a community, a party or an organization, such as a committee member of an association or an elected member of parliament; {palai kiteelna} is the election of representatives) (r:zd:22362/zd:21550/zd:22688) (q:draft)
palaite = (i:1) (t:n) (f:politics/social) (w:representatives/delegates/envoys) (d:plural of <palai>: those who speak or act for a people, a group or a country, such as delegates to a meeting, members of parliament and ambassadors) (b:palai) (r:ts:3102/zd:13287/zd:23048) (q:draft)
