lolua = (i:1) (t:adv) (f:everyday) (w:not very/not at all) (d:<lo>, not, and <lua>, very, written as one word after a verb or describing word: not so much, or very much not) (j:lo/lua) (r:zd:12110/zd:16216) (q:draft, low confidence)
