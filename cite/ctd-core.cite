puul = (i:1) (t:n) (f:health) (j:pul) (r:zd:23754/zd:23806) (q:draft)
puulnatna = (i:1) (t:n) (f:health) (j:pulnatna) (r:zd:24955) (q:draft)
pya = (i:1) (t:n) (f:work) (w:pya) (d:the smallest unit of Myanmar money, one hundredth of a kyat; {pya khat} is a single pya, the least amount of money) (o:Burmese) (r:zd:21843) (q:draft, low confidence)
Pyenee = (i:1) (t:n) (f:politics) (w:state) (d:a state of Myanmar as a unit of government, as in {Chin Pyenee}, Chin State) (o:Burmese, pyine) (r:zd:19166/zd:19210) (q:draft, low confidence)
Pyidaungsuh = (i:1) (t:name) (f:politics) (w:Union) (d:Burmese word for the Union of Myanmar, used in names such as {Pyidaungsuh Hluttaw}, the Union Parliament, and {Pyidaungsuh Lanmagyi}, a Union highway) (o:Burmese, pyidaungsu) (r:zd:23011/zd:23252) (q:draft)
Pyigyitagon = (i:1) (t:name) (c:place) (f:travel) (w:Pyigyitagon) (d:township of the city of Mandalay) (r:zd:17668) (q:draft)
Pyine = (i:1) (t:n) (f:politics) (w:state) (d:a state as a division of Myanmar; {Pyine Hluttaw} is a state parliament) (o:Burmese, pyi-ne) (r:zd:24492) (q:draft)
Pyinee = (i:1) (t:n) (f:politics) (j:Pyine) (r:zd:15565/zd:10951) (q:draft)
Pyitu = (i:1) (t:n) (f:politics) (w:the people/people's) (d:Burmese word for the people, found in names of bodies of Myanmar such as {Pyitu Hlotdaw}, the People's Assembly) (o:Burmese, pyithu) (r:zd:22586/zd:10864) (q:draft, low confidence)
Pyituh = (i:1) (t:name) (f:politics) (w:Pyithu) (d:Burmese for the people, in names of Myanmar institutions; {Pyituh Hluttaw} is the Pyithu Hluttaw, the lower house of parliament) (o:Burmese, pyithu) (r:zd:10951/zd:24504) (q:draft)
Pyongyang = (i:1) (t:name) (c:city) (f:politics/travel) (w:Pyongyang) (d:the capital city of North Korea) (r:zd:12394/zd:11366) (q:draft)
pyramid = (i:1) (t:n) (f:education/travel) (w:pyramid) (d:the great stone tomb of a king of ancient Egypt; in the articles mostly in the name Sunway Pyramid, a shopping centre in Malaysia) (o:English) (r:zd:12046) (q:draft, low confidence)
Python = (i:1) (t:n) (c:animal) (f:nature) (w:python) (d:very large snake that kills by squeezing; usually followed by <gul> or <gulpi>, snake) (o:English) (r:zd:12181/zd:11889/zd:13334) (q:draft)
Pyu = (i:1) (t:name) (c:people) (f:politics/social) (w:Pyu) (d:name of an early people of Myanmar; in the news mostly in {Pyu Saw Htee}, the militias on the side of the military government) (r:zd:26620/zd:17204) (q:draft, low confidence)
