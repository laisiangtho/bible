speed = (i:1) (t:n) (f:travel/it) (w:speed) (d:how fast a vehicle, the wind or an internet connection goes; {speed ahat} is fast) (o:English) (r:zd:25052/zd:11259/zd:11590) (q:draft)
spelling = (i:1) (t:n) (f:education/it) (w:spelling) (d:how a word is written letter by letter; the English word used in Zolai sentences) (o:English) (r:zd:26097/zd:18081) (q:draft)
spokesman = (i:1) (t:n) (f:media/politics) (w:spokesman/spokesperson) (d:a person who speaks to the public and the press on behalf of an organisation such as the police or a government) (o:English) (r:zd:15884/zd:17112) (q:draft)
