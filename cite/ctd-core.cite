bill = (i:1) (t:n) (f:politics) (w:bill/draft law) (d:a proposed law put before a parliament or congress to be voted on) (o:English) (r:zd:24609/zd:24810) (q:draft)
bill = (i:2) (t:n) (f:work/home) (w:bill/invoice) (d:a statement of money owed for a service, as in {mei bill}, electricity bill, and {phone bill}) (o:English) (r:zd:15586/zd:24126) (q:draft, low confidence)
billion = (i:1) (t:num) (f:work/everyday) (w:billion) (d:the number one thousand million, mostly in amounts of money and counts of people) (o:English) (r:zd:21183/zd:21025/zd:23301) (q:draft)
