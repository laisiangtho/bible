nileh = (i:1) (t:phrase) (f:time) (w:day and) (d:<ni>, day, and <leh>, and, written as one word; other uses in the articles, such as {ki nileh}, are not clear) (j:ni/leh) (r:zd:21547/zd:17521) (q:draft, low confidence)
nilian = (i:1) (t:n) (f:time/religion) (w:the day itself/feast day) (d:<ni>, day, and <lian>, great, written as one word after the name of a festival: the very day of the feast, as {Christmas nilian}, Christmas day itself) (r:zd:10662) (q:draft, low confidence)
nilohte = (i:1) (t:part) (f:everyday) (d:<niloh>, continually, with the plural <te>, after a verb: those who keep on doing it, the ones who are always doing so) (j:niloh/te) (r:zd:21279) (q:draft, low confidence)
nim = (i:2) (t:adj) (f:nature) (w:lush/green/verdant) (d:fresh and richly green, said of leaves, grass, trees or a whole landscape and not of the sky; mostly with <dildial> as {nim dildial}) (r:zd:9422/zd:18026/zd:22305) (q:draft)
nim = (i:3) (t:adj) (f:health) (w:queasy/nauseous) (d:after <sung>, inside, as {sung nim}: feeling sick in the stomach, the feeling that comes before vomiting) (r:zd:24276) (q:draft, low confidence)
nima = (i:1) (t:adv) (f:time) (w:before the day) (d:<ni>, day, and <ma>, before, written as one word after a date or an event and often followed by <in>: before that day; {Sihvui nima nitak} is the evening before the day of the funeral) (j:ni/ma) (r:zd:10745/zd:13069) (q:draft, low confidence)
nimah = (i:1) (t:n) (f:time) (w:day/the very day) (d:<ni>, day, with the emphatic <mah>, written as one word after the name of a day of the week and before <in>: on that day) (j:ni/mah) (r:zd:19646/zd:11384) (q:draft)
nimit = (i:1) (t:n) (f:time) (w:date) (d:the day, month and year of an event or of a letter; written as a label before the date in notices and announcements) (r:zd:23246/zd:25311) (q:draft)
nin = (i:1) (t:adj) (f:everyday/home) (w:dirty/unclean) (d:dirty, not clean; the opposite of <siang>, clean) (s:nit/kihhuai) (a:siang/siangtho) (r:41.7.2) (q:draft)
nin = (i:3) (t:n) (f:home/everyday) (w:rubbish/garbage/waste/litter) (d:things thrown away, household waste, rather than dirt on a surface; brought out by <paih>, throw away, and by {nindum}, a rubbish bin) (r:zd:16862/zd:20131/zd:22444) (q:draft)
ninbua = (i:1) (t:v) (f:home/social) (w:dump rubbish/throw away rubbish) (d:<nin>, rubbish, and <bua>, pour out, written as one word: throw rubbish out, dump it; {ninbua mawtaw} is a rubbish truck) (j:nin/bua) (r:zd:16680/zd:16790) (q:draft)
ninbung = (i:1) (t:n) (f:home) (w:rubbish bin/trash can/dustbin) (d:a container into which rubbish is thrown) (r:zd:12373/zd:23727/zd:21239) (q:draft)
ning ei = (i:1) (t:part) (f:everyday) (d:<ning>, the ending of the first person singular for what the speaker will do, and the sentence-final <ei>, which here is not the pronoun we: closes a sentence in which the speaker announces or affirms warmly what he will do or feels, I will indeed, let me; often after <mah>) (r:zd:10725/zd:21305) (q:draft, low confidence)
ning maw = (i:1) (t:part) (f:everyday) (w:shall I/let me) (d:<ning>, I will, and <maw>, the question word: closes a sentence in which the speaker says what he means to do and asks the hearer to agree, shall I, let me, all right; stands after the verb) (r:zd:23957/zd:17663/zd:20280) (q:draft, low confidence)
ninga = (i:2) (t:n) (f:time) (w:Friday) (d:the fifth day of the week counted after Sunday, mostly as {ninga ni}; in news writing often followed by the English name of the day) (s:laithai) (r:zd:23797) (q:draft)
ningani = (i:1) (t:n) (c:ni) (f:time) (w:Friday) (d:<ninga>, Friday, and <ni>, day, written as one word; {Ningani-pha} is Good Friday) (j:ninga/ni) (r:zd:16940) (q:draft)
Ningbo = (i:1) (t:name) (c:city) (f:travel) (w:Ningbo) (d:port city in the east of China) (r:zd:11044) (q:draft)
ningin = (i:1) (t:part) (f:everyday) (d:<ning>, I will, with the linking <in>, written as one word: I will do this, and then; joins a first-person statement of intent to the next clause) (j:ning/in) (r:zd:20513/zd:23037) (q:draft)
ningkum = (i:1) (t:n) (f:time) (w:last year) (d:the year before this one; also written {ning kum}) (r:zd:24648) (q:draft, low confidence)
ningniang = (i:1) (t:adv) (f:everyday/body) (w:limply/droopingly/listlessly) (d:placed after a verb, describes something that droops, hangs or lies limp, or is done without spirit; {vul ningniang} is to be downcast and worn out) (r:zd:20646/zd:22683) (q:draft, low confidence)
ningtui = (i:1) (t:n) (f:food) (w:drink/liquor/beer) (d:word of songs and elevated speech for a drink, mostly <zu>, beer or liquor; compare <ningzu>) (r:zd:22653/zd:24234) (q:draft, low confidence)
ningzu = (i:1) (t:n) (f:food/social) (w:rice beer/wine) (d:word of songs for <zu>, the beer of a feast, mostly in the pair {ningzu aisa}, beer and meat) (s:zu) (r:zd:20131/zd:25393) (q:draft)
ninihsung = (i:1) (t:adv) (f:time) (w:for two days/during the two days) (d:<ninih> two days and <sung> during, written as one word: over the two days named, or within two days) (j:ninih/sung) (r:zd:11221/zd:13303/zd:14969) (q:draft)
ninkawmlak = (i:1) (t:n) (f:home/everyday) (w:rubbish heap/rubble/debris) (d:<nin>, rubbish, and <kawmlak>, the space among things, written as one word: among the rubbish, or among the rubble of a fallen house) (j:nin/kawmlak) (r:zd:13311/zd:11240) (q:draft)
ninkhawm = (i:1) (t:v) (f:home/work) (w:collect rubbish/collect garbage/pick up litter) (d:<nin>, dirt or rubbish, with <khawm>, here gather: gather up rubbish; {ninkhawm mawtaw} is a garbage truck) (r:zd:20089/zd:16790/zd:12785) (q:draft)
ninlak = (i:1) (t:n) (f:home/everyday) (w:rubbish/rubbish heap/garbage dump) (d:<nin>, dirt, with <lak>, midst: the place where rubbish lies or is thrown; {ninlak ah paai} is throw into the rubbish) (j:nin/lak) (r:zd:13129/zd:16695) (q:draft)
nino = (i:2) (t:n) (f:time) (w:Saturday) (d:the day of the week before <nipi>, Sunday, also {nino ni}; {Nipi Nino} together are the weekend days off work) (r:zd:16037/zd:24133) (q:draft, low confidence)
nino = (i:3) (t:n) (f:nature) (w:rising sun/morning sun) (d:<ni>, sun, with <no>, young: the sun that has just risen, as in {zing nino}, used as a picture of a new beginning; not a day of the week) (r:zd:24253) (q:draft, low confidence)
ninpaihna = (i:1) (t:n) (f:home/everyday) (w:rubbish dump/garbage dump/rubbish bin) (d:<nin>, dirt or rubbish, with <paihna>, the place of throwing: a place or container where rubbish is thrown away) (r:zd:11360/zd:17311) (q:draft)
ninpuakna = (i:1) (t:n) (f:home/work) (w:rubbish carrying/garbage collection) (d:<nin>, rubbish, and <puakna>, carrying, written as one word: the carrying away of rubbish; {ninpuakna mawtaw} is a garbage truck) (j:nin/puakna) (r:zd:17603/zd:12157) (q:draft)
ninte = (i:2) (t:n) (f:home/everyday) (w:rubbish/garbage/litter) (d:plural of <nin> for things thrown away, household waste that is collected or thrown out, not ritual uncleanness; brought out by <paih>, throw away) (r:zd:20131/zd:19408) (q:draft)
ninthem = (i:2) (t:n) (f:home/everyday) (w:rubbish/litter/waste/debris) (d:things thrown away or broken pieces lying about, as rubbish on a road or the debris of a building; brought out by <kaihkhop>, collect, and {tawh kidim}, full of, and not a single speck of dust) (s:nin) (r:zd:19176/zd:18145) (q:draft)
nipan = (i:1) (t:adv) (f:time) (w:from the day/since the day) (d:<ni>, day, and <pan>, from, written as one word: starting from that day or date; often followed by <kipan>) (j:ni/pan) (r:zd:20652/zd:12115/zd:14681) (q:draft)
nipek = (i:1) (t:adv) (f:time) (w:already on/back on) (d:<ni>, day, and <pek>, far back, written as one word after a date and followed by <in>, <panin> or <akipan>: already on that day, as early as that day) (j:ni/pek) (r:zd:12587/zd:15609) (q:draft)
nipen = (i:1) (t:phrase) (f:time) (w:the day/as for the day) (d:<ni>, day, and the topic marker <pen> written as one word: after a date or the name of a day, that day is what the sentence speaks about) (j:ni/pen) (r:zd:15007/zd:12231) (q:draft)
nipi = (i:2) (t:n) (f:time) (w:week) (d:a period of seven days, alone or as {nipi kal}, mostly before a number or after <tu>, this, <mai>, next, and <nung>, last: {nipi khat} is one week, while {nipi ni} is the day Sunday) (r:zd:23249/zd:21703/zd:23240) (q:draft)
nipi sang = (i:1) (t:n) (f:religion/education) (w:Sunday school) (d:<nipi>, Sunday, and <sang>, school: the class for teaching the Bible that a church holds on Sunday, chiefly for children; {nipi sang kah} is attend it and {nipi sang sia} is its teacher) (r:zd:9430/zd:17437) (q:draft)
nipikal = (i:1) (t:n) (f:time) (w:week) (d:a period of seven days; {nipikal khat} is one week and {nipikal sagih} is seven weeks) (s:nisagih)
Nipini = (i:2) (t:n) (f:time/religion) (w:Sunday) (d:in present-day use the first day of the week, the day of church worship, as in {Nipini kikhop}, the Sunday service; in the Bible text the same word is the Sabbath) (s:nipi) (r:zd:10743/ts:3375/zd:23539) (q:draft)
Nipisang = (i:1) (t:n) (f:religion/education) (j:nipi sang) (r:zd:23191/zd:21174) (q:draft)
Nipon = (i:1) (t:name) (c:land) (f:politics) (w:Japan) (d:Japan, from the Japanese name Nippon, used of the Japanese in the Second World War as {Nipon te}; also in the name Nippon Foundation) (s:Japan) (o:Japanese, Nippon) (r:zd:23283/zd:14844) (q:draft, low confidence)
nisim nuntakna = (i:1) (t:n) (f:everyday) (w:daily life/everyday life) (d:<nisim>, daily, and <nuntakna>, living: the life of every day; a possessive such as <i> or <na> stands before it and <ah> or <sungah> after it) (r:zd:20329/zd:22719) (q:draft)
nisim phial = (i:1) (t:adv) (f:time/everyday) (w:almost every day/practically daily/day after day) (d:<nisim>, every day, with <phial>, even or quite: so often that it is as good as every day; mostly followed by <in> or <a> at the head of a clause) (r:ts:6697/zd:11386) (q:draft)
nisimphial = (i:1) (t:adv) (f:time) (w:every single day/day after day) (d:<nisim>, daily, and the stressing word <phial> written as one word: every day without exception, usually followed by <in>) (j:nisim/phial) (r:zd:12093/zd:19543) (q:draft)
Nissan = (i:1) (t:name) (f:travel) (w:Nissan) (d:Japanese car maker and the make of its cars; {Nissan mawtaw} is a Nissan car) (r:zd:11342/zd:18691) (q:draft)
nisuah = (i:2) (t:n) (f:nature/travel) (w:east) (d:the direction in which the sun rises rather than the time of sunrise, before <lam>, side, or with <na> written apart, as in {nisuah lam} and {nisuah na}; set against <nitumna>, west) (s:nisuahna) (r:ts:12042/zd:25312/zd:23843) (q:draft)
nisuahnalam = (i:1) (t:n) (c:direction) (f:travel/nature) (w:east/east side/eastern part) (d:<nisuahna>, east, and <lam>, side or direction, written as one word: the east, the eastern side of a place) (j:nisuahna/lam) (r:zd:19141/zd:19514) (q:draft)
nisuhgah = (i:1) (t:n) (c:plant) (f:food) (w:date/date fruit) (d:<nisuh> and <gah> written as one word: the fruit of the date palm) (j:nisuh/gah) (r:zd:12698) (q:draft)
nisun = (i:1) (t:n) (f:time) (w:daytime/midday) (d:<ni>, day, and <sun>, daytime, written as one word: the daytime of a day, around noon; {Nipi nisun} is Sunday daytime) (j:ni/sun) (r:zd:24234/zd:19431) (q:draft)
nitaak = (i:1) (t:n) (f:time) (j:nitak) (r:zd:20944/zd:19166/zd:20172) (q:draft)
nitak = (i:1) (t:n) (f:time) (w:evening) (d:the end of the day, from late afternoon until dark; {nitak ciangin} is in the evening, and {nitak nai thum} is three in the afternoon) (a:zingsang) (r:1.8.11)
nitak an = (i:1) (t:phrase) (f:food/time) (w:dinner/supper) (d:the evening meal) (r:zai:dinner) (q:draft)
nitak lamin = (i:1) (t:adv) (f:time) (w:in the evening/at evening time) (d:<nitak>, evening, with <lam>, side or part, and the marker <in>, the same as <nitaklam> with <in>; here <lamin> is not the verb build: in the evening, placed after a date or a word such as <zanni>, yesterday, or <tua>, that) (s:nitaklam) (r:zd:23539/ts:3882) (q:draft)
nitak nai = (i:1) (t:phrase) (f:time) (w:in the evening at/pm) (d:<nitak>, evening, and <nai>, hour by the clock: placed before a number, that hour of the afternoon or evening, as {nitak nai 8}, 8 pm; the morning hours are {zingsang nai}) (r:zd:10892/zd:19654) (q:draft)
nitakkhat = (i:1) (t:adv) (f:time) (w:one evening/one night) (d:<nitak>, evening, and <khat>, one, written as one word: one evening, for one night) (j:nitak/khat) (r:zd:23616/zd:24276) (q:draft)
nitaklam = (i:1) (t:n) (f:time) (w:afternoon/evening) (d:<nitak>, evening, and <lam>, side, written as one word: the later part of the day, from the early afternoon until night, often followed by the hour) (j:nitak/lam) (r:zd:25280/zd:15307/zd:11897) (q:draft)
nitaklamdong = (i:1) (t:adv) (f:time) (w:until evening/up to the evening) (d:<nitaklam>, evening, and <dong>, until, written as one word: up to the evening, mostly after the name of a day) (j:nitaklam/dong) (r:zd:14919) (q:draft)
nitaksim = (i:1) (t:adv) (f:time) (w:every evening/nightly/every night) (d:<nitak>, evening, with <sim>, each, as in <nisim>, daily: every evening or every night; also {nitaksim in}) (r:zd:24276/zd:15941) (q:draft)
nitampi = (i:1) (t:n) (f:time) (w:many days) (d:<ni>, day, and <tampi>, many, written as one word) (j:ni/tampi) (r:zd:20920/zd:19176/zd:12941) (q:draft)
nitang = (i:1) (t:n) (f:nature) (j:nitaang) (r:zd:11441/zd:20747/zd:11438) (q:draft)
niteh = (i:2) (t:adv) (f:time) (w:some day/one day) (d:<ni>, day, with <teh>, here when: after <nikhat>, one day, it points to a day that is still to come, {nikhat niteh}, some day; not the sentence-final word of reported thought) (r:zd:14730/zd:21271) (q:draft)
nitha = (i:1) (t:n) (f:work) (w:daily wage/day's pay) (d:<ni>, day, with <tha>, strength or labour: the pay for one day of work, beside <khasum>, the monthly pay) (r:zd:17102/zd:11431/zd:25532) (q:draft)
nithak = (i:1) (t:n) (f:time) (w:new day) (d:<ni> day and <thak> new written as one word: a new day, often as a picture of a better time to come) (j:ni/thak) (r:zd:25300/zd:10725) (q:draft)
nithumsung = (i:1) (t:adv) (f:time) (w:for three days/within three days) (d:<nithum>, three days, and <sung>, during, written as one word) (j:nithum/sung) (r:zd:14937/zd:15554) (q:draft)
nithupi = (i:1) (t:n) (f:time/religion/social) (w:special day/holy day/festival day) (d:<ni> day and <thupi> important written as one word: a day kept as special, a religious or public holiday) (j:ni/thupi) (r:zd:19662/zd:24330) (q:draft)
nitrogen = (i:1) (t:n) (f:nature) (w:nitrogen) (d:the chemical element, spoken of as a plant nutrient in {nitrogen dat}) (o:English) (r:zd:23729/zd:21006) (q:draft)
nitumkuan = (i:1) (t:n) (f:time) (w:dusk/toward sunset/evening) (d:<nitum> and <kuan> written as one word: the time when the sun is about to set) (j:nitum/kuan) (r:zd:17622/zd:19697) (q:draft)
nitumna gamte = (i:1) (t:n) (f:politics) (w:the West/Western countries/Western nations) (d:<nitumna>, west, and <gamte>, countries: the countries of the West taken together, Europe and North America, as a term of world affairs) (r:zd:18952/zd:24283) (q:draft)
nitumna lam = (i:1) (t:n) (c:direction) (f:nature/travel) (w:the west/west side/western part) (d:<nitumna>, west, and <lam>, way or side: the west, the western side of a place, and the West as a part of the world; stands before a noun as in {nitumna lam gam}, the western countries, or after a possessor) (a:nisuahna) (r:ts:3284/zd:23038/zd:16651) (q:draft)
nizan = (i:1) (t:n) (f:time) (w:night of the day/evening) (d:<ni>, day, and <zan>, night, written as one word after the name of a day or event: the night of that day) (j:ni/zan) (r:zd:16433) (q:draft, low confidence)
nizong = (i:1) (t:adv) (f:time) (w:the day also/on the day too) (d:<ni>, day, and <zong>, also, written as one word, after the name or description of a day: that day too) (j:ni/zong) (r:zd:19579/zd:18042) (q:draft)
nlah = (i:1) (t:part) (f:everyday) (d:<n>, the short form of <in> after an apostrophe, and the particle <lah> written as one word, as in {te'nlah}: as for them, they on their part) (j:n/lah) (r:zd:15606) (q:draft, low confidence)
NLD = (i:1) (t:name) (f:politics) (w:NLD/National League for Democracy) (d:a political party of Myanmar, named by the letters of its English name) (r:zd:21978/zd:17344/zd:24932) (q:draft)
nna = (i:1) (t:n) (f:work) (w:work/task) (d:work, a task to be done, as in {nna sem}, do work; the word that forms <nasep>, written with a double n) (r:zd:9441/zd:9440) (q:draft)
no = (i:2) (t:n) (f:everyday/it) (w:number/no.) (d:the English abbreviation for number, written after a word such as <phone> or before a figure, as in {phone no} and {no 4}; not the pronoun) (o:English, no.) (r:zd:20968/ts:9093) (q:draft)
Nobel = (i:1) (t:name) (f:education/media) (w:Nobel) (d:in {Nobel Prize}, the international prizes given each year for science, literature and peace, named after Alfred Nobel) (r:zd:21183/zd:21978) (q:draft)
nohset = (i:1) (t:v) (f:social/family) (w:fuss over/humour/soothe/pamper) (d:treat a person or a thing with fond attention, speak to someone soothingly to please or calm him; related to <noh>, caress) (r:zd:24310/zd:20935/zd:17854) (q:draft, low confidence)
Noida = (i:1) (t:name) (c:city) (f:travel) (w:Noida) (d:a city in the state of Uttar Pradesh, India, near Delhi; in the articles as Greater Noida) (r:zd:20475) (q:draft)
nokhat = (i:1) (t:phrase) (f:everyday) (w:a young/a little) (d:<no>, here young or small, and <khat>, one, written as one word after a noun: {numei nokhat} is a young woman, {huntom nokhat} is a short little while) (j:no/khat) (r:zd:12110/zd:23843) (q:draft, low confidence)
Nokia = (i:1) (t:name) (f:it) (w:Nokia) (d:a company that makes mobile phones, and a phone of that make) (r:zd:11506/zd:17442) (q:draft)
nominate = (i:1) (t:v) (f:politics) (w:nominate/put forward) (d:name a person as a candidate for an office; used as a Zolai verb, as in {aki nominate}, he is nominated) (o:English) (r:zd:20795/zd:23343) (q:draft, low confidence)
nominee = (i:1) (t:n) (f:politics) (w:nominee/candidate) (d:the person a party puts forward for an office) (o:English) (r:zd:23513) (q:draft, low confidence)
nomvalh = (i:1) (t:v) (f:everyday/nature) (j:nawmvalh) (r:zd:11986/zd:18093) (q:draft)
non = (i:1) (t:adv) (f:everyday) (j:nawn) (r:zd:15662/zd:15324/zd:25357) (q:draft)
nongkhak = (i:1) (t:v) (f:everyday/it) (w:you send me/you send us) (d:<nong>, you to me, and <khak>, send, written as one word: you send money, a picture or a message to me or to us) (j:nong/khak) (r:zd:16302/zd:10964) (q:draft)
nongpiak = (i:1) (t:v) (f:everyday) (w:you give me/you give us) (d:<nong>, you to me or us, and <piak>, give, written as one word: that you give or gave me or us) (j:nong/piak) (r:zd:17965/zd:15874) (q:draft)
nongpuak = (i:1) (t:v) (f:everyday/work) (w:you send/you bring) (d:<nong> and <puak>, send, written as one word: you send or deliver something to us) (j:nong/puak) (r:zd:15109/zd:16813) (q:draft)
nongsap = (i:1) (t:v) (f:everyday/social) (w:you call me) (d:<nong>, you toward me, and <sap>, call, written as one word: you call me, also of a telephone call) (j:nong/sap) (r:zd:14791/zd:16813) (q:draft)
nongsim = (i:1) (t:v) (f:education/everyday) (w:you read) (d:<nong>, you to me or to us, and <sim>, read, written as one word: you read what I or we wrote; {lai nongsim sak} is that you read my writing) (j:nong/sim) (r:zd:22981) (q:draft, low confidence)
nongsimsak = (i:1) (t:v) (f:media/education) (w:you read for us) (d:<nong>, you to me or us, with <simsak>, read for, written as one word: you have read it for us; {lai nongsimsak lungdam} thanks a reader for reading) (j:nong/simsak) (r:zd:15489) (q:draft, low confidence)
nonlo = (i:1) (t:adv) (f:everyday) (j:nawnlo) (r:zd:20999/zd:24234/zd:20902) (q:draft)
nonloh = (i:1) (t:adv) (f:everyday) (w:no longer/not again/no more) (d:{nawn loh} written as one word with <non> for <nawn>, any more, and <loh>, not: placed after a verb and before <nading> or <ding>, so that it does not happen again) (j:nawn/loh) (r:zd:23901/zd:17326) (q:draft)
Nonthaburi = (i:1) (t:name) (c:land/city) (f:travel) (w:Nonthaburi) (d:a province and city of <Thailand> next to <Bangkok>) (r:zd:11803/zd:17200) (q:draft)
Noodle = (i:1) (t:n) (f:food) (w:noodles/noodle) (d:noodles as a dish; also explained as <khauhsuai>) (o:English) (r:zd:11364/zd:15276) (q:draft)
nop man = (i:1) (t:conj) (f:everyday) (w:because of wanting to/out of a wish to) (d:<nop>, want, and <man>, reason or because: placed after a verb, it gives the wish to do that action as the reason; often followed by <ahihi>, it is, or by <in>) (r:zd:21384/zd:25139) (q:draft)
nopcitak = (i:1) (t:adv) (f:social) (w:joyfully/merrily/festively) (d:<nopci>, pleasant, with <tak>, written as one word: in a joyful and festive way, said of how a feast or celebration is held; often {nopcitak in}) (j:nopci/tak) (r:zd:26238/zd:12259) (q:draft)
nopleh = (i:1) (t:phrase) (f:everyday) (w:if one wants to) (d:<nop> and <leh> written as one word, placed after a verb: if one wants to do it) (j:nop/leh) (r:zd:19898/zd:12267/zd:15602) (q:draft)
noploh = (i:1) (t:v) (f:everyday) (w:not want to/be unwilling) (d:<nop>, want, and <loh>, not, written as one word after a verb: not wanting to do it, the form used before a noun and before words such as <ciang> and <man>) (j:nop/loh) (r:zd:25924/zd:22415) (q:draft)
noplohna = (i:1) (t:n) (f:everyday) (w:unwillingness/reluctance) (d:<nop> and <lohna> written as one word, after a verb: not wanting to do it, as {up noplohna}, unwillingness to believe) (j:nop/lohna) (r:zd:25100/zd:20841) (q:draft)
noplohna = (i:2) (t:n) (f:health/body) (w:discomfort/unease) (d:the state of not being comfortable or at ease, in body or in mind; {lung noplohna} is uneasiness of heart) (r:zd:21633/zd:22959) (q:draft)
nopluat = (i:1) (t:v) (f:everyday) (w:want too much/want very much) (d:<nop>, want, and <luat>, too much, written as one word after a verb and before <man>: because of wanting so much to do it) (j:nop/luat) (r:zd:25917/zd:19671) (q:draft)
nopluatna = (i:1) (t:n) (f:everyday) (w:great desire/eagerness) (d:<nop>, want to, and <luatna> written as one word: the great wish to do the thing named by the verb before it) (j:nop/luatna) (r:zd:25225/zd:26495) (q:draft)
nopman = (i:1) (t:conj) (f:everyday) (w:because of wanting to/out of a wish to) (d:<nop>, want, and <man>, here short for <manin>, because, written as one word, after a verb: because someone wants to do it) (j:nop/man) (r:zd:13127/zd:20800) (q:draft)
nopmawh = (i:1) (t:adj) (f:everyday/social) (w:uncomfortable/unpleasant/awkward/embarrassing) (d:not pleasant to bear, causing unease or embarrassment; {nopmawh sa} is feel uncomfortable or embarrassed) (r:zd:13314/zd:19856/zd:10929) (q:draft)
nopmawhsa = (i:1) (t:v) (f:everyday/social) (w:feel uncomfortable/be bothered/be upset) (d:<nopmawh>, unpleasant, with <sa>, feel, written as one word: find something unpleasant, be bothered or embarrassed by it) (j:nopmawh/sa) (r:zd:19468/zd:16947) (q:draft)
nopmawhsak = (i:1) (t:v) (f:social/everyday) (w:trouble/make uncomfortable/make difficult/bother) (d:<nopmawh>, uncomfortable, and <sak>, written as one word: make things unpleasant or hard for a person or a matter; also find something uncomfortable) (j:nopmawh/sak) (r:zd:21033) (q:draft)
nopna dahna = (i:1) (t:n) (f:social/family) (w:joy and sorrow/glad and sad occasions) (d:<nopna>, happiness, and <dahna>, grief: a pair for the happy and sad events of community life, such as weddings and funerals; mostly as {nopna dahna ah}, at times of joy and of mourning) (r:zd:12337/zd:19139) (q:draft)
nopna lungsim = (i:1) (t:n) (f:everyday/social) (w:desire/wish/mindset) (d:<nopna.2>, the wish to do what the verb before it says, and <lungsim>, mind: placed after a verb, the desire or the mindset of wanting to do it; {neih nopna lungsim} is the wish to have) (r:zd:24079/zd:23989) (q:draft)
nopneh = (i:1) (t:v) (f:social) (w:look down on/bully/take advantage of/belittle) (d:treat a person or a people as weak and of no account, and so push them around; often paired with <simmawh>, despise, and also used with <bawl>) (r:zd:10842/zd:23394/zd:19637) (q:draft)
nopnehbawl = (i:1) (t:v) (f:social/politics) (w:molest/assault/abuse) (d:<nopneh>, take advantage of, and <bawl>, do, written as one word: molest or sexually assault a person, in news reports mostly of a man and a woman) (j:nopneh/bawl) (r:zd:12794) (q:draft)
nopnehna = (i:1) (t:n) (f:social) (w:bullying/belittling/contempt) (d:the act of looking down on someone and taking advantage of them, from <nopneh>) (b:nopneh) (r:zd:16865/zd:23419) (q:draft)
nopnop = (i:1) (t:adv) (f:everyday) (w:whatever one wants/as one pleases) (d:<nop>, want, said twice, after a verb or after <a>: as much or whatever one wishes to do) (b:nop) (r:zd:25165/zd:15894) (q:draft)
noptak = (i:1) (t:adv) (f:everyday) (w:easily/comfortably/pleasantly) (d:with ease and comfort, without trouble; usually {noptak in}) (s:nuamtak) (r:zd:11860/zd:12210) (q:draft)
noptuam = (i:3) (t:v) (f:everyday/social) (w:benefit/be better off) (d:be helped or made better off by something, not of sickness; {noptuam pih} is benefit from a thing or person and {noptuam lawh} is gain by it) (r:zd:19714/zd:25624/zd:15558) (q:draft)
noptuamding = (i:1) (t:v) (f:everyday/social) (w:will benefit/for the benefit of) (d:<noptuam> and <ding> written as one word: will be better off, or so that someone is better off) (j:noptuam/ding) (r:zd:17607/zd:25569) (q:draft)
noptuamlo = (i:1) (t:v) (f:health) (w:not get better/not improve) (d:<noptuam> and <lo> written as one word: of a sick person or an illness, not getting any better) (j:noptuam/lo) (r:zd:12359/zd:11382) (q:draft)
noptuampih = (i:1) (t:v) (f:everyday) (w:benefit from/find helpful/profit by) (d:<noptuam>, benefit, with <pih>, together with: gain good from something or someone) (s:phattuampih) (b:noptuam) (r:zd:21918/zd:22922) (q:draft)
noptuamta = (i:1) (t:v) (f:health) (w:have got better/have recovered) (d:<noptuam>, get better, and <ta> written as one word: has now got better, of a sick or injured person) (j:noptuam/ta) (r:zd:14858/zd:12450) (q:draft)
nopzat = (i:1) (t:v) (f:everyday) (w:like to use/be fond of using) (d:<nop> and <zat> written as one word: use something gladly and much; {nopzat le mawkzat} is use for pleasure and wasteful use) (j:nop/zat) (r:zd:18200/zd:15976) (q:draft)
nopzaw = (i:1) (t:adj) (f:everyday) (w:more pleasant/more comfortable/better) (d:<nop>, pleasant or comfortable, and <zaw> written as one word: more pleasant, more comfortable) (j:nop/zaw) (r:zd:25932/zd:11734) (q:draft)
normal = (i:1) (t:adj) (f:everyday/health) (w:normal/ordinary) (d:usual, not special or abnormal) (o:English) (r:zd:22116/zd:20367) (q:draft, low confidence)
Northfield = (i:1) (t:name) (c:khua) (f:religion) (w:Northfield) (d:town in Massachusetts in the United States, the home of the evangelist D. L. Moody) (r:zd:9221) (q:draft)
Norway = (i:1) (t:name) (c:land) (f:travel/politics) (w:Norway) (d:a country in northern Europe) (r:zd:26566/zd:20513) (q:draft)
nosuah = (i:1) (t:v) (f:health/body) (w:be refreshed/be invigorated/become lively) (d:become fresh, young and full of life in body or mind; with <sak>, enliven or stimulate, and of children made restless by caffeine) (r:zd:20195/zd:19245) (q:draft, low confidence)
nosuahna = (i:1) (t:n) (f:health/body) (w:rejuvenation/freshness/youthfulness) (d:becoming young and fresh again in body or mind) (r:zd:20747/zd:20778/zd:21148) (q:draft)
nosuaksak = (i:1) (t:v) (f:health/body) (w:refresh/revive/rejuvenate) (d:<nosuak>, become fresh, with <sak>, cause: make fresh, young or strong again) (b:nosuak) (r:zd:20778/zd:24276) (q:draft)
not = (i:1) (t:v) (f:everyday) (w:push/drive back/repulse) (d:push or force someone back; {not kik} is drive back and {not zo} is be able to repulse) (s:nawt)
notawh = (i:1) (t:phrase) (f:everyday/social) (w:with you) (d:<no>, you, said to more than one, and <tawh>, with, written as one word: with you, together with you) (j:no/tawh) (r:zd:8667/zd:24038) (q:draft)
note = (i:3) (t:pron) (f:everyday) (w:you) (d:you, said to more than one person; with <kiangah>, to you, and with <lakah>, among you) (s:nomau) (b:no) (r:43.6.64/1.1.29) plural form of <no>
notebook = (i:1) (t:n) (f:education) (w:notebook) (d:a book for writing notes in; {Notebook Computer} is a small portable computer) (o:English) (r:zd:11452/zd:17666/zd:24004) (q:draft)
Notes = (i:1) (t:n) (f:education) (w:notes/note) (d:short written record of what is read or heard, as in {notes la}, take notes; also the heading of an explanatory remark below a text) (o:English) (r:zd:26531/zd:24244) (q:draft, low confidence)
Notice = (i:1) (t:n) (f:social/work) (w:notice/written notice) (d:a written or posted announcement or warning, as from an office, a company or the police) (o:English) (r:zd:11553/zd:19215) (q:draft)
Notification = (i:1) (t:n) (f:it/politics) (w:notification/notice) (d:an official written notice of a government body or an organisation, or the alert a phone gives) (s:theihsakna) (o:English) (r:zd:17618) (q:draft, low confidence)
novel = (i:1) (t:n) (f:media/education) (w:novel) (d:a long written story, a book of fiction; in {novel coronavirus} it is only part of an English name) (o:English) (r:zd:9244/zd:9265) (q:draft)
nozong = (i:1) (t:pron) (f:everyday) (w:you also/you too) (d:<no>, you, said to more than one person, and <zong>, also, written as one word) (j:no/zong) (r:zd:15874/zd:20257) (q:draft)
NST = (i:1) (t:name) (f:media) (w:New Straits Times/NST) (d:abbreviation of New Straits Times, an English-language newspaper of Malaysia, named as the source of news) (r:zd:19721/zd:13078) (q:draft)
nteh = (i:1) (t:part) (f:everyday) (j:inteh) (r:zd:16337/zd:19108) (q:draft)
nu = (i:1) (t:n) (f:family) (w:mother) (d:mother; {a nu leh a pa} is his mother and father) (a:pa) (r:41.3.33)
nu = (i:5) (t:n) (f:social) (w:Mrs/Madam) (d:title of respect placed before the name of a married or older woman, as <pa> is placed before the name of a man) (r:zd:18234/zd:17409) (q:draft)
nu leh pa = (i:1) (t:phrase) (f:family) (w:parent/parents) (d:mother and father, the parents of a person) (r:zai:parent) (q:draft)
nua = (i:1) (t:prep) (f:time) (w:after/behind) (d:poetic form of <nung>: {ka nua ciangah} is after me, {a pham nua ciang} is after she has died) (r:zd:24086/zd:24176) (q:draft, low confidence)
nuai aa = (i:1) (t:adj) (f:everyday/media) (w:following/below) (d:<nuai>, below, and <aa>, of: with <a> before it, {a nuai aa} is what is written below, the following; it stands before a noun, and {a nuai aa bangin} is as follows) (r:zd:20786/zd:25925/zd:23733) (q:draft)
nuaia = (i:1) (t:adv) (f:everyday) (w:below/following) (d:<nuai>, below, and the linking <a> written as one word: that is below; {a nuaia bang} is as below, as follows) (j:nuai/a) (r:zd:22065/zd:16813/zd:22975) (q:draft)
nuaicip = (i:1) (t:v) (f:politics/everyday) (w:crush/press down/overrun/suppress) (d:press something down under one so that it stays there, as a wheel going over a thing; in war news, overrun a position or put an enemy down) (r:zd:11251/ts:4850) (q:draft)
nuailam = (i:2) (t:n) (f:travel/politics) (w:illegal route/unofficial way/underground) (d:the way that is not lawful or not open, set against <tunglam>, the official way: of going to another country without papers, and of a group that works in secret) (r:zd:19953/ts:10538) (q:draft)
nuainet = (i:1) (t:v) (f:social) (w:put down/belittle/keep down) (d:press a person down as lower than oneself; found before <simmawhna>, contempt, and <langbawlna>, opposition) (r:zd:17132) (q:draft, low confidence)
nuaisiah = (i:3) (t:n) (f:social/work) (w:subordinate/inferior) (d:those below one in rank or standing, in the pair {tungsiah nuaisiah}, those above and those below) (r:zd:24164) (q:draft, low confidence)
nuaisiahte = (i:1) (t:n) (f:everyday/social) (w:those below/those under/those younger) (d:<nuaisiah> downward with the plural <te>: the people from a stated age or height downward, and in general those who are lower than oneself) (a:tungsiahte) (b:nuaisiah) (r:zd:21925/zd:24276) (q:draft)
nuaizan = (i:1) (t:v) (f:politics) (w:suppress/crush/crack down on) (d:put down opponents by force, or press someone down) (r:zd:25109) (q:draft, low confidence)
nuakkhuan = (i:1) (t:n) (f:family/social) (w:leave to sulk/freedom to sulk) (d:<nuak>, sulk, with <khuan>, leave or permission: the freedom to sulk and be coaxed, which a person has only with his or her own parents) (r:zd:17395) (q:draft, low confidence)
nuaksan = (i:1) (t:v) (f:social/politics) (w:shun/boycott/turn away from) (d:turn away from a person or a thing in displeasure and have no part in it, from <nuak>, take offence) (r:zd:26252/zd:24743) (q:draft)
nuam = (i:1) (t:v) (f:everyday) (w:want) (d:want or be willing to do something, placed after the verb; with <kei> or <lo>, not want to) (s:deih/nop)
nuam = (i:3) (t:adj) (f:everyday/social) (w:happy/glad/pleasant) (d:happy or glad; {nuam mahmah} is very glad, and {lung nuam} is glad at heart)
nuam kisa = (i:1) (t:v) (f:everyday/social) (w:be happy/be pleased/enjoy) (d:<nuam.3>, happy or pleasant, and <kisa>, feel oneself: feel happy, be pleased, enjoy something; here <nuam> is not want; often followed by <mahmah>) (s:nuamsa) (r:zd:22941/zd:18194) (q:draft)
nuamding = (i:1) (t:v) (f:everyday) (w:will want to/would want to/will be glad) (d:<nuam> and <ding> written as one word: after a verb, will or would want to do it; after <lung>, heart, will be glad) (j:nuam/ding) (r:zd:17448/zd:12050) (q:draft)
nuamhetlo = (i:1) (t:adj) (f:everyday/social) (w:not pleased at all/very unhappy/displeased) (d:<nuam>, glad, and <hetlo>, not at all, written as one word: not glad at all, upset or displeased; {lung nuamhetlo} is sad at heart) (j:nuam/hetlo) (r:zd:20263/zd:14561/zd:11557) (q:draft)
nuamhi = (i:1) (t:v) (f:everyday) (w:want to/wish to) (d:<nuam>, want, and the sentence-final <hi> written as one word: closes a statement of what someone wants to do) (j:nuam/hi) (r:zd:23022/zd:20905/zd:14579) (q:draft)
nuamhiam = (i:1) (t:phrase) (f:everyday) (w:do you want to) (d:<nuam>, want, and the question word <hiam> written as one word, at the end of a question after a verb: do you want to) (j:nuam/hiam) (r:zd:13088/zd:24276) (q:draft)
nuamin = (i:2) (t:v) (f:everyday) (w:wanting to/wishing to) (d:<nuam>, want, with the connective ending {-in}, placed after a verb: wanting to do it, said as the reason for the action that follows, as in {mu nuamin}, wanting to see) (r:zd:20334/zd:24673) (q:draft)
nuamin = (i:3) (t:adv) (f:everyday) (w:happily/gladly) (d:<nuam>, happy, with the ending {-in}: happily or being glad, not after a verb of action; {lung nuamin} is with a glad heart) (r:zd:23803/zd:20942) (q:draft, low confidence)
nuamkei = (i:1) (t:v) (f:everyday) (w:not want to/be unwilling) (d:<nuam>, want, with the negative <kei>, written as one word after a verb: not want to do it) (j:nuam/kei) (r:zd:14927/zd:17779/zd:19166) (q:draft)
nuamkisa = (i:1) (t:v) (f:everyday/social) (w:like to/find pleasant/prefer) (d:<nuam> and <kisa> written as one word after a verb: people find it pleasant to do, they like to; with <zaw>, prefer) (j:nuam/kisa) (r:zd:22364/zd:24289) (q:draft)
nuamlai = (i:1) (t:v) (f:everyday) (w:still want to) (d:<nuam> and <lai> written as one word, placed after a verb: still want to do it) (j:nuam/lai) (r:zd:17804/zd:24955) (q:draft)
nuamlo = (i:1) (t:v) (f:everyday) (w:not want/be unwilling) (d:<nuam> and <lo> written as one word: after a verb, not want to do it; after <lung>, heart, not happy, as in {a lung nuamlo}, he is unhappy) (j:nuam/lo) (r:zd:19662/zd:22586/zd:12928) (q:draft)
nuamlote = (i:1) (t:n) (f:everyday) (w:those who do not want to/the unwilling) (d:<nuam> and <lote> written as one word, after a verb: those who do not want to do it) (j:nuam/lote) (r:zd:11571/zd:25206/zd:16424) (q:draft)
nuamlua = (i:2) (t:v) (f:everyday) (w:want very much/be eager/long to) (d:placed after a verb, <nuam.1> want with <lua>, too much: want very much to do what the verb says, as in {sem nuamlua}, be eager to work; not the being happy of the other sense) (b:nuam) (r:ts:3125/zd:22827/zd:23773) (q:draft)
nuammahmah = (i:1) (t:phrase) (f:everyday) (w:very pleasant/want very much) (d:<nuam> and <mahmah>, very, written as one word: very pleasant or comfortable, and after a verb want very much to do it) (j:nuam/mahmah) (r:zd:19166/zd:23745) (q:draft)
nuamnawn = (i:1) (t:v) (f:everyday) (w:want any longer/want any more) (d:<nuam> and <nawn> written as one word after a verb and before a negative such as <keng> or <loin>: no longer want to do it) (j:nuam/nawn) (r:zd:14883/zd:21974) (q:draft)
nuamnawnlo = (i:1) (t:v) (f:everyday) (w:no longer want to) (d:<nuam>, want, and <nawnlo>, no longer, written as one word after a verb: not want to do it any more) (j:nuam/nawnlo) (r:zd:11457/zd:12021) (q:draft)
nuampah = (i:1) (t:v) (f:everyday) (w:want at once/be glad at once) (d:<nuam> and <pah> written as one word: after a verb, want to do it right away; of a state, become pleasant or happy at once) (j:nuam/pah) (r:zd:12504/zd:21115) (q:draft, low confidence)
nuampeuh = (i:1) (t:phrase) (f:everyday) (w:whoever wants to/anyone wishing to) (d:<nuam>, want, and <peuh>, any, written as one word after a verb: anyone at all who wants to do it) (j:nuam/peuh) (r:zd:25212/zd:14826) (q:draft)
nuamsakna = (i:1) (t:n) (f:everyday/social) (w:happiness/pleasure/enjoyment) (d:<nuamsa>, be happy or enjoy, with the noun suffix {-na}: the state of being happy, pleasure or comfort) (b:nuamsa) (r:zd:16625/ts:11162) (q:draft)
nuamsalo = (i:1) (t:v) (f:everyday) (w:not be happy/not enjoy/be unwilling) (d:<nuamsa> and <lo> written as one word: not be happy with, not enjoy doing) (j:nuamsa/lo) (r:zd:20979) (q:draft)
nuamta = (i:1) (t:v) (f:everyday) (w:want to/wish to) (d:<nuam>, want, and the marker <ta> written as one word after a verb: now want to; before a noun, the one who wants to) (j:nuam/ta) (r:zd:15748) (q:draft, low confidence)
nuamtak kizo = (i:1) (t:phrase) (f:media/social) (w:concluded happily/successfully held) (d:<nuamtak>, pleasantly, and <kizo>, here be finished: the usual headline for a report on an event, the event was held and ended well; the name of the event stands before it) (r:zd:26238/zd:21127) (q:draft)
nuamtaka = (i:1) (t:adv) (f:everyday) (w:happily/pleasantly/comfortably/at ease) (d:<nuam>, pleasant, and <taka>, which makes an adverb, written as one word; stands before the verb it describes) (s:nuamtakin/nuamtak) (b:nuam) (j:nuam/taka) (r:zd:19826/zd:16078) (q:draft)
nuamtein = (i:1) (t:phrase) (f:everyday) (w:those who want to) (d:<nuamte>, those who want, and the subject marker <in>, written as one word after a verb: those who want to do it, as the ones who then act) (j:nuamte/in) (r:zd:23005) (q:draft)
nuamzawding = (i:1) (t:adj) (f:everyday) (w:will be more pleasant/more comfortable/easier) (d:<nuamzaw>, more pleasant, and <ding> written as one word: so as to be or that will be more pleasant or convenient) (j:nuamzaw/ding) (r:zd:11199/zd:20236) (q:draft)
nuapang = (i:1) (t:n) (f:family/everyday) (j:naupang) (r:zd:22868/zd:19606) (q:draft)
nuclear = (i:1) (t:adj) (f:politics/it) (w:nuclear) (d:placed before a noun; <nuclear galvan> is nuclear weapons) (o:English) (r:zd:10988/zd:10788) (q:draft)
nuclear galvan = (i:1) (t:n) (f:politics) (w:nuclear weapon/nuclear weapons) (d:<nuclear>, the English word, and <galvan>, weapons: a nuclear weapon or nuclear arms) (r:zd:10788/zd:17990/zd:10988) (q:draft)
