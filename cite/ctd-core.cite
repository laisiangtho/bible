sading = (i:1) (t:v) (f:social/media) (w:to sing/will sing) (d:<sa>, here the verb sing, and <ding> written as one word: will sing, or in order to sing) (j:sa/ding) (r:zd:25318) (q:draft)
sading = (i:2) (t:v) (f:everyday/health) (w:will find/will feel) (d:<sa>, here the verb feel or consider that follows a describing word, and <ding> written as one word: {hak sading} is will find it hard) (j:sa/ding) (r:zd:20263) (q:draft, low confidence)
Safety = (i:1) (t:n) (f:social/travel) (w:safety) (d:being safe from harm or accident; the English word used in news reports) (s:bitna) (o:English) (r:zd:15103/zd:12217) (q:draft)
Sagaing = (i:1) (t:name) (c:land) (f:politics/travel) (w:Sagaing) (d:region in the north-west of Myanmar that borders Chin State and includes Kalay; also the town of that name) (r:zd:20173/zd:19239/zd:9266) (q:draft)
sahang = (i:2) (t:n) (c:animal) (f:nature) (w:tiger) (d:the tiger, the large striped wild cat, as kept in a zoo and hunted in the hills; named beside <humpi>, lion, and <kamkei>, leopard, as a different animal, where the Bible rows have only the general wild beast) (r:zd:11044/ts:3375/zd:12869) (q:draft)
sahawm = (i:1) (t:n) (f:social/food) (w:sharing of meat/distribution of meat) (d:<sa>, meat, and <hawm>, share out, written as one word: the customary sharing out of meat at a feast, often paired as {zuhawm sahawm}, the sharing of beer and meat; {vompi sahawm}, sharing bear meat, is said of an unequal division) (j:sa/hawm) (r:zd:15377/zd:23441) (q:draft)
sahdah = (i:1) (t:n) (f:health/everyday) (w:chewing tobacco) (d:tobacco that is held in the mouth or chewed, named beside cigarettes, <khaini> and <kunza> among harmful habits) (r:zd:17635/zd:16398) (q:draft)
sahetlo = (i:1) (t:v) (f:everyday) (w:not think at all/not consider at all/not mind at all) (d:<sa>, here think or feel something to be so, with <hetlo>, not at all, written as one word and placed after a describing word: {dik sahetlo} is not think it right at all, {phamawh sahetlo} not mind at all) (j:sa/hetlo) (r:zd:11248/zd:16833) (q:draft)
sahlua = (i:1) (t:adj) (f:nature) (w:too thick/very dense) (d:<sah> and <lua> written as one word: too thick, mostly of fog, cloud or smoke through which nothing can be seen) (j:sah/lua) (r:zd:17247/zd:12831) (q:draft)
saidawl = (i:1) (t:n) (f:work/everyday) (w:shop/stall/store) (d:a shop or stall where goods are sold; {vanzuakna saidawl} is a shop selling goods) (r:zd:20287/zd:19936) (q:draft)
saigei = (i:1) (t:n) (f:work/everyday) (w:shop/stall/outlet) (d:a shop or stall where things are sold or a service is given; {anzuakna saigei} is a food stall) (r:zd:17368/zd:11248/zd:13161) (q:draft, low confidence)
saihapaak = (i:1) (t:n) (f:nature/work) (w:ivory/elephant tusk) (d:<saiha>, elephant tusk, with <paak>: ivory as a traded and smuggled good; what <paak> adds here is not certain) (s:saiha) (r:zd:13278/zd:10759) (q:draft, low confidence)
saihapak = (i:1) (t:n) (f:nature/work) (w:ivory/elephant tusk) (d:the tusk of an elephant and the ivory from it, from <saiha>, ivory; a thing of great value) (s:saiha) (r:zd:14859/ts:301) (q:draft)
saikel = (i:1) (t:n) (f:travel) (w:motorcycle/bicycle) (d:a two-wheeled vehicle: a bicycle, and in present-day writing mostly a motorcycle, also called {mawtaw saikel}) (o:English, cycle) (r:zd:25937/zd:21421/zd:23437) (q:draft)
saikhat = (i:1) (t:n) (f:work/everyday) (w:a shop/a stall) (d:<sai>, shop, and <khat> written as one word: a shop, a stall or an eating place) (j:sai/khat) (r:zd:19398/zd:13181/zd:13048) (q:draft)
saimai = (i:1) (t:n) (f:work/travel) (w:shop front/front of the shop) (d:<sai>, shop, and <mai>, front, written as one word: the front of a shop or restaurant; {saimai ah} is in front of the shop) (j:sai/mai) (r:zd:17560/zd:12696/zd:14523) (q:draft)
Saimual = (i:1) (t:name) (c:mountain/place) (f:travel/nature) (w:Saimual) (d:hill about 6500 feet high at the entrance of Tedim town, with a view over the town and a place of prayer) (r:zd:18266/zd:10866) (q:draft)
sain = (i:1) (t:part) (f:everyday) (d:<sa> as the marker of a completed state and <in> written as one word after a verb or describing word: in that state, while being so or doing so) (r:zd:16379/zd:23170) (q:draft, low confidence)
sainei = (i:1) (t:n) (f:work) (w:shop owner/shopkeeper/proprietor) (d:<sai>, shop, with <nei>, have: the owner of a shop or restaurant) (r:zd:16832) (q:draft)
saineipa = (i:1) (t:n) (f:work) (w:shop owner/shopkeeper) (d:<sainei> and <pa> written as one word: the man who owns a shop) (j:sainei/pa) (r:zd:17232/zd:14961) (q:draft)
saingak = (i:1) (t:n) (f:work) (w:shopkeeper/shop assistant) (d:<sai>, shop, with <ngak>, keep watch: the person who minds a shop and serves its customers) (r:zd:17260/zd:17313/zd:13145) (q:draft)
saipi = (i:2) (t:n) (f:work/food) (w:big shop/store/big restaurant) (d:a large shop or eating place, from the Burmese loan <sai>, shop, with <pi>, big, and not the animal; {an saipi} is a big restaurant) (r:zd:23301/zd:18213/zd:25068) (q:draft)
saipi = (i:3) (t:n) (f:politics) (w:minister) (d:the head of a government ministry, named after the matter in charge as in {gamsung vai saipi}, minister of home affairs) (r:ts:1598) (q:draft, low confidence)
saisai = (i:1) (t:adv) (f:everyday) (w:hurriedly/busily/in a rush) (d:placed after a verb: the action is done in haste or with bustle; {kizen saisai} is busy and energetic) (r:zd:12267/zd:15615) (q:draft, low confidence)
saisung = (i:1) (t:n) (f:work) (w:shop/inside of a shop) (d:<sai>, shop, with <sung>, inside, written as one word: the inside of a shop, the shop premises; {saisung ah} is in the shop) (j:sai/sung) (r:zd:22282/zd:21659/zd:12754) (q:draft)
saisungah = (i:1) (t:adv) (f:work) (w:in the shop/inside the shop) (d:<saisung>, the inside of a shop, and <ah> written as one word: in the shop) (j:saisung/ah) (r:zd:17232/zd:13145) (q:draft)
saite = (i:1) (t:n) (f:work) (w:shops/stalls) (d:<sai>, shop, with the plural <te>: shops, stalls or businesses) (b:sai) (r:zd:25068/zd:16197) (q:draft)
saite = (i:2) (t:n) (f:work/politics/media) (w:department/agency/authorities) (d:<sai>, be in charge of, with the plural <te>, placed after the name of a matter: the people or offices that deal with it, as in {thuthak saite}, news agencies, and {cidamna lam saite}, the health authorities) (b:sai) (r:ts:9048/ts:12053/zd:21066) (q:draft)
saiten = (i:1) (t:n) (f:media) (w:outlets/agencies) (d:<sai>, shop, with the plural <te> and the subject marker <in> written as one word; in news writing {thuthak saiten} is the news outlets, as the subject of saying or reporting) (j:sai/te/in) (r:ts:2461/ts:3446) (q:draft, low confidence)
Saizaang = (i:1) (t:name) (c:khua) (f:social/travel) (j:Saizang) (r:zd:25390) (q:draft)
sak = (i:3) (t:v) (f:everyday) (w:consider/regard/find/feel) (d:form of <sa>, feel or think, after a word of quality: {nuam sak} is find pleasant, {thupi sak} regard as important, {lamdang sak} find strange; not the causing {sak} that follows a verb) (r:ts:3375/zd:24217) (q:draft)
sakden = (i:1) (t:part) (f:everyday) (d:the causative <sak> and <den>, always, written as one word after a verb: keep causing, as in {nawngkai sakden}, keep on troubling) (j:sak/den) (r:zd:12450/zd:12217) (q:draft)
sakding = (i:1) (t:part) (f:everyday) (d:<sak> and <ding> written as one word after a verb: will make it happen, will do it for someone) (j:sak/ding) (r:zd:17668/zd:21837) (q:draft)
sakgawp = (i:1) (t:part) (f:everyday) (d:the causative <sak>, make or cause, and <gawp>, severely, written as one word after a verb: cause it badly or do it to someone with violence, as in {lauthawng sakgawp}, frighten badly, and {suksiat sakgawp}, wreck) (j:sak/gawp) (r:zd:14901/zd:17517/zd:20013) (q:draft)
sakha = (i:1) (t:v) (f:everyday) (w:suppose/assume/take to be) (d:<sa>, here think or consider a thing to be so, with <kha>: happen to think, suppose, often wrongly; {sakha kei ni} is let us not suppose) (j:sa/kha) (r:zd:22361/zd:12121/zd:25628) (q:draft)
sakhan = (i:1) (t:n) (f:politics) (w:camp/base/post) (d:a camp or post, especially of soldiers or an armed group; {thong sakhan} is a prison camp) (o:Burmese) (r:zd:24231/zd:20315) (q:draft)
Sakhangyi = (i:1) (t:name) (c:khua) (f:travel) (w:Sakhangyi) (d:village in Myanmar, named as the home village of Zomi people and as a place of fighting) (r:ts:7881) (q:draft, low confidence)
sakkei = (i:1) (t:part) (f:everyday) (w:not let/not make/not find) (d:<sak>, cause or find to be, and <kei>, not, written as one word after a verb or describing word: not make or let it happen, not find it so; {sakkei in} forbids, do not let) (j:sak/kei) (r:zd:21458/zd:12913) (q:draft)
sakkha = (i:1) (t:part) (f:everyday) (w:cause by accident/happen to make) (d:the causative <sak> with <kha>, happen to, written as one word after a verb: bring something about without meaning to, or happen to do it to someone) (j:sak/kha) (r:zd:19712/zd:20871) (q:draft)
sakkhin = (i:1) (t:part) (f:everyday) (d:the causative <sak> and <khin>, already, written as one word after a verb: has already been made to happen, has already been done to someone) (j:sak/khin) (r:zd:15205/zd:11778) (q:draft)
sakkhop = (i:1) (t:v) (f:media/religion/social) (w:sing together) (d:sing, as in {la sak}, sing a song, with <khop>, together, written as one word: sing a song together) (j:sak/khop) (r:zd:19168/zd:24217/zd:9225) (q:draft)
sakkik = (i:2) (t:n) (f:religion/media) (w:chorus/refrain) (d:the part of a song or hymn that is sung again after each verse, from <sak>, sing, with <kik>, again; mostly as {a sakkik}, its chorus) (r:zd:9220/zd:9256/zd:9215) (q:draft)
saklai = (i:1) (t:part) (f:everyday) (d:causative <sak> with <lai>, here still, written as one word after a verb: still let something go on, still have it done) (j:sak/lai) (r:zd:17733/zd:15342) (q:draft, low confidence)
sakleh = (i:1) (t:conj) (f:everyday) (w:if) (d:<sak> and <leh>, if, written as one word after a verb: if one lets or makes it happen; after <ka>, when I think it so) (j:sak/leh) (r:zd:13144/zd:17060) (q:draft, low confidence)
saklo = (i:1) (t:part) (f:everyday) (d:the causative <sak> and <lo>, not, written as one word after a verb: not make, not let, not allow to happen) (j:sak/lo) (r:zd:17409/zd:19262/zd:23977) (q:draft)
sakloh = (i:1) (t:v) (f:everyday) (w:not cause/not let/not consider) (d:<sak> and the negative <loh> written as one word after a verb: not cause or not let it happen, as in {nawngkai sakloh}, not to trouble; after a describing word it is the form of <sa>, deem, as in {kilawm i sakloh}, we do not think it fitting) (j:sak/loh) (r:zd:8668/zd:14946/zd:21049) (q:draft)
saklohna = (i:1) (t:n) (f:everyday) (w:not feeling/not considering) (d:<sak>, here the form of <sa> in its sense feel or consider to be, with <lohna>: the fact of not finding something to be so, placed after a describing word; {nop saklohna} is not feeling happy, {dik saklohna} is not thinking something right) (r:zd:22474/zd:20956) (q:draft)
saklua = (i:1) (t:v) (f:everyday) (w:make too much/cause excessively) (d:the causative <sak> with <lua>, too much, written as one word after a verb or describing word: make someone or something too much so, as {gilkial saklua}, let someone get too hungry) (j:sak/lua) (r:zd:17886) (q:draft, low confidence)
saknop = (i:1) (t:v) (f:everyday) (w:want to make/want to let/wish to cause) (d:the causative <sak> and <nop>, want, written as one word after a verb: want to make or let that happen, as {muh saknop}, want to show) (j:sak/nop) (r:zd:21125/zd:23978) (q:draft)
saknop = (i:2) (t:v) (f:media/everyday) (w:want to sing) (d:<sak>, here sing, with <nop>, want: want or like to sing) (r:zd:16442) (q:draft, low confidence)
saknuam = (i:1) (t:v) (f:everyday) (w:want to make/want to cause) (d:<sak>, make or cause, and <nuam>, want, written as one word after a verb: want to make something happen, or to make someone do or become something) (j:sak/nuam) (r:zd:19733/zd:26658) (q:draft)
Sakollam = (i:1) (t:name) (c:place) (f:travel) (w:Sakollam) (d:a ward of the town of Tedim in Chin State) (r:zd:23205/zd:17530) (q:draft)
sakpah = (i:1) (t:part) (f:everyday) (d:the causative <sak> and <pah>, at once, written as one word after a verb: have it done at once; {kipuak sakpah} is was sent at once) (j:sak/pah) (r:zd:18036/zd:17856) (q:draft)
sakpan = (i:1) (t:v) (f:everyday) (w:begin to make/start to cause) (d:the causative <sak> with <pan>, begin, written as one word after a verb: begin to make something happen, as {paikhia sakpan}, begin to take out; in other sentences {sakpan} is from the north) (j:sak/pan) (r:zd:12070/zd:17717) (q:draft, low confidence)
sakphot = (i:1) (t:part) (f:everyday) (d:the causative <sak> and <phot>, for the time being, written as one word after a verb: have something done for now, temporarily; {khakcip sakphot} is have it closed for the time being) (j:sak/phot) (r:zd:17622/zd:17707) (q:draft)
sakpih = (i:1) (t:v) (f:social/religion) (w:sing along with/sing together with/join in singing) (d:<sak>, the form of sing used before an ending, with <pih>, together with: sing a song along with someone) (r:zd:11504/zd:11135) (q:draft)
sakpih = (i:2) (t:v) (f:social) (w:feel with/share the feeling of/regard likewise) (d:<sak>, the form of feel or consider, with <pih>, together with: feel a thing as someone else feels it or regard it as they do, as {thupi sakpih}, count important with them, and {hoih sakpih}, approve) (r:zd:19662/zd:15527) (q:draft, low confidence)
saksak = (i:3) (t:v) (f:religion/social) (w:keep singing/sing regularly) (d:<sak>, sing, doubled: sing a song again and again or as a habit, with <la>, song, close by, as {tu-a i saksak la}, the song we sing today; not the causative) (r:zd:17854/zd:9258/ts:3506) (q:draft)
saksawm = (i:1) (t:part) (f:everyday) (w:intend to make/try to have done) (d:<sak> and <sawm> written as one word after a verb: intend or try to make someone do the action, or to have it done) (j:sak/sawm) (r:zd:15467/zd:12331/zd:20263) (q:draft)
sakthei = (i:1) (t:v) (f:everyday) (w:can cause/be able to make) (d:causative <sak> and <thei>, able, written as one word after a verb: can make it happen, can cause to) (j:sak/thei) (r:zd:17262/zd:16415) (q:draft)
saktuak = (i:1) (t:v) (f:everyday) (w:each feel/each find) (d:<sak> and <tuak>, each, written as one word after a word of feeling: each of them feels or finds it so, {lamdang saktuak} is each finds it strange; after a verb of doing, each side does it to the other) (j:sak/tuak) (r:zd:15727/zd:16657/zd:11746) (q:draft, low confidence)
saktuam = (i:1) (t:part) (f:everyday) (d:the causative <sak> and <tuam> written as one word after a verb or describing word: make it so as a further result, cause it all the more; {ziakai saktuam} is cause yet more delay) (j:sak/tuam) (r:zd:15469/zd:20122/zd:23311) (q:draft, low confidence)
sakzel = (i:1) (t:v) (f:everyday) (w:keep making/do repeatedly) (d:<sak>, cause or let, and <zel>, repeatedly, written as one word after a verb: make or let it be done time after time) (j:sak/zel) (r:zd:21826/zd:16717) (q:draft, low confidence)
sakzia = (i:1) (t:n) (f:everyday) (w:way of causing/manner of doing) (d:<sak> and <zia> written as one word after a verb: the way in which something is made to happen or is done to someone) (j:sak/zia) (r:zd:16373) (q:draft, low confidence)
sakzo = (i:1) (t:v) (f:everyday) (w:be able to make/can cause) (d:<sak> and <zo> written as one word after a verb: be able to make that happen, as in {kikhel sakzo}, can make something change) (j:sak/zo) (r:zd:19947/zd:24276/zd:15275) (q:draft)
Salai = (i:1) (t:n) (f:social) (w:Salai) (d:title placed before the name of a man among some Chin peoples; also said of a man who bears it) (r:zd:10874/zd:15698) (q:draft, low confidence)
salam = (i:1) (t:n) (f:religion) (w:the flesh/physical side) (d:<sa>, flesh, with <lam>, side: the bodily or worldly side of life, set against <khalam>, the spiritual side) (j:sa/lam) (r:zd:25106) (q:draft)
Salayang = (i:1) (t:name) (c:city) (f:travel/health) (w:Selayang) (d:town in Selangor, Malaysia, known for its hospital; the Malay spelling is Selayang) (r:zd:21841) (q:draft)
salel = (i:1) (t:v) (f:everyday) (w:just think/simply feel/just suppose) (d:<sa>, here think or feel a thing to be so, with <lel>, just, written as one word after a describing word: simply find it so, just suppose) (r:zd:17162/zd:19521) (q:draft, low confidence)
Salesman = (i:1) (t:n) (f:work) (w:salesman/seller) (d:a man whose work is selling goods, as in {Car Salesman}) (o:English) (r:zd:10929/zd:17491) (q:draft)
saliang = (i:1) (t:n) (f:food) (w:shoulder of meat) (d:<sa>, meat, with <liang>, shoulder: the shoulder of a slaughtered animal, a share given in honour at a feast) (r:zd:18001/zd:13144) (q:draft, low confidence)
saliang = (i:2) (t:v) (f:everyday) (w:feel so much/find even) (d:<sa>, here feel or find, and <liang>, even, written as one word after a describing word: feel it to that degree, as {lamdang bang saliang}, find it quite strange) (r:zd:15588/zd:19447) (q:draft, low confidence)
salo = (i:1) (t:v) (f:everyday) (w:not consider/not find/not feel) (d:<sa> in the sense of feel or consider, with the negative <lo>, written as one word after a describing word: not find it so, as {hoih salo}, not think it good, and {thupi salo}, not consider important) (j:sa/lo) (r:zd:20516/zd:23075) (q:draft)
salpha = (i:1) (t:n) (f:social/politics) (w:hero/martyr) (d:short for {pasal pha}, a good and brave man: a hero, especially one who gave his life for his people) (r:zd:11262/zd:22658) (q:draft)
salphate = (i:1) (t:n) (f:politics/social) (w:martyrs/heroes) (d:those who gave their lives for their people or land, the plural of <salpha> with <te>; {Zomi salphate} are the Zomi martyrs) (r:zd:9421/ts:1343) (q:draft)
salua = (i:1) (t:adj) (f:nature/everyday) (w:too hot/very hot) (d:<sa>, hot, and <lua>, too much, written as one word: too hot, extremely hot) (j:sa/lua) (r:zd:23729/zd:24532) (q:draft)
salua = (i:2) (t:v) (f:everyday) (w:find too much/feel very) (d:<sa>, here feel or consider to be, and <lua>, too much, written as one word after a describing word: feel that something is very much so, as in {lamdang salua}, find it very strange, and {tam salua}, find it too many) (r:zd:17177/zd:20341) (q:draft, low confidence)
sam = (i:1) (t:v) (f:everyday/social) (w:call/summon/invite) (d:call a person to come, call out to someone, invite; before a suffix the form is <sap>) (r:1.22.15)
sam hang = (i:1) (t:conj) (f:everyday) (w:even though/although/admittedly) (d:<sam>, here a particle, indeed or admittedly, and not the verb call, and <hang>, although: placed after a verb or a clause that is granted to be true, before or after the statement that limits it, even though it is so) (r:zd:21664/zd:25580) (q:draft, low confidence)
samahmah = (i:1) (t:v) (f:everyday) (w:find very/feel very/consider very) (d:<sa> in the sense of feel or consider, with <mahmah>, very, written as one word after a describing word: find something very much so, as {lamdang samahmah}, be greatly amazed, and {thupi samahmah}, consider very important) (j:sa/mahmah) (r:zd:16365/zd:24502/zd:25572) (q:draft)
samai = (i:1) (t:n) (f:politics/social) (w:front line) (d:found only after <galmai> in the pair {galmai samai}, the front of battle: the place of danger where one faces the enemy; perhaps from <sa>, here wild animal, and <mai>, face) (r:zd:20241/zd:17224) (q:draft, low confidence)
Samaritan = (i:1) (t:name) (c:people) (f:religion) (w:Samaritan) (d:a person of Samaria or of the Samaritan people and religion; {Good Samaritan} is the helpful stranger of the parable of Jesus) (o:English) (r:zd:20319/zd:24014) (q:draft)
samawk = (i:1) (t:v) (f:everyday) (w:consider/take to be/suppose) (d:<sa>, here consider or deem, and <mawk>, a marker of something unexpected, written as one word after a describing word: actually regard something as so) (j:sa/mawk) (r:zd:11803/zd:12972) (q:draft, low confidence)
samding = (i:1) (t:v) (f:everyday/social) (w:to call/will call) (d:<sam>, call, and <ding> written as one word: to call or summon someone; in other sentences it is the end of {kisam ding}, will be needed) (j:sam/ding) (r:zd:17279) (q:draft, low confidence)
samkei = (i:1) (t:adv) (f:everyday) (w:not at all/not really) (d:an emphatic word, not the verb spelled the same, with the negative <kei> written as one word after a verb: not at all, not really; {hi samkei} is it is not so at all) (r:zd:15259/zd:22451) (q:draft, low confidence)
samkhawmin = (i:1) (t:v) (f:social/politics) (w:calling together/summoning together) (d:<samkhawm>, call together, with the linking <in>: having called people together, and then) (j:samkhawm/in) (r:ts:3375/zd:14734) (q:draft)
samlo = (i:1) (t:adv) (f:everyday) (w:not really/not exactly/not necessarily) (d:<sam>, here a softening particle and not the verb call, with <lo>, not, written as one word after a verb or describing word: a softened denial, it is not really so, not quite, not as one might think) (r:zd:16844/zd:16892/zd:21918) (q:draft)
samloh = (i:1) (t:adv) (f:everyday) (w:not really/not exactly) (d:form of <samlo>, not exactly, used before <hangin>: {ahih pah samloh hangin} is although it is not exactly so) (b:samlo) (r:zd:24750/ts:3125) (q:draft)
sammet = (i:1) (t:n) (f:body/work) (w:haircut/hair cutting/barbering) (d:from {sam met}, cut the hair of the head, written as one word: the cutting of hair; {sammet sai} is a barbershop, {sammet nasep} the work of a barber and {sammet pa} a barber) (r:zd:15278/zd:24112) (q:draft)
Sample = (i:1) (t:n) (f:health/work) (w:sample/specimen) (d:a small part taken to test or to show the whole) (o:English) (r:zd:12945/zd:17570) (q:draft, low confidence)
samsam = (i:2) (t:adv) (f:everyday) (w:then/in turn/at once) (d:after another verb it is not <sam>, call, but an adverb for an action done promptly or in answer to what came before, as {gen samsam}, {ci samsam} and {pah samsam}) (r:zd:14824/zd:25109) (q:draft, low confidence)
Samsung = (i:1) (t:name) (f:it/work) (w:Samsung) (d:South Korean company and its brand of phones and household appliances) (o:Korean) (r:zd:12456/zd:11783) (q:draft)
samthei = (i:1) (t:v) (f:everyday/travel) (w:can call/can invite/can sponsor) (d:<sam>, call, and <thei>, able, written as one word: be able to call someone to come, as a relative to another country) (j:sam/thei) (r:zd:22877/zd:23569) (q:draft)
san = (i:1) (t:n) (f:everyday) (w:red/scarlet) (d:the colour red, said of a horse, cloth, a cord, wine or the evening sky)
Sanchaung = (i:1) (t:name) (c:place) (f:travel) (w:Sanchaung) (d:township of the city of Yangon) (r:zd:25027/zd:23641) (q:draft)
sanction = (i:1) (t:n) (f:politics) (w:sanction/sanctions) (d:a penalty that one country lays on another, as in {sanction bawl}, impose sanctions; in a few places the approval of a budget) (o:English) (r:zd:24990/zd:20394/zd:24945) (q:draft)
sanctions = (i:1) (t:n) (f:politics) (w:sanctions) (d:penalties that one country places on another to make it change its conduct; writers also say <khalna> or <khaktanna> and add the English word) (o:English) (r:zd:25582) (q:draft, low confidence)
Sandakan = (i:1) (t:name) (c:city) (f:travel) (w:Sandakan) (d:town on the coast of Sabah State in Malaysia) (r:zd:13063/zd:16916) (q:draft)
sandan = (i:1) (t:n) (f:social/religion) (w:view/understanding/way of accepting) (d:the verb form {san-}, receive or accept, with <dan>, manner: the way a person takes or understands a matter; {updan sandan} is what people believe and hold) (r:zd:20058/zd:23086) (q:draft)
sang = (i:3) (t:adj) (f:everyday) (w:high) (d:high above the ground or in position, said of mountains, clouds and the sun; the opposite of <niam>, low) (s:sangpi) (a:niam)
sang = (i:2) (t:n) (f:education) (w:school) (s:sanginn)
sang = (i:4) (t:prep) (f:everyday) (w:than) (d:short form of <sangin>, placed after the thing compared, often as {sang in} and with <zaw> on the describing word: than, compared with) (s:sangin) (r:zd:25919/zd:20560) (q:draft)
sang = (i:5) (t:v) (f:social/religion) (w:accept/receive) (d:take or admit a person or what is offered, also written <saang>; not {sang}, high, and not {sang}, school) (s:saang) (r:zd:20920/zd:23271) (q:draft, low confidence)
sang akah = (i:1) (t:v) (f:education) (w:attend school/go to school/be a student) (d:<sang>, school, and <kah>, go up, with the subject marker <a> written onto the verb: he or she attends school, or one who attends school; the place stands before it with <ah> or <panin>, and {sang akah lai tak} is still at school now) (s:sangkah) (r:zd:19160/zd:20414) (q:draft)
sangah = (i:2) (t:adv) (f:education) (w:at school/to school/in school) (d:<sang.2>, school, with the place marker <ah>: at, in or to a school; told from {sangah}, on high, by a school name before it or by <kah>, <sangkah> or <sin> after it) (r:zd:20241/zd:25110/zd:23590) (q:draft)
Sangai = (i:1) (t:n) (c:animal) (f:nature) (w:deer) (d:a wild animal taken in hunting, probably a kind of deer; the Sangai Express is a newspaper of Imphal named after the sangai deer of Manipur) (r:ts:3168/ts:301) (q:draft, low confidence)
sangam = (i:1) (t:n) (f:family) (j:sanggam) (r:zd:20507/zd:21179) (q:draft)
sanggam = (i:1) (t:n) (f:family) (w:brother/sister) (d:a brother or sister, a child of the same parents; {sanggam pasal} is a brother and {sanggam numei} a sister)
sanggam = (i:3) (t:n) (f:social/religion) (w:brother/brethren/fellow member) (d:a fellow member of one’s people or church, not a relative by birth; often a form of address to hearers or readers, as <sanggam aw> and {sanggam u leh nau te}) (r:zd:24064/zd:20080/zd:12333) (q:draft)
sanggam aw = (i:1) (t:intj) (f:social/religion) (w:dear brother/dear sister/dear friend) (d:<sanggam>, brother or sister, and <aw>, here the calling word placed after the one addressed: a warm way to address a reader or hearer, at the start or end of a sentence, common in sermons and advice) (r:zd:18920/zd:12333) (q:draft)
sanggam laizom = (i:1) (t:n) (f:family) (w:full sibling/own brother or sister/siblings) (d:<sanggam>, brother or sister, and <laizom>, sibling of the same mother, said as a pair: a brother or sister of the same parents, or the brothers and sisters of one family together; stands after a possessive such as <ka> or <a>) (r:zd:20537/zd:24447) (q:draft)
sanggamnu = (i:1) (t:n) (f:family) (w:sister) (d:<sanggam> brother or sister with <nu>, which marks a woman: a sister) (a:sanggampa) (b:sanggam)
sanggampa = (i:1) (t:n) (f:family) (w:brother) (d:<sanggam> brother or sister with <pa>, which marks a man: a brother) (s:sangampa) (a:sanggamnu) (b:sanggam)
sanghoih = (i:1) (t:n) (f:education) (w:good school) (d:<sang>, school, and <hoih>, good, written as one word: a good school) (j:sang/hoih) (r:zd:26097/zd:23591) (q:draft)
sanghuangsung = (i:1) (t:n) (f:education) (w:school grounds/campus) (d:<sang>, school, and <huangsung>, the space inside an enclosure, written as one word: the grounds of a school or university) (j:sang/huangsung) (r:zd:12146/zd:13151) (q:draft)
sanginn huangsung = (i:1) (t:n) (f:education) (w:school grounds/school campus/school compound) (d:<sanginn>, school building, with <huangsung>, the space inside a fence: the grounds of a school or university, the campus) (r:zd:11995/zd:13151) (q:draft)
sanginnkhat = (i:1) (t:n) (f:education) (w:a school/one school) (d:<sanginn> and <khat> written as one word: a school, one school building) (j:sanginn/khat) (r:zd:15221/zd:15301) (q:draft)
sanginnpi = (i:1) (t:n) (f:education) (w:school/school building/main school) (d:<sanginn>, school building, with the augmentative <pi>: a school and its large building, as {Tedim sanginnpi}, the school of Tedim) (j:sanginn/pi) (r:zd:19371/zd:19964) (q:draft, low confidence)
sanginnte = (i:1) (t:n) (f:education) (w:schools/school buildings) (d:plural of <sanginn>, school) (b:sanginn) (r:zd:25107/ts:10764) (q:draft)
sangkah = (i:1) (t:v) (f:education) (w:attend school/go to school/study) (d:<sang>, school, with <kah>, go up: go to school, be a pupil or student; also as a noun, schooling) (r:zd:21876/zd:16820/zd:15681) (q:draft)
sangkahding = (i:1) (t:v) (f:education) (w:go to school/attend school) (d:<sang>, <kah> and <ding> written as one word: to attend school, in order to go to school; often followed by <in>) (j:sang/kah/ding) (r:zd:16688/zd:26495/zd:13186) (q:draft)
sangkahlai = (i:1) (t:v) (f:education) (w:be still at school/while studying) (d:<sangkah>, attend school, and <lai>, still or while, written as one word: be still a student, or at the time of attending school) (j:sangkah/lai) (r:zd:15186/zd:17204) (q:draft)
sangkahna = (i:1) (t:n) (f:education) (w:schooling/school attendance/education) (d:<sang>, school, with <kah>, go up to or attend, and the noun ending {-na}: going to school, the schooling of a person) (r:zd:9228/zd:16216/zd:22429) (q:draft)
sangkahpih = (i:1) (t:n) (f:education) (w:schoolmate/classmate/fellow student) (d:<sang>, school, <kah>, go up to, and <pih>, together with: a person who goes or went to the same school as oneself) (r:zd:21097/zd:12292/zd:16506) (q:draft)
sangkhak = (i:1) (t:n) (f:education/time) (w:school holiday/school break/vacation) (d:<sang>, school, with <khak>, shut: the time when school is closed; also as a verb, the school closes) (r:zd:11347/zd:15767/zd:21279) (q:draft)
sangkhan = (i:1) (t:v) (f:everyday) (w:raise/heighten/rise higher) (d:<sang>, high, with <khan>, grow: make higher or become higher, as the voice, faith or the standard of living) (j:sang/khan) (r:zd:21075/zd:23019) (q:draft)
sangkhan = (i:2) (t:n) (f:education) (w:classroom/school building) (d:a room or building of a <sang>, school, where classes are held) (r:zd:19729/zd:23281) (q:draft, low confidence)
sanglai = (i:1) (t:n) (f:education) (w:schooling/school studies/school lessons) (d:<sang>, school, with <lai>, writing: what is taught and learned at school, formal education; {sanglai sim} is study at school) (r:zd:18927/zd:22736/zd:19676) (q:draft)
sanglo = (i:1) (t:v) (f:social/religion) (w:not accept/reject/refuse) (d:<saang>, accept, here spelled with a short vowel, and <lo>, not, written as one word: not accept or admit a person, a request or a teaching) (j:saang/lo) (r:zd:17051/zd:23441/zd:25178) (q:draft)
sanglo = (i:2) (t:adj) (f:everyday) (w:not high/low) (d:<sang>, high, and <lo>, not, written as one word: not high) (j:sang/lo) (r:zd:25919) (q:draft, low confidence)
sanglut = (i:1) (t:v) (f:education) (w:enter school/enrol) (d:<sang>, school, and <lut>, enter, written as one word: go into school, or be admitted to a school; {sanglut man} is the fee for entering) (j:sang/lut) (r:zd:20572/zd:10717) (q:draft, low confidence)
sangmahmah = (i:1) (t:adj) (f:everyday) (w:very high/very tall) (d:<sang>, high, and <mahmah>, very, written as one word) (j:sang/mahmah) (r:zd:15579/zd:25919) (q:draft)
sangman = (i:1) (t:v) (f:education) (w:graduate/finish school) (d:<sang>, school, with <man>, finish: complete one's studies, graduate from a university) (r:zd:12244/zd:21559) (q:draft)
sangmang = (i:1) (t:n) (f:religion) (w:missionary) (d:a foreign Christian missionary, used especially of the American Baptist missionaries who came to the Zomi) (r:zd:22709/zd:12003/zd:21866) (q:draft)
sangmangpa = (i:1) (t:n) (f:religion) (w:missionary) (d:<sangmang>, missionary, with <pa>, man: a male missionary, also used as a title; among the Zomi said especially of the missionary J. H. Cope) (b:sangmang) (r:ts:3375/zd:22646) (q:draft)
sangmangte = (i:1) (t:n) (f:religion) (w:missionaries) (d:plural of <sangmang>, missionary: the foreign missionaries who brought the gospel and schools to the Chin Hills) (r:zd:13354/zd:22586) (q:draft)
sangnaupang = (i:1) (t:n) (f:education) (w:student/pupil) (d:<sang> school with <naupang> child) (q:draft)
sangnaupangno = (i:1) (t:n) (f:education) (w:young pupil/schoolchild) (d:<sangnaupang>, pupil, with the ending {-no}, small or young: a young school child) (b:sangnaupang) (r:zd:12616) (q:draft)
sangnaupangnu = (i:1) (t:n) (f:education) (w:schoolgirl/female student) (d:<sangnaupang>, student, and <nu>, marking a female, written as one word) (j:sangnaupang/nu) (r:zd:11783/zd:15236) (q:draft)
sangnaupangpa = (i:1) (t:n) (f:education) (w:schoolboy/male student) (d:<sangnaupang>, student, with the male ending {-pa}: a boy or young man who is a student) (b:sangnaupang) (r:zd:12261/zd:14731) (q:draft)
sangnaupangte = (i:1) (t:n) (f:education) (w:students/pupils) (d:plural of <sangnaupang>, student) (b:sangnaupang) (r:zd:21259/zd:17168/zd:17746) (q:draft)
sangnuamlo = (i:1) (t:v) (f:everyday/politics) (w:refuse to accept/be unwilling to receive) (d:<sangnuam>, want to receive, and <lo>, not, written as one word: not want to accept what is offered) (j:sangnuam/lo) (r:zd:20394/zd:12289) (q:draft)
sangoi = (i:1) (t:n) (f:food) (w:sausage) (d:a sausage of the Zomi kitchen, an animal's intestine stuffed with meat or blood, eaten at feasts) (r:zd:25393/zd:21701) (q:draft)
sangpah = (i:1) (t:v) (f:everyday/social) (w:accept at once/receive right away) (d:<sang>, here receive or accept, and <pah>, at once, written as one word: accept or take what is offered without delay) (j:sang/pah) (r:zd:21097/zd:14728) (q:draft)
sangpan = (i:1) (t:adv) (f:education) (w:from school/by the school) (d:<sang>, school, and <pan>, from, written as one word: from the school, out of school, on the part of the school) (j:sang/pan) (r:zd:22556/zd:14921/zd:24234) (q:draft)
sangpi = (i:2) (t:n) (f:education) (w:high school/college) (d:<sang>, school, with the augmentative <pi>: a high school or other higher school, after the name of a town or after {tan 10}, tenth standard; not {sangpi}, very high) (r:zd:17675/zd:21279) (q:draft)
sangsap = (i:1) (t:n) (f:education) (w:school fee/tuition fee) (d:the money paid for attending a school, from <sang>, school) (r:zd:20486/zd:19826/zd:15681) (q:draft)
sangsia = (i:1) (t:n) (f:education) (w:school teacher/teacher) (d:<sang>, school, with <sia>, teacher: one who teaches in a school) (r:zd:20572/zd:24069/zd:24682) (q:draft)
sangsiam = (i:1) (t:v) (f:social/everyday) (w:accept well/know how to accept/take in good part) (d:<sang>, here accept or receive, with <siam>, skilled: be good at accepting what comes, such as teaching, change or hardship) (r:zd:19245/zd:25734/zd:23975) (q:draft)
sangsiama = (i:1) (t:n) (f:education) (w:female teacher/schoolmistress) (d:a woman who teaches in a school, from <sang>, school, and <siama>, woman teacher) (r:zd:12409/zd:19213/zd:16313) (q:draft)
sangsiapa = (i:1) (t:n) (f:education) (w:schoolteacher/teacher) (d:<sang>, school, with <siapa>, male teacher: a man who teaches at a school) (s:siapa) (r:zd:23352/zd:15280) (q:draft)
sangsiapi = (i:1) (t:n) (f:education) (w:headmaster/principal/head teacher) (d:the head of a school or college; {sangsiapi pa} is a headmaster and {sangsiapi nu} a headmistress) (r:zd:12403/zd:11771) (q:draft)
sangsiate = (i:1) (t:n) (f:education) (w:teachers/schoolteachers) (d:<sang>, school, and <siate>, teachers, written as one word: the teachers of a school; {Lai Siangtho sangsiate} are Bible school teachers) (j:sang/siate) (r:zd:20572/zd:9453/zd:9435) (q:draft)
sangsik = (i:1) (t:conj) (f:everyday) (w:instead of/rather than/far from) (d:placed after a clause and usually followed by <in>: instead of doing what would be expected, the opposite is done; built on the comparing word <sangin>, than) (r:zd:21601/zd:14652/zd:11837) (q:draft)
sangsikin = (i:1) (t:conj) (f:everyday) (w:instead of/rather than/far from) (d:<sangsik> and <in> written as one word after a clause: instead of that, the opposite is done; {tua sangsikin} is instead of that) (j:sangsik/in) (r:zd:21803/zd:19166) (q:draft)
sangsum = (i:1) (t:n) (f:education) (w:school fees/tuition/tuition fees) (d:<sang>, school, with <sum>, money: the money paid for schooling) (r:zd:15809/zd:16257) (q:draft)
sangte = (i:3) (t:n) (f:education) (w:schools) (d:<sang.2>, school, with the plural {-te}: schools, as in {kumpi sangte}, government schools, and {sangte ah}, at the schools; not {sangte} high or those who receive) (b:sang) (r:zd:11891/zd:23754/zd:24947) (q:draft)
sangtuah = (i:1) (t:v) (f:education) (w:finish school/be let out of school) (d:of a school or a course, come to its end so that the pupils leave: {nitak sangtuah ciangin} is when school is out in the evening, and {sangtuah pawi} is the closing ceremony of a course) (r:zd:20851/zd:26620/zd:23797) (q:draft)
sangvai = (i:1) (t:n) (f:education) (w:education/schooling/school matters) (d:<sang>, school, with <vai>, affair: matters of school and education) (r:zd:20169/zd:17597) (q:draft)
sangzolo = (i:1) (t:v) (f:everyday/politics) (w:cannot accept/be unable to accept) (d:<sangzo>, be able to accept, and <lo>, not, written as one word: not able to accept or approve something, such as a case or what someone says) (j:sangzo/lo) (r:zd:21063/zd:17393) (q:draft)
sangzong = (i:1) (t:phrase) (f:education) (w:school also/even school) (d:<sang>, school, and <zong>, also, written as one word, mostly before <kah>, attend: not even go to school) (j:sang/zong) (r:zd:15199/zd:16809) (q:draft)
Sanini = (i:1) (t:n) (f:time) (w:Saturday) (d:<sani>, Saturday, and <ni>, day, written as one word) (j:sani/ni) (r:zd:18198) (q:draft)
sanitizer = (i:1) (t:n) (f:health) (w:sanitizer/hand sanitizer) (d:liquid for cleaning the hands, used as {hand sanitizer}) (o:English) (r:zd:23731/zd:24219/zd:24319) (q:draft)
sanlaitak = (i:1) (t:adv) (f:time/everyday) (w:still in progress/currently under way) (d:the ending {-san}, placed after a verb for an action begun and not yet finished, with <laitak>, written as one word: the action is going on right now) (r:zd:20297/zd:11706) (q:draft, low confidence)
sanloh = (i:1) (t:v) (f:everyday) (w:not accept/not receive) (d:<san> as the form of <sang> in the sense accept or receive, with <loh>, not, written as one word: not accepting a teaching, not receiving pay, not answering a phone call; not the colour red) (j:san/loh) (r:zd:16254/zd:17264) (q:draft)
sanmel = (i:1) (t:n) (f:everyday) (w:red colour/red) (d:<san>, red, with <mel>, appearance: the colour red; {a sanmel nei} is red-coloured) (r:zd:22740/zd:21459) (q:draft)
sanna = (i:2) (t:n) (f:social) (w:acceptance/reception/admission) (d:<sang> in the sense receive or accept, with the noun suffix <na>: the receiving or accepting of a person or a thing; {lut nuamte sanna} is the admission of those who want to join, and {thupha sanna} the receiving of a blessing) (r:zd:25789/zd:14791) (q:draft)
sansan = (i:2) (t:adv) (f:everyday) (w:right then/at once/straight away) (d:after a verb, says that the thing happens right at that moment or directly, most often in {phawk sansan}, come to remember or realise right then, and in {tu sansan}, only just now; not a doing again and again) (r:zd:16425/zd:14591/ts:3125) (q:draft, low confidence)
sansiam = (i:1) (t:v) (f:social/everyday) (w:accept rightly/take in good part/accept with understanding) (d:a short form of <saang>, accept, with <siam>, skilled: know how to accept or take a thing in the right way) (r:zd:9430/zd:24227) (q:draft)
sanuam = (i:1) (t:v) (f:social/religion) (w:want to sing) (d:<sa>, here sing, and <nuam>, want, written as one word: want to sing a song or a voice part) (j:sa/nuam) (r:zd:17234/zd:16661) (q:draft)
sanzawh = (i:1) (t:v) (f:everyday/social) (w:be able to accept/be able to receive) (d:form of <sangzo>, be able to accept, used before <loh>, <ding>, <khit> and similar words: manage to accept a person, a fact or advice; {sanzawh lohna} is not being accepted) (b:sangzo) (r:zd:18234/zd:21717) (q:draft)
sanzia = (i:1) (t:n) (f:social/religion) (w:view/understanding/way of accepting) (d:the way a person takes or accepts something, how a teaching or matter is understood, from the verb for accept with <zia>, way; often beside <muhzia>, way of seeing) (r:zd:21605/zd:23037/zd:20786) (q:draft)
sap = (i:2) (t:v) (f:home/work) (w:rent/hire) (d:form of <saap>, pay to use a house, land or a vehicle for a time; after <inn>, <leitang>, <mawtaw> or <Bus>, not of calling a person) (r:ts:4720/zd:19587/zd:16402) (q:draft)
Sapan = (i:1) (t:name) (c:place) (f:travel) (w:Sapan) (d:place on the Sozang road in the Tedim area of Chin State, probably a village) (r:zd:22586) (q:draft, low confidence)
sapbeh = (i:1) (t:v) (f:work/social) (w:call in more/summon in addition) (d:<sap>, call, with <beh>, in addition, as in <behlap>: call further people in to help those already there) (j:sap/beh) (r:zd:19554/zd:17517) (q:draft)
sapding = (i:1) (t:v) (f:everyday/social) (w:will call/to call/to send for) (d:<sap>, call or invite, and <ding> written as one word: to call, about to call or send for someone; {koici sapding}, how to address someone) (j:sap/ding) (r:zd:12311/zd:16216) (q:draft)
sapen = (i:1) (t:phrase) (f:everyday) (w:consider most/find most) (d:after a describing word, feel or judge it to be so, with the superlative ending: {hoih sapen} is to find it the best) (r:zd:26097/zd:24303) (q:draft, low confidence)
saphuklai = (i:1) (t:n) (f:home/everyday) (w:plastic/plastic bag/plastic sheet) (d:plastic, and a thin bag or sheet made of it) (r:zd:24290/zd:25927) (q:draft, low confidence)
sapian = (i:1) (t:v) (f:everyday) (w:find rather/feel somewhat) (d:{sa pian}, feel somewhat, written as one word after a describing word: find something rather so, as {muanmawhhuai sapian}, find it rather suspicious) (r:zd:17138/zd:17428) (q:draft, low confidence)
sapihte = (i:1) (t:n) (f:social/family) (w:kinsfolk/own people/fellows) (d:used only after <mipih>, as {mipih sapihte}, one's own people and kin, those of the same nation or community) (r:zd:9448/zd:9437) (q:draft, low confidence)
sapkik = (i:1) (t:v) (f:everyday/politics) (w:call back/call again/reconvene) (d:<sap>, call, and <kik>, again or back, written as one word: call someone back, return a call, or call a meeting again) (j:sap/kik) (r:zd:20822/zd:21327) (q:draft)
sapkikna = (i:1) (t:n) (f:work/everyday) (w:recall/calling back) (d:<sap> and <kikna> written as one word: a calling back, as when a company recalls goods it has sold, or a calling again) (j:sap/kikna) (r:zd:11915/zd:11764) (q:draft)
saptuam = (i:1) (t:n) (f:religion) (w:church/congregation) (d:the church as the people who are called out, from <sap>, call, and <tuam>, apart; used for the local church and for the church of Christ, beside <pawlpi>, which is also said of a denomination) (s:pawlpi) (r:ts:12519/zd:15274/zd:25275) (q:draft)
Sarawak = (i:1) (t:name) (c:land) (f:travel) (w:Sarawak) (d:a state of Malaysia on the island of Borneo) (r:zd:13324/zd:19581) (q:draft)
sasa = (i:2) (t:part) (f:everyday) (w:already) (d:after a verb, <sa>, already done, said twice: what has already been said or is already known, as {a kigen sasa mah bangin}, as has already been said; not the verb sing) (r:zd:23853/zd:20284) (q:draft, low confidence)
sasai = (i:1) (t:n) (f:food/work) (w:butcher's shop/meat stall) (d:<sa>, meat, with <sai>, shop: a stall or shop where meat is sold) (j:sa/sai) (r:zd:24276/zd:23268) (q:draft)
Sasan = (i:1) (t:n) (f:food/home) (w:chopping block/meat board) (d:apparently the block or board on which meat is cut; one article gives <sabak> as another word for it, and the word is also used as a nickname) (r:zd:23538) (q:draft, low confidence)
sasem = (i:1) (t:n) (f:food/work) (w:butcher/meat cutting) (d:<sa>, meat, with <sem>, here cut up: the cutting up of meat and the person who does it; {sasem bangin} is like meat being cut up) (r:ts:301) (q:draft)
sasemna = (i:1) (t:n) (f:food/home) (w:meat chopping) (d:<sa>, meat, with <sem>, here cut up, and the ending {-na}: for cutting up meat; {sasemna temta} is a meat knife or cleaver, see <temta>) (r:zd:11814/zd:16876) (q:draft)
sasin = (i:1) (t:n) (f:food) (w:liver) (d:the liver of an animal as meat; {sasin salung} is the liver and heart, the choice parts offered at a feast) (r:zd:20433/ts:3366) (q:draft)
sat = (i:3) (t:v) (f:everyday/social) (w:decide/settle) (d:after <khen>, divide, as {khen sat} and {thukhen sat}, the word <khensat> written as two words: cut a matter off, decide it or pass judgment on it; nothing is struck or founded) (r:zd:25461) (q:draft, low confidence)
satanh = (i:1) (t:n) (f:social/politics) (w:share/portion/rightful share) (d:<sa>, meat, with <tanh>, share: the portion that is due to someone, in the news the rightful share of a people in power and in the affairs of the country) (r:zd:23990/zd:24699/zd:25330) (q:draft)
satding = (i:1) (t:v) (f:everyday) (w:to strike/to hit/about to strike) (d:<sat>, strike, and <ding> written as one word: to strike, going to strike) (j:sat/ding) (r:zd:12579) (q:draft)
sate = (i:2) (t:part) (f:everyday) (w:those who have already/those already) (d:not the noun meat but <sa>, already, with the plural <te> after a verb: those who have already done or become it; {a si sate} is those already dead) (r:zd:23797/zd:22565/zd:23008) (q:draft)
sate = (i:3) (t:n) (f:everyday) (w:those who feel/those who consider) (d:the verb <sa>, feel or consider, with the plural <te>, usually as {a sate}: the people who find something so; {nuam a sate} is those who find it pleasant) (r:zd:24189/zd:23087) (q:draft, low confidence)
satellite = (i:1) (t:n) (f:it) (w:satellite) (d:a man-made object sent into orbit, used for communication and observation) (o:English) (r:zd:24468/zd:11292/zd:10917) (q:draft)
satellites = (i:1) (t:n) (f:it) (w:satellites) (d:the English plural of <satellite>, used unchanged in Zolai sentences) (b:satellite) (o:English) (r:zd:15874/zd:11292) (q:draft, low confidence)
sateng = (i:1) (t:pron) (f:everyday) (w:all that/everything that/whatever) (d:placed after a verb: all that has been done or all that there is, from <sa>, already done, and <teng>, all; {a nasep sateng} is all the work that was done) (j:sa/teng) (r:zd:22915/zd:22479/zd:11395) (q:draft)
sathau = (i:1) (t:n) (f:food/home) (w:oil) (d:oil or fat, used for cooking, for lamps and for rubbing on the body) (r:19.84.9) (q:draft)
sathei = (i:1) (t:v) (f:media/everyday) (w:can sing/able to sing) (d:<sa> in its sense sing, as in {la sa}, sing a song, and <thei>, can, written as one word: be able to sing) (j:sa/thei) (r:zd:25318/zd:14767) (q:draft)
satliamgawp = (i:1) (t:v) (f:body/social) (w:beat and badly wound/slash badly) (d:<sat> and <liamgawp> written as one word: strike a person so that he is badly wounded) (j:sat/liamgawp) (r:zd:14939) (q:draft)
satma = (i:1) (t:adv) (f:time) (w:before it strikes/before the hour) (d:<sat>, strike, and <ma>, before, written as one word: before the clock strikes the hour named, as in {nai 11:00 a satma in}, before eleven o'clock) (j:sat/ma) (r:zd:23886/zd:24276) (q:draft)
satna = (i:2) (t:n) (f:nature/health) (w:heat/temperature) (d:<sa>, hot, with the noun ending {-na}: how hot something is, of the body in fever, of the sun and of the earth, and not the second word of <natna satna>, sickness; often followed by a number of degrees, and a different word from {satna}, beating) (r:zd:23252/zd:18241/zd:21807) (q:draft)
satpia = (i:1) (t:n) (f:home/health) (w:soap) (d:soap for washing the hands, the body or clothes) (s:satpiang) (o:Burmese) (r:zd:23933/zd:14946) (q:draft)
satsakgawp = (i:1) (t:v) (f:everyday/media) (w:batter/smash up/hack) (d:<satsak> and <gawp> written as one word: strike or hack something that belongs to another again and again or with great force, so that it is badly damaged or hurt) (j:satsak/gawp) (r:zd:19562/zd:15366) (q:draft)
satui = (i:1) (t:n) (f:food) (w:soup/broth) (d:<sa>, meat, with <tui>, water: the liquid in which meat was boiled) (s:mehtui) (q:draft)
Saturday = (i:1) (t:n) (c:ni) (f:time) (w:Saturday) (d:the English name of the day, in common use in news writing, often followed by <ni>, day) (o:English) (r:zd:23400/zd:17703/zd:15403) (q:draft)
sau = (i:1) (t:adj) (f:everyday) (w:long) (d:long in measure or in time; after a number of cubits it gives the length) (s:saupi) (a:tom)
Saudi = (i:1) (t:name) (c:land) (f:politics) (w:Saudi Arabia/Saudi) (d:kingdom on the Arabian peninsula; written alone or as {Saudi Arabia}) (r:zd:16088/zd:16058) (q:draft)
Savannah = (i:1) (t:name) (c:city) (f:travel) (w:Savannah) (d:city in the state of Georgia in the United States) (r:zd:9253) (q:draft)
savat = (i:1) (t:v) (f:everyday/body) (w:feel suddenly/be struck by) (d:<sa>, feel, with <vat>, suddenly, written as one word: feel something all at once, as surprise or pain) (r:zd:19398) (q:draft, low confidence)
sawhkha = (i:1) (t:v) (f:everyday/health) (w:touch/come into contact with/be involved in) (d:mostly after <ki> and with <tawh>, with: come into contact with a person or thing, or have to do with a matter; also written <kisawhkha>) (r:zd:19245/zd:11679) (q:draft)
sawk = (i:3) (t:v) (f:politics) (w:cast a vote/vote) (d:with <mee>, vote: put a ballot into the box, cast one's vote in an election or a contest) (r:zd:12819/zd:18198) (q:draft)
sawkkhak = (i:1) (t:v) (f:religion/everyday) (w:draw/happen to draw) (d:<sawk>, reach in, with <khak>, happen to, written as one word: what one happens to draw when lots are drawn) (j:sawk/khak) (r:zd:17634) (q:draft, low confidence)
sawl = (i:1) (t:v) (f:everyday) (w:send) (d:make someone go to a place or a person, with a task or a message) (s:puak/paisak) (r:55.4.12) (q:draft)
sawlsawl = (i:1) (t:v) (f:everyday/social) (w:keep telling/urge repeatedly/order again and again) (d:<sawl> said twice: tell or order someone to do something again and again) (b:sawl) (r:zd:24244/zd:23990/zd:19166) (q:draft)
sawm hamtang = (i:1) (t:v) (f:everyday) (w:make a point of/try hard to/be determined to) (d:<sawm.2>, intend, and <hamtang>, insistently: placed after a verb, make a determined effort to do it; with <in> or <ni> at the end it is a strong advice, be sure to do it; <sawm> is here not the number ten) (r:zd:26252/zd:11702/zd:23886) (q:draft)
sawmin = (i:2) (t:v) (f:everyday) (w:intend/try/plan) (d:<sawm>, intend, with the ending <in>, placed after a verb: intending or trying to do it, as {theih sawmin}, trying to know; at the end of a sentence it is a command, try to do it) (r:zd:24035/zd:24491/zd:19600) (q:draft)
sawmleh = (i:1) (t:phrase) (f:everyday) (w:if one intends to/if planning to) (d:<sawm>, intend, and <leh>, if, written as one word after a verb: if one means to do it) (j:sawm/leh) (r:zd:24135/zd:20747) (q:draft)
sawmleh = (i:2) (t:num) (f:everyday) (w:ten and) (d:<sawm>, ten, and <leh>, and, written as one word in the numbers eleven to nineteen: {sawmleh nih} is twelve) (j:sawm/leh) (r:zd:19679/zd:15274) (q:draft)
sawmlo = (i:1) (t:v) (f:everyday) (w:not intend/not plan/not try) (d:<sawm>, intend, with <lo>, not, written as one word after a verb: not intend or not try to do it; {piak sawmlo} is not intend to give) (j:sawm/lo) (r:zd:12096/zd:14755) (q:draft)
sawmpa = (i:1) (t:n) (f:everyday/social) (w:man who tried to/man who intended to) (d:<sawm> and <pa> written as one word, placed after a verb: the man who tried or was about to do it) (j:sawm/pa) (r:zd:21611) (q:draft)
sawmsawm = (i:1) (t:v) (f:everyday) (w:keep trying to/be bent on/attempt) (d:<sawm>, intend, doubled and placed after a verb: be set on doing it, keep planning or attempting it) (b:sawm) (r:zd:15205/zd:25357) (q:draft, low confidence)
sawmta = (i:1) (t:v) (f:everyday) (w:now intend/be about to/plan to) (d:<sawm>, intend, and <ta>, now, written as one word after a verb: now intend to do it, be about to do it) (j:sawm/ta) (r:ts:301) (q:draft)
sawn = (i:2) (t:v) (f:everyday) (w:push) (r:zai:push) (q:draft)
sawng = (i:1) (t:n) (f:time) (w:time/period) (d:a stretch of time, in {tu sawng}, at present, these days, and {tua sawng}, at that time) (r:zd:23957/zd:21072) (q:draft, low confidence)
sawng = (i:2) (t:n) (f:home) (w:storey/floor) (d:a level of a building, counted with a number after it, as in {sawng 5}, five storeys) (r:zd:14844) (q:draft, low confidence)
sawnna = (i:1) (t:n) (f:everyday/social) (w:passing on/relaying) (d:<sawn>, onward, with the noun ending {-na}, placed after a verb of saying or giving: the passing on to others of what one has heard or received, as {theihsak sawnna}, the passing on of information) (b:sawn) (r:zd:20792/zd:15474) (q:draft)
sawnsawn = (i:2) (t:adv) (f:everyday) (w:even/in fact/indeed) (d:placed after the verb at the end of a statement, it adds that the fact is more than was expected or said before, even so or in fact, with no sense of going on, as in {kici sawnsawn hi}, it is even said) (r:zd:22683/zd:14566/zd:14954) (q:draft, low confidence)
sawnsuk = (i:1) (t:v) (f:everyday) (w:push down/push into/shove in) (d:<sawn>, push, and <suk>, down or into, written as one word) (j:sawn/suk) (r:zd:16676/zd:25477) (q:draft)
sawntuk = (i:1) (t:v) (f:everyday) (w:push over/push down/knock down) (d:<sawn>, push, and <tuk>, fall, written as one word: push someone or something so that it falls) (j:sawn/tuk) (r:zd:20132/zd:16256) (q:draft)
sawp = (i:1) (t:v) (f:everyday/home) (w:wash) (d:wash a thing or a part of the body such as clothes, nets, hands or feet) (s:sil) (r:42.5.2) (q:draft)
sawt = (i:1) (t:adj) (f:time/everyday) (w:long/lasting) (d:long in time; {a sawt loin} is soon or before long, {sawt pek} is long ago, and {sawt veipi} is for a long time) (s:sau) (a:tom) (q:draft)
sawt lo-in = (i:1) (t:phrase) (f:everyday/time) (w:soon/before long) (r:zai:soon) (q:draft)
sawtding = (i:1) (t:v) (f:time) (w:will last/will take long) (d:<sawt>, long in time, with <ding>, will, written as one word: after a length of time, it will last or take that long) (j:sawt/ding) (r:zd:12101/zd:19801) (q:draft)
sawthetlo = (i:1) (t:adv) (f:time) (w:not long after/very soon/before long) (d:<sawt>, long, and <hetlo>, not at all, written as one word; {a sawthetlo in} is after no time at all, very soon) (j:sawt/hetlo) (r:zd:21075/zd:21876) (q:draft)
sawtin = (i:1) (t:adv) (f:time) (w:lasting/for as long as/long) (d:<sawt>, long in time, and <in> written as one word after a length of time: lasting that long, for that length of time) (j:sawt/in) (r:zd:14624/zd:12464) (q:draft)
sawtkhin = (i:1) (t:v) (f:time) (w:have lasted long/be long past) (d:<sawt>, long in time, and <khin>, already, written as one word: a long time has already passed; after a length of time, that much time has gone by) (j:sawt/khin) (r:zd:20335/zd:19480) (q:draft)
sawtkhinta = (i:1) (t:v) (f:time) (w:it is already long/have been long) (d:<sawt>, long in time, with <khinta>, already, written as one word: a long time has already passed, often after a number of years) (j:sawt/khinta) (r:zd:20278/zd:17195/zd:21601) (q:draft)
sawtlo = (i:1) (t:adv) (f:time) (w:soon/before long/not long) (d:<sawt> and <lo> written as one word: not long; {a sawtlo in} is soon, before long) (j:sawt/lo) (r:zd:21389/zd:16173/zd:23888) (q:draft)
sawtloin = (i:1) (t:adv) (f:time) (w:soon/before long/shortly) (d:<sawt>, long, and <loin>, without, written as one word, often as {a sawtloin}: without it being long, soon) (j:sawt/loin) (r:zd:22019/zd:19661) (q:draft)
sawtlua = (i:1) (t:adj) (f:time) (w:too long/very long) (d:<sawt>, long in time, and <lua>, too, written as one word; {a sawtlua lo in} is not long after, before long) (j:sawt/lua) (r:zd:19098/zd:18017/zd:15659) (q:draft)
sawtmahmah = (i:1) (t:adj) (f:time) (w:very long) (d:<sawt> and <mahmah> written as one word: a very long time) (j:sawt/mahmah) (r:zd:13233/zd:20363) (q:draft)
sawtnailo = (i:1) (t:adj) (f:time) (w:not long/recent) (d:<sawt> long and <nailo> not yet, written as one word: it is not long since, a short time ago) (j:sawt/nailo) (r:zd:12048/zd:12482/zd:12504) (q:draft)
sawtpen = (i:1) (t:adj) (f:time) (w:longest/at the longest) (d:<sawt>, long in time, with <pen>, most, written as one word: the longest; before a length of time, at the longest) (b:sawt) (r:zd:11702/zd:22695) (q:draft)
sawtpipek = (i:1) (t:adv) (f:time) (w:very long ago/a long time ago) (d:<sawtpi>, for a long time, and <pek>, far back, written as one word; {abeisa sawtpipek akipan} is since long ago) (j:sawtpi/pek) (r:zd:13089/zd:19569) (q:draft)
sawtpipi = (i:1) (t:adv) (f:time) (w:for a very long time/very long) (d:<sawt>, long in time, with the intensifier <pipi>: for a very long time) (s:sawtpi) (j:sawt/pipi) (r:zd:15527/zd:23191) (q:draft)
sawtpitak = (i:1) (t:adv) (f:time) (w:for a very long time/very long) (d:<sawtpi>, for a long time, strengthened by <tak>: for a very long time; {hun sawtpitak} is a very long time) (j:sawtpi/tak) (r:zd:15951/zd:24276) (q:draft)
sawtsawt = (i:1) (t:adv) (f:time) (w:in the long run/after a long time/eventually) (d:<sawt>, long in time, said twice: as time goes on; {a sawtsawt ciangin} is after a long while, in the end) (b:sawt) (r:zd:17152/zd:20083/zd:21605) (q:draft)
sawtsimsim = (i:1) (t:adj) (f:time) (w:quite long/a good while) (d:<sawt>, long in time, and <simsim>, quite, written as one word: quite a long time; {sawtsimsim ciangin} is after quite a while) (j:sawt/simsim) (r:zd:21649/zd:19774) (q:draft)
Saya = (i:1) (t:n) (f:education/social) (w:teacher/Saya) (d:Burmese title for a teacher or a respected man, placed before the name) (s:Sia) (o:Burmese, saya) (r:zd:25221/zd:15971) (q:draft)
Sayadaw = (i:1) (t:n) (f:religion) (w:Buddhist abbot/senior monk) (d:title of a senior Buddhist monk, the head of a monastery, placed after or before his name) (o:Burmese) (r:ts:7392/zd:19680) (q:draft)
Sayama = (i:1) (t:n) (f:education/health) (w:woman teacher/nurse/Sayama) (d:Burmese title for a woman teacher, placed before the name; also a nurse) (s:sianu) (o:Burmese, sayama) (r:zd:16038) (q:draft)
sazan = (i:1) (t:n) (f:work) (w:deposit/advance payment) (d:money paid in advance to secure a purchase or contract; probably the Burmese word for a deposit) (o:Burmese) (r:zd:24358) (q:draft, low confidence)
sazian kipia = (i:1) (t:v) (f:social/work) (w:be registered/be signed up) (d:<sazian>, list, and <kipia>, be given: a name is handed in for a list, one registers or signs up; usually {min sazian kipia}, with <min>, name, and the person who takes the names marked by {tung ah} or <ah>) (r:zd:21550/zd:25286) (q:draft)
scale = (i:1) (t:n) (f:education) (w:scale) (d:a scale of measurement, as of temperature or of a drawing) (o:English) (r:zd:19166) (q:draft, low confidence)
Scan = (i:1) (t:n) (f:health) (w:scan) (d:an examination of the inside of the body or of luggage by machine, as {CT Scan}; {Scan bawl} is do a scan) (o:English) (r:zd:17085/zd:23533) (q:draft)
Scandinavian = (i:1) (t:name) (c:people) (f:social) (w:Scandinavian) (d:of the peoples of Scandinavia in northern Europe; {Scandinavian mite} is the Scandinavians) (o:English) (r:zd:20334) (q:draft, low confidence)
Schedule = (i:1) (t:n) (f:time/work) (w:schedule/timetable) (d:the English word used in Zolai sentences for a plan of fixed times; normally written without a capital) (o:English) (r:zd:16556/zd:19506/zd:17463) (q:draft)
