sum = (i:1) (t:n) (f:work/everyday) (w:money/wealth) (d:money, and wealth counted in money; {sum hau} is be rich, {sum leh pai} is money and goods) (s:dangka/sumlepai) (q:draft)
sum don = (i:1) (t:v) (f:work/social) (w:pay a contribution/pay in/contribute money) (d:<sum>, money, and <don>, here pay in a share: pay the contribution or premium that every member of a fund owes; {sum don zah} is the amount to be paid, and the name of the fund stands before it) (r:zd:25568/zd:22489) (q:draft, low confidence)
sum khakna = (i:1) (t:n) (f:work) (w:money transfer/remittance/sending money) (d:<sum>, money, and <khakna>, sending, from <khak>, send: the sending of money to someone far away, a remittance, and a service or means by which money is sent) (r:zd:10685/zd:25518) (q:draft)
sum ngahna = (i:1) (t:n) (f:work) (w:income/receipts/earning) (d:<sum>, money, and <ngahna>, getting: money received, or the getting of it; {sum ngahna leh zatna} is income and expenditure in accounts, {huhna sum ngahna} is donations received, and {sum ngahna ding} is in order to earn money) (s:sumlut) (r:zd:24182/zd:21032/zd:21377) (q:draft)
sum thalawh = (i:1) (t:v) (f:work) (w:earn money/work for wages) (d:<sum>, money, and <thalawh>, work for: to earn money by one's labour, to work for a living; often followed by <theihna>, a way of earning, or <dingin>, in order to earn) (r:zd:22755/zd:11409) (q:draft)
Sumatra = (i:1) (t:name) (c:land) (f:travel) (w:Sumatra) (d:large island of Indonesia, with the provinces North, West and South Sumatra) (r:zd:22193/zd:19695) (q:draft)
sumbei = (i:1) (t:n) (f:work/everyday) (w:expense/cost/spending) (d:<sum>, money, with <bei>, be used up: money spent, the cost of something; {sumbei lo} is without cost, free) (j:sum/bei) (r:zd:23990/zd:22938/zd:17152) (q:draft)
sumbeilo = (i:1) (t:adv) (f:work) (w:free of charge/without cost) (d:<sum>, money, <bei>, be used up, and <lo>, not, written as one word: without spending money, free) (j:sum/bei/lo) (r:zd:13241/zd:24276) (q:draft)
sumbuk = (i:1) (t:n) (f:work/social) (w:market/marketplace) (d:place of buying and selling; {sumbuk vante} is merchandise, {sumbuk bawlte} are traders) (s:sumzuakna/vanzuakna) (r:44.17.17) (q:draft)
sumbul = (i:1) (t:n) (f:work) (w:capital/principal/investment) (d:<sum>, money, with <bul>, base: the money with which a business is started, and the sum lent or invested as opposed to its interest) (r:zd:19774/zd:23767/zd:10743) (q:draft)
sumdal = (i:1) (t:n) (f:work) (w:banknote/note/bill) (d:<sum>, money, with <dal>, sheet: a piece of paper money) (r:zd:21586) (q:draft)
sumkhak = (i:1) (t:v) (f:work/family) (w:send money/remit) (d:<sum>, money, with <khak>, here in the sense of send, written as one word: send money to someone far away, above all from abroad to the family at home; also as a noun, money sent, a remittance) (j:sum/khak) (r:zd:22984/zd:15902/zd:16813) (q:draft)
sumlaidal = (i:1) (t:n) (f:work) (w:banknote/paper money/note) (d:money printed on paper, from <sum>, money, and <laidal>, sheet of paper; set against <sumtang>, coin) (r:zd:11457/zd:11587) (q:draft)
sumlehpaai = (i:1) (t:n) (f:work) (j:sumlepai) (r:zd:20920/zd:24605) (q:draft)
sumlei = (i:1) (t:v) (f:work/everyday) (w:buy) (d:buy with money, mostly in the pair {sumlei sumzuak}, buying and selling) (s:vanlei) (a:sumzuak) of currency
sumlei sumzuakna = (i:1) (t:n) (f:work/politics) (w:trade/commerce/business/economy) (d:<sumlei>, buy, and <sumzuakna>, selling: buying and selling taken as one thing, trade and commerce, and in writing on public affairs the economy of a country) (r:zd:19997/zd:25343) (q:draft)
sumleitawi = (i:1) (t:n) (f:work) (w:loan/borrowed money) (d:<sum> and <leitawi> written as one word: money taken on loan, and the lending and borrowing of money; {sumleitawi la} is take a loan) (j:sum/leitawi) (r:zd:22742/zd:19558) (q:draft)
sumlepaai = (i:1) (t:n) (f:work) (j:sumlepai) (r:zd:24061/zd:22650) (q:draft)
sumlom = (i:1) (t:n) (f:work) (w:sum of money/lump sum/bundle of money) (d:<sum>, money, with <lom>, lump or bundle: a large amount of money in one piece; {sumlom pi} is a big sum) (r:zd:21918/ts:11162) (q:draft)
sumlut = (i:1) (t:n) (f:work) (w:income/revenue/earnings) (d:<sum>, money, with <lut>, come in: the money that a person, a business or a country takes in) (r:zd:24043/zd:22282/zd:21989) (q:draft)
sumlutna = (i:1) (t:n) (f:work) (w:income/revenue/earnings) (d:<sum>, money, with <lutna>, coming in: the money that a person, a business or a government takes in) (r:zd:11401/zd:15234/zd:11852) (q:draft)
summer = (i:1) (t:n) (f:time/nature) (w:summer) (d:the hot season, mostly of other countries, as in {summer hun sung}, during the summer) (s:khuakhal) (o:English) (r:zd:17060/zd:24067) (q:draft)
summet bawlna = (i:1) (t:n) (f:work) (w:business/profit-making/trade) (d:<summet>, profit, and <bawlna>, doing: the making of profit, a business or trade run for gain; {summet bawlna dingin} is for doing business, and {summet bawlna in zang} is use for profit) (s:sumbawlna) (r:zd:23729/zd:17067) (q:draft)
sumngen = (i:1) (t:v) (f:work/social) (w:ask for money/demand money) (d:<sum>, money, with <ngen>, ask for, written as one word: ask for or demand money, as a child, a beggar or one who charges for a service) (j:sum/ngen) (r:zd:18292/zd:15443) (q:draft)
sumpen = (i:1) (t:n) (f:work) (w:money/the money) (d:<sum>, money, and the topic marker <pen> written as one word: the money, as for the money) (j:sum/pen) (r:zd:22451/zd:11380/zd:16949) (q:draft)
sumpia = (i:1) (t:v) (f:work) (w:pay/give money) (d:<sum> and <pia> written as one word: pay money for something, also pay someone off, bribe; {sumpia in} is by paying) (j:sum/pia) (r:zd:18943/zd:20486/zd:17886) (q:draft)
sumpiak = (i:1) (t:n) (f:work) (w:payment/paying money) (d:<sum>, money, and <piak>, give, written as one word: the paying of money; {sumpiak kullo} is without having to pay, free) (j:sum/piak) (r:zd:19953/zd:16788/zd:12913) (q:draft)
sumpiang = (i:1) (t:n) (f:nature/work) (w:mineral/natural resource) (d:wealth that comes out of the ground, such as ore, metal and precious stones; mostly in {leisung sumpiang}, minerals under the ground) (r:zd:16455/zd:12279/zd:24495) (q:draft)
sumtampi = (i:1) (t:n) (f:work/everyday) (w:much money/a lot of money/fortune) (d:<sum>, money, and <tampi>, much, written as one word: a large amount of money) (j:sum/tampi) (r:zd:17607/zd:19774/zd:21869) (q:draft)
sumtawh = (i:1) (t:adv) (f:work/everyday) (w:with money/by money) (d:<sum>, money, and <tawh>, with, written as one word: with money, by means of money) (j:sum/tawh) (r:zd:20747/zd:24089/zd:21869) (q:draft)
sumtha = (i:1) (t:n) (f:work/social) (w:financial strength/financial resources/funds) (d:<sum> money with <tha> strength: the strength that money gives, set beside {mihing tha}, manpower) (r:zd:23496/zd:24750) (q:draft)
sumtuh = (i:1) (t:n) (f:work/politics) (w:counterfeit money/fake money/forged banknotes) (d:<sum>, money, that is <atuh>, fake or imitation: money made to pass as real) (r:zd:11608/zd:12788/zd:12482) (q:draft)
sumvai = (i:1) (t:n) (f:work/politics) (w:finance/money matters/financial affairs) (d:<sum>, money, with <vai>, affair: matters of money, finance or funds) (r:zd:11652/zd:17152) (q:draft)
sumzat = (i:1) (t:n) (f:work) (w:expense/spending/expenditure) (d:<sum>, money, and <zat>, use, written as one word: the money that is spent, and the spending of it) (j:sum/zat) (r:zd:23301/zd:15983/zd:24852) (q:draft)
sumzat = (i:2) (t:n) (f:work) (w:currency) (d:the money in use in a country) (j:sum/zat) (r:zd:22381) (q:draft, low confidence)
sumzatna = (i:1) (t:n) (f:work) (w:expenditure/spending/expenses) (d:<sum>, money, and <zatna>, using, written as one word: the money that is spent, or the way one spends it) (j:sum/zatna) (r:zd:21220/zd:23301/ts:2400) (q:draft)
sumzian = (i:1) (t:n) (f:work) (w:capital/funds/investment) (d:money put into a business or needed for an undertaking, also the sum spent on it) (r:zd:19829/zd:14665/zd:14551) (q:draft)
sumzon = (i:1) (t:v) (f:work) (w:earn money/make a living) (d:<sum>, money, and <zon>, seek, written as one word: work to earn money; also used as a noun, the earning of money) (j:sum/zon) (r:zd:15941/zd:20443/zd:22464) (q:draft)
sumzong = (i:1) (t:v) (f:work) (w:earn money/make a living/seek money) (d:<sum>, money, and <zong>, seek, written as one word: work to earn money, often of those who go abroad for it) (j:sum/zong) (r:zd:19676/zd:19603) (q:draft)
sumzong = (i:2) (t:phrase) (f:work/everyday) (w:the money also/money too) (d:<sum>, money, and <zong>, also, written as one word) (j:sum/zong) (r:zd:15814) (q:draft, low confidence)
sumzonna = (i:1) (t:n) (f:work) (w:earning money/livelihood/business) (d:<sum>, money, with <zonna>, seeking: the earning of money, and the work or business by which one earns it) (j:sum/zonna) (r:zd:23301/zd:15276/zd:19145) (q:draft)
sun = (i:1) (t:n) (f:time) (w:day/daytime) (d:the light part of the day, the opposite of <zan>, night; {sun leh zan} is day and night and {sun-in} is by day) (a:zan) as in during sun light
sun an = (i:1) (t:n) (f:food/time) (w:lunch/midday meal) (d:<sun>, daytime, and <an>, food: the midday meal; the other meals are named the same way with the time of day before <an>) (r:zd:19371/zd:17963) (q:draft)
Sunday = (i:1) (t:n) (c:ni) (f:time) (w:Sunday) (s:nipi) (o:English) (r:zd:16136/zd:20382/zd:16373) (q:draft)
sung tawntung = (i:1) (t:prep) (f:time) (w:throughout/all through/during the whole of) (d:<sung>, within, and <tawntung>, without stopping: placed after a word for a span of time, through the whole of it, as {a nuntak sung tawntung}, all his life long) (r:zd:9261/zd:25393/zd:19858) (q:draft)
sung vilvel = (i:1) (t:adv) (f:time) (w:for the whole of/all through/for fully) (d:<sung>, during, and <vilvel>, here a word that stresses the full length: placed after a number of days or years, for that whole time without a break) (r:zd:15653/zd:22683) (q:draft)
sungaa = (i:1) (t:prep) (f:everyday) (w:in/inside/within) (d:<sung>, inside, and <aa> written as one word, placed between a noun and what is inside it: {pumpi sungaa}, that is in the body) (j:sung/aa) (r:zd:21006/zd:21085/zd:21918) (q:draft)
sungahzong = (i:1) (t:adv) (f:everyday) (w:also in/inside too) (d:<sungah> and <zong> written as one word: in it also, inside as well) (j:sungah/zong) (r:zd:16794/zd:11854) (q:draft)
sungaom = (i:1) (t:adj) (f:everyday/travel) (w:located in/in) (d:<sung>, in, with <a> and <om>, be, written as one word: that is in, placed between a place and what is found there) (j:sung/a/om) (r:zd:14995/zd:17647) (q:draft)
sungbang = (i:1) (t:prep) (f:time) (w:for about/within about) (d:<sung> and <bang> written as one word, placed after a length of time or a measure: for about that long, within roughly that much) (j:sung/bang) (r:zd:20946/zd:11058/zd:22894) (q:draft)
sungbek = (i:1) (t:adv) (f:time) (w:only within/only during/only in) (d:<sung> and <bek> written as one word, placed after a word of time or place: only for that length of time, only inside that place) (j:sung/bek) (r:zd:16178/zd:14887/zd:20854) (q:draft)
sungh = (i:1) (t:n) (f:family) (w:in-law/wife's family) (d:relatives by marriage on the wife's side, such as her father, {sungh pa}; often named together with <pu>, the mother's side) (r:zd:24188/zd:24072) (q:draft, low confidence)
sungh = (i:2) (t:v) (f:politics/social) (w:submit/propose/put forward) (d:bring a matter or request before a body or a person in authority, usually as {thu sungh}) (r:zd:14755/zd:22411/zd:11463) (q:draft)
sunghpa = (i:1) (t:n) (f:family) (w:father-in-law) (d:the father of a man's wife) (r:zd:24320/zd:17332) (q:draft)
sunghte = (i:1) (t:n) (f:family) (w:parents-in-law/in-laws) (d:<sungh>, parent-in-law, with plural <te>: the parents of one's wife or husband and their household; {a sunghte inn} is the house of his in-laws) (r:zd:17341/ts:261/zd:19108) (q:draft)
sungkhat = (i:1) (t:phrase) (f:everyday) (w:inside a/in one) (d:<sung>, inside, and <khat>, one, written as one word after a noun: the inside of a certain one, as {Hotel sungkhat ah}, in a hotel; {tun sungkhat pan} is from one womb, of the same mother) (j:sung/khat) (r:zd:19790/zd:12132) (q:draft)
sungkhatah = (i:1) (t:adv) (f:everyday/travel) (w:in a/inside a) (d:<sung>, inside, <khat>, one, and <ah> written as one word and placed after a noun: inside one such place, in a hotel, in a car, in a video) (j:sung/khat/ah) (r:zd:15803/zd:15301/zd:18102) (q:draft)
sungkhawng = (i:1) (t:adv) (f:everyday/time) (w:for about/somewhere in/in or around) (d:<sung>, in, and <khawng>, or so, written as one word: after a length of time, for about that long; after a place, with <ah>, somewhere in it) (j:sung/khawng) (r:zd:16164/zd:16885/zd:18286) (q:draft)
sunglampilna = (i:1) (t:n) (f:education/health) (w:subconscious mind/inner mind/inner wisdom) (d:<sunglam>, inside, and <pilna>, wisdom, written as one word: the inner or subconscious mind, set against {pualam pilna}, the conscious mind) (j:sunglam/pilna) (r:zd:21876/zd:21869) (q:draft)
sunglamtha = (i:1) (t:n) (f:everyday) (w:inner strength/inner power) (d:<sunglam>, inside, with <tha>, strength: the power within a person, of mind or spirit, as against outward things; also said of the engine that drives a car) (j:sunglam/tha) (r:zd:21389/zd:20829) (q:draft)
sungmah = (i:1) (t:prep) (f:everyday) (w:right in/within) (d:<sung> and <mah> written as one word: in that very place or time, right inside it; mostly followed by <ah> or <in>) (j:sung/mah) (r:ts:301/zd:24610) (q:draft)
sungpai = (i:1) (t:n) (f:health/body) (w:diarrhoea/bowel movement) (d:<sung>, inside, with <pai>, go: the emptying of the bowels, and especially loose bowels, diarrhoea; {sungpai natna} is diarrhoeal disease and {sungpai zavat natna} cholera) (r:zd:11617/zd:11020/zd:24276) (q:draft)
sungpen = (i:1) (t:phrase) (f:time/everyday) (w:during/within) (d:<sung>, in, and the topic marker <pen>, written as one word after a time or place: as for the time during, as for the area within) (j:sung/pen) (r:zd:23797/zd:22203) (q:draft)
sungta = (i:1) (t:adv) (f:time) (w:for as long as/for each period of) (d:<sung>, during, with <ta>, placed after a length of time: for that long each time or each one, as in {nai 5 sungta}, for five hours each) (j:sung/ta) (r:zd:19213/zd:19826) (q:draft, low confidence)
sungta = (i:2) (t:n) (f:family) (w:in-laws/relatives by marriage) (d:persons related through a marriage, a parent-in-law and a child-in-law taken as a pair; said beside {unau-pata} and {putu}) (r:ts:9672) (q:draft, low confidence)
sungtak = (i:1) (t:adv) (f:time) (w:for a full/as long as) (d:<sung> and <tak> written as one word, placed after a length of time to stress it: for fully that long; {nai 10 sungtak} is for a full ten hours) (j:sung/tak) (r:zd:14839/zd:15659/zd:17450) (q:draft)
sungteen = (i:1) (t:n) (f:home) (w:underwear/undergarment/underpants) (d:a garment worn under the outer clothes; {bombi sungteen} is underpants) (r:zd:14561/zd:16696) (q:draft)
sungten = (i:1) (t:n) (f:home) (w:underwear/underpants/undergarment) (d:clothing worn next to the body under other clothes; {pheituam sungten} is underpants) (r:zd:22499/zd:23131) (q:draft)
sungzong = (i:1) (t:adv) (f:everyday/time) (w:also in/also during/even within) (d:<sung>, in or during, and <zong>, also, written as one word, placed after a place or a length of time) (j:sung/zong) (r:zd:17595/zd:15417) (q:draft)
sunkim = (i:1) (t:n) (f:time) (w:noon/midday) (d:the middle of the day; {sunkim laipi} is high noon) (s:suntang/suntangpi) (a:zankim) (r:11.18.29) (q:draft)
sunlam = (i:1) (t:n) (f:time) (w:daytime/midday) (d:<sun>, day, with <lam>, side: the daytime part of the day, in news the hours around noon, between morning and evening; {Monday sunlam in} is on Monday around midday) (r:zd:19554/zd:15535/zd:22151) (q:draft)
sunmang = (i:1) (t:n) (f:everyday/social) (w:dream/aspiration/vision) (d:what a person or a people hopes and longs to reach, a dream for the future; named together with <lametna>, hope, and <ngimna>, aim) (r:zd:24248/zd:25129/zd:24455) (q:draft)
sunni = (i:1) (t:n) (f:nature) (w:sun/sunshine) (d:<sun>, daytime, with <ni>, here the sun: the sun of the day and its light, mostly in songs and elevated speech) (j:sun/ni) (r:zd:23554/zd:19378) (q:draft, low confidence)
sunsiah = (i:1) (t:n) (f:food) (w:lunch/midday meal/packed lunch) (d:food eaten at midday, also the food packed to take along for the day) (r:zd:23616/zd:20946/zd:17963) (q:draft)
suntawh = (i:1) (t:adv) (f:time) (w:by day/day) (d:<sun>, day, with <tawh>, with, written as one word; used in the pair {suntawh zantawh}, day and night, around the clock) (j:sun/tawh) (r:zd:14652/zd:21869) (q:draft)
