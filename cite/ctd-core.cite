list = (i:1) (t:n) (f:everyday/work) (w:list) (d:a written list of names or items) (s:sazian) (o:English) (r:zd:11224/zd:20968) (q:draft)
Liter = (i:1) (t:n) (f:everyday/work) (w:liter/litre) (d:the unit for measuring liquids such as water and fuel; the number follows it, as {liter 4}, four liters) (o:English) (r:zd:24276/zd:13171) (q:draft)
Lithuania = (i:1) (t:name) (c:land) (f:politics/travel) (w:Lithuania) (d:country in northern Europe, on the Baltic Sea) (r:zd:25918/zd:16997) (q:draft)
litlet = (i:1) (t:adv) (f:everyday) (w:neatly/tidily/in good order) (d:placed after a verb or describing word: in a neat, orderly and complete way; {om litlet} is be there intact and in order) (r:zd:17442/zd:12976/ts:301) (q:draft)
litre = (i:1) (t:n) (f:everyday/food) (w:litre/liter) (d:the metric unit for measuring liquids) (o:English) (r:zd:20588/zd:20831/zd:22650) (q:draft)
liuleu = (i:1) (t:adv) (f:everyday) (w:completely/clean off/outright) (d:placed after a verb of cutting off, separating, overturning or dying: the thing is wholly severed or lies there finished) (r:zd:22540/zd:13159) (q:draft, low confidence)
Live = (i:1) (t:n) (f:media/it) (w:live broadcast/live stream) (d:a broadcast or video stream shown while the event happens, mostly on Facebook; {Live in khah} is broadcast live) (o:English) (r:zd:17788/zd:24226) (q:draft)
Liverpool = (i:1) (t:name) (c:city) (f:travel/media) (w:Liverpool) (d:Liverpool, a port city in England, and its football club) (r:zd:24612/zd:9209) (q:draft)
lo = (i:1) (t:adv) (f:everyday) (w:not) (d:negative word placed after a verb or describing word: {nei lo} is not have, {om lo} is not be there)
lo = (i:2) (t:n) (f:work/nature) (w:farm/field) (d:a piece of land that is worked to grow crops)
loa = (i:1) (t:adv) (f:everyday) (w:not/without) (d:<lo>, not, with the linking <a> written as one word: not doing so and, without) (j:lo/a) (r:zd:24119/zd:25275) (q:draft)
loan = (i:1) (t:n) (f:work) (w:loan) (d:money borrowed that is to be paid back, in the articles mostly a student loan or a loan to a government) (s:leitawi) (o:English) (r:zd:20545/zd:23787) (q:draft, low confidence)
Lobby = (i:1) (t:n) (f:travel/home) (w:lobby/entrance hall) (d:the entrance hall of a hotel, hospital, apartment block or other large building) (o:English) (r:zd:14568/zd:17661) (q:draft)
lobuk = (i:1) (t:n) (f:home/work) (w:field hut/farm hut/shanty) (d:a small hut built at a <lo>, a farm field, away from the village, where people rest, cook or stay while working the field) (r:zd:25346/zd:24963) (q:draft)
lockdown = (i:1) (t:n) (f:health/politics) (w:lockdown) (d:the closing of a town or country and the order to stay at home, as during the Covid-19 epidemic; {lockdown bawl} is to impose it) (o:English) (r:zd:23825/zd:24019) (q:draft)
lockup = (i:1) (t:n) (f:politics/social) (w:lockup/police cell/detention cell) (d:the cells of a police station, in Malaysia, where a person is held after arrest; named after the station, as in {Jinjang lockup}) (o:English) (r:zd:23709/zd:11706/zd:21282) (q:draft)
lodia = (i:1) (t:part) (f:everyday) (w:will it not/would it not) (d:<lo>, not, and <dia>, the spoken question word, written as one word at the end of a sentence, often followed by <maw>: will it not be so, surely it is) (j:lo/dia) (r:zd:16442/zd:11953) (q:draft)
loding = (i:1) (t:part) (f:everyday) (w:will not/shall not) (d:<lo>, not, and <ding>, will, written as one word after a verb: will not, is not going to; at the end of a rule it means must not) (j:lo/ding) (r:zd:19556/zd:22888/zd:15958) (q:draft)
lodingin = (i:1) (t:phrase) (f:everyday) (w:so as not to/in order not to) (d:<lo>, not, with <dingin>, in order to, written as one word after a verb) (j:lo/dingin) (r:zd:23538/zd:16235) (q:draft)
logamte = (i:1) (t:n) (f:nature/work) (w:farmlands/fields) (d:<logam>, farmland, with the plural <te>: fields, cultivated lands) (b:logam) (j:logam/te) (r:ts:479/zd:24249) (q:draft)
Logo = (i:1) (t:n) (f:media/work) (w:logo/emblem) (d:the emblem or symbol of a party, company or organisation) (o:English) (r:zd:24607/zd:10743/zd:17630) (q:draft)
loh hangin = (i:1) (t:conj) (f:everyday) (w:although not/even though not/even if not) (d:<loh>, the negative after a verb, and <hangin>, although: placed after a verb, although that is not so; the main statement follows, often with <veve>, still) (r:zd:22849/zd:21254/zd:23758) (q:draft)
loh nadingin = (i:1) (t:conj) (f:everyday) (w:so that not/in order not to/lest) (d:<loh>, the negative form used before an ending, and <nadingin>, so that: placed after a verb, it states the thing that the following action is meant to prevent, so that it does not happen) (r:zd:23729/zd:25355/zd:24037) (q:draft)
loh phamawh = (i:1) (t:phrase) (f:everyday) (w:must/have to/cannot but) (d:<loh>, not doing, and <phamawh>, serious: placed after a verb in its second form, not to do it would be serious, so it must be done; {tai loh phamawh} is have to flee) (r:zd:23057/zd:24240/zd:16441) (q:draft)
lohciang = (i:1) (t:conj) (f:everyday) (w:when not/if not) (d:the negative <loh> and <ciang>, when, written as one word after a verb: when or because something does not happen) (j:loh/ciang) (r:zd:12033/zd:16235) (q:draft)
lohciangin = (i:1) (t:conj) (f:everyday) (w:when not/as not) (d:the negative <loh> with <ciangin>, when, written as one word after a verb: when that did not happen) (j:loh/ciangin) (r:zd:11986) (q:draft)
lohding = (i:1) (t:part) (f:everyday) (w:not to/so as not to) (d:<loh> and <ding> written as one word after a verb: that the thing not be done or not happen; {lohding thupi hi} is it is important not to, {lohding in} is so as not to) (j:loh/ding) (r:zd:12115/zd:18943/zd:13314) (q:draft)
lohhang = (i:1) (t:conj) (f:everyday) (w:although not/even though not) (d:<loh> and <hang> written as one word after a verb, with or without <in>: even though it is not so or was not done) (j:loh/hang) (r:zd:12267/zd:12057/zd:25932) (q:draft)
lohhangin = (i:1) (t:conj) (f:everyday) (w:although not/even though not) (d:<loh>, not, and <hangin>, although, written as one word after a verb: even though that is not so or did not happen) (j:loh/hangin) (r:zd:12094/zd:12632/zd:22376) (q:draft)
lohi = (i:1) (t:part) (f:everyday) (w:not) (d:<lo>, not, and the sentence ending <hi> written as one word: closes a negative statement, is not, does not) (j:lo/hi) (r:zd:23551/zd:20905/zd:23492) (q:draft)
lohiam = (i:1) (t:part) (f:everyday) (d:<lo> and the question word <hiam> written as one word at the end of a clause: is it not so, why not; it makes a negative question, also a rhetorical one) (j:lo/hiam) (r:zd:20302/zd:13314) (q:draft)
lohman = (i:1) (t:conj) (f:everyday) (w:because not) (d:<loh> and <man> written as one word after a verb, with or without <in>: because it is not so or was not done) (j:loh/man) (r:zd:25178/zd:12068/zd:21134) (q:draft)
lohna dingin = (i:1) (t:conj) (f:everyday) (w:so that not/lest) (d:<lohna>, the not doing, and <dingin>, in order to: placed after a verb, so that it does not happen, in order not to; the negative of <nadingin>) (r:zd:21458/zd:9141) (q:draft)
lohna hangin = (i:1) (t:conj) (f:everyday) (w:because of not/for not) (d:<lohna>, the noun form of the negative, and <hangin>, because of: placed after a verb, because of not doing or not being so; the clause that follows gives the result) (r:zd:21845/zd:20418) (q:draft)
lohnading = (i:1) (t:phrase) (f:everyday/work) (w:in order to pay off/to repay) (d:<loh>, pay off, with <nading>, written as one word: in order to pay a debt, as in {leibat lohnading}) (j:loh/nading) (r:zd:15651) (q:draft)
lohnading = (i:2) (t:phrase) (f:everyday) (w:so as not to/not to) (d:the negative <loh> with <nading>, written as one word after a verb: for not doing, so that it is not done; usually written {loh nading}) (j:loh/nading) (r:zd:17955) (q:draft, low confidence)
lohnang = (i:1) (t:phrase) (f:everyday) (w:so as not to/in order not to) (d:a short form of {loh nading}, written as one word after a verb: so that something does not happen; the same as <lohnading>) (r:zd:22830/zd:14615) (q:draft)
Loikaw = (i:1) (t:name) (c:city) (f:travel/politics) (w:Loikaw) (d:capital of Kayah State in eastern Myanmar) (r:zd:14609/ts:4379) (q:draft)
lokhawh = (i:2) (t:n) (f:work/nature) (w:farming/agriculture/cultivation) (d:the working of fields to grow crops, <lo>, field, with <khawh>, till: used as a noun and before <nading> and <dan>, and paired as {lokhawh singpuak}, farm work in general) (s:lokho) (r:zd:23770/ts:3375/zd:21908) (q:draft)
lokhopa = (i:1) (t:n) (f:work) (w:farmer) (d:<lokho>, farm, with <pa> for a man: a man who works the land)
lokuan = (i:1) (t:v) (f:work/nature) (w:go to the field/work in the fields/farm) (d:<lo>, field, with <kuan>, set out: go out to work in the fields; also said of the person who does so, a field worker) (j:lo/kuan) (r:zd:23797/zd:25075/zd:15228) (q:draft)
lokzo = (i:1) (t:v) (f:politics/everyday) (w:shake/be able to shake) (d:<lok>, shake, and <zo>, be able, written as one word: manage to shake or move a country, an army or the world) (j:lok/zo) (r:zd:24990/zd:26092) (q:draft)
lol = (i:1) (t:adj) (f:time/everyday) (w:early) (d:early in the morning or ahead of time, mostly of rising and setting out; {zingsang lol} is early in the morning) (r:zd:21259/zd:19381) (q:draft)
Lombok = (i:1) (t:name) (c:place) (f:travel) (w:Lombok) (d:island of Indonesia, east of Bali) (r:zd:20582/zd:17733) (q:draft)
lomlom = (i:1) (t:adv) (f:everyday/social) (w:in groups/in flocks/in bunches) (d:<lom>, bundle, doubled, mostly as {a lomlom in}: group by group, many together) (b:lom) (r:zd:22305/zd:22758) (q:draft)
lompi = (i:2) (t:n) (f:social/politics) (w:group/bloc/mass) (d:of people or organisations, not a heap of things: a large body of people, or one of the large groups into which a whole is divided, then often followed by a number; {a lompi in} is in a mass) (r:zd:24471) (q:draft, low confidence)
London = (i:1) (t:name) (c:city) (f:travel/politics) (w:London) (d:capital city of England and of the United Kingdom) (r:zd:13009/zd:23975/zd:21649) (q:draft)
longkhia = (i:1) (t:v) (f:everyday/work) (w:pry off/wrench out/pull out/uproot) (d:force something loose from the place where it is fixed and take it out, as nails, a window grille, a wheel or a plant with its root; the second part is <khia>, out) (r:zd:19816/zd:22046/zd:17779) (q:draft)
lopna = (i:1) (t:n) (f:social) (w:celebration/festivity) (d:a joyful marking of an event such as a victory, a wedding, a festival or the installing of a leader; {gualzawh lopna} is a victory celebration) (r:zd:15790/zd:10942) (q:draft)
Lorry = (i:1) (t:n) (f:travel/work) (w:lorry/truck) (d:a large motor vehicle that carries goods, often said together with <mawtawpi>) (o:English) (r:zd:17816/zd:12761) (q:draft)
losan = (i:1) (t:n) (f:social) (w:firecracker/fireworks) (d:a firecracker, and fireworks of any kind set off at festivals) (r:zd:15978/zd:17558) (q:draft)
losiah = (i:1) (t:prep) (f:everyday) (w:except/apart from/other than) (d:placed after the thing excepted: all but that one) (s:simloh) (r:zd:20547/zd:25346/zd:24544) (q:draft)
lotawh = (i:1) (t:prep) (f:everyday) (w:without) (d:the negative <lo> and <tawh>, with, written as one word after a noun: without that thing, other than by it; after a describing word, with what is not so, as in {thuman lotawh}, by dishonest means) (j:lo/tawh) (r:zd:24289/zd:25917) (q:draft, low confidence)
Lotdaw = (i:1) (t:name) (f:politics) (w:Hluttaw/parliament) (d:the parliament of Myanmar, its house of representatives; also written {Lutdaw}) (o:Burmese, hluttaw) (r:zd:16087/zd:24164) (q:draft)
lothak = (i:1) (t:n) (f:nature/work) (w:new field/new farmland) (d:<lo>, field, with <thak>, new: a new plot cleared for farming, or new land to which people move to farm) (j:lo/thak) (r:zd:15772/zd:17309) (q:draft)
lothang = (i:1) (t:n) (c:plant) (f:food) (w:onion/garlic) (d:bulb vegetable of the onion kind; {lothang san}, red, is the onion and {lothang kang}, white, is garlic) (r:zd:22499/zd:24276) (q:draft)
lothangkang = (i:1) (t:n) (f:food) (w:garlic) (d:<lothang> with <kang>, white: garlic; {lothang san} or <lothangsan>, the red one, is onion) (r:zd:24276/zd:24501) (q:draft)
lothangsan = (i:1) (t:n) (c:plant) (f:food) (w:onion/red onion) (d:the onion, the red bulb used in cooking; named beside <lothangkang>, garlic) (r:zd:20959/zd:23729/zd:25115) (q:draft)
lotngah = (i:1) (t:v) (f:education) (w:memorize/learn by heart) (d:fix something in the memory so that it can be said without looking) (r:zd:20968) (q:draft)
lotphei = (i:1) (t:v) (f:everyday) (w:throw across/fling over/launch toward) (d:<lot>, throw or shoot, with a second part meaning across or over toward a place: throw a thing over to someone or fire a missile toward a place) (r:zd:15253/zd:16669) (q:draft)
Lottery = (i:1) (t:n) (f:social/everyday) (w:lottery) (d:a draw in which a prize of money, or a visa as in the American DV Lottery, goes to tickets or names picked by chance) (o:English) (r:zd:22076/zd:17504) (q:draft)
loudspeaker = (i:1) (t:n) (f:media/it) (w:loudspeaker) (d:device that makes the voice loud for a public announcement) (o:English) (r:zd:25937/zd:13151) (q:draft)
Louisiana = (i:1) (t:name) (c:land) (f:travel/politics) (w:Louisiana) (d:a state in the south of the United States) (r:zd:15054/zd:14975) (q:draft)
Louisville = (i:1) (t:name) (c:city) (f:travel) (w:Louisville) (d:city in Kentucky, United States, where a Zomi community lives) (r:zd:15805/zd:9217) (q:draft)
lovegift = (i:1) (t:n) (f:religion) (w:love gift/gift of money/honorarium) (d:a gift of money given out of thanks to a preacher, singer or other servant of the church) (o:English, love gift) (r:zd:25572/zd:19451) (q:draft)
lua = (i:3) (t:adv) (f:everyday) (w:very/so much/greatly) (d:placed after a verb or adjective as a plain intensifier with no idea of excess, often followed by <mahmah> or <takpi>: very, so much, as {nuam lua}, want very much, and {nasia lua}, very fierce) (r:ts:4720/zd:25109/zd:24119) (q:draft)
luading = (i:1) (t:phrase) (f:everyday) (w:will be very/will surely) (d:<lua>, very much or too much, with <ding>, will, written as one word after a verb or describing word: it will be very much so) (j:lua/ding) (r:zd:19676/zd:25275) (q:draft, low confidence)
luahsuk = (i:1) (t:v) (f:family/social) (w:inherit/receive by descent) (d:<luah>, inherit, with <suk>, down: receive something handed down from parents or from those who came before) (b:luah) (j:luah/suk) (r:zd:25734/zd:21657/zd:25917) (q:draft)
luahto = (i:1) (t:v) (f:politics/family) (w:succeed to/take over/inherit) (d:<luah>, inherit, with <to>, up: step up into the office, throne or position that another held) (j:luah/to) (r:zd:11283/zd:21040) (q:draft)
luahuai = (i:1) (t:adj) (f:everyday/body) (w:nauseating/disgusting/sickening/loathsome) (d:<lua>, vomit, with <huai>: making one feel sick, from a great height or from disgust) (r:zd:16035/zd:25569) (q:draft, low confidence)
luahzo = (i:1) (t:v) (f:politics) (w:capture/occupy/take control of) (d:<luah>, occupy, and <zo>, manage to, written as one word: succeed in occupying a town or a position in war) (j:luah/zo) (r:ts:6741/ts:11032) (q:draft)
luai = (i:4) (t:n) (f:home/family) (w:cradle/hammock) (d:a hanging cradle in which a baby is rocked to sleep, as in {luai ah sial}, rock in the cradle; not the seat on which a grown person is carried) (s:nauluai) (r:zd:24119/zd:24086) (q:draft)
luailuai = (i:1) (t:adv) (f:everyday) (w:on and on/merely) (d:placed after a verb: keep on doing it and nothing more, just go along doing it without thought or aim) (r:zd:24411/zd:15894) (q:draft, low confidence)
luakei = (i:1) (t:adv) (f:everyday) (w:not too much/not very) (d:<lua> and <kei> written as one word after a verb: not too much; with <in>, do not do it too much) (j:lua/kei) (r:zd:19266/zd:16442) (q:draft, low confidence)
luakhollo = (i:1) (t:adv) (f:everyday) (w:not very/not all that/hardly) (d:<lua>, too much, and <khollo>, not much, written as one word after a describing word: not to any great degree) (j:lua/khollo) (r:zd:11587/zd:14856) (q:draft)
luaksuak = (i:1) (t:v) (f:health) (w:feel sick/be nauseous/vomit) (d:feel like vomiting, or vomit; named among the signs of illness, of pregnancy and of travel sickness) (r:zd:20433/zd:19593) (q:draft)
lualai = (i:1) (t:adv) (f:everyday) (w:still too/too much yet) (d:<lua>, too, with <lai>, still, written as one word, after a describing word: still too much so, as in {manlang lualai}, still too early) (r:zd:12279/zd:23266) (q:draft, low confidence)
lualo = (i:1) (t:adv) (f:everyday) (w:not very/not so much) (d:<lua>, very or too much, and <lo>, not, written as one word after a verb or describing word: not very, not much) (j:lua/lo) (r:zd:18927/zd:21180/zd:24276) (q:draft)
luamahmah = (i:1) (t:adv) (f:everyday) (w:extremely/far too/very much) (d:<lua> and <mahmah> written as one word: placed after a describing word or verb, to a very great or excessive degree) (j:lua/mahmah) (r:zd:14648/zd:15890/zd:11837) (q:draft)
luang = (i:3) (t:n) (f:body) (w:body/corpse/dead body) (d:the body of a person, in the news mostly a dead one: {misi luang} is a corpse, and a number after it counts the dead; not the verb flow) (s:luanghawm/misiluang) (r:zd:9124/zd:15423/ts:6573) (q:draft)
luanga = (i:1) (t:v) (f:body/everyday) (w:flow/stream down) (d:<luang>, flow, with the linking <a>, and, written as one word; {khitui luanga} is with tears flowing, shedding tears and) (j:luang/a) (r:zd:25668/zd:21273) (q:draft)
luanggawp = (i:1) (t:v) (f:health/nature) (w:flow heavily/pour out/bleed heavily) (d:<luang>, flow, with <gawp>, severely, written as one word: of blood or water, flow in great quantity; {si luanggawp} is bleed heavily) (j:luang/gawp) (r:zd:13330/zd:12717) (q:draft)
luanghawmpen = (i:1) (t:phrase) (f:health/media) (w:the body/the corpse) (d:<luanghawm>, dead body, with the topic marker <pen>, written as one word: as for the body) (j:luanghawm/pen) (r:zd:17154) (q:draft)
luangkham = (i:2) (t:v) (f:everyday/social) (w:risk one's life/stake one's life) (d:used as a verb, put one's own life in danger for someone or something, as in {luangkham ngam}, dare to risk one's life; the other sense is the adverb use with <in>) (r:zd:8375/zd:25414/zd:15528) (q:draft)
luangkhamliang = (i:1) (t:adv) (f:everyday) (w:even at the risk of life) (d:<luangkham>, at the risk of life, with <liang>, even: to the point of risking one's life, usually with <in>) (j:luangkham/liang) (r:zd:16344/zd:26495) (q:draft, low confidence)
luangkhat = (i:1) (t:phrase) (f:everyday) (w:one body/one carcass) (d:<luang>, here body, used in counting dead bodies and whole slaughtered animals, and <khat>, one, written as one word: {misi luangkhat} is one dead body and {vok luangkhat} one whole pig, not the verb flow) (j:luang/khat) (r:zd:23129/zd:12188) (q:draft)
luangkhawm = (i:1) (t:v) (f:everyday/social) (w:flow together/go together/merge) (d:<luang> and <khawm> written as one word: flow together in one stream, and so of matters or people, go together and be at one) (j:luang/khawm) (r:zd:22557/zd:23022) (q:draft)
luangkheng = (i:1) (t:v) (f:politics/everyday) (w:overstep/exceed/go beyond) (d:<luang>, flow, with <kheng>, go beyond: go over a limit, as in {thuneihna luangkheng}, overstep authority) (j:luang/kheng) (r:zd:24714) (q:draft, low confidence)
luanglet = (i:1) (t:v) (f:everyday/politics) (w:overflow/go to excess/be extreme) (d:<luang>, flow, with <let.1>, overflow: run over; in the articles used of people or views that go beyond the proper measure, as {a luanglet te}, the extremists) (r:zd:25312/zd:22369/zd:22592) (q:draft, low confidence)
luangnih = (i:1) (t:phrase) (f:everyday) (w:two bodies/two carcasses) (d:<luang>, here body, and <nih>, two, written as one word: two bodies, counted of dead people or animals) (j:luang/nih) (r:zd:13133/zd:22142) (q:draft)
luangphamna = (i:1) (t:n) (f:social/work) (w:death benefit) (d:money that a community association or its insurance fund pays to the family when a member dies) (r:zd:25265/zd:25789) (q:draft, low confidence)
luangthei = (i:1) (t:v) (f:everyday) (w:can flow/be apt to flow) (d:<luang>, flow, and <thei>, able, written as one word, said here of tears) (j:luang/thei) (r:zd:16321/zd:19526) (q:draft)
luanhun = (i:1) (t:n) (f:nature/time) (w:rainy season) (d:<luan> and <hun> written as one word: the time when something flows; {guahtui luanhun} is the season of the rains, the monsoon) (j:luan/hun) (r:zd:20155/zd:13039) (q:draft)
luankhi = (i:1) (t:n) (f:body) (w:tears/tear) (d:tears, a word of songs and poetic writing; {luankhi nul} is wipe away tears) (s:khitui) (r:zd:22095/zd:15874/zd:12033) (q:draft)
