innpan = (i:1) (t:adv) (f:home/everyday) (w:from home/from the house/out of the house) (d:<inn> and <pan> written as one word: from the house, from home) (j:inn/pan) (r:zd:25111/zd:12319/zd:12717) (q:draft)
innpanin = (i:1) (t:adv) (f:home/everyday) (w:from home/from the house) (d:<inn>, house, and <panin>, from, written as one word: from the house, from home) (j:inn/panin) (r:zd:18152/zd:16772) (q:draft)
innpen = (i:1) (t:n) (f:home) (w:the house/the building) (d:<inn>, house, and the topic marker <pen> written as one word: the house as the thing the sentence is about) (j:inn/pen) (r:zd:14969/zd:14952) (q:draft)
Innpipa = (i:1) (t:n) (f:social) (w:chief/headman) (d:<innpi>, great house, with <pa>, man: the head of the chief's house, title of a hereditary Zomi chief placed before his name; his wife is {Innpinu}) (r:zd:15996) (q:draft)
innpualam = (i:1) (t:adv) (f:home) (w:outside the house/outdoors) (d:<inn>, house, and <pualam>, outside, written as one word: the outside of the house, out of doors) (j:inn/pualam) (r:zd:16926/zd:14509) (q:draft)
innsaap = (i:1) (t:n) (f:home) (w:house rent/rented house/rental housing) (d:<inn>, house, with <saap>, hire: the renting of a house, the rent paid for it, or a house that is rented) (r:zd:12647/zd:20339) (q:draft)
innsaapna = (i:1) (t:n) (f:home) (w:rented house/rented room/lodging) (d:{inn saap}, rent a house, with the noun suffix <na>: the house or room that a person rents and lives in) (r:zd:20595/zd:12373) (q:draft)
innsang = (i:1) (t:n) (f:home) (w:tall building/high-rise) (d:<inn>, house, with <sang>, high, written as one word: a tall building of many storeys) (j:inn/sang) (r:zd:11438/zd:18166) (q:draft)
innsangdawn = (i:1) (t:n) (f:home) (w:rooftop/top of a tall building) (d:<inn>, house, <sang>, high, and <dawn>, top: the top or roof of a high building) (r:zd:11172/zd:13022) (q:draft)
innsangpi = (i:1) (t:n) (f:home) (w:tall building/high-rise/skyscraper) (d:<inn>, house, with <sangpi>, very high: a very tall building of many floors) (j:inn/sangpi) (r:zd:14559/zd:13009/zd:12319) (q:draft)
innsap = (i:1) (t:n) (f:home/work) (w:house rent/rented house/renting a house) (d:<inn>, house, with <sap> in the sense of rent: living in a rented house, a rented house, and the rent paid for it) (r:zd:26620/zd:12166/zd:20999) (q:draft)
innsung = (i:1) (t:n) (f:home/family) (w:home/household) (d:<inn>, house, with <sung>, inside: the inside of a house, and so the home and the people who live in it) (s:innkuan/innkuansung) (q:draft)
innsungpan = (i:1) (t:adv) (f:home) (w:from the house/from inside the home/from a household) (d:<innsung>, the inside of a house or a household, and <pan>, from, written as one word) (j:innsung/pan) (r:zd:12093/zd:15095) (q:draft)
innsungteng = (i:1) (t:n) (f:home) (w:the whole house/all through the house) (d:<innsung>, the inside of a house, with <teng> in the sense all, written as one word: every part of the inside of the house) (j:innsung/teng) (r:zd:22162/zd:11700/zd:12208) (q:draft)
innteekna = (i:1) (t:n) (f:social) (w:hosting/being host) (d:<innteek>, householder, with {-na}: being the host of an event; {innteekna tawh} after the name of a group means hosted by that group) (b:innteek) (r:ts:2844/zd:10743) (q:draft)
innteeknu = (i:1) (t:n) (f:home/family) (w:lady of the house/hostess/housewife/landlady) (d:<innteek>, house owner, with <nu> marking a woman: the woman to whom a house belongs or who keeps it) (b:innteek) (r:zd:16634/zd:9249/zd:16321) (q:draft)
innteekpa = (i:1) (t:n) (f:home/work) (w:master of the house/house owner/landlord/employer) (d:<innteek> and <pa> written as one word: the man who owns the house, also the master for whom a household worker works) (j:innteek/pa) (r:zd:20470/zd:16294) (q:draft)
innteekte = (i:1) (t:n) (f:home/social) (w:house owners/hosts/landlords) (d:<innteek> with the plural {-te}: the people to whom a house belongs, the hosts who receive guests, or the owners who rent a house out) (b:innteek) (r:zd:22827/zd:25470) (q:draft)
innteeng = (i:1) (t:n) (f:work/home) (w:domestic worker/housemaid/live-in helper) (d:one who lives in the house of an employer and does the housework; built from <inn>, house, and <teeng>, live; mostly in <innteeng nasem>, domestic worker) (r:zd:17936/zd:16657/zd:15956) (q:draft)
innteeng nasem = (i:1) (t:n) (f:work/home) (w:domestic worker/housemaid/maid) (d:<innteeng>, one who lives in the house of an employer, and <nasem>, worker: a person employed to do the housework and living in the house; with <in> and a verb such as <om> it says that someone works as a maid) (r:zd:12992/zd:15761) (q:draft)
innteeng nasemnu = (i:1) (t:n) (f:work/home) (w:housemaid/domestic helper/live-in maid) (d:<innteeng>, one who lives in the house, with <nasemnu>, female servant: a woman employed to live in a household and do its work, the usual news term for a foreign domestic helper) (r:zd:16580/zd:15575) (q:draft)
inntek = (i:1) (t:n) (f:home/social) (w:host/householder/house owner) (d:the people of the house or place that receives guests or holds an event; another spelling of <innteek>; {inntek te} are the hosts, the family of the house) (s:innteek) (r:zd:25616/zd:18241) (q:draft)
inntek = (i:2) (t:v) (f:social) (w:be at home/act as owner) (d:behave as the owner of a place or a cause: be fully at home in it or take a leading part in it, mostly as {inntek mahmah}) (r:zd:24481/zd:20227) (q:draft, low confidence)
innteknu = (i:1) (t:n) (f:home/work) (w:mistress of the house/female employer/landlady) (d:<innteek>, house owner, with <nu> for a woman, in a shorter spelling: the woman who owns the house, also the woman for whom a maid works) (b:innteek) (r:zd:11941) (q:draft)
inntekpa = (i:1) (t:n) (f:home/family) (w:householder/master of the house/house owner/host) (d:the man who owns or heads a house, and so the host of a guest; another spelling of {innteek pa}) (s:innteek) (r:zd:14804/zd:14530) (q:draft)
inntekte = (i:1) (t:n) (f:home/family) (w:householders/hosts/family of the house) (d:the people to whom a house belongs: the hosts as against their guests, or the household concerned, as a bereaved family; plural of <inntek>, also spelled <innteek>) (b:innteek) (r:zd:12487/zd:21175) (q:draft)
innteng = (i:1) (t:n) (f:work/home) (w:domestic worker/housemaid/live-in maid) (d:a person who lives in an employer's house and does the housework there; {innteng nasep} is domestic work) (r:zd:21662/zd:20975/zd:10722) (q:draft)
innthak = (i:1) (t:n) (f:home) (w:new house/new home) (d:<inn> and <thak> written as one word: a new house; {innthak honna} is the opening of a new house) (j:inn/thak) (r:zd:24594/zd:20512/zd:17655) (q:draft)
inntung = (i:1) (t:n) (f:home) (w:upstairs/upper floor/roof/rooftop) (d:<inn>, house, with <tung>, top: the upper part of a house, either the floor upstairs or the roof; the opposite is <innnuai>, downstairs) (r:zd:16294/zd:11375) (q:draft)
inntungdawn = (i:1) (t:n) (f:home) (w:rooftop/top of a building/upper floor) (d:<inn>, house, with <tung>, upon, and <dawn>, top: the top of a house or building, its roof or a high storey) (r:zd:14904/zd:12605) (q:draft)
inntungkhuh = (i:1) (t:n) (f:home) (w:roof/roofing) (d:<inn>, house, with <tungkhuh>, covering: the roof of a house and the sheets it is made of) (s:innkhum) (j:inn/tungkhuh) (r:zd:12717/zd:13326/zd:14547) (q:draft)
inntungpan = (i:1) (t:adv) (f:home) (w:from the top of a building/from the roof) (d:<inn>, house, and <tungpan>, from upon, written as one word: from the roof or an upper floor of a building, mostly of a fall) (j:inn/tungpan) (r:zd:16634) (q:draft)
innveng = (i:1) (t:n) (f:social/home) (w:neighbourhood/neighbour) (d:the houses near one's own and those who live there) (s:veng) (q:draft)
innzang = (i:1) (t:n) (f:home) (w:home/house/residence) (d:the house where a person lives, his own home; {amau innzang ah} is at their home) (r:zd:11130/zd:15481/zd:19178) (q:draft, low confidence)
Insein = (i:1) (t:name) (c:place) (f:travel/politics) (w:Insein) (d:township in the north of Yangon, known for its prison and for the Myanmar Institute of Theology) (r:zd:19964/zd:25268) (q:draft)
Inspection = (i:1) (t:n) (f:politics/work) (w:inspection/check) (d:an official check of a place or thing; {Inspection bawl} is to carry out an inspection) (o:English) (r:zd:17003/zd:21471/zd:16823) (q:draft)
Inspector = (i:1) (t:n) (f:work/politics) (w:inspector) (d:an officer of the police, the customs or a government department; mostly after the English name of the service, as in Police Inspector) (o:English) (r:zd:12603/zd:15247) (q:draft)
