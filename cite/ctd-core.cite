uah = (i:1) (t:ppm) (f:everyday) (w:in their/at their/in your) (d:the plural marker <uh> and the place marker <ah> written as one word: after a noun that has <a>, <na> or <ka> before it, in or at what belongs to several people, as {na khua ciat uah}, in each of your villages, and {atung uah}, upon them) (j:uh/ah) (r:zd:21690/zd:22446/zd:20550) (q:draft)
uanggen = (i:1) (t:v) (f:everyday/media) (w:exaggerate/overstate) (d:<uang>, go to excess, with <gen>, say: make a thing sound greater than it is) (r:zd:26163/zd:21013) (q:draft)
Uber = (i:1) (t:name) (f:travel/it) (w:Uber) (d:company whose phone application calls a private car with a driver, used like a taxi) (r:zd:11844/zd:11253/zd:12891) (q:draft)
UEC = (i:1) (t:name) (f:politics) (w:Union Election Commission/UEC) (d:English abbreviation: the Union Election Commission, the body that runs elections and registers parties in Myanmar) (o:English) (r:zd:24515/zd:17630) (q:draft)
Uganda = (i:1) (t:name) (c:land) (f:politics/travel) (w:Uganda) (d:country in East Africa) (r:zd:19565) (q:draft)
uha = (i:2) (t:part) (f:everyday) (w:and/and then) (d:the plural marker <uh> joined with the linking {-a}, and: it follows a verb whose subject is several people and joins the clause to the next one, they did so and; more often written {uh a}) (r:zd:25472/zd:17197/zd:24455) (q:draft)
uhaa = (i:1) (t:part) (f:everyday) (d:the plural marker <uh> with the linking <a>, here spelled <aa>, written as one word after a verb: they do so, and) (j:uh/a) (r:zd:24343/zd:21869) (q:draft)
uham = (i:1) (t:n) (f:family/social) (w:adult/elder/older person) (d:<u>, older, with <ham>, old: a grown or older person, named beside <naupang>, child, and <khangno>, youth) (r:zd:20586/zd:25626/ts:8336) (q:draft)
uhbel = (i:1) (t:part) (f:everyday) (d:the plural <uh> and the topic word <bel> written as one word after a verb: as for what they did, as for their doing so) (j:uh/bel) (r:zd:24457) (q:draft, low confidence)
uhciang = (i:1) (t:conj) (f:everyday) (w:when they/when) (d:<uh>, the marker of a plural subject, and <ciang>, when, written as one word after a verb: when they, we or you do it; often followed by <in>) (j:uh/ciang) (r:zd:13092/zd:23977/zd:16216) (q:draft)
uhciangin = (i:1) (t:conj) (f:everyday) (w:when they/after they) (d:<uh>, the plural marker of the verb, and <ciangin>, when, written as one word after a verb: when or after they did so) (j:uh/ciangin) (r:zd:16239/zd:12261/zd:12567) (q:draft)
uhdiam = (i:1) (t:part) (f:everyday) (d:the plural marker <uh> and the question word <diam>, written as one word at the end of a sentence: will they, I wonder whether they will) (j:uh/diam) (r:zd:22223/zd:15533) (q:draft)
uhhang = (i:1) (t:conj) (f:everyday) (w:because they/although they) (d:the plural marker <uh> and <hang> written as one word after a verb, usually followed by <in>: because of their doing so, or although they do so) (j:uh/hang) (r:zd:16895/zd:12412/zd:25919) (q:draft)
uhhangin = (i:1) (t:conj) (f:everyday) (w:although they/even though they) (d:the plural marker <uh> and <hangin>, although, written as one word after a verb: although they, or we, do so) (j:uh/hangin) (r:zd:15554/zd:17884/zd:11978) (q:draft)
uhhen = (i:1) (t:part) (f:everyday) (w:let them/may they) (d:<uh> and <hen> written as one word at the end of a sentence: a wish or command about several people, let them, may they; {kei uhhen} is let them not) (j:uh/hen) (r:zd:15602/zd:20909/zd:16729) (q:draft)
uhhenla = (i:1) (t:part) (f:everyday) (w:let them and/may they and) (d:<uh> and <henla> written as one word after a verb: a wish or command about several people that is followed by another clause, let them do this and) (j:uh/henla) (r:zd:11662/zd:11990) (q:draft)
uhhi = (i:1) (t:part) (f:everyday) (d:<uh>, the marker of a plural subject, and the sentence-final <hi> written as one word: closes a statement about what several people do or are) (j:uh/hi) (r:zd:23896/ts:4831/zd:19860) (q:draft)
uhhiam = (i:1) (t:part) (f:everyday) (d:<uh> and <hiam> written as one word: the plural marker with the question particle, ending a question about several people) (j:uh/hiam) (r:zd:14652/zd:23025/zd:17933) (q:draft)
uhi = (i:1) (t:part) (f:everyday) (d:<uh>, the marker of a plural subject, and the sentence-final <hi> written as one word with a single h: closes a statement about what several people do or are) (j:uh/hi) (r:zd:22858/ts:301/zd:22585) (q:draft)
uhin = (i:1) (t:part) (f:everyday) (d:<uh>, the plural marker after a verb, and <in> written as one word: they did so, and; it links the clause to the one that follows) (j:uh/in) (r:zd:22860/zd:24305) (q:draft)
uhpen = (i:1) (t:ppm) (f:everyday) (d:<uh>, the plural marker, and <pen>, the topic marker, written as one word: placed after a noun or verb phrase whose owner or subject is plural, it marks that phrase as the topic) (j:uh/pen) (r:zd:12087/zd:12132) (q:draft)
uhtam = (i:1) (t:part) (f:everyday) (d:<uh>, the marker of a plural subject, and the sentence-final <tam>, here a word of wondering and not many, written as one word: closes a question about several people, I wonder whether they, how might they) (r:zd:24414/zd:24457) (q:draft, low confidence)
uhtawh = (i:1) (t:phrase) (f:everyday) (w:with their) (d:the plural marker <uh> and <tawh>, with, written as one word after a noun or verb phrase: with or in keeping with what they have or did, as in {agamtatna uhtawh kisai}, concerning their activities) (j:uh/tawh) (r:zd:16312/zd:16336) (q:draft)
uhteh = (i:2) (t:part) (f:everyday) (w:when/after) (d:plural <uh> with <teh>, when, after a verb and often after <khit>: when or after they, we or you did it; without <le> it states a time and not a condition) (r:zd:16897/zd:22479/zd:16820) (q:draft)
uhteh = (i:3) (t:part) (f:everyday) (w:indeed/really) (d:at the end of a statement, mostly as {hi uhteh}: plural <uh> with the forceful <teh>, said to or about several people with feeling, you really are, they really are) (r:zd:15902/zd:20289) (q:draft, low confidence)
uhzong = (i:1) (t:adv) (f:everyday) (w:also/too) (d:<uh>, the plural marker after a verb or a possessed noun, with <zong>, also, written as one word: that they do so also, theirs too) (j:uh/zong) (r:zd:11487/zd:11253) (q:draft)
ui = (i:1) (t:n) (c:animal) (f:nature/home) (w:dog) (d:a dog, the animal kept at the house) (q:draft)
uikhat = (i:1) (t:n) (f:nature/home) (w:a dog) (d:<ui>, dog, and <khat>, one, written as one word: a dog, one dog) (j:ui/khat) (r:zd:15848/zd:19398) (q:draft)
uino = (i:1) (t:n) (c:animal) (f:nature/home) (w:puppy/little dog/doggy) (d:<ui>, dog, with the diminutive ending {-no}: a young or small dog) (b:ui) (r:zd:17992/zd:20930/zd:15358) (q:draft)
uipi = (i:1) (t:n) (c:animal) (f:nature/home) (w:female dog/bitch/mother dog) (d:<ui>, dog, with the ending {-pi}, female or full-grown: a female dog, a dog that has pups; in stories also a big dog) (b:ui) (r:zd:19295/zd:15283) (q:draft)
uipil = (i:1) (t:n) (c:animal) (f:nature/work) (w:trained dog/sniffer dog/police dog) (d:<ui>, dog, with <pil>, clever: a clever or trained dog, in news mostly one used by police or customs to search) (r:zd:11792/zd:21291/zd:15344) (q:draft)
uisa = (i:1) (t:n) (f:food) (w:dog meat) (d:<ui>, dog, with <sa>, meat) (b:ui) (r:zd:13133/zd:15283) (q:draft)
uital = (i:1) (t:n) (c:animal) (f:nature/home) (w:male dog/dog) (d:<ui>, dog, with <tal>, male: a male dog) (j:ui/tal) (r:ts:301) (q:draft)
uital = (i:2) (t:n) (f:politics) (w:junta troops/military council) (d:scornful name, literally male dog, for the army of the military council of Myanmar, as in {Uital galkapte}, the junta soldiers) (r:ts:1368) (q:draft, low confidence)
uitui = (i:1) (t:v) (f:social) (w:be on good terms/be close/get along) (d:used with the prefix <ki>, as {ki uitui}: be close to one another, be on friendly terms with someone) (r:zd:24594/zd:19671/zd:25488) (q:draft)
uk = (i:5) (t:v) (f:everyday) (w:be keen on/be fond of/like) (d:have a strong liking for a thing or a pastime such as music or jokes, often with <mahmah> or <lua>; a spelling of <uuk> and not the {uk} of ruling) (s:uuk) (r:zd:16442/zd:21529) (q:draft)
ukcipna = (i:1) (t:n) (f:politics) (w:domination/oppressive rule/subjugation) (d:<ukcip>, bring fully under one's rule, with the noun suffix <na>: rule that holds a people down by force; {ukcipna nuai} is under the domination of) (b:ukcip) (r:zd:10957/zd:25099/zd:22293) (q:draft)
ukcipzo = (i:1) (t:v) (f:politics) (w:take control of/capture/hold) (d:<ukcip>, control completely, and <zo>, be able, written as one word: succeed in bringing a town or area fully under control) (j:ukcip/zo) (r:ts:8689) (q:draft)
ukdan = (i:1) (t:n) (f:politics) (w:way of ruling/system of government/way of governing) (d:<uk>, rule, with <dan>, manner: the way in which a country or a people is ruled; {ki-ukdan} is the way people are governed) (s:ukzia) (r:zd:22910/zd:17536) (q:draft)
uklai = (i:1) (t:v) (f:politics) (w:be ruling/rule) (d:<uk>, rule, with <lai>, still or at the time, written as one word: be ruling, while ruling) (j:uk/lai) (r:zd:24318/zd:10702) (q:draft)
ukmahmah = (i:1) (t:v) (f:everyday) (w:be very fond of/be keen on/love doing) (d:<uk>, here in the sense be fond of or be keen on, and <mahmah>, very, written as one word; {a ukmahmah khat} is someone who loves doing it, a keen fan) (j:uk/mahmah) (r:zd:13343/zd:21406/zd:17450) (q:draft)
ukna buluh = (i:1) (t:n) (f:politics) (w:regime/junta/usurper of power) (d:<ukna>, rule, and <buluh>, raid or rob: those who took the rule of the country by force, the name used for the military government of Myanmar after the coup of 2021, often followed by SAC) (r:ts:12104/ts:11998) (q:draft)
ukna nuai = (i:1) (t:phrase) (f:politics) (w:under the rule/under the control/under the authority) (d:<ukna>, dominion, and <nuai>, under: under the rule of; the ruler or power stands before it and <ah>, <a> or <pan> after it, {ukna nuai ah om} is to be ruled by) (r:zd:11917/zd:12122/zd:25099) (q:draft)
uknaza = (i:1) (t:n) (f:politics) (w:ruling power/political power/governing authority) (d:<ukna>, rule, with <za>, office or rank: the power to govern a country, held by a government or a head of government) (r:zd:16157/zd:11456) (q:draft)
ukpi = (i:1) (t:n) (f:social) (w:chief/leader/head) (d:<uk>, rule, with <pi>, great: the head of a clan or tribe, a chief) (s:makai/makaipa/ukpipa) (b:uk) (q:draft)
Ukraine = (i:1) (t:name) (c:land) (f:politics) (w:Ukraine) (d:country in eastern Europe, in the news for its war with Russia) (r:zd:25603/zd:25650/zd:9211) (q:draft)
ukte = (i:2) (t:n) (f:everyday/social) (w:lovers/enthusiasts/fans) (d:<uk> in another meaning, be fond of or keen on, with the plural <te>: those who are fond of the thing or activity named before it, as {music ukte}, music lovers, and {laigelh ukte}, those keen on writing; not those who rule) (r:zd:24381/zd:19788/zd:20359) (q:draft)
uleh = (i:1) (t:conj) (f:everyday) (w:if they/when they) (d:<uh>, the plural marker after a verb, and <leh>, if or when, written as one word: if they, when they) (j:uh/leh) (r:zd:21439/zd:19137/zd:20956) (q:draft)
ulehnau = (i:1) (t:n) (f:family) (w:brothers and sisters/siblings/relatives) (d:<u>, elder sibling, <leh>, and, <nau>, younger sibling, written as one word: brothers and sisters, one's kin) (s:unau/ulenau) (j:u/leh/nau) (r:zd:23984/zd:22818/zd:21853) (q:draft)
uliankhat = (i:1) (t:phrase) (f:politics/work) (w:an official/a senior officer/a leader) (d:<ulian>, official, and <khat>, one, written as one word: an official, a person of high rank) (j:ulian/khat) (r:zd:19318/zd:11099) (q:draft)
ulianpenpa = (i:1) (t:n) (f:politics/work) (w:chief/head/highest official) (d:<ulianpen> and <pa> written as one word: the man who is the highest official of an office or organisation) (j:ulianpen/pa) (r:zd:13205/zd:21372) (q:draft)
Ultrasound = (i:1) (t:n) (f:health) (w:ultrasound/ultrasound scan) (d:medical examination with ultrasound, as of an unborn child; with <zaih>, take an ultrasound picture) (o:English) (r:zd:22065/zd:21633) (q:draft)
ultun = (i:1) (t:v) (f:social) (w:put first/give priority/exalt) (d:treat as the most important thing and set above the rest; mostly {ultun sak}, also written {ultung sak}) (r:zd:23060/zd:21908) (q:draft)
ultung = (i:1) (t:adj) (f:social) (w:foremost/of first importance) (d:in {ultung sak}, put first, hold above everything else, give priority to) (r:zd:22023/zd:19662) (q:draft)
ultungsak = (i:1) (t:v) (f:social) (w:put first/give most weight to/exalt) (d:treat as the most important thing, above all else; {ki ultungsak} is to exalt oneself) (r:zd:25399/zd:23977/zd:13339) (q:draft)
ultunsak = (i:1) (t:v) (f:everyday/work) (w:give priority to/emphasize/put first) (d:treat something as the most important, give it first place or the most weight; glossed in the articles with priority and emphasis) (r:zd:19998/zd:25751) (q:draft)
umcippah = (i:1) (t:v) (f:politics/media) (w:cordon off at once/seal off at once) (d:<um>, here surround, with <cip>, tightly, and <pah>, at once: police or soldiers close off a place immediately so that nobody can enter; {ki umcippah} is the place was cordoned off) (j:um/cip/pah) (r:zd:12651/zd:15537) (q:draft)
umkei = (i:1) (t:v) (f:everyday) (w:not believe/do not believe) (d:<um> and the negative <kei> written as one word: not believe, not think that something is so) (j:um/kei) (r:zd:12913/zd:24165) (q:draft)
umkhawm = (i:1) (t:v) (f:food/social) (w:eat together/share a meal) (d:with <ankuang>, dish: sit round the same dish and eat together, said of a shared meal at a gathering or feast; <um> here is to sit around, with <khawm>, together) (r:zd:16956/zd:25393/zd:22935) (q:draft)
umkhopna = (i:1) (t:n) (f:food/social) (w:shared meal/eating together) (d:in {ankuang umkhopna}, sitting around the <ankuang>, the dish, together: a meal that a group eats together, a fellowship meal) (r:zd:22935/ts:9389/zd:19090) (q:draft)
umlo = (i:1) (t:v) (f:religion/everyday) (w:not believe/disbelieve) (d:<um> and <lo> written as one word: not believe a person or a word, be without faith; {Pasian umlo} is one who does not believe in God) (j:um/lo) (r:zd:22550/zd:16687/zd:17398) (q:draft)
ummawhlo = (i:1) (t:v) (f:everyday/media) (w:not suspect/not think likely) (d:<ummawh>, suspect, and <lo>, not, written as one word; {ki ummawhlo} is it is not suspected, it is not thought to be so) (j:ummawh/lo) (r:zd:16391/zd:20331) (q:draft)
ummawhna = (i:1) (t:n) (f:social/politics) (w:suspicion/surmise) (d:<ummawh>, suspect, with the noun ending {-na}: what someone suspects or supposes to be so without knowing it for certain) (b:ummawh) (r:zd:16628/ts:2529) (q:draft)
ummawhpah = (i:1) (t:v) (f:everyday) (w:suspect at once/immediately suppose) (d:<ummawh>, suspect, and <pah>, at once, written as one word; {ki ummawhpah} is it was at once suspected) (j:ummawh/pah) (r:zd:12021/zd:13243) (q:draft)
ummawhpen = (i:1) (t:phrase) (f:everyday/media) (w:what is suspected) (d:<ummawh>, suspect, and the topic marker <pen> written as one word, mostly after <aki>: what is suspected, the thing suspected) (j:ummawh/pen) (r:zd:19191/zd:19699) (q:draft)
ummi = (i:1) (t:n) (f:religion) (w:believer) (d:<um>, believe, with <mi>, person: one who believes; mostly as {thu ummi} or {thu-ummi}, a believer in the word, a Christian) (r:zd:23492/zd:13354) (q:draft)
ummite = (i:1) (t:n) (f:religion) (w:believers) (d:<um>, believe, with <mite>, people: those who believe, mostly written {thu-ummite}) (s:umte) (r:zd:14791/zd:19772) (q:draft)
umna = (i:2) (t:n) (f:food/social/religion) (w:meal together/feast/supper) (d:after <ankuang> or <annkuang>, the sitting round a dish to eat together: a shared meal or feast, and in church {Topa Nitak Annkuang Umna}, the Lord's Supper; not a wall or fence) (r:zd:11429/zd:23113) (q:draft)
Umno = (i:1) (t:name) (f:politics) (w:UMNO/United Malays National Organisation) (d:political party of Malaysia, mostly written UMNO) (r:zd:19602/zd:16637) (q:draft)
un card = (i:1) (t:n) (f:politics/social) (w:UN card/UNHCR card/refugee card) (d:UN, the United Nations, and <card>: the card that the refugee office of the United Nations, UNHCR, gives to a registered refugee or asylum seeker; written {UN card}) (r:zd:10892/zd:12695) (q:draft)
un laidal = (i:1) (t:n) (f:politics/social) (w:UN document/UNHCR letter) (d:UN, the United Nations, and <laidal>, a sheet of writing: the paper issued by the UN refugee agency to a registered asylum seeker, named beside the {UN card}; used with <nei>, <tawi> or <ngah>, to hold or get one) (r:zd:23446/zd:20168) (q:draft)
UNA = (i:1) (t:name) (f:politics) (w:United Nationalities Alliance/UNA) (d:alliance of political parties of the ethnic nationalities in Myanmar, named beside the NLD) (r:zd:11103) (q:draft, low confidence)
unaukhat = (i:1) (t:phrase) (f:family/social) (w:one family/brothers of one family) (d:<unau> and <khat> written as one word: siblings who are one, people who belong together as one family) (j:unau/khat) (r:zd:21690/zd:17120) (q:draft)
Uncle = (i:1) (t:n) (f:family/social) (w:uncle) (d:an uncle, and a polite way to address or speak of an older man) (o:English) (r:zd:11251/zd:13309) (q:draft)
Underwear = (i:1) (t:n) (f:home) (w:underwear) (d:clothing worn under other clothes; mostly written with a capital and often added to explain <bombi sungten>) (o:English) (r:zd:19707) (q:draft, low confidence)
UNDP = (i:1) (t:name) (f:politics) (w:UNDP/United Nations Development Programme) (d:the development agency of the United Nations, named by its English abbreviation) (o:English) (r:zd:19172/zd:15523) (q:draft)
UNESCO = (i:1) (t:name) (f:education/politics) (w:UNESCO) (d:the United Nations Educational, Scientific and Cultural Organization) (r:zd:12353/zd:22650/zd:23770) (q:draft)
uneu = (i:1) (t:n) (f:social) (w:person of low rank/ordinary person/the lowly) (d:a person of low position, the counterpart of <ulian>: {ulian uneu} is high and low, great and small alike) (a:ulian) (r:zd:23933/zd:24691) (q:draft)
UNFC = (i:1) (t:name) (f:politics) (w:UNFC) (d:the United Nationalities Federal Council, an alliance of ethnic armed organizations of Myanmar) (r:zd:17927/zd:13167) (q:draft)
UNFPA = (i:1) (t:name) (f:politics/health) (w:UNFPA/United Nations Population Fund) (d:the United Nations Population Fund, an agency of the United Nations, written with its English abbreviation) (r:zd:15881) (q:draft)
ungh = (i:1) (t:part) (f:everyday) (j:ung) (r:zd:24310/zd:20652/zd:23554) (q:draft)
UNHCR = (i:1) (t:name) (f:politics/social) (w:UNHCR/United Nations High Commissioner for Refugees) (d:the refugee agency of the United Nations, where refugees are registered) (r:zd:25533/zd:22938) (q:draft)
UNICEF = (i:1) (t:name) (f:social/politics) (w:UNICEF) (d:the children's fund of the United Nations) (o:English) (r:zd:17335/zd:18026) (q:draft)
Unicode = (i:1) (t:name) (f:it) (w:Unicode) (d:the international standard for writing characters on computers and phones; for Burmese script the standard font encoding, as against Zawgyi) (o:English) (r:zd:23049/zd:20095) (q:draft)
uniform = (i:1) (t:n) (f:home/work) (w:uniform) (d:the special clothes worn by all members of a school, army or police force) (o:English) (r:zd:23451/zd:23782) (q:draft)
unity = (i:1) (t:n) (f:social/religion) (w:unity) (d:the state of being one and working together) (o:English) (r:zd:24199) (q:draft, low confidence)
Universe = (i:1) (t:n) (f:nature/education) (w:universe) (d:the whole of space and all that is in it; most uses are in the English title Miss Universe) (o:English) (r:zd:22557/zd:24355) (q:draft, low confidence)
University = (i:1) (t:n) (f:education) (w:university) (d:a place of higher education that gives degrees, often after its name) (o:English) (r:zd:22981/zd:23780/zd:12244) (q:draft)
unla = (i:2) (t:part) (f:everyday) (w:and) (d:<un>, the plural ending of a command, with <la>, and: closes a command to several people when another command follows, as in {pai unla}, go and; <kei unla> is do not, and; not a marker of the subject) (r:zd:9448/zd:25137/zd:23792) (q:draft)
unmaw = (i:1) (t:part) (f:everyday) (w:do/please do) (d:<un> and <maw> written as one word, at the end of a request to several people: do so, will you) (j:un/maw) (r:zd:17353/zd:12611/zd:13072) (q:draft)
UNO = (i:1) (t:name) (f:politics) (w:United Nations/UNO) (d:the United Nations Organization) (r:zd:15905/zd:22381) (q:draft)
unteh = (i:1) (t:part) (f:everyday) (d:sentence-final ending for a plural subject, short for {uh inteh}: they will, they probably will; followed by <maw> it asks the hearer to agree) (r:zd:24327/zd:24749) (q:draft)
unzong = (i:1) (t:adv) (f:everyday) (w:also/even) (d:<un> and <zong> written as one word: the plural ending <un> that closes the phrase before it, followed by <zong>, also or even) (j:un/zong) (r:zd:19788/zd:16216) (q:draft, low confidence)
upa = (i:1) (t:n) (f:social) (w:elder/leader) (d:an elder or leader of a people, a town or a church; {pawlpi upa} is a church elder and {upa vaihawmte} are the ruling council) (s:makai) (r:64.1.1) (q:draft)
upa = (i:2) (t:adj) (f:family/social) (w:elder/older/firstborn) (d:the older one among siblings; {tapa upa pen} is the eldest or firstborn son and {ta upa zaw} the older of two children) (s:uzaw) (a:khangnozaw) (q:draft)
upakhin = (i:1) (t:adj) (f:time/everyday) (w:aged/old/years old) (d:<upa>, older, and <khin>, already, written as one word: having already reached an age, said of people, animals, trees and things; {kum 7 a upakhin} is seven years old, and without a number it means already elderly) (j:upa/khin) (r:zd:20611/zd:15631/zd:19480) (q:draft)
upazaw = (i:1) (t:adj) (f:family) (w:older/elder) (d:<upa>, elder, and <zaw>, more, written as one word: older than another, the elder of two) (j:upa/zaw) (r:zd:18128/zd:12409/zd:10721) (q:draft)
UPC = (i:1) (t:name) (f:religion) (w:United Pentecostal Church) (d:abbreviation of the United Pentecostal Church, a church with Zomi congregations; a few articles use the same letters for a peace conference in Myanmar) (r:zd:19850/zd:11224) (q:draft, low confidence)
updan = (i:1) (t:n) (f:religion) (w:belief/doctrine/way of believing) (d:<up>, believe, with <dan>, manner: what and how a person or a church believes, a doctrine; often paired with <sandan>, the way it is accepted) (b:up) (r:zd:23655/zd:23394/zd:17536) (q:draft)
update = (i:1) (t:n) (f:media/it) (w:update/latest news) (d:newer information about a matter already reported; {update bawl} is to give an update, and the word is also used as a verb) (o:English) (r:zd:24808/zd:15788/zd:24892) (q:draft)
upding = (i:1) (t:v) (f:everyday/religion) (w:to be believed/worth believing) (d:<up> and <ding> written as one word: to be believed, what should be believed) (j:up/ding) (r:zd:25462/zd:24214) (q:draft)
UPF = (i:1) (t:name) (f:politics) (w:UPF/United People's Front) (d:umbrella body of Kuki-Zo armed groups in Manipur, India, named together with KNO in talks with the Indian government) (o:English) (r:zd:15905/zd:22365) (q:draft)
upgrade = (i:1) (t:v) (f:travel/it/work) (w:upgrade/improve) (d:English word: bring a road, a network or a service to a higher standard; also as a noun with <bawl>) (o:English) (r:zd:23252) (q:draft, low confidence)
upipa = (i:1) (t:n) (f:family) (w:eldest brother) (d:<u>, older sibling, with <pi>, great, and <pa>, male: the eldest brother, the firstborn son of the family) (b:u) (r:zd:16121) (q:draft, low confidence)
upload = (i:1) (t:v) (f:it/media) (w:upload) (d:put a photo, video or file on the internet; often {ki upload}, be uploaded, and {upload khia}) (o:English) (r:zd:15562/zd:15517) (q:draft)
uplohna = (i:1) (t:n) (f:religion/everyday) (w:unbelief/disbelief/distrust) (d:<uploh>, not believe, with the noun suffix <na>: not believing, in God or in what a person says; {ki uplohna} is distrust of oneself or of one another) (s:uplahna) (a:upna) (b:uploh) (r:zd:10676/zd:23984) (q:draft)
upmawhin = (i:1) (t:adv) (f:everyday) (w:by guessing/guessing) (d:<upmawh>, suppose, with the linking <in>, written as one word: by guesswork, without knowing for sure) (b:upmawh) (j:upmawh/in) (r:zd:22778) (q:draft)
upmawhloh = (i:1) (t:adv) (f:everyday) (w:unexpectedly/unexpected/unforeseen) (d:<upmawh>, expect, and <loh>, not, written as one word: not expected; {upmawhloh in} and {upmawhloh pi-in} are unexpectedly, {upmawhloh laitak} is at a moment when nobody expects it) (j:upmawh/loh) (r:zd:24850/zd:17152/zd:9430) (q:draft)
upmawhlohpi = (i:1) (t:adv) (f:everyday) (w:quite unexpectedly/all of a sudden/unexpected) (d:<upmawhloh>, unexpected, and <pi>, greatly, written as one word, mostly with <in>: wholly unexpectedly) (j:upmawhloh/pi) (r:zd:11545/zd:24086/zd:9425) (q:draft)
upmawhna = (i:2) (t:n) (f:everyday) (w:supposition/guess/expectation/estimate) (d:what someone supposes or expects to be so without being sure, with no thought of wrongdoing; {upmawhna ah} is in the estimate of, and {upmawhna sangin} is than was expected) (r:zd:13295/zd:26411/zd:23317) (q:draft)
upmawhthu = (i:1) (t:n) (f:media/everyday) (w:speculation/supposition/guess) (d:<upmawh> and <thu> written as one word: something merely supposed and not known to be so) (a:thutak) (j:upmawh/thu) (r:zd:25687/zd:19427) (q:draft)
upnatawh = (i:1) (t:adv) (f:religion) (w:with faith/by faith) (d:<upna>, faith, and <tawh>, with, written as one word) (j:upna/tawh) (r:zd:24029/zd:15274) (q:draft)
upzia = (i:1) (t:n) (f:religion) (w:way of believing/belief/doctrine) (d:<up>, believe, with <zia>, manner: the way a person or a church believes, what is held as belief; {Pasian thu upzia} is how one believes in the word of God) (r:zd:11891/zd:20786/zd:19098) (q:draft)
US = (i:1) (t:name) (c:land) (f:politics/travel) (w:United States/US) (d:the United States of America, in the short English form) (s:USA) (r:zd:16337/zd:24209/ts:9524) (q:draft)
USA = (i:1) (t:name) (c:land) (f:politics/travel) (w:United States of America/USA) (s:US) (r:zd:13020/zd:19679) (q:draft)
USCIS = (i:1) (t:name) (f:politics/travel) (w:USCIS) (d:United States Citizenship and Immigration Services, the immigration office of the United States, named by its English abbreviation) (o:English) (r:zd:18159/zd:17841) (q:draft)
USDP = (i:1) (t:name) (f:politics) (w:USDP/Union Solidarity and Development Party) (d:a political party of Myanmar close to the army, named by the letters of its English name) (r:zd:22412/zd:21429/zd:10951) (q:draft)
User = (i:1) (t:n) (f:it) (w:user) (d:a person who uses a website or an online service, mostly in {Facebook User}) (o:English) (r:zd:15387/zd:11837) (q:draft)
Usher = (i:1) (t:n) (f:social/religion) (w:usher) (d:a person who receives and seats the people at a church service or a public gathering; {Usher sem} is serve as usher) (o:English) (r:zd:22686/zd:17776/zd:25080) (q:draft)
USJ = (i:1) (t:name) (c:place) (f:travel) (w:USJ) (d:township in Subang Jaya in Selangor, Malaysia, whose sections are written with a number, as USJ 2) (r:zd:11148) (q:draft)
USSR = (i:1) (t:name) (c:land) (f:politics) (w:USSR/Soviet Union) (d:abbreviation of the Union of Soviet Socialist Republics, the state that existed until 1991) (r:zd:21025) (q:draft)
USte = (i:1) (t:name) (c:people) (f:politics) (w:Americans/United States) (d:<US>, the United States, with the plural <te>, written as one word: the Americans, the United States as a government or an armed force) (j:US/te) (r:zd:10833/zd:11055) (q:draft)
Utah = (i:1) (t:name) (c:land) (f:travel/politics) (w:Utah) (d:a state in the west of the United States) (r:zd:15724/zd:23810) (q:draft)
utbangbang = (i:1) (t:adv) (f:everyday) (w:as one pleases/at will/however one likes) (d:<ut>, want, with <bangbang>, just as, written as one word: just as one wishes, freely; {na utbangbang} is as you please) (j:ut/bangbang) (r:zd:20682/zd:17549/zd:21796) (q:draft)
utdan = (i:1) (t:n) (f:everyday) (w:wish/desire/preference) (d:<ut>, want, with <dan>, manner, written as one word: what one would like, the way one wants things to be) (j:ut/dan) (r:zd:9449/zd:24598/zd:20829) (q:draft)
utdandan = (i:1) (t:adv) (f:everyday) (w:as one wishes/however one likes) (d:just as one likes, following one's own wish; mostly with <in> or after a pronoun, {na utdandan in}, as you like) (r:zd:20484/zd:24739) (q:draft)
ute naute = (i:1) (t:n) (f:religion/social) (w:brothers and sisters/brethren) (d:<ute>, elder siblings, paired with <naute>, younger siblings: brothers and sisters, the usual address to fellow believers or one's own people at the opening of a speech or sermon, often followed by <aw>) (r:zd:21866/zd:23556/zd:23037) (q:draft)
uteh = (i:1) (t:part) (f:everyday) (d:the plural marker <uh> and the particle <teh> written as one word at the end of a sentence, after {ding hi}: a statement about what they or you will surely come to do or see) (j:uh/teh) (r:zd:22911/zd:12432) (q:draft, low confidence)
uthuai = (i:1) (t:adj) (f:everyday) (w:desirable/appealing) (d:<ut>, desire, with <huai>, worthy of: to be wished for, something one would like to see or have) (r:zd:19521/zd:25318) (q:draft)
utkei = (i:1) (t:v) (f:everyday) (w:do not want/not wish) (d:<ut>, want, and the negative <kei> written as one word: {ka utkei hi} is I do not want to) (j:ut/kei) (r:zd:20363/zd:13314) (q:draft)
utleh = (i:1) (t:phrase) (f:everyday) (w:if one wants/if willing) (d:<ut>, want, and <leh>, if, written as one word: if one wants; {utleh utloh tawh kisailo in} is whether willing or not) (j:ut/leh) (r:zd:16788/zd:19676) (q:draft)
utlo = (i:1) (t:v) (f:everyday) (w:not want/be unwilling) (d:<ut> and <lo> written as one word: not want to, be unwilling; {a utlo te} is those who do not want to) (j:ut/lo) (r:zd:10743/zd:23896/zd:25173) (q:draft)
utloh = (i:1) (t:n) (f:everyday) (w:unwillingness/not wanting/dislike) (d:<ut>, want, with the negative <loh>, written as one word: not wanting, or what one does not want; {ut le utloh} is wanting or not wanting) (j:ut/loh) (r:zd:20403/zd:21090/zd:24765) (q:draft)
utlohna = (i:1) (t:n) (f:everyday) (w:unwillingness/reluctance/dislike) (d:<utloh> with the noun suffix {-na}: not wanting; {utlohna mun} is a place one does not want to be in) (b:utloh) (r:zd:20780/zd:25609) (q:draft)
utlopi = (i:1) (t:adv) (f:everyday) (w:unwillingly/against one’s will) (d:<ut>, want, and <lopi>, without, written as one word, mostly as {utlopi in}: without wanting to, against one’s will) (j:ut/lopi) (r:zd:22938/zd:12470) (q:draft)
utnawnlo = (i:1) (t:v) (f:everyday) (w:no longer want/not want any more) (d:<ut>, want, and <nawnlo>, no longer, written as one word) (j:ut/nawnlo) (r:zd:12632/ts:11162) (q:draft)
utpeuh = (i:1) (t:phrase) (f:everyday) (w:whoever wants/whatever one wants/anyone who wishes) (d:<ut>, want, and <peuh>, any, written as one word: {a utpeuh} is anyone who wishes, and {i utpeuh} is whatever we want) (j:ut/peuh) (r:zd:11346/zd:23311) (q:draft)
Uttar = (i:1) (t:name) (c:land) (f:politics/travel) (w:Uttar Pradesh) (d:first word of the name Uttar Pradesh, a state in the north of India) (r:zd:11435/zd:12389) (q:draft)
uu = (i:1) (t:n) (f:family) (j:u) (r:zd:12765/zd:23479) (q:draft)
uukte = (i:1) (t:n) (f:social/everyday) (w:enthusiasts/lovers/fans) (d:<uuk>, be keen on, with the plural <te>, written as one word: people who are keen on or devoted to the thing named before it, as in {lai uukte}, lovers of literature) (b:uuk) (j:uuk/te) (r:zd:22709/zd:21941/zd:24393) (q:draft)
uut = (i:1) (t:v) (f:everyday) (j:ut) (r:zd:21117/zd:21862) (q:draft)
UWSA = (i:1) (t:name) (f:politics) (w:UWSA/United Wa State Army) (d:armed organisation of the Wa people in Shan State, Myanmar) (r:zd:17760/zd:17927) (q:draft)
uzawte = (i:1) (t:n) (f:family/social) (w:elders/older ones/older siblings) (d:<uzaw>, older, with the plural ending <te>: those who are older than oneself, in the family or in age) (b:uzaw) (r:zd:23591/zd:13166) (q:draft)
vaai = (i:1) (t:n) (f:politics/media) (j:vai) (r:zd:15335/zd:16395) (q:draft)
vaak = (i:3) (t:v) (f:travel/everyday) (w:go about/go out/wander) (d:walk about from place to place, a different word from {vaak}, feed, and {vaak}, light; with <khia>, out, it is go out of the house, as people are told not to do in quarantine) (r:zd:23933/zd:24319) (q:draft)
vaal = (i:1) (t:v) (f:everyday) (j:val) (r:zd:25452/zd:17120/zd:15380) (q:draft)
vaan = (i:3) (t:n) (f:religion/nature) (w:heaven/sky) (d:the same word as <van>, heaven, written with a long vowel by some writers; this noun stands before another noun, as in {Vaan Kumpigam}, the kingdom of heaven, and {vaan laaizang}, the middle of the sky) (s:van) (r:zd:17901/zd:20545) (q:draft)
vaang = (i:2) (t:n) (f:social) (w:dignity/prestige/standing/honour) (d:the respect and standing a person has among others, named beside <min>, name, as in {min leh vaang}, and with <zahtak>, respect; not the might of sense 1) (r:zd:25672/zd:12187/zd:9124) (q:draft)
Vaangkhua = (i:1) (t:n) (f:social/religion) (j:vangkhua) (r:zd:21182) (q:draft)
vaanleeng = (i:1) (t:n) (f:travel) (j:vanleng) (r:zd:11110) (q:draft)
vabang = (i:1) (t:adv) (f:nature) (w:like a bird) (d:<va>, bird, and <bang>, like, written as one word, in songs and sayings: like a bird, as in {vabang leng}, fly like a bird, and {vabang pil}, wise as a bird) (j:va/bang) (r:ts:3369/zd:24570) (q:draft)
vabawl = (i:1) (t:v) (f:everyday/work) (w:go and make/go and do) (d:<va>, go and, and <bawl>, make, written as one word: go to a place and make or do something there) (j:va/bawl) (r:zd:14744/zd:19262) (q:draft)
Vacation = (i:1) (t:n) (f:travel/time) (w:vacation/holiday) (d:time off work spent resting or travelling, often written with a capital and followed by a Zolai explanation) (o:English) (r:zd:16304/zd:12274) (q:draft, low confidence)
Vaccination = (i:1) (t:n) (f:health) (w:vaccination) (d:the giving of a vaccine; the English word used beside <vaccine>) (o:English) (r:zd:25202/zd:19995) (q:draft, low confidence)
vaccine = (i:1) (t:n) (f:health) (w:vaccine) (d:a medicine given, usually by injection, to protect against a disease; <vaccine sun> is get vaccinated) (o:English) (r:zd:25062/zd:23731/zd:25294) (q:draft)
vaccine sun = (i:1) (t:v) (f:health) (w:be vaccinated/get a vaccine shot) (d:<vaccine> and <sun>, here not day but a form of <sut>, pierce, inject: have a vaccine injected, be vaccinated; {vaccine sun nailo te} are those not yet vaccinated and {vaccine sun khin} is already vaccinated) (r:zd:25294/zd:25062) (q:draft)
vaciah = (i:1) (t:v) (f:travel) (w:go back/return home) (d:<va> and <ciah> written as one word: go back there, return to the home place) (j:va/ciah) (r:zd:25222/zd:17860) (q:draft)
vadawn = (i:1) (t:v) (f:travel/social) (w:go and meet/pick up/go to welcome) (d:<va> and <dawn> written as one word: go to where someone is to meet, welcome or fetch him, as a driver picks up a passenger) (j:va/dawn) (r:zd:14833/zd:13233) (q:draft)
vadelh = (i:1) (t:v) (f:everyday/travel) (w:go after/run to/rush to) (d:<va> and <delh> written as one word: go and chase, or hurry to a person or place) (j:va/delh) (r:zd:19902/zd:18241) (q:draft)
vagen = (i:1) (t:v) (f:everyday) (w:go and tell) (d:<va> and <gen> written as one word: go to someone and tell it) (j:va/gen) (r:zd:24320/zd:14910) (q:draft)
vahawh = (i:1) (t:v) (f:social/travel) (w:go and visit/pay a visit/call on) (d:<va>, go and, with <hawh>, visit, written as one word: go to see a person or a place) (j:va/hawh) (r:zd:17187/ts:3366/zd:25488) (q:draft)
vahna = (i:1) (t:n) (f:travel/everyday) (w:going out/outing/whereabouts) (d:noun of <vak>, go about: a going out, or the place where someone goes; {i-vahna} is where we have been, and {vahna ciahna} is going out and coming home) (r:zd:14930/zd:15818) (q:draft, low confidence)
vahna = (i:2) (t:n) (f:food) (w:fullness/being well fed) (d:noun of <vah>, be full: the state of having eaten enough, named together with <kialna>, hunger) (b:vah) (r:zd:9428) (q:draft, low confidence)
vaiah = (i:1) (t:adv) (f:everyday/social) (w:in the matter of/concerning/regarding) (d:<vai>, matter or affair, and <ah>, in, written as one word after the thing spoken of: in the matter of, as regards) (j:vai/ah) (r:ts:3375/zd:20920/ts:1405) (q:draft)
vaidang = (i:1) (t:n) (f:everyday/social) (w:other matter/other business/something else) (d:<vai>, affair, and <dang>, other, written as one word: another matter, other business) (j:vai/dang) (r:zd:19900/zd:24276) (q:draft)
vaidawn = (i:1) (t:v) (f:social) (w:welcome/receive/go to meet) (d:go out to meet and receive a visitor with honour; built on <dawn>, meet; also the welcoming itself, as in {vaidawn lakah}, among those who welcomed) (r:ts:301/zd:17613/zd:11198) (q:draft)
vaidawnna = (i:1) (t:n) (f:social) (w:welcome/reception) (d:the act or occasion of going out to welcome someone who arrives; {vaidawnna mun} is the place of reception) (r:zd:25347/zd:15393) (q:draft)
vaiding = (i:1) (t:n) (f:everyday/work) (w:matter/arrangements/affairs/plan) (d:<vai>, affair, and <ding> written as one word: what is to be done or arranged, placed after the thing concerned; {khualzin vaiding} is travel arrangements) (j:vai/ding) (r:zd:17341/zd:11380) (q:draft)
Vaigam = (i:1) (t:name) (c:land) (f:travel/politics) (w:India) (d:India, the land of the {Vai}, as the Zomi call the Indians; often named beside <Kawlgam>, Burma, as the two countries where the Zomi live) (s:India) (r:zd:20507/zd:25866) (q:draft)
vaihang = (i:1) (t:conj) (f:everyday/media) (w:because of/over the matter of) (d:<vai>, matter, and <hang>, reason, written as one word after a noun: because of the matter of, on account of) (j:vai/hang) (r:zd:16637) (q:draft)
vaihawmding = (i:1) (t:v) (f:social/politics) (w:will arrange/will manage/will handle) (d:<vaihawm>, arrange or manage, and <ding> written as one word: will see to a matter, to be arranged or handled) (j:vaihawm/ding) (r:zd:17206/zd:16895/zd:15811) (q:draft)
vaihawmkhawm = (i:1) (t:v) (f:social/politics) (w:consult together/deliberate together/plan jointly) (d:<vaihawm> and <khawm> written as one word: discuss and arrange a matter together with others, who are marked by <tawh>) (j:vaihawm/khawm) (r:zd:11244/zd:11303/zd:15537) (q:draft)
vaihawmpih = (i:1) (t:v) (f:social/work) (w:help arrange/plan with/advise) (d:<vaihawm>, manage or arrange a matter, with the suffix <pih>: arrange or plan something together with someone or on his behalf, help him see to it) (b:vaihawm) (r:zd:10743/zd:24146/zd:11872) (q:draft)
vaihawmsawm = (i:1) (t:v) (f:politics/work) (w:plan to/intend to arrange/be preparing to) (d:<vaihawm>, plan or arrange, with <sawm>, intend, written as one word: be planning to carry something out, said of governments and companies) (j:vaihawm/sawm) (r:zd:11931/zd:17750) (q:draft)
vaihawmzia = (i:1) (t:n) (f:politics/work) (w:way of managing/administration/policy) (d:<vaihawm> and <zia> written as one word: the way matters are planned and managed) (j:vaihawm/zia) (r:zd:24210/zd:20043) (q:draft)
vaii = (i:1) (t:n) (f:everyday/social) (j:vai) (r:zd:23383) (q:draft)
vaiipuak = (i:1) (t:n) (f:work/social) (w:responsibility/duty/task) (d:a task or responsibility that someone carries; from <vai>, affair, with <puak>, carry) (r:zd:22803/ts:261) (q:draft)
vaikha = (i:1) (t:v) (f:everyday/social) (w:instruct/charge/leave word/order) (d:tell someone what is to be done, as parting advice or as an order for food or drink; <vaikhak> is the form used before endings) (s:vaikhak) (r:zd:23748/zd:16820/zd:21703) (q:draft)
vaikhak = (i:4) (t:v) (f:food/everyday) (w:order) (d:ask for food, drink or goods to be made or sent, as in a restaurant or from another town; the thing ordered stands before {vaikhak}) (r:zd:25178/zd:17313) (q:draft)
vaikhat = (i:1) (t:n) (f:everyday/social) (w:a matter/some matter/something) (d:<vai>, matter, and <khat>, one, written as one word: a matter or concern; {vaikhat peuh} is any matter at all) (j:vai/khat) (r:zd:19320/zd:16844/zd:12231) (q:draft)
vaikhempeuh = (i:1) (t:n) (f:everyday/work) (w:all matters/all the arrangements) (d:<vai>, matter or affair, and <khempeuh>, all, written as one word) (j:vai/khempeuh) (r:zd:16421/zd:12431) (q:draft)
vaikin = (i:1) (t:n) (f:everyday/health) (w:emergency/urgent matter) (d:<vai>, matter, with <kin>, urgent: a matter that cannot wait; {zato vaikin} is a medical emergency) (r:zd:17824/zd:25415/zd:25111) (q:draft)
vaikuan = (i:1) (t:v) (f:work) (w:go to work/go out to work) (d:<vai>, business, with <kuan>, set out: leave home for the day's work, in the field or at a job) (r:zd:25189/zd:12292) (q:draft)
vaikuanna = (i:1) (t:n) (f:work) (w:workplace/going to work) (d:<vaikuan>, go to work, with the noun suffix {-na}: the place where one goes to work, or the going there) (b:vaikuan) (r:zd:17442/zd:24270) (q:draft)
vailian = (i:1) (t:n) (f:social) (w:important matter/major affair/great undertaking) (d:a great or weighty affair of a community, such as a common cause or a large public undertaking) (r:zd:13183/zd:20999) (q:draft, low confidence)
vailo = (i:1) (t:adj) (f:social) (w:unbecoming/unfitting/improper) (d:<vai> and the negative <lo> written as one word after a noun: not in the manner of, not befitting; {pasal vailo} is unmanly) (j:vai/lo) (r:zd:19013/zd:12510) (q:draft, low confidence)
vaimah = (i:1) (t:n) (f:everyday/social) (d:<vai>, matter or affair, with the emphatic <mah>, written as one word after the thing named: the very matter of, a case of just that) (j:vai/mah) (r:zd:11130) (q:draft, low confidence)
vaimang = (i:1) (t:n) (f:politics) (w:government/ruler/high office) (d:word of song language: the ruling power or government, and a high post in its service; {vaimang lian tun} is reach high office) (r:zd:12432/zd:20176) (q:draft, low confidence)
vaimim = (i:1) (t:n) (f:food/nature) (w:maize/corn) (r:zai:maize) (q:draft)
vaimin = (i:1) (t:n) (f:food/nature) (j:vaimim) (r:zd:23729/zd:15767) (q:draft)
vaimuak = (i:1) (t:v) (f:social) (w:welcome/receive/go to meet) (d:go to meet and receive a guest with honour, built on <muak>; {vaimuak thugenna} is a speech of welcome) (s:vaidawn) (r:zd:17788/zd:11358) (q:draft)
vaimuakna = (i:1) (t:n) (f:social) (w:welcome/reception/welcoming) (d:the act or occasion of welcoming a guest who arrives; {vaimuakna nei} is to hold a welcome) (s:vaidawnna/muakna) (r:zd:19260/zd:17963/zd:20727) (q:draft)
vaipen = (i:1) (t:phrase) (f:everyday/social) (w:the matter of/as for the matter) (d:<vai>, matter or affair, with the topic marker <pen>, written as one word after a noun or clause: the matter of this, as for this affair) (j:vai/pen) (r:zd:14979/zd:21837) (q:draft)
vaiphamawh = (i:1) (t:n) (f:everyday/social) (w:urgent matter/emergency/serious matter) (d:<vai>, matter, with <phamawh>, serious: a matter that cannot wait, an emergency) (j:vai/phamawh) (r:zd:13151/zd:12680) (q:draft)
vaipi = (i:1) (t:n) (f:social/politics/work) (w:important matter/great undertaking/major affair) (d:<vai>, affair, with <pi>, great: an important matter or large undertaking; {vaipi hawm} is conduct the main affairs, govern) (r:zd:21340/ts:301) (q:draft)
vaipuak = (i:1) (t:n) (f:social/work) (w:responsibility/duty/task) (d:a matter that someone has to carry: the duty or responsibility that falls on a person or group; {vaipuak la} is take on a responsibility) (r:zd:20971/zd:22704/zd:25461) (q:draft)
vaipuak nei = (i:1) (t:v) (f:work/politics) (w:be responsible/have a duty/be in charge) (d:<vaipuak>, responsibility, and <nei>, have: bear the responsibility for a matter or hold an office; before a noun or <khat> it describes the person in charge, a responsible officer) (r:zd:22254/ts:6610/zd:11176) (q:draft)
vaipuakla = (i:1) (t:v) (f:social/work) (w:take responsibility/take charge) (d:<vaipuak>, responsibility, with the verb for take, written as one word: take on the responsibility for a task) (r:zd:17530) (q:draft, low confidence)
vaipuakna = (i:1) (t:n) (f:social/work) (w:responsibility/duty) (d:<vaipuak> with the noun suffix <na>: responsibility, the bearing of a duty; {vaipuakna nei} is have or take responsibility) (b:vaipuak) (r:zd:24030/zd:18208) (q:draft)
vaisah = (i:1) (t:adj) (f:social/everyday) (w:serious/grave/troublesome) (d:of a matter: weighty and hard to deal with; <vai>, matter, with <sah>, thick) (r:zd:12998/zd:24932) (q:draft)
vaisai = (i:1) (t:n) (f:politics/work) (w:official/person in charge/department) (d:<vai>, affair, with <sai>, be in charge of: those who are in charge of a matter, or the office that deals with it; {cidamna lam vaisai} is the health authorities) (r:zd:20507/ts:11223) (q:draft, low confidence)
vaisaipi = (i:1) (t:n) (f:politics/work) (w:minister/secretary/officer in charge) (d:the person or office in charge of an area of affairs, from <vai>, affair, and <sai>, manage: {gamdang lam vaisaipi}, foreign minister; {thukizakna vaisaipi}, information officer) (r:zd:19114/ts:4418) (q:draft)
vaisaite = (i:1) (t:n) (f:politics/work) (w:officials/authorities/those in charge) (d:<vaisai>, one who handles a matter, from <vai>, affair, with the plural <te>: the officials or persons responsible for something; {kumpi lam vaisaite} is government officials) (b:vaisai) (r:ts:9083/ts:10582) (q:draft)
vaitawh = (i:1) (t:phrase) (f:everyday/media) (w:with the matter of) (d:<vai>, matter, and <tawh>, with, written as one word; mostly in {vaitawh kisai}, concerning the matter of, and {vaitawh kizom in}, in connection with the matter of) (j:vai/tawh) (r:zd:15881/zd:19219) (q:draft)
vaiteng = (i:1) (t:n) (f:everyday/social) (w:all affairs/everything to be done/all the arrangements) (d:<vai>, affair or business, and <teng> in the sense of all, written as one word: all of one's affairs, or all the arrangements for a case, a journey or a funeral) (j:vai/teng) (r:zd:22159/zd:13181/zd:16760) (q:draft)
vaithupi = (i:1) (t:n) (f:everyday/social) (w:important matter/important business) (d:<vai>, matter, and <thupi>, important, written as one word) (j:vai/thupi) (r:zd:13318/zd:21037) (q:draft)
vaituamtuam = (i:1) (t:n) (f:everyday/social) (w:various matters/various reasons) (d:<vai> and <tuamtuam> written as one word: affairs or concerns of different kinds; {vaituamtuam tawh} and {vaituamtuam hangin} are for various reasons) (j:vai/tuamtuam) (r:zd:13268/zd:11715) (q:draft)
vaitun = (i:1) (t:v) (f:social/travel) (w:arrive/gather) (d:arrive at the place of a meeting or feast as guest or delegate; {vaitun ni} is the day of arrival before a gathering opens) (r:zd:19371/zd:26411) (q:draft, low confidence)
vaizong = (i:1) (t:n) (f:everyday/politics) (w:matter also/affair too) (d:<vai> matter or affair and <zong> also, written as one word after the thing spoken of: the matter of it as well) (j:vai/zong) (r:zd:22459/zd:12739/zd:16331) (q:draft)
vak = (i:3) (t:v) (f:everyday/travel) (w:go about/walk about/roam/wander) (d:move about from place to place, not of light: {vak kawikawi} is roam around, {vak khia} is go out, and {tam vak} is go about a lot) (s:vakkhia) (r:zd:11072/zd:22652/zd:24069) (q:draft)
vak = (i:4) (t:v) (f:food/family) (w:feed/provide food for) (d:give food to a person or an animal, mostly after <an>, food; a spelling of <vaak>, and in job notices {an vak} means that meals are provided) (s:vaak) (r:zd:17979/zd:24130/zd:12024) (q:draft)
vakah = (i:1) (t:v) (f:social/travel) (w:go and attend/go to) (d:<va>, go and, with <kah>, attend, written as one word: go to a meeting, a conference or an office and take part) (j:va/kah) (r:zd:15122/zd:25322) (q:draft)
vakciang = (i:1) (t:phrase) (f:travel/everyday) (w:when going about/when walking around) (d:<vak>, go about, with <ciang>, when, written as one word: when one goes about, as in {khuasung vakciang}, when going about in town) (j:vak/ciang) (r:zd:11527/zd:11752) (q:draft)
vaki = (i:1) (t:part) (f:everyday) (d:<va> and the verb prefix <ki> written as one word and apart from the verb that follows: go and do to oneself, as in {vaki ap}, go and give oneself up) (j:va/ki) (r:zd:10722) (q:draft, low confidence)
vakkawikawi = (i:1) (t:v) (f:travel/everyday) (w:roam about/wander around/go about) (d:<vak>, here walk about, with <kawikawi> written as one word: go about from place to place) (r:zd:12214/zd:20293) (q:draft)
vakkhawm = (i:1) (t:v) (f:travel/social) (w:go about together/stroll together/roam together) (d:walk or wander about a place in company with others) (r:zd:19357/zd:26585) (q:draft)
vaklai = (i:1) (t:v) (f:travel/everyday) (w:while going about/while wandering) (d:<vak>, go about or roam, with <lai>, while: at the time of going about in a place) (r:zd:24167/zd:19338) (q:draft, low confidence)
vaklo = (i:1) (t:v) (f:work/food) (w:not feed/not provide meals) (d:<vak>, here feed, with <lo>, not, written as one word; in job advertisements {an vaklo} says that meals are not provided) (j:vak/lo) (r:zd:11587/zd:11706) (q:draft, low confidence)
vakna = (i:3) (t:n) (f:travel/everyday) (w:outing/walk/trip/wandering) (d:noun of <vak>, go about: a going about, a walk, visit or trip away from home; {khuasung vakna} is a walk about the town, and {gamlak vakna} is wandering in the wilderness, also the name of the book of Numbers) (r:zd:23249/zd:17961/zd:9438) (q:draft)
vakte = (i:1) (t:n) (f:travel/everyday) (w:those who go about/people moving about) (d:<vak>, here in the sense walk or go about, with the plural <te>: the people who go about a place; {khuasung vakte} is the people going about in town) (r:zd:17396/ts:7815) (q:draft)
vaktoh = (i:1) (t:v) (f:travel) (w:go up/go about) (d:form of <vakto> used before the noun ending <na>; {vaksuk vaktoh na} is going down and up, moving about from place to place) (b:vakto) (r:zd:24283/zd:18179) (q:draft)
vaktohnate = (i:1) (t:n) (f:travel/everyday) (w:goings/movements/travels) (d:plural of <vaktohna>; in the pair {vaksuk vaktohnate}, goings down and up, all of one's comings and goings) (b:vaktohna) (r:zd:23005/zd:24948) (q:draft)
vakvak = (i:1) (t:v) (f:everyday/travel) (w:go about/wander/roam) (d:go about from place to place, be out and about, often without need; a doubled verb of going about) (r:zd:23629/zd:22714/zd:12386) (q:draft)
val deuh = (i:1) (t:adv) (f:everyday) (w:a little over/slightly more than) (d:<val>, exceed, and <deuh>, somewhat: placed after a number with its measure, a little more than that amount; {kum 20 val deuh} is a little over twenty years) (r:zd:9245/zd:23240) (q:draft)
val pha = (i:1) (t:v) (f:everyday/media) (w:number more than/come to over/exceed) (d:<val>, be more than, and <pha>, here reach or amount to, not good: after a number, come to more than that number; used in reports of counts, sizes and totals) (r:zd:24234/zd:23014/zd:25210) (q:draft)
vala = (i:1) (t:v) (f:everyday) (w:go and get/fetch/go and take) (d:<va>, go and, and <la>, here the verb take, written as one word: go to where something or someone is and bring it) (j:va/la) (r:zd:21659/zd:22652) (q:draft)
valah = (i:1) (t:phrase) (f:everyday) (w:in more than/to more than) (d:<val>, more than, and <ah>, in or to, written as one word after a number: {State 20 valah} is in more than 20 states) (j:val/ah) (r:zd:13183/zd:9427) (q:draft)
valak = (i:1) (t:v) (f:everyday) (w:go and take/go and show) (d:<va>, go and, with <lak> written as one word: go and take something, or go and show something; the sense after <ki>, as in {ki valak mahmah}, is not determined) (j:va/lak) (r:zd:25223/zd:23767) (q:draft, low confidence)
valbang = (i:1) (t:adv) (f:everyday/media) (w:more than about/over) (d:<val> and <bang> written as one word, after a number: something over, more than about that many) (j:val/bang) (r:zd:14587/zd:12053/zd:15890) (q:draft)
valbangin = (i:1) (t:adv) (f:everyday/media) (w:more than about/over) (d:<valbang> and <in> written as one word, after a number: something over that many, more than about that much) (j:valbang/in) (r:zd:20387/zd:19514) (q:draft)
valdeuh = (i:1) (t:adv) (f:everyday/time) (w:a little over/slightly more than/just over) (d:<val>, exceed, and <deuh>, somewhat, written as one word after a number or measure) (j:val/deuh) (r:zd:20823/zd:17083) (q:draft)
valhsuk = (i:1) (t:v) (f:body/food) (w:swallow/swallow down) (d:<valh>, swallow, with <suk>, down: take something down the throat) (s:valh) (j:valh/suk) (r:zd:21616/zd:14708) (q:draft)
valkhin = (i:1) (t:v) (f:everyday) (w:have exceeded/be already more than) (d:<val> and <khin> written as one word, after a number: it is already more than that many) (j:val/khin) (r:zd:11945/zd:26310/zd:16423) (q:draft)
valkhinta = (i:1) (t:v) (f:everyday/time) (w:have passed/already exceed/be already more than) (d:<val>, exceed, and <khinta>, already done, written as one word: after a number or amount, it has already gone beyond it) (j:val/khinta) (r:zd:15689/zd:11945/zd:15491) (q:draft)
vallua = (i:1) (t:adj) (f:everyday) (w:excessive/too much/extreme) (d:<val>, exceed, with <lua>, too much: beyond what is right or needed; mostly as {a vallua}, what is excessive, and {a vallua in}, to excess) (j:val/lua) (r:zd:24276/zd:20647/zd:21075) (q:draft)
valman = (i:1) (t:phrase) (f:work) (w:worth more than) (d:<val> and <man>, price, written as one word after a sum of money: worth more than that amount) (j:val/man) (r:zd:25135/zd:12754) (q:draft)
valta = (i:1) (t:v) (f:everyday/time) (w:be more than/have passed) (d:<val>, exceed, with <ta>, here already, written as one word after a number: already more than that number) (j:val/ta) (r:zd:15971/zd:25517/zd:19826) (q:draft)
valtak = (i:1) (t:adv) (f:everyday) (w:well over/more than) (d:<val>, more than, with the strengthening <tak>, written as one word after a number: well over that number) (j:val/tak) (r:zd:17645/zd:15095/zd:16038) (q:draft)
valtawh = (i:1) (t:adv) (f:everyday) (w:more than/over) (d:<val>, exceed, and <tawh>, with, written as one word after a number: with more than that number) (j:val/tawh) (r:zd:15790) (q:draft)
Valung = (i:1) (t:name) (c:khua) (f:travel) (w:Valung) (d:village in Falam township of Chin State, named as the far end of the area where the Zo dialect is spoken) (r:zd:19657/zd:22334) (q:draft)
valval = (i:1) (t:adv) (f:everyday) (w:repeatedly/intensely/again and again) (d:placed after a verb: with a repeated or swinging movement or sound, or with strong feeling; {ging valval} is keep ringing and {duh valval} is crave strongly; after a number it is doubled <val>, well over) (r:zd:15644/zd:16254/zd:14708) (q:draft, low confidence)
van = (i:3) (t:n) (f:work/home) (w:goods/things/article/item) (d:things that are bought, sold, carried or used, as in {van man}, the price of goods, and {van tuamtuam}, various things; not the sky) (r:zd:23821/zd:25146/zd:23930) (q:draft)
van mawtaw = (i:1) (t:n) (f:travel) (w:van) (d:the English word van with <mawtaw>, motor vehicle: a van, a closed vehicle for goods or passengers; <van> is here not the Zolai word for sky) (r:zd:13061/zd:15454/zd:20609) (q:draft)
vanbawlna = (i:1) (t:n) (f:work) (w:manufacturing/industry/factory) (d:the making of goods, or a place where goods are made) (r:zd:23904/zd:22262) (q:draft)
Vancouver = (i:1) (t:name) (c:city) (f:travel) (w:Vancouver) (d:a city on the west coast of Canada) (r:zd:11846) (q:draft)
vandawn = (i:1) (t:n) (f:nature/travel) (w:sky/air/mid-air) (d:<van>, sky, with <dawn>, top: high up in the sky; {vandawn ah} is in the air, said of aircraft in flight and of smoke that rises) (r:zd:12963/zd:14681/zd:12128) (q:draft)
vanding = (i:1) (t:v) (f:work/social) (w:attend to/look after/take charge of) (d:taken as <vaan.2> and <ding> written as one word: to attend to or take charge of affairs; {vai vanding in} is in order to attend to the affairs) (j:vaan/ding) (r:zd:20256/zd:23156) (q:draft, low confidence)
vandum = (i:1) (t:n) (f:nature) (w:blue sky/sky blue) (d:<van>, sky, and <dum>, blue, written as one word: the blue sky, and the colour sky blue) (j:van/dum) (r:zd:23022) (q:draft)
vanei = (i:1) (t:v) (f:social/everyday) (w:go and hold/go and give) (d:<va> and <nei> written as one word: go to a place and hold or carry out something there, as a speech or an inspection) (j:va/nei) (r:zd:21904/zd:17530/zd:15874) (q:draft)
vangam = (i:1) (t:n) (f:religion) (w:heaven/kingdom of heaven) (d:<van>, heaven, with <gam>, country: heaven as the land where God is) (s:vantung) (j:van/gam) (r:zd:19983/zd:23676/zd:23896) (q:draft)
vanghvangh = (i:1) (t:adv) (f:everyday/media) (w:widely/greatly/far and wide) (d:placed after a verb, mostly <thang>, be known: news or a name spreads far and wide; with a negative, not much, not greatly) (r:zd:23639/zd:24594) (q:draft, low confidence)
vangil = (i:1) (t:n) (f:home/work) (w:property/goods/valuables/possessions) (d:the things a person owns, goods and valuables) (r:zd:20796/ts:8998) (q:draft)
vangkhua = (i:1) (t:n) (f:social/religion) (w:home village/home town/native place) (d:word of songs and poetic speech for the village or town where one was born and belongs; {Dimtui vangkhua} is a poetic name of Tedim) (r:zd:21426/zd:24542/zd:20558) (q:draft)
vanglak = (i:1) (t:part) (f:everyday) (w:actually/in fact/indeed) (d:placed after a verb: the thing really does happen or is so, often against what might be expected) (r:ts:3369/zd:23044) (q:draft, low confidence)
vangleng = (i:1) (t:n) (f:travel) (j:vanleng) (r:zd:20486/zd:10994/zd:20902) (q:draft)
Vanglian Pasian = (i:1) (t:name) (f:religion) (w:Almighty God/Mighty God) (d:<vanglian>, mighty, and <Pasian>, God: the Almighty God, a title of God in sermons and prayers; also written with a small letter when it follows another word, as in {i biak vanglian Pasian}, the almighty God we worship) (r:zd:26626/zd:25286) (q:draft)
vangnei = (i:1) (t:adj) (f:social/religion) (w:powerful/mighty/glorious/honoured) (d:<vang>, power or glory, with <nei>, have, written as one word: having power, effect or honour) (j:vang/nei) (r:zd:20200/zd:11697) (q:draft)
Vangteh = (i:1) (t:name) (c:khua) (f:travel/social) (w:Vangteh) (d:a Zomi village in the Tedim area of Chin State; in lists it follows the name of a person to show the home village) (r:zd:20414/zd:17325) (q:draft)
vanhoih = (i:1) (t:n) (f:home/everyday) (w:good things/fine goods/quality goods) (d:<van>, goods, with <hoih>, good: goods of good quality, fine belongings) (r:zd:10945/zd:17437) (q:draft)
vankham = (i:1) (t:n) (f:politics/health) (w:contraband/illegal drugs/narcotics) (d:goods that the law forbids; in the news mostly narcotic drugs, also {vankham zatui}) (r:zd:11459/zd:15134/zd:18876) (q:draft)
vankhamte = (i:1) (t:n) (f:politics/health) (w:contraband goods/illegal drugs) (d:<vankham> with the plural <te>) (b:vankham) (r:zd:11637/zd:20661) (q:draft)
vankhamzuak = (i:1) (t:v) (f:politics) (w:sell drugs/deal in drugs/drug dealer) (d:<vankham>, illegal drugs, and <zuak>, sell, written as one word: sell drugs, and before a noun the one who sells them, as in {vankhamzuak mi}, drug dealer) (j:vankham/zuak) (r:zd:13108/zd:11637) (q:draft)
vankhat = (i:1) (t:n) (f:everyday) (w:an object/a thing/an item) (d:<van>, here a thing or article, and <khat> written as one word: a thing, one object) (j:van/khat) (r:zd:12031/zd:16949) (q:draft)
vankhatpeuh = (i:1) (t:n) (f:work/everyday) (w:any item/any goods/anything) (d:<van>, here goods, things, and <khatpeuh>, any one, written as one word: any article or object whatever) (j:van/khatpeuh) (r:zd:19685/zd:21540/zd:11764) (q:draft)
vankhempeuh = (i:1) (t:n) (f:home/everyday) (w:all the things/all the goods/everything) (d:<van>, here goods or things, and <khempeuh> written as one word: all the things, every article) (j:van/khempeuh) (r:zd:16122/zd:24116) (q:draft)
vanlai = (i:1) (t:n) (f:nature) (w:mid-sky/high sky/space) (d:<van>, sky, with <lai>, middle: the height of the sky where the eagle flies, {mu vanlai}; in present-day writing also outer space) (r:ts:301/zd:16194) (q:draft)
vanlak = (i:1) (t:n) (f:travel) (w:luggage/baggage/belongings) (d:<van>, here goods, and <lak>, midst, written as one word: among the things someone carries, the luggage of a traveller; {vanlak panin} is from the luggage) (j:van/lak) (r:zd:21291/zd:15560) (q:draft)
vanlam = (i:1) (t:n) (f:nature/politics) (w:air/sky/skyward) (d:<van>, sky, with <lam>, direction: the direction of the sky, upward; in war news the air as against <leilam>, the ground, so that {vanlam pan kap} is to attack from the air) (r:ts:4033/zd:25603/zd:21918) (q:draft)
vanlam pan = (i:1) (t:adv) (f:politics) (w:from the air/by air) (d:<vanlam>, the sky side, and <pan>, from: from the air, said of attacks, bombing and reinforcement by aircraft; it stands before the verb and contrasts with {leilam pan}, on the ground) (r:ts:4653/ts:12074/ts:8689) (q:draft)
vanleeng = (i:1) (t:n) (f:travel) (j:vanleng) (r:zd:19166/zd:15834/zd:16087) (q:draft)
vanlei = (i:2) (t:n) (f:work/everyday) (w:customer/buyer/shopper) (d:a person who buys goods, the customer of a shop, where the first sense is the act of buying; counted with <khat> or made plural with <te>, and set against <vanzuak>, the seller) (r:zd:11364/zd:21869/ts:2586) (q:draft)
vanleiding = (i:1) (t:v) (f:work/everyday) (w:to buy goods/to shop) (d:<vanlei>, buy goods, and <ding> written as one word: in order to shop; {vanleiding in pai} is go shopping) (j:vanlei/ding) (r:zd:15048/zd:11683/zd:22932) (q:draft)
vanleina = (i:1) (t:n) (f:work) (w:buying/purchase/shopping) (d:<vanlei>, buy goods, with the noun suffix {-na}: the buying of goods, or the place where goods are bought, a shop; {vanzuak vanleina} is buying and selling, trade) (b:vanlei) (r:zd:21586/zd:22262) (q:draft)
vanlenate = (i:1) (t:n) (f:home/everyday) (w:goods/belongings/possessions) (d:{van le nate}, goods and things, written as one word: the goods and things that a person or a household has or needs) (j:van/le/nate) (r:zd:26026/zd:23935) (q:draft)
vanleng = (i:1) (t:n) (f:travel) (w:aeroplane/airplane/aircraft) (d:<van>, sky, with the verb fly, <leeng>: a machine that flies) (r:ts:2461/ts:3366) (q:draft)
vanleng kiatna = (i:1) (t:n) (f:travel/media) (w:plane crash/air crash) (d:<vanleng>, aeroplane, and <kiatna>, a falling: the crash of an aircraft, the usual term in news; followed by <pan> for survivors or bodies recovered from it, or by <ahang>, its cause) (r:zd:12936/zd:19054) (q:draft)
vanleng tuahsiatna = (i:1) (t:n) (f:travel/media) (w:plane crash/air accident/air disaster) (d:<vanleng>, aeroplane, and <tuahsiatna>, misfortune or accident: the crash of an aircraft, the usual term of news reports) (r:zd:22618/zd:17792) (q:draft)
vanlenghawl = (i:1) (t:n) (f:travel/work) (w:pilot/airman) (d:one who flies an aeroplane, <vanleng>, aeroplane, with <hawl>, drive; often said together with the English word, {vanlenghawl Pilot}) (r:zd:18270/zd:14787/zd:20248) (q:draft)
vanlenghawlpa = (i:1) (t:n) (f:travel/work) (w:pilot) (d:<vanleng>, aeroplane, and <hawlpa>, driver, written as one word: the man who flies an aeroplane) (j:vanleng/hawlpa) (r:zd:17763/zd:13169) (q:draft)
vanlenghawlzah = (i:1) (t:n) (f:travel/work) (w:flying time/amount of flying) (d:<vanlenghawl>, flying an aeroplane, with <zah>, amount, written as one word: how much a pilot has flown, counted in hours) (j:vanlenghawl/zah) (r:zd:12936) (q:draft, low confidence)
vanlengkhat = (i:1) (t:n) (f:travel) (w:an aeroplane/one aircraft) (d:<vanleng>, aeroplane, and <khat>, one or a, written as one word) (j:vanleng/khat) (r:zd:19860/zd:17696) (q:draft)
vanlengkia = (i:1) (t:n) (f:travel) (w:crashed plane/plane crash) (d:<vanleng>, aeroplane, and <kia>, fall, written as one word: an aeroplane that has crashed, or a plane crash) (j:vanleng/kia) (r:zd:17064/zd:13102/zd:17792) (q:draft)
vanlengneu = (i:1) (t:n) (f:travel) (w:small aircraft/light plane) (d:<vanleng>, aircraft, with <neu>, small: a light plane, and in one report an unmanned drone) (j:vanleng/neu) (r:zd:12530/zd:15773/zd:17864) (q:draft)
vanlengpen = (i:1) (t:n) (f:travel) (w:the aeroplane/the plane) (d:<vanleng>, aeroplane, and the topic marker <pen> written as one word: the plane, as the thing spoken about) (j:vanleng/pen) (r:zd:17581/zd:12000/zd:17713) (q:draft)
vanlengsung = (i:1) (t:n) (f:travel) (w:inside of an aeroplane/aircraft cabin) (d:<vanleng> and <sung> written as one word: the inside of an aeroplane, on board) (j:vanleng/sung) (r:zd:11081/zd:19912/zd:13276) (q:draft)
vanlengtawh = (i:1) (t:adv) (f:travel) (w:by plane/by air) (d:<vanleng>, aeroplane, and <tawh>, with, written as one word: by aeroplane) (j:vanleng/tawh) (r:zd:15031/zd:15296) (q:draft)
vanlengte = (i:1) (t:n) (f:travel) (w:aeroplanes/aircraft/planes) (d:plural of <vanleng>, aeroplane) (b:vanleng) (r:zd:19176/zd:17941/zd:21918) (q:draft)
vanlengtual = (i:1) (t:n) (f:travel) (w:airport/airfield) (d:<vanleng>, aeroplane, with <tual>, open ground: the place where aeroplanes land and take off) (r:zd:11874/zd:15669/zd:15992) (q:draft)
vanlengtung = (i:1) (t:adv) (f:travel) (w:on an aeroplane/on board an aircraft) (d:<vanleng>, aeroplane, and <tung>, on, written as one word: on or aboard an aircraft) (j:vanleng/tung) (r:zd:11621/zd:11997) (q:draft)
vanlengzong = (i:1) (t:phrase) (f:travel) (w:the aeroplane also/the plane too) (d:<vanleng> and <zong> written as one word: the aeroplane also, even the plane) (j:vanleng/zong) (r:zd:17432/zd:10670) (q:draft)
vanliatna = (i:1) (t:n) (f:religion) (j:vangliatna) (r:zd:9454/zd:21703) (q:draft)
vanman = (i:1) (t:n) (f:work) (w:price/prices/cost of goods) (d:<van>, goods, with <man>, price: what goods cost; {vanman tam} is prices are high and {vanman khang} is prices rise) (r:zd:12915/zd:23301) (q:draft)
vanmi = (i:1) (t:n) (f:religion) (w:angel/heavenly being) (d:<van>, heaven, with <mi>, person: a being from heaven, an angel) (s:vantungmi) (r:zd:25467/zd:23896) (q:draft)
vanpawlkhat = (i:1) (t:phrase) (f:everyday) (w:some things/some items/some goods) (d:<van>, thing or goods, with <pawlkhat>, some, written as one word) (j:van/pawlkhat) (r:zd:19837/zd:13243) (q:draft)
vanpen = (i:1) (t:n) (f:everyday) (w:the thing/the item/the object) (d:<van>, goods or a thing, and the topic marker <pen> written as one word: the thing or object, as the topic of the sentence) (j:van/pen) (r:zd:12645/zd:16708) (q:draft)
vanpih = (i:1) (t:v) (f:everyday/social) (w:assist/help/attend to for someone) (d:help someone by handling a matter for or with them, as arranging a visit, interpreting or seeing to affairs) (r:zd:14993/zd:14554) (q:draft, low confidence)
vanpuak = (i:1) (t:n) (f:travel/work) (w:load/luggage/cargo/freight) (d:goods that are carried, by a person or a vehicle; also the carrying of goods) (s:vangik) (r:zd:18958/zd:21268) (q:draft)
vanpuakna = (i:1) (t:n) (f:travel/work) (w:goods transport/cargo/freight) (d:the carrying of goods, as in {van puak} carry goods, with <puakna> carrying; before a vehicle it means for freight: {vanpuakna meileng} is a goods train and {vanpuakna vanleng} a cargo plane) (r:zd:14895/zd:19480/zd:13348) (q:draft)
vante = (i:3) (t:n) (f:everyday/home) (w:things/belongings/items/equipment) (d:the things a person owns or uses, such as belongings, tools, toys or materials, with no thought of trade; often after a possessive such as <ka> or after a word that says what the things are for) (r:zd:20389/zd:23729/zd:12096) (q:draft)
vanteng = (i:1) (t:n) (f:everyday/home) (w:belongings/goods/things/luggage) (d:the things someone owns or has with him: belongings, luggage, goods for sale, also clothes) (r:zd:18958/zd:12181) (q:draft)
vantuamtuam = (i:1) (t:n) (f:work/home) (w:various goods/various items/assorted things) (d:<van>, goods or things, and <tuamtuam>, of various kinds, written as one word: goods, supplies or equipment of different kinds) (j:van/tuamtuam) (r:zd:22662/zd:15417) (q:draft)
vanzat = (i:1) (t:n) (f:home/work) (w:equipment/tool/implement/utensil) (d:the things that are used for a task or in a house: tools, equipment, utensils, goods; from <van>, goods, and <zat>, use) (r:zd:21869/zd:26531/zd:23729) (q:draft)
vanzuak = (i:2) (t:n) (f:work) (w:seller/vendor/trader) (d:a person who sells goods, where {vanzuak} stands as a noun alone or before <pa>, <mi> or <te>; {vanzuak pa} is the seller) (r:zd:20764/zd:16900/zd:12068) (q:draft)
vanzuakte = (i:1) (t:n) (f:work) (w:sellers/traders/goods for sale) (d:<vanzuak>, sell goods, with the plural <te>: those who sell goods, opposed to {van leite}, the buyers; after a possessive also the goods someone has for sale) (b:vanzuak) (j:vanzuak/te) (r:zd:23935/zd:20117) (q:draft)
vapha = (i:1) (t:v) (f:travel/politics) (w:go and reach/visit in person/go to) (d:<va> with a verb that means reach, written as one word: go to a place and arrive there, mostly of leaders who visit the place itself) (j:va/pha) (r:zd:15243/zd:19990) (q:draft)
Vaphual = (i:1) (t:n) (c:animal) (f:nature/social) (w:hornbill) (d:the great hornbill, a large forest bird; the Zomi take it as their emblem and as a picture of faithfulness) (r:zd:21154/zd:16640/zd:20358) (q:draft)
vapia = (i:1) (t:v) (f:everyday/social) (w:go and give) (d:<va> and <pia> written as one word: go to someone and give; {tha vapia} is go and encourage) (j:va/pia) (r:zd:16376/zd:24157) (q:draft)
vapuak = (i:1) (t:v) (f:everyday/travel) (w:go and deliver/take to/go and send) (d:<va>, go and, and <puak>, send or deliver, written as one word: go to a place and hand something over there) (j:va/puak) (r:zd:24607/zd:15553) (q:draft)
Var = (i:1) (t:name) (c:place) (f:travel/politics) (w:Var) (d:a place on the Kalay to Falam and Hakha road in Chin State, Myanmar, with a bridge over the Manipur River and an army camp) (r:zd:25357/ts:4331) (q:draft, low confidence)
vasem = (i:1) (t:v) (f:work) (w:go and work/go and serve) (d:<va>, go and, and <sem>, work, written as one word: go to another place and work or serve there) (j:va/sem) (r:zd:21904/zd:21215) (q:draft)
vasim = (i:1) (t:v) (f:politics) (w:go and attack/attack) (d:<va>, go and, with <sim.3>, attack, written as one word: go to a place and attack it, of armed groups and armies) (j:va/sim) (r:zd:15212/zd:17611) (q:draft)
vasim = (i:2) (t:v) (f:social) (w:go and attend/go and visit) (d:<va>, go and, with <sim>, here visit or take part in, written as one word: go to a festival or gathering and join in it) (j:va/sim) (r:zd:15874) (q:draft, low confidence)
vat = (i:2) (t:adv) (f:everyday) (w:suddenly/all at once/abruptly) (d:after a verb, not the verb strike: the action comes suddenly or unexpectedly, as {phawk vat} suddenly remember and {si vat} die suddenly; often with {thakhat thu in} or <mawk>) (r:zd:14750/zd:21989/zd:21845) (q:draft)
vat = (i:3) (t:v) (f:work/nature) (w:clear/cut down/fell) (d:cut down the trees and bush of a field before burning it, as {lo vat} clear a field; not a striking of a person or place) (r:zd:9430) (q:draft, low confidence)
Vatican = (i:1) (t:name) (c:land/place) (f:religion/politics) (w:Vatican/Vatican City) (d:the city state in Rome that is the seat of the Pope and of the Roman Catholic Church) (r:zd:12654/zd:15653) (q:draft)
vatmawkpen = (i:1) (t:phrase) (f:social) (d:<vat>, here suddenly, <mawk>, unexpectedly, and the topic marker <pen>, written as one word after a verb: the fact that it happened so suddenly; in notices of condolence {ong nusiat vatmawkpen} is his leaving us so suddenly) (j:vat/mawk/pen) (r:zd:11757/zd:12799) (q:draft)
vatna = (i:1) (t:n) (f:everyday) (w:sudden doing) (d:placed after a verb: <vat>, here suddenly, with the noun suffix <na>, the sudden doing of it; {nusiat vatna} is a sudden leaving, and {thau-vatna} sudden gain of weight) (r:zd:15449) (q:draft, low confidence)
vatung = (i:1) (t:v) (f:travel) (w:arrive there/reach/get to) (d:<va> and <tung> written as one word: go and arrive at another place) (j:va/tung) (r:zd:22464/zd:11110) (q:draft)
vatvat = (i:1) (t:adv) (f:everyday) (w:abruptly/impulsively/suddenly) (d:placed after a verb: the action is done in a sudden, hasty or jerky way, without holding back, often again and again; {lungtom vatvat} is quick to flare up) (r:zd:22858/zd:14824/zd:19814) (q:draft, low confidence)
vatzat = (i:1) (t:n) (f:work/home) (j:vanzat) (r:zd:11854/zd:19816) (q:draft, low confidence)
vau = (i:1) (t:v) (f:social/politics) (w:threaten/intimidate) (d:frighten someone with words of what will be done to him, so that he does or gives something) (r:zd:24188/zd:24542/zd:22595) (q:draft)
vauna = (i:1) (t:n) (f:social/politics) (w:threat/warning/intimidation) (d:words or acts that threaten harm to make someone obey or stop, or a stern warning; {vauna ngah} is receive threats) (r:zd:25666/zd:9429/zd:9124) (q:draft)
vauvau = (i:1) (t:adv) (f:everyday) (w:strongly/intensely/on and on) (d:placed after a verb or describing word to say that a smell, a sound or a desire is strong and keeps on: {namtui vauvau} is strongly fragrant, {ham vauvau} is buzz on and on, {duh vauvau} is crave) (r:zd:26097/zd:12144) (q:draft, low confidence)
vava = (i:1) (t:adv) (f:everyday) (w:forcefully/loudly/vigorously) (d:placed after a verb: doing it with force, strongly or noisily, much like <baba>) (r:zd:19295/zd:17992) (q:draft, low confidence)
vaw = (i:1) (t:intj) (f:everyday/media) (w:O/oh) (d:exclamation of feeling used in songs and warm speech, placed after the name of the one addressed, as {Nu vaw}, O mother, or at the end of a sentence to give it weight; found also in song titles) (r:zd:11163/zd:21925) (q:draft, low confidence)
vawt = (i:1) (t:adj) (f:everyday/nature) (j:vot) (r:zd:20145) (q:draft, low confidence)
vazin = (i:1) (t:v) (f:travel) (w:go and visit/travel to) (d:<va>, go and, with <zin>, travel, written as one word: go to another place on a journey or a visit) (j:va/zin) (r:zd:12093/zd:24069/zd:19723) (q:draft)
vazui = (i:1) (t:v) (f:everyday/travel) (w:go along with/go and follow/accompany) (d:<va>, go and, and <zui>, follow, written as one word: go to where others are going and follow them, go along) (j:va/zui) (r:zd:25322/zd:25225) (q:draft)
ve maw = (i:1) (t:part) (f:everyday) (w:isn't it/you see/indeed) (d:the particles <ve>, emphasis, and <maw>, question, together at the end of a sentence in place of <hi>: the speaker states something with feeling and looks for agreement, or wonders at it) (r:zd:25064/zd:17589) (q:draft, low confidence)
veel = (i:1) (t:v) (f:everyday/health) (j:vel) (r:zd:25200/zd:17860) (q:draft)
veeng = (i:2) (t:n) (f:social) (w:neighbour) (d:a person or household living near one's own, as in {ka veeng khat}, one of my neighbours; the pair {veeng leh paam} is the neighbours all around) (s:veng) (r:zd:15998/zd:16844) (q:draft)
Vegas = (i:1) (t:name) (c:city) (f:travel) (w:Las Vegas) (d:second word of Las Vegas, a city in the state of Nevada in the United States) (r:zd:11932) (q:draft)
veh aw = (i:1) (t:part) (f:everyday) (w:surely/indeed) (d:a sentence-final word written like <veh>, visit, but not that verb, with the exclamation <aw>: closes a spoken sentence with feeling or emphasis; after <kei>, not, as in {hi kei veh aw}, it protests or insists) (r:zd:21370/zd:20751) (q:draft, low confidence)
vehna = (i:1) (t:n) (f:social/health) (w:visit/visiting) (d:noun from <veh>, visit: a visit to the sick, to prisoners or to those in need; also the money or gift brought on such a visit) (b:veh) (r:zd:22928/zd:15527/zd:22413) (q:draft)
vei = (i:1) (t:n) (f:time/everyday) (w:time) (d:an occasion or instance, counted with a number word before it: {khat vei} is once, {thum vei} is three times)
veibang = (i:1) (t:adv) (f:everyday/time) (w:about so many times) (d:<vei>, time, and <bang>, about, written as one word after a number: about that many times, as in {3 veibang}, some three times) (j:vei/bang) (r:zd:16926/zd:16216/zd:14901) (q:draft)
veih = (i:1) (t:n) (f:body) (w:fart/flatus/wind) (d:gas passed from the bowels; {veih pek} is break wind) (r:zd:17846/zd:17796) (q:draft)
veiina = (i:1) (t:n) (f:social) (w:concern/burden/care) (d:a heart that is burdened for something and cares deeply about it; {minam veiina} is concern for one's people) (r:zd:22989) (q:draft, low confidence)
veilo = (i:1) (t:v) (f:everyday/health) (w:not suffer from/not be concerned about) (d:<vei>, here a verb, be sick with or be burdened in heart for, with <lo>, not, written as one word: not fall ill, or not care about a matter; another word than {sau veilo}, before long) (r:zd:22701/zd:25089) (q:draft, low confidence)
veina = (i:4) (t:n) (f:social/religion) (w:concern/care/burden) (d:<vei>, feel concern for, with <na>: heartfelt concern or burden for people, a nation or a cause, not a count of times; it stands beside <itna>, love, and in {minam veina}, concern for the nation) (r:zd:23191/zd:14887/zd:24248) (q:draft)
veinate = (i:1) (t:n) (f:social) (w:concerns/burdens/afflictions) (d:plural of <veina> in the sense of a thing one suffers from or is burdened about, from <vei>, suffer or feel concern) (r:zd:22336) (q:draft, low confidence)
veipen = (i:1) (t:phrase) (f:time) (d:<vei>, time or occasion, and the topic marker <pen> written as one word: this time, or after a number the occasions counted, as the thing spoken about) (j:vei/pen) (r:zd:17921/zd:17252) (q:draft)
veipen = (i:2) (t:v) (f:social) (w:care about most/be most concerned for) (d:<vei>, here feel concern or a burden for, with <pen> as the superlative ending: what one cares about most) (r:zd:25573) (q:draft, low confidence)
veipiang = (i:1) (t:v) (f:media/everyday) (w:happen so many times/occur) (d:<vei>, time, and <piang>, happen, written as one word after a number: happened that many times) (j:vei/piang) (r:zd:17110) (q:draft, low confidence)
veita = (i:1) (t:adv) (f:time) (w:times each/times) (d:<vei>, time, with the distributive ending {-ta}, each: after a number, that many times in every period named; {kum khat in khat veita} is once a year) (b:vei) (r:zd:20926/zd:23833/zd:12177) (q:draft)
veitak = (i:1) (t:adv) (f:everyday/time) (w:as many as ... times) (d:<vei> and <tak> written as one word after a number: that many times, stressing that the number is large; {7 veitak} is as many as seven times) (j:vei/tak) (r:zd:17917/zd:21279) (q:draft)
Veitnam = (i:1) (t:name) (f:travel/politics) (j:Vietnam) (r:zd:16058/zd:20730) (q:draft)
veival = (i:1) (t:phrase) (f:time/everyday) (w:more than ... times) (d:<vei>, times, and <val>, more than, written as one word after a number: more than that many times) (j:vei/val) (r:ts:2073/zd:25171) (q:draft)
veivei = (i:2) (t:v) (f:body/everyday) (w:wave/swing/rock) (d:without <khat> before it, move something to and fro again and again, as hands waved in the air or a cradle rocked) (r:zd:15264/zd:21530) (q:draft, low confidence)
veivei ciangin = (i:1) (t:adv) (f:time/everyday) (w:sometimes/at times/now and then) (d:<veivei>, at times, and <ciangin>, when: always after <khat> as {khat veivei ciangin}, sometimes, at the head of a sentence or clause) (s:khatveivei) (r:zd:23487/zd:19425) (q:draft)
vekpi = (i:1) (t:adv) (f:everyday) (w:all/altogether/in all) (d:the whole, everyone or everything together, used as {a vekpi-in} or {a vekpi-un}) (s:vekin/vekun) (q:draft)
vekpi gawm = (i:1) (t:adv) (f:everyday/work) (w:in total/altogether/grand total) (d:<vekpi>, all, and <gawm>, add together: all added together; stands after the thing counted and before the number, and heads the last line of a list of sums) (r:zd:19262/zd:24671) (q:draft)
vekpigawm = (i:1) (t:adv) (f:everyday) (w:in total/altogether/all together) (d:<vekpi> and <gawm> written as one word: all added together, used before a total number) (j:vekpi/gawm) (r:zd:24195/zd:15590) (q:draft)
velcian = (i:1) (t:v) (f:work/health) (w:examine closely/inspect carefully/check thoroughly) (d:<vel>, examine, with <cian>, carefully, written as one word: look a thing over thoroughly) (s:kancian) (j:vel/cian) (r:zd:16450/zd:13352/zd:11240) (q:draft)
velcianna = (i:1) (t:n) (f:politics/work) (w:inspection/examination/investigation) (d:<vel>, examine, with <cian>, carefully, and the noun suffix {-na}: a close examination; {velcianna nei} is carry out an inspection) (r:zd:11112/zd:11376/zd:20239) (q:draft)
velna = (i:1) (t:n) (f:health) (w:examination/check-up) (d:<vel>, examine, with the noun suffix {-na}: the examining of a patient; {ha velna} is a dental check) (b:vel) (r:zd:19293) (q:draft, low confidence)
velval = (i:2) (t:adv) (f:everyday) (w:very/really/quite/utterly) (d:general intensifier after a verb or descriptive word of any kind, not only after words of pain: {cidam velval} is quite healthy and {lumlet velval} is overturn completely) (r:zd:15965/zd:16934/zd:21198) (q:draft)
velvel = (i:2) (t:v) (f:everyday) (w:keep looking at/look over/look through) (d:<vel>, look over, doubled for continued action: look at a thing again and again, or go through things one after another, as against the adverb {velvel} that follows another verb) (r:zd:15709/zd:26097/zd:21025) (q:draft)
vemaw = (i:1) (t:part) (f:everyday) (d:<ve> and <maw> written as one word at the end of a request: a friendly urging, do so, won't you) (j:ve/maw) (r:zd:11308) (q:draft)
ven = (i:3) (t:part) (f:everyday) (w:indeed/surely/you see) (d:sentence-final word after <hi> in a statement, not after a command: it stresses that the thing is plainly so, and may be followed by <maw> or <cin>) (r:zd:22683/zd:21220/zd:24149) (q:draft)
vencin = (i:1) (t:part) (f:everyday) (d:words that close a clause and state it as plain to see or only to be expected: after all, as one can see, of course; the clause often gives the ground for what is said next) (j:ven/cin) (r:zd:11110/zd:15387) (q:draft, low confidence)
Venezuela = (i:1) (t:name) (c:land) (f:politics) (w:Venezuela) (d:a country in South America) (r:zd:25602/zd:17361) (q:draft)
veng = (i:2) (t:n) (f:social) (w:neighbourhood/neighbour/quarter) (d:the part of a village or town where one lives, and the people who live near) (s:veeng/innveng) (q:draft)
veng = (i:3) (t:part) (f:everyday) (w:indeed) (d:ending of a sentence in which the speaker talks of himself with feeling, after <kei> or <hi> as in {kei veng} and {hi veng}; not the noun for a neighbourhood and not the verb cease) (r:zd:25937/zd:21941) (q:draft, low confidence)
veng kim = (i:1) (t:n) (f:social/home) (w:neighbourhood/surroundings/vicinity) (d:<veng>, neighbourhood, and <kim>, the area around: the neighbourhood and what lies round it; mostly in the doubled expression {veng kim veng pam}, all around where one lives, with <pam>, vicinity) (r:zd:22652/zd:22459) (q:draft)
veng pam = (i:1) (t:n) (f:home/social) (w:neighbourhood/surroundings/vicinity) (d:<veng>, neighbourhood, and <pam>, edge: used in the paired expression {veng kim veng pam}, the whole neighbourhood round about where one lives) (r:zd:22459) (q:draft)
vengbit = (i:1) (t:v) (f:social/politics) (w:protect/safeguard/keep safe) (d:guard a person or a life so that it is safe; <veng>, here guard, with <bit>, safe) (r:zd:9124/zd:9126) (q:draft)
vengbitna = (i:1) (t:n) (f:social/politics) (w:protection/safeguarding/defence) (d:<vengbit>, protect, with the noun suffix <na>: the protecting of a person or a right, mostly as {vengbitna ding}, in order to protect) (b:vengbit) (r:zd:9126/zd:9124) (q:draft)
vengkhat = (i:1) (t:n) (f:social/travel) (w:a neighbourhood/one quarter) (d:<veng> and <khat> written as one word: a neighbourhood, one quarter of a town) (j:veng/khat) (r:zd:16197/zd:19936) (q:draft)
venglepaam = (i:1) (t:n) (f:social/home) (w:neighbourhood/neighbours) (d:<veng>, <le> and <paam> written as one word: the neighbourhood and its surroundings, and the people who live there) (j:veng/le/paam) (r:zd:20595/zd:21613) (q:draft)
vengnailo = (i:1) (t:v) (f:everyday/media) (w:not yet over/not yet subsided) (d:<veng>, cease, with <nailo>, not yet, written as one word: of trouble or fighting, not yet at an end) (j:veng/nailo) (r:zd:13100/zd:23084) (q:draft)
vengpan = (i:1) (t:adv) (f:everyday/travel) (w:from the neighbourhood/from the quarter) (d:<veng>, neighbourhood, and <pan>, from, written as one word after the name of a quarter) (j:veng/pan) (r:zd:18122) (q:draft)
vengpan = (i:2) (t:v) (f:politics/everyday) (w:come to an end/cease) (d:<veng>, cease, with <pan>, here only then, written as one word: of a war or of fighting, stop at last) (j:veng/pan) (r:zd:25292/zd:11866) (q:draft, low confidence)
vengsak = (i:1) (t:v) (f:everyday/health) (w:make cease/remove/resolve) (d:<veng>, cease, with the causative <sak>: bring a trouble, hardship or disease to an end) (j:veng/sak) (r:zd:19139/zd:25119/zd:21747) (q:draft)
vengsung = (i:1) (t:n) (f:social/travel) (w:neighbourhood/area/quarter) (d:<veng> and <sung> written as one word: the inside of a neighbourhood; after a place name, the area of that name) (j:veng/sung) (r:zd:17021/zd:15604/zd:16846) (q:draft)
vengsungah = (i:1) (t:adv) (f:social/travel) (w:in the neighbourhood/in the area of) (d:<veng> and <sungah> written as one word, after a place name: in that quarter, district or neighbourhood) (j:veng/sungah) (r:zd:14963/zd:17149) (q:draft)
vengsungteng = (i:1) (t:n) (f:social/travel) (w:whole neighbourhood/whole area) (d:<vengsung>, neighbourhood, and <teng>, all, written as one word: the whole of a neighbourhood; after a place name, all around that area) (j:vengsung/teng) (r:zd:21613/zd:14957) (q:draft)
vengta = (i:1) (t:n) (f:social) (w:neighbours/neighbour) (d:<veng>, neighbourhood, with {-ta}, as in <lawmta>: people who live next to each other, neighbours in their relation to one another) (b:veng) (r:zd:19981/zd:24202) (q:draft, low confidence)
vengta = (i:2) (t:v) (f:everyday/politics) (w:be over/be settled) (d:<veng>, cease, and <ta>, now or already, written as one word: a matter or case is finished, is cleared) (j:veng/ta) (r:zd:22850) (q:draft, low confidence)
vengtuamtuam = (i:1) (t:n) (f:social/travel) (w:various neighbourhoods/different districts) (d:<veng> and <tuamtuam> written as one word: the several quarters or districts of a town) (j:veng/tuamtuam) (r:zd:18042/zd:15002) (q:draft)
vengveng = (i:1) (t:adv) (f:social) (w:in each neighbourhood/ward by ward) (d:<veng> doubled, after <a>: each neighbourhood or quarter for itself, quarter by quarter) (b:veng) (r:zd:17410/zd:17493) (q:draft)
vengvung = (i:1) (t:adv) (f:social/everyday) (w:in an uproar/noisily/tumultuously) (d:placed after a verb for a noisy and widespread stir: {so vengvung} is seethe in uproar, {buai vengvung} is be in a commotion) (r:zd:24966/zd:14581) (q:draft, low confidence)
veni = (i:1) (t:part) (f:everyday) (d:<ve> and <ni> written as one word at the end of a sentence: let us, an invitation or urging that includes the speaker; often as {dih veni}) (j:ve/ni) (r:zd:14814/zd:16037) (q:draft, low confidence)
vensak = (i:1) (t:v) (f:social) (w:resolve/settle/end/relieve) (d:<ven>, cease, with the causative <sak>: make a trouble, dispute or hardship come to an end) (b:ven) (r:ts:3280/zd:21747/zd:25177) (q:draft)
ventilator = (i:1) (t:n) (f:health) (w:ventilator/breathing machine) (d:a hospital machine that breathes for a patient who cannot breathe alone) (o:English) (r:zd:23825/zd:23898) (q:draft)
Venus = (i:1) (t:name) (c:star) (f:nature) (w:Venus) (d:the planet Venus; as the morning star it is called <zingsol>) (o:English) (r:zd:11292/zd:11072) (q:draft)
verse = (i:1) (t:n) (f:religion/education) (w:verse) (d:a numbered verse of a holy book, written before or after its number) (o:English) (r:zd:19679/zd:24377) (q:draft)
version = (i:1) (t:n) (f:media/it) (w:version/edition) (d:one form of a text, a translation or a program among several, as an English version of a statement or a version of the Bible) (o:English) (r:zd:23272/zd:14789/zd:12441) (q:draft)
vetkei = (i:1) (t:adv) (f:everyday) (w:not at all) (d:<vet> and <kei> written as one word after a verb: not at all; before <in> it forbids, do not at all) (j:vet/kei) (r:zd:24029/zd:17060/zd:20652) (q:draft)
vetlo = (i:1) (t:adv) (f:everyday) (w:not at all/never) (d:the emphatic <vet> and <lo>, not, written as one word: placed after a verb, not at all, not in the least) (j:vet/lo) (r:zd:20484/zd:24742/zd:11163) (q:draft)
vetloh = (i:1) (t:adv) (f:everyday) (w:not at all/not even) (d:<vet> and <loh> written as one word after a verb: not at all; the form taken before <ding>, <hi> and <na>, and {gen vetloh} is not even to be spoken of) (j:vet/loh) (r:zd:25923/zd:25917) (q:draft)
veto = (i:1) (t:n) (f:politics) (w:veto) (d:the right of one member or office to stop a decision, mostly as {veto power}) (o:English) (r:ts:3284) (q:draft)
vetse = (i:1) (t:part) (f:everyday) (d:<vet> and <se> written as one word: emphatic particle after a verb or describing word, really, indeed; after <lo>, not at all) (j:vet/se) (r:zd:23113/zd:16356) (q:draft, low confidence)
veuveu = (i:1) (t:adv) (f:everyday/food) (d:placed after a verb for something that keeps coming steadily, as steam or a good smell rising from food; also of an action done again and again) (r:zd:19812/zd:25673) (q:draft, low confidence)
veve lel = (i:1) (t:adv) (f:everyday) (w:all the same/still anyway/just the same) (d:<veve>, still, nevertheless, and <lel>, just, merely, not the verb lose: placed after a verb and before the sentence-final word, the thing holds all the same in spite of what was said before, often after a clause with <hangin> or <zong>) (r:zd:21254/zd:21081) (q:draft)
veveding = (i:1) (t:adv) (f:everyday) (w:will still/will anyway) (d:<veve> and <ding> written as one word, after a verb: will do or be so all the same) (j:veve/ding) (r:zd:11695/zd:11635/zd:14925) (q:draft)
