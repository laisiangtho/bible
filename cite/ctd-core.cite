State = (i:1) (t:n) (f:politics) (w:state) (d:a state as a division of a country, mostly after its name, as in Chin State) (o:English) (r:zd:15439/zd:22439/zd:22412) (q:draft)
Statement = (i:1) (t:n) (f:media/politics) (w:statement/announcement) (d:an official written statement that an office, the police or an organisation releases to the public) (o:English) (r:zd:14624/zd:19182/zd:17874) (q:draft)
statement akhahkhiatna = (i:1) (t:n) (f:media/politics) (w:released statement/press statement/press release) (d:the English word {statement} and <akhahkhiatna>, its release: the statement that an office or company has put out; stands after the name of the one who issued it and before <ah>, in, to introduce what the statement says) (r:zd:10812/zd:12555/zd:15782) (q:draft)
States = (i:1) (t:n) (f:politics) (w:states) (d:the English plural of <State>, used for the states of a country such as Myanmar, India or the United States) (b:State) (o:English) (r:zd:14696/zd:17897) (q:draft)
Station = (i:1) (t:n) (f:travel) (w:station) (d:a railway or bus station; {police station} is the office of the police) (o:English) (r:zd:18147/zd:19599/zd:18144) (q:draft)
status = (i:1) (t:n) (f:politics/social) (w:status/legal status) (d:the standing that the law or an office gives a person, such as recognition as a refugee by UNHCR; it occurs mostly in English phrases such as {Refugee Status}) (o:English) (r:zd:19953/zd:23844) (q:draft, low confidence)
Steel = (i:1) (t:n) (f:work/home) (w:steel) (o:English) (r:zd:21616/zd:19756) (q:draft)
step = (i:1) (t:n) (f:everyday) (w:step/stage) (d:one stair of a stairway, or one stage of a course of action) (o:English) (r:zd:24234/zd:24186) (q:draft)
Stock = (i:1) (t:n) (f:work) (w:stock/shares) (d:shares of a company that are bought and sold; also the goods a seller has on hand) (o:English) (r:zd:15517/zd:22704) (q:draft, low confidence)
Stockholm = (i:1) (t:name) (c:city) (f:travel) (w:Stockholm) (d:the capital city of Sweden) (r:zd:9227/zd:19460) (q:draft)
Stomp = (i:1) (t:name) (f:media) (w:Stomp) (d:news website of Singapore to which readers send reports, often named as a source, also written STOMP; {Stomp pan kiza hi} is it is heard from Stomp) (r:zd:17100/zd:15292) (q:draft)
storey = (i:1) (t:n) (f:home) (w:storey/floor) (d:one level of a building, used after a number to say how many floors a building has, often beside the Zolai <inndawl>) (s:dawl) (o:English) (r:zd:19788/zd:19002) (q:draft)
strategy = (i:1) (t:n) (f:politics/work) (w:strategy) (d:a plan for reaching an aim; in war reports also said before a word for hill of a strategic hill position, as {strategy mualtung}) (o:English) (r:zd:23776/zd:24116) (q:draft, low confidence)
studio = (i:1) (t:n) (f:media) (w:studio/recording studio) (d:a room where songs are recorded or photographs are taken) (o:English) (r:zd:21070/zd:23036) (q:draft)
study = (i:1) (t:n) (f:education) (w:study/research) (d:a study or piece of research; {study bawl} is make a study) (o:English) (r:zd:24453/zd:20406) (q:draft)
Stunt = (i:1) (t:n) (f:media) (w:stunt) (d:a daring or showy feat done to draw attention; {stunt bawl} and {stunt la} are do a stunt) (o:English) (r:zd:15924/zd:17115) (q:draft)
style = (i:1) (t:n) (f:media/everyday) (w:style/manner/fashion) (d:the way something is made, sung or done) (o:English) (r:zd:21102/zd:16216) (q:draft, low confidence)
suah seh = (i:1) (t:phrase) (f:education/everyday) (w:out of/parts of) (d:<suah>, make into, and <seh>, part: the middle of a fraction, in the frame {seh thum suah seh nih}, of three parts two, two thirds; the first number is the whole and the second the share) (r:zd:17613/zd:23301) (q:draft)
suahkha = (i:1) (t:n) (f:time/family) (w:month of birth/birth month) (d:<suah>, be born, with <kha>, month: the month in which a person was born, usually named together with <suahni>, the day of birth) (j:suah/kha) (r:zd:12280/zd:25789) (q:draft)
suahni = (i:1) (t:n) (f:time/family) (w:birthday/date of birth/day of birth) (d:<suah> and <ni> written as one word: the day on which someone was born, or the day on which an organisation was founded) (j:suah/ni) (r:zd:21739/zd:16820/zd:15905) (q:draft)
suahtaakna = (i:1) (t:n) (f:politics) (j:suahtakna) (r:zd:25712/zd:23488/zd:25678) (q:draft)
suahtakna ngah = (i:1) (t:v) (f:politics) (w:gain independence/become free/be released) (d:<suahtakna>, freedom, and <ngah>, get: of a country, gain independence from a ruling power, and of a person, be set free; {suahtakna ngah khit ciang} is after independence) (r:zd:17106/zd:24743/zd:23792) (q:draft)
suai = (i:1) (t:v) (f:media/education) (w:draw/paint/depict) (d:make a picture; {lim suai} is draw or paint a picture) (r:zd:17466/zd:23113) (q:draft)
suai = (i:2) (t:n) (f:politics/work) (w:signature) (d:a signature, said with <kai>, draw: {suai kai} is sign one's name, and {thukimna suai kai} is sign an agreement) (r:ts:12274/zd:17760/zd:21421) (q:draft)
suaih = (i:1) (t:v) (f:education/media) (w:draw/paint/sketch) (d:draw or paint a picture, {lim suaih}; said also of drawing up a budget; also written <suai>) (r:zd:17466/zd:16078/zd:22747) (q:draft)
suaikai = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature) (d:write one's name on a document or an agreement to approve it; {thukimna suaikai} is sign an agreement) (r:ts:3375/zd:21659/zd:11463) (q:draft)
suaikaih = (i:1) (t:v) (f:politics/work) (w:sign/put one's signature to) (d:<suai>, signature, with <kaih>, draw: sign a document or agreement; the form used before <na> and <lai>, and {suaikaihna} is the signing) (r:ts:12498/zd:17722) (q:draft)
suaikhi = (i:1) (t:n) (f:home) (w:necklace/gold necklace/neck chain) (d:a chain worn round the neck as jewellery, usually of gold; named with <bilbah>, earrings) (s:khamkhi) (r:zd:21121/zd:14941) (q:draft)
suaka = (i:1) (t:v) (f:everyday/family) (w:be born/become) (d:<suak>, be born or come to be, and the linking <a>, written as one word: was born and, became and; the sentence then goes on) (j:suak/a) (r:zd:9256/zd:22807) (q:draft)
suakcil = (i:1) (t:adj) (f:family/health) (w:newborn/just born) (d:<suak>, here be born, with <cil>, at the beginning: just born; {naungek suakcil} is a newborn baby) (r:zd:12014/zd:15984) (q:draft)
suakding = (i:1) (t:v) (f:everyday) (w:will become/will turn into/will come out) (d:<suak>, become or come forth, and <ding>, will, written as one word) (j:suak/ding) (r:zd:11373/zd:24570) (q:draft)
suakding = (i:2) (t:v) (f:everyday) (w:will go on/will continue) (d:<suak>, placed after a verb for an action that carries on or is done for good, and <ding>, will, written as one word: {kinei suakding} is will go on being held, {khakcip suakding} is will be closed for good) (j:suak/ding) (r:zd:17549) (q:draft)
suakhi = (i:1) (t:v) (f:everyday) (w:become/turn into) (d:<suak>, become, and the sentence ending <hi> written as one word: became, has become) (j:suak/hi) (r:zd:23797/zd:23356) (q:draft)
suakhi = (i:2) (t:v) (f:family/everyday) (w:be born) (d:<suak>, be born, and the sentence ending <hi> written as one word: was born) (j:suak/hi) (r:zd:20484/zd:22873) (q:draft)
suaklo = (i:1) (t:v) (f:everyday) (w:not become/not turn out/not appear) (d:<suak> and <lo> written as one word: not become something; also not come out or not show) (j:suak/lo) (r:zd:17577/zd:19997/zd:12794) (q:draft)
suakta takin = (i:1) (t:adv) (f:social/politics) (w:freely/in freedom/at liberty) (d:<suakta>, be free, and <takin>, which makes an adverb: placed before a verb, do it freely, without restraint) (r:zd:23148/zd:22695/zd:21706) (q:draft)
suaktakna = (i:1) (t:n) (f:politics/social) (w:freedom/liberty/independence) (d:<suaktak>, be free, with the noun suffix <na>: freedom of a person, or the independence of a country) (s:suahtakna) (b:suaktak) (r:ts:3168/zd:22877) (q:draft)
suaktatak = (i:1) (t:adv) (f:everyday/politics) (w:freely/at liberty) (d:<suakta>, be free, with <tak>, written as one word: freely, without hindrance; often {suaktatak in}) (j:suakta/tak) (r:zd:17383/zd:11712/ts:2189) (q:draft)
suaktathei = (i:1) (t:v) (f:everyday) (w:manage to escape/get away safely/survive) (d:<suakta> and <thei> written as one word: be able to get away, come out of an accident or attack alive or unhurt) (j:suakta/thei) (r:zd:20663/zd:13138) (q:draft)
suakthak = (i:1) (t:adj) (f:everyday/family) (w:newborn/newly arisen/new) (d:<suak>, be born or become, with <thak> new: newly born, as {naungek suakthak}, a newborn baby, or newly come into being) (j:suak/thak) (r:zd:19734/zd:25616) (q:draft)
sual = (i:1) (t:n) (f:home) (w:floor) (d:the floor of a house or room; {sual puan} is a rug spread on the floor) (a:innsun) (r:26.41.16) (q:draft)
sualtung = (i:1) (t:n) (f:home) (w:floor/surface of the floor) (d:<sual> and <tung> written as one word; {sualtung ah} is on the floor) (j:sual/tung) (r:zd:18020/zd:12723) (q:draft)
suamlup = (i:1) (t:v) (f:politics/media) (w:assassinate/attack and kill/murder) (d:form of <suamlum>, attack and kill, used before words such as <laitak>, <pen> and <khak>; {aki suamlup} is the one who was assassinated, {ki suamlupna} the assassination) (b:suamlum) (r:zd:19324/zd:15498) (q:draft)
suamlupna = (i:1) (t:n) (f:politics/media) (w:assassination/murder/killing) (d:<suamlup>, the form of <suamlum>, attack and kill, used before an ending, with the noun suffix <na>: the killing of a person by an attack, an assassination) (b:suamlum) (r:zd:11433/zd:12171) (q:draft)
suamlupsawm = (i:1) (t:v) (f:politics) (w:try to kill/attempt to assassinate) (d:<suamlup>, the form of <suamlum>, attack and kill, used before <sawm>, intend: try to kill; with <ki> before it, be the target of an attempt on one's life, or try to kill oneself) (b:suamlum) (r:zd:20653/zd:11821) (q:draft)
suamna = (i:1) (t:n) (f:politics/social) (w:attack/assault/raid) (d:<suam>, attack, with the noun suffix {-na}: an armed attack on people or a place; a dictionary also gives robbery) (b:suam) (r:zd:10798/zd:10727) (q:draft)
