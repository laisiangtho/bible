buhcim = (i:1) (t:n) (f:food/health) (w:rice porridge/congee/rice gruel) (d:rice boiled soft with much water, eaten plain by the sick or with beans and greens as a simple meal) (r:zd:25148/zd:11386) (q:draft)
buhkhuh = (i:1) (t:v) (f:health/body) (w:cough) (d:cough, also as a noun in {buhkhuh natna}, a coughing illness that spreads easily) (r:zd:23812/zd:12167) (q:draft, low confidence)
buhman = (i:1) (t:n) (f:food) (w:sticky rice/glutinous rice) (d:the sticky kind of <buh>, rice, cooked for feasts and for offerings to the dead and also made into cakes) (r:zd:25392/zd:24276) (q:draft, low confidence)
buhsih = (i:1) (t:n) (f:food) (w:cooked rice/rice) (d:rice cooked and eaten as the meal; named as good food, often together with chicken) (r:zd:20503/zd:11386/zd:24330) (q:draft)
bui = (i:2) (t:n) (c:animal) (f:nature) (w:bamboo rat) (d:a burrowing rodent that is dug out of the ground, the same as <buipi>; known from sayings such as {bui phak kuanin kitawp}, give up just before reaching the bamboo rat) (s:buipi) (r:zd:21939/zd:21415) (q:draft)
Building = (i:1) (t:n) (f:home/work) (w:building) (d:a large building, especially one of several storeys in a town; mostly written with a capital letter) (o:English) (r:zd:14301/zd:19470/zd:24897) (q:draft)
buipi = (i:1) (t:n) (c:animal) (f:nature) (w:bamboo rat/mole) (d:a large burrowing rodent; known from the saying {Buipi leikeei in zong khuangai}, even the bamboo rat digging the earth is mindful, a call to be careful) (r:zd:19520/zd:17327) (q:draft, low confidence)
buk = (i:3) (t:n) (f:home) (w:hut/booth/shed/shelter) (d:a small simple building or a closed room for one use, as {lo buk} field hut, {misi buk} mortuary and {zun buk} toilet; a noun, another spelling of <buuk>, not the verb {buk} hide) (s:buuk) (r:zd:23933/zd:23709/zd:11920) (q:draft)
bukhat = (i:1) (t:phrase) (f:education) (w:one book/one volume) (d:<bu>, the counting word for books, and <khat>, one, written as one word: one book, a single volume or copy) (j:bu/khat) (r:zd:17051/zd:15810/zd:17634) (q:draft)
bukhuh = (i:1) (t:n) (f:health) (w:cough/coughing) (d:a cough as a sign of illness, named with fever and difficulty in breathing; the second part is <khuh>, cough) (r:zd:23486/zd:23538) (q:draft)
bukim = (i:1) (t:adj) (f:everyday/religion) (w:complete/full/whole/perfect) (d:lacking nothing, placed after the noun: {damna bukim} is complete healing, {suahtakna bukim} full freedom; {bukim lo} is incomplete) (s:kicing) (r:zd:23780/zd:14765/zd:24459) (q:draft)
bukkhuh = (i:1) (t:n) (f:health) (w:cough/coughing) (d:a cough, and to cough; {bukkhuh natna} is a coughing illness) (r:zd:14706/zd:20640/zd:21370) (q:draft)
bukkhuhza = (i:1) (t:n) (f:health) (w:cough medicine/cough remedy) (d:<bukkhuh>, cough, with {-za}, medicine, as in <zatui>: medicine taken against a cough) (b:bukkhuh) (r:zd:21370/zd:17843) (q:draft)
Bukphil = (i:1) (t:name) (c:khua) (f:travel) (w:Bukphil) (d:a Zomi village; written in brackets after a person's name to show the home village) (r:zd:22074) (q:draft, low confidence)
buksan = (i:1) (t:v) (f:everyday) (w:hide from/take cover from) (d:<buk>, hide, with the ending {-san}, away from: hide oneself from someone, often after <ki>; compare <taisan>, run away from) (b:buk) (r:zd:13067/zd:10694) (q:draft)
buksung = (i:1) (t:phrase) (f:home/work) (w:inside the booth/inside the cabin) (d:<buk>, here a hut, booth, cubicle or cab, with <sung>, inside: the inside of a small room or shelter, as a toilet cubicle, a guard post or a driver's cab) (j:buk/sung) (r:zd:16617/zd:21248) (q:draft)
buksungah = (i:1) (t:adv) (f:home/travel) (w:inside the tent/inside the shelter) (d:<buk>, a hut, booth or tent, and <sungah>, inside, written as one word; {mawtaw buksungah} seems to be inside the cabin of a car) (j:buk/sungah) (r:zd:15274/zd:11729) (q:draft, low confidence)
bul = (i:2) (t:n) (f:time) (w:beginning/start) (d:the first part of a period of time, after <kum>, <kha> or a year or month name, often as {bul lamin}, at the beginning of, or {bul akipan}, from the beginning of; not the lower end of a thing) (r:zd:10912/ts:4806) (q:draft)
bulb = (i:1) (t:n) (f:home) (w:light bulb/bulb) (d:an electric light bulb, usually said as {mei bulb}) (o:English) (r:zd:22915/zd:19410) (q:draft)
bulbal = (i:1) (t:n) (f:nature/everyday) (w:root stock/base/basis/foundation) (d:the thick lower part of a plant, its root stock or tuber; of a statement, the ground on which it rests, as in {thu bulbal neilo}, without foundation) (r:zd:9133/zd:9125) (q:draft, low confidence)
bulhdan = (i:1) (t:n) (f:home/everyday) (w:way of putting on/way of wearing) (d:<bulh>, put on or fasten, with <dan>, way: how something is put on, said of shoes in {khedap bulhdan}) (j:bulh/dan) (r:zd:25919) (q:draft)
bulhlo = (i:1) (t:v) (f:home/everyday) (w:not put on/not wear) (d:<bulh> and <lo> written as one word: not put on or attach; {khedap bulhlo in} is without wearing shoes) (j:bulh/lo) (r:zd:14564/zd:11630) (q:draft)
bulhtuah = (i:1) (t:v) (f:everyday) (w:fit together/bring together/adapt/apply to) (d:<bulh>, fasten on, with <tuah>, join: set one thing against another so that they meet or fit, as knowledge with the Bible; of a gun, hold it right up to the target) (j:bulh/tuah) (r:zd:15941/zd:21859) (q:draft, low confidence)
bulin = (i:1) (t:adv) (f:time) (w:at the beginning of/at the start of) (d:<bul>, base or start, and <in> written as one word: {kum bulin} is at the beginning of the year) (j:bul/in) (r:zd:11279/ts:8010) (q:draft)
bullam = (i:1) (t:n) (f:everyday) (w:base/lower end/bottom part) (d:<bul>, base, with <lam>, side: the part toward the base of something, as the foot of a tree or branch) (j:bul/lam) (r:zd:24176) (q:draft, low confidence)
