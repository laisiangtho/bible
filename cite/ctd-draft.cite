lotgawpte = (i:1) (t:n) (w:those overthrown) (d:<lot> throw with <gawp>, violently, and plural <te>: the places that the Lord overthrew) (q:draft, low confidence)
lotkhiat = (i:1) (t:v) (w:sling out/hurl out/throw out) (d:<lot>, throw, with <khiat>, out: throw or sling something out, as a stone from a sling) (s:lawnkhia) (b:lot) (q:draft)
lotna = (i:1) (t:n) (w:throwing/slinging) (d:<lot> throw with the noun suffix <na>; {suang lotna} is a sling, the thing for throwing stones) (b:lot) (q:draft)
lotsak = (i:1) (t:v) (w:throw/cast) (d:<lot>, throw, with <sak>: throw something into a place, as idols into the fire) (s:lawn) (b:lot) (q:draft)
lotte = (i:1) (t:n) (w:things shot/arrows shot) (d:<lot> shoot, with the plural <te>: the ones that are shot, as {ka thaltang lotte}, the arrows I shoot) (b:lot) (q:draft)
lotthal = (t:todo) (r:23.1.7) (q:draft, one verse only, {theih ngei lohte’ lotthal bangin} answers to NIV as when overthrown by strangers, but whether the word means overthrow, raid or something else cannot be told)
lozaw = (i:1) (t:adv) (w:less/even less) (d:<lo>, not, with the comparative <zaw>: more so not; {a gina lozaw}, less good, inferior; {kilawm lozaw}, even less fitting) (b:lo) (q:draft)
lu = (i:1) (t:n) (w:head) (d:the head of a person or an animal; {lu tung} is the top of the head) (s:lutang)
lua = (i:1) (t:adv) (w:too/too much/excessively) (d:placed after a verb or adjective to show that something is more than is right or bearable; {lua-in} links it to what follows and {lua kei in} means do not overdo) (r:18.41.17) (q:draft)
lua = (i:2) (t:v) (w:vomit) (d:bring up from the stomach what was eaten or drunk) (s:luakhia) (q:draft)
luah = (i:1) (t:v) (w:inherit/possess/occupy) (d:take over land or property as an heir or new owner; {a zi luah} means take over the wife of a dead brother) (s:innluah) (r:41.12.21) (q:draft)
luah = (i:2) (t:n) (w:inheritance/heritage/possession) (d:what is received as an heir or as an allotted share, especially land; of the Levites it is said that the Lord is their {luah}) (s:gamh/luahna/gamhluah/gamluah) (r:6.19.41) (q:draft)
luahin = (i:1) (t:v) (w:inherit/possess/succeed to) (d:connective form of <luah>, inheriting or taking possession; {za luah} is to succeed someone in office) (b:luah) (q:draft)
luahkhawm = (i:1) (t:v) (w:inherit together/share the inheritance) (d:<luah> inherit with <khawm> together; {a luahkhawm mite} is fellow heirs) (b:luah) (q:draft)
