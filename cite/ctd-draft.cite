lasukin = (i:1) (t:v) (w:taking down) (d:<lasuk> take down, with the linking suffix <in>) (b:lasuk) (q:draft)
latal = (i:1) (t:n) (c:animal) (w:male donkey) (d:<la> donkey with <tal> male; the female is <lapi>) (a:lapi/lanu) (q:draft)
late = (i:1) (t:n) (c:animal) (w:donkeys/asses) (d:<la>, donkey, with the plural <te>) (s:laate) (b:la) (q:draft)
late = (i:2) (t:n) (w:songs) (d:<la>, song, with the plural <te>) (s:lasaknate) (b:la) (q:draft)
late = (i:3) (t:n) (w:reapers/harvesters) (d:those who take, <la> with the plural marker <te>; {an late} are those who take in the grain, the reapers, and {leitawi a late} are those who take a loan, borrowers) (s:anlate/atte) (b:la) (r:20.22.7) (q:draft)
lathei = (i:1) (t:v) (w:be able to take/can take) (d:<la> take, with <thei> be able) (b:la) (q:draft)
lathuah = (i:1) (t:v) (w:take more/take in addition) (d:<la> take with <thuah>, in addition, on top of what is already there) (q:draft)
Latin = (i:1) (t:name) (w:Latin) (d:the language of the Romans, one of the three languages of the notice on the cross of Jesus) (r:43.19.20)
lato = (i:1) (t:v) (w:take up/lift up/draw up) (d:<la>, take, with <to>, upward: take, lift or draw up) (s:lakto) (a:lasuk/laksuk) (b:la) (r:12.6.7) (q:draft)
latsak = (i:1) (t:v) (w:show/testify/make known) (d:make something seen; of honesty, speak for a person afterwards) (s:langsak) (q:draft, low confidence)
latsakna = (i:1) (t:n) (w:showing/making known) (d:<latsak> show, with the noun suffix <na>) (s:lahna/muhsakna) (b:latsak) (q:draft, low confidence)
lau = (i:2) (t:v) (w:fear/scare/be afraid) (d:feel fear of someone or of something that may happen; {lau kei in} and {lau kei un} are the commands do not be afraid) (s:kihta/kihtak)
laugawp = (i:1) (t:v) (w:be terrified/be greatly afraid) (d:<lau> fear with the intensifier <gawp>; with <sak>, terrify) (s:laulua/kihtalua) (b:lau) (q:draft)
laugawpsak = (i:1) (t:v) (w:frighten/terrify) (d:<laugawp> be terrified, with the causative <sak>) (s:lausakgawp/dipkuasak) (a:hehnem) (b:laugawp) (q:draft)
lauhlauh = (i:1) (t:adv) (d:descriptive word placed after <tuan>, ride, for the jolting and bouncing of a chariot being driven) (q:draft, low confidence)
lauhuai = (i:1) (t:adj) (w:dreadful/terrible/fearful/awesome) (d:<lau>, fear, with <huai>, causing: causing fear or awe, dreadful; of anger, fierce) (s:kihtakhuai/mulkimhuai/dipkuathuai) (a:lungmuanhuai) (q:draft)
lauhuaina = (i:1) (t:n) (w:terror/danger/dread) (d:<lauhuai>, dreadful or dangerous, with the noun suffix <na>: terror, or danger that threatens) (s:launa/kihtakna) (a:bitna/lungmuanna) (b:lauhuai) (r:45.8.35) (q:draft)
lauhuainate = (i:1) (t:n) (w:terrors/dangers) (d:<lauhuaina>, terror or danger, with the plural <te>) (s:launate) (b:lauhuaina) (q:draft)
lauhuaipi = (i:1) (t:adj) (w:fierce/most dreadful/terrible) (d:<lauhuai> dreadful with <pi>, great; said of anger) (b:lauhuai) (q:draft)
lauhuaite = (i:1) (t:adj) (w:terrible/fearsome/cruel/fierce) (d:<lauhuai> with plural <te>, after a noun: {mi lauhuaite} the cruel, {ganhing lauhuaite} fierce beasts) (s:kihtakhuaite) (b:lauhuai) (q:draft)
lauhuaizaw = (i:1) (t:adj) (w:more dreadful/more terrible/more severe) (d:<lauhuai> dreadful, with <zaw>, more) (b:lauhuai) (q:draft)
lauin = (i:1) (t:v) (w:being afraid/fearing) (d:<lau> fear, with the connective suffix <in>) (s:kihtakin) (b:lau) (q:draft)
laukawm = (i:1) (t:adv) (w:fearfully/afraid/in fear) (d:<lau> fear with <kawm> while: being afraid and something else at the same time, as {laukawm lingkawmin}, fearing and trembling, and {laukawm nuamkawmin}, afraid yet glad) (q:draft)
laukawmin = (i:1) (t:adv) (w:in fear/fearfully) (d:<laukawm> while being afraid, with the connective suffix <in>) (b:laukawm) (q:draft)
laulau = (i:1) (t:v) (w:dread/keep fearing) (d:<lau>, fear, said twice; {ka laulau} is the very thing I fear) (s:kihtaktak) (q:draft)
laulua = (i:1) (t:v) (w:be very afraid/be terrified) (d:<lau> fear with <lua>, too much, exceedingly) (s:laugawp/kihtalua/naklau) (b:lau) (q:draft)
laumai = (i:1) (t:v) (w:look afraid/show fear) (d:<lau>, fear, with <mai>, face: of the face, show fear) (q:draft)
launa = (i:1) (t:n) (w:fear/terror/dread) (d:<lau>, fear, with the noun suffix <na>: fear, dread or terror) (s:kihtakna/lauhuaina/patauhna) (a:lungmuanna/hanna) (b:lau) (q:draft)
Launa = (i:1) (t:n) (w:terror/fear) (d:<launa>, fear, written with a capital at the start of a sentence, and in the name {Mun khempeuhah Launa}, Terror on Every Side) (b:launa) (q:draft)
launate = (i:1) (t:n) (w:terrors/fears) (d:<launa>, fear, with the plural <te>; {sih ding launate} are the terrors of death) (s:lauhuainate) (b:launa) (q:draft)
laupa = (i:1) (t:n) (w:one who fears) (d:<lau> fear with <pa> marking a man: the man who is afraid) (b:lau) (q:draft)
laupih = (i:1) (t:v) (w:be afraid of/fear) (d:<lau>, fear, with <pih>: be afraid on account of someone or something) (s:kihta) (b:lau) (q:draft)
lausak = (i:1) (t:v) (w:frighten/terrify/make afraid) (d:<lau>, fear, with the causative <sak>: make someone afraid) (s:patausak/dipkuasak/laugawpsak) (a:hehnem/hangsak) (b:lau) (r:24.17.17) (q:draft)
lausakgawp = (i:1) (t:v) (w:terrify/frighten greatly) (d:<lausak>, frighten, with <gawp>, severely) (s:laugawpsak/lingsakgawp) (b:lausak) (q:draft)
lausakin = (i:1) (t:v) (w:frightening/terrifying) (d:<lausak> frighten with the linking ending <in>) (b:lausak) (q:draft)
