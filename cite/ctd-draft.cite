lialua = (i:1) (t:v) (w:be in an uproar/be greatly stirred) (d:in {luum lialua}, of a whole town astir with noise and excitement; perhaps <lia> with <lua>, exceedingly) (q:draft, low confidence)
lialuanate = (i:1) (t:n) (w:commotions/uproar) (d:in {gamlum lialuanate}, the loud commotion made on the hills; <lialua> with the noun suffix <na> and plural <te>) (b:lialua) (q:draft, low confidence)
