vutte = (i:1) (t:n) (w:ashes) (d:<vut>, ashes, with the plural <te>; English uses ashes) (s:vute) (b:vut) (r:4.4.13) (q:draft)
vuttui = (i:1) (t:n) (w:lye/soap) (d:<vut>, ashes, with <tui>, water: water run through ashes, used for washing) (s:satpiang) (q:draft)
vutvang = (i:1) (t:v) (w:bore a hole in/pierce) (d:<vut>, pierce, with <vang>, hole: make a hole through something, here the lid of a chest) (q:draft)
vuuk = (i:1) (t:n) (w:snow) (d:snow; a spelling with a long vowel of <vuk>) (s:vuk) (q:draft)
vuukpaak = (i:1) (t:n) (w:frost/hoarfrost) (d:spelling with long vowels of <vukpak>) (s:vukpak) (q:draft)
x = (t:todo) (q:draft, not a word: a stray mark in the text of Genesis 22:9 and 24:37)
z = (t:todo) (q:draft, not a word: the text has {Topa z} where the stone name Topaz is expected, a misprint)
za = (i:2) (t:n) (w:title/rank/office) (d:the title, rank or office held by a person; {a za lian} is of high rank) of position, job
za = (i:3) (t:num) (w:hundred) (d:the number hundred; {kum za} is a hundred years, and a smaller number is added with <leh>) (s:zakhat)
Za = (i:1) (t:num) (w:hundred) (d:<za>, hundred, written with a capital in the name {Mi Za Khat Tausang}, the Tower of the Hundred) (b:za) (q:draft)
Za = (i:2) (t:name) (d:first part of hyphenated Hebrew names: <Za-avan> is Zaavan, a man, and <Za-anannim> is Zaanannim, a place) (r:6.19.33) (q:draft)
za-anan = (t:todo) (q:draft, proper name Zaanan, a town in Micah 1:11, written {Za-anan} in the text; a name row needs the capitalised keyword)
