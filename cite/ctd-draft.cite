nilsuk = (t:v) (w:throw down/pour down/hurl down) (d:nil, throw, with suk, downward: throw or pour down into a lower place) (e:guam sungah ka ~ ding a) (s:lawnsuk) (b:nil) (r:33.1.6) (q:draft)
