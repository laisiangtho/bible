gawh = (i:1) (t:v) (w:slaughter/kill) (d:kill an animal for food or sacrifice; form of <go> used before <ding>, <hun> and similar words) (r:38.11.4) (q:draft)
gawhna = (i:1) (t:n) (w:slaughtering/slaughter/killing) (d:<gawh>, slaughter, with the noun suffix <na>: the killing of an animal for food or sacrifice; {a gawhna mun} is the place where it is slaughtered) (b:gawh) (q:draft)
gawhnate = (i:1) (t:n) (w:sacrifices/slaughterings) (d:<gawh>, slaughter, with the noun suffix <na> and the plural <te>; {gan gawhnate} is animal sacrifices) (b:gawhna) (q:draft)
gawhsak = (i:1) (t:v) (w:slaughter for/kill for) (d:<gawh>, slaughter, with <sak>, here doing it for someone: kill an animal to feed a guest) (b:gawh) (q:draft)
gawi = (i:1) (t:v) (w:grind/gnash/gnaw) (d:crush between stones or between the teeth; {an gawi} grind grain, {ha gawi} gnash the teeth) (q:draft)
gawigawi = (t:see) <gawigawi-a>
gawigawi-a = (i:1) (t:v) (w:gnashing/grinding) (d:doubled form of <gawi>, gnash, with the linking <a>: {ha gawigawi} is keep gnashing the teeth) (q:draft)
gawigawi-in = (i:1) (t:v) (w:gnashing/grinding) (d:doubled form of <gawi>, gnash, with the linking suffix <in>: {ha gawigawi} is keep gnashing the teeth) (q:draft)
gawigawp = (i:1) (t:v) (w:thresh/crush) (d:<gawi>, grind, with <gawp>, severely: grind down utterly) (s:sugawp) (b:gawi) (q:draft)
gawina = (i:1) (t:n) (w:grinding/gnashing) (d:<gawi>, grind or gnash, with the noun suffix <na>: {an gawina suang} is a millstone, and {ha gawina} is gnashing of teeth) (b:gawi) (q:draft)
gawisan = (i:1) (t:v) (w:gnash/grind) (d:with <ha>, tooth: grind the teeth at someone in anger) (b:gawi) (q:draft)
gawisanin = (i:1) (t:v) (w:gnashing at) (d:<gawisan>, gnash the teeth at someone, with the linking suffix <in>) (b:gawisan) (q:draft)
gawivui = (i:1) (t:v) (w:grind to powder/crush to dust/pulverize) (d:<gawi>, grind, with <vui>, dust: grind something until it is powder) (s:satvui/suvui) (q:draft)
gawizan = (i:1) (t:v) (w:crush/grind/thresh/trample) (d:crush or tread something until it is broken small, as grain is threshed or grapes are trodden) (q:draft)
gawizansak = (i:1) (t:v) (w:trample/crush) (d:<gawizan>, crush or tread, with the causative <sak>) (b:gawizan) (q:draft)
gawl = (i:1) (t:n) (w:neck/throat) (d:the neck or throat; {gawl meek} is to choke or strangle) (s:ngawng/gawlgui) (q:draft)
gawl = (i:2) (t:n) (w:fence/wall) (d:a fence or wall round a field or yard; {gawl sung} is the space inside it, a court) (s:daai/daigawl) (q:draft)
gawlgui = (i:1) (t:n) (w:throat) (d:the throat, the passage inside the neck for breath, voice and food) (s:gawl) (q:draft)
gawlin = (i:1) (t:n) (w:with a fence/with a hedge) (d:<gawl>, fence, with the marker <in>, by means of: {gawlin um} is enclose with a fence) (b:gawl) (q:draft)
gawlin = (i:2) (t:n) (w:by the throat/by the neck) (d:<gawl>, throat or neck, with the marker <in>: {a gawlin man} is seize him by the throat) (b:gawl) (q:draft, low confidence)
gawlmek = (i:1) (t:v) (w:strangle/choke) (d:<gawl>, throat, with <mek>, squeeze; {gawlmek a kigo sa} is the meat of a strangled animal) (q:draft)
gawlzawhna = (i:1) (t:n) (w:victory) (d:apparently another spelling of <gualzawhna>, victory) (s:gualzawhna/galzawhna) (a:guallelhna) (q:draft, low confidence)
gawm = (i:1) (t:v) (w:join/combine/blend/add together) (d:put things together into one: join forces, blend ingredients, add up a number; {gawm khawm} is join together) (a:khen) (q:draft)
gawmin = (i:1) (t:v) (w:joining/combining/putting together) (d:<gawm>, join or combine, with the linking ending <in>; often rendered together or all together) (a:khenin) (b:gawm) (q:draft)
gawmkik = (i:1) (t:v) (w:join again/reunite) (d:<gawm>, join, with <kik>, again or back: make into one again) (b:gawm) (q:draft)
gawmsa = (i:1) (t:adj) (w:joined/joined together) (d:<gawm>, join, with <sa>, already done: what has been joined) (b:gawm) (q:draft)
gawng = (i:1) (t:adj) (w:lean/thin/gaunt) (d:thin from lack of flesh, said of animals and of a wasted body) (a:thau) (q:draft)
gawngin = (i:1) (t:adj) (w:lean/wasted) (d:<gawng>, thin and wasted, with the linking suffix <in>) (b:gawng) (q:draft)
gawngte = (i:1) (t:adj) (w:lean/thin) (d:<gawng>, lean, with the plural <te>: the lean ones, as in {tuu gawngte}, lean sheep) (a:thaute) (b:gawng) (q:draft)
gawp = (i:1) (t:part) (d:placed after a verb to show that the action is done severely or completely, to the point of ruin) (q:draft)
gawpgawp = (i:1) (t:part) (w:severely/harshly) (d:placed after a verb to show that the action is done severely and again and again; {hih gawpgawp} is to treat harshly, to oppress) (b:gawp) (q:draft)
gawpgawpna = (i:1) (t:n) (w:harshness/ruthlessness/rigour) (d:severe treatment; {hih gawpgawpna tawh uk} means rule over someone ruthlessly) (b:gawpgawp) (q:draft)
gawpgawpnate = (i:1) (t:n) (w:harsh acts/severities) (d:<gawpgawp>, severely and again and again, with the noun suffix <na> and the plural <te>; {tawn’ gawpgawpnate} is harsh threats) (b:gawpgawpna) (q:draft, low confidence)
gawpin = (i:1) (t:part) (w:utterly/severely) (d:<gawp>, severely, with the linking suffix <in>: placed after a verb to show that the action is done violently, thoroughly or to destruction) (b:gawp) (q:draft)
gawpmang = (i:1) (t:part) (w:utterly/completely) (d:placed after a verb: <gawp>, severely, with <mang>, away or to nothing, as in {susia gawpmang} destroy utterly) (q:draft)
gawpna = (i:1) (t:part) (d:<gawp>, severely, with the noun suffix <na>: placed after a verb, it makes a noun for an action done severely or thoroughly, as {siat gawpna}, utter ruin, and {tuatcil gawpna}, trampling) (b:gawp) (q:draft)
gawpnate = (i:1) (t:part) (d:<gawpna> with plural <te>, placed after a verb: makes a plural noun for the results of a severe action; {satnim gawpnate} are bruises from heavy blows) (b:gawpna) (q:draft)
gawppa = (i:1) (t:part) (d:the particle <gawp>, severely, with <pa>, the man who: after a verb, the one who does it thoroughly; {a sut gawppa} is the plunderer) (b:gawp) (q:draft)
gawpsa = (t:see) <gawpsa-in>
gawpsa-in = (i:1) (t:part) (d:placed after a verb: <gawp>, severely, with <sa>, already done, and the linking suffix <in>: having done the action severely, as in {kikui gawpsa-in} having gashed themselves) (q:draft)
gawpsak = (i:1) (t:part) (d:placed after a verb: <gawp>, severely or utterly, with the causative <sak>, so that the action is done or caused to be done to the point of ruin, as in {cim gawpsak} demolish) (b:gawp) (q:draft)
gawpsakin = (i:1) (t:part) (d:<gawpsak>, placed after a verb for an action done or caused severely, with the linking suffix <in>) (b:gawpsak) (q:draft)
gawpsate = (i:1) (t:part) (d:placed after a verb: <gawp>, utterly, with <sa>, already done, and the plural <te>: the ones that have been utterly so, as in {a sia gawpsate} the things that are ruined) (q:draft, low confidence)
gawpta = (i:1) (t:part) (d:<gawp>, placed after a verb for an action done severely or completely, with <ta>, now or already, as in {kitan gawpta} is now shattered) (b:gawp) (q:draft)
gawpte = (i:1) (t:part) (d:<gawp>, which shows an action done severely, with the plural <te>: those who do, or who suffer, the action thoroughly, as in {luh gawpte}, plunderers) (b:gawp) (q:draft)
gawpzo = (i:1) (t:part) (d:<gawp>, placed after a verb for an action done severely or completely, with <zo>, be able, as in {thalnial gawpzo} be able to demolish) (b:gawp) (q:draft)
gawsem = (i:1) (t:n) (w:harp) (d:a musical instrument, rendered harp in Revelation, where <tamngai> is the pipe; {gawsem tumte} is those who play it; in everyday use perhaps the gourd mouth organ, a wind instrument) (q:draft, low confidence)
gawsemte = (i:1) (t:n) (w:harps/pipes) (d:plural of <gawsem>, a musical instrument; used for the harps of Revelation and for the pipes of Daniel 3:5) (b:gawsem) (q:draft, low confidence)
gawt = (i:1) (t:v) (w:afflict/oppress/mistreat/punish) (d:lay a heavy hand on someone: treat harshly, afflict or punish; {gawt bawl} is to mistreat a person) (s:gimsak/bawlsia/nengniam) (q:draft)
gawtbawl = (i:1) (t:v) (w:mistreat/treat harshly) (d:<gawt>, afflict, with <bawl>, do: treat someone harshly) (s:gimbawl/bawlsia) (b:gawt) (q:draft)
gawtin = (i:1) (t:v) (w:afflicting/punishing) (d:<gawt>, afflict, with the linking suffix <in>) (s:gimsakin) (b:gawt) (q:draft)
gawtna = (i:1) (t:n) (w:punishment/affliction) (d:<gawt> afflict with the noun suffix <na>: the heavy hand laid on someone) (s:gimpiakna/daantatna) (b:gawt) (q:draft)
Gaza = (i:1) (t:name) (c:land) (w:Gaza) (d:Philistine city on the coast in the south-west of Canaan, one of the five chief cities of the Philistines) (r:7.1.18/30.1.7)
Gazez = (i:1) (t:name) (c:male) (w:Gazez) (d:name of two men in the family of Caleb: a son of Caleb by his concubine Ephah, and a son of Haran) (r:13.2.46)
Gazzam = (i:1) (t:name) (c:male) (w:Gazzam) (d:ancestor of a family of temple servants who returned from the exile) (r:16.7.51)
Gazzan = (i:1) (t:name) (c:male) (w:Gazzam) (d:spelling of <Gazzam> in Ezra 2:48, ancestor of a family of temple servants who returned from the exile) (r:15.2.48)
Ge = (t:see) <Ge-uel>
Ge-uel = (i:1) (t:name) (c:male) (w:Geuel) (d:son of Maki, the man of the tribe of Gad sent by Moses to explore Canaan) (q:draft)
Geba = (i:1) (t:name) (c:city) (w:Geba) (d:town of the tribe of Benjamin north of Jerusalem, given to the Levites) (r:16.11.31) (q:draft)
Gebal = (i:1) (t:name) (c:place) (w:Gebal/Byblos) (d:Phoenician port city north of Sidon, called Byblos in the NIV, known for its builders and shipwrights) (r:6.13.5/11.5.18)
Gebeah = (i:1) (t:name) (c:place) (w:Gibeah) (d:spelling of <Gibeah> in 1 Samuel 14:2, the town of Saul in Benjamin) (r:9.14.2)
geber = (t:see) <Ezion-geber>
Geber = (i:1) (t:name) (c:male) (w:Geber) (d:son of Uri, governor of King Solomon in the land of Gilead) (q:draft)
Gebim = (i:1) (t:name) (c:city) (w:Gebim) (d:place north of Jerusalem whose people fled before the Assyrian advance in Isaiah 10) (r:23.10.31)
Gedaliah = (i:1) (t:name) (c:male) (w:Gedaliah) (d:name of several men, chiefly the son of Ahikam whom Nebuchadnezzar made governor of Judah and whom Ishmael killed at Mizpah) (r:12.25.22/24.41.3)
Gedeliah = (i:1) (t:name) (c:male) (w:Gedaliah) (d:spelling of <Gedaliah> in Jeremiah 39:14, the son of Ahikam to whose care Jeremiah was given) (r:24.39.14)
Geder = (i:1) (t:name) (c:place) (w:Geder) (d:Canaanite royal town whose king was defeated by Joshua) (r:6.12.13)
Gederah = (i:1) (t:name) (c:land) (w:Gederah) (d:town in the western foothills of Judah) (r:6.15.36/13.4.23)
Gederoh = (i:1) (t:name) (c:city) (w:Gederoth) (d:spelling of <Gederoth> in 2 Chronicles 28:18, a town in the foothills of Judah taken by the Philistines) (r:14.28.18)
Gederoth = (i:1) (t:name) (c:city) (w:Gederoth) (d:town in the western foothills of Judah, taken by the Philistines in the time of King Ahaz) (r:14.28.18) (q:draft)
Gederothaim = (i:1) (t:name) (c:land) (w:Gederothaim) (d:town in the western foothills of Judah, listed next to Gederah) (r:6.15.36)
gedi = (t:see) <En-gedi>
Gedor = (i:1) (t:name) (c:land) (w:Gedor) (d:name of a town in the hill country of Judah and of several men, among them a Benjamite son of Jeiel) (r:6.15.58)
geel = (i:1) (t:v) (w:plan/devise/design) (d:think out beforehand what is to be done or made) (s:ngim) (q:draft)
geelgeel = (i:1) (t:v) (w:devise/plot/ponder/meditate) (d:doubled form of <geel>, plan: keep planning or turning something over in the mind) (s:gelgel/ngaihsunsun/lungngaingai) (q:draft)
geelgeelin = (i:1) (t:v) (w:pondering/meditating) (d:form of <geelgeel> with the linking suffix <in>; {lung geelgeelin} is turning something over in the heart) (b:geelgeel) (q:draft)
geelgeelna = (i:1) (t:n) (w:careful planning/planning) (d:<geelgeel>, keep planning, with the noun suffix <na>) (b:geelgeel) (q:draft)
geelgeelte = (i:1) (t:n) (w:plotters/those who devise) (d:<geelgeel> keep planning with plural <te>: the people who keep plotting something) (s:sawmsimte/geelte) (b:geelgeel) (q:draft)
geelin = (i:1) (t:v) (w:planning/designing/devising) (d:<geel>, plan, with the linking suffix {-in}: planning something and then doing it) (b:geel) (q:draft)
geelkholh = (i:1) (t:v) (w:plan beforehand/prepare in advance) (d:<geel>, plan, with <kholh>, beforehand) (q:draft)
geelkholhsa = (i:1) (t:v) (w:planned beforehand/prepared in advance/prescribed) (d:<geelkholh>, plan ahead, with <sa> marking a completed action) (b:geelkholh) (q:draft)
geelna = (i:1) (t:n) (w:plan/purpose/counsel/design) (d:<geel>, plan, with the noun suffix <na>: what someone has planned or intends to do; {biakinn geelna} is the design of the temple) (s:ngimna/vaihawmna/gelna) (b:geel) (q:draft)
geelnasa = (i:1) (t:n) (w:purpose/plan already made) (d:<geelna>, plan, with <sa>, already done: what has been planned) (s:ngaihsutsa) (b:geelna) (q:draft)
geelnate = (i:1) (t:n) (w:plans/purposes) (d:plural of <geelna>: things that have been planned) (s:ngimnate/vaihawmnate/geelsate) (b:geelna) (q:draft)
geelpa = (i:1) (t:n) (w:planner/one who planned) (d:<geel>, plan, with <pa> marking a man: the one who planned it) (s:vaihawmpa) (b:geel) (q:draft)
geelsa = (i:1) (t:adj) (w:planned/purposed/designed) (d:<geel> plan with <sa> already done; also what has been planned, a plan) (s:vaihawmsa) (b:geel) (q:draft)
geelsate = (i:1) (t:n) (w:plans/purposes/things planned) (d:<geelsa> planned with plural <te>: what someone has planned or decreed) (s:geelnate) (b:geelsa) (q:draft)
geelsiam = (i:1) (t:adj) (w:skilled in design) (d:<geel> design with <siam> skilled; {geelsiam nasep} is the work of a designer or skilled craftsman) (q:draft)
geelsim = (i:1) (t:v) (w:plan in secret) (d:<geel>, plan, with <sim>, secretly; {a geelsim thute} is the things he planned in secret) (q:draft, low confidence)
geeltawm = (i:1) (t:v) (w:make up/devise oneself) (d:<geel>, plan, with <tawm>, on one's own: think something up out of one's own mind) (s:geltawm/phuahtawm) (q:draft)
geelte = (i:1) (t:n) (w:those who plan/plotters) (d:<geel>, plan, with plural <te>: those who plan something; {siat nading a geelte}, those who planned the destruction) (s:geelgeelte/sawmsimte) (b:geel) (q:draft)
geelte = (i:2) (t:n) (w:plans/things planned) (d:<geel>, plan, with plural <te>: what someone has planned) (s:geelnate/geelsate) (b:geel) (q:draft, low confidence)
geeltheih = (i:1) (t:v) (w:be able to plan/be able to direct) (d:<geel>, plan, with <theih>, be able) (b:geel) (q:draft)
gega = (i:1) (t:adv) (w:staring/fixedly) (d:placed after <en>, look, or <sal>: with a fixed wide-open stare; {mit san gega} is eyes glaring red) (q:draft)
gegupi = (t:see) <gegupi-in>
gegupi-in = (i:1) (t:adv) (w:full well/clearly) (d:after <thei>, know: knowing full well; the meaning rests on one verse) (q:draft, low confidence)
geh = (i:1) (t:n) (w:eunuch) (d:a castrated man; {geh bang}, like a eunuch) (q:draft, low confidence)
Geharashim = (i:1) (t:name) (c:city) (w:Ge Harashim) (d:valley and settlement of craftsmen in Judah, founded by Joab son of Seraiah and later lived in by Benjamites; the name means valley of craftsmen) (r:13.4.14/16.11.35)
Gehazi = (i:1) (t:name) (c:male) (w:Gehazi) (d:servant of the prophet Elisha, struck with leprosy for his greed) (r:12.4.12/12.8.4)
gehsa = (i:1) (t:n) (w:eunuch) (d:<geh>, eunuch, with <sa>, already: one who is already a eunuch, here from birth) (b:geh) (q:draft, low confidence)
gehsate = (i:1) (t:n) (w:steers/castrated animals) (d:<gehsa> castrated with plural <te>; {bawngtalno gehsate} are young bulls that have been castrated, where the NIV has bull calves) (b:gehsa) (q:draft, low confidence)
gei = (i:1) (t:n) (w:side/edge/shore) (d:the place beside something; <gei-ah>, beside, near, by) (s:pang/nawl/mong) (r:26.27.28) (q:draft)
geiah = (i:1) (t:prep) (w:beside/by/at the edge of/on the shore of) (d:<gei> side or edge with the place marker <ah>; follows the noun, as in {tui geiah}, {lam geiah}) (s:panga/nawlah/kianga) (b:gei) (q:draft)
geihuai = (i:1) (t:n) (w:molding/border) (d:a raised edging made round the rim of the table) (s:geihual) (q:draft, low confidence)
geihual = (i:1) (t:n) (w:molding/rim/edging/border) (d:a raised band made around the edge of an object) (s:geivial/geihuai) (q:draft)
geihualte = (i:1) (t:n) (w:rims/ledges/borders) (d:plural of <geihual>: the raised edges that run round the altar) (b:geihual) (q:draft)
geinai = (i:1) (t:n) (w:near/close by) (d:<gei>, side, with <nai>, near: the place close beside someone) (q:draft)
geite = (i:1) (t:n) (w:banks/sides/edges) (d:<gei> side with the plural <te>; {lui geite} is the banks of the streams) (s:pangte) (b:gei) (q:draft)
geiteng = (i:1) (t:n) (w:shorelands/shores/coasts) (d:<gei>, shore, with <teng>, all: all the shore) (b:gei) (q:draft)
geivial = (i:1) (t:n) (w:rim/brim/edge) (d:the edge running round the top of a cup, a basin or an altar) (s:geihual) (r:14.4.5) (q:draft)
gel = (i:1) (t:det) (w:both/the two) (d:placed after a noun or pronoun for two together: both of them, the two) (q:draft)
gel = (i:2) (t:v) (w:write) (d:write down; a rare shorter form of <gelh>, found in one verse) (s:gelh/at) (q:draft, low confidence)
gelgel = (i:1) (t:v) (w:plot/devise/scheme) (d:doubled form of <geel>, plan, in a shorter spelling: keep thinking out, in the verses always of evil) (s:geelgeel) (q:draft)
gelhbehsak = (i:1) (t:v) (w:have added in writing/add in writing) (d:<gelh>, write, with <beh>, in addition, and the causative <sak>) (q:draft)
gelhin = (i:1) (t:v) (w:writing/writing down) (d:form of <gelh> with the linking ending <in>, used before a following verb) (b:gelh) (q:draft)
gelhinah = (i:1) (t:v) (w:write) (d:<gelhin> with <ah>, introducing the words that were written: wrote as follows) (b:gelhin) (q:draft)
gelhkhiat = (i:1) (t:v) (w:write out/write down) (d:<gelh>, write, with <khiat>, out; the form used before <ding>) (b:gelh) (q:draft)
gelhkholhsa = (i:1) (t:v) (w:written beforehand/written about in advance) (d:<gelh>, write, with <kholh>, beforehand, and <sa>, already done) (q:draft)
gelhkik = (i:1) (t:v) (w:write again/rewrite) (d:<gelh>, write, with <kik>, again) (s:atkik) (b:gelh) (q:draft)
gelhna = (i:1) (t:n) (w:writing/what is written) (d:<gelh>, write, with the noun suffix <na>: something written, a writing; {gelhna lai} is the writings of someone) (s:laigelhna/kigelhna) (b:gelh) (q:draft)
gelhna = (i:2) (t:n) (w:seal/signet/engraving) (d:in {min gelhna}, a thing with a name cut into it: seal, signet) (s:minthuhna/ciamtehna) (b:gelh) (q:draft)
gelhnate = (i:1) (t:n) (w:writings/letters) (d:<gelhna> with plural <te>: the things someone has written) (s:laigelhnate) (b:gelhna) (q:draft)
gelhnate = (i:2) (t:n) (w:engravings/seals) (d:<gelhna> with plural <te>; {min gelhnate} are engraved names, as on a seal) (b:gelhna) (q:draft)
gelhnop = (i:1) (t:v) (w:want to write) (d:<gelh>, write, with <nop>, wish) (q:draft)
gelhpa = (i:1) (t:n) (w:writer) (d:<gelh>, write, with <pa> for a man: the one who wrote) (b:gelh) (q:draft)
gelhsa = (i:1) (t:adj) (w:written) (d:already written; what someone has written, <gelh> with <sa> for a finished action) (s:kigelhsa) (b:gelh) (q:draft)
gelhsak = (i:1) (t:v) (w:have written/cause to write/write for) (d:<gelh> write with <sak>: have something written, or write it for someone) (b:gelh) (q:draft)
gelhsakin = (i:1) (t:v) (w:have written/cause to write) (d:form of <gelhsak> with the linking suffix <in>, having something written and then going on to the next action) (b:gelhsak) (q:draft)
gelhte = (i:1) (t:n) (w:those who write/writers) (d:<gelh>, write, with plural <te>: those who write something) (s:laigelhte/atte) (b:gelh) (q:draft)
gelhte = (i:2) (t:n) (w:things written/what is written) (d:<gelh>, write, with plural <te>: the things that someone writes) (b:gelh) (q:draft)
gelhzawk = (i:1) (t:v) (w:write instead/rather write) (d:<gelh>, write, with <zawk>, rather; the form used before <ding>) (q:draft)
Geliloth = (i:1) (t:name) (c:place) (w:Geliloth) (d:place on the border between Judah and Benjamin, facing the Pass of Adummim) (r:6.18.17)
gelkhia = (i:1) (t:v) (w:slip away/slip out/steal out) (d:go out unnoticed, with <khia>, out) (s:taikhiasim) (q:draft, low confidence)
gelna = (i:1) (t:n) (w:plan/plot/purpose) (d:shorter spelling of <geelna>, what someone has planned; paired with <ngimna>, aim) (s:geelna/ngimna) (q:draft)
gelsim = (i:1) (t:v) (w:steal away/sneak/slink) (d:move stealthily so as not to be seen, with <sim>, secretly) (q:draft, low confidence)
geltawm = (i:1) (t:v) (w:make up/invent/imagine) (d:think something up by oneself, of things devised in one's own mind) (s:phuahtawm/geeltawm) (q:draft)
Gemalli = (i:1) (t:name) (c:male) (w:Gemalli) (d:father of Ammiel, the man from the tribe of Dan sent to spy out Canaan) (r:4.13.12)
Gemariah = (i:1) (t:name) (c:male) (w:Gemariah) (d:name of two men in Jeremiah: a son of Shaphan the secretary, who urged the king not to burn the scroll, and a son of Hilkiah sent to Babylon by Zedekiah) (r:24.36.11/24.36.25)
gen = (i:2) (t:v) (w:inform) (d:tell someone a piece of news or report it to them, with <kiangah> for the person told) (s:zasak/theihsak)
genbaang = (i:1) (t:v) (w:blame) (d:find fault with someone in words; {genbaang lo} is blameless, with nothing to be blamed for) (s:paubaang)
genbeh = (i:1) (t:v) (w:say in addition/testify further/add) (d:<gen>, say, with <beh>, in addition) (s:genthuah) (q:draft)
genbelin = (i:1) (t:adv) (w:as the subject of speech) (d:always with <nei>, have: {genbelin nei} is have something as the matter one keeps speaking about, speak of, testify to) (q:draft, low confidence)
gendai = (i:1) (t:v) (w:slander/revile/blaspheme) (d:speak evil of someone; {gendai-mawhna} is the sin of speaking against God, blasphemy) (s:gensia/kosia) (a:phat) (q:draft)
gendaina = (i:1) (t:n) (w:slander/reviling) (d:<gendai> with the noun suffix <na>) (s:gensiatna) (a:phatna) (b:gendai) (q:draft)
gengen = (i:1) (t:v) (w:mention/tell again and again/proclaim) (d:<gen>, say, doubled: speak of something repeatedly, keep telling or proclaiming it) (b:gen)
gengenin = (i:1) (t:v) (w:keep talking/talk on and on) (d:<gen>, say, doubled and with the linking suffix {-in}: saying again and again, at length) (s:paupau) (b:gengen) (q:draft)
gengenna = (i:1) (t:n) (w:words/talk) (d:<gengen>, say repeatedly, with the noun suffix <na>: what one keeps saying) (b:gengen) (q:draft)
genhak = (i:1) (t:adj) (w:obstinate/stubborn/hard) (d:<gen>, speak, with <hak>, difficult: hard to speak to or reason with) (s:lungkhauh) (q:draft)
genhuaina = (i:1) (t:n) (w:cause for complaint/something to object to) (d:something that deserves to be spoken about; in the verse a question, is there anything to object to) (q:draft, low confidence)
genin = (i:1) (t:v) (w:tell/speak/say) (d:form of <gen> with the linking suffix <in>, telling or speaking and then going on to the next action) (b:gen) (r:19.145.11) (q:draft)
geninah = (i:1) (t:v) (w:say/tell/speak) (d:<gen>, say, with <inah>, the ending that introduces the words that follow: says as follows, speaking thus) (s:cihinah) (q:draft)
genkha = (i:1) (t:v) (w:say/happen to say) (d:<gen>, say, with <kha>, which marks something one comes to do, often without meaning to or wrongly) (s:cikha) (q:draft, low confidence)
genkhak = (i:1) (t:v) (w:happen to say/say) (d:form of <genkha>, <gen> say with <kha>, come to do, used before <loh>, {uh leh} and the like) (b:genkha) (q:draft)
genkhawm = (i:1) (t:v) (w:talk together/converse) (d:<gen>, speak, with <khawm>, together) (s:kiho/kihokhawm) (b:gen) (q:draft)
genkhawmin = (i:1) (t:v) (w:talk together/discuss) (d:<genkhawm> with the linking ending <in>, used before a following verb) (b:genkhawm) (q:draft)
genkhia = (i:1) (t:v) (w:declare/proclaim/speak out/utter) (d:<gen>, say, with <khia>, out) (s:pulak/tangko) (b:gen) (r:11.4.32) (q:draft)
genkhiat = (i:1) (t:v) (w:tell/declare/speak out/pronounce) (d:<gen> speak with <khiat>, out; form of <genkhia> used before another word such as <ding>, <theih> or a noun) (b:genkhia) (q:draft)
genkhiate = (i:1) (t:n) (w:those who declare/those who acknowledge) (d:<genkhia>, declare, with the plural <te>: the ones who speak it out) (b:genkhia) (q:draft)
genkhiatna = (i:1) (t:n) (w:proclaiming/speaking out/declaration) (d:<genkhiat> speak out with the noun suffix <na>) (s:pulakna) (b:genkhiat) (q:draft)
genkhiatsawn = (i:1) (t:v) (w:tell to others/pass on/relate) (d:<genkhiat>, speak out, with <sawn>, on to others) (s:gensawn) (q:draft)
genkhin = (i:1) (t:v) (w:have told/have spoken) (d:<gen>, tell, with <khin>, already or completely: the telling is finished) (s:genzo) (b:gen) (r:23.24.3) (q:draft)
genkhit = (i:1) (t:v) (w:finish saying/have said) (d:<gen>, say, with <khit>, finished, mostly in {a genkhit ciangin}, after he had said) (s:cihkhit) (q:draft)
genkhol = (i:1) (t:v) (w:foretell/prophesy/tell beforehand) (d:<gen>, tell, with <khol>, beforehand: tell a thing before it happens, prophesy) (s:hilhkhol) (r:44.3.24) (q:draft)
genkholh = (i:1) (t:v) (w:foretell/tell beforehand/promise) (d:form of <genkhol> used before a noun or in a dependent clause, what was said beforehand) (s:hilhkholh) (b:genkhol) (q:draft)
genkholhna = (i:1) (t:n) (w:prophecy/prediction/divination) (d:telling a thing beforehand) (s:thugenkholhna) (b:genkholh) (r:54.4.14) (q:draft)
genkholhnate = (i:1) (t:n) (w:prophecies/predictions/visions) (d:<genkholhna>, a thing told beforehand, with plural <te>; also of warnings and threats made in advance) (b:genkholhna) (q:draft)
genkholhsa = (i:1) (t:v) (w:foretold/said beforehand) (d:<genkholh>, tell beforehand, with <sa>, already done: {a genkholhsa bangin} is as he had foretold) (b:genkholh) (q:draft)
genkholhsakna = (i:1) (t:n) (w:prophecy/foretelling) (d:<genkholh>, foretell, with the causative <sak> and the noun suffix <na>: what was caused to be spoken beforehand) (s:genkholhna) (q:draft)
genkholin = (i:1) (t:v) (w:prophesying/foretelling) (d:<genkhol> with the linking suffix <in>; {thu genkholin}, prophesying) (b:genkhol) (q:draft)
genkholkhin = (i:1) (t:v) (w:have already told beforehand/have foretold) (d:<genkhol>, tell beforehand, with <khin>, already done) (s:genkholzo) (b:genkhol) (q:draft)
genkholpa = (i:1) (t:n) (w:foreteller/one who foretold) (d:<genkhol>, foretell, with <pa> for a man: the one who told it beforehand) (b:genkhol) (q:draft)
genkholzo = (i:1) (t:v) (w:have foretold/have prophesied) (d:<genkhol>, foretell, with <zo> for a completed action) (s:genkholkhin) (b:genkhol) (q:draft)
genkik = (i:1) (t:v) (w:say again/speak again/repeat/report back) (d:<gen> with <kik> again; also to go on speaking) (s:cikik/genpha) (b:gen) (q:draft)
genkikin = (t:see) <genkikin-ah>
genkikin-ah = (i:1) (t:v) (w:say again/repeat/tell again) (d:<gen>, say, with <kik>, again, and the ending {in-ah} that introduces the words spoken: I say again as follows) (q:draft)
genlo = (i:1) (t:v) (w:not tell/not speak) (d:<gen>, tell, with <lo>, not) (b:gen) (q:draft)
genloh = (i:1) (t:v) (w:not tell/not speak) (d:form of <genlo> used before <nading>: so as not to speak) (b:genlo) (q:draft)
genmun = (i:1) (t:v) (w:speak often) (d:<gen>, speak, with <mun>; in the verse negated with <lo>, did not speak much, seldom spoke) (q:draft, low confidence)
genna = (i:1) (t:n) (w:saying/speaking/statement/testimony) (d:what is said or the act of saying it; {thu genna}, testimony) (s:thugenna/cihna) (b:gen) (r:5.17.6) (q:draft)
gennasa = (i:1) (t:v) (w:told/spoken of) (d:<genna> with <sa>, already done: that has been told before, as the place God had told of) (b:genna) (q:draft)
gennate = (i:1) (t:n) (w:words/sayings/things said) (d:plural of <genna>; what someone has said) (s:thugente/kammalte) (b:genna) (q:draft)
Gennesaret = (i:1) (t:name) (c:place) (w:Gennesaret) (d:fertile plain on the north-west shore of the Sea of Galilee; the Lake of Gennesaret is another name for that sea) (r:40.14.34/42.5.1)
Gennesareth = (i:1) (t:name) (c:land) (w:Gennesaret) (d:spelling of <Gennesaret>, the plain on the north-west shore of the Sea of Galilee) (r:41.6.53)
gennop = (i:1) (t:v) (w:want to say/mean) (d:<gen>, say, with <nop>, wish; {gennop thu} is what someone wants to say or means) (s:gennuam/cihnop) (q:draft)
gennopna = (i:1) (t:n) (w:meaning/what is meant) (d:<gennop>, want to say, with the noun suffix <na>: what one means to say) (s:cihnopna) (b:gennop) (q:draft)
gennuam = (i:1) (t:v) (w:want to say/want to tell/wish to speak) (d:<gen>, say, with <nuam>, want) (s:gennop/cinuam) (q:draft)
genpa = (i:1) (t:n) (w:speaker/teller) (d:<gen>, say, with <pa>, the man who says or speaks, as in {zuau genpa}, a liar, and {thuman a genpa}, one who tells the truth) (s:thugenpa) (b:gen) (q:draft)
genpha = (i:1) (t:v) (w:say again/repeat) (d:<gen> say with <pha>: tell something that has been told before) (s:genkik) (q:draft, low confidence)
genpih = (i:1) (t:v) (w:speak to/talk with/tell) (d:<gen> speak with <pih> together with: speak to a person, talk a matter over with him) (s:hopih/paupih) (b:gen) (q:draft)
genpihpih = (i:1) (t:v) (w:keep urging/keep speaking to) (d:<genpih>, speak to, with <pih> repeated for speaking again and again) (s:hopihpih) (b:genpih) (q:draft)
gensa = (i:1) (t:v) (w:spoken/said/promised) (d:already spoken, <gen> with <sa> marking a completed action; {a gensa thu}, the word spoken before) (s:cihsa) (b:gen) (q:draft)
gensak = (i:1) (t:v) (w:speak for/plead for) (d:speak on behalf of someone) (s:thumsak) (b:gen) (r:18.13.8) (q:draft)
gensak = (i:2) (t:v) (w:let speak/have speak) (d:allow or cause someone to speak) (s:pausak) (b:gen) (r:1.18.32) (q:draft)
gensakin = (i:1) (t:v) (w:let speak/have speak) (d:<gensak> with the linking ending <in>, used before a following verb) (b:gensak) (q:draft)
gensate = (i:1) (t:n) (w:things said/words spoken) (d:<gensa> spoken with the plural <te>: what someone has said) (s:gennate) (b:gensa) (q:draft)
gensawn = (i:1) (t:v) (w:pass on/relay/report/proclaim) (d:<gen>, say, with <sawn>, onward: tell to others what one has heard; {mi' gensawn} is what people report, hearsay) (s:hilhsawn) (q:draft)
gensia = (i:1) (t:v) (w:slander/speak evil of/blaspheme) (d:speak badly of someone; also grumble against) (s:kosia/gendai) (a:phat) (r:66.13.6) (q:draft)
gensiam = (i:1) (t:v) (w:be skilled in speaking/be clever at saying) (d:<gen>, speak, with <siam>, be skilled; in the verse of one clever at saying things that belittle others) (q:draft)
gensiamna = (i:1) (t:n) (w:skill in speaking/clever speech) (d:<gensiam> with the noun suffix <na>; {zuau gensiamna} is skill in telling lies) (b:gensiam) (q:draft)
gensiapa = (i:1) (t:n) (w:slanderer) (d:<gensia>, slander, with <pa> for a man) (b:gensia) (q:draft)
gensiasiate = (i:1) (t:n) (w:gossips/slanderers) (d:<gensia>, speak evil of, with <sia> repeated and the plural <te>: those who keep speaking ill of others) (s:gensiate/kosiate) (q:draft)
gensiat = (i:1) (t:v) (w:slander/speak evil of/speak against) (d:form of <gensia> used before endings such as <nading> and {uh ciangin}) (s:kosiat) (b:gensia) (r:44.18.6) (q:draft)
gensiate = (i:1) (t:n) (w:slanderers/those who speak evil of/blasphemers) (d:<gensia> with the plural <te>, those who speak against someone) (s:kosiate) (b:gensia) (q:draft)
gensiatkhak = (i:1) (t:v) (w:speak evil of/malign) (d:<gensiat>, speak evil of, with <khak>, come to do or happen to do) (q:draft)
gensiatna = (i:1) (t:n) (w:slander/gossip/evil speaking/blasphemy) (d:speaking evil of someone; {Pasian gensiatna} is blasphemy) (s:gendaina) (a:phatna) (b:gensiat) (q:draft)
gensiatnate = (i:1) (t:n) (w:slanders/evil words) (d:<gensiatna> with plural <te>: the evil things said against someone) (b:gensiatna) (q:draft)
gensiatsak = (i:1) (t:v) (w:cause to be slandered/bring slander on) (d:<gensiat>, slander, with the causative <sak>) (b:gensiat) (q:draft)
gentaak = (i:1) (t:adj) (w:worth mentioning/of account) (d:<gen>, speak, with <taak>, worthy; in the verses always negated, {gentaak lo}, not worth mentioning, of no account) (s:gentham) (q:draft)
Gentail = (i:1) (t:name) (c:people) (w:Gentile) (d:a person or people not of the Jewish nation; {Gentail mi} is a Gentile, {Gentail pawlpite} are the Gentile churches) (r:49.2.11/45.16.4)
Gentaile = (i:1) (t:name) (c:people) (w:Gentiles) (d:the Gentiles, the nations other than the Jews) (b:Gentail) (r:42.22.25)
Gentailte = (i:1) (t:name) (c:people) (w:Gentiles) (d:the Gentiles, all the peoples who are not Jews; <Gentail> with the plural <te>) (b:Gentail) (r:44.15.19/64.1.7)
gentawmin = (i:1) (t:v) (w:make up/speak of one's own invention) (d:<gen>, speak, with <tawm>, of one's own making, and the linking ending <in>) (q:draft)
gente = (i:1) (t:n) (w:words/sayings) (d:the things that someone says, as in {kong gente} what I say to you) (s:thugente/gennate) (b:gen) (q:draft)
gente = (i:2) (t:n) (w:speakers/tellers) (d:those who say or tell something; {thuzuau gente} are liars) (b:gen) (q:draft)
genteh = (i:1) (t:v) (w:compare/liken) (d:describe one thing by likening it to another, with <tawh> for the thing it is compared to) (s:tehkak/tehpih) (r:42.13.20) (q:draft)
gentehin = (i:1) (t:v) (w:take as an example/compare) (d:<genteh> with the linking ending <in>: using someone as an illustration) (b:genteh) (q:draft)
gentehna = (i:1) (t:n) (w:example/illustration) (d:<genteh>, compare, with the noun suffix <na>: a case told as an example or illustration, also a person held up as a byword) (s:etteh) (b:genteh)
gentel = (i:1) (t:v) (w:explain/expound/state clearly) (d:<gen> tell with <tel> clear, tell a matter so that it is understood) (s:hilhtel) (q:draft)
gentelna = (i:1) (t:n) (w:explanation/clear statement) (d:<gentel> explain with the noun suffix <na>) (s:hilhtelna) (b:gentel) (q:draft)
genteng = (i:1) (t:n) (w:all that is said/everything said) (d:<gen>, say, with <teng>, all: all that someone says or has said) (b:gen) (q:draft)
genthaang = (i:1) (t:v) (w:spread abroad/disclose/make known) (d:tell something to others so that it becomes known, of a secret) (s:genthang) (a:seel) (q:draft)
gentham = (i:1) (t:adj) (w:worth mentioning/of account) (d:<gen> say with <tham> worth; {bangmah gentham lo} is of no account at all) (s:gentaak) (q:draft)
genthang = (i:1) (t:v) (w:proclaim/spread abroad/publish) (d:tell something widely so that it becomes known everywhere, of good news or of slander) (s:tangko/genthaang) (a:seel) (q:draft)
genthangin = (i:1) (t:v) (w:proclaim/spread abroad) (d:<genthang> with the linking ending <in>, used before a following verb) (b:genthang) (q:draft)
genthangna = (i:1) (t:n) (w:proclamation/report) (d:<genthang>, make known by telling, with the noun suffix <na>: what is proclaimed or spread about) (s:taangkona) (b:genthang) (q:draft)
genthei = (i:1) (t:adj) (w:distressed/afflicted/miserable/poor) (d:suffering hardship or anguish, often paired with <cimawh>, needy) (s:cimawh/zawng/hingim) (a:nuamsa) (q:draft)
genthei = (i:2) (t:v) (w:can tell/be able to say) (d:<gen>, tell, with <thei>, be able) (s:cihthei) (b:gen) (q:draft)
gentheih = (i:1) (t:v) (w:be able to tell/be able to say/can be told) (d:<gen> tell with <theih> can; {gentheih loh} is beyond telling) (s:genzawh) (b:gen) (r:28.9.9) (q:draft)
gentheih = (i:2) (t:v) (w:suffer/be in trouble/be in distress) (d:form of <genthei> used before <hun> and <na>; {ka gentheih hunin}, in my time of trouble) (b:genthei) (q:draft, low confidence)
gentheihna = (i:1) (t:n) (w:misery/hardship/suffering/distress) (d:<genthei>, distressed, with the noun suffix <na>: a state of misery, hardship or affliction) (s:haksatna/gimna/cihmawhna) (a:nopsakna) (b:gentheih) (q:draft)
gentheisak = (i:1) (t:v) (w:afflict/cause distress/make suffer) (d:<genthei> distressed with <sak>, cause) (s:gimsak) (b:genthei) (q:draft)
gentheite = (i:1) (t:n) (w:the poor/the weak/the afflicted) (d:<genthei>, distressed, with the plural <te>) (s:cimawhte/mizawngte) (a:haute) (b:genthei) (q:draft)
genthuah = (i:1) (t:v) (w:add/say further/say more) (d:add to what has been said) (s:genbeh/cithuah) (r:43.6.65) (q:draft)
genthuahin = (i:1) (t:v) (w:say further/add) (d:<genthuah> with the linking ending <in>, used before a following verb) (b:genthuah) (q:draft)
Genubath = (i:1) (t:name) (c:male) (w:Genubath) (d:son of Hadad the Edomite and the sister of Queen Tahpenes, brought up in the palace of Pharaoh) (r:11.11.20)
genzaak = (i:1) (t:v) (w:proclaim/announce/make known) (d:<gen> tell with <zaak>, let hear: make something known aloud; written <genzak> in the other Bible text) (s:genzak/taangko/tangko/zasak) (q:draft)
genzak = (i:1) (t:v) (w:proclaim/announce/make known) (d:<gen> tell with <zak>, let hear: make something known aloud; written <genzaak> in the other Bible text) (s:genzaak/taangko/tangko/zasak) (q:draft)
genzakna = (i:1) (t:n) (w:proclamation/announcement/order) (d:<genzak> proclaim with the noun suffix <na>; {thu genzakna bawl} is issue a proclamation) (s:taangkona/zaksakna/thupiakna) (b:genzak) (q:draft)
genzaw = (i:1) (t:v) (w:speak rather/speak instead/teach rather) (d:<gen>, speak, with <zaw>, rather: speak in this way and not in the other; follows a clause with {gen loin}, not speaking as) (s:pauzaw/cizaw) (b:gen) (q:draft)
genzawh = (i:1) (t:v) (w:be able to tell/express fully/tell in full) (d:<gen>, tell, with <zawh>, be able to finish; nearly always with <loh>, not: {genzawh loh} and {genzawh lohin} mean beyond telling, more than can be told or counted) (s:gentheih) (q:draft)
genzo = (i:1) (t:v) (w:have said/have spoken/have told) (d:<gen>, tell, with <zo>, marking the act as carried through: has said, has told) (s:genkhin/cizo) (b:gen) (q:draft)
Gera = (i:1) (t:name) (c:male) (w:Gera) (d:name of several men of Benjamin, among them a son of Bela and the father of Ehud the judge) (r:1.46.21) (q:draft)
gerah = (i:1) (t:n) (w:gerah) (d:the smallest Hebrew unit of weight, one twentieth of a shekel) (q:draft)
Gerar = (i:1) (t:name) (c:male/city) (w:Hamathites/Gerar) (d:Philistine town in the Negev between Kadesh and Shur where Abraham and Isaac stayed, with the valley beside it) (r:1.20.1/1.26.6)
Gerasa = (i:1) (t:name) (c:land) (w:Gerasenes) (d:region of the Gerasenes on the east side of the Sea of Galilee, where Jesus healed a man possessed by demons) (r:41.5.1)
Geresa = (i:1) (t:name) (c:land) (w:Gerasenes) (d:spelling of Gerasa in Luke 8, the region of the Gerasenes across the lake from Galilee) (r:42.8.26/42.8.37)
Gerizim = (i:1) (t:name) (c:mountain) (w:Gerizim) (d:mountain beside Shechem, opposite Mount Ebal, from which the blessings were proclaimed) (r:5.11.29/5.27.12)
Gershom = (i:1) (t:name) (c:male) (w:Gershom) (d:elder son of Moses, ancestor of a Levite family to which Shubael belonged) (r:13.23.15)
Gershom = (i:2) (t:name) (c:male) (w:Gershom) (d:firstborn son of Moses and Zipporah, born in Midian; in 1 Chronicles 6 the name also stands for Gershon son of Levi) (r:2.2.22)
Gershomte = (i:1) (t:name) (c:people) (w:Gershonites) (d:Levite clan descended from Gershon son of Levi, whose name is spelled Gershom in 1 Chronicles 6) (b:Gershom) (r:13.6.71)
Gershon = (i:1) (t:name) (c:male) (w:Gershon) (d:eldest son of Levi, ancestor of the Gershonite clan of Levites) (r:1.46.11/13.23.7)
Gershonte = (i:1) (t:name) (c:people) (w:Gershonites) (d:Levite clan descended from Gershon, in charge of the curtains and coverings of the tabernacle) (b:Gershon) (r:4.3.25/4.4.24)
Geshan = (i:1) (t:name) (c:male) (w:Geshan) (d:son of Jahdai in the family of Caleb, of the tribe of Judah) (r:13.2.47)
Geshem = (i:1) (t:name) (c:male) (w:Geshem) (d:the Arab who with Sanballat and Tobiah opposed Nehemiah when he rebuilt the wall of Jerusalem) (r:16.6.1/16.6.2)
Geshur = (i:1) (t:name) (c:land) (w:Geshur) (d:small Aramean kingdom east of the Sea of Galilee, where Absalom fled; also a people living in the south near the Philistines) (r:10.14.23/6.13.2)
Gether = (i:1) (t:name) (c:male) (w:Gether) (d:son of Aram and grandson of Shem) (r:1.10.23)
Gethsemane = (i:1) (t:name) (c:place) (w:Gethsemane) (d:place at the foot of the Mount of Olives where Jesus prayed on the night of his arrest) (r:41.14.32/40.26.36)
Geuel = (i:1) (t:name) (c:male) (w:Geuel) (d:son of Maki, the man of the tribe of Gad sent by Moses to explore Canaan) (r:4.13.4)
Gezer = (i:1) (t:name) (c:city) (w:Gezer) (d:Canaanite city on the western edge of the hill country of Ephraim, given to the Levites and later rebuilt by Solomon) (r:6.10.33/11.9.17)
gi = (i:1) (t:n) (w:boundary/border) (d:the boundary of a piece of land; found in {gi-suang}, a boundary stone or landmark, and in <gamgi>, the border of a land) (s:gamgi) (q:draft)
gi = (i:2) (t:adj) (w:good/kind/upright) (d:good in character, the opposite of <gilo> bad; {a gi, a gilote}, the good and the bad) (s:hoih) (a:gilo) (q:draft)
Gi = (t:see) <Gi-ah>
Gi-ah = (i:1) (t:name) (c:place) (w:Giah) (d:place near the hill of Ammah on the road to the wilderness of Gibeon, reached by Joab in his pursuit of Abner) (q:draft)
giah = (i:1) (t:v) (w:lodge/stay the night/camp) (d:stay somewhere for the night; the form of <giak> used before <nading>: {giah nading} is a place to stay, and {giah phual} is a camp) (s:giak/taam/zintun) (q:draft)
Giah = (i:1) (t:name) (c:place) (w:Giah) (d:place near the hill of Ammah on the road to the wilderness of Gibeon, reached by Joab in his pursuit of Abner) (q:draft)
giahbuk = (i:1) (t:n) (w:camp/tent) (d:<giah> lodge with <buk> hut: a shelter to stay in, and the camp made of them; {giahbuk pualam} is outside the camp) (s:giahphual/phual) (q:draft)
giahna = (i:1) (t:n) (w:lodging place/camp/resting place) (d:<giah>, stay the night, with the noun suffix <na>: the place where one stops for the night, a lodging place or camp) (s:giahphual/phual) (b:giah) (q:draft)
giahphual = (i:1) (t:n) (w:camp/encampment) (d:the place where a people or an army stops and sets up its tents; {giahphual sat} is pitch camp) (s:phual/giahbuk)
giahphuala = (i:1) (t:adv) (w:in the camp) (d:<giahphual>, camp, with the place ending <a>: in the camp) (s:phuala) (b:giahphual) (q:draft)
giahphualah = (i:1) (t:n) (w:camp/in the camp/to the camp) (d:<giahphual>, camp, with the place ending <ah>: in the camp or to the camp) (b:giahphual)
giahphualate = (i:1) (t:n) (w:those camping/those in the camp) (d:<giahphuala>, in the camp, with the plural <te>: the ones encamped) (b:giahphuala) (q:draft)
giahphualte = (i:1) (t:n) (w:camps/encampments) (d:<giahphual>, camp, with plural <te>; in Numbers 33 the camping places are the stages of the journey) (s:phualte) (b:giahphual) (q:draft)
giahpih = (i:1) (t:v) (w:stay the night with/camp out with) (d:<giah>, stay the night, with <pih>, together with: of shepherds staying out at night with their flocks) (b:giah) (q:draft)
giak = (i:1) (t:v) (w:spend the night/lodge/stay overnight) (d:stay somewhere for the night, as a traveller or a guest; the form <giah> is used before <nading> and in <giahphual>, camp) (s:giah/taam/zintun) (r:1.32.21) (q:draft)
giakin = (i:1) (t:v) (w:spend the night/stay overnight) (d:<giak>, spend the night, with the linking ending <in>, used before a following verb: staying out at night) (b:giak) (q:draft)
giakkhawm = (i:1) (t:v) (w:stay the night together/lodge with) (d:<giak>, spend the night, with <khawm>, together: stay the night with someone as a guest) (b:giak) (q:draft)
gial = (i:1) (t:adj) (w:speckled/spotted/streaked/dappled) (d:of an animal, marked with spots or stripes of another colour; {a dung gial} is streaked, and {a bem gial} is spotted) (s:puang/gialbem) (r:1.30.39) (q:draft)
gial = (i:2) (t:n) (w:hail/hailstone) (d:frozen rain that falls as balls of ice; <gialpi> is heavy hail) (s:gialpi) (r:23.32.19) (q:draft)
gialbem = (i:1) (t:adj) (w:spotted/speckled) (d:<gial> spotted with <bem> round: marked with round spots; {kamkei gialbem} is the leopard) (s:puang) (q:draft)
gialheek = (i:1) (t:n) (c:plant) (w:poplar/willow) (d:a tree that grows beside streams, usually with <kung>, tree; also written <gialhek>) (s:gialhek) (q:draft)
Gialheek = (i:1) (t:n) (c:plant) (w:poplar/willow) (d:<gialheek> written with a capital in the name {Gialheek Lui}, the Ravine of the Poplars) (b:gialheek) (q:draft)
gialhek = (i:1) (t:n) (c:plant) (w:poplar/willow) (d:a tree that grows beside water, usually with <kung>, tree; also written <gialheek>) (s:gialheek) (q:draft)
Gialhek = (i:1) (t:n) (c:plant) (w:poplar/willow) (d:<gialhek> written with a capital in the name {Gialhek Lui}, the Ravine of the Poplars) (b:gialhek) (q:draft)
gialhekte = (i:1) (t:n) (c:plant) (w:willows/poplars) (d:<gialhek>, willow or poplar, with the plural <te>; {lui-a gialhekte} are the willows of the brook) (b:gialhek) (q:draft)
gialin = (i:1) (t:adv) (w:spotted/patterned) (d:<gial>, spotted or patterned, with the suffix <in>: of animals marked with spots or streaks, and of cloth woven in a pattern) (b:gial) (q:draft)
gialkiatnate = (i:1) (t:n) (w:hailstorms/falls of hail) (d:<gial>, hail, with <kiat>, fall, the noun suffix <na> and the plural <te>: falls of hail, a hailstorm) (q:draft)
gialphual = (i:1) (t:n) (w:camp) (d:in the verse where the NIV has outside the camp; elsewhere the word for camp is <giahphual>, so this spelling may be a misprint) (s:giahphual) (q:draft, low confidence)
gialpi = (i:1) (t:n) (w:hail/hailstone/hailstorm) (d:<gial>, hail, with <pi>, great: heavy hail, large hailstones or a hailstorm; {gialpi kia} is hail falls) (s:gial) (b:gial) (r:19.105.32) (q:draft)
gialpite = (i:1) (t:n) (w:hailstones) (d:<gialpi>, large hail, with the plural <te>: hailstones) (b:gialpi) (q:draft)
gialte = (i:1) (t:adj) (w:speckled/streaked/dappled) (d:plural form of <gial>, animals with a marked or patterned coat, {a dung gialte} are the streaked ones) (b:gial) (q:draft)
giat = (i:1) (t:num) (w:eight) (d:the number eight; {a ni giat ni} is the eighth day, and {sawm leh giat} is eighteen)
giatna = (i:1) (t:num) (w:eighth) (d:<giat>, eight, with the ordinal ending <na>; {sawm-le-giatna} is eighteenth) (b:giat) (r:13.12.12) (q:draft)
giatte = (i:1) (t:num) (w:the eight/eight) (d:<giat>, eight, with plural {-te}: the eight persons or things; also ends larger numbers such as {sawm-le-giatte}, the eighteen) (b:giat) (q:draft)
giau = (i:1) (t:adv) (w:intently) (d:follows <en>, look, for looking intently or peering at something through an opening) (q:draft, low confidence)
giaugiau = (i:1) (t:adv) (w:intently/closely) (d:<giau> repeated; follows <en>, look, for watching someone closely for some time) (q:draft, low confidence)
