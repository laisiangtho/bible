zaakin = (i:1) (t:v) (w:spreading out/stretching out) (d:<zaak> spread out, with the linking ending <in>; said of the hands in prayer) (b:zaak) (q:draft)
zaam = (i:1) (t:v) (w:spread/climb/creep) (d:of a vine or its branches, grow out along or over something) (q:draft)
zaamsak = (i:1) (t:v) (w:make grow over/make spread over) (d:<zaam>, of a vine, spread or climb, with the causative <sak>: make a plant grow up over something) (b:zaam) (q:draft)
Zaanannim = (i:1) (t:name) (c:place) (w:Zaanannim) (d:place on the border of Naphtali near Kedesh, where Heber the Kenite pitched his tent by the great tree) (r:6.19.33/7.4.11)
zaang = (i:1) (t:v) (w:suffer loss/lose) (q:draft, low confidence)
zaangmul = (i:1) (t:n) (w:mane) (d:the long hair on the neck of a horse; <mul> is hair) (s:zangmul) (q:draft)
zaap = (t:see) <zaap-in>
zaap-in = (i:1) (t:v) (w:fanning/blowing) (d:<zaap> fan, with the linking ending <in>; {pum zaap} is work the bellows to blow a fire) (q:draft)
Zaavan = (i:1) (t:name) (c:male) (w:Zaavan) (d:son of Ezer and grandson of Seir the Horite, in the land of Edom) (r:1.36.27/13.1.42)
Zabab = (i:1) (t:name) (c:male) (w:Zabad) (d:son of Nathan and father of Ephlal in the line of Jerahmeel of Judah; the NIV spells the name Zabad) (r:13.2.37/13.2.36)
Zabad = (i:1) (t:name) (c:male) (w:Zabad) (d:name of several men, among them one of the mighty warriors of David and three men who had married foreign wives in the time of Ezra) (r:15.10.27) (q:draft)
Zabbai = (i:1) (t:name) (c:male) (w:Zabbai) (d:name of two men after the exile: a descendant of Bebai who had married a foreign wife, and the father of Baruch who repaired part of the wall of Jerusalem) (r:16.3.20/15.10.28)
Zabbud = (i:1) (t:name) (c:male) (w:Zabbud/Zakkur) (d:descendant of Bigvai who returned from Babylon with Ezra; the NIV has Zakkur) (r:15.8.14)
Zabdi = (i:1) (t:name) (c:male) (w:Zabdi) (d:name of several men, among them the grandfather of Achan of the tribe of Judah and the official over the wine stores of David) (r:6.7.1/13.27.27)
Zabdiel = (i:1) (t:name) (c:male) (w:Zabdiel) (d:name of two men: the father of Jashobeam, a commander in David’s army, and a chief officer of the priests in the time of Nehemiah) (r:13.27.2/16.11.14)
Zabres = (i:1) (t:name) (c:male) (w:Jambres) (d:one of the two men who opposed Moses, named together with Jannes) (r:55.3.8)
Zabud = (i:1) (t:name) (c:male) (w:Zabud) (d:son of Nathan, a priest and adviser to King Solomon) (r:11.4.5)
zadahin = (i:1) (t:adv) (w:with loathing/in disgust) (d:describes hating strongly, detesting; here with <kih> hate) (q:draft, low confidence)
Zado = (i:1) (t:name) (c:male) (w:Zadok) (d:a scribe whom Nehemiah put in charge of the storerooms; spelled Zadok in the NIV) (r:16.13.13) (q:draft, spelling without final k may be a misprint)
Zadok = (i:1) (t:name) (c:male) (w:Zadok) (d:priest in the time of David and Solomon, son of Ahitub; also the name of several other men) (r:13.6.12/10.8.17)
Zafananim = (i:1) (t:name) (c:place) (w:Zaanannim) (d:place near Kedesh with a great tree, where Heber the Kenite pitched his tent) (r:7.4.11)
Zafenath = (i:1) (t:name) (c:male) (w:Zaphenath) (d:first part of Zaphenath-Paneah, the name Pharaoh gave to Joseph) (r:1.41.45)
Zafenath-paneah = (i:1) (t:name) (c:male) (w:Zaphenath-Paneah) (d:the name Pharaoh gave to Joseph) (q:draft)
Zafon = (i:1) (t:name) (c:place) (w:Zaphon) (d:town east of the Jordan in the territory of Gad) (r:6.13.27/7.12.1)
zagiat = (i:1) (t:num) (w:eight hundred) (d:<za>, hundred, with <giat>, eight; {tul zagiat} is eight hundred thousand)
zagui = (i:1) (t:n) (w:hamstring/leg tendon) (d:the tendon at the back of an animal’s leg; {zagui sattat} and {zagui atsat} mean cut the hamstring of a horse or an ox so that it cannot run) (q:draft)
zaguk = (i:1) (t:num) (w:six hundred) (d:<za>, hundred, with <guk>, six)
zagukte = (i:1) (t:num) (w:the six hundred/six hundred) (d:<zaguk>, six hundred, with the plural <te>: the six hundred, said after the noun of a group of people already mentioned) (b:zaguk) (q:draft)
zah = (i:1) (t:part) (d:numerical classifier used in counting the number of times per equal amount)
zah = (i:2) (t:n) (w:amount/number/quantity) (d:the amount, number or quantity of something; {zah tawh kituakin} is according to the number of)
zah = (i:3) (t:n) (w:fold) (d:a multiple of an amount, with a number after it: {a zah zakhat} is a hundredfold and {a zah nih} is double)
zah = (i:4) (t:n) (w:time) (d:used with a number for how many times over something is repaid or done)
zaha = (i:1) (t:adv) (w:so/such/to that extent) (d:<zah>, amount, with the linking <a>, used after <hih>, <tua> or <bang> and before a describing word or a noun: {hih zaha tam} is so many, {bang zaha lian} is how great) (s:zahta) (b:zah) (q:draft)
Zaham = (i:1) (t:name) (c:male) (w:Zaham) (d:son of King Rehoboam of Judah and his wife Mahalath) (r:14.11.19)
Zahaziel = (i:1) (t:name) (c:male) (w:Jahaziel) (d:father of Shekaniah, of the descendants of Zattu, who returned from exile with Ezra) (r:15.8.5)
zahhuai = (i:1) (t:v) (w:be put to shame/be ashamed/be disgraced) (d:be put to shame or disgraced, said mostly of enemies who are defeated; {zahhuai sak} is put someone to shame) (s:zum) (q:draft)
zahhuaigawp = (i:1) (t:v) (w:be utterly put to shame/be thrown into confusion) (d:<zahhuai> be put to shame, with <gawp> completely; with <sak>, put someone utterly to shame) (b:zahhuai) (q:draft)
zahhuaina = (i:1) (t:n) (w:shame/disgrace/scorn) (d:<zahhuai>, be put to shame, with the noun suffix <na>: shame or disgrace that comes on a person or a people) (s:maizumna/mindaina/zumna) (a:pahtawina) (b:zahhuai) (q:draft)
zahhuaisak = (i:1) (t:v) (w:put to shame/disgrace/treat shamefully) (d:<zahhuai>, be put to shame, with the causative <sak>: put someone to shame, disgrace or treat shamefully) (s:maizumsak/mindaisak/zumsak) (a:pahtawi) (b:zahhuai) (r:41.12.4) (q:draft)
zahin = (i:1) (t:prep) (w:as much as/as many as/like) (d:<zah>, amount, with the marker <in>, placed after the thing compared: to the same amount or degree as) (b:zah) (q:draft)
Zahin = (i:1) (t:prep) (w:as much as/as) (d:<zahin>, as much as, capitalised in a section heading, love is as strong as death) (b:zahin) (q:draft)
zahko = (i:1) (t:v) (w:mock/ridicule/scoff at/insult) (d:make fun of someone with scorn, laugh at and insult; often said of enemies) (s:zahpih/nuihsan/simmawhbawl) (a:zahtak) (q:draft)
zahkohna = (i:1) (t:n) (w:mockery/reproach/contempt/insult) (d:<zahko>, mock, with the noun suffix <na>: mockery or contempt shown to someone; also written <zahkona>) (s:zahkona/zahpihna/simmawhna) (a:zahtakna) (q:draft)
zahkoin = (i:1) (t:v) (w:mocking/ridiculing) (d:<zahko> mock, with <in> linking it to the next verb) (s:zahpihin) (b:zahko) (q:draft)
zahkona = (i:1) (t:n) (w:ridicule/reproach/contempt/taunt) (d:<zahko>, mock, with the noun suffix <na>: mockery, ridicule or a taunt; {zahkona kam} is a taunting saying) (s:zahkohna/zahpihna/simmawhna) (a:zahtakna) (b:zahko) (r:19.123.4) (q:draft)
zahkonate = (i:1) (t:n) (w:mockeries/ridicule/taunts) (d:<zahkona> mockery with plural <te>) (s:simmawhnate) (b:zahkona) (r:24.29.18) (q:draft)
zahkote = (i:1) (t:n) (w:mockers/those who taunt) (d:<zahko> mock, with plural <te>: those who mock) (b:zahko) (q:draft)
zahla = (i:1) (t:v) (w:be ashamed/feel disgrace) (d:feel shame for what one has done; found once, paired with <maizum>, ashamed) (s:zum) (q:draft, low confidence)
zahnih = (i:1) (t:adv) (w:double/twice as much/twofold) (d:<zah>, amount, with <nih>, two: twice the amount; used as {a zahnih}, double of it) (q:draft)
zahpi = (i:1) (t:n) (w:so great a number/so many) (d:<zah> amount with <pi> great; {hih zahpi} is this great a number) (b:zah) (q:draft)
zahpih = (i:1) (t:v) (w:mock/scoff at/ridicule/jeer at) (d:treat with scorn, often paired with <simmawh> despise and <nuihsan> laugh at) (s:zahko/nuihsan/zahpihbawl) (a:zahtak) (q:draft)
zahpihbawl = (i:1) (t:v) (w:mock/ridicule/sneer at/make fun of) (d:<zahpih>, mock, with <bawl>, do or treat) (s:zahpih/zahko/simmawhbawl) (a:zahtakbawl) (b:zahpih) (q:draft)
zahpihhuai = (i:1) (t:adj) (w:contemptible/despicable) (d:deserving to be mocked or looked down on; with <zaw>, more contemptible) (s:simmawhhuai) (a:zahtakhuai) (q:draft, low confidence)
zahpihin = (i:1) (t:v) (w:mocking/laughing at/scoffing at) (d:<zahpih> with the linking suffix <in>: making fun of someone, and) (s:zahkoin/nuihsanin) (b:zahpih) (q:draft)
zahpihna = (i:1) (t:n) (w:mockery/ridicule/reproach/taunt) (d:<zahpih>, mock, with the noun suffix <na>: mockery or a taunt; {zahpihna tawh} is mockingly) (s:zahkona/zahkohna/nuihsatna) (a:zahtakna) (b:zahpih) (q:draft)
zahsak = (i:1) (t:v) (w:tell/inform/let hear) (d:cause someone to hear, tell or report news; from <zak>, hear, with the causative <sak>) (s:zasak/zaksak/theihsak) (q:draft)
zahta = (i:1) (t:adv) (w:so much/this much/such) (d:follows <hih> or <tua>: to such an extent, so much or so many; often written {zahta-in}) (s:zaha) (b:zah) (r:18.6.10) (q:draft)
Zahtak = (i:1) (t:v) (w:fear/revere/honor) (d:<zahtak>, fear or honor, written with a capital at the start of a sentence and in {Isaac’ Zahtak pa}, the One whom Isaac feared, a name of God, the Fear of Isaac in the NIV) (b:zahtak) (q:draft)
zahtaka = (i:1) (t:v) (w:respect/fear/revere) (d:<zahtak> respect, with <a> linking it to what follows: respecting and) (b:zahtak) (q:draft)
zahtakbawl = (i:1) (t:v) (w:respect/honor/show respect to) (d:<zahtak> respect with <bawl> do, treat someone with respect) (s:zahtak/pahtawi) (a:simmawhbawl/zahpihbawl) (b:zahtak) (r:54.5.3) (q:draft)
zahtakhuai = (i:1) (t:adj) (w:honorable/respected/awesome) (d:deserving honor or reverence, from <zahtak> respect and <huai> worthy of; with <taka>, in a dignified way) (s:kihtakhuai/pahtakhuai) (a:zahpihhuai/simmawhhuai) (q:draft)
zahtakin = (i:1) (t:v) (w:fear/revere/respect) (d:<zahtak> with the linking ending <in>, followed by another verb: fearing, revering) (a:simmawhin) (b:zahtak) (q:draft)
Zahtakpa = (i:1) (t:n) (w:Fear/the One feared) (d:<Zahtak>, fear or revere, with {-pa}, the male one: the One who is feared; {Isaak’ Zahtakpa} is a name of God, the Fear of Isaac in the NIV) (b:Zahtak) (q:draft)
zahtakte = (i:1) (t:n) (w:those who fear/worshippers) (d:<zahtak> with plural <te>, those who fear or revere; mostly {Topa a zahtakte}, those who fear the Lord) (s:kihtate) (b:zahtak) (r:19.118.4) (q:draft)
zahtaktheih = (i:1) (t:v) (w:be able to respect/be respected) (d:<zahtak> respect with <theih> can: {mite’ zahtaktheih dingin}, so that people can respect it) (b:zahtak) (q:draft)
zahtaktuam = (i:1) (t:n) (w:partiality/special regard) (d:<zahtak> respect with <tuam> separate: respect shown to one person above others; {zahtaktuam nei lo} is show no partiality) (s:deidanna/angvanna) (q:draft)
zahtakzaw = (i:1) (t:v) (w:fear more/respect more) (d:<zahtak> respect, with <zaw> more) (s:kihtazaw) (b:zahtak) (q:draft)
zahtuan = (i:1) (t:v) (w:spare/have regard for) (d:show regard or mercy to someone; found in the negative, {zahtuan lo}, not spare) (q:draft, low confidence)
zahun = (i:1) (t:conj) (w:as much as/as far as/to the extent that) (d:<zah>, amount, with the plural ending <un>, after a clause whose subject is plural: {na hih zawh zahun} is as far as you are able) (b:zah) (q:draft)
zahval = (i:1) (t:adv) (w:more than/beyond) (d:<zah> amount with <val> exceed, after a phrase naming an amount: more than that amount) (q:draft)
zahzah = (i:1) (t:adv) (w:as many as/as much as/whatever amount) (d:placed after a verb, to the full number or amount that is so) (q:draft)
zahzaha = (i:1) (t:adv) (w:as much as/to the full extent) (d:<zahzah> with the ending <a>; {ahi thei zahzaha} is as much as is possible) (b:zahzah) (q:draft)
zahzahin = (i:1) (t:adv) (w:as much as/as far as) (d:placed after a verb to mean to the full extent of what is wanted or possible) (b:zahzah) (q:draft)
zahzahun = (i:1) (t:adv) (w:as much as/as many as) (d:<zahzah>, as much as, with the plural ending <un>, used when the subject is plural: {a duh zahzahun} is as much as they want) (b:zahzah) (q:draft)
zai = (i:1) (t:adj) (w:wide/broad/spacious) (d:wide, also used after a measure to give the width) (a:kawcik/kawciik/geek) (q:draft)
Zai = (i:1) (t:adj) (w:broad/wide) (d:<zai> written with a capital in {Kulh Zai}, the Broad Wall of Jerusalem) (b:zai) (q:draft)
zailam = (i:1) (t:n) (w:width/breadth) (d:<zai> wide with <lam> side, the measure across, set against <saulam> the length) (s:zaina/vailam) (a:saulam) (q:draft)
zaina = (i:1) (t:n) (w:breadth) (d:<zai>, wide, with the noun suffix <na>: breadth or largeness, here of understanding) (b:zai)
zaina = (i:2) (t:n) (w:width) (d:<zai>, wide, with the noun suffix <na>: the measure of a thing from side to side, paired with <sauna> for the length) (s:zailam/vailam) (a:sauna) (b:zai)
zaipi = (i:1) (t:adj) (w:very wide/extensive/vast) (d:<zai> wide with <pi> great) (b:zai) (q:draft)
Zair = (i:1) (t:name) (c:place) (w:Zair) (d:place in or near Edom where King Jehoram of Judah fought the Edomites) (r:12.8.21)
zaisak = (i:1) (t:v) (w:widen/broaden/make wide) (d:<zai> wide with <sak> cause; after a measure, make so many wide) (b:zai) (q:draft)
zaizai = (i:1) (t:adv) (d:expressive word placed after a verb, describing many small things flashing, sparkling, crackling or flying out at once) (q:draft, low confidence)
zaizaw = (i:1) (t:adj) (w:wider/broader) (d:<zai> wide, with <zaw> more) (b:zai) (q:draft)
zak = (i:1) (t:v) (w:hear) (d:form of <za> used before <ciangin>, <ding> and other dependent endings) (b:za) (r:13.19.8) (q:draft)
zakha = (i:1) (t:v) (w:happen to hear/overhear) (d:<za> hear with <kha>, by chance) (s:zakkhak) (q:draft)
Zakhariah = (i:1) (t:name) (c:male) (w:Zechariah) (d:father of Abijah, the mother of King Hezekiah) (r:14.29.1)
zakhat = (i:1) (t:num) (w:one hundred/hundred) (d:<za>, hundred, with <khat>, one; {tul zakhat} is one hundred thousand) (s:za) (q:draft)
zakhatin = (i:1) (t:adv) (w:a hundred times/a hundredfold) (d:<zakhat> one hundred, with the marker <in>) (s:zavei) (b:zakhat) (q:draft)
zakhatte = (i:1) (t:num) (w:hundred/one hundred) (d:<zakhat> one hundred, with plural <te> for the people or things counted; {tul leh zakhatte} is eleven hundred) (b:zakhat) (q:draft)
zakhin = (i:1) (t:v) (w:have heard/hear) (d:<za> hear with <khin> marking the action as completed) (b:za) (q:draft)
Zakhur = (i:1) (t:name) (c:male) (w:Zakkur) (d:a son of Asaph, a temple musician in the time of David; spelled Zakkur in the NIV) (r:13.25.2)
zakiasak = (i:1) (t:v) (w:dethrone/depose/remove from office) (d:<za>, rank or office, with <kiasak>, cause to fall: bring a ruler down from his position) (q:draft)
zakiat = (i:1) (t:v) (w:fall from power/lose position) (d:<za> rank with <kiat> fall; set against <liat>, become great) (q:draft)
zakiatna = (i:1) (t:n) (w:downfall/fall from power) (d:<zakiat> fall from power, with the noun suffix <na>) (s:kiatna) (b:zakiat) (q:draft)
zakik = (i:1) (t:v) (w:hear again) (d:<za> hear with <kik> again) (s:zakkik/ngaikik) (b:za) (q:draft)
zakin = (i:1) (t:prep) (w:in the hearing of) (d:placed after the hearer: while that person listens, to the ears of) (b:zak) (r:5.31.30) (q:draft)
Zakkai = (i:1) (t:name) (c:male) (w:Zakkai) (d:ancestor of a family of 760 people who returned from exile with Zerubbabel) (r:15.2.9/16.7.14)
zakkhak = (i:1) (t:v) (w:happen to hear/come to hear) (d:<zak> hear with <khak>, by chance or as it turns out) (s:zakha) (q:draft)
Zakkhias = (i:1) (t:name) (c:male) (w:Zacchaeus) (d:chief tax collector in Jericho, a rich man who welcomed Jesus into his house) (r:42.19.2/42.19.5)
zakkhit = (i:1) (t:v) (w:have heard/finish hearing) (d:<zak>, hear, with <khit>, finished: used before <ciangin> or <phet> for after hearing, as soon as one has heard) (q:draft)
Zakkhur = (i:1) (t:name) (c:male) (w:Zakkur) (d:leader of the third group of temple musicians in the time of David, a son of Asaph) (r:13.25.10)
zakkik = (i:1) (t:v) (w:hear again) (d:<zak> hear with <kik> again) (s:zakik/ngaikik) (b:zak) (q:draft)
Zakkur = (i:1) (t:name) (c:male) (w:Zaccur/Zakkur) (d:name of several men, among them the father of Shammua, the spy from the tribe of Reuben) (r:4.13.4)
zakma = (i:1) (t:v) (w:before hearing) (d:<zak> hear with <ma> before: before one hears or heard) (q:draft, low confidence)
zakna = (i:1) (t:n) (w:hearing) (d:<zak> with <na>, the act of hearing or what is heard) (b:zak) (r:20.15.30) (q:draft)
zaknop = (i:1) (t:v) (w:want to hear/long to hear) (d:form of <za> hear with <nop> want; after a possessive, what someone likes to hear) (s:zanuam) (q:draft)
zaknophuai = (i:1) (t:adj) (w:pleasant to hear/pleasing/gracious) (d:of words or speech, sweet to listen to; from <zak> hear, <nop> pleasant and <huai> worthy of) (q:draft)
zakphetin = (i:1) (t:v) (w:as soon as one hears/on hearing) (d:<zak> hear with <phet>, the very moment, and the marker <in>) (q:draft)
zaksa = (i:1) (t:v) (w:heard/already heard) (d:<zak> with {-sa}, already; with a pronoun before it, what one has heard) (s:zasa) (b:zak) (r:40.11.4) (q:draft)
zaksak = (i:1) (t:v) (w:tell/report/proclaim/make known) (d:<zak>, hear, with the causative <sak>: cause to hear, tell, report or proclaim news) (s:zasak/zahsak/theihsak/pulak) (b:zak) (q:draft)
zaksakna = (i:1) (t:n) (w:announcement/proclamation/notice/report) (d:<zaksak> make hear with <na>: making something known, by word, letter or signal) (s:theihsakna/thuzaksakna) (b:zaksak) (q:draft)
zaktak = (i:1) (t:v) (w:fear/revere/respect/honor) (d:show reverence or respect to God or to a person; another spelling of <zahtak>) (s:zahtak/kihta) (a:simmawh) (q:draft)
zaktakin = (i:1) (t:adv) (w:reverently/with awe) (d:<zaktak> revere, with the ending <in>; {zaktakin kihta} is stand in awe of) (b:zaktak) (q:draft)
zakte = (i:1) (t:n) (w:things heard/what one hears) (d:<zak>, hear, with the plural <te>, placed after the one who hears: the things that someone hears) (b:zak) (q:draft)
zakthadahhuai = (i:1) (t:adj) (w:detestable/hateful to hear) (d:<zak> hear with <thadahhuai>, wearisome or loathsome: not worth listening to) (q:draft)
zaktheih = (i:1) (t:v) (w:be able to hear/can hear) (d:<zak> hear with <theih> can, the form used before <ding>, <nading> and <hangin>) (b:zak) (q:draft)
zakua = (i:1) (t:num) (w:nine hundred) (d:<za>, hundred, with <kua>, nine)
zakzah = (i:1) (t:adv) (w:as much as) (d:placed after <zawh>, be able: {puak zawh zakzah} is as much as can be carried) (s:zahzah) (q:draft, low confidence)
zakzak = (i:1) (t:v) (w:keep hearing/hear again and again) (d:<zak> hear, said twice for repeated or continued action; in Isaiah 42:2 {gen zakzak} is speak out so as to be heard) (s:zaza) (q:draft)
zakzakna = (t:see) <zakzakna-un>
zakzakna-un = (i:1) (t:n) (w:at their hearing/when they hear) (d:<zakzak> keep hearing, with the noun suffix <na> and <un> for a plural subject: as they hear it) (q:draft, low confidence)
zakzaksa = (i:1) (t:v) (w:have heard/already heard) (d:<zakzak> keep hearing, with <sa> marking what is already done) (s:zaksa/zasa) (b:zakzak) (q:draft)
zal = (i:1) (t:v) (w:spread out/stretch out) (d:open something out wide, as God spreads out the sky and the earth, or as one spreads a tent or wings) (s:zalh) (r:26.1.23) (q:draft)
Zalaf = (i:1) (t:name) (c:male) (w:Zalaph) (d:father of Hanun, who helped repair the wall of Jerusalem in the time of Nehemiah) (r:16.3.30)
zalesawmnga = (i:1) (t:num) (w:one hundred and fifty) (d:<za> hundred, <le> and, <sawmnga> fifty; in 1 Kings 7:2 a length counted in <pi>, feet, where the NIV has a hundred cubits) (q:draft)
zalh = (i:1) (t:v) (w:spread out/stretch out/lay flat) (d:to spread something out flat, used of stretching out the heavens, spreading grain and levelling ridges of soil) (s:zal) (q:draft)
zalhmai = (t:see) <zalhmai-in>
zalhmai-in = (i:1) (t:v) (w:level/flatten/make level) (d:<zalhmai>, make flat and even, with the linking ending <in>, which joins it to the following verb; <zalh> is spread flat) (s:zalhtam) (q:draft)
zalhtam = (i:1) (t:v) (w:level/make level) (d:make the ground flat before sowing) (q:draft)
zali = (i:1) (t:num) (w:four hundred) (d:<za>, hundred, with <li>, four) (r:1.11.13)
zalian = (i:1) (t:n) (w:high rank/rank) (d:<za> rank or title with <lian> great; {zalian a neipa} is a man of rank) (s:zaliatna) (a:zaneu) (q:draft)
zalianpi = (i:1) (t:n) (w:high position/very high rank) (d:<zalian> high rank, with <pi> great) (s:zaliatna) (b:zalian) (q:draft)
zaliatna = (i:1) (t:n) (w:high rank/high position/dignity) (d:<za>, rank, with <liatna>, greatness: a great office or exalted standing) (s:zalian) (a:zaneu) (q:draft)
zalin = (i:1) (t:v) (w:spread out/stretch out) (d:<zal> with the ending <in>, which links it to the following verb: spreading, stretching out, said of wings and of the heavens) (b:zal) (q:draft)
zalite = (i:1) (t:num) (w:four hundred) (d:<zali> with plural {-te}, the four hundred, placed after the noun it counts) (b:zali) (q:draft)
zalkhia = (i:1) (t:v) (w:spread out/stretch out) (d:<zal> spread out, with <khia> out) (b:zal) (q:draft)
Zalmon = (i:1) (t:name) (c:male) (w:Zalmon) (d:the Ahohite, one of the thirty mighty warriors of David) (q:draft)
Zalmon = (i:2) (t:name) (c:mountain) (w:Zalmon) (d:mountain near Shechem where Abimelek and his men cut branches; also the snow-covered mountain of Psalm 68) (r:7.9.48) (q:draft)
Zalmonah = (i:1) (t:name) (c:place) (w:Zalmonah) (d:place where the Israelites camped in the wilderness after leaving Mount Hor) (r:4.33.41/4.33.42)
Zalmunna = (i:1) (t:name) (c:male) (w:Zalmunna) (d:king of Midian whom Gideon pursued, captured and killed, always named together with Zebah) (r:7.8.12/7.8.21)
Zalmunnate = (i:1) (t:name) (c:male) (w:Zalmunna) (d:<Zalmunna> with the plural <te>, used when Zebah and Zalmunna are named together as a pair) (b:Zalmunna) (r:7.8.10)
zalpa = (i:1) (t:n) (w:one who spreads out) (d:<zal> spread out, with <pa> marking a male: he who spreads out) (b:zal) (q:draft)
zalzal = (i:1) (t:adv) (w:flashing/glittering/in flashes) (d:describes repeated flashing or darting; placed after <tee> or <phe>, glitter, and after <kin>, quick) (s:zialzial) (q:draft)
zalzo = (i:1) (t:v) (w:be able to spread out) (d:<zal> spread out, with <zo> be able) (b:zal) (q:draft)
zam = (i:1) (t:v) (w:reach out/stretch out/spread) (d:stretch the hand toward something to take or touch it; of branches and vines, spread out or climb over) (q:draft)
Zamari = (i:1) (t:name) (c:people) (w:Zemarites) (d:Canaanite people descended from Canaan son of Ham, listed with the Arvadites and Hamathites) (r:1.10.18)
zamin = (i:1) (t:v) (w:reaching out/stretching out/straining toward) (d:<zam> reach or stretch out with the linking suffix {-in}, followed by another verb) (b:zam) (q:draft)
zamsuak = (i:1) (t:v) (w:reach as far as/spread out to) (d:<zam> spread or reach out, of branches, with <suak> come out to) (q:draft)
Zamzummim = (i:1) (t:name) (c:people) (w:Zamzummites) (d:name the Ammonites gave to the Rephaites, a tall and numerous people who lived in their land before them) (r:5.2.20)
Zan = (i:1) (t:n) (w:night) (d:<zan>, night, written with a capital at the start of a sentence, and in Genesis 1:5 as the name God gave to the darkness) (a:Sun) (b:zan) (q:draft)
zana = (i:1) (t:adv) (w:yesterday/last night) (d:<zan> night with <a>: in the night just past, yesterday; {tua zana} is of that night) (s:zani) (a:zingciang) (b:zan) (q:draft)
Zanaan = (i:1) (t:name) (c:city) (w:Zaanan) (d:town of Judah named by the prophet Micah among the towns that face judgment) (r:33.1.11)
zancip = (i:1) (t:v) (w:be broken/be crushed) (d:said of Jerusalem brought to ruin, followed by <gawp> utterly) (q:draft, low confidence)
zaneite = (i:1) (t:n) (w:officials/officers) (d:{za nei}, hold a rank or title, with plural {-te}: those who hold office) (s:uliante) (q:draft)
zaneu = (i:1) (t:n) (w:low rank/lowest place) (d:<za> rank with <neu> small; {a zaneu pen} is the lowest in rank) (a:zalian) (q:draft, low confidence)
zang = (i:1) (t:v) (w:use/employ) (d:make use of a thing, a name or a person for some purpose; <zat> is the form used before <ding> and <nading>) (r:26.16.15) (q:draft)
zang = (i:2) (t:n) (w:middle) (d:the very middle, used after <lai> as {lai zang}) (q:draft, low confidence)
zanga = (i:1) (t:num) (w:five hundred) (d:<za>, hundred, with <nga>, five)
zangah = (i:1) (t:prep) (w:in the middle of/among/in the midst of) (d:<zang> with the place marker <ah>, mostly as {lai zangah}) (s:lakah) (b:zang) (q:draft)
zangah = (i:2) (t:prep) (w:on top of/on/upon) (d:<zang> flat open surface with the place marker <ah>: {innkhum zangah} is on the flat roof of a house, {kulh zangah} on top of the wall) (s:tungah) (q:draft)
zangawp = (i:1) (t:v) (w:waste away/be worn out) (d:said of a garment eaten by moths and of a person who wastes away) (q:draft, low confidence)
zangawpte = (i:1) (t:n) (w:those who are crushed/the worn out) (d:<zangawp> with the plural <te>; {lungsim zangawpte} is those crushed in spirit) (b:zangawp) (q:draft, low confidence)
zangin = (i:1) (t:v) (w:using/by means of/with) (d:verb <zang>, use, with the linking suffix <in>; {min zangin} is invoking a name) (s:zatin) (b:zang) (q:draft)
zangkha = (i:1) (t:v) (w:get to use/enjoy) (d:<zang> use, with <kha> happen to, get to; in the verses always denied: not get to use) (q:draft)
zangkhai = (i:1) (t:adv) (w:lightly/in vain) (d:literally light, not heavy; before <zat> use or <ngaihsut> think it means to treat as unimportant, to misuse or make light of) (q:draft)
zangkhawm = (i:1) (t:v) (w:share/use together/have in common) (d:<zang>, use, with <khawm>, together) (s:neikhawm) (b:zang) (q:draft)
zangkhia = (i:1) (t:v) (w:use up/spend) (d:<zang> use, with <khia> out) (s:zangkhin/zangmang/zatmang) (b:zang) (q:draft)
zangkhin = (i:1) (t:v) (w:use up/spend all) (d:<zang> use with <khin>, completely) (s:zangkhia/zangmang/zatmang) (b:zang) (q:draft)
zangkik = (i:1) (t:v) (w:use again/take up again) (d:<zang> use with <kik> again) (b:zang) (q:draft)
zangkuam = (i:1) (t:n) (w:valley) (d:<zang> plain with <kuam> valley; {leihoih zangkuam} is a fertile valley) (s:kuam/mualkuam) (r:23.28.3) (q:draft)
zanglei = (i:1) (t:n) (w:plain/lowland/flat land) (d:<zang>, flat, with <lei>, ground: a stretch of level land, a plain or lowland, as the plain of the Jordan and the plains of Moab) (q:draft)
Zanglei = (i:1) (t:n) (w:plain) (d:<zanglei>, plain or lowland, capitalised as the name of a region, the Plain of the Jordan valley and the coastal plain of Philistia) (b:zanglei) (q:draft)
zangleite = (i:1) (t:n) (w:plains/lowlands/plateau) (d:<zanglei> plain, with plural <te>) (b:zanglei) (q:draft)
zanglo = (i:1) (t:v) (w:not use) (d:<zang> use with the negative <lo>, written as one word; {thutang zanglo} is not deal justly) (b:zang) (q:draft)
zangmang = (i:1) (t:v) (w:squander/use up/waste) (d:<zang>, use, with <mang>, away or lost: use up until it is gone; in Mark 12:40 of consuming the property of widows) (s:zatmang/zangkhin/zangkhia) (q:draft)
zangmul = (i:1) (t:n) (w:mane) (d:the long hair on the neck of a horse; <mul> is hair) (s:zaangmul) (q:draft)
zangnuam = (i:1) (t:v) (w:want to use/wish to devote) (d:<zang> use with <nuam> want) (q:draft)
zangpa = (i:1) (t:n) (w:user/one who uses) (d:<zang>, use, with <pa>, the male one who does it: {a zangpa} is the one who uses or wields it) (b:zang) (q:draft)
zangpah = (i:1) (t:v) (w:use at once/put to use immediately) (d:<zang> use with <pah> at once) (q:draft)
zangpi = (t:see) <zangpi-in>
zangpi-in = (i:1) (t:adv) (w:all together/as a whole) (d:used after <khua> town: {khua zangpi-in} is the whole town, all the people of the town) (q:draft, low confidence)
zangsak = (i:1) (t:v) (w:lighten/make lighter/ease) (d:<zang>, light in weight, with the causative <sak>: make a load, a yoke or a punishment less heavy) (a:giksak) (r:14.10.9) (q:draft)
zangsak = (i:2) (t:v) (w:let use/let enjoy/cause to be used) (d:<zang>, use, with the causative <sak>: let someone use or enjoy something, or make a thing serve as something) (b:zang) (q:draft, low confidence)
zangsawm = (i:1) (t:adj) (w:ten-stringed) (d:of a harp or lyre with ten strings; <sawm> is ten) (q:draft)
zangsial = (i:1) (t:n) (c:animal) (w:wild ox) (d:a wild ox, named as a picture of strength; <sial> is the mithun) (s:gamsial) (q:draft)
zangsung = (i:1) (t:n) (w:field/open country) (d:<zang> plain or level land with <sung> inside; {zangsung sa} is the creatures of the field) (q:draft, low confidence)
zangte = (i:1) (t:n) (w:those who use/users) (d:<zang> use with plural <te>, after <a>; {a zangte} is the people who use something) (b:zang) (q:draft)
zangteep = (i:1) (t:n) (w:foreskin) (d:the foreskin, cut off in circumcision; <zangvun> is the same) (s:vundawn/zangvun) (q:draft)
zangthei = (i:1) (t:v) (w:can use/be able to use) (d:<zang>, use, with <thei>, can) (b:zang) (q:draft)
zangvun = (i:1) (t:n) (w:foreskin) (d:with <vun> skin; here in {zangvun teepte}, foreskins) (s:vundawn/zangteep) (q:draft)
zangzaw = (i:1) (t:adj) (w:lighter) (d:<zang>, light in weight, with <zaw>, more; after <sangin>, than) (a:gikzaw) (q:draft)
zangzaw = (i:2) (t:v) (w:use rather/use instead) (d:<zang>, use, with <zaw>, rather: use it for this and not for that) (b:zang) (q:draft)
zanhak = (i:1) (t:v) (w:stay awake at night/keep awake) (d:<zan> night with <hak> be awake) (q:draft)
zanhal = (i:1) (t:adv) (w:the other day/a few days ago) (d:on a day not long past) (q:draft, low confidence)
zani = (i:1) (t:adv) (w:yesterday) (d:the day before today; {zani, tuni} is yesterday and today) (s:zana) (a:zingciang) (q:draft)
zanih = (i:1) (t:num) (w:two hundred) (d:<za>, hundred, with <nih>, two) (r:4.4.44) (q:draft)
zanihte = (i:1) (t:num) (w:two hundred) (d:<zanih>, two hundred, with the plural <te>, of people: {mi zanihte} is the two hundred men) (b:zanih) (q:draft)
zanin = (i:1) (t:adv) (w:at night/during the night) (d:<zan>, night, with the marker <in>) (b:zan) (q:draft)
zanin = (i:2) (t:v) (w:stretch out/reach out) (d:the verb <zan>, stretch out, with the linking ending <in>; said of the hand) (q:draft)
zaninah = (i:1) (t:adv) (w:on the night/at night) (d:<zanin> at night, with the place and time marker <ah>; after a day count, on the night of that day) (b:zanin) (q:draft)
zankhang = (i:1) (t:n) (w:late night/dead of night) (d:used paired with <zankim> midnight: {zankim zankhang dongin} is far into the night) (q:draft, low confidence)
zankhia = (i:1) (t:v) (w:stretch out/reach out) (d:<zan> stretch out a hand or arm, with <khia> out; lift a finger against someone) (a:dokkik) (q:draft)
zankhiat = (i:1) (t:v) (w:stretch out/reach out) (d:form of <zankhia> used before a noun: {a zankhiat a khut} is the hand he stretched out) (b:zankhia) (q:draft)
zankhua = (t:see) <zankhua-in>
zankhua-in = (i:1) (t:adv) (w:all night/the whole night) (d:<zan> night with <khua>, and the marker <in>) (s:zanthapai/zankhuavak) (q:draft)
zankhuavak = (i:1) (t:adv) (w:all night/through the night) (d:<zan> night with <khuavak> daylight: the whole night until it is light) (s:zanthapai/zankhua-in) (r:21.10.16) (q:draft)
zankimpi = (t:see) <zankimpi-in>
zankimpi-in = (i:1) (t:adv) (w:in the middle of the night/at midnight) (d:{zan kim} midnight with <pi> and the marker <in>) (q:draft)
zanna = (i:1) (t:n) (w:stretching out/holding out) (d:<zan> stretch out, hold out, with the noun suffix <na>; {teipi a zanna a khut} is the hand with which he held out the spear) (q:draft)
Zannes = (i:1) (t:name) (c:male) (w:Jannes) (d:one of the Egyptian magicians who opposed Moses, named together with Jambres) (r:55.3.8)
Zanoah = (i:1) (t:name) (c:land) (w:Zanoah) (d:name of two towns of Judah, one in the western foothills and one in the hill country) (r:6.15.34/6.15.56)
zanpah = (i:1) (t:v) (w:stretch out at once) (d:<zan>, stretch out, with <pah>, at once: stretch out the hand immediately) (q:draft)
zanpi = (i:1) (t:n) (w:night/dead of night) (d:<zan>, night, with <pi>, great: {zanpi mahin} is in the night itself, while it was still night) (a:sun/suntangpi) (b:zan) (q:draft)
zansak = (i:1) (t:v) (w:make stretch out/cause to hold out) (d:<zan> stretch out the hand, with causative <sak>) (q:draft)
zantaamsak = (i:1) (t:v) (w:keep overnight) (d:<zan> night, <taam> stay and <sak> cause: let something stay with one through the night) (q:draft)
zanthapai = (i:1) (t:adv) (w:all night/the whole night) (d:through the whole night, often followed by <in>) (s:zankhuavak/zankhua-in) (q:draft)
zantuam = (i:1) (t:v) (w:become lighter/be lightened) (d:said of a ship whose cargo is thrown out) (q:draft)
zanuam = (i:1) (t:v) (w:want to hear/like to hear) (d:<za> hear with <nuam> want or like) (s:zaknop) (q:draft)
zanuamin = (i:1) (t:v) (w:wanting to hear) (d:<zanuam> want to hear, with the linking ending <in>) (b:zanuam) (q:draft)
zap = (i:1) (t:v) (w:flap/flutter/beat) (d:move the wings up and down: {kha a zap}, flap the wings) (q:draft)
zap = (i:2) (t:v) (w:winnow/fan) (d:blow or fan away chaff; {buhphual zap siang}, clear the threshing floor by winnowing) (s:zapsiang/haih) (q:draft)
zapa = (i:1) (t:n) (w:hearer/one who hears) (d:<za> hear with <pa>, the male one who does it; {thungetna a zapa} is the one who hears prayer) (b:za) (q:draft)
Zaphon = (i:1) (t:name) (c:mountain) (w:Zaphon) (d:mountain in the far north, to whose heights Mount Zion is compared) (r:19.48.2)
zapi = (i:1) (t:adj) (w:wide/spacious/vast) (d:of rooms and of a realm: very wide, of great extent) (s:zai/zaipi/tanzau) (a:kawcik) (q:draft)
zapin = (i:1) (t:v) (w:fanning/blowing) (d:<zap> fan, with the linking ending <in>; {pum zap} is work the bellows to blow a fire) (s:zaap-in) (b:zap) (q:draft)
zapna = (i:1) (t:n) (w:flapping/beating) (d:<zap> flap, with the noun suffix <na>; {kha zapna} is the beating of wings) (s:khazapna) (b:zap) (q:draft)
zapsiang = (i:1) (t:v) (w:winnow/fan clean/clear) (d:clean grain or a threshing floor by fanning away the chaff) (s:haih/zap) (b:zap) (q:draft)
zaptel = (i:1) (t:adj) (w:swift/fast/quick) (d:able to move very fast, said of horses, runners and pursuers) (s:taihat) (q:draft)
zaptelsak = (i:1) (t:v) (w:make swift/make nimble) (d:<zaptel> swift, with causative <sak>) (b:zaptel) (q:draft)
zaptelte = (i:1) (t:n) (w:swift ones/swift horses) (d:<zaptel> swift, with plural <te>; {sakol zaptelte} is swift horses) (b:zaptel) (q:draft)
zaptelzaw = (i:1) (t:adj) (w:swifter/faster) (d:<zaptel> swift, with <zaw> more) (b:zaptel) (q:draft)
Zarah = (i:1) (t:name) (c:male) (w:Zerah) (d:son of Judah and Tamar, twin brother of Perez) (r:1.46.12)
Zarefat = (i:1) (t:name) (c:city) (w:Zarephath) (d:Phoenician town on the coast near Sidon, named in Obadiah as the northern limit of the land) (q:draft)
Zarefath = (i:1) (t:name) (c:city) (w:Zarephath) (d:town belonging to Sidon, where Elijah stayed with a widow) (r:11.17.9/11.17.10)
Zarephat = (i:1) (t:name) (c:city) (w:Zarephath) (d:town in the region of Sidon, where Elijah was sent to a widow) (r:42.4.26)
Zarethan = (i:1) (t:name) (c:city) (w:Zarethan) (d:town in the Jordan valley, near Adam and Sukkoth) (r:11.4.12/11.7.46)
zasa = (i:1) (t:v) (w:have heard/heard) (d:<za> hear, with <sa> marking what is already done) (s:zaksa/zakhin/zazo) (b:za) (q:draft)
zasagih = (i:1) (t:num) (w:seven hundred) (r:7.20.16)
zasak = (i:1) (t:v) (w:inform/announce/proclaim/report) (d:<za>, hear, with causative <sak>: cause to hear, make known; {thu zasak} is to report or announce a matter) (s:zaksak/zahsak/theihsak) (b:za) (r:42.2.10) (q:draft)
zasakin = (i:1) (t:v) (w:report/announce/inform) (d:<zasak>, make known, with the linking ending <in>, which joins it to the following verb: {thu zasakin} is reporting the matter, letting someone hear it) (b:zasak) (q:draft)
zasakkhol = (i:1) (t:v) (w:announce beforehand/tell in advance) (d:<za> hear, <sak> cause and <khol> beforehand: let someone hear ahead of time) (s:genkhol) (q:draft)
zasakkik = (i:1) (t:v) (w:report back/let hear again) (d:<zasak> cause to hear, inform, with <kik> back or again) (b:zasak) (q:draft)
zasakkikin = (i:1) (t:v) (w:reporting back/report) (d:<zasakkik> report back, with <in> linking it to the words that follow) (b:zasakkik) (q:draft)
zasan = (i:1) (t:n) (w:red paint/vermilion) (d:red colour smeared on a house; <san> is red) (q:draft)
zasate = (i:1) (t:n) (w:those who have heard) (d:<zasa> have heard, with plural <te>) (b:zasa) (q:draft)
zasawm = (i:1) (t:num) (w:ten hundred/one thousand) (d:<za> hundred with <sawm> ten; {tul zasawm}, thousand times ten hundred, stands for a countless host) (q:draft, low confidence)
zasim = (i:1) (t:v) (w:overhear/hear secretly) (d:<za> hear with <sim> secretly) (s:ngaisim) (q:draft)
zasimin = (i:1) (t:v) (w:listening in/overhearing) (d:<zasim> hear secretly, with the linking ending <in>) (b:zasim) (q:draft)
zat = (i:1) (t:v) (w:use) (d:form of <zang>, use, taken before <ding>, <nading> and similar words) (r:43.13.29) (q:draft)
zate = (i:1) (t:n) (w:hearers/those who heard) (d:<za>, hear, with plural <te>: {a zate} is those who heard) (s:thungaite) (b:za) (r:44.5.11) (q:draft)
zathei = (i:1) (t:v) (w:be able to hear/can hear) (d:<za> hear with <thei> can) (b:za) (q:draft)
zathum = (i:1) (t:num) (w:three hundred)
zathumte = (i:1) (t:num) (w:the three hundred/three hundred) (d:<zathum> with <te>, for a group of three hundred people already counted or known) (b:zathum) (q:draft)
zatin = (i:1) (t:v) (w:using/spending) (d:<zat> use, with <in> linking it to the next verb; {uang zatin} is using lavishly) (b:zat) (q:draft)
zatkhak = (i:1) (t:v) (w:happen to use/have to use) (d:<zat> use with <khak>, as it turns out) (q:draft)
zatmang = (i:1) (t:v) (w:spend all/squander/use up) (d:<zat> use with <mang>, away until it is gone) (s:phengzat/lawnmang) (a:khol) (q:draft)
zatna = (i:1) (t:n) (w:use/using/way of using) (d:<zat>, use, with the noun suffix <na>: the using of something, or the way it is used) (s:kizatna/zatzia) (b:zat) (q:draft)
zatnate = (i:1) (t:n) (w:uses/practices) (d:<zatna>, use, with the plural <te>: {kam kihhuai zatnate} is the use of filthy language, {tawitehna man lo zatnate} the use of false measures) (b:zatna) (q:draft)
zatnop = (i:1) (t:v) (w:want to use) (d:<zat> use with <nop> want) (q:draft)
zato = (i:1) (t:n) (w:physician/doctor) (d:one who heals the sick; often {zato siam} or {zato mangpa}) (s:siavuan/siavuanpa) (q:draft)
Zatopa = (i:1) (t:name) (w:Zatopa/Physician) (d:<zato>, physician, with <pa>, used as a form of address in the proverb Physician, heal yourself) (r:42.4.23)
zatote = (i:1) (t:n) (w:physicians/doctors) (d:<zato>, physician, with the plural <te>) (s:siavuante) (b:zato) (q:draft)
zatpen = (i:1) (t:n) (w:agent/one most used) (d:<zat> use with <pen> most: the one a person makes most use of; {kumpipa zatpen} is the king’s agent) (b:zat) (q:draft, low confidence)
zatsak = (i:1) (t:v) (w:put to use/make use of) (d:<zat> use with <sak> cause) (b:zat) (q:draft, low confidence)
zatsiamte = (i:1) (t:n) (w:good stewards/those who use well) (d:<zat> use, <siam> skilled and the plural <te>) (q:draft)
zattawm = (i:1) (t:v) (w:use for oneself) (d:<zat>, use, with <tawm>, by or for oneself; {zattawm dingin koih} is keep for one’s own use, said of the chariots and horses Solomon kept) (q:draft, low confidence)
zatte = (i:1) (t:n) (w:things used/tools/utensils) (d:<zat>, use, with the plural <te>, the things that are used; {na zatte}, also written {na-zatte}, is tools or furnishings) (s:nazatte) (b:zat) (q:draft)
zattheih = (i:1) (t:v) (w:can be used/be usable/be able to use) (d:<zat> use with <theih> can, mostly before <ding> or <nading>: so that it can be used, fit for use) (b:zat) (q:draft)
Zattu = (i:1) (t:name) (c:male) (w:Zattu) (d:head of a family whose descendants returned from the exile with Zerubbabel; also a leader who sealed the covenant under Nehemiah) (r:15.8.5/16.10.14)
zatui = (i:1) (t:n) (w:medicine/balm/ointment) (d:a healing substance such as medicine, balm or ointment; {zatui siam} is a physician and {zatui tawh bawl} is to embalm a body) (r:1.50.2) (q:draft)
zatval = (i:1) (t:n) (w:surplus/excess) (d:<zat> use with <val> over: what is left over beyond what one uses) (s:neihval/lamval) (q:draft)
zatzia = (i:1) (t:n) (w:usage/way of using) (d:<zat> use with <zia> manner; {kam zatzia} is the use of words) (s:zatna/kizatna) (q:draft)
zau = (i:1) (t:v) (w:spread out/spread wide) (d:of branches, spread wide; {vak zau} is wander about everywhere) (r:20.5.16) (q:draft, low confidence)
zausak = (i:1) (t:v) (w:make spread out/make abundant) (d:<zau> spread wide, with causative <sak>, said of branches) (b:zau) (q:draft)
zauvak = (i:1) (t:v) (w:wander off/go astray) (d:<zau> spread about with <vak> walk about: wander each his own way) (q:draft, low confidence)
zavei = (i:1) (t:adv) (w:a hundred times) (d:<za> hundred with <vei> time) (s:zakhatin) (q:draft)
zaw = (i:2) (t:adj) (w:weak) (d:without strength, limp or feeble, said mostly of the hands and of bodily strength) (s:thanem/thazawng) (a:hat/thahat/khauh)
zawcipsak = (i:1) (t:v) (w:make bent/make weak for good) (d:<zaw>, weak, with <cip>, firmly or for good, and causative <sak>: make limp or bent for good, said of the back or loins) (s:kulsak) (q:draft, low confidence)
zawdeuh = (i:1) (t:adv) (w:rather more/somewhat more) (d:comparative <zaw>, more, with <deuh>, somewhat; placed after a descriptive word or verb, a little more, rather) (q:draft, low confidence)
zawdeuhte = (i:1) (t:n) (w:those who are more) (d:<zawdeuh> rather more, with the plural <te>, after a descriptive word: {khangham zawdeuhte} is the more senior ones) (s:zawdiakte/deuhte) (b:zawdeuh) (q:draft, low confidence)
zawdiakte = (i:1) (t:n) (w:those who are more) (d:<zaw> more with <diak> especially and plural <te>; {khangham zawdiakte} is those who are older, the elders) (s:zawdeuhte/deuhte) (q:draft)
zawh = (i:1) (t:v) (w:rule over/win/overcome/defeat) (d:form of <zo>, win or overcome, used before <ding>, {uh ciangin} and similar words) (s:gualzawh/gualzo) (a:guallel/guallelh)
zawhgawp = (i:1) (t:v) (w:overpower/conquer/defeat completely) (d:<zawh> overcome with <gawp> marking forceful or thorough action) (s:galzawh) (b:zawh) (q:draft)
zawhin = (i:1) (t:v) (w:having finished/being able to) (d:<zawh>, the form of <zo>, be able, overcome or finish, with the linking suffix <in>; {a teek zawhin} is after he had grown old, {hehnep zawhin om lo} is could not be comforted) (b:zawh) (q:draft, low confidence)
zawhkhit = (i:1) (t:v) (w:finish/complete) (d:<zawh> finish with <khit> done; {a zawhkhit ciangin} is when it has been finished) (s:mankhit/zosiang) (q:draft)
zawhleh = (i:1) (t:conj) (w:if possible/if able) (d:<zawh> be able with <leh> if; {ahih zawhleh} is if it can be) (q:draft)
zawhloh = (i:1) (t:adj) (w:unable/that cannot be done) (d:<zawh> be able with <loh> not, after a verb; {sim zawhloh} is too many to count) (s:theiloh) (q:draft)
zawhna = (i:1) (t:n) (w:victory/conquest) (d:the act of overcoming or of being able to do something) (s:gualzawhna/galzawhna) (a:guallelhna/lelhna) (b:zawh) (r:19.18.50) (q:draft)
zawhnop = (i:1) (t:adj) (w:easy to overcome) (d:<zawh> overcome with <nop> easy) (q:draft)
zawhpih = (i:1) (t:v) (w:help finish/help complete) (d:<zawh> finish, with <pih> do together with or for someone) (b:zawh) (q:draft)
zawhpih = (i:2) (t:v) (w:help conquer/help subdue) (d:<zawh> win, overcome, with <pih> do together with someone) (b:zawh) (q:draft)
zawhsa = (i:1) (t:adj) (w:conquered/subdued) (d:<zawh>, overcome, with <sa> for a completed state: already conquered) (b:zawh) (q:draft)
zawhsa = (i:2) (t:adj) (w:finished/completed) (d:<zawh>, finish, with <sa> for a completed state: already completed) (s:kiman) (b:zawh) (q:draft, low confidence)
zawhsak = (i:1) (t:v) (w:subdue/make subject) (d:<zawh>, overcome, with <sak>: cause to be overcome, or overcome on behalf of someone) (s:nuaisiah/ukcip) (b:zawh) (q:draft)
zawhte = (i:1) (t:n) (w:things finished/completed works) (d:<zawh> finish, with plural <te>: the things he completed) (b:zawh) (q:draft)
zawhthawh = (i:1) (t:n) (w:force/compulsion/coercion) (d:{zawhthawh thu tawh} or {thu-in} means by force) (s:zawhthawhna/sawlzawh) (a:utthu/uttawmna) (r:40.5.41) (q:draft)
zawhthawh = (i:2) (t:v) (w:force/compel/oppress) (d:press hard on someone, force or oppress; more often found with <bawl>, as {zawhthawh bawl}) (s:hahbawl) (q:draft, low confidence)
zawhthawhna = (i:1) (t:n) (w:compulsion/force/oppression) (d:forcing someone against his will; {zawhthawhna tawh} is by force, under compulsion) (s:zawhthawh/sawlzawh) (a:uttawmna) (b:zawhthawh) (q:draft)
zawhtheih = (i:1) (t:v) (w:be able to overcome/can subdue) (d:<zawh> win over, with <theih> can) (s:zawhzawh) (b:zawh) (q:draft)
zawhtheihna = (i:1) (t:n) (w:ability to accomplish/being able to do) (d:<zawhtheih> be able to overcome or accomplish, with the noun suffix <na>) (b:zawhtheih) (q:draft)
zawhzah = (i:1) (t:adv) (w:as much as one is able) (d:<zawh> be able with <zah> amount; {a piak zawhzah} is as much as they could give) (q:draft)
zawhzawh = (i:1) (t:v) (w:be able to overcome/prevail against) (d:form of <zo> overcome followed by <zo> be able, used before <loh>, <lohna> or <nading>) (s:zawhtheih) (q:draft)
zawhzawh = (i:2) (t:v) (w:be able to finish/be able to complete) (d:form of <zo> finish followed by <zo> be able) (q:draft, low confidence)
zawin = (i:1) (t:adv) (w:more) (d:comparative <zaw>, more than, with the adverb suffix <in>; after a descriptive word, more so, to a greater degree) (b:zaw) (q:draft)
zawk = (i:1) (t:adv) (w:more) (d:form of <zaw> used after a descriptive word or verb when <leh>, <ding>, <nading> or <kei> follows; more, to a greater degree, as in {a thuk zawk} deeper) (b:zaw) (q:draft)
zawkan = (i:1) (t:adv) (w:how much more/all the more/even more) (d:placed after a verb in a comparison to say that something applies to an even greater degree; after a negative verb, how much less) (s:zawtham/kanzaw) (q:draft)
zawkna = (i:1) (t:n) (w:being more/advantage/preference) (d:<zawk> more with the noun ending <na>; after a descriptive word or verb it names the fact of being more so, as in {tam zawkna} being more numerous, {nuam zawkna} greater joy and {deih zawkna} preference) (b:zawk) (q:draft)
zawl = (i:1) (t:n) (w:pole/bar/crossbar) (d:a long piece of wood: a pole for carrying a load, a crossbar that holds frames together, or the bar of a city gate) (s:singzawl) (q:draft)
zawl = (i:2) (t:n) (w:rim/ledge/border) (d:the raised edge or ledge that runs round a table or an altar) (s:zawlpeek) (q:draft)
zawl-aikungte = (i:1) (t:n) (c:plant) (w:mandrakes/mandrake plants) (d:{zawl-ai}, mandrake, with <kung>, plant, and the plural <te>: mandrake plants, which Reuben found in the field) (q:draft)
zawlah = (i:1) (t:n) (w:on the beam/on the pole) (d:<zawl>, pole or beam, with the place marker <ah>: on the beam; in {bangtung zawlah} birds perch on the top beams of a ruined building) (b:zawl) (q:draft, low confidence)
zawlai = (i:1) (t:adv) (w:even more/still more/more) (d:<zaw>, more, with <lai>, still: placed after a verb or descriptive word to say even more or still more so) (s:semsem/kanzaw) (q:draft)
zawlin = (i:1) (t:adv) (w:as a friend) (d:<zawl>, friend or companion, with the suffix <in>: as a friend; {zawlin kiman} is be friends with, and {zawlin man} is receive as a friend, welcome) (q:draft, low confidence)
zawlmit = (t:see) <zawlmit-in>
zawlmit-in = (i:1) (t:v) (w:eyeing with desire/lusting after) (d:<zawlmit>, look at someone with desire, with the linking ending <in>: looking with desire at another man's wife) (q:draft, low confidence)
zawlmitin = (i:1) (t:v) (w:eyeing with desire/lusting after) (d:<zawlmit>, look at someone with desire, with the linking ending <in>: looking with desire at another man's wife) (q:draft, low confidence)
zawlmitna = (i:1) (t:n) (w:alluring glance/captivating look) (d:<zawlmit>, look at someone with desire, with the noun suffix <na>: an enticing look of the eyes) (q:draft, low confidence)
zawlpeek = (i:1) (t:n) (w:rim/frame/border) (d:<zawl>, rim, with <peek>, flat piece: the flat rim or frame round the top of the table) (s:zawl) (q:draft)
zawlta = (i:1) (t:adj) (w:fatherless/illegitimate) (d:born outside marriage, of a woman who is not the wife of the father)
zawlta = (i:2) (t:n) (w:illegitimate/illegitimate child) (d:a child born outside marriage, not a true son or daughter)
zawltai = (i:1) (t:v) (w:run away together/elope) (d:said by a woman to her lover in {zawltai ni}, let us run off together; from <zawl>, lover, and <tai>, run) (q:draft, low confidence)
zawlte = (i:1) (t:n) (w:poles/bars/rods) (d:<zawl>, pole or bar, with the plural <te>: the carrying poles of the ark, the table and the altar, and the bars of a city gate) (s:singzawlte) (q:draft)
Zawlzawng = (i:1) (t:name) (c:star) (w:Orion) (d:constellation named in Job together with the Bear and the Pleiades) (r:18.9.9/18.38.31)
Zawlzawngte = (i:1) (t:name) (c:star) (w:Orion) (d:<Zawlzawng>, Orion, with the plural <te>: the stars of Orion) (b:Zawlzawng) (q:draft)
zawm = (i:1) (t:adj) (w:weak/faint/feeble) (d:without strength, said of the body and of the conscience) (s:thanem/thaneem/zawngkhal/thazawng) (a:thahat/hat) (q:draft)
zawmte = (i:1) (t:n) (w:the weak/the faint) (d:<zawm>, weak, with the plural <te>: those who are weak; {lungsim zawmte} is the fainthearted) (s:thanemte/thaneemte/zawngkhalte) (a:thahatte) (b:zawm) (q:draft)
zawn = (i:1) (t:v) (w:be poor) (d:form of <zawng>, poor, written {zawn’} before <na>, <mahmah> and similar words; {zawn’na} is poverty) (a:hauh) (q:draft)
zawngin = (i:1) (t:v) (w:being poor/becoming poor) (d:<zawng>, poor, with the linking ending <in>: being or becoming poor, and so something else follows) (b:zawng) (q:draft)
zawngkhal = (i:1) (t:adj) (w:weak/feeble/powerless/helpless) (d:without strength or power; also used as a verb, grow weak or be worn out) (s:thanem/thaneem/thazawng/zawm) (a:thahat/hat/ngalhat) (q:draft)
zawngkhalin = (i:1) (t:adv) (w:destitute/in helplessness) (d:<zawngkhal> weak and helpless, with the ending <in>) (b:zawngkhal) (q:draft)
zawngkhalna = (i:1) (t:n) (w:infirmity/sickness/weakness) (d:weakness or sickness of the body; of crops, {ankung zawngkhalna} is blight or mildew) (s:thanemna/thaneemna) (a:thahatna/hatna) (b:zawngkhal) (r:14.6.28) (q:draft)
zawngkhalna = (i:2) (t:n) (w:poverty) (d:the state of being poor and without power) (s:zawnna) (a:hauhna) (b:zawngkhal) (q:draft)
zawngkhalsak = (i:1) (t:v) (w:make weak/weaken) (d:<zawngkhal>, weak, with the causative <sak>: make weak or powerless) (s:zawsak/thanemsak/thaneemsak/thazawsak) (a:thahatsak/hatsak) (b:zawngkhal) (q:draft)
zawngkhalte = (i:1) (t:n) (w:the weak/weak ones) (d:<zawngkhal>, weak or feeble, with the plural suffix <te>) (s:thanemte/thaneemte/zawmte) (a:thahatte) (b:zawngkhal) (q:draft)
zawnglua = (i:1) (t:adj) (w:too poor/very poor) (d:<zawng>, poor, with <lua>, too or very) (a:haulua) (b:zawng) (q:draft)
zawngmaw = (i:1) (t:n) (c:animal) (w:ape/monkey) (d:animal brought by the ships of Tarshish together with ivory and peacocks) (q:draft)
zawngpa = (i:1) (t:n) (w:poor man/poor person/the poor) (d:<zawng>, poor, with <pa>, which marks a man: a poor man; often {mi zawngpa} or {sanggam zawngpa}, a poor brother) (s:mizawngpa) (a:haupa/mihaupa) (b:zawng) (q:draft)
zawngpen = (i:1) (t:adj) (w:poorest) (d:<zawng>, poor, with <pen>, most: poorest) (a:haupen/hauhpen) (b:zawng) (q:draft)
zawngpente = (i:1) (t:n) (w:the poorest/poorest people) (d:<zawng>, poor, with <pen>, most, and the plural <te>: those who are the poorest) (s:mizawngpen) (b:zawngpen) (q:draft)
zawngpi = (i:1) (t:n) (c:animal) (w:baboon/ape) (d:large kind of monkey, brought by the ships of Tarshish together with <zawngmaw>) (q:draft, low confidence)
zawngsak = (i:1) (t:v) (w:make poor/impoverish) (d:<zawng>, poor, with the causative <sak>: make someone poor, take away what he has) (a:hausak) (b:zawng) (q:draft)
zawngsakin = (i:1) (t:v) (w:making poor/impoverishing) (d:<zawngsak>, make poor, with the linking suffix <in>: making poor, and then another action follows) (a:hausakin) (b:zawngsak) (q:draft)
zawngte = (i:1) (t:n) (w:the poor/poor people) (d:<zawng>, poor, with the plural <te>: poor people, usually as {mi zawngte} or {a zawngte}) (s:mizawngte/cimawhte) (a:haute/mihaute) (b:zawng) (q:draft)
zawnin = (i:1) (t:v) (w:taking along/taking with) (d:<zawn>, take someone along as a companion, with the linking suffix <in>) (s:tonpihin) (q:draft)
zawnna = (i:1) (t:n) (w:poverty/destitution) (d:<zawn>, be poor, with the noun suffix <na>: the state of being poor) (s:khiukheuna/zawngkhalna) (a:hauhna) (b:zawn) (r:66.2.9) (q:draft)
zawnnate = (i:1) (t:n) (w:poverty/hardships) (d:<zawnna> poverty, with the plural <te>) (a:hauhnate) (b:zawnna) (q:draft)
zawpa = (i:1) (t:n) (w:the greater one/one who is more) (d:<zaw> more, with <pa> for a man, placed after a descriptive word: {a lian zawpa} is the one who is greater) (b:zaw) (q:draft)
zawpek = (i:1) (t:adv) (w:far more/much more) (d:<zaw> more, with the intensifier <pek>, placed after a descriptive word: {manpha zawpek} is worth far more) (q:draft)
zawsak = (i:1) (t:v) (w:weaken/make weak/make limp) (d:<zaw>, weak, with the causative <sak>: make weak or powerless; {khut zawsak} is let the hands drop, give up) (s:thazawsak/zawngkhalsak/thanemsak/thaneemsak) (a:hatsak/thahatsak) (b:zaw) (q:draft)
zawsang = (i:1) (t:adv) (d:placed after a descriptive word, apparently <zaw> more with a further element: {a hoih zawsang om tuan lo}, nothing any better comes of it) (q:draft, low confidence)
zawsop = (i:1) (t:adv) (w:instead/rather/on the contrary) (d:placed after a verb to mark what is done or happens in place of what was expected or wanted) (r:38.13.5) (q:draft)
zawsopin = (i:1) (t:adv) (w:instead/rather) (d:<zawsop> instead, with <in> linking it to what follows) (b:zawsop) (q:draft)
zawt = (i:1) (t:v) (w:grope/feel for/search through) (d:feel about with the hands as a blind person does or as in the dark; also search through things by hand) (s:mialzawt/zawtzawt) (r:1.19.11) (q:draft)
zawte = (i:1) (t:part) (d:<zaw>, more, with the plural <te>, placed after a descriptive word or verb: those who are more so, as {a vanglian zawte}, the stronger ones, and {a it zawte}, those who love more) (b:zaw) (q:draft)
zawte = (i:2) (t:n) (w:the weak/the lame) (d:<zaw>, weak, with the plural <te>; {khe zawte} is those whose feet are weak, the lame) (s:thanemte/thaneemte) (a:thahatte) (b:zaw) (q:draft, low confidence)
zawtham = (i:1) (t:adv) (w:all the more/much more/much less) (d:<zaw> more, with <tham>, placed after a verb in a how much more comparison) (s:zawkan) (q:draft)
zawtzawt = (i:1) (t:v) (w:grope/feel about) (d:feel about with the hands again and again, as a blind person searching for a door) (s:zawt/mialzawt) (q:draft)
zawzen = (i:1) (t:adv) (d:placed after a verb and before <zong>, even if, to strengthen the supposition: {hong ding zawzen zongun}, even if they were actually to stand) (q:draft, low confidence)
zawzenin = (i:1) (t:adv) (w:even/so much that) (d:placed after a verb phrase: to such a degree that, not even; from <zaw> more and <zen> emphatic with <in>) (q:draft)
zaza = (i:1) (t:num) (w:hundreds/by hundreds) (d:<za>, hundred, said twice: by hundreds, in groups of a hundred each; often with <tultul>, by thousands) (q:draft)
zaza = (i:2) (t:v) (w:keep hearing/hear again and again) (d:<za>, hear, said twice to show hearing that is repeated or goes on and on) (s:zakzak) (r:26.7.26) (q:draft)
Zaza = (i:1) (t:name) (c:male) (w:Zaza) (d:son of Jonathan, a descendant of Jerahmeel of the tribe of Judah) (q:draft)
zazo = (i:1) (t:v) (w:have heard/heard) (d:<za>, hear, with <zo>, which marks the action as done or achieved: have heard) (s:zasa/zakhin/zaksa) (b:za) (r:23.37.11) (q:draft)
ze = (t:see) <ze-et>
Ze = (t:see) <Ze-eb>
Ze-eb = (i:1) (t:name) (c:male) (w:Zeeb) (d:Midianite leader captured and killed in the time of Gideon, together with Oreb) (r:7.8.3) (q:draft)
ze-et = (i:1) (t:v) (w:test/tempt/try) (d:put a person to the test, or tempt someone to do wrong; always written with a hyphen) (s:sin) (q:draft)
ze-etna = (i:1) (t:n) (w:temptation/trial/testing) (d:<ze-et>, test or tempt, with the noun suffix <na>: a temptation, a trial or a testing) (s:kize-etna) (b:ze-et) (q:draft)
ze-etnate = (i:1) (t:n) (w:trials/temptations/tests) (d:<ze-et>, test or tempt, with the noun suffix <na> and the plural suffix <te>) (q:draft)
Zeadad = (i:1) (t:name) (c:place) (w:Zedad) (d:place on the northern border of the promised land, also spelled <Zedad>) (r:4.34.8)
Zealot = (i:1) (t:name) (w:Zealot) (d:name given to Simon, one of the twelve apostles) (r:42.6.15/44.1.13)
Zeas = (i:1) (t:name) (w:Zeus) (d:chief god of the Greeks; the people of Lystra called Barnabas by this name) (r:44.14.12/44.14.13)
Zeba = (i:1) (t:name) (c:male) (w:Zebah) (d:king of Midian defeated by Gideon, named together with Zalmunna) (r:19.83.11) (q:draft)
Zebadiah = (i:1) (t:name) (c:male) (w:Zebadiah) (d:name of several men, among them two Benjamites and a priest of the family of Immer in the time of Ezra) (r:13.26.2/13.8.15)
Zebah = (i:1) (t:name) (c:male) (w:Zebah) (d:king of Midian captured and killed by Gideon, together with Zalmunna) (r:7.8.12/7.8.21)
Zebedi = (i:1) (t:name) (c:male) (w:Zebedee) (d:fisherman of Galilee, father of the apostles James and John) (r:40.4.21/40.26.37)
Zebeon = (i:1) (t:name) (c:male) (w:Zibeon) (d:son of Seir the Horite and father of Aiah and Anah) (r:13.1.40)
Zebidah = (i:1) (t:name) (c:female) (w:Zebidah) (d:mother of King Jehoiakim of Judah, daughter of Pedaiah of Rumah) (r:12.23.36)
Zebina = (i:1) (t:name) (c:male) (w:Zebina) (d:descendant of Nebo who had married a foreign wife in the time of Ezra) (r:15.10.43)
Zeboi = (i:1) (t:name) (c:male) (w:Zeboyim) (d:first part of {Zeboi-im}, Zeboyim, one of the cities of the plain named with Sodom, Gomorrah and Admah) (r:1.10.19)
Zeboiim = (i:1) (t:name) (c:male) (w:Zeboyim) (d:one of the cities of the plain; its king Shemeber fought beside the kings of Sodom and Gomorrah) (r:1.14.8)
Zeboiim = (i:2) (t:name) (c:land/city) (w:Zeboyim) (d:one of the cities of the plain, named with Sodom, Gomorrah and Admah on the border of Canaan) (r:1.10.19)
Zeboim = (i:1) (t:name) (c:place) (w:Zeboim) (d:town of Benjamin settled after the exile; also a valley in Benjamin facing the wilderness) (r:16.11.34/9.13.18)
Zebul = (i:1) (t:name) (c:male) (w:Zebul) (d:governor of the city of Shechem under Abimelek, who drove Gaal out of the city) (r:7.9.30) (q:draft)
Zebulun = (i:1) (t:name) (c:male) (w:Zebulun) (d:sixth son of Jacob and Leah, ancestor of the tribe of Zebulun; also the tribe and its territory) (r:1.30.20/2.1.3)
Zebulunte = (i:1) (t:name) (c:people) (w:Zebulun) (d:the people of the tribe of Zebulun) (b:Zebulun) (r:13.6.77)
Zedad = (i:1) (t:name) (c:place) (w:Zedad) (d:place on the northern border of the promised land) (r:4.34.8/26.47.15)
Zedekiah = (i:1) (t:name) (c:male) (w:Zedekiah) (d:name of several men, among them the last king of Judah and a false prophet in the time of Ahab) (r:14.18.10/13.3.16)
Zeeb = (i:1) (t:name) (c:male) (w:Zeeb) (d:Midianite leader killed at the winepress of Zeeb in the time of Gideon, together with Oreb) (r:7.7.25/19.83.11)
zeekna = (i:1) (t:n) (w:management/administration/handling) (d:the managing of property or money for another) (q:draft)
zeekte = (t:see) <zeekte-in>
zeekte-in = (i:1) (t:n) (w:stewards/those entrusted with) (d:<zeek> manage or have charge of, with the plural <te> and <in>, as: as those who have charge of something) (q:draft, low confidence)
zeel = (i:1) (t:v) (w:spread through/fill/pervade) (d:of news or a scent, reach every part of a place; written with a long vowel, the same word as <zel>) (s:kizeel/zel) (q:draft)
zeel = (i:2) (t:adv) (w:often/repeatedly/regularly) (d:placed after a verb for an action done time after time; written with a long vowel, the same word as <zel>) (s:zelzel/zel) (q:draft)
zeelin = (i:1) (t:adv) (w:often/repeatedly) (d:<zeel> often, with the linking suffix <in>) (s:zelzel) (b:zeel) (q:draft)
zeelsak = (i:1) (t:v) (w:spread/make known everywhere) (d:<zeel> spread through, with causative <sak>: cause news to spread through a place) (s:thangsak) (b:zeel) (q:draft)
zeem = (i:1) (t:v) (w:adorn/decorate/dress up) (d:make beautiful: used of a building, a tomb or the hair, and of dressing a person in fine clothes) (s:zem) (q:draft)
zeemin = (i:1) (t:v) (w:adorning/painting) (d:<zeem> adorn, with the linking suffix <in>; of the eyes, to put on eye paint) (s:zemin) (b:zeem) (q:draft)
zeemsak = (i:1) (t:v) (w:robe/dress/adorn) (d:<zeem> adorn, with <sak>: dress another person in fine clothes) (s:zemsak) (b:zeem) (q:draft)
Zefaniah = (i:1) (t:name) (c:male) (w:Zephaniah) (d:name of several men, among them a priest in the time of Jeremiah and the prophet Zephaniah) (r:13.6.36/12.25.18)
Zefath = (t:see) <Zefath-ah>
Zefath-ah = (i:1) (t:name) (c:city) (w:Zephath) (d:<Zefath>, Zephath, with the place marker <ah>: in Zephath, a Canaanite city that was destroyed and renamed Hormah) (q:draft)
Zefathah = (i:1) (t:name) (c:valley) (w:Zephathah) (d:valley near Mareshah in Judah where King Asa drew up his army for battle) (r:14.14.10)
Zefehad = (i:1) (t:name) (c:male) (w:Zelophehad) (d:man of the tribe of Manasseh, son of Hepher, who had five daughters and no sons) (r:6.17.3)
Zefenath = (i:1) (t:name) (c:male) (w:Zaphenath) (d:first part of Zaphenath-Paneah, the name Pharaoh gave to Joseph) (r:1.41.45)
