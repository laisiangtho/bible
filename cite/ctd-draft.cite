lutin = (i:1) (t:v) (w:entering/going in/coming in) (d:<lut> with <in>, entering and then doing the next action) (a:pusuakin) (b:lut) (q:draft)
lutkhawm = (i:1) (t:v) (w:enter together/go in with) (d:<lut> enter with <khawm> together) (s:tumkhawm) (b:lut) (q:draft)
lutkhit = (i:1) (t:v) (w:have entered) (d:<lut> enter with <khit>, finished; {lutkhit ciangin} is after going in) (s:tumkhit) (q:draft)
lutkik = (i:1) (t:v) (w:go back in/re-enter/return into) (d:<lut> enter with <kik>, again or back) (b:lut) (q:draft)
lutkikin = (i:1) (t:v) (w:go back in/enter again) (d:<lutkik> with the linking suffix <in>) (b:lutkik) (q:draft)
lutlah = (i:1) (t:v) (w:fail to enter/fall short of entering) (d:<lut> enter with <lah>, not manage to) (q:draft, low confidence)
lutlam = (i:1) (t:n) (w:entering/way in) (d:<lut> enter with <lam> way, manner: the act of going in) (q:draft)
lutna = (i:1) (t:n) (w:entrance/entry/way in) (d:<lut>, enter, with the noun suffix <na>: the place where one goes in, such as a gateway or doorway, or the act of entering) (s:tumna) (a:pusuahna) (b:lut) (q:draft)
lutnop = (i:1) (t:v) (w:want to enter) (d:<lut> enter with <nop> want, the form of <lutnuam> used before <leh>, if) (q:draft)
lutnuam = (i:1) (t:v) (w:want to enter) (d:<lut> enter with <nuam> want) (q:draft)
lutnuamte = (i:1) (t:n) (w:those who want to enter) (d:<lutnuam> want to enter with the plural <te>) (b:lutnuam) (q:draft)
lutol = (i:1) (t:n) (w:bald head/bald crown) (d:<lu> head with <tol> bald: the bald top of the head, set beside <talkolh>, the bald forehead) (q:draft)
lutpa = (i:1) (t:n) (w:possessed man) (d:<lut> enter with <pa>, marking a man: the man whom something has entered; found as {dawi lutpa}, a demon-possessed man) (b:lut) (q:draft)
lutpah = (i:1) (t:v) (w:enter at once) (d:<lut> enter with <pah>, at once, immediately) (s:tumpah) (q:draft)
lutpih = (i:1) (t:v) (w:bring in/take in) (d:<lut>, enter, with <pih>, do together with: go in taking a person or thing along, bring or carry in) (s:tumpih) (b:lut) (q:draft)
lutsak = (i:1) (t:v) (w:let in/bring in/send into/admit) (d:<lut>, enter, with <sak>, cause or allow: let someone in, bring in or send into a place) (s:tumsak) (b:lut) (q:draft)
lutsate = (i:1) (t:n) (w:those who have entered) (d:<lut> enter with <sa>, already, and plural <te>; NIV has her guests) (q:draft)
lutsim = (i:1) (t:v) (w:slip in/creep in/enter secretly) (d:<lut> enter with <sim>, secretly) (s:simlut/tumsim) (q:draft)
lutsuk = (i:1) (t:v) (w:go down into/go in/enter) (d:<lut>, enter, with <suk>, downward) (a:kahto) (b:lut) (q:draft)
lutsukin = (i:1) (t:v) (w:go down into/go inside) (d:<lutsuk> with the linking suffix <in>) (b:lutsuk) (q:draft)
lutsukpah = (i:1) (t:v) (w:go straight down into) (d:<lut> enter with <suk> downward and <pah> at once) (q:draft)
lutte = (i:1) (t:n) (w:those who enter) (d:<lut>, enter, with the plural <te>: the people who go in) (b:lut) (q:draft)
lutte = (i:2) (t:n) (w:possessed people) (d:in {dawi lutte}, those whom demons have entered, the demon-possessed) (b:lut) (q:draft)
lutthei = (i:1) (t:v) (w:can enter/be able to enter) (d:<lut> enter with <thei> be able) (b:lut) (q:draft)
luttheih = (i:1) (t:v) (w:be able to enter) (d:the form of <lutthei> used before <nading>; {luttheih nading} is so that one may enter, the right to enter) (b:lutthei) (q:draft)
lutuam = (i:1) (t:n) (w:headband/headdress) (d:<lu> head with <tuam>, wrap) (q:draft)
lutuk = (i:1) (t:v) (w:fall headlong) (d:<lu> head with <tuk> fall: fall head first, a fall worse than <puk>, stumble) (q:draft)
lutung = (i:1) (t:n) (w:head/top of the head) (d:<lu>, head, and <tung>, top or upon, mostly of something that is put or falls on the head of a person) (s:luzang) (q:draft)
lutunga = (i:1) (t:n) (w:on the head) (d:<lutung> top of the head with <a>, on, at) (b:lutung) (q:draft)
lutungah = (i:1) (t:n) (w:on the head/upon the head) (d:<lutung> top of the head, with the place marker <ah>) (b:lutung) (q:draft)
lutzawh = (i:1) (t:v) (w:be able to enter) (d:<lut> enter with <zawh> be able; {a lutzawh lohna} is their not being able to enter) (q:draft)
luum = (i:1) (t:v) (w:be stirred/be in an uproar) (d:in {luum lialua}, of a whole town moved and noisy with excitement) (q:draft, low confidence)
luum = (i:2) (t:n) (w:shield) (d:named among the weapons of a rider, with <galhiam> and <tei>, spear; apparently a spelling of <lum>, shield) (q:draft, low confidence)
luumsak = (i:1) (t:v) (w:warm/let warm) (d:<luum> warm with <sak>, cause) (b:luum) (q:draft)
luvum = (i:1) (t:n) (w:brink/steep edge) (d:the top edge of a cliff; {keen luvum} is the steep bank the pigs rushed down) (q:draft, low confidence)
Luz = (i:1) (t:name) (c:city) (w:Luz) (d:old name of the town of Bethel in Canaan; also a city built later in the land of the Hittites by a man from the first Luz) (r:1.28.19)
luzang = (i:1) (t:n) (w:crown of the head/top of the head) (d:the crown or top of the head; {a khenuai a kipan a luzang dongin} is from the sole of the foot to the top of the head) (s:lutung) (a:khenuai) (q:draft)
luzepnate = (i:1) (t:n) (w:tops/capitals) (d:<lu> head with <zepna>, ornament, and plural <te>: the ornamented tops of posts) (q:draft)
Lydda = (i:1) (t:name) (c:city) (w:Lydda) (d:town in the plain of Sharon near Joppa, where Peter healed Aeneas) (r:44.9.32/44.9.38)
Lydia = (i:1) (t:name) (c:female) (w:Lydia) (d:woman from Thyatira, a dealer in purple cloth, who believed at Philippi and received Paul in her house) (r:44.16.14/44.16.40)
Lysanias = (i:1) (t:name) (c:male) (w:Lysanias) (d:tetrarch of Abilene at the time John the Baptist began to preach) (r:42.3.1)
Lysia = (i:1) (t:name) (c:land) (w:Lycia) (d:region on the south coast of Asia Minor, where Paul changed ships at Myra on his way to Rome) (q:draft)
Lysias = (i:1) (t:name) (c:male) (w:Lysias) (d:Claudius Lysias, the Roman commander in Jerusalem who arrested Paul and sent him to the governor Felix) (r:44.24.22/44.23.26)
Lystra = (i:1) (t:name) (c:city) (w:Lystra) (d:city of Lycaonia in Asia Minor, where Paul healed a lame man and was stoned, and where Timothy lived) (r:44.14.8/44.16.2)
ma = (i:1) (t:prep) (w:before) (d:placed after a noun or verb and followed by <in> or <a>: before in time or order) (s:masiah/mapek) (a:nung)
ma = (i:2) (t:n) (w:fortune)
ma = (i:3) (t:n) (w:destiny)
Ma = (t:see) <Ma-akah>
Ma-adai = (i:1) (t:name) (c:male) (w:Maadai) (d:a descendant of Bani who had married a foreign wife in the time of Ezra) (r:15.10.34) (q:draft)
Ma-adiah = (i:1) (t:name) (c:male) (w:Moadiah/Maadiah) (d:a priest who returned from the exile with Zerubbabel, called Moadiah in the NIV) (r:16.12.5) (q:draft)
ma-akah = (t:todo) (r:13.11.43/11.15.20) (q:draft, proper name Maakah written <Ma-akah> in the text, a lowercase keyword cannot take type name)
Ma-akah = (i:1) (t:name) (c:female) (w:Maakah) (d:name of several women, among them a concubine of Caleb and the wife of Jeiel of Gibeon) (r:13.9.35) (q:draft)
Ma-akah = (i:2) (t:name) (c:land) (w:Maakah) (d:small Aramean kingdom near Mount Hermon whose king joined the Ammonites against David) (r:10.10.6) (q:draft)
Ma-akah = (i:3) (t:name) (c:male) (w:Maakah) (d:father of Achish king of Gath; also the father of Hanan, one of David's mighty warriors) (q:draft, low confidence)
Ma-akahte = (i:1) (t:name) (c:people) (w:Maakah) (d:Maakah with plural <te>, the men of Maakah) (q:draft)
Ma-akath = (i:1) (t:name) (c:people) (w:Maakathite/Maakah) (d:in {Ma-akath mite}, the Maakathites, the people of Maakah; the place and the personal name Maakah are written <Ma-akah>) (r:5.3.14) (q:draft)
Ma-aketh = (i:1) (t:name) (c:people) (w:Maakathite) (d:{Ma-aketh mite} are the people of Maakah, the Maakathites) (q:draft, low confidence)
ma-arath = (t:todo) (r:6.15.59) (q:draft, the town name Maarath written {Ma-arath} in Joshua 15:59, a lowercase keyword cannot take type name)
Ma-asai = (i:1) (t:name) (c:male) (w:Maasai) (d:a priest, son of Adiel, who lived in Jerusalem after the exile) (q:draft)
Ma-aseiah = (i:1) (t:name) (c:male) (w:Maaseiah) (d:name of many men, among them priests who had married foreign wives in the time of Ezra and the father of the priest Zephaniah) (r:15.10.21/24.21.1) (q:draft)
Ma-asseiah = (i:1) (t:name) (c:male) (w:Maaseiah) (d:a Levite musician who played the lyre when David brought the ark to Jerusalem) (r:13.15.20) (q:draft)
ma-aziah = (t:todo) (r:16.10.8) (q:draft, the personal name Maaziah, a priest, written <Ma-aziah> in Nehemiah 10:8, a lowercase keyword cannot take type name)
Ma-aziah = (i:1) (t:name) (c:male) (w:Maaziah) (d:head of the twenty-fourth division of priests in the time of David; also a priest who sealed the covenant with Nehemiah) (q:draft)
ma-kuakte = (i:1) (t:n) (w:furrows) (d:the furrows cut in a field by a hoe or plough, the last part of the word {tu-ma-kuakte}) (s:tumakuakte) (q:draft, low confidence)
maa = (i:1) (t:n) (w:success/progress) (d:success or progress in what one does, used before a verb: {a maa tung} is he succeeds, {na maa vang ding hi} is you will prosper, {a maa pai} is it goes well for him) (s:maavanna/daupaina) (q:draft, low confidence)
Maadai = (i:1) (t:name) (c:male) (w:Maadai) (d:a descendant of Bani who had married a foreign wife in the time of Ezra) (r:15.10.34)
Maadiah = (i:1) (t:name) (c:male) (w:Moadiah) (d:a priest who returned from the exile with Zerubbabel) (r:16.12.5)
maai = (i:1) (t:v) (w:overcome/defeat) (d:to overcome or defeat an enemy; in the verse it follows <vat>, strike, so that {vat maai} is to cut down and defeat with the sword) (s:vatmai) (q:draft, low confidence)
Maai = (i:1) (t:name) (c:male) (w:Maai) (d:one of the priests' associates who played musical instruments at the dedication of the wall of Jerusalem) (r:16.12.36)
Maakah = (i:1) (t:name) (c:male) (w:Maacah/Maakah) (d:name of several men and women, among them a child of Nahor, the father of Hanan and the mother of King Abijah) (r:1.22.24)
Maakath = (i:1) (t:name) (c:people) (w:Maakath/Maakathite) (d:the Maakathites, the people of the small kingdom of Maakah beside Geshur, east of the Jordan) (r:5.3.14/13.4.19)
maan = (i:1) (t:adj) (w:true/honest/right/just) (d:true, right or honest, without falsehood, said of scales, words, paths and offerings; often {a maan} before the noun) (s:man/dik) (a:manlo) (q:draft)
maan = (i:2) (t:v) (w:reign/rule/be king) (d:to reign as king; in the verses written {maan’} with an apostrophe, before <laitakin> for during the reign of, or before <zawh>, as in {a maan’ zawh kum li}, the fourth year of his reign) (s:maang) (q:draft)
maana = (i:1) (t:n) (w:manna) (d:manna, the bread from heaven that God gave Israel in the wilderness, the borrowed word in one of its Zolai spellings) (s:manna/mana) (q:draft)
maang = (i:1) (t:n) (w:vision) (d:something seen in a vision or trance, most often with <mu>, see: {maang ka mu hi} is I saw a vision) (s:maangmuhna/mangmuhna/maangmu/mumaang) (q:draft)
maang = (i:2) (t:v) (w:reign/rule/be king) (d:to reign as king or ruler, said of God and of kings) (s:maan) (q:draft)
maangin = (i:1) (t:v) (w:reign/be king) (d:<maang>, reign, with the linking suffix <in>, which joins it to the verb that follows: he will reign and) (b:maang) (r:11.1.13) (q:draft)
maangkhawm = (i:1) (t:v) (w:reign together/reign with) (d:to reign together with someone, from <maang>, reign, and <khawm>, together) (s:ukkhawm) (b:maang) (q:draft)
maangmu = (i:1) (t:n) (w:vision) (d:something seen in a vision, also the seeing of it; {maangmu kineih} is to pretend to have visions) (s:maangmuhna/mangmuhna/maang/mumaang) (r:47.12.3) (q:draft)
maangmuh = (i:1) (t:n) (w:vision) (d:something seen as in a dream and taken as a message from God) (s:maangmuhna/mangmuh/maang/maangmu) (b:maangmu) (q:draft)
maangmuhna = (i:1) (t:n) (w:vision/revelation) (d:something seen in a vision or a dream, a revelation from God; <maangmuh> with the noun suffix <na>) (s:mangmuhna/maangmuh/maangmu/maang) (b:maangmuh) (r:26.12.24) (q:draft)
maangmuhnate = (i:1) (t:n) (w:visions) (d:plural of <maangmuhna>: the visions that a prophet sees) (s:mangmuhnate) (b:maangmuhna) (q:draft)
maangte = (i:1) (t:n) (w:officials/officers/eunuchs) (d:plural of <maang>, a ruler or official; {innsung maangte} are the officials of the palace, called eunuchs in the English versions) (s:mangte/innsungmangte/uliante) (b:maang) (q:draft)
maanin = (i:1) (t:adv) (w:rightly/justly/uprightly/truly) (d:in a right, just or true way, from <maan>, true or right, with the adverb suffix <in>; {a maanin gamta} is to act rightly) (s:thumanin/diktakin) (a:khialin) (b:maan) (q:draft)
maanna = (i:1) (t:n) (w:reign/seat of rule) (d:the reign of a king or the place where he reigns, from <maan>, reign, with the noun suffix <na>; {a maanna ngei} is where he once reigned) (b:maan) (q:draft)
maap = (i:1) (t:v) (w:spare/pity) (d:to hold back from killing or harming someone out of pity; in the verses it is always negated with <kei>) (s:hehpih/khasiat) (q:draft)
maapai = (i:1) (t:v) (w:prosper/succeed) (d:to go forward and do well, from <maa>, success, and <pai>, go) (s:maavang/mavang/daupai) (q:draft)
Maarath = (i:1) (t:name) (c:land) (w:Maarath) (d:town in the hill country of Judah) (r:6.15.59)
