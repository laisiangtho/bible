sawmthumte = (i:1) (t:n) (w:the Thirty/the thirty) (d:a group of thirty; in the verses the thirty chief warriors of David) (b:sawmthum) (r:13.11.21) (q:draft)
sawmvei = (i:1) (t:adv) (w:ten times) (d:<sawm> ten with <vei> time) (q:draft)
sawn = (i:1) (t:adv) (w:on/onward/in turn) (d:placed after a verb of giving or saying: pass on to others what one has received, as in {pia sawn}, {gen sawn}, {taangko sawn}) (q:draft)
sawngteng = (i:1) (t:adv) (w:throughout/all through) (d:placed after a word of time: during the whole of that time) (q:draft, low confidence)
sawnih = (t:see) <sawnih-le>
sawnih-le = (i:1) (t:num) (d:first part of a compound number: <sawnih>, twenty, with <le>, and; {sawnih-le-nih} is twenty-two) (q:draft)
sawnkhia = (i:1) (t:v) (w:push away/push out/thrust out) (d:<sawn>, push, with <khia>, out: push someone aside or throw him out of a place) (s:nawtkhia) (b:sawn) (q:draft)
sawnkhiat = (i:1) (t:v) (w:push off/push out/throw down) (d:form of <sawnkhia> used before <ding>) (b:sawnkhia) (q:draft)
sawnpa = (i:1) (t:n) (w:governor) (d:in {a uk sawnpa}, the man who rules a province on behalf of the king; apparently <sawn>, in turn, with <pa> marking a man) (b:sawn) (q:draft, low confidence)
sawnpai = (i:1) (t:v) (w:push back/push away/push over) (d:drive something away by pushing: of enemies, push back; of tables, push over) (q:draft)
sawnpaih = (i:1) (t:v) (w:push over/overturn) (d:<sawn> push with <paih> throw away, form of <sawnpai> used before <sak>) (s:sawnthal/lumlet) (b:sawnpai) (q:draft)
sawnsak = (i:1) (t:v) (w:have pass on/direct to hand on) (d:<sawn>, pass on, with the causative <sak>: make someone pass on to others what he has been taught) (b:sawn) (q:draft, low confidence)
sawnsakte = (i:1) (t:n) (d:<sawnsak> with the plural <te>: the things that someone was made to pass on, here the things God had Moses teach) (b:sawnsak) (q:draft, low confidence)
sawnsawn = (i:1) (t:adv) (w:all the more/more and more/on and on) (d:placed after a verb, the action goes on or grows stronger; {kiko sawnsawn} shout all the more, {dot sawnsawn} keep on asking) (s:semsem) (q:draft)
sawnte = (i:1) (t:n) (w:rumors/reports) (d:with <kigen>: things told and passed on from one person to the next) (b:sawn) (q:draft, low confidence)
sawnte = (i:2) (t:n) (w:governors/satraps) (d:with <uk>: those who rule in turn under the king, delegated rulers) (s:uksawnte/mangpite) (b:sawn) (q:draft, low confidence)
sawnthal = (i:1) (t:v) (w:overturn/push over) (d:push something over so that it falls; used with <sak> of Jesus overturning the tables and benches in the temple) (s:lumlet/sawnpaih) (r:41.11.15) (q:draft)
sawpin = (i:1) (t:v) (w:wash) (d:<sawp>, wash, with the linking ending <in>, followed by another verb; said of washing clothes) (s:silin) (b:sawp) (r:3.11.25) (q:draft)
sawpkhia = (i:1) (t:v) (w:wash away/wash out) (d:<sawp>, wash, with <khia>, out: remove something by washing, also said of washing evil out of the heart) (s:silkhia) (b:sawp) (q:draft)
sawpkhiat = (i:1) (t:v) (w:wash away/wash out) (d:form of <sawpkhia>, wash away, used before <sak> and <na>) (s:silkhia) (b:sawpkhia) (q:draft)
sawpkhiatna = (i:1) (t:n) (w:washing away/removal) (d:<sawpkhiat>, wash away, with the noun suffix <na>: the removing of dirt by washing) (b:sawpkhiat) (q:draft)
sawpkhiatsak = (i:1) (t:v) (w:wash off/wash away) (d:<sawpkhiat>, wash away, with <sak>, for someone: wash something off a person) (b:sawpkhiat) (q:draft)
sawpkhiatsakin = (i:1) (t:v) (w:wash away for) (d:<sawpkhiat>, wash away, with <sak>, for someone, and the linking suffix <in>; said of God washing away sins) (b:sawpkhiat) (q:draft)
sawpna = (i:1) (t:n) (w:washing) (d:<sawp>, wash, with the noun suffix <na>: the washing of things such as cups and pots) (b:sawp) (q:draft)
sawpsak = (i:1) (t:v) (w:wash for) (d:<sawp>, wash, with <sak>: wash something for someone) (s:silsak) (b:sawp) (q:draft)
sawpsakin = (i:1) (t:v) (w:have wash/make wash) (d:<sawpsak>, cause to wash, with the linking suffix <in>) (b:sawpsak) (q:draft)
sawpsiang = (i:1) (t:v) (w:wash clean/cleanse/purify) (d:<sawp>, wash, with <siang>, clean: wash something until it is clean; also said of sins being cleansed or wiped away) (s:silsiang/siangsak/siansak) (a:ninsak) (b:sawp) (q:draft)
sawpsiangin = (i:1) (t:v) (w:wash clean) (d:<sawpsiang>, wash clean, with the linking suffix <in>, followed by another verb) (b:sawpsiang) (q:draft)
sawpsiangna = (i:1) (t:n) (w:washing/cleansing) (d:<sawpsiang>, wash clean, with the noun suffix <na>) (s:siansakna/siansuahna) (b:sawpsiang) (q:draft)
sawpsiangsak = (i:1) (t:v) (w:wash clean/cleanse/wipe away) (d:<sawpsiang>, wash clean, with <sak>, for someone: wash a person's wounds clean, or wipe away someone's sins) (s:silsiang/siangsak) (b:sawpsiang) (q:draft)
sawtlai = (i:1) (t:v) (w:still be long/take longer) (d:<sawt>, long in time, with <lai>, still: {bangtan sawtlai ding} is how much longer will it be) (q:draft)
sawtna = (i:1) (t:n) (w:length of time/long while) (d:<sawt>, long in time, with the noun suffix <na>; {a sawtna ciangin} is at length, finally, after a long while) (b:sawt) (q:draft)
sawtpek = (i:1) (t:adv) (w:long ago/long since) (d:<sawt>, long in time, with <pek>, far off: a long time ago; {sawtpek lai-in} is in days long past and {sawtpek a kipanin} is from long ago) (s:tangtawnga) (r:24.2.20) (q:draft)
sawtpekin = (i:1) (t:adv) (w:long ago/long since) (d:<sawtpek>, long ago, with the adverb ending <in>, placed before the verb) (s:tangtawnga) (b:sawtpek) (r:40.11.21) (q:draft)
sawtpi = (i:1) (t:adv) (w:for a long time/long/long ago) (d:<sawt>, long in time, with <pi>, great: for a long time, or a long time ago; {kum sawtpi} is many years) (s:sawtveipi/sawtvei/sauveipi) (a:tawlkhat) (b:sawt) (q:draft)
sawtta = (i:1) (t:adj) (w:long/long already) (d:<sawt>, long in time, with <ta>, by now: have lasted long already; {bang tanvei sawtta} asks how long something has been going on) (b:sawt) (q:draft)
sawtvei = (i:1) (t:adv) (w:for a long time/long) (d:<sawt>, long, with <vei>, time; {a sawtvei ciangin} is after a long time and {sawtvei kihal loin} is not long after) (s:sauvei/sawtpi) (a:tawlkhat) (q:draft)
sawtveipi = (i:1) (t:adv) (w:for a long time/a long while/very long) (d:<sawtvei>, a long time, with <pi>, great: for a very long time) (s:sauveipi/sawtpi) (a:tawlkhat) (b:sawtvei) (q:draft)
saza = (i:1) (t:n) (c:animal) (w:ibex) (d:a wild animal in the list of clean animals, where the English versions have ibex, pygarg or chamois, which animal it is in everyday speech is to be confirmed) (q:draft, low confidence)
sazang = (i:1) (t:n) (w:flesh/muscle) (d:the flesh or muscle of the body, named beside <thagui>, sinews, <guh>, bones, and <vun>, skin) (s:satak) (q:draft)
sazangte = (i:1) (t:n) (w:muscles/sinews) (d:<sazang>, flesh or muscle, with the plural <te>) (b:sazang) (q:draft)
sazaw = (i:1) (t:adj) (w:hotter) (d:<sa>, hot, with <zaw>, more: hotter than something else) (b:sa) (q:draft)
sazian = (i:1) (t:n) (w:account/record/list/reckoning) (d:a count or written list of money, goods or people; {sazian en} is to check the accounts and {sazian bawl} is to make a list) (s:ciamtehna) (q:draft)
sazuakte = (i:1) (t:n) (w:meat sellers/merchants) (d:<sa>, meat, and <zuak>, sell, with the plural <te>: those who sell meat) (q:draft)
sazuk = (i:1) (t:n) (c:animal) (w:deer/doe/hind) (d:a kind of deer; in the verses a doe with her young and deer fleeing from hunters) (s:sakhi) (q:draft)
Sbawl = (i:1) (t:name) (w:Sbawl)
se = (i:1) (t:part) (d:emphatic particle placed after a verb, mostly before a negative such as <lo> or <kei>, in a question with {bang hangin}, why, or with <leh> as in {hita se leh}, even so) (q:draft, low confidence)
Se = (t:see) <Se-irah>
se-alte = (i:1) (t:n) (c:animal) (w:jackals) (d:plural of <se-al>, a wild animal of desolate places) (q:draft)
Se-irah = (i:1) (t:name) (c:place) (w:Seirah) (d:place to which Ehud escaped after killing Eglon king of Moab) (r:7.3.26) (q:draft)
Seba = (i:1) (t:name) (c:male) (w:Seba) (d:son of Cush, and the people and land named after him) (r:1.10.7)
Sebam = (i:1) (t:name) (c:place) (w:Sebam) (d:town east of the Jordan in the land asked for by the tribes of Reuben and Gad) (r:4.32.3)
Sedi = (i:1) (t:name) (c:male) (w:Sodi) (d:man of the tribe of Zebulun, father of the spy Gaddiel) (r:4.13.10)
seek = (i:1) (t:v) (w:hammer/forge/beat/shape) (d:shape or sharpen metal by beating it; with <in> on the noun, beat one thing into another, as swords into ploughshares) (s:sek) (q:draft)
seekin = (i:1) (t:v) (w:forge/hammer out/chisel/shape) (d:<seek>, shape or forge, with the linking ending <in>: shaping metal by hammering, cutting stone tablets, or forming bricks from clay) (b:seek) (q:draft)
seekna = (i:1) (t:n) (w:shaping/working/making) (d:the work or the place of shaping stone, metal or clay; {suangte seekna} is cutting of stones, {leiseek seekna} is brickmaking) (b:seek) (r:2.35.31) (q:draft)
seekpa = (i:1) (t:n) (w:potter/maker/smith) (d:<seek>, shape or forge, with <pa>, which marks a man: the man who shapes something; {beel seekpa} is the potter, {kham seekpa} the goldsmith and {ngun seekpa} the silversmith) (s:sekpa) (b:seek) (q:draft)
seeksa = (i:1) (t:adj) (w:dressed/hewn/cut) (d:of stone, already shaped with tools; <seek>, shape by beating, with <sa>, already) (b:seek) (q:draft)
seeksak = (i:1) (t:v) (w:forge for/have forged/make) (d:<seek>, forge or beat metal, with <sak>, causing or for someone: have a smith make something, or make it for someone) (b:seek) (q:draft)
seeksate = (i:1) (t:n) (w:dressed stones/hewn stones) (d:in {suang seeksate}, stones already cut to shape; <seeksa> with the plural <te>) (s:suangseeksate) (b:seeksa) (q:draft)
seekte = (i:1) (t:n) (w:smiths/craftsmen/makers) (d:<seek>, shape or forge, with the plural <te>: those who shape a material; {kham seekte} are goldsmiths, {suang seekte} stonecutters and {beel seekte} potters) (s:sekte) (b:seek) (q:draft)
seektheih = (i:1) (t:v) (w:be able to shape/can mould) (d:<seek>, shape, with <theih>, can; here of a potter shaping clay) (b:seek) (q:draft)
seel = (i:1) (t:v) (w:hide/conceal/cover) (d:put or keep something out of sight or out of knowledge; {mai seel} is to hide the face and {meel seel} is to hide what one looks like) (s:im/iim/seelcip) (a:pholak/langsak) (r:6.2.6) (q:draft)
seelbawl = (i:1) (t:v) (w:hide/keep hidden) (d:<seel>, hide, with <bawl>, do: keep something concealed) (s:seel) (b:seel) (q:draft)
seelcip = (i:1) (t:v) (w:hide/conceal/cover up/keep hidden) (d:<seel>, hide, with <cip>, tightly: hide completely so that it stays out of sight) (s:imcip/iimcip/seel) (a:pholak) (b:seel) (q:draft)
seelcipsak = (i:1) (t:v) (w:cover/hide away/keep hidden) (d:<seelcip>, hide completely, with <sak>, for or from someone: of sins, cover them; of a right, keep it from someone) (s:khuhsak) (b:seelcip) (q:draft)
seelcipzo = (i:1) (t:v) (w:can hide/be able to conceal) (d:<seelcip>, hide completely, with <zo>, be able) (b:seelcip) (q:draft)
seelin = (i:1) (t:v) (w:hide/conceal) (d:<seel> with the linking ending <in>, hiding something and then doing the next action) (b:seel) (q:draft)
seelin = (i:2) (t:v) (w:disguise) (d:in {meel seelin} or {mel seelin}, hiding the face or appearance, being in disguise) (s:kiselin) (b:seel) (q:draft)
seello = (i:1) (t:v) (w:not hide) (d:<seel>, hide, with <lo>, not; {mai seello} is not to hide the face from someone) (b:seel) (q:draft)
seello = (i:2) (t:v) (w:not argue/not dispute) (d:<seel>, dispute or speak against, with <lo> not, said with <thu> word) (q:draft, low confidence)
seelloin = (i:1) (t:v) (w:not talking back/without contradicting) (d:in {thu seelloin}: <seel>, here speak against, with <lo>, not, and the linking suffix <in>) (q:draft, low confidence)
seelna = (i:1) (t:n) (w:hiding/covering/concealment) (d:the act or place of hiding; {seelna mun} is a hiding place, and {mawhna seelna} is the covering of sin) (b:seel) (q:draft)
seelna = (i:2) (t:n) (w:argument/dispute/case) (d:arguing against someone, apparently from another verb <seel> meaning dispute) (s:kinialna/kiselna) (q:draft, low confidence)
seelpha = (i:1) (t:v) (w:hide well/hide again) (d:<seel>, hide, with <pha>: hide something carefully) (q:draft, low confidence)
seelsakin = (i:1) (t:v) (w:cover/hide) (d:<seel>, hide, with <sak>, for someone, and the linking suffix <in>: covering what should not be seen) (b:seel) (q:draft)
seelsim = (i:1) (t:v) (w:hide/conceal/keep hidden) (d:<seel>, hide, with <sim>, secretly: hide a person or a thing away where it will not be found) (s:seel/seelcip) (a:pholak) (q:draft)
seelsim = (i:2) (t:n) (w:private parts/nakedness) (d:what is kept hidden, a polite word for the private parts of the body) (q:draft)
seelte = (i:1) (t:n) (w:rebels/those who opposed) (d:<seel>, speak against or resist, with <te>, those who; {thu seel} is to oppose or rebel against someone) (s:lehdote) (q:draft)
seem = (i:1) (t:v) (w:blow/blow on/fan) (d:of wind, blow over or upon something; of a fire, blow or fan it so that it burns) (s:mut) (q:draft)
seem = (i:2) (t:v) (w:work/do/serve) (d:spelling of <sem>, work, used with <na>, work or task: {na seem} is do work, be at work) (s:sem) (q:draft)
seemgawp = (i:1) (t:v) (w:churn up/blow violently on) (d:<seem>, of wind blow on, with <gawp>, violently: stir up the sea) (b:seem) (q:draft)
seemkhia = (i:1) (t:v) (w:blow away) (d:<seem>, blow, with <khia>, out or away) (s:mutkhia/mutmang) (b:seem) (q:draft)
seengin = (i:1) (t:n) (w:by the measure/with the measure) (d:<seeng>, basket used as a measure, with <in>, by or with) (b:seeng) (q:draft)
seengte = (i:1) (t:n) (w:baskets) (d:<seeng>, basket, with the plural <te>) (b:seeng) (q:draft)
Sefar = (i:1) (t:name) (c:land) (w:Sephar) (d:place marking the eastern limit of the land where the sons of Joktan lived) (r:1.10.30)
Sefarvaim = (i:1) (t:name) (c:city) (w:Sepharvaim) (d:city conquered by Assyria, whose people were settled in Samaria) (r:12.19.13/12.17.24)
sefer = (t:see) <Kiriath-sefer>
Segub = (i:1) (t:name) (c:male) (w:Segub) (d:name of two men: a son of Hezron and father of Jair, and the youngest son of Hiel who rebuilt Jericho) (r:13.2.22/13.2.21)
Seguk = (i:1) (t:name) (c:star) (w:Pleiades) (d:the Pleiades, a cluster of stars named together with Orion) (r:18.9.9/18.38.31)
seh = (i:1) (t:n) (w:part/portion/share) (d:one of the equal parts of a whole, used in fractions: {seh thum suah seh khat} is one third) (s:tanh) (r:38.13.8) (q:draft)
seh = (i:2) (t:v) (w:appoint/assign/set/designate) (d:set a person in a place or task, mark out a place, or fix a time) (q:draft)
seh = (i:3) (t:v) (w:value/set a value/estimate) (d:set the value or price of something, as in {a man zah seh}, fix its price) (s:tuat) (r:3.6.6/3.27.12) (q:draft, low confidence)
sehin = (i:1) (t:v) (w:appoint/assign/apportion) (d:<seh>, appoint or assign, with the linking ending <in>: set apart a place, assign a share or fix a value, and then do the next action) (b:seh) (q:draft)
sehkhat = (i:1) (t:n) (w:one part/one share) (d:one part of a whole divided into equal parts; {sehsawm suah sehkhat} is one tenth, a tithe) (q:draft)
sehkhatte = (i:1) (t:n) (w:one part/portions/tithes) (d:<sehkhat>, one part, with the plural <te>: the people or things that make up one part; {seh thum ah sehkhatte} is a third of them, and {sehsawm suah sehkhatte} are tithes) (b:sehkhat) (q:draft)
sehkhen = (i:1) (t:v) (w:distribute/apportion/divide out) (d:<seh>, portion, with <khen>, divide: divide into shares and give out) (s:hawm/hawmkhia) (q:draft)
sehkhia = (i:1) (t:v) (w:measure off/parcel out/apportion) (d:<seh>, portion or assign, with <khia>, out: mark out land in portions) (b:seh) (r:19.108.7) (q:draft)
sehkhin = (i:1) (t:v) (w:have appointed/have set apart) (d:<seh>, appoint, with <khin>, already done; the NIV has anointed) (b:seh) (q:draft)
sehkhol = (i:1) (t:v) (w:appoint beforehand/decree/set in advance) (d:fix or assign something ahead of time, such as a day or an outcome) (s:ciamkholh) (q:draft)
sehkholhin = (i:1) (t:v) (w:appointing beforehand) (d:<seh>, appoint, with <kholh>, beforehand, and the linking suffix <in>) (q:draft)
sehkholhpa = (i:1) (t:n) (w:the appointed man) (d:<seh>, appoint, with <kholh>, beforehand, and <pa> marking a man: the man appointed beforehand) (q:draft)
sehkholhsa = (i:1) (t:v) (w:predestined/appointed beforehand) (d:<seh>, appoint, with <kholh>, beforehand, and <sa>, already) (q:draft)
sehli = (i:1) (t:num) (w:four parts) (d:used in {sehli suah sehkhat}, one part out of four, a quarter) (q:draft)
sehlisuah = (i:1) (t:phrase) (d:divided into four parts: <seh>, part, <li>, four, and <suah>; {sehlisuah sehkhat} is one fourth, a quarter) (q:draft)
sehna = (i:1) (t:n) (w:valuation/value/estimate) (d:the value set on a person or thing; {na sehna} is your valuation, the amount at which you assess it) (s:kisehna/manzah) (b:seh) (q:draft)
sehna = (i:2) (t:n) (w:appointment/decree/plan/ordinance) (d:what someone has set or decided; {a sehna bangin} is as he planned, and {sehna tawh} is by the appointment of someone) (b:seh) (q:draft, low confidence)
sehnasa = (i:1) (t:adj) (w:appointed/assigned/designated) (d:<seh>, appoint, with <na> and <sa> marking a completed action; {sehnasa mun} is the place already appointed) (s:sehsa/kisehsa) (b:seh) (q:draft)
sehnel = (i:1) (t:n) (w:sand) (d:the fine loose grains found on the seashore; {tuipi sehnel} is the sand of the sea) (q:draft)
sehnel = (i:2) (t:n) (w:desert/wilderness) (d:in the phrase <sehnel gam>, land of sand: dry country where few people live) (s:gampalak/keugawgam/gamlakpi) (r:28.13.5) (q:draft)
Sehnel = (i:1) (t:n) (w:desert/wilderness) (d:<sehnel> written with a capital in {Sehnel gam}, the land of sand) (s:gampalak/keugawgam) (b:sehnel) (r:23.16.1) (q:draft)
sehnelte = (i:1) (t:n) (w:sands/sand) (d:<sehnel>, sand, with the plural <te>; often of the countless sands of the seashore) (b:sehnel) (q:draft)
sehnga = (i:1) (t:num) (w:five parts) (d:used in {sehnga suah sehkhat}, one part out of five, a fifth) (q:draft)
sehnih = (i:1) (t:num) (w:two-tenths/two parts) (d:<seh>, part or share, with <nih>, two: two parts; {sehsawm suah sehnih} is two parts out of ten, two-tenths) (q:draft)
sehsa = (i:1) (t:adj) (w:appointed/assigned/decreed/predestined) (d:<seh>, appoint, with <sa>, already: set or decided beforehand, said of a time, a place, a share or people) (b:seh) (q:draft)
sehsak = (i:1) (t:v) (w:appoint/assign/allot) (d:<seh>, appoint, with <sak>, for someone: appoint or set aside a person or thing for someone) (b:seh)
sehsak = (i:2) (t:n) (w:divide) (b:seh)
sehsaksa = (i:1) (t:adj) (w:assigned/allotted/appointed) (d:<sehsak>, assign to someone, with <sa> marking a completed action: what has been assigned) (b:sehsak) (q:draft)
sehsawm = (i:1) (t:n) (w:ten parts/tenth) (d:a division into ten parts; found in the fixed phrase {sehsawm suah sehkhat}, one part out of ten, a tenth or tithe) (r:5.14.28) (q:draft)
sehsawmsuah = (i:1) (t:n) (d:<seh>, part, with <sawm>, ten, and <suah>, make into: divided into ten parts; {sehsawmsuah sehkhat} is one part out of ten, a tenth) (q:draft)
sehte = (i:1) (t:n) (w:those appointed) (d:<seh>, appoint, with the plural <te>: the ones for whom something has been appointed) (b:seh) (q:draft)
