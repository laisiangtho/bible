Bezek = (i:1) (t:name) (c:place) (w:Bezek) (d:place where Judah defeated Adoni-Bezek, and where Saul mustered Israel before relieving Jabesh Gilead) (r:7.1.5/9.11.8/7.1.4)
Bezer = (i:1) (t:name) (c:city) (w:Bezer) (d:city of refuge in the wilderness plateau east of the Jordan, in the territory of Reuben; also a man of the tribe of Asher) (r:6.21.36/5.4.43/6.20.8/13.7.37)
bi = (i:1) (t:v) (w:touch) (d:touch something lightly, as the seraph touches the lips of the prophet with a live coal) (s:khoih/sukha) (q:draft)
bi = (i:2) (t:n) (c:plant) (w:hay/thatch grass/grass) (d:dry grass such as is used for thatch, named between wood and straw as a building material) (q:draft, low confidence)
bia = (i:1) (t:v) (w:worship) (d:bow down to and serve God or a god; <biak> is the form used before endings such as <na> and <nading>)
bia = (i:2) (t:n) (w:veneration/worship) (d:the act of worshipping, reverence shown to God or a god)
biabia = (i:1) (t:v) (w:keep worshipping/worship continually/go on serving) (d:<bia>, worship, said twice for an action that goes on and on) (s:biakbiak) (q:draft)
biaibuai = (i:1) (t:adv) (w:billowing/in a cloud) (d:describes smoke rising thickly; {kahto biaibuai} is to rise in a billowing cloud) (q:draft, low confidence)
biak = (i:1) (t:v) (w:worship) (d:form of <bia>, worship, used before endings and following words such as <nading>, <na>, <theih> and <khit>) (b:bia) (q:draft)
biak = (i:2) (t:v) (w:offer/sacrifice) (d:make an offering to God, as in {meihal biak nading}, for a burnt offering, and {khialhna hanga biak nading}, for a sin offering) (s:biakpiak) (b:bia) (q:draft)
biakbiak = (i:1) (t:v) (w:keep worshipping/worship) (d:<biak>, worship, said twice for an action that goes on) (s:biabia) (q:draft)
biakbuak = (i:1) (t:adv) (d:descriptive word after <kang>, white, said of a cloud: brilliantly or billowing white; the exact sense is not certain) (q:draft, low confidence)
biakbuk = (i:1) (t:n) (w:tabernacle) (d:the tent of worship that Israel carried through the wilderness, from <biak>, worship, and <buk>, tent or booth) (s:Puanbuk) (q:draft)
Biakbuk = (i:1) (t:n) (w:tabernacle) (d:<biakbuk>, tabernacle, written with a capital at the start of a sentence or for the tabernacle of Moses) (b:biakbuk) (q:draft)
biakha = (i:1) (t:v) (w:worship/fall into worshipping) (d:<biak>, worship, with <kha>, happen to: come to worship; {milim biakha nawn lo} is no longer worship idols) (s:biakkhak) (q:draft)
biakhawm = (i:1) (t:v) (w:worship together) (d:<bia>, worship, with <khawm>, together) (s:biakkhop) (b:bia) (q:draft)
biakin = (i:1) (t:n) (w:temple/house of worship) (d:a spelling of <biakinn>, from <biak>, worship, and <inn>, house) (s:biakinn) (q:draft)
biakinn = (i:1) (t:n) (w:temple/sanctuary) (d:house of worship, from <biak>, worship, and <inn>, house: the temple in Jerusalem, or the sanctuary where God is present) (s:biakinnpi/biakin) (r:19.73.17) (q:draft)
Biakinn = (i:1) (t:n) (w:temple) (d:<biakinn> written with a capital, the temple in Jerusalem) (b:biakinn) (q:draft)
biakinnah = (i:1) (t:n) (w:to the temple/in the temple) (d:<biakinn>, temple, with the place marker <ah>) (b:biakinn) (q:draft)
biakinncing = (i:1) (t:n) (w:temple guard) (d:one who guards the temple, from <biakinn>, temple, and <cing>, guard; {biakinncing palikte} are the temple guards and {biakinncing palikmangte} their officers) (q:draft)
biakinnpi = (i:1) (t:n) (w:temple/sanctuary) (d:<biakinn>, temple, with <pi>, great: the great house of worship, the temple) (s:biakinn) (b:biakinn) (r:24.17.12) (q:draft)
Biakinnpi = (i:1) (t:n) (w:temple/sanctuary) (d:<biakinnpi> written with a capital, the temple in Jerusalem) (b:biakinnpi) (q:draft)
biakinnsung = (i:1) (t:n) (w:inside of the temple/temple) (d:<biakinn>, temple, with <sung>, inside: the interior of the temple; also simply the temple) (r:26.44.4) (q:draft)
biakinnte = (i:1) (t:n) (w:temples/sanctuaries) (d:plural of <biakinn>: temples, sanctuaries, or the buildings of the temple) (b:biakinn) (q:draft)
biakinntual = (i:1) (t:n) (w:temple court/courtyard) (d:the open court of the temple, from <biakinn>, temple, and <tual>, court; {biakinntual sungnung} is the inner court and {biakinntual puanung} the outer court) (r:26.44.21) (q:draft)
biakkhak = (i:1) (t:v) (w:fall into worshipping/worship) (d:<biak>, worship, with <khak>, happen to: come to worship; {biakkhak loh nading} is so as not to fall into worshipping) (s:biakha) (q:draft)
biakkhop = (i:1) (t:v) (w:worship together with/worship alongside) (d:<biak>, worship, with <khop>, form of <khawm>, together) (s:biakhawm) (q:draft)
biakna = (i:1) (t:n) (w:religion) (d:a system of belief and worship) (b:biak)
biakna = (i:2) (t:n) (w:offering/sacrifice) (d:something given to God in worship, an offering or sacrifice) (s:biakpiakna/kithoihna) (b:biak) in this sense more exactly <biakpiakna>
biakna = (i:3) (t:n) (w:worship) (d:worship or religious observance, as in {biakna ngeina} regulations for worship and <milim biakna> idolatry) (s:kibiakna) (b:biak) in this sense more exactly <biakpiakna>
biaknatau = (i:1) (t:n) (w:altar) (d:raised place on which offerings are made, from <biakna>, offering, and <tau>, altar) (s:tau) (q:draft)
biaknataute = (i:1) (t:n) (w:altars) (d:plural of <biaknatau>, altar) (s:taute) (b:biaknatau) (q:draft)
biaknate = (i:1) (t:n) (w:offerings/sacrifices) (d:plural of <biakna>, offering; {meihal biaknate} are burnt offerings) (s:biakpiaknate/kithoihnate/piaknate) (b:biakna) (q:draft)
biaknate = (i:2) (t:n) (w:places of worship/shrines) (d:plural of <biakna> in the sense of a place of worship; {mual tunga biaknate}, the places of worship on the hills, are the high places) (b:biakna) (q:draft, low confidence)
biaknopna = (i:1) (t:n) (w:desire to worship/devotion) (d:<biak>, worship, and <nop>, want, with the noun suffix <na>: the wish to worship; {milim biaknopna lungsim} is a heart set on worshipping idols) (q:draft)
biakpiak = (i:1) (t:v) (w:sacrifice/offer) (d:give an offering in worship, from <biak>, worship, and <piak>, give; also names the act, as in {nitak biakpiak hun}, the time of the evening sacrifice) (s:biak) (q:draft)
biakpiakna = (i:1) (t:n) (w:sacrifice/offering) (d:what is given to God in worship, from <biak>, worship, and <piakna>, giving; {thunuam-a biakpiakna} is a fellowship offering) (s:biakna/kithoihna) (q:draft)
biakpiaknate = (i:1) (t:n) (w:sacrifices/offerings) (d:plural of <biakpiakna>, sacrifice) (s:biaknate/kithoihnate) (b:biakpiakna) (q:draft)
biakpih = (i:1) (t:v) (w:join in worshipping/worship) (d:<biak>, worship, with <pih>, along with: worship together with others, in the verses always the idols or gods of other people) (b:biak) (q:draft)
biaksa = (i:1) (t:v) (w:worshipped/formerly worshipped) (d:<biak>, worship, with <sa>, already done: that was worshipped before) (b:biak) (q:draft)
biaksiam = (i:1) (t:v) (w:worship rightly/be devout) (d:<biak>, worship, with <siam>, be skilled at: worship rightly, said of women who are devoted to God) (q:draft, low confidence)
biakte = (i:1) (t:n) (w:objects of worship/idols) (d:plural of <biak>, the things that are worshipped; {milim biakte} are idols) (b:biak) (q:draft)
biaktheih = (i:1) (t:v) (w:be able to worship/can worship) (d:<biak>, worship, with <theih>, can; {biaktheih nading}, so that one may worship) (b:biak) (q:draft)
biaktheihna = (i:1) (t:n) (w:right to worship/worship) (d:<biaktheih>, be able to worship, with the noun suffix <na>: the right or the means to worship) (b:biaktheih) (q:draft)
biang = (i:1) (t:n) (w:cheek) (d:the side of the face below the eye) (s:paang) (q:draft)
biangte = (i:1) (t:n) (w:cheeks) (d:plural of <biang>, cheek) (b:biang) (q:draft)
bianuam = (i:1) (t:v) (w:want to worship/be willing to worship) (d:<bia>, worship, with <nuam>, want to) (q:draft)
biasak = (i:1) (t:v) (w:make worship/cause to worship) (d:<bia>, worship, with <sak>, cause) (b:bia) (q:draft)
biate = (i:1) (t:n) (w:worshipers) (d:those who worship, <bia> with the plural ending <te>; <milim biate> are idolaters) (b:bia) (q:draft)
Bidkar = (i:1) (t:name) (c:male) (w:Bidkar) (d:chariot officer of Jehu king of Israel) (r:12.9.25)
Bigah = (i:1) (t:name) (c:male) (w:Bilgah) (d:a spelling of <Bilgah>, a priest who returned from the exile with Zerubbabel) (r:16.12.5)
Bigai = (i:1) (t:name) (c:male) (w:Bilgai) (d:a spelling of <Bilgai>, a priest who sealed the covenant with Nehemiah) (r:16.10.8) (q:draft)
Bigtha = (i:1) (t:name) (c:male) (w:Bigtha) (d:one of the seven eunuchs who served King Xerxes) (r:17.1.10)
Bigthana = (i:1) (t:name) (c:male) (w:Bigthana) (d:officer who guarded the doorway of King Xerxes and plotted with Teresh to kill him) (r:17.2.21/17.6.2)
Bigvai = (i:1) (t:name) (c:male) (w:Bigvai) (d:leader who returned from the exile with Zerubbabel, and head of a large family of returned exiles) (r:15.2.14/15.8.14/15.2.2/16.10.16)
Bihah = (i:1) (t:name) (c:city) (w:Bilhah) (d:a spelling of <Bilhah>, a town of the tribe of Simeon) (r:13.4.29)
biing = (i:1) (t:n) (w:horn/flask) (d:a horn or flask that holds oil, in {sathau biing}; also a measure of oil) (s:bing) (q:draft)
biingah = (i:1) (t:n) (w:into the horn/in the flask) (d:<biing>, horn or flask for oil, with the place marker <ah>) (b:biing) (q:draft)
biingta = (i:1) (t:n) (w:log/small measure of oil) (d:a small measure of oil, used for the Hebrew measure log in Leviticus 14, about a third of a litre) (q:draft)
bikbek = (i:1) (t:adv) (w:completely/absolutely/totally/entirely/wholly/fully/thoroughly) (d:placed after a verb or describing word: completely, tightly, with nothing left over; {khua mial bikbek} is pitch dark)
Bikhri = (i:1) (t:name) (c:male) (w:Bikri) (d:a Benjamite, father of the Sheba who rebelled against David) (r:10.20.1/10.20.13/10.20.7)
bil = (i:1) (t:n) (w:ear) (d:the organ of hearing) (q:draft)
bil-aphuai = (i:1) (t:adj) (w:resounding/noisy) (d:describes a gong, <zam>; apparently <bil>, ear, with {a phuai}: loud or harsh on the ear) (q:draft, low confidence)
bilah = (i:1) (t:n) (w:in the ear/in the hearing of/to the ears) (d:<bil>, ear, with the place marker <ah>: in or to the ears, in the hearing of) (b:bil) (q:draft)
bilbah = (i:1) (t:n) (w:earring) (d:ornament worn in the ear; contains <bil>, ear) (q:draft)
bilbahte = (i:1) (t:n) (w:earrings/rings) (d:plural of <bilbah>, an ornament worn in the ear) (b:bilbah) (q:draft)
Bildad = (i:1) (t:name) (c:male) (w:Bildad) (d:Bildad the Shuhite, one of the three friends of Job) (r:18.2.11/18.8.1/18.18.1)
Bileam = (i:1) (t:name) (c:city) (w:Bileam) (d:town in the territory of the half-tribe of Manasseh west of the Jordan, given to the Kohathite Levites) (r:13.6.70)
Bilgah = (i:1) (t:name) (c:male) (w:Bilgah) (d:head of the fifteenth division of priests in the time of David; also a priest who returned from the exile with Zerubbabel) (r:16.12.5/13.24.14/16.12.18)
Bilgai = (i:1) (t:name) (c:male) (w:Bilgai) (d:priest who sealed the covenant with Nehemiah) (r:16.10.8)
Bilhah = (i:1) (t:name) (c:female) (w:Bilhah) (d:servant of Rachel and mother of Dan and Naphtali; also a town of the tribe of Simeon) (r:1.35.25/1.30.7/13.4.29)
Bilhahtungah = (i:1) (t:name) (c:female) (w:Bilhah) (d:<Bilhah>, the servant of Rachel, written together with <tungah>, to: to Bilhah) (b:Bilhah) (r:1.30.4)
Bilhan = (i:1) (t:name) (c:male) (w:Bilhan) (d:name of two men: a son of Ezer the Horite, and a Benjamite, son of Jediael) (r:1.36.27/13.1.42/13.7.10)
bilngong = (i:1) (t:adj) (w:deaf) (d:unable to hear, from <bil>, ear, and <ngong>, deaf) (s:bengngong/ngong) (q:draft)
bilngongin = (i:1) (t:adj) (w:deaf) (d:<bilngong>, deaf, with the suffix <in>: being deaf) (b:bilngong) (q:draft)
bilngongsak = (i:1) (t:v) (w:make deaf) (d:<bilngong>, deaf, with <sak>, cause) (s:ngongsak) (b:bilngong) (q:draft)
bilngongte = (i:1) (t:n) (w:the deaf/deaf people) (d:plural of <bilngong>: people who cannot hear) (s:ngongte) (b:bilngong) (r:23.42.18) (q:draft)
bilpi = (i:1) (t:n) (c:animal) (w:hare)
bilpi = (i:2) (t:n) (c:animal) (w:rabbit)
