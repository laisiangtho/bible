lenkipte = (i:1) (t:n) (w:those who hold fast) (d:<lenkip>, hold firmly, with <te>, those who) (b:lenkip) (q:draft)
lenlen = (i:1) (t:v) (w:hold on to/keep holding/cling to) (d:<len> hold, doubled for a continued action) (q:draft)
lenpa = (i:1) (t:n) (w:holder) (d:<len> hold with <pa>, the man who holds; {heina lenpa}, the man who holds the rudder, the pilot or helmsman) (s:tawipa) (b:len) (q:draft)
lenpih = (i:1) (t:v) (w:carry along/drive along) (d:of the wind, carry a ship along with it) (q:draft, low confidence)
