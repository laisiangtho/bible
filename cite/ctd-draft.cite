Nibshan = (i:1) (t:name) (c:land/city) (w:Nibshan) (d:town in the wilderness of Judah, listed with the City of Salt and En Gedi) (r:6.15.62)
nidang = (i:1) (t:adv) (w:formerly/in the past/before) (d:in former times, in the past; {nidang lai} is the time gone by and {nidang bangin} is as before) (s:tuma/tumasiah/tanglai) (r:45.15.4) (q:draft)
nidanga = (i:1) (t:adv) (w:formerly/earlier/in the past) (d:<nidang> with the ending <a>: formerly, at an earlier time; before a noun it means former, of earlier days) (s:tumasiah) (b:nidang) (q:draft)
Nidanga = (i:1) (t:name) (w:Nidanga) (d:the adverb <nidanga>, formerly, written with a capital at the start of a sentence)
nidangin = (i:1) (t:adv) (w:formerly/in the past/before) (d:<nidang>, former time, with the marker <in>: in the past, before now, often set against <tu-in>, now) (s:tuma/tumasiah) (b:nidang) (q:draft)
nidangte = (i:1) (t:n) (w:the other days/other days) (d:<ni>, day, with <dang>, other, and the plural <te>: the rest of the days of a year or a month) (q:draft)
Nidas = (i:1) (t:name) (c:city) (w:Cnidus) (d:port city on the south-west coast of Asia Minor, passed by the ship that carried Paul toward Rome) (r:44.27.7)
Niger = (i:1) (t:name) (c:male) (w:Niger) (d:byname of Simeon, one of the prophets and teachers in the church at Antioch) (r:44.13.1)
niguk = (i:1) (t:n) (w:six days) (d:<ni>, day, with <guk>, six, written together; {niguk sung} is for six days) (q:draft)
nih = (i:1) (t:num) (w:two) (d:the number two; it follows the noun it counts, and {sawm-le-nih} is twelve) (r:1.1.16)
Nih = (i:1) (t:num) (w:two/twin) (d:<nih>, two, written with a capital in {Pasian Nih}, the Two Gods, the twin gods Castor and Pollux carved as the figurehead of a ship) (b:nih) (q:draft)
nihin = (i:1) (t:adv) (w:both/in two/two by two/in pairs) (d:<nih>, two, with <in>: {a nihin} is both of them, {nih nihin} is two by two, and {gual nihin} or {pawl nihin} is in two rows or groups) (b:nih) (q:draft)
nihna = (i:1) (t:num) (w:second) (d:<nih>, two, with the ordinal suffix <na>: second; {sawm-le-nihna} is twelfth) (b:nih)
Nihna = (i:1) (t:num) (w:second) (d:<nihna>, second, written with a capital at the start of a sentence or in a name: {Veng Nihna} is the Second Quarter of Jerusalem, in the NIV the New Quarter, and {Jeroboam Nihna} is Jeroboam the Second) (b:nihna) (r:12.15.1) (q:draft)
nihnapa = (i:1) (t:n) (w:the second) (d:<nihna>, second, with <pa> marking a man: after a name, the second man of that name, as Jeroboam the Second; also the man second in rank) (b:nihna) (q:draft)
nihnate = (i:1) (t:n) (w:those second in rank/seconds) (d:<nihna>, second, with the plural <te>: the men who rank next after the chief) (b:nihna) (q:draft)
nihta = (i:1) (t:num) (w:two each) (d:<nih>, two, with <ta>, each: two at a time, as two lambs each day) (b:nih) (q:draft)
nihte = (i:1) (t:num) (w:two/both) (d:<nih>, two, with the plural <te>: the two, both of them; {Sawm-le-nihte} is the Twelve) (b:nih) (r:42.9.30/3.3.4) (q:draft)
nihun = (i:1) (t:pron) (w:both/the two together) (d:<nih>, two, with the plural ending <un>; used after <a>, <na>, <ka> or <i>: {a nihun} is both of them, {na nihun} both of you, {ka nihun} the two of us) (b:nih) (q:draft)
nihvei = (i:1) (t:adv) (w:twice/a second time) (d:<nih>, two, with <vei>, time: two times, or for the second time; <khatvei nihvei> is once or twice) (q:draft)
nihveina = (i:1) (t:num) (w:second time/second) (d:<nihvei>, twice, with the ending <na>: the second time something is done; {a nihveina} is for the second time) (b:nihvei) (r:40.26.42) (q:draft)
niim = (i:1) (t:adj) (w:overcast/gloomy/dim) (d:dull and dark, said of the sky or the day in <khua niim>; the same word as <nim>) (s:nim) (q:draft)
niin = (i:1) (t:n) (w:on the day) (d:<ni> day, with the marker <in>; usually written <ni-in>) (b:ni) (q:draft)
niinpa = (i:1) (t:n) (w:stubble) (d:dry stalks left in a field, which fire burns up quickly; also written <ninpa>; the build of the word is not clear) (s:ninpa/buhtu/nahpa) (q:draft, low confidence)
niinsak = (i:1) (t:v) (w:defile/desecrate/make unclean) (d:make a holy place or thing unclean; a spelling of <ninsak> with a long vowel) (s:ninsak/nitsak) (a:siangsak) (q:draft)
nik = (i:1) (t:n) (w:skirt) (d:a woman's lower garment; to lift or strip off the {nik} is a picture of putting someone to shame) (r:23.47.2) (q:draft)
Nikai = (i:1) (t:name) (w:Nikai) (d:<nikai>, afternoon, written with a capital at the start of a sentence; {Nikai nai thum} is three in the afternoon) (r:44.10.3)
Nikanor = (i:1) (t:name) (c:male) (w:Nicanor) (d:one of the seven men chosen in Jerusalem to oversee the daily distribution of food) (r:44.6.5)
nikhat = (i:1) (t:n) (w:one day/a day) (d:<ni>, day, with <khat>, one: a single day; {nikhat sung} is within one day, {nikhat sung lam} is a day's journey, and {nikhat ni ciangin} is one day, some day) (r:18.1.6) (q:draft)
Nikoda = (i:1) (t:name) (c:male) (w:Nekoda) (d:ancestor of a family of temple servants who returned from the exile) (r:16.7.50)
Nikodemas = (i:1) (t:name) (c:male) (w:Nicodemus) (d:Pharisee and member of the Jewish council who came to Jesus by night and later helped to bury him) (r:43.3.1/43.7.50)
Nikolas = (i:1) (t:name) (c:male) (w:Nicolas) (d:convert to Judaism from Antioch, one of the seven chosen in Jerusalem; {Nikolas pawlte} are the Nicolaitans of Revelation) (r:44.6.5)
Nikopolis = (i:1) (t:name) (c:city) (w:Nicopolis) (d:city in western Greece where Paul planned to spend the winter) (r:56.3.12)
nikten = (i:1) (t:n) (w:clothing/garments) (d:clothes, what a person wears; found in the pair <nikten puansilh>, clothing of every kind, beside <annek tuidawn>, food and drink) (r:18.27.16) (q:draft)
nikum = (i:1) (t:n) (w:last year) (d:the year before this one; {nikum pekin} is since last year) (a:kumkik) (q:draft)
nikumin = (i:1) (t:adv) (w:last year) (d:<nikum>, last year, with the time marker <in>: in the past year) (b:nikum) (q:draft)
nil = (i:1) (t:v) (w:throw/cast/hurl) (d:throw something away from oneself; {nil suk} is throw down, {nil khia} is cast away or reject) (s:lawn/paai) (q:draft)
nilang = (i:1) (t:n) (w:half a day) (d:<ni>, day, with <lang>, half; {nithum leh nilang} is three and a half days) (q:draft)
nilh = (i:1) (t:v) (w:anoint/smear/rub on) (d:put oil on a person or thing, especially to set apart a king, priest or prophet, usually as <sathau nilh>; {nilh sathau} is anointing oil) (s:nuh) (q:draft)
nilhin = (i:1) (t:v) (w:anoint/rub on) (d:<nilh>, anoint, with the linking ending <in>, used before a following verb, usually with <sathau>, oil) (s:nuhin) (b:nilh) (q:draft)
nilhkhol = (i:1) (t:v) (w:anoint beforehand) (d:<nilh>, anoint, with <khol>, in advance: anoint ahead of time, as a body before its burial) (s:nuhkhol) (q:draft)
nilhna = (i:1) (t:n) (w:anointing) (d:<nilh>, anoint, with the noun ending <na>: the act of anointing or the anointing received; <sathau nilhna> is anointing with oil) (s:kinilhna) (b:nilh) (q:draft)
nilhpa = (i:1) (t:n) (w:anointed one) (d:the man who has been anointed, usually {sathau nilhpa}, the one anointed with oil; <nilh> with <pa> marking a man) (s:kinilhpa) (b:nilh) (q:draft)
nilhsa = (i:1) (t:adj) (w:anointed) (d:<nilh>, anoint, with <sa>, already done; {sathau nilhsa} is one who has been anointed with oil) (b:nilh) (q:draft)
nilhsak = (i:1) (t:v) (w:anoint/put on/pour on/apply) (d:rub or pour oil or perfume on a person, and so anoint a king or priest; <nilh> with <sak>, done to or for another) (b:nilh) (q:draft)
nilhte = (i:1) (t:n) (w:anointed ones) (d:<nilh>, anoint, with the plural <te>: those who have been anointed, as {sathau nilhte}, those anointed with oil) (b:nilh) (q:draft)
nilhte = (i:2) (t:n) (d:those who anoint themselves, users of perfumed oil) (b:nilh) (q:draft, low confidence)
nilhzo = (i:1) (t:v) (w:have anointed) (d:<nilh>, anoint, with <zo> marking a completed action) (s:nuhkhit) (b:nilh) (q:draft)
nili = (i:1) (t:num) (w:four days/fourth day) (d:<ni>, day, and <li>, four, written together; in dates it follows the tens: {nisawm leh nili ni} is the fourteenth day, {ni sawmnih leh nili ni} the twenty-fourth) (q:draft)
niliim = (i:1) (t:n) (w:shadow/shade) (d:the shadow or shade made when the sun is blocked, from <ni>, sun, and <liim>, shadow; also a picture of what passes quickly) (s:nilim/liim) (q:draft)
nilim = (i:1) (t:n) (w:shade/shadow) (d:the shade or shadow made when the sun is blocked, also a picture of a life that passes quickly; a spelling of <niliim>) (s:niliim/liim) (q:draft)
nilkhia = (i:1) (t:v) (w:reject/cast out/throw away/remove) (d:<nil>, throw, with <khia>, out: throw out or put away from oneself or from a place, and so reject a person) (s:paaikhia/lawnkhia) (a:saang/teel) (b:nil) (q:draft)
nilkhiamang = (i:1) (t:v) (w:sweep away/cast away utterly) (d:<nil>, throw, with <khia>, out, and <mang>, away and lost: sweep away completely) (q:draft)
nilkhiat = (i:1) (t:v) (w:reject/cast out/throw away) (d:form of <nilkhia> used before a noun or an ending: {a nilkhiat suang} is the stone that was rejected) (b:nilkhia) (r:60.2.4) (q:draft)
niloh = (i:1) (t:adv) (w:continually/always/constantly) (d:placed after a verb: keep on doing without ceasing, as {thungen niloh}, pray continually) (s:den/gige/ngitnget/tawntunga) (q:draft)
nilohin = (i:1) (t:adv) (w:continually/all day long/regularly) (d:<niloh>, continually, with the ending <in>; {sun nilohin} is all day long) (s:den/gige) (b:niloh) (q:draft)
nilohna = (i:1) (t:n) (w:continual doing/repeated practice) (d:<niloh>, continually, with the noun ending <na>: doing something again and again; in Amos, {a khialh kikkik nilohna} is sinning time after time) (b:niloh) (r:30.2.1) (q:draft)
nilsuk = (i:1) (t:v) (w:throw down/pour down/hurl down) (d:<nil>, throw, with <suk>, downward: throw or pour down into a lower place) (s:lawnsuk) (b:nil) (q:draft)
nim = (i:1) (t:adj) (w:overcast/gloomy/dull) (d:dull and dark, said of the weather; {khua nim} is the sky is overcast; also written <niim>) (s:niim) (q:draft)
Nimfa = (i:1) (t:name) (c:female) (w:Nympha) (d:Christian woman of Laodicea in whose house a church met) (r:51.4.15)
Nimrah = (i:1) (t:name) (c:place) (w:Nimrah) (d:town east of the Jordan that the tribes of Reuben and Gad asked for, also called Beth Nimrah) (r:4.32.3)
Nimrim = (i:1) (t:name) (c:place) (w:Nimrim) (d:place in Moab known for its waters, which the prophets say will dry up) (r:23.15.6/24.48.34)
Nimrod = (i:1) (t:name) (c:male) (w:Nimrod) (d:son of Cush, a mighty warrior and hunter who founded a kingdom in Shinar and Assyria) (r:1.10.8)
Nimshi = (i:1) (t:name) (c:male) (w:Nimshi) (d:father of Jehoshaphat and grandfather of Jehu king of Israel, who is often called son of Nimshi) (r:11.19.16/12.9.14)
nin = (i:2) (t:n) (w:dirt/filth/impurity) (d:dirt or uncleanness; {nin nei}, have uncleanness, is said of a woman in her monthly period) (s:nitna) (a:siangna) (r:38.9.3) (q:draft)
Nin = (i:1) (t:n) (w:Dung) (d:<nin>, dirt or filth, written with a capital in the name {Nin Kongpi}, the Dung Gate of Jerusalem, and at the start of the cry {Nin, nin}, Unclean, unclean) (b:nin) (q:draft)
ninamte = (i:1) (t:n) (w:nations) (d:stands where <minamte>, nations, is expected; possibly a misprint) (q:draft, low confidence)
ninbuakna = (i:1) (t:n) (w:rubbish heap/ash heap/dump) (d:<nin> dirt, with <buak> pour out and the noun suffix <na>: place where refuse is thrown) (s:ninkholna/ninphual/ninlom) (q:draft)
ninbulom = (i:1) (t:n) (w:filth/rubbish/refuse) (d:a compound of <nin>, dirt: dirt or rubbish that is thrown out, also a picture of something worthless) (s:nin) (q:draft)
ninbulomtang = (i:1) (t:n) (w:heap of rubble/heap of ruins/rubbish heap) (d:the pile of rubble that is left of a destroyed town or house; {ninbulomtang suak} is become a heap of ruins) (s:ninkholna/ninkikholna) (q:draft)
ninbulomtangin = (i:1) (t:n) (w:into heaps of rubble) (d:<ninbulomtang> heap of rubble, with the marker <in>) (b:ninbulomtang) (q:draft, low confidence)
nindalna = (i:1) (t:n) (w:menstrual protection) (d:<nin> impurity, with <dal> block and the noun suffix <na>; {numei nindalna puan} is a menstrual cloth) (q:draft)
Nineveh = (i:1) (t:name) (c:land/city) (w:Nineveh) (d:capital city of Assyria on the Tigris, founded by Nimrod, to which Jonah was sent to preach) (r:1.10.11/1.10.12)
ning = (i:1) (t:part) (w:I will/let me) (d:verb-final word for the first person singular, stating what the speaker intends to do or asks leave to do) (q:draft)
ning = (i:2) (t:n) (w:side/corner) (d:side or edge of an object; {a ning kim} or {a ning kikim}, with equal sides, renders square) (q:draft, low confidence)
ning = (i:3) (t:v) (w:stink/go rotten) (d:smell bad from going rotten, said of food kept too long) (s:uih) (q:draft, low confidence)
ninga = (i:1) (t:n) (w:five days) (d:<ni>, day, with <nga>, five, written together; {a ninga ni} is the fifth day and {nisawm leh ninga} is fifteen days) (q:draft)
ningsing = (i:1) (t:n) (w:ebony) (d:a hard black wood traded as a luxury, named together with <saiha>, ivory) (q:draft)
ningthei = (i:1) (t:adj) (w:perishable/that spoils) (d:<ning>, go rotten, with <thei>, can: able to spoil, said of food that does not last) (s:muatthei/siathei) (b:ning) (q:draft)
nini = (t:see) <nini-in>
nini-in = (i:1) (t:adv) (w:day by day/daily) (d:<ni>, day, doubled, with <in>; used as {a nini-in}) (s:nisimin/nisim) (q:draft)
ninih = (i:1) (t:num) (w:second day/two days) (d:<ni> day, with <nih> two; {a ninih ni} is the second day) (q:draft)
ninin = (i:1) (t:adv) (w:as unclean/unclean/impure) (d:<nin>, unclean, with the ending <in>: in an unclean state; {a ninin ngaihsun} is regard as unclean) (a:siangin) (b:nin) (q:draft)
ninkholna = (i:1) (t:n) (w:rubbish heap/dunghill/refuse heap) (d:<nin>, dirt, with <khol>, heap up, and the noun suffix <na>: place where refuse is piled up, also a town left in ruins) (s:ninbulomtang/ninphual/eekkholna) (q:draft)
ninkikholna = (i:1) (t:n) (w:heap of ruins/rubbish heap) (d:<nin> dirt, with <kikhol> be piled up and the noun suffix <na>: place where rubbish is heaped) (s:ninkholna/ninbulomtang) (q:draft)
ninlom = (i:1) (t:n) (w:rubbish heap/dung heap) (d:<nin>, dirt, with <lom>, heap) (s:ninphual/ninkholna) (q:draft, low confidence)
ninna = (i:1) (t:n) (w:uncleanness/stain/spot) (d:<nin>, unclean, with the noun suffix <na>: a stain or spot of uncleanness; {ninna tawh kinuh loin} is spotless) (s:nitna) (a:siangna/sianthona) (b:nin) (q:draft)
ninnei = (i:1) (t:adj) (w:menstruating/unclean) (d:<nin>, impurity, with <nei>, have: said of a woman during her monthly period) (q:draft)
ninneih = (i:1) (t:n) (w:period/discharge/uncleanness) (d:form of <ninnei> used before <hun> and <sung>: the time a woman is unclean) (b:ninnei) (q:draft)
ninneite = (i:1) (t:n) (w:those with a discharge/unclean persons) (d:<ninnei> having an impurity, with plural <te>) (b:ninnei) (q:draft)
ninnen = (i:1) (t:n) (w:whirling dust/litter) (d:light rubbish blown round in a whirlwind) (q:draft, low confidence)
ninneng = (i:1) (t:n) (w:speck/mote/bit of dust) (d:a tiny bit of dirt or dust; {ninneng tang} is a single speck, and {ninneng bang} is like rubbish, worthless) (s:ninthem) (r:40.7.5) (q:draft)
nino = (i:1) (t:n) (w:day before the Sabbath/eve) (d:{nino ni} explains {Kigin ni}, Preparation Day; the build of the word is not clear) (q:draft, low confidence)
ninpa = (i:1) (t:n) (w:unclean man/unclean person) (d:<nin>, unclean, with <pa> marking a man) (b:nin) (q:draft)
ninpa = (i:2) (t:n) (w:stubble) (d:dry stalks that fire burns up; a spelling of <niinpa>) (s:niinpa/buhtu/nahpa) (q:draft, low confidence)
ninphual = (i:1) (t:n) (w:ash heap/rubbish heap/dunghill) (d:<nin>, dirt, with <phual>, place) (s:ninkholna/ninlom/ninbuakna) (q:draft)
ninsa = (i:1) (t:adj) (w:defiled/made unclean) (d:<nin>, unclean, with <sa>, already done) (b:nin) (q:draft)
ninsak = (i:1) (t:v) (w:defile/make unclean/desecrate) (d:<nin>, unclean, with the causative <sak>: make a person, a place or a holy thing unclean) (s:nitsak/niinsak/kihhuaisak/thanghuaisak) (a:siangsak/siansak) (b:nin) (r:24.32.34) (q:draft)
ninsakin = (i:1) (t:v) (w:defiling/making unclean) (d:<ninsak>, defile, with the linking ending <in>, which joins it to the following verb) (b:ninsak) (q:draft)
ninsakkha = (i:1) (t:v) (w:defile/happen to defile) (d:<ninsak>, defile, with <kha>, happen to: make something unclean, even without meaning to) (q:draft)
ninsakkik = (i:1) (t:v) (w:make dirty again/soil again) (d:<ninsak> make unclean, with <kik> again) (b:ninsak) (q:draft)
ninsakthei = (i:1) (t:v) (w:can defile/be able to make unclean) (d:<ninsak> defile, with <thei>, be able) (b:ninsak) (q:draft)
ninsakzo = (i:1) (t:v) (w:have defiled) (d:<ninsak> defile, with <zo> marking a completed action) (b:ninsak) (q:draft)
ninte = (i:1) (t:n) (w:unclean things/unclean ones/defilement) (d:plural of <nin>; things or persons that are dirty or ritually unclean) (b:nin) (r:3.11.29) (q:draft)
ninteng = (i:1) (t:n) (w:all the impurities/all the dirt) (d:<nin> dirt, with <teng> all) (b:nin) (q:draft)
ninthem = (i:1) (t:n) (w:speck/mote) (d:tiny bit of dirt or dust) (s:ninneng) (r:42.6.41) (q:draft)
nip = (i:1) (t:adj) (w:soft) (d:soft, not hard or stiff; {tutphah nip}, a soft seat, is a couch or cushion) (s:nem/neem) (a:khauh/sak) (q:draft)
Nipi = (i:1) (t:n) (w:Sabbath) (d:the day of rest, usually {Nipi ni}, the Sabbath day) (s:Sabbath/sabbath/Nipini) (b:nipi) (r:42.13.10) (q:draft)
nipikalte = (i:1) (t:n) (w:weeks) (d:<nipikal>, week, with the plural <te>; {Nipikalte’ pawi} is the Festival of Weeks) (b:nipikal)
Nipikalte = (i:1) (t:n) (w:weeks) (d:<nipikal> week with plural <te>; {Nipikalte’ pawi} is the Festival of Weeks) (b:nipikalte) (q:draft)
Nipini = (i:1) (t:n) (w:Sabbath day/Sabbath) (d:<Nipi> Sabbath with <ni> day) (s:Sabbath/sabbath) (b:Nipi) (q:draft)
nipisim = (i:1) (t:adj) (w:weekly/every week) (d:<nipi> week or Sabbath, with <sim> every; {a nipisim pawite} renders her Sabbath days) (q:draft)
nipna = (i:1) (t:n) (w:softness/soft place) (d:<nip>, soft, with the noun suffix <na>: softness; {a nipna mun} is a soft place) (s:nemna) (b:nip) (q:draft)
nipsak = (i:1) (t:v) (w:soften/soak/drench) (d:<nip> with the causative <sak>; make ground soft and wet through) (s:kawtsak) (b:nip) (q:draft)
nipzaw = (i:1) (t:adj) (w:softer/more soothing) (d:<nip>, soft, with <zaw>, more) (s:nelzaw) (a:sakzaw) (b:nip) (q:draft)
nisa = (i:1) (t:n) (w:heat of the sun/heat/sunshine) (d:from <ni> sun and <sa> hot) (s:nisat) (q:draft)
nisagih = (i:1) (t:n) (w:week) (d:<ni> day, with <sagih> seven: seven days) (s:nipikal) (q:draft)
Nisan = (i:1) (t:name) (w:Nisan) (d:first month of the Hebrew year, in spring, the month of the Passover) (r:16.2.1/17.3.7)
nisat = (i:1) (t:n) (w:heat of the day/heat of the sun) (d:form of <nisa>; {sun nisat hun} is the hot part of the day around noon, {nisat hun} the hot season) (s:nisa) (b:nisa) (q:draft)
nisawm = (i:1) (t:n) (w:ten days) (d:<ni>, day, with <sawm>, ten; {nisawm-le-nih} is twelve days, and with <ni> after it the day of the month, {nisawm leh nili ni} the fourteenth day) (r:27.1.15) (q:draft)
nisim = (i:1) (t:adv) (w:daily/every day/regularly) (d:<ni> day with <sim>, each; also placed before a noun as in {nisim nasep}, daily work) (s:nisimin) (q:draft)
nisima = (i:1) (t:adv) (w:daily/of each day/every day) (d:<nisim>, daily, with the linking <a>) (b:nisim) (q:draft)
nisimin = (i:1) (t:adv) (w:daily/every day) (d:<nisim>, daily, with the adverb ending <in>: every day, day after day) (s:nisim) (r:26.43.25) (q:draft)
Nisrok = (i:1) (t:name) (w:Nisrok) (d:god of the Assyrians, in whose temple King Sennacherib was killed by his sons) (r:12.19.37/23.37.38)
nisuah = (i:1) (t:n) (w:sunrise) (d:<ni>, sun, with <suah>, come out; the time when the sun rises, set against <nitum>, sunset) (s:nisuak) (a:nitum) (q:draft)
nisuahna = (i:1) (t:n) (c:direction) (w:east) (d:the side where the sun rises, <nisuah> sunrise with the noun suffix <na>; {nisuahna lam} is the east side or eastward) (s:suahna) (a:nitumna) (b:nisuah) (r:1.2.8)
Nisuahna = (i:1) (t:n) (c:direction) (w:east) (d:written with a capital in the Bible text, as in {Nisuahna lam mite}, the peoples of the East, and {Nisuahna Kongpi}, the East Gate) (a:Nitumna) (b:nisuahna) (r:16.3.29) (q:draft)
nisuak = (i:1) (t:n) (w:sunrise/dawn/rising sun) (d:<ni>, sun, with <suak>, come out: the rising sun or the time when it rises; {nisuak tung} is the moment of sunrise) (s:nisuah) (a:nitum) (q:draft)
nisuh = (i:1) (t:n) (c:plant) (w:palm/palm tree/date palm) (d:{nisuh kung} is the tree and {nisuh gah} its fruit) (r:5.34.3) (q:draft)
nisuhkung = (i:1) (t:n) (c:plant) (w:palm tree) (d:<nisuh> palm, with <kung> tree) (s:Tumkung) (q:draft)
nisuhte = (i:1) (t:n) (c:plant) (w:palms/palm trees) (d:<nisuh>, palm, with the plural ending <te>) (b:nisuh) (q:draft)
nit = (i:1) (t:adj) (w:unclean/defiled/filthy) (d:dirty or ceremonially unclean, the form of <nin> used before words such as <hun>, <sung>, <sak> and <lohna>; {a nit hun}, the time of her uncleanness, is a woman's monthly period) (s:nin) (a:siang) (r:3.18.19) (q:draft)
nitaang = (i:1) (t:n) (w:sunshine/sunlight) (d:the light of the sun; {sun nitaang} is the bright sun of midday) (q:draft)
Nitak = (t:see) <Nitak-an>
Nitak-an = (i:1) (t:n) (w:supper/evening meal) (d:<nitak> evening with <an> food; {Topa’ Nitak-an} is the Lord's Supper) (q:draft)
nitakin = (i:1) (t:adv) (w:in the evening/at twilight) (d:<nitak> evening with the ending {-in}; {tu nitakin} means tonight) (a:zingsangin) (b:nitak) (q:draft)
nitawp = (i:1) (t:n) (w:last day/end time) (d:<ni>, day, with <tawp>, end; nearly always {nitawp ni}, the last day, the day of resurrection and judgment) (q:draft)
nite = (i:1) (t:n) (w:days) (d:<ni> with plural {-te}; {sabbath nite}, {khadet nite} and {pawi nite} are the Sabbaths, New Moon days and feast days) (b:ni) (r:13.23.31) (q:draft)
niteh = (i:1) (t:part) (d:sentence-final word in reported thought, it must be so, surely) (q:draft, low confidence)
nithum = (i:1) (t:n) (w:three days) (d:<ni>, day, with <thum>, three; {nithum sung} is for three days) (r:6.3.2) (q:draft)
nithum = (i:2) (t:n) (w:third day) (d:followed by <ni>, {nithum ni}, the third day) (q:draft)
nitna = (i:1) (t:n) (w:uncleanness/impurity/defilement) (d:<nit>, unclean, with the noun suffix <na>: the state of being ritually unclean, or an unclean act) (s:ninna) (a:siangna) (b:nit) (q:draft)
nitnateng = (i:1) (t:n) (w:all uncleanness/all impurity) (d:<nitna> uncleanness, with <teng> all) (b:nitna) (q:draft)
nitsak = (i:1) (t:v) (w:defile/make unclean/desecrate) (d:<nit>, unclean, with the causative <sak>: make a person, a place or a holy thing unclean) (s:ninsak) (a:siangsak/siansak) (b:nit) (q:draft)
nitsakna = (i:1) (t:n) (w:defilement/desecration/profaning) (d:act of making something unclean) (b:nitsak) (q:draft)
nitsan = (i:1) (t:v) (w:sniff at/blow the nose at) (d:with <nap>, nasal mucus: <nit>, blow the nose, with <san>, toward someone; a gesture of contempt) (q:draft, low confidence)
nitum = (i:1) (t:n) (w:sunset/sundown) (d:<ni> sun with <tum> set, the time when the sun goes down) (a:nisuah) (q:draft)
nitumna = (i:1) (t:n) (c:direction) (w:west) (d:the place of sunset, from <ni> sun and <tum> set) (s:tumna) (a:nisuahna) (q:draft)
Nitumna = (i:1) (t:n) (c:direction) (w:west) (d:{Nitumna Tuipi}, the western sea, is the Mediterranean Sea) (a:Nisuahna) (b:nitumna) (q:draft)
nitumte = (i:1) (t:n) (w:idlers/drowsy ones) (d:<nitum>, sunset, with <te>, those who: those who only eat and let the day go by till sunset; the English has drowsiness) (b:nitum) (q:draft, low confidence)
nizang = (i:1) (t:n) (w:sunbeam/ray of the sun/sunshine) (d:<ni>, sun, with <zang>; the light that the sun sends out) (q:draft, low confidence)
no = (i:1) (t:pron) (w:you) (d:second person plural pronoun; before a noun it addresses a group, as in {no tuucingte aw}, you shepherds, and before <kong> or <hong> it is the object of the verb) (s:nang/note) used for only the plural
No = (i:1) (t:pron) (w:you) (d:<no>, you plural, written with a capital at the start of a sentence: it addresses a group or is the object of the verb) (b:no) (q:draft)
Noadiah = (i:1) (t:name) (c:male/female) (w:Noadiah) (d:name of two people: a Levite, son of Binnui, who helped weigh the temple treasures in the time of Ezra, and a prophetess who tried to frighten Nehemiah) (r:15.8.33/16.6.14)
noah = (t:see) <noah-taaksing>
Noah = (i:1) (t:name) (c:male) (w:Noah) (d:son of Lamech, who built the ark and with his family survived the flood) (r:1.5.29/1.7.5)
noah-taak = (i:1) (t:n) (c:plant) (w:cypress/gopher wood) (d:the tree whose wood was used for the ark; {noah-taak sing} is its wood) (q:draft, low confidence)
noah-taaksing = (i:1) (t:n) (c:plant) (w:cypress wood/gopher wood) (d:<noah-taak> with <sing> wood: the wood used for the ark) (q:draft, low confidence)
noahtaak = (i:1) (t:n) (c:plant) (w:gopher) (d:the tree whose wood was used for the ark of Noah; written <noah-taak> in the Bible text)
Noahte = (i:1) (t:name) (c:female) (w:Noah) (d:<Noah> with the plural <te>, Noah and the others: one of the five daughters of Zelophehad of the tribe of Manasseh) (r:4.36.11)
Nob = (i:1) (t:name) (c:city) (w:Nob) (d:town of the priests in Benjamin near Jerusalem, where Ahimelek the priest helped David) (r:9.22.9) (q:draft)
Nobah = (i:1) (t:name) (c:male/place) (w:Nobah) (d:man of Manasseh who captured Kenath and named it Nobah after himself; also a place east of the Jordan near Jogbehah) (r:4.32.42/7.8.11)
Nobo = (i:1) (t:name) (c:city) (w:Nebo) (d:town of Moab named in the judgment on Moab, spelled Nebo in the NIV) (r:24.48.22)
Nod = (i:1) (t:name) (c:land) (w:Nod) (d:land east of Eden where Cain settled) (r:1.4.16)
Nodab = (i:1) (t:name) (c:people) (w:Nodab) (d:people east of the Jordan, defeated together with the Hagrites by Reuben, Gad and the half tribe of Manasseh) (r:13.5.19)
Nogah = (i:1) (t:name) (c:male) (w:Nogah) (d:son of David born in Jerusalem) (r:13.3.7/13.14.6)
noh = (i:1) (t:v) (w:caress/fondle) (d:touch a wife or husband lovingly) (q:draft)
Nohah = (i:1) (t:name) (c:male/place) (w:Nohah) (d:fourth son of Benjamin; in Judges 20:43 the Tedim text also has {Nohah} as a place near Gibeah) (r:7.20.43/13.8.2)
nokik = (i:1) (t:v) (w:sprout anew/grow fresh again) (d:of grass, come up young again, with <kik> again) (q:draft, low confidence)
nokkhak = (i:1) (t:v) (w:hinder/hold back/trouble) (d:get in the way of what someone does; {nokkhak sak} is detain or weary someone) (s:khaktan) (q:draft, low confidence)
noleno = (i:1) (t:pron) (w:yourselves) (d:<no>, you plural, said twice and joined by <le>, and; used with a verb in <ki> for what people do to themselves) (q:draft)
nolh = (i:1) (t:v) (w:reject/refuse/turn away) (d:refuse to accept or welcome a person or thing) (s:nial) (a:saang) (q:draft)
nolhkhitna = (i:1) (t:n) (w:rejection/having rejected) (d:<nolh> reject, with <khit> finished and the noun suffix <na>: the fact of having rejected) (q:draft)
nolhte = (i:1) (t:n) (w:those who reject/whoever rejects) (d:<nolh>, reject, with <te>, those who) (s:nialte) (b:nolh) (q:draft)
nom = (i:1) (t:n) (w:moisture/dampness) (d:wetness in the soil; in the list of plagues in Deuteronomy 28:22 {a nom} stands where the NIV has mildew) (q:draft)
nomau = (i:1) (t:pron) (w:yourselves/you/your own) (d:second person plural, emphatic or reflexive; with <aa> or the possessive mark, yours) (q:draft)
nomsak = (i:1) (t:v) (w:moisten/wet/make damp) (d:<nom> with the causative <sak>; of dew wetting branches and of clouds filled with moisture) (s:kawtsak) (a:keusak) (b:nom) (q:draft)
nona = (i:1) (t:n) (d:<no>, young or tender, with the noun suffix <na>; in {lo nona}, a place of fresh young grass, green pasture or grassland) (b:no) (q:draft)
nong = (i:1) (t:pron) (w:you) (d:second person subject marker used when the action is directed at the speaker, you to me or you to us, placed before the verb) (r:43.16.31/1.3.12)
Nong = (i:1) (t:pron) (w:you) (d:second person subject acting on the speaker, you to me, placed before the verb) (b:nong) (q:draft)
nongeekte = (i:1) (t:n) (w:chicks/young ones) (d:<no>, young, with <ngeek>, tender, and the plural ending <te>: the very young of a bird or animal, in the verses the chicks of a hen) (r:42.13.34) (q:draft)
nongek = (i:1) (t:n) (w:tender young/suckling young) (d:<no> young of an animal, with <ngek> tender; {a nongek neite} is those nursing their young) (q:draft)
nono = (i:1) (t:part) (d:placed after a descriptive word to speak of several things that each have that quality, as {hoih nono} fine ones and {anlim nono} choice foods) (q:draft)
nonote = (i:1) (t:part) (d:<nono> with the plural ending <te>, placed after a descriptive word for several things that each have that quality; {haksa nonote}, the hard ones) (b:nono) (q:draft)
nop = (i:1) (t:v) (w:want/wish/desire) (d:form of <nuam> used after another verb in dependent clauses, want to, be willing to) (s:nuam) (q:draft)
nopci = (i:1) (t:adj) (w:pleasant/delightful) (d:of a land that is good to live in) (s:noptuak) (q:draft)
nopcitna = (i:1) (t:n) (w:luxury/splendor/delight) (d:<nopci> pleasant, with the noun suffix <na>) (q:draft)
nopmawhna = (i:1) (t:n) (w:unease/trouble/discomfort) (d:{lungsim nopmawhna} is a troubled conscience) (q:draft)
nopna = (i:1) (t:n) (w:peace/well-being/happiness/pleasure) (d:a state of peace, well-being or enjoyment; {nopna om ta hen} is a greeting, peace be with you) (s:nopsakna/lungnopna/nuamna) (a:dahna) (b:nop) (q:draft)
nopna = (i:2) (t:n) (w:wish/desire/intention) (d:after a verb, the wish or intention to do it; {cih nopna}, what one wants to say, is the meaning of a word or name) (s:deihna) (b:nop) (q:draft, low confidence)
Nopna = (i:1) (t:n) (w:peace/well-being) (d:{Nopna lampi} is the way of peace) (b:nopna) (q:draft)
nopnate = (i:1) (t:n) (w:wishes/desires/intentions) (d:after a verb, the things one wants to do, as {nget nopnate}, requests) (s:deihnate) (b:nopna) (q:draft)
nopnate = (i:2) (t:n) (w:peace/happiness/joys) (d:plural of <nopna>: peace and well-being, named together with glory and honour) (b:nopna) (q:draft)
nopnehte = (i:1) (t:n) (w:the humble/the meek) (d:plural with <te>; the build of the word is not clear) (q:draft, low confidence)
nopsa = (t:see) <nopsa-a>
nopsa-a = (i:1) (t:adv) (w:in pleasure/enjoying oneself) (d:<nopsa> find pleasant, enjoy, with the linking <a>; {nopsa-a om} is live for pleasure) (q:draft)
nopsak = (i:1) (t:v) (w:go well/prosper/be well off/enjoy) (d:fare well or enjoy good things; {na nopsak theih nadingun} means so that it may go well with you, and {nopsak nading} is for the well-being of) (s:nuamsa) (b:nop) (q:draft)
nopsaklawh = (i:1) (t:v) (w:enjoy instead/get the enjoyment of) (d:<nopsak>, enjoy, with <lawh>, get as gain: another person gets the enjoyment of what someone owns) (q:draft)
nopsakna = (i:1) (t:n) (w:peace/rest/well-being/comfort) (d:<nopsak>, fare well, with the noun suffix <na>: peace, rest and well-being; {ka nopsakna mun} is my place of rest) (s:nopna/lungmuanna) (a:gimna) (q:draft)
Nopsakna = (i:1) (t:n) (w:peace) (d:<nopsakna>, peace, written with a capital at the start of a sentence and in the title {Nopsakna Kumpi}, Prince of Peace) (b:nopsakna) (q:draft)
nopsaknate = (i:1) (t:n) (w:fortunes/riches/pleasures/comforts) (d:plural of <nopsakna>: good times, prosperity and the good things enjoyed) (s:hauhnate) (b:nopsakna) (q:draft)
nopsaknateng = (i:1) (t:n) (w:all comforts/all well-being) (d:<nopsakna>, comfort or well-being, with <teng>, all of) (b:nopsakna) (q:draft, low confidence)
noptaksa = (t:see) <noptaksa-in>
noptaksa-in = (i:1) (t:adv) (w:taking advantage/exploiting) (d:acting toward someone as suits one's own pleasure; seems to be <nop>, pleasant, with <tak>, <sa>, deem, and <in>) (q:draft, low confidence)
noptat = (i:1) (t:v) (w:revel/indulge/live for pleasure) (d:live for pleasure without restraint; {noptat nuamte} are lovers of pleasure and {noptat khamna} is self-control) (q:draft)
noptatin = (i:1) (t:v) (w:reveling/living for pleasure) (d:<noptat>, revel, with <in> linking it to the next verb) (b:noptat) (q:draft)
noptatna = (i:1) (t:n) (w:indulgence/dissipation/wild living) (d:<noptat> with the noun suffix <na>; living for pleasure without restraint; {noptatna khamna}, the holding back of it, is self-control) (s:uangtatna) (b:noptat) (q:draft)
nopte = (i:1) (t:n) (w:those one wants to) (d:<nop> want with plural <te>, after a verb: the ones whom, or the things which, someone wishes to) (s:nuamte) (b:nop) (q:draft)
noptheih = (i:1) (t:v) (w:be cheered/be glad) (d:<nop>, form of <nuam>, be happy, with <theih>, be able; with <lung> or <lungsim>, heart, and <nadingin>: so that the heart may be glad) (b:nop) (q:draft)
noptheihna = (i:1) (t:n) (w:being cheered/refreshment) (d:<noptheih>, be cheered, with the noun suffix <na>; with <dingin>: so that the mind may be glad) (b:noptheih) (q:draft)
noptuak = (i:1) (t:adj) (w:pleasant/comfortable/agreeable) (d:of land or a place that is good to be in) (s:omnuam) (q:draft)
noptuam = (i:1) (t:n) (w:benefit/good/relief/advantage) (d:what makes someone better off; {noptuam nading} is for the good of) (s:noptuamna/phattuamna) (q:draft)
noptuam = (i:2) (t:v) (w:get better/improve/recover) (d:become better, of a sick person or a sore) (s:nuamtuam) (q:draft)
noptuamin = (i:1) (t:v) (w:getting better/easing) (d:<noptuam>, get better, with <in> linking it to what follows; of a sore that has eased and not spread, where the English has unchanged) (b:noptuam) (q:draft, low confidence)
noptuamna = (i:1) (t:n) (w:benefit/profit/good/reward) (d:what is to someone's advantage or comfort) (s:phattuamna/thaman) (a:supna) (b:noptuam) (q:draft)
noptuamsak = (i:1) (t:v) (w:make well/refresh/relieve) (d:<noptuam>, get better, with <sak>, cause: make a sick person well or put a mind at ease) (s:damsak/nuamtuamsak) (b:noptuam) (q:draft)
noptuamsakin = (i:1) (t:v) (w:making well/raising up) (d:<noptuamsak>, make well, with <in> linking it to the next verb) (b:noptuamsak) (q:draft)
noptuamzaw = (i:1) (t:v) (w:get better/improve more) (d:<noptuam>, get better, with <zaw>, more; {noptuamzaw loin} is instead of getting better) (b:noptuam) (q:draft)
nopzawk = (i:1) (t:v) (w:want more/would rather) (d:<nop>, form of <nuam>, want, with <zawk>, form of <zaw>, more: want to do something more for one than for another) (s:nuamzaw/utzaw) (q:draft)
nosak = (i:1) (t:v) (w:refresh/make fresh/freshen) (d:<no>, young and tender, with <sak>, cause; of dew that makes grass and earth fresh again) (q:draft)
nosakkik = (i:1) (t:v) (w:refresh again/make fresh again) (d:<nosak>, make fresh, with <kik>, again) (b:nosak) (q:draft)
nosuak = (i:1) (t:v) (w:become fresh/revive/be refreshed) (d:<no>, young and tender, with <suak>, become; {nosuak sak kik} is refresh or revive again) (q:draft)
nosuaksakkik = (i:1) (t:v) (w:refresh/revive/restore) (d:<nosuak>, become fresh, with <sak>, cause, and <kik>, again) (q:draft)
nota = (i:1) (t:v) (w:become green/grow fresh) (d:<no>, young and tender, with <ta> marking a change that has now come: of grass, be fresh and green again) (q:draft, low confidence)
note = (i:1) (t:adj) (w:small) (s:neute) (a:liante)
note = (i:2) (t:adj) (w:little) (s:neute)
Note = (i:1) (t:pron) (w:you/your) (d:<note>, you plural, written with a capital at the start of a clause or quotation; English has you or your depending on the place in the sentence) (b:note) (r:33.3.9) (q:draft)
noteng = (i:1) (t:pron) (w:you/all of you) (d:<no>, you plural, with <teng>, all of: the whole group spoken to) (b:no) (r:27.2.9) (q:draft)
notkhia = (i:1) (t:v) (w:drive away/drive out/expel) (d:<not>, push, with <khia>, out: force someone to leave a place) (s:hawlkhia) (b:not) force to leave a place.
notkhiasiang = (i:1) (t:v) (w:drive out completely/clear out) (d:<notkhia>, drive away, with <siang>, clean: drive out until none is left) (b:notkhia) (q:draft)
notkhiazo = (i:1) (t:v) (w:be able to drive away/ward off) (d:<notkhia>, drive away, with <zo>, be able) (b:notkhia) (q:draft)
notkik = (i:1) (t:v) (w:drive back/push back/force back) (d:<not> push, with <kik> back) (s:hawlkik) (b:not) (q:draft)
notzo = (i:1) (t:v) (w:be able to push back/repulse) (d:<not>, push, with <zo>, be able) (b:not) (q:draft)
nu = (i:2) (t:n) (w:woman) (d:a woman, placed after a word that describes her; {tua nu} is that woman, she) (s:numei) (a:pa) (r:1.38.3)
nu = (i:3) (t:n) (w:feminine) (d:marks a female person or animal at the end of a word, as <pa> marks a male one) (a:pa)
nu = (i:4) (t:n) (w:female) (d:the female of a pair or of an animal, set against <pa>, the male) (a:pa) (r:1.7.3)
Nu = (i:1) (t:n) (w:mother) (d:<nu> written with a capital in the address {Nu aw}, mother, and in a title, the Mother of) (b:nu) (q:draft)
nu'ng = (i:1) (t:part) (w:let us) (d:verb-final word for the first person plural, proposing an action to be done together: let us, we will) (q:draft)
nuai = (i:1) (t:adv) (w:under/below) (d:the place under or below something; usually followed by <ah>, as in {ka nuai-ah}, under me) (a:tunglam) (r:19.18.38)
nuaiah = (i:1) (t:prep) (w:under/beneath/below) (d:<nuai> with the place marker <ah>, placed after the noun; also of rank, lower than) (a:tungah) (b:nuai) (r:24.43.9) (q:draft)
nuaigawp = (i:1) (t:v) (w:oppress/crush) (d:press a people down hard; <gawp> shows that the action is severe) (q:draft)
nuaikhiat = (i:1) (t:v) (w:make lower/put below) (d:<nuai>, under, with <khiat>, down: set someone in a lower place) (b:nuai) (q:draft)
nuaikiat = (i:1) (t:v) (w:go down/sink to the bottom) (d:<nuai>, under, with <kiat>, form of <kia>, fall: come to be below, the opposite of going up) (q:draft)
nuailam = (i:1) (t:n) (w:below/lower side/beneath) (d:<nuai>, under, with <lam>, side or direction; {nuailam mi} is one who is from below, set against <tunglam>, above) (q:draft)
nuaimang = (i:1) (t:v) (w:destroy utterly/wipe out/annihilate) (d:destroy completely so that nothing is left; <mang> shows that the object disappears) (s:susiamang/thatmang) (q:draft)
nuainung = (i:1) (t:adj) (w:lower/lowest) (d:the lower or lowest of two or more things, set against <tungnung>, upper; {Bethhoron nuainung} is Lower Beth Horon) (a:tungnung) (r:1.6.16)
Nuainung = (i:1) (t:adj) (w:Lower) (d:capitalised form of <nuainung> used in place names, {Bethhoron Nuainung} is Lower Beth Horon) (b:nuainung) (q:draft)
nuainungin = (i:1) (t:adv) (w:underneath/at the bottom) (d:<nuainung>, lower, with <in>: being placed lowest, under the rest) (b:nuainung) (q:draft)
nuainungte = (i:1) (t:adj) (w:lower) (d:<nuainung>, lower, with the plural <te>; {tuikhuk nuainungte}, the lower springs, set against <tungnungte>, the upper ones) (b:nuainung) (q:draft)
nuaiphah = (i:1) (t:n) (w:foundation/base) (d:<nuai>, under, with <phah>, lay out: what is laid beneath a wall) (q:draft)
nuaiphahin = (i:1) (t:n) (w:as a foundation) (d:<nuaiphah>, foundation, with <in>, as) (b:nuaiphah) (q:draft)
nuaiphahte = (i:1) (t:n) (w:foundations) (b:nuaiphah) (q:draft)
nuaisiah = (i:1) (t:v) (w:subdue/bring under/overcome) (d:put a defeated people under one's rule) (q:draft)
nuaisiah = (i:2) (t:adv) (w:and under/below/downward) (d:after a number, an age or a part of the body, from that point downward) (a:tungsiah) (q:draft)
nuaisiahin = (i:1) (t:v) (w:subduing/bringing under) (d:<nuaisiah>, subdue, with <in> linking it to the next verb) (b:nuaisiah) (q:draft)
nuaisiahna = (i:1) (t:n) (w:oppression/subjugation) (d:<nuaisiah>, bring under, with the noun suffix <na>; {mi nuaisiahna} is the oppression of people) (s:nenniamna/netniamna) (b:nuaisiah) (q:draft)
nuaite = (t:see) <nuaite-ah>
nuaite-ah = (i:1) (t:prep) (w:under/beneath) (d:<nuai>, the underside, with plural <te> and <ah>, at: in the places under several things) (q:draft)
nuak = (i:1) (t:v) (w:sulk/take offence) (d:be offended and withdraw; {nuak ciah} seems to be go home in resentment, the English versions do not render the word) (q:draft, low confidence)
nuam = (i:2) (t:v) (w:delight) (d:find pleasant; {nuam sa} is take delight in)
Nuam = (i:1) (t:adj) (w:pleasant/fair/peaceful) (d:<nuam>, pleasant or at peace, written with a capital in the place name {Khawlmun Nuam}, Fair Havens, and at the start of the farewell {Nuam takin pai in}, go in peace) (b:nuam) (r:44.27.13) (q:draft)
nuama = (i:1) (t:v) (w:wanting/wishing) (d:<nuam> want with the linking ending <a>, joined to the verb before it; {that nuama}, wanting to kill) (b:nuam) (q:draft)
nuama = (i:2) (t:adj) (w:at ease/comfortable/pleasant) (d:<nuam> with the linking ending <a>, describing how one lives) (b:nuam) (q:draft, low confidence)
nuama = (i:3) (t:adj) (d:second part of {thu-nuama}, of fellowship or peace, as in {thu-nuama biakna} the fellowship offering) (b:nuam) (r:14.29.35) (q:draft)
nuamah = (i:1) (t:adj) (w:pleasant/good/level) (d:<nuam> pleasant with the place marker <ah>; {gam nuamah} in the pleasant land, {lam nuamah} on an easy path) (b:nuam) (q:draft)
nuamin = (i:1) (t:adj) (w:contrary)
nuamkawmin = (i:1) (t:adv) (w:joyfully/while glad) (d:<nuam>, be glad, with <kawmin>, while; {laukawm nuamkawmin} is afraid and glad at the same time) (q:draft)
nuamkik = (i:1) (t:v) (w:be comforted/be glad again) (d:<nuam>, be glad, with <kik>, again; said of the <lungsim>, mind) (s:nuamtuam) (b:nuam) (q:draft)
nuamlua = (i:1) (t:adj) (w:overjoyed/very glad) (d:<nuam>, happy, with <lua>, too much) (b:nuam) (q:draft)
nuammawh = (i:1) (t:v) (w:bother/trouble/pick on) (d:be ill-disposed towards someone, find fault with) (r:42.8.28) (q:draft, low confidence)
nuammawh = (i:2) (t:v) (w:fret/be uneasy) (d:with <lung>, heart: be troubled in mind) (q:draft, low confidence)
nuamna = (i:1) (t:n) (w:joy/gladness/pleasure) (d:<nuam>, happy, with the noun suffix <na>: joy or gladness, often paired with <lungdamna>) (s:lungdamna/kipahna) (a:dahna) (b:nuam) (q:draft)
nuampa = (i:1) (t:n) (w:one who wants to) (d:<nuam>, want, with <pa>, the male one; after a verb, the man who wants to do it) (b:nuam) (q:draft)
nuampen = (i:1) (t:adj) (w:best/most pleasant/most comfortable) (d:<nuam>, pleasant, with <pen>, most; of seats, the most desirable) (b:nuam) (q:draft)
nuampente = (i:1) (t:adj) (w:best/most pleasant) (d:<nuampen>, most pleasant, with plural <te>; of seats, the most desirable ones) (b:nuampen) (q:draft)
nuampipi = (i:1) (t:v) (w:want greatly/long) (d:<nuam>, want, with <pipi>: while wanting very much; {nei nuampipi} is though longing to have a husband) (q:draft, low confidence)
nuamsa = (i:1) (t:v) (w:be happy/enjoy/be content) (d:<nuam>, pleasant, with <sa>, feel or deem: be happy, enjoy something; {mi nuamsa} is a blessed or happy person) (s:nopsak/lungkim) (a:genthei) (b:nuam) (q:draft)
nuamsak = (i:1) (t:v) (w:gladden/cheer/make happy) (d:<nuam>, glad, with causative <sak>; {lung nuamsak} is gladden the heart) (s:lungdamsak/lungnuamsak) (a:dahsak/lungkhamsak) (b:nuam) (q:draft)
nuamsakin = (i:1) (t:v) (w:gladdening/cheering/making merry) (d:<nuamsak>, gladden, with the linking ending <in>; {lung nuamsakin om} is enjoy oneself) (b:nuamsak) (q:draft)
nuamsasak = (i:1) (t:v) (w:make content/give rest/make happy) (d:<nuamsa>, be content, with <sak>, cause) (b:nuamsa) (q:draft)
nuamsate = (i:1) (t:n) (w:happy people/those who live at ease) (d:<nuamsa> be happy, enjoy, with the plural <te>: {mi nuamsate} is people who are happy or blessed, and also people who live in comfort) (b:nuamsa) (q:draft)
nuamtak = (i:1) (t:adv) (w:pleasantly/comfortably/at ease/safely) (d:<nuam> with <tak>, which makes an adverb; {nuamtak sa-in} means finding it easy or pleasant to do, without scruple) (s:nuamtakin) (b:nuam) (r:15.8.23) (q:draft)
nuamtakin = (i:1) (t:adv) (w:peacefully/in peace/safely/comfortably) (d:<nuam>, pleasant, with <takin>, which makes an adverb: in peace, in comfort or in safety) (s:nuamtak/lungmuangin) (b:nuam) (q:draft)
nuamtaksa = (i:1) (t:v) (w:take advantage of/exploit/seize the opportunity) (d:<nuamtak> with <sa>, deem: find something easy or convenient and so make use of it) (b:nuamtak) (q:draft)
nuamte = (i:1) (t:n) (w:those who want/whoever wants) (d:<nuam>, want, with plural <te>, placed after a verb: those who want to do it) (s:nopte/deihte/utte) (b:nuam) (q:draft)
nuamthei = (i:1) (t:v) (w:be able to be at ease/can be glad) (d:<nuam>, be glad, with <thei>, be able; {lungsim nuamthei nawn lo} is the mind could no longer be at ease) (b:nuam) (q:draft)
nuamtuam = (i:1) (t:v) (w:be relieved/be comforted/get better) (d:feel easier after pain, grief or sickness; with <sak>, give relief to) (s:noptuam/nuamkik) (q:draft)
nuamtuamin = (i:1) (t:adv) (w:restfully/in relief) (d:<nuamtuam>, be relieved, with <in>: being at ease, said of one who sleeps a healing sleep) (b:nuamtuam) (q:draft, low confidence)
nuamtuamsak = (i:1) (t:v) (w:comfort/give relief to/refresh) (d:<nuamtuam>, be relieved, with <sak>, cause) (s:hehnem/noptuamsak) (b:nuamtuam) (q:draft)
nuamzaw = (i:1) (t:v) (w:prefer/would rather) (d:<nuam> want with <zaw> more, used with <sangin> than) (s:utzaw/deihzaw/nopzawk) (b:nuam) (q:draft)
nuamzaw = (i:2) (t:adj) (w:better/more pleasant/more comfortable) (d:<nuam> pleasant with <zaw> more) (s:hoihzaw) (b:nuam) (q:draft)
nuangnuang = (i:1) (t:adv) (w:limply/feebly/droopingly) (d:describes weak hands that hang down limply; used after <zaw>, weak, in {zaw nuangnuang}, weak and drooping) (q:draft, low confidence)
Nubiate = (i:1) (t:name) (c:people) (w:Cushites/Nubians) (d:the Nubians, the people of Cush south of Egypt, named together with the Libyans; called Cushites in the NIV) (r:27.11.43)
Nubukhadnezzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:king of Babylon who captured Jerusalem and carried its people into exile; a spelling of the name used in this verse) (r:24.52.29)
nuh = (i:1) (t:v) (w:smear/anoint/rub on/apply) (d:put oil, blood or ointment on something by smearing or rubbing; {sathau nuh} is anoint with oil) (s:nilh) (r:3.8.23) (q:draft)
nuhin = (i:1) (t:v) (w:anoint/smear/rub on) (d:connective form of <nuh>, putting oil, perfume or blood on something, followed by another verb) (s:nilhin) (b:nuh) (q:draft)
nuhkawmin = (i:1) (t:v) (w:putting on/smearing on) (d:<nuh>, smear or rub on, with <kawmin>, while doing: as he put it on) (q:draft)
nuhkhit = (i:1) (t:v) (w:have anointed/have smeared) (d:<nuh>, smear or rub on, with <khit>, finished; {nuhkhit ciangin} is after anointing) (s:nilhzo) (q:draft)
nuhkhol = (i:1) (t:v) (w:anoint beforehand) (d:<nuh>, smear or rub on, with <khol>, in advance) (s:nilhkhol) (q:draft)
nuhsak = (i:1) (t:v) (w:apply/smear on/put on) (d:put mud, ointment or oil on someone; <nuh> smear with <sak>, for another) (s:nilhsak) (b:nuh) (q:draft)
nuih = (i:1) (t:v) (w:laugh) (d:form of <nui> used before another word such as <hun>, time) (a:kah) (b:nui) (q:draft)
nuihna = (i:1) (t:n) (w:laughter/laughing) (d:<nuih>, laugh, with the noun suffix <na>: laughing, laughter) (a:kahna/dahna) (b:nuih) (r:21.7.3) (q:draft)
nuihnate = (i:1) (t:n) (w:laughter) (d:<nuihna>, laughter, with plural <te>) (b:nuihna) (q:draft)
nuihpih = (i:1) (t:v) (w:laugh with) (d:<nuih>, laugh, with <pih>, together with someone) (b:nuih) (q:draft)
nuihsan = (i:1) (t:v) (w:laugh at/mock/ridicule/deride) (d:<nuih>, laugh, with {-san}, at or toward someone) (s:zahko/zahpih) (b:nuih) (r:19.37.13) (q:draft)
nuihsanin = (i:1) (t:v) (w:laugh at/mock/scorn) (d:<nuihsan> with the linking ending <in>) (b:nuihsan) (q:draft)
nuihsat = (i:1) (t:n) (w:laughingstock/derision/scorn) (d:someone who is laughed at by others) (s:ciamnuihna) (q:draft)
nuihsat = (i:2) (t:v) (w:smile at/laugh at) (d:smile or laugh toward someone; in this verse a kindly smile, not mockery) (q:draft, low confidence)
nuihsatin = (i:1) (t:n) (w:object of scorn/laughingstock) (d:<nuihsat>, being laughed at, with <in>; used with <om> or <bawl>: be or make a laughingstock) (b:nuihsat) (q:draft)
nuihsatna = (i:1) (t:n) (w:mockery/scorn/ridicule) (d:<nuihsat>, laugh at, with the noun suffix <na>) (s:zahpihna/zahkona/simmawhna) (b:nuihsat) (q:draft)
nuihzak = (i:1) (t:v) (w:laugh) (d:{nuihzak nading} is something to laugh for, a cause of laughter) (q:draft, low confidence)
nuinui = (i:1) (t:v) (w:laugh on/keep laughing/rejoice) (d:<nui>, laugh, said twice for an action that goes on) (q:draft, low confidence)
nukik = (i:1) (t:n) (w:stepmother) (d:<nu>, mother, with <kik>, again: the wife a father took later) (b:nu) (q:draft)
nul = (i:1) (t:v) (w:wipe/wipe dry) (d:wipe something dry or clean, such as feet, tears or a dish) (r:43.13.5) (q:draft)
nulepa = (i:1) (t:n) (w:couple) (d:a husband and wife together; in the verses {nulepa mawhna} and {nulepa khialhna} mean adultery or sexual sin) (s:nupa)
nulin = (i:1) (t:v) (w:wiping) (d:<nul>, wipe, with <in> linking it to the next verb) (b:nul) (q:draft)
nulkeusak = (i:1) (t:v) (w:wipe dry) (d:<nul>, wipe, with <keu>, dry, and <sak>, cause or do for someone) (q:draft)
nulkhia = (i:1) (t:v) (w:wipe off/wipe away) (d:<nul>, wipe, with <khia>, out or off) (b:nul) (q:draft)
nulsak = (i:1) (t:v) (w:wipe/wipe away/wipe dry) (d:<nul>, wipe, with <sak>, do it for another) (b:nul) (q:draft)
nulsaknu = (i:1) (t:n) (w:woman who wiped) (d:<nulsak>, wipe for another, with <nu> marking a woman: the woman who wiped) (b:nulsak) (q:draft)
numei = (i:2) (t:n) (w:female) (a:pasal)
Numei = (i:1) (t:n) (w:woman) (d:<numei> written with a capital at the start of a sentence or where the word is given as a name) (b:numei) (r:66.17.5) (q:draft)
numei-nasemnangma = (t:todo) (q:draft, {numei-nasem} female servant run together with <nangma> yourself, probably a missing space in the text of Genesis 16:6)
numeinu = (i:1) (t:n) (w:woman) (d:<numei>, woman, with <nu> marking a female person: the woman, one particular woman) (b:numei) (q:draft)
numeipihte = (i:1) (t:n) (w:fellow women) (d:<numei>, woman, with <pih>, fellow, and plural <te>: other women like themselves) (q:draft)
numeite = (i:1) (t:n) (w:women) (d:<numei>, woman, with the plural <te>) (s:nupite) (a:pasalte) (b:numei) (r:54.5.3) (q:draft)
nun = (i:1) (t:n) (w:bud/knob) (d:in the verses a bud-shaped ornament of the lampstand, named together with <pak> flower) (q:draft)
nun = (i:2) (t:v) (w:blow) (d:of wind or storm: blow; written {nun’} before words such as <ciangin>, {lai takin} and <ni>) (r:18.37.17) (q:draft)
Nun = (i:1) (t:name) (c:male) (w:Nun) (d:father of Joshua, of the tribe of Ephraim) (r:4.13.8) (q:draft)
nung = (i:1) (t:n) (w:back/rear) (d:the back or the place behind; {a nung zui} means follow behind him) (s:nunglam) (a:mai) (r:42.5.28) (q:draft)
nung = (i:2) (t:prep) (w:after) (d:after in time, in {tua nung ciangin} after that and {a nung ciangin} afterward) (a:ma) (r:42.20.32) (q:draft)
nunga = (i:1) (t:prep) (w:behind/after) (d:at the back of or following after, <nung> with the place ending <a>; follows a possessive) (a:maiah) (b:nung) (q:draft)
nunga = (i:2) (t:v) (w:blow) (d:of wind, the verb <nung> blow followed by the linking <a>) (q:draft, low confidence)
nungah = (i:1) (t:prep) (w:behind/after) (d:placed after the noun, of place or of time) (a:maiah) (b:nung) (q:draft)
Nungak = (i:1) (t:n) (w:young woman/maiden) (d:<nungak>, young woman, with a capital at the start of a sentence and in the speaker headings of the Song of Songs, {Nungak} the woman, {Nungak dangte} the other young women) (b:nungak) (r:22.5.8) (q:draft)
nungakin = (i:1) (t:adv) (w:as a young woman/as a maiden) (d:<nungak> young unmarried woman with the ending <in>, telling the state someone is in; {nungakin a om}, while still an unmarried girl) (b:nungak) (q:draft)
nungakna = (i:1) (t:n) (w:virginity) (d:<nungak> with {-na}, the state of being a virgin; {nungakna lim} is the sign or proof of it) (b:nungak) (r:26.23.8) (q:draft)
nungakno = (i:1) (t:n) (w:young woman/young girl/young virgin) (d:<nungak>, young unmarried woman, with <no>, young; {nungakno hun} is the time of a woman’s youth) (b:nungak) (q:draft)
nungaknote = (i:1) (t:n) (w:young women/girls/maidens) (d:<nungakno>, young unmarried woman, with the plural <te>) (s:nungakte) (b:nungakno) (q:draft)
nungaknu = (i:1) (t:n) (w:young woman/girl) (d:<nungak>, young woman, with <nu> marking a female person: the young woman, one particular girl) (b:nungak) (q:draft)
nungakte = (i:1) (t:n) (w:virgins/young women/maidens/girls) (d:<nungak>, young unmarried woman, with the plural <te>; {Jerusalem nungakte} is the daughters of Jerusalem) (s:nungaknote) (a:tangvalte) (b:nungak) (q:draft)
nungcianga = (i:1) (t:adv) (w:afterwards/later/in the future) (d:<nung>, after, with <ciang>, time, and <a>; {a nungcianga piang ding} is what will happen afterwards) (s:nungciangin) (q:draft)
nungdalin = (i:1) (t:n) (w:as rear guard) (d:{nungdal}, what shields the rear, with <in>, as: marching last to guard those in front) (q:draft, low confidence)
nungdalte = (i:1) (t:n) (w:rear guard/rear troops) (d:the men who come behind or are posted at the back of an army; plural with <te>) (a:madawkte) (q:draft)
nungdelh = (i:1) (t:v) (w:pursue/chase after/run after) (d:<nung>, behind, with <delh>, chase) (s:delh/nawhdelh) (r:25.3.43) (q:draft)
nungdelhin = (i:1) (t:v) (w:running after/pursuing) (d:<nungdelh>, run after, with <in> linking it to the next verb) (b:nungdelh) (q:draft)
nungdelhsak = (i:1) (t:v) (w:make pursue/send in pursuit) (d:<nungdelh> pursue, with <sak>, cause to: {namsau ka nungdelhsak ding} is I will make the sword pursue them) (b:nungdelh) (q:draft)
nunggen = (i:1) (t:v) (w:speak later/speak afterwards) (d:<nung>, after, with <gen>, speak) (q:draft)
nungguh = (i:1) (t:n) (w:backbone/spine) (d:<nung>, back, with <guh>, bone) (q:draft)
nunghei = (i:1) (t:v) (w:look back/turn around) (d:turn the head or the body to look behind)
nungin = (i:1) (t:v) (w:blowing/blow) (d:of the wind; <nung> blow with {-in}, linking it to the next verb) (q:draft)
nungkiat = (i:1) (t:v) (w:fall backward/tumble backward) (d:<nung>, back, with <kiat>, fall) (q:draft)
nungkik = (i:1) (t:v) (w:retreat/withdraw/turn back/draw back) (d:go back from where one has advanced, as an army retreats or a river turns back) (s:nungkin) (a:mainawt) (b:nung) (q:draft)
nungkikin = (i:1) (t:v) (w:turn back/go back/shrink back) (d:form of <nungkik> with {-in}, linking to what follows) (b:nungkik) (q:draft)
nungkikna = (i:1) (t:n) (w:turning back/retreat) (d:<nungkik>, turn back, with the noun suffix <na>) (b:nungkik) (q:draft)
nungkiksak = (i:1) (t:v) (w:turn back/drive back/make retreat) (d:<nungkik> go back with <sak>, cause) (b:nungkik) (q:draft)
nungkin = (i:1) (t:v) (w:go backward/shrink back/turn back) (d:draw back instead of going forward, set against <mainawt>, go forward) (s:nungkik) (a:mainawt) (q:draft)
nungkinin = (i:1) (t:v) (w:drawing back/shrinking back) (d:<nungkin>, go backward, with <in> linking it to the next verb) (b:nungkin) (q:draft)
nunglam = (i:1) (t:n) (w:back/rear/behind) (d:<nung> back with <lam> side, direction: the back side, the direction behind; of a ship the stern; {nunglam en} is look back) (s:nung) (a:mailam) (q:draft)
nunglamah = (i:1) (t:adv) (w:backward/to the rear) (d:<nunglam>, the back side, with <ah>, to) (b:nunglam) (q:draft)
nungngat = (i:1) (t:v) (w:turn away from/turn the back on/reject) (d:turn the back toward someone, from <nung> back and <ngat> face toward) (a:maingat) (q:draft)
nungngatin = (i:1) (t:v) (w:turn one's back on/face away from) (d:<nungngat> with the linking ending <in>: with the back turned to someone, the opposite of <maingat>, to face; also said of God turning away from his people) (b:nungngat) (q:draft)
nungnung = (i:1) (t:v) (w:keep blowing/blow on and on) (d:<nung>, blow, of the wind, said twice for an action that goes on) (q:draft)
nungpai = (i:1) (t:v) (w:go afterward/come later/follow later) (d:<nung>, behind or after, with <pai>, go: go or come after others have gone) (a:mapai) (q:draft)
nungpen = (i:1) (t:adj) (w:remotest/farthest/hindmost) (d:<nung>, back, with <pen>, most: farthest in) (b:nung) (q:draft)
nungphawk = (i:1) (t:v) (w:realize afterwards/remember later) (d:<nung>, after, with <phawk>, remember or realize) (q:draft)
nungphiat = (i:1) (t:v) (w:set aside/annul/cancel afterwards) (d:<nung>, after, with <phiat>, erase: undo an agreement once it has been made) (q:draft)
nungsak = (i:1) (t:v) (w:make blow/cause to blow/stir up/send) (d:of wind: make it blow; <nung>, blow, with the causative {-sak}) (r:24.51.1) (q:draft)
nungsakin = (i:1) (t:v) (w:make blow/cause to blow/send a wind) (d:<nung> blow, said of wind, with causative <sak> and the linking ending <in>) (b:nungsak) (q:draft)
nungsang = (i:1) (t:conj) (w:now that/since/after) (d:placed at the end of a clause, after <ahih> or <khit>) (q:draft)
nungsuk = (i:1) (t:v) (w:blow down/sweep down) (d:of wind: <nung> blow, with <suk> downward; paired with <nungto>, blow upward) (a:nungto) (q:draft)
nungta = (i:1) (t:adj) (w:alive) (s:hing) (a:sisa)
nungta = (i:2) (t:adj) (w:living) (s:ahing) (a:sisa) (r:1.1.20)
nungtakik = (i:1) (t:v) (w:live again/come back to life/revive) (d:<nungta>, live, with <kik>, again; with <sak>, raise to life again) (s:hingkik/nuntakkik/hinkik) (b:nungta) (q:draft)
nungtalai = (i:1) (t:v) (w:be still alive/survive/remain alive) (d:<nungta> live with <lai> still; {a nungtalai} is one who is still alive, a survivor) (s:hinlai) (q:draft)
nungtasak = (i:1) (t:v) (w:let live/keep alive/revive) (d:cause to live, spare the life of, give life again) (s:nuntaksak) (a:sisak/that) (b:nungta) (r:19.85.6) (q:draft)
nungtasakkik = (i:1) (t:v) (w:revive/bring back to life/make live again) (d:<nungtasak> make live, with <kik> again) (s:hingkiksak/thokiksak) (b:nungtasak) (q:draft)
nungtasuak = (i:1) (t:v) (w:survive/go on living/stay alive) (d:<nungta>, alive, with <suak>, come out as) (q:draft)
nungtate = (i:1) (t:n) (w:living/the living) (d:those who are alive, living people or creatures) (a:misite) (b:nungta) plural form of <nungta>
nungtazaw = (i:1) (t:v) (w:outlive/live longer) (d:<nungta>, alive, with <zaw>, more; with <sangin>, than) (b:nungta) (q:draft)
nungtazo = (i:1) (t:v) (w:be able to live/survive) (d:<nungta> live, with <zo>, be able, manage to) (b:nungta) (q:draft)
nungto = (i:1) (t:v) (w:blow up/blow upward) (d:of wind: <nung>, blow, with <to>, upward; paired with <nungsuk>, blow down, and said to the south wind in the verse) (a:nungsuk) (q:draft)
nungzang = (i:1) (t:n) (w:back) (d:the back of the body) (s:nung) (q:draft)
nungzangah = (i:1) (t:adv) (w:on the back) (d:<nungzang>, the back of a person or animal, with the place marker <ah>) (b:nungzang) (q:draft)
nungzui = (i:1) (t:n) (w:disciple/follower/attendant) (d:one who follows behind; {nungzui honpi} is a retinue or caravan) (s:thuzui) (q:draft)
nungzuih = (i:1) (t:v) (w:follow/follow after) (d:<nung>, behind, with <zuih>, a form of <zui>, follow: go after someone, follow behind) (s:zuih/sulzuih) (b:nungzui) (q:draft)
nungzuihin = (i:1) (t:v) (w:following/following after) (d:<nungzuih>, follow, with <in> linking it to the next verb) (b:nungzuih) (q:draft)
nungzuihpihte = (i:1) (t:n) (w:fellow disciples/fellow followers) (d:<nungzuih>, follow, with <pih>, together with, and plural <te>: those who follow along with one) (q:draft)
nungzuipa = (i:1) (t:n) (w:disciple/follower) (d:<nungzui>, disciple, with <pa> marking a man: one particular disciple, as in {a it nungzuipa}, the disciple he loved) (s:nungzui/thuzui) (b:nungzui) (r:43.19.27) (q:draft)
nungzuite = (i:1) (t:n) (w:disciples/followers) (d:<nungzui>, disciple, with plural <te>: the disciples of Jesus, or the followers of any leader) (b:nungzui) (q:draft)
nunna = (i:1) (t:n) (w:blowing) (d:<nun>, blow, of wind, with the noun suffix <na>; {huih nunna lam} is where the wind blows, {huihpi nunna gam} a land swept by storms) (b:nun) (q:draft)
nuntak = (i:1) (t:v) (w:live) (d:form of <nungta>, live, used before words such as <khit>, <sung>, <lai>, <ding> and <theih>; {a nuntak sung tawntung} is all the days of his life) (s:hin) (a:sih/si) (b:nungta)
nuntakdan = (i:1) (t:n) (w:way of life/conduct/manner of living) (d:<nuntak>, live, with <dan>, manner: the way a person lives and behaves) (s:nuntakzia/omdan/gamtatzia) (q:draft)
nuntakdante = (i:1) (t:n) (w:ways of life/ways) (d:<nuntakdan>, way of life, with plural <te>) (s:nuntakziate) (b:nuntakdan) (q:draft)
nuntakkik = (i:1) (t:v) (w:live again/come back to life) (d:<nuntak>, live, with <kik>, again; {nuntakkik sak} is raise to life again) (s:hingkik/hinkik/nungtakik/thokik) (b:nuntak) (q:draft)
nuntaklawh = (i:1) (t:v) (w:live as a result/be kept alive) (d:<nuntak>, live, with <lawh>, get as gain: come to live because of what was done) (q:draft, low confidence)
nuntakna = (i:1) (t:n) (w:living) (d:the state of being alive; {nuntakna a nei} is living, having life) (s:hinna)
nuntakna = (i:2) (t:n) (w:life) (s:hinna/hin) (a:sihna)
nuntakna = (i:3) (t:n) (w:livelihood) (d:what a person lives on, the means of making a living)
nuntakna = (i:4) (t:n) (w:way of life) (d:the way a person lives, conduct) (s:nuntakzia/nuntakdan/omzia)
Nuntakna = (i:1) (t:n) (w:life) (d:<nuntakna> written with a capital, at the start of a sentence or as a title for the life that is in Jesus; {Nuntakna laibu} is the book of life) (b:nuntakna) (q:draft)
nuntaknate = (i:1) (t:n) (w:lives/days of life) (d:<nuntakna>, life, with plural <te>) (b:nuntakna) (q:draft)
nuntaksa = (i:1) (t:v) (w:already living/have lived) (d:<nuntak>, live, with <sa>, already done) (b:nuntak) (q:draft)
nuntaksak = (i:1) (t:v) (w:keep alive/give life/preserve/spare) (d:<nuntak>, live, with the causative <sak>: give life to someone or keep someone alive) (s:hingsak/nungtasak) (a:that) (b:nuntak) (q:draft)
nuntaksaknop = (i:1) (t:v) (w:want to spare/want to keep alive) (d:<nuntak>, live, with <sak>, cause, and <nop>, want) (a:thahnop) (q:draft)
nuntaksung = (i:1) (t:n) (w:lifetime) (d:<nuntak>, live, with <sung>, during; {a nuntaksung tawntung} is as long as he lived) (s:khansung/hunsung) (q:draft)
nuntakzia = (i:1) (t:n) (w:way of life/ways/conduct) (d:<nuntak>, live, with <zia>, manner: the way a person or a people live, often paired with <gamtatna>, deeds) (s:nuntakdan/omdan/gamtatzia) (r:24.7.5) (q:draft)
nuntakziate = (i:1) (t:n) (w:ways of life/conduct) (d:<nuntakzia>, way of life, with plural <te>) (s:nuntakdante) (b:nuntakzia) (q:draft)
nunte = (i:1) (t:n) (w:buds/knobs) (d:bud-shaped ornaments on the lampstand, plural of <nun>) (b:nun) (q:draft)
nunung = (i:1) (t:adj) (w:last/latter/final) (d:{a nunung penin} and {a nunung belin} are last of all, finally) (s:tawp) (a:masa) (q:draft)
nununga = (i:1) (t:adj) (w:latter/later/last) (d:<nunung>, last, with <a>, describing the noun that follows; opposite of {a masa}, the first) (a:masa) (b:nunung) (q:draft)
nunungin = (i:1) (t:adv) (w:last/behind/afterwards) (d:<nunung>, last, with <in>; opposite of {a masa-in}, in front) (a:amasa) (b:nunung) (q:draft)
nunungna = (i:1) (t:n) (w:the last/latter one) (d:<nunung>, last, with the noun suffix <na>, after a verb: the later time of doing; {khem nunungna} is the last deception) (a:masakna) (b:nunung) (q:draft)
nunungpen = (i:1) (t:adj) (w:last/very last/lowest) (d:<nunung>, last, with <pen>, most; in Luke 22.26 of the follower of lowest rank, the one who serves) (a:masapen) (b:nunung) (q:draft)
nunungte = (i:1) (t:n) (w:the last/last ones) (d:those who come last; also after a noun, as in {kam nunungte}, last words) (a:masate) (b:nunung) (q:draft)
nupa = (i:1) (t:n) (w:couple/pair) (d:husband and wife; of animals a male and female pair, as in {nupa kop}) (s:nulepa/zilepasal)
nupate = (i:1) (t:n) (w:married couple/husband and wife) (d:<nupa>, couple, with plural <te>: a husband and wife; {tua nupate} is that couple, the two of them) (s:zilepasal) (b:nupa) (q:draft)
nupi = (i:1) (t:n) (w:woman/married woman) (d:grown or married woman; {papi, nupi leh naupangte} is men, women and children) (s:numei) (a:papi) (b:nu) (q:draft)
nupite = (i:1) (t:n) (w:women) (d:plural of <nupi>, grown or married women) (s:numeite) (a:papite) (b:nupi) (q:draft)
nusia = (i:1) (t:v) (w:leave/forsake/abandon/leave behind) (d:go away from a person or place, or let something stay behind; of God or his law, forsake) (s:taisan)
nusia = (i:2) (t:v) (w:pass away) (d:leave this world, depart from life, as in {leitung nusia})
nusiacip = (i:1) (t:v) (w:abandon/leave behind/forsake) (d:<nusia>, leave, with <cip>, firmly: leave and not come back for it) (s:taisan) (b:nusia) (q:draft)
nusiakha = (i:1) (t:v) (w:neglect/leave out/leave behind) (d:<nusia>, leave, with <kha>, happen to) (q:draft)
nusiakhawm = (i:1) (t:v) (w:leave together with) (d:<nusia>, leave, with <khawm>, together) (b:nusia) (q:draft)
nusiakik = (i:1) (t:v) (w:desert/turn away from/leave again) (d:<nusia>, leave, with <kik>, back or again) (b:nusia) (q:draft)
nusialai = (i:1) (t:v) (w:leave behind/leave remaining) (d:<nusia>, leave, with <lai>, still) (q:draft)
nusian = (i:1) (t:n) (w:goddess) (d:a female deity; used of Ashtoreth, Asherah and Artemis) (s:pasiannu) (q:draft)
nusiapa = (i:1) (t:n) (w:deserter/one who abandons) (d:<nusia>, leave, with <pa> marking a man: the man who leaves) (b:nusia) (q:draft)
nusiat = (i:1) (t:v) (w:leave/forsake/abandon) (d:form of <nusia> used before a following word such as <hangin>, or to describe a noun) (s:nutsiat/taisan) (b:nusia) (q:draft)
nusiate = (i:1) (t:n) (w:those who forsake/those who leave) (d:people who have left or abandoned someone or something) (b:nusia) (q:draft)
nusiatin = (i:1) (t:v) (w:left lying/abandoned) (d:<nusiat>, leave, with <in>: in the manner of a thing left lying; {ek nusiatin} is like dung left on the ground) (b:nusiat) (q:draft, low confidence)
nusiatkhak = (i:1) (t:v) (w:come to abandon/happen to forsake) (d:<nusiat>, leave, with <khak>, form of <kha>, happen to) (q:draft)
nusiatlai = (i:1) (t:adj) (w:left behind/remaining/spared) (d:<nusiat>, leave, with <lai>, still: describes people or things that someone has left where they were) (s:omlaisun) (q:draft)
nusiatlam = (i:1) (t:n) (w:having left behind) (d:<nusiat>, leave, with <lam>, the fact that: that they had left someone behind) (q:draft)
nusiatna = (i:1) (t:n) (w:forsaking/abandonment/desertion) (d:<nusiat>, forsake, with the noun suffix <na>; {kei hong nusiatna uh} is their forsaking me) (s:taisatna) (b:nusiat) (q:draft)
nusiatte = (i:1) (t:n) (w:what is left/things left behind/those left behind) (d:<nusiat>, leave, with plural <te>: the people or things someone has left behind; {van nusiatte} is goods left behind, plunder) (s:kinusiate) (b:nusiat) (q:draft)
nusiazo = (i:1) (t:v) (w:have forsaken/have abandoned/have left) (d:<nusia>, leave or forsake, with <zo> showing that the act has been carried through) (s:taisanzo) (b:nusia) (q:draft)
nuta = (i:1) (t:n) (w:mother and young/mother and child) (d:<nu>, mother, with <ta>, child; a mother together with her young, as in {la nuta}, a donkey and her colt) (b:nu) (q:draft)
nutate = (i:1) (t:n) (w:mother and daughter/mother and child) (d:<nuta>, mother and child, with the plural ending <te>; in the verse a woman and her mother who are married to one man) (b:nuta) (q:draft)
nute = (i:1) (t:n) (w:mothers) (d:<nu> with plural <te>; {na nute na pate}, your parents) (a:pate) (b:nu) (q:draft)
nutsiat = (i:1) (t:v) (w:leave/leave behind/abandon) (d:spelling of <nusiat>, the form of <nusia>, leave, used before <ding> and <khit> and to describe a noun) (s:nusiat) (q:draft)
Nymfas = (i:1) (t:name) (c:female) (w:Nympha) (d:Christian at Laodicea in whose house a church met) (r:51.4.15)
O = (i:1) (t:intj) (w:O/oh) (d:exclamation placed before a name in address or lament, as English O) (s:Aw) (r:10.7.20) (q:draft)
Obadiah = (i:1) (t:name) (c:male) (w:Obadiah) (d:name of several men, among them the prophet whose book bears his name and the palace administrator of Ahab) (r:13.12.9/16.10.5)
Obal = (i:1) (t:name) (c:male) (w:Obal) (d:son of Joktan, a descendant of Shem) (r:1.10.28)
Obed = (i:1) (t:name) (c:male) (w:Obed) (d:son of Boaz and Ruth, father of Jesse and grandfather of David; also the name of several other men) (r:8.4.17/13.2.12)
Obededom = (i:1) (t:name) (c:male) (w:Obed-Edom) (d:the Gittite in whose house the ark of the covenant stayed for three months; also a Levite gatekeeper) (r:13.26.15/13.26.4)
Obil = (i:1) (t:name) (c:male) (w:Obil) (d:the Ishmaelite in charge of the camels of King David) (r:13.27.30)
Oboth = (i:1) (t:name) (c:place) (w:Oboth) (d:camping place of Israel in the wilderness, between Punon and Iye Abarim) (r:4.21.10/4.33.43) (q:draft)
Oded = (i:1) (t:name) (c:male) (w:Oded) (d:father of the prophet Azariah in the time of King Asa; also a prophet in Samaria in the time of King Ahaz) (r:14.15.1/14.15.8)
odia = (t:see) <eu-odia>
Ofel = (i:1) (t:name) (c:place) (w:Ophel) (d:the hill of Ophel in Jerusalem, near the temple, where the temple servants lived; {Ofel mualbo} is the hill of Ophel) (q:draft)
Ofir = (i:1) (t:name) (c:male/land) (w:Ophir) (d:son of Joktan; also a land famous for its fine gold, as in {Ofir kham}, gold of Ophir) (r:1.10.29)
Ofni = (i:1) (t:name) (c:city) (w:Ophni) (d:town in the territory of Benjamin) (r:6.18.24)
Ofrah = (i:1) (t:name) (c:city) (w:Ophrah) (d:town in the territory of Benjamin; also the town of the Abiezrites, the home of Gideon) (r:6.18.23/7.8.32)
Ofraih = (i:1) (t:name) (c:male) (w:Ophrah) (d:son of Meonothai in the tribe of Judah) (r:13.4.14)
Og = (i:1) (t:name) (c:male) (w:Og) (d:king of Bashan, defeated by Israel under Moses) (r:16.9.22) (q:draft)
oh = (i:1) (t:intj) (w:oh) (d:exclamation that opens a plea, written {Oh} at the start of speech) (q:draft)
Ohad = (i:1) (t:name) (c:male) (w:Ohad) (d:third son of Simeon) (r:1.46.10/2.6.15)
Ohah = (i:1) (t:name) (c:male) (w:Ohad) (d:a son of Simeon; the text spells the name {Ohah}) (r:1.46.10) (q:draft)
Ohel = (i:1) (t:name) (c:male) (w:Ohel) (d:descendant of David, listed among the children of Zerubbabel) (r:13.3.20)
Ohilibamath = (i:1) (t:name) (c:male) (w:Oholibamah) (d:spelling of <Oholibamah> in this verse, a chief of Edom) (r:13.1.52)
Oholah = (i:1) (t:name) (c:female) (w:Oholah) (d:symbolic name of Samaria, the elder of the two sisters in the parable of Ezekiel) (r:26.23.5/26.23.44)
Oholiab = (i:1) (t:name) (c:male) (w:Oholiab) (d:son of Ahisamak of the tribe of Dan, the craftsman who helped Bezalel make the tabernacle) (r:2.35.34)
Oholibah = (i:1) (t:name) (c:female) (w:Oholibah) (d:symbolic name of Jerusalem, the younger sister of Oholah in the parable of Ezekiel) (r:26.23.11/26.23.36)
Oholibahte = (i:1) (t:name) (c:female) (w:Oholibah) (d:<Oholibah> with <te>, naming Oholah and Oholibah together as a pair) (b:Oholibah) (r:26.23.44)
Oholibamah = (i:1) (t:name) (c:male/female) (w:Oholibamah) (d:wife of Esau, daughter of Anah; also the name of a chief of Edom) (r:1.36.41)
Oholimah = (i:1) (t:name) (c:female) (w:Oholibamah) (d:spelling of <Oholibamah> in this verse, the daughter of Anah) (r:1.36.25)
ok = (i:1) (t:v) (w:wear around the neck/hang around the neck/bind on) (d:put something on the neck as a chain or necklace) (s:awh) (q:draft)
okin = (i:1) (t:v) (w:bind around the neck/wear around the neck) (d:<ok>, wear around the neck, with <in> linking it to the next verb) (b:ok) (q:draft)
Okran = (i:1) (t:name) (c:male) (w:Okran) (d:father of Pagiel, the leader of the tribe of Asher in the wilderness) (r:4.1.13/4.10.26)
oksak = (i:1) (t:v) (w:put around the neck/hang on) (d:<ok>, wear around the neck, with the causative <sak>: put a chain or necklace on someone) (b:ok) (q:draft)
oksakin = (i:1) (t:v) (w:put around the neck/hang on) (d:<oksak>, put around someone's neck, with <in> linking it to the next verb) (b:oksak) (q:draft)
ol = (i:1) (t:adj) (w:easy/at ease/common) (d:easily had or done; {ol tak-a} is easily, {ol sak} is make plentiful) (s:baih) (a:haksa) (r:14.9.27) (q:draft)
ol = (i:2) (t:adj) (w:slow/lingering) (d:slow to come or to act; of speech that does not come readily; {ol lo} is not delayed) (s:hak) (q:draft, low confidence)
Olimpas = (i:1) (t:name) (c:male) (w:Olympas) (d:Christian in Rome greeted by Paul) (r:45.16.15)
oliv = (i:1) (t:n) (c:plant) (w:olive) (d:the olive tree and its fruit; {oliv kung} is an olive tree, {oliv thau} olive oil and {oliv sing} olive wood) (s:olive) (r:66.11.4)
Oliv = (i:1) (t:n) (c:plant) (w:olive) (d:<oliv> written with a capital, mostly in {Oliv Mual}, the Mount of Olives) (b:oliv) (r:42.19.29) (q:draft)
olive = (i:1) (t:n) (c:plant) (w:olive) (d:spelling of <oliv>, the olive tree and its fruit) (s:oliv) (q:draft)
olna = (i:1) (t:n) (w:ease/easiness) (d:<ol>, easy, with the noun suffix <na>; {nuntak olna gam} is a land where living is easy, a good land) (s:baihna) (a:haksatna) (b:ol) (q:draft)
olno = (i:1) (t:adj) (w:easy) (d:<ol>, easy, with <no>; found as {olno takin}, easily, with little effort) (s:baih) (a:haksa) (b:ol) (q:draft)
oloes = (i:1) (t:n) (c:plant) (w:aloes) (d:a fragrant substance used as perfume) (s:aloes/alo) (q:draft)
olsak = (i:1) (t:v) (w:make common/make plentiful) (d:<ol>, easy, with the causative <sak>; make a thing easy to get, as common as stones) (s:tamsak) (b:ol) (r:14.9.27) (q:draft)
oltak = (i:1) (t:adv) (w:easily/at ease) (d:<ol>, easy, with <tak> making an adverb; {oltak a nuntakna} is a life of ease, rest) (s:nuamtak) (b:ol) (q:draft)
oltakin = (i:1) (t:adv) (w:easily/with ease) (d:<oltak>, easily, with the adverb suffix <in>: without effort of one’s own, as when building on work that another has begun) (a:haksapipi-in) (b:oltak) (q:draft)
Olympas = (i:1) (t:name) (c:male) (w:Olympas) (d:Christian in Rome greeted by Paul at the end of his letter to the Romans) (r:45.16.15)
olzaw = (i:1) (t:adj) (w:easier/more bearable) (d:<ol>, easy, with <zaw>, more: easier, or lighter to bear; used after <sangin>, than) (s:baihzaw) (a:haksazaw) (b:ol) (q:draft)
om = (i:1) (t:v) (w:be) (d:exist, be present, be in a place or in a state; {a om} is there is, {om lo} is there is not)
om = (i:2) (t:v) (w:become) (d:come to be, come into existence or come upon someone, often with <hong> or <pah>)
om = (i:3) (t:v) (w:make) (d:in instructions {om ding hi}, there is to be, stands where the English says make)
om = (i:4) (t:v) (w:happen/occur) (d:of an event such as war, famine or mourning: take place, there is)
Om = (i:1) (t:v) (w:be/exist) (d:<om> written with a capital, at the start of a sentence or in the name {Kumpi Gam Om Lo}, No Kingdom There) (b:om) (q:draft)
Omar = (i:1) (t:name) (c:male) (w:Omar) (d:son of Eliphaz and grandson of Esau, a chief of Edom) (r:1.36.11/13.1.36)
omcip = (i:1) (t:v) (w:remain/stay still/keep silent) (d:<om>, be, with <cip>, firmly: stay as one is without moving, answering or changing) (s:ommawk) (b:om) (q:draft)
omcipin = (i:1) (t:v) (w:remaining still/being left speechless) (d:<omcip>, stay still, with the linking suffix <in>: remaining without a move or a word, and) (b:omcip) (q:draft)
omdan = (i:1) (t:n) (w:ways/conduct/way of life) (d:<om>, be, with <dan>, manner: how a person or a people live and behave; also how someone is getting on) (s:omzia/nuntakzia) (q:draft)
omden = (i:1) (t:v) (w:remain/continue/stay on) (d:<om>, be, with <den>, continually: go on being so, stay as it is) (s:omsuak) (q:draft)
Omega = (i:1) (t:name) (w:Omega) (d:last letter of the Greek alphabet, used with Alpha as a title of God and of Christ, the beginning and the end) (r:66.22.13/66.1.8)
omer = (t:see) <Khedorla-omer>
omgawp = (i:1) (t:v) (w:carry on/behave without restraint) (d:<om>, be, with <gawp>, severely or to excess: be present and behave grossly) (b:om) (q:draft, low confidence)
omin = (i:1) (t:v) (w:being/staying/living) (d:<om>, be or stay, with the linking suffix <in>, joining it to the next clause) (b:om) (q:draft)
omkha = (i:1) (t:v) (w:happen to be/be there by chance) (d:<om>, be, with <kha>, by chance: happen to be somewhere; with <ding> or <thei>, there may be) (q:draft)
omkhak = (i:1) (t:v) (w:happen to be/chance to be) (d:form of <omkha> used before <leh>, <loh> and <pen>: be or exist by chance, mostly in if-clauses and warnings) (b:omkha) (q:draft)
omkhawm = (i:1) (t:v) (w:be with/stay together/live together) (d:<om>, be, with <khawm>, together: be, stay or live with someone; <tawh> marks the companion) (s:ompih/ton) (b:om) (q:draft)
omkhawmin = (i:1) (t:v) (w:be with/stay with/live with) (d:<omkhawm> with the linking ending <in>: being together with someone, <tawh> marks the companion) (s:ompihin) (b:omkhawm) (q:draft)
omkhawmna = (i:1) (t:n) (w:being together/standing together) (d:<omkhawm>, be together, with the noun suffix <na>) (b:omkhawm) (q:draft)
omkhawmsak = (i:1) (t:v) (w:cause to be with/put together with) (d:<omkhawm>, be together, with <sak>, cause: make or let someone be in the same place as others) (b:omkhawm) (q:draft)
omkhawmte = (i:1) (t:n) (w:companions/those who are with) (d:<omkhawm>, be together, with plural {-te}: those who are with someone) (s:tonpihte/kikholhpihte) (b:omkhawm) (q:draft)
omkhin = (i:1) (t:v) (w:have already been/already exist) (d:<om>, be, with <khin>, already: have been somewhere or in a state up to now, be there already) (b:om) (q:draft)
omkhit = (i:1) (t:v) (w:have been/have stayed) (d:<om>, be or stay, with <khit>, finished; mostly as {omkhit ciangin}, after being or staying) (s:omzawh) (q:draft)
omkhitna = (i:1) (t:n) (w:having been) (d:<omkhit>, have been, with the noun suffix <na>: the fact of having been something for a time) (b:omkhit) (q:draft)
omkhol = (i:1) (t:v) (w:be ready/be prepared) (d:<om>, be, with <khol>, beforehand: be in readiness for what is to be done) (s:kigingkhol/kiging) (q:draft)
omkhong = (i:1) (t:v) (w:keep still/stay still/be at rest) (d:keep still, be at rest; in the verses always negated with {thei lo}: cannot keep still, restless) (s:ommawk) (q:draft)
omkhop = (i:1) (t:v) (w:be together/stay with/dwell with) (d:form of <omkhawm> used before <loh>, <ding>, <theih> and <nading>) (s:tenkhop) (q:draft)
omkhopna = (i:1) (t:n) (w:being together) (d:<omkhop>, be together, with the noun suffix <na>) (b:omkhop) (q:draft)
omkik = (i:1) (t:v) (w:be again/happen again/exist again) (d:<om> be with <kik>, again or back: return to an earlier state; with <lo>, be no more) (b:om) (q:draft)
omkim = (i:1) (t:v) (w:be all present/be everywhere) (d:<om>, be, with <kim>, complete: all are there, or be present throughout a place) (q:draft)
omlai = (i:1) (t:v) (w:remain/be left) (d:<om>, be, with <lai>, still: still be there, be left; {a omlai} is the rest, what remains) (s:kinusialai/vallai) (r:26.9.8) (q:draft)
omlaipi = (i:1) (t:v) (w:still be there/still remain) (d:<omlai>, remain, with <pi>; {omlaipi mahin} is even while it was still there) (b:omlai) (q:draft, low confidence)
omlaisun = (i:1) (t:adj) (w:remaining/left over) (d:<omlai>, remain, with <sun>: still left; {a omlaisun teng} or {a omlaisun khempeuh} is all who are still left, the remnant) (s:laisun/nusiatlai) (q:draft)
omlaite = (i:1) (t:n) (w:the rest/remnant/those remaining) (d:<omlai>, remain, with plural <te>: the people or things that are left; in Kings, the remaining acts of a reign) (s:laisunte/sunte/suaktate) (b:omlai) (r:12.16.19) (q:draft)
omlaiteng = (i:1) (t:n) (w:the rest/remainder/all that remain) (d:<omlai>, remain, with <teng>, all: everyone or everything that is still left) (s:valteng/omlaite/laiteng) (b:omlai) (q:draft)
omlaiteng = (i:2) (t:conj) (w:as long as) (d:after a noun and <a>, for as long as that thing still exists) (s:laiteng) (b:omlai) (q:draft)
omlam = (i:1) (t:det) (w:that) (d:<om>, be, with <lam>: the fact that someone or something is there; follows a clause and stands before a verb of knowing, seeing or hearing) (r:43.9.32)
omlo = (i:1) (t:adj) (w:without/lacking) (d:<om>, be, with <lo>, not: where something is not present, as {mi omlo}, without people, and {silngo-omlo}, without yeast, unleavened) (b:om) (q:draft)
omlohna = (i:1) (t:n) (w:absence/lack/not being) (d:<om>, be, with <loh>, not, and the noun suffix <na>: the fact that there is none) (q:draft)
omlopi = (t:see) <omlopi-a>
omlopi-a = (i:1) (t:adv) (w:without cause/without reason) (d:<om>, be, with <lo>, not; {thu omlopi-a} is when there is no matter, for no reason) (s:mawkin) (q:draft)
ommah = (i:1) (t:v) (w:indeed be/be just so) (d:<om>, be, with <mah> for emphasis: {a ommah ding} is there must indeed be, {a ommah bangin} is just as one was) (b:om) (q:draft, low confidence)
ommawk = (i:1) (t:v) (w:be idle/do nothing/stay still/delay) (d:remain without acting or speaking; {ommawk kei in} warns not to neglect or put off a duty) (s:omcip) (q:draft)
ommawkna = (i:1) (t:n) (w:idleness/sitting idle/inaction) (d:<ommawk>, be idle, with the noun suffix <na>; {khutzepin ommawkna} is sitting idle with folded hands) (s:tutmawkna/thadahna) (a:thanuamna) (b:ommawk) (q:draft)
ommuang = (i:1) (t:adj) (w:harmless/unsuspecting) (d:of a person or animal that is quietly minding its own business and expects no harm) (q:draft, low confidence)
ommun = (i:1) (t:v) (w:be frequent/be often) (d:<om>, be, with <mun>, often; {ommun lo} is be rare) (q:draft, low confidence)
omna = (i:1) (t:v) (w:locate/find) (d:<om>, be, with the noun suffix <na>: the place where someone or something is; {omna peuhah} is wherever there is, and {omna panin} is from the presence of) (b:om) where there is
Omna = (i:1) (t:n) (w:dwelling place/place where one is) (d:<omna> written with a capital: the place where someone is or sits; {note’ omna peuhah} is wherever you are) (b:omna) (q:draft, low confidence)
omnai = (i:1) (t:v) (w:be yet/exist so far) (d:<om>, be, with <nai>, yet; in a question: is there any so far) (q:draft, low confidence)
omnasa = (i:1) (t:n) (w:former place/former site) (d:<om>, be, with <na> and <sa>, already: the place where someone or something was before; often followed by <mun>, place) (b:om) (q:draft)
omnate = (i:1) (t:n) (w:standing firm/endurance) (d:<om>, be or remain, with the noun suffix <na> and plural <te>; {kiptakin omnate} is remaining steadfast) (b:om) (q:draft, low confidence)
omnawn = (i:1) (t:v) (w:be any more/still be) (d:<om>, be, with <nawn>, any more or further) (b:om) (q:draft)
omngei = (i:1) (t:v) (w:have been/once was/used to be) (d:<om>, be, with <ngei>, ever or once: have existed or been present at an earlier time; {a omngei bangin} is as it was before, {omngei nai lo} is has never been) (q:draft)
omnop = (i:1) (t:v) (w:want to be/wish to live) (d:<om>, be, with <nop>, form of <nuam>, want) (q:draft)
omnopna = (i:1) (t:n) (w:longing to be/desire to be) (d:<omnop>, want to be, with the noun suffix <na>) (b:omnop) (q:draft)
omnuam = (i:1) (t:v) (w:want to be/want to stay) (d:<om>, be, with <nuam>, want) (q:draft)
omnuam = (i:2) (t:adj) (w:pleasant/agreeable) (d:<om>, be, with <nuam>, pleasant: of a person who is pleasant to be with; the English has fine-looking) (q:draft, low confidence)
omom = (i:1) (t:v) (w:keep on being/still remain/go on) (d:doubled form of <om>, be, for a state that continues, often followed by <lai>, still) (q:draft)
omomin = (i:1) (t:v) (w:as still being/being there still) (d:<omom>, go on being, with <in>; {a omomin ngaihsun} is think that he is still there) (b:omom) (q:draft)
ompa = (i:1) (t:n) (w:he who is/the one who is) (d:<om> be, with <pa> marking a man: the one who is in a place or with someone) (b:om) (q:draft)
ompah = (i:1) (t:v) (w:be at once/stay right away) (d:<om>, be, with <pah>, at once; {pau loin ompah} is fall silent at once) (q:draft)
ompak = (i:1) (t:v) (w:stay for a while/lodge/sojourn) (d:<om>, be, with <pak>, for a short while) (s:taam/peem) (q:draft)
ompakna = (i:1) (t:n) (w:sojourn/temporary stay) (d:<ompak>, stay for a while, with the noun suffix <na>; {ompakna gam} is the land where one is living for a time) (s:tenpakna) (b:ompak) (q:draft)
ompi = (i:1) (t:v) (w:be there/be present) (d:<om>, be, with <pi>; in {a ompi mahin}, even though they were there; what <pi> adds is not clear) (b:om) (q:draft, low confidence)
ompih = (i:1) (t:v) (w:be with/stay with/accompany) (d:<om>, be, with <pih>, together with: be with someone and stand by him, said above all of God; the person is the object) (s:omkhawm/ton) (b:om) (r:9.18.14/42.9.41) (q:draft)
ompihin = (i:1) (t:v) (w:be with/stand by/accompany) (d:<ompih> with the linking ending <in>: being with someone to help and support) (s:omkhawmin) (b:ompih) (q:draft)
ompihlai = (i:1) (t:v) (w:still be with/remain with) (d:<ompih>, be with, with <lai>, still) (q:draft)
ompihna = (i:1) (t:n) (w:presence/being with) (d:<ompih>, be with, with the noun suffix <na>: someone’s being with a person, especially the presence of God) (b:ompih) (q:draft)
Ompihna = (i:1) (t:n) (w:presence) (d:<ompihna> written with a capital in {Ompihna Anlum}, the bread of the Presence that is set before God) (q:draft)
Omri = (i:1) (t:name) (c:male) (w:Omri) (d:king of Israel who built Samaria, father of Ahab; also the name of three other men) (r:11.16.30/11.16.25)
omsa = (i:1) (t:adj) (w:existing/already there/established) (d:<om>, be, with <sa>, already: that which already is or was there before; {thu omsa bangin} is according to the word already given, {ngeina kip omsa} is the established rule) (a:thak) (b:om) (q:draft, low confidence)
omsak = (i:1) (t:v) (w:put) (d:<om>, be, with <sak>, cause: cause to be somewhere, put) (s:koih) (b:om)
omsak = (i:2) (t:v) (w:place) (d:set or keep someone or something in a place, let remain there) (s:koih) (b:om)
omsakin = (i:1) (t:v) (w:putting/placing/causing to be) (d:<omsak>, cause to be, with the linking suffix <in>) (b:omsak) (q:draft)
omsakkik = (i:1) (t:v) (w:restore/reestablish/bring back) (d:<omsak> with <kik>, again: cause to be as before, put back in its place; {ki-omsakkik} is the passive) (s:koihkik) (b:omsak) (q:draft)
omsaklai = (i:1) (t:v) (w:let remain/leave alone still) (d:<omsak>, let be, with <lai>, still: leave a thing as it is for a while longer) (q:draft)
omsakzo = (i:1) (t:v) (w:be able to keep/establish) (d:<omsak>, make be, with <zo>, be able; {nuamtakin omsakzo} is keep in peace) (b:omsak) (q:draft, low confidence)
omsate = (i:1) (t:n) (w:existing ones/earlier ones/those already there) (d:<omsa> already existing, with the plural <te>; after a noun it describes it, as {pawlpi omsate}, the churches already there) (b:omsa) (q:draft)
omsawm = (i:1) (t:v) (w:intend to stay/plan to be) (d:<om>, be or stay, with <sawm>, intend) (q:draft)
omsuak = (i:1) (t:v) (w:remain/continue/stay on) (d:<om>, be, with <suak>, onward: go on being in the same place or state, stay on) (s:omden) (q:draft)
omsuakin = (i:1) (t:v) (w:remaining/staying on) (d:<omsuak>, remain, with <in> linking it to what follows) (b:omsuak) (q:draft)
omsuakna = (i:1) (t:n) (w:staying on/remaining) (d:<omsuak>, stay on, with the noun suffix <na>) (b:omsuak) (q:draft)
omsuakte = (i:1) (t:n) (w:those who remain/survivors) (d:<omsuak>, stay on, with plural <te>) (s:omlaite/sunte) (b:omsuak) (q:draft)
omsung = (i:1) (t:n) (w:stay/time of staying) (d:<om>, be, with <sung>, within or during: the time while someone is in a place; {ka omsung khempeuh} is all the time I was there) (q:draft)
omta = (i:1) (t:v) (w:be/exist/have come) (d:<om> be with <ta>, which marks a state that now holds: now is, has come to be; {koi-ah omta ahi hiam} asks where something is now) (b:om) (q:draft)
omte = (i:1) (t:v) (w:be) (d:<om>, be, with plural <te>: those who are in a place or state; {a omte} is the ones who are) (b:om)
omte = (i:2) (t:v) (w:have) (b:om)
omte = (i:3) (t:part) (d:particle used in making a comparison)
omteng = (i:1) (t:n) (w:all that is/everything in/all who are) (d:<om>, be, with <teng>, all: all that there is in a place, all who are there) (b:om) (q:draft)
omthei = (i:1) (t:v) (w:can be/be able to remain) (d:<om>, be, with <thei>, can: can be, be able to stay as it is) (b:om) (q:draft)
omtheih = (i:1) (t:v) (w:be able to be/may be) (d:form of <omthei>, can be, used before <nading>; {a omtheih nadingin} is so that it may be) (b:om) (q:draft)
omto = (i:1) (t:v) (w:be up above/rise above/stay on) (d:<om>, be, with <to>, up or onward; be high above a thing, and of time, go on being in a place) (b:om) (q:draft, low confidence)
omtoh = (i:1) (t:v) (w:come up onto/be up on) (d:form of <omto>, be up on, used before <ciangin>, when) (b:omto) (q:draft, low confidence)
omtual = (i:1) (t:v) (w:stay/dwell/keep to) (d:<om>, be, with <tual>; in the verse the wise keep among mourning and fools among pleasure) (q:draft, low confidence)
omtuam = (i:1) (t:v) (w:be separate/be set apart) (d:<om>, be, with <tuam>, separate; {hun omtuam lo} is there is no separate time) (q:draft, low confidence)
omvat = (i:1) (t:v) (w:appear suddenly/be there all at once) (d:<om>, be, with <vat>, suddenly) (s:dingvat) (q:draft)
omzah = (i:1) (t:n) (w:number/amount/quantity) (d:<om>, be, with <zah>, amount: how many or how much there is of something) (s:malzah/phazah) (q:draft)
omzaw = (i:1) (t:v) (w:be rather/be instead) (d:<om>, be or live, with <zaw>, rather: be or live in one way instead of another) (s:hizaw) (b:om) (q:draft)
omzaw = (i:2) (t:v) (w:be more) (d:there is more of something, used with <sangin> than) (b:om) (q:draft)
omzawh = (i:1) (t:v) (w:have been/have stayed) (d:<om>, be or stay, with <zawh>, completed: the time that one has spent in a state, followed by a count of days or years) (s:omkhit) (q:draft)
omzia = (i:1) (t:n) (w:condition/state/ways/way of life/welfare) (d:how a person is or lives, both his circumstances and his conduct; {omzia dong}, ask how someone is, means greet) (s:nuntakzia/omdan) (q:draft)
omziate = (i:1) (t:n) (w:ways/conditions/features) (d:<omzia>, how a person or thing is, with the plural <te>; of a person, his ways, and of a land, what it is like) (b:omzia) (q:draft)
omzo = (i:1) (t:v) (w:be able to stand/be able to be/be able to remain) (d:<om>, be or stay, with <zo>, be able: be able to be, remain or stand in a certain state or place) (s:omtheih) (b:om) (q:draft)
omzote = (i:1) (t:n) (w:those who are able to live so) (d:<omzo>, be able to be or remain, with plural <te>: those who can live in that way) (b:omzo) (q:draft)
On = (i:1) (t:name) (c:city) (w:On) (d:city in Egypt, also called Heliopolis, whose priest Potiphera was the father-in-law of Joseph) (r:26.30.17) (q:draft)
On = (i:2) (t:name) (c:male) (w:On) (d:son of Peleth of the tribe of Reuben, who joined the revolt of Korah) (r:4.16.1) (q:draft)
Onam = (i:1) (t:name) (c:male) (w:Onam) (d:name of two men: a son of Shobal the Horite, and a son of Jerahmeel of the tribe of Judah) (r:1.36.23/13.2.26)
Onan = (i:1) (t:name) (c:male) (w:Onan) (d:second son of Judah, who died in Canaan) (r:1.38.4/4.26.19)
Onesiforas = (i:1) (t:name) (c:male) (w:Onesiphorus) (d:Christian whose household Paul greets, who often refreshed Paul and was not ashamed of his chains) (r:55.1.16/55.4.19)
Onesimas = (i:1) (t:name) (c:male) (w:Onesimus) (d:slave of Philemon who became a believer through Paul and was sent back to his master) (r:57.1.10)
onik = (i:1) (t:n) (c:stone) (w:onyx) (d:a precious stone, usually in the phrase {onik suang}, onyx stone, set on the ephod and breastpiece of the priest) (r:2.25.7)
Onik = (i:1) (t:n) (c:stone) (w:onyx) (d:<onik>, onyx, written with a capital in a list of precious stones) (b:onik) (q:draft)
onikh = (i:1) (t:n) (w:onycha) (d:a fragrant substance, one of the ingredients of the holy incense) (s:onikha) (q:draft)
onikha = (i:1) (t:n) (w:onycha) (d:a fragrant substance, one of the ingredients of the holy incense; spelling of <onikh> in the older text) (s:onikh) (q:draft)
Ono = (i:1) (t:name) (c:city) (w:Ono) (d:town in the territory of Benjamin near Lod, with a plain named after it) (r:16.11.35) (q:draft)
op = (i:1) (t:v) (w:brood/sit on eggs/hatch) (d:of a bird: sit on eggs or cover the young to keep them warm) (s:keuh) (q:draft)
op = (i:2) (t:n) (w:deposit/scum/rust) (d:only in {kang-op}, the burnt crust stuck inside a cooking pot) (q:draft, low confidence)
opa = (t:todo) (q:draft, not a word of its own, the rest of <Topa> where the 1932 text prints {T opa} with a space)
OPA = (i:1) (t:n) (w:Lord) (d:part of {TOPA}, the Lord, printed in the text as {T OPA} with a space) (q:draft, low confidence)
opsim = (i:1) (t:v) (w:brood/sit on eggs) (d:said of a bird that sits on eggs to hatch them; in the verse, eggs that are not its own) (s:op) (q:draft, low confidence)
Oreb = (i:1) (t:name) (c:male) (w:Oreb) (d:a Midianite leader killed in the time of Gideon) (r:7.7.25) (q:draft)
Oreb = (i:2) (t:name) (c:place) (w:Oreb) (d:the rock of Oreb, {Oreb suangpi}, where the Midianite leader Oreb was killed) (r:7.7.25) (q:draft)
Oren = (i:1) (t:name) (c:male) (w:Oren) (d:son of Jerahmeel of the tribe of Judah) (r:13.2.25)
Ornan = (i:1) (t:name) (c:male) (w:Araunah) (d:the Jebusite whose threshing floor David bought as the site for the altar, called Araunah in the NIV) (r:13.21.25/13.21.15)
Orpah = (i:1) (t:name) (c:female) (w:Orpah) (d:Moabite woman, daughter-in-law of Naomi, who went back to her own people) (r:8.1.4/8.1.14)
ot = (i:1) (t:v) (w:shout/cry out/call aloud) (d:shout or call out loudly, in battle, in joy or in prayer) (s:awng/kiko) (a:daih) (q:draft)
Othiel = (i:1) (t:name) (c:male) (w:Othniel) (d:spelling of <Othniel> in 1 Chronicles 4.13: son of Kenaz) (r:13.4.13)
Othni = (i:1) (t:name) (c:male) (w:Othni) (d:son of Shemaiah, a Levite gatekeeper of the family of Obed-Edom) (r:13.26.7) (q:draft)
Othniel = (i:1) (t:name) (c:male) (w:Othniel) (d:son of Kenaz and kinsman of Caleb, who took Kiriath Sepher and became the first judge of Israel) (r:6.15.17/7.1.13)
otkhai = (t:see) <otkhai-in>
otkhai-in = (i:1) (t:v) (w:shouting after/shouting at) (d:<ot>, shout, with <khai> and the linking <in>; of people who shout as they chase a thief away; what <khai> adds is not clear) (q:draft, low confidence)
otna = (i:1) (t:n) (w:shout/shouting/roar) (d:noun from <ot> shout; a loud cry of many people, in joy or in uproar) (s:kikona/awtna) (b:ot) (q:draft)
otsan = (i:1) (t:v) (w:shout to/call out to/shout after) (d:<ot>, shout, with <san>, toward: shout to or after a person) (b:ot) (q:draft)
otsanin = (i:1) (t:v) (w:shouting to/calling out to) (d:<otsan>, shout to, with <in> linking it to the words that are shouted) (b:otsan) (q:draft)
Ozem = (i:1) (t:name) (c:male) (w:Ozem) (d:name of two men: the sixth son of Jesse, and a son of Jerahmeel) (r:13.2.15/13.2.25)
Ozni = (i:1) (t:name) (c:male) (w:Ozni) (d:son of Gad, ancestor of the Oznite clan) (r:4.26.16)
pa = (i:2) (t:n) (w:man) (d:a man or male person, mostly after <tua> or <hih>: {tua pa}, that man, {hih pa}, this man) (s:mipa/pasal) (a:nu)
pa = (i:3) (t:n) (w:male) (d:male, said mostly of animals for sacrifice; {a pa khat} is one male) (a:nu/pi) (r:1.7.3)
pa = (i:4) (t:n) (w:masculine) (d:marks the masculine gender, in contrast to <nu>, feminine) (a:nu)
Pa = (i:1) (t:n) (w:Father) (d:God the Father, written with a capital) (b:pa) (q:draft)
Pa = (i:2) (t:n) (w:One) (d:the male one, in titles of God such as {Siangtho Pa} the Holy One) (b:pa) (q:draft, low confidence)
PA = (i:1) (t:n) (w:man) (d:<pa>, man or male person, written in capitals in the inscription on the cross; {hih pa} is this man) (q:draft)
Pa-arai = (i:1) (t:name) (c:male) (w:Paarai) (d:Paarai the Arbite, one of the mighty warriors of David) (r:10.23.35) (q:draft)
paai = (i:2) (t:n) (w:sheath/scabbard) (d:the case that holds the blade of a sword) (q:draft)
paai = (i:3) (t:v) (w:be pregnant/carry) (d:carry a child in the womb, in the phrase {nau paai}) (s:naupaai/paii) (q:draft)
paaikhia = (i:1) (t:v) (w:throw away/cast out/reject/remove) (d:<paai>, throw, with <khia>, out: throw out or away, and so reject people or remove what is not wanted) (s:paihkhiat/lawnkhia) (b:paai) (r:44.27.19) (q:draft)
paaikhiasak = (i:1) (t:v) (w:take out for/remove for) (d:<paaikhia>, throw out or remove, with <sak>, do it for another; {hong paaikhiasak in} is let me take it out for you) (b:paaikhia) (r:42.6.42) (q:draft)
paaimang = (i:1) (t:v) (w:throw away/cast off/abandon) (d:<paai>, throw, with <mang>, away or lost: throw away for good, abandon or do away with) (s:paaikhia/paihkhiat) (q:draft)
paaipaai = (i:1) (t:v) (w:keep throwing/throw again and again) (d:<paai>, throw, doubled for repeated action) (q:draft)
paaite = (i:1) (t:n) (w:riches/possessions/goods) (d:with <sum>, money, the two together mean wealth) (q:draft, low confidence)
paak = (i:1) (t:n) (w:flower/blossom) (d:the flower of a plant, often as a picture of what soon fades) (s:pak/pakpalh) (q:draft)
paak = (i:2) (t:adj) (w:white/bright) (d:shining white, as snow or bright clothing) (s:kang/kaang/ngo) (a:vom) (q:draft)
Paak = (i:1) (t:n) (w:flower/blossom) (d:{Unok Paak} is the lily flower) (b:paak) (q:draft)
paakin = (i:1) (t:v) (w:blossoming/blooming) (d:<paak>, flower, used as a verb, with <in> linking it to the next verb) (s:palhin) (b:paak) (q:draft)
paaknamtui = (i:1) (t:n) (c:plant) (w:spice/fragrant flower) (d:<paak>, flower, with <namtui>, sweet-smelling) (q:draft)
paaksak = (i:1) (t:v) (w:make white/whiten/bleach) (d:<paak>, be white, with the causative <sak>: make white, as in washing or bleaching clothes) (a:vomsak) (b:paak) (q:draft)
paakte = (i:1) (t:n) (w:flowers/blossoms) (d:plural of <paak>, flower; also of flower shapes made in gold) (s:pakte) (r:2.25.34) (q:draft)
paam = (i:1) (t:n) (w:surroundings/neighbourhood/area around) (d:found in the pair <kiim> and {paam}, each with its own pronoun: {i kiim i paam} and {ka kiim ka paam}, all around us) (s:kim) (q:draft)
paampaih = (i:1) (t:adj) (w:outcast/cast aside/rejected) (d:{paampaih mi} is an outcast) (q:draft)
paang = (i:1) (t:n) (w:cheek/jaw/temple of the head) (d:the side of the face or head: the cheek that is slapped, the jaw, and the temple; in Leviticus 13.41 used of the front part of the head from which hair is lost) (s:biang) (r:7.4.21) (q:draft)
paangah = (i:1) (t:n) (w:into the temple of the head/in the temple of the head) (d:<paang>, the temple of the head, with <ah>, at or into) (b:paang) (q:draft)
Paarai = (i:1) (t:name) (c:male) (w:Paarai) (d:Paarai the Arbite, one of the mighty warriors of David) (r:10.23.35)
paat = (i:1) (t:v) (w:be worn out/wear thin/be thin) (d:become thin through wear, said of clothes and sandals, of eyes worn by weeping, and of a wall that narrows) (q:draft, low confidence)
paatgawp = (i:1) (t:v) (w:be badly worn out/fail) (d:<paat>, be worn out, with <gawp>, badly or thoroughly; said of eyes worn by weeping) (b:paat) (q:draft)
paatgawpta = (i:1) (t:v) (w:be badly worn out) (d:<paatgawp> with <ta>, marking that the state has now been reached; said of clothes and sandals) (b:paatgawp) (q:draft)
paatkhia = (i:1) (t:v) (w:wear out/become worn out) (d:<paat>, be worn thin, with <khia>, out: wear out, said of cloth that grows old and thin) (q:draft)
paatsa = (i:1) (t:adj) (w:worn-out/old/tattered) (d:<paat>, be worn out, with <sa>, already: of sacks, wineskins, sandals and clothes that are old and falling apart) (s:luisa) (a:thak) (b:paat) (q:draft)
paatsak = (i:1) (t:v) (w:wear out/wear down/exhaust) (d:<paat>, be worn out, with <sak>, cause) (b:paat) (q:draft)
Padaiah = (i:1) (t:name) (c:male) (w:Pedaiah) (d:man of Rumah, father of Zebidah the mother of King Jehoiakim) (r:12.23.36)
Paddan = (i:1) (t:name) (c:land) (w:Paddan) (d:first part of <Paddan-aram>, Paddan Aram, the region where Laban lived) (r:1.28.2/1.35.26) (q:draft)
Paddan-aram = (i:1) (t:name) (c:land) (w:Paddan Aram) (d:region in northern Mesopotamia where Laban lived and where Jacob found his wives) (r:1.28.2/1.35.26) (q:draft)
Paddanaram = (i:1) (t:name) (c:male) (w:Paddan-aram/Paddan Aram) (d:region in northern Mesopotamia where Laban lived and where Jacob found his wives) (r:1.25.20/1.31.18)
Padon = (i:1) (t:name) (c:male) (w:Padon) (d:ancestor of a family of temple servants who returned from the exile) (r:15.2.44/16.7.47)
Pafos = (i:1) (t:name) (c:city) (w:Paphos) (d:city on the west coast of Cyprus where Paul met the sorcerer Bar-Jesus) (r:44.13.6)
Pagiel = (i:1) (t:name) (c:male) (w:Pagiel) (d:son of Okran, leader of the tribe of Asher in the wilderness) (r:4.1.13/4.10.26)
pah = (i:1) (t:adv) (w:immediately/at once/right away/instantly) (d:placed after a verb: the action happens at once, without delay) (s:pahpah/thakhatin/pak)
pah = (i:2) (t:conj) (w:as soon as) (d:after a verb and followed by <leh>: as soon as the action happens) (s:phetin/phetun)
Pahathmoab = (i:1) (t:name) (c:male) (w:Pahath-Moab) (d:ancestor of a large family that returned from the exile; also a leader who sealed the covenant with Nehemiah) (r:15.8.4/16.10.14)
Pahathmoabte = (i:1) (t:name) (c:people) (w:Pahath-Moab) (d:<Pahathmoab> with the plural <te>: the family descended from Pahath-Moab) (b:Pahathmoab) (r:15.2.6/16.7.11)
pahin = (i:1) (t:adv) (w:immediately/at once/straightaway) (d:<pah> with the linking suffix <in>, after a verb: doing it at once, and then) (s:pakin) (b:pah) (q:draft)
pahpah = (i:1) (t:adv) (w:immediately) (d:<pah> doubled: at once, each time or each one without delay) (s:pah/thakhatin)
pahpah = (i:2) (t:adv) (w:straight away/at once/right away/instantly) (d:<pah> doubled: readily, without stopping to think, as in {heh pahpah}, be quick to anger) (s:pah/pakin)
pahpah = (i:3) (t:conj) (w:as soon as)
pahpahin = (i:1) (t:adv) (w:immediately/at once/right away) (d:<pahpah> with the adverbial ending <in>) (b:pahpah) (q:draft)
pahpahpa = (i:1) (t:n) (w:one who acts at once) (d:<pahpah>, immediately, with <pa>, the one who: {hong huh pahpahpa} is the one who helps at once) (b:pahpah) (q:draft)
pahpahte = (i:1) (t:n) (w:those who are quick to) (d:<pahpah> at once, readily, with the plural <te>, making a noun of the verb phrase before it: those who are quick to do something; {a heh pahpahte} is those who are quick to anger) (b:pahpah) (q:draft)
pahtaak = (i:1) (t:n) (w:favour/approval) (d:the good opinion of others; spelling of <pahtak>) (s:pahtak/pahtakna) (q:draft)
pahtak = (i:1) (t:v) (w:favour/be pleased with/delight in/approve of) (d:be pleased with someone and hold him in regard) (q:draft)
pahtak = (i:2) (t:n) (w:favour/approval/honour) (d:the good opinion of others; {pahtak ngah} is to gain honour) (s:pahtakna/pahtaak) (q:draft)
pahtakbawl = (i:1) (t:v) (w:speak well of/praise/treat with favour) (d:<pahtak>, favour or approval, with <bawl>, do or make: show someone approval) (b:pahtak) (q:draft)
pahtakhuai = (i:1) (t:adj) (w:honoured/admirable/worthy of honour) (d:<pahtak>, favour or honour, with <huai>, worthy of: deserving honour or admiration) (s:pahtawihuai/phathuai) (q:draft)
pahtaklam = (i:1) (t:n) (w:favour/the fact of favouring) (d:<pahtak>, favour or be pleased with, with <lam>, the fact or manner of) (q:draft)
pahtakna = (i:1) (t:n) (w:approval/favour/honour/praise) (d:<pahtak>, favour, with the noun suffix <na>: the approval, favour or honour that someone gives; {pahtakna ngah} is win favour) (s:pahtak) (b:pahtak) (q:draft)
pahtawi = (i:1) (t:v) (w:honor/exalt/glorify) (d:show honour to someone or lift him up in rank or praise; of God and his name, exalt and glorify) (s:liansak/minthangsak/zahtak) (a:simmawh/mindaisak/daisak) (q:draft)
pahtawihuai = (i:1) (t:adj) (w:honourable/worthy of honour) (d:deserving honour or respect: <pahtawi>, honour, with <huai>, worthy of) (s:pahtakhuai/zahtakhuai) (a:mindaihuai/zumhuai) (q:draft)
pahtawina = (i:1) (t:n) (w:honor/respect) (d:<pahtawi>, honor, with the noun suffix <na>: the respect or high standing given to a person; {pahtawina ngah} is receive honor) (s:pahtakna/zahtakna) (a:mindaina/simmawhna) (b:pahtawi) (q:draft)
Pahtawina = (t:see) <Pahtawina-a>
Pahtawina-a = (i:1) (t:n) (w:to the honor of/in honor of) (d:<pahtawina> honor with the marker <a>, at or for) (q:draft, low confidence)
pahtawinate = (i:1) (t:n) (w:praises/honors) (d:<pahtawina>, honor or praise, with the plural <te>: the praises given to someone) (s:phatnate) (b:pahtawina) (q:draft)
pahtawipa = (i:1) (t:n) (w:one who honors) (d:<pahtawi>, honor or exalt, with <pa>, the one who) (b:pahtawi) (q:draft)
pahtawite = (i:1) (t:n) (w:those who honor) (d:<pahtawi>, honor, with <te>, those who) (a:simmawhte) (b:pahtawi) (q:draft)
pahtawizawk = (i:1) (t:v) (w:honor more/be honored more) (d:<pahtawi>, honor, with <zawk>, more, the form of <zaw> used before <ding>) (q:draft)
pahte = (i:1) (t:adv) (d:<pah>, at once or readily, after a verb, with <te>, those who: {a zuak pahte}, those who sell readily, {a mang pahte}, those who accept at once) (b:pah) (q:draft)
Pai = (i:1) (t:v) (w:go) (d:<pai>, go, written with a capital at the start of quoted speech) (b:pai) (r:12.2.18) (q:draft)
Pai = (i:2) (t:name) (c:city) (w:Pau/Pai) (d:the city of Hadad king of Edom; Pau in the NIV, Pai in older English Bibles) (q:draft)
paidak = (i:1) (t:v) (w:forsake/abandon/cast off) (d:give up or abandon someone for good; used in parallel with <nusia>, forsake) (s:nusia/taisan) (q:draft)
paih = (i:1) (t:v) (w:throw away/cast/throw off/reject) (d:form of <paai> used before <khit>, <nading> and other endings) (s:lawn) (q:draft)
paihdak = (i:1) (t:v) (w:cast away/throw down) (d:<paih>, throw away, with <dak>; in the verse of God casting his people into deep darkness; what <dak> adds is not clear) (q:draft, low confidence)
paihkhiat = (i:1) (t:v) (w:throw away/cast out/thrust out/forsake) (d:throw away, drive out or give up: the form of the verb used before words such as <bangin>, <dongin>, <hun> and <thu>) (s:hawlkhiat/nusiat) (a:kep) (b:paih) (q:draft)
paihkhiatna = (i:1) (t:n) (w:casting out/rejection/setting aside) (d:<paihkhiat>, throw out, with the noun suffix <na>: being thrown out, rejected or set aside; {paihkhiatna thuak} is be rejected) (s:nialna) (b:paihkhiat) (r:12.24.20) (q:draft)
paihkhiatpih = (i:1) (t:v) (w:bring out/lead out) (d:used in the verse beside <paikhiatpih> with the same meaning; perhaps a misprint of that word) (q:draft, low confidence)
paihkhiatsak = (i:1) (t:v) (w:remove/take away/deprive of) (d:<paihkhiat>, throw out, with the causative <sak>: take something away from someone, remove it for him) (b:paihkhiat) (q:draft)
paihkhiatsakin = (i:1) (t:v) (w:removing/taking away) (d:<paihkhiatsak> remove, take away from someone, with the linking ending <in>) (b:paihkhiatsak) (q:draft)
paihmang = (i:1) (t:v) (w:throw away/cast out/abandon) (d:<paih>, throw, with <mang>, away or lost) (s:paimang) (q:draft)
paihmawk = (i:1) (t:v) (w:throw away/throw out) (d:<paih>, throw, with <mawk>, simply or to no purpose) (q:draft)
paihna = (i:1) (t:n) (w:throwing/casting down) (d:<paih>, a form of <paai>, throw, with the noun suffix <na>; the act of throwing or casting down, and before a noun the place where a thing was thrown) (b:paih) (q:draft)
paihsak = (i:1) (t:v) (w:throw away/cast/hurl) (d:throw away or cast down something that belongs to another; <paih> with <sak>) (b:paih) (q:draft)
paihsakin = (i:1) (t:v) (w:throwing/casting) (d:<paihsak> with the ending <in>, linking it to the following verb: throwing) (b:paihsak) (q:draft)
paihtuam = (i:1) (t:n) (w:partiality/discrimination) (d:setting one person aside from the rest; paired with <guptuam> for favouritism and partiality) (q:draft, low confidence)
paii = (i:1) (t:v) (w:conceive/be pregnant with/carry in the womb) (d:carry a child in the womb, conceive; {nau paii} is be with child) (s:gai) (q:draft)
paii = (i:2) (t:v) (w:throw/cast/throw away) (d:throw something down or away, as a net onto the water; also written <paai>) (s:lawn) (q:draft)
paiite = (i:1) (t:n) (w:goods/valuables/treasures) (d:used together with <sum>, money, as {sum leh paiite} and {na sum na paiite}, money and possessions; compare <sumlepai>) (s:vante/neihsate) (q:draft)
paikawm = (i:1) (t:v) (w:while going/while walking) (d:<pai>, go, with <kawm>, while: as one goes along, at the same time as another action) (q:draft)
paikawmin = (i:1) (t:v) (w:while going/going along) (d:<pai> go with <kawm>, at the same time, and the linking suffix {-in}: doing something else while on the way) (b:paikawm) (r:18.22.14) (q:draft)
paikawmun = (i:1) (t:v) (w:as they go/while going/on the way) (d:<pai> with <kawm>, while, and the plural ending <un>: as they went along, doing something else at the same time) (b:paikawm) (q:draft)
paikha = (i:1) (t:v) (w:happen to go/pass by/go near) (d:<pai> go with <kha>, happen to or come upon) (q:draft)
paikhak = (i:1) (t:v) (w:go near/happen to go/come near) (d:form of <paikha> used before <ciangin>) (b:paikha) (q:draft)
paikhawm = (i:1) (t:adv) (w:together with/go together/accompany) (d:<pai>, go, with <khawm>, together: go or come together with someone) (b:pai)
paikhawmin = (i:1) (t:v) (w:go together/go with) (d:<paikhawm> with the linking ending <in>, going together) (b:paikhawm) (q:draft)
paikhawmpa = (i:1) (t:n) (w:one who goes with) (d:<paikhawm>, go together, with <pa>, the one who) (b:paikhawm) (q:draft)
paikhawmsak = (i:1) (t:v) (w:send together with/let go with) (d:<paikhawm>, go together, with <sak>, make or let) (b:paikhawm) (q:draft)
paikhawmte = (i:1) (t:n) (w:companions/those who go with) (d:<paikhawm>, go together, with plural <te>) (b:paikhawm) (q:draft)
paikhia = (i:1) (t:n) (w:getout/go out/leave/depart) (d:<pai>, go, with <khia>, out: go out of a place or away from someone) see <pai> and <khia>
paikhial = (i:1) (t:v) (w:go astray/turn aside) (d:<pai>, go, with <khial>, wrongly) (q:draft)
paikhiapa = (i:1) (t:n) (w:one who has gone out) (d:<paikhia>, go out, with <pa>, the man who) (b:paikhia) (q:draft)
paikhiapih = (i:1) (t:v) (w:bring out/lead out) (d:<paikhia>, go out, with <pih>, together with: go out taking someone along) (b:paikhia) (q:draft)
paikhiasak = (i:1) (t:v) (w:send away/let go/make go out) (d:<paikhia>, go out, with causative <sak>) (s:ciahsak/paisak) (b:paikhia) (r:42.14.4) (q:draft)
paikhiasakin = (i:1) (t:v) (w:send away/send out) (d:<paikhiasak> with the ending <in>, linking it to the following verb: sending out) (b:paikhiasak) (q:draft)
paikhiasuak = (i:1) (t:v) (w:go out/pass out) (d:<paikhia>, go out, with <suak>, right on through) (q:draft)
paikhiasuk = (i:1) (t:v) (w:go out/go away/leave) (d:<paikhia>, go out, with <suk>, downward) (b:paikhia) (q:draft)
paikhiat = (i:1) (t:v) (w:go out/come out/leave/depart) (d:form of <paikhia> used before <lai>, <ding>, <phetin> and in dependent clauses) (s:kuankhiat/pusuah) (a:lut) (b:paikhia) (r:6.2.7) (q:draft)
paikhiata = (i:1) (t:v) (w:come out/go out) (d:<paikhia>, go out, with <ta>, marking a completed event; {a paikhiata kipan} is since they came out) (b:paikhia) (q:draft)
paikhiate = (i:1) (t:n) (w:things that come out) (d:<paikhia>, come out, with the plural <te>; {a paikhiate}, the things that come out) (s:pusuakte) (b:paikhia) (r:40.15.11) (q:draft)
paikhiatin = (i:1) (t:v) (w:go out/set out/leave) (d:<paikhiat> with the ending <in>: when or as someone set out) (b:paikhiat) (q:draft)
paikhiatkhak = (i:1) (t:v) (w:slip out/get out) (d:<paikhiat>, go out, with <khak>, happen to; with {loh nading}, so that no one gets out) (q:draft)
paikhiatlam = (i:1) (t:n) (w:going out/departure/leaving) (d:<paikhiat> go out, with <lam>, the fact or manner of: that someone has gone out, the leaving of someone) (s:paikhiatna) (q:draft)
paikhiatna = (i:1) (t:n) (w:departure/exodus/going out) (d:<paikhiat>, go out, with the noun suffix <na>: the act of leaving, or before <gam> or <mun> the place someone came out from) (s:kuankhiatna/pusuahna/paikhiatlam) (b:paikhiat) (q:draft)
paikhiatnapa = (i:1) (t:n) (w:man from whom something went out) (d:<paikhiatna>, going out, with <pa> marking a man: in the verses the man out of whom the demons had gone) (b:paikhiatna) (q:draft)
paikhiatnasa = (i:1) (t:adj) (w:left/gone out from) (d:<paikhiat>, go out, with <na>, place, and <sa>, already: that one has gone out from) (b:paikhiat) (q:draft)
paikhiato = (i:1) (t:v) (w:come up out/go up out) (d:<paikhia>, go out, with <to>, upward) (b:paikhia) (q:draft)
paikhiatosak = (i:1) (t:v) (w:send up/make go up out) (d:<paikhiato>, go up out, with causative <sak>) (b:paikhiato) (q:draft)
paikhiatpih = (i:1) (t:v) (w:bring out/lead out/take out) (d:<paikhiat>, go out, with <pih>, together with: go out taking someone or something along, bring or lead out) (a:lutpih/tumpih) (b:paikhiat) (r:2.12.51) (q:draft)
paikhiatpihin = (i:1) (t:v) (w:bringing out/leading out/taking out) (d:<paikhiatpih> with the linking ending <in>, followed by another verb: bringing out, brought out and) (b:paikhiatpih) (r:12.10.26) (q:draft)
paikhiatpihna = (i:1) (t:n) (w:bringing out/leading out) (d:noun from <paikhiatpih>: the act or fact of bringing or leading someone out; also the place or people to which one is led out) (b:paikhiatpih) (q:draft)
paikhiatpihpa = (i:1) (t:n) (w:one who brought out) (d:the one who led or brought someone out; {-pa} marks a man) (b:paikhiatpih) (r:2.16.6) (q:draft)
paikhiatpihsak = (i:1) (t:v) (w:let bring out) (d:<paikhiatpih>, bring out, with <sak>, cause or allow; in the verse a request to be allowed to bring someone out) (b:paikhiatpih) (q:draft)
paikhiatpihte = (i:1) (t:n) (w:those led out/those taken away) (d:<paikhiatpih>, lead out, with plural <te>) (b:paikhiatpih) (q:draft)
paikhiatpihto = (i:1) (t:v) (w:bring up out) (d:<paikhiatpih>, bring out, with <to>, upward) (b:paikhiatpih) (q:draft)
paikhiatsak = (i:1) (t:v) (w:send out/send away/dismiss/let go) (d:<paikhiat>, go out, with the causative <sak>: make or let someone go out, send away or set free) (s:ciahsak/khahkhia) (b:paikhiat) (q:draft)
paikhiazo = (i:1) (t:v) (w:have gone out/have come out/have set out) (d:<paikhia>, go out, with <zo> marking the action as done) (b:paikhia) (q:draft)
paikhin = (i:1) (t:v) (w:have gone/gone already) (d:<pai> go with <khin>, marking the action as already done) (b:pai) (q:draft)
paikhit = (i:1) (t:v) (w:have gone/finish going) (d:<pai> go with <khit>, completed; {a paikhit ciangin} is after he had gone) (q:draft)
paikhop = (i:1) (t:v) (w:go together with/come with/accompany) (d:<pai>, go, with <khop>, together; form of <paikhawm> used before <ciangin> and {lai takin}) (q:draft)
paikhopna = (i:1) (t:n) (w:going together/accompanying) (d:<paikhop>, go together with, with the noun suffix <na>; {nong paikhopna} is your going with us) (b:paikhop) (q:draft)
paikikin = (i:1) (t:v) (w:returning/going back/coming back) (d:<paikik> with the linking ending {-in}, used when another action follows: returned and) (s:ciahkikin) (b:paikik) (r:11.20.5) (q:draft)
paikikna = (i:1) (t:n) (w:return/coming back/coming again) (d:<paikik>, return, with the noun suffix <na>) (s:ciahkikna) (b:paikik) (q:draft)
paikim = (i:1) (t:v) (w:all come/all go) (d:<pai>, go or come, with <kim>, all without exception: come every one of them) (q:draft)
pailai = (i:1) (t:v) (w:go farther/go on/be still to come) (d:<pai> go or come with <lai>, more or still) (q:draft)
pailam = (i:1) (t:n) (w:coming/going) (d:<pai> go, come, with <lam>, the fact of: that someone has come or is coming) (q:draft)
pailet = (i:1) (t:v) (w:pierce through/pass through/penetrate) (d:<pai> go, with <let> through: go right through a body) (s:sunlet) (q:draft)
pailetin = (i:1) (t:v) (w:piercing/passing through) (d:going right through something; <pailet> with the linking suffix {-in}) (b:pailet) (r:18.22.14) (q:draft)
paimang = (i:1) (t:v) (w:throw away/cast away) (d:in the verse, of hair cut off and thrown away) (s:paihmang) (q:draft)
paimangpih = (i:1) (t:v) (w:take away/carry off) (d:<paimang> with <pih>, together with: go away taking something along) (b:paimang) (q:draft)
paimangta = (i:1) (t:v) (w:abandon/forsake/cast off) (d:<paimang> with <ta>, marking that the act is now done) (b:paimang) (q:draft)
paina = (i:1) (t:v) (w:walking/going/where one goes) (d:<pai>, go, with the suffix <na>: the going of someone, a journey, or the place where one goes; {na paina khempeuh ah} is wherever you go) (b:pai)
painasa = (i:1) (t:v) (w:have gone/have passed through) (d:<pai> with <na> and <sa>, already, used before a noun of place: the place where someone has gone; {a painasa-ah} means where it has passed, in its wake) (b:pai) (q:draft)
paingei = (i:1) (t:v) (w:usually go/be used to going) (d:<pai>, go, with <ngei>, be accustomed to; {a paingei bangin} is as was his custom) (q:draft)
painop = (i:1) (t:v) (w:want to go/be willing to go) (d:<pai> go, with <nop>, the form of <nuam> want used in dependent clauses, as before {kei leh} and <ciangin>) (q:draft)
painopna = (i:1) (t:n) (w:wish to go/place one wants to go) (d:<painop>, want to go, with the noun suffix <na>; the wish to go, and the place where one wants to go) (b:painop) (q:draft)
painuam = (i:1) (t:v) (w:want to go/be willing to go/want to come) (d:<pai> go, come, with <nuam> want) (q:draft)
paipa = (i:1) (t:n) (w:one who comes/one who goes) (d:<pai> with {-pa}, the man who goes; {hong paipa} is he who comes) (b:pai) (q:draft)
paipah = (i:1) (t:v) (w:go at once/hurry/go quickly) (d:<pai> go with <pah> at once) (r:42.1.39) (q:draft)
paipahin = (i:1) (t:v) (w:going at once/coming straight up) (d:<paipah>, go at once, with <in> linking it to the next verb) (b:paipah) (q:draft)
paipai = (i:1) (t:v) (w:keep going/go on/go about) (d:<pai> go, said twice to show that the action continues; {kot paipai}, keep going round) (q:draft)
paipaina = (t:see) <paipaina-ah>
paipaina-ah = (i:1) (t:adv) (w:wherever it goes) (d:<pai>, go, doubled, with <na>, place, and <ah>, at or to: to whatever place one goes) (q:draft, low confidence)
paipak = (i:1) (t:v) (w:come soon/come for a while) (d:<pai>, go or come, with <pak>, quickly or for a short while) (q:draft, low confidence)
paipel = (i:1) (t:n) (w:basket) (d:large carrying basket; in the accounts of the feeding of the crowds, the baskets filled with the pieces left over) (s:bawm/seeng) (q:draft)
paiphei = (i:1) (t:v) (w:go across/run along) (d:<pai>, go, with <phei>, crosswise or level; in the verse of a row of rooms running along one level of a building) (q:draft, low confidence)
paipih = (i:1) (t:phrase) (w:go along with) (d:<pai>, go, with <pih>, together with: go along with someone, or make someone go along) (b:pai)
paipihin = (i:1) (t:v) (w:bringing/taking/leading) (d:<paipih>, take along, with the linking ending <in>: bringing or leading someone and then doing the next action) (b:paipih) (r:3.8.6) (q:draft)
paipihkha = (i:1) (t:v) (w:bring along/take along/happen to bring) (d:<paipih>, take along, with <kha>, happen to; {paipihkha loin} means so as not to bring a thing somewhere by mistake) (q:draft)
paipihkik = (i:1) (t:v) (w:bring back/lead back) (d:<paipih>, take along or lead, with <kik>, back: bring or lead someone back) (s:tunpihkik/ciahpihkik) (b:paipih) (q:draft)
paipihmang = (i:1) (t:v) (w:bring along/bring in) (d:<paipih>, take along, with <mang>, wholly; in the verse, bring everyone in) (q:draft, low confidence)
paipihna = (i:1) (t:n) (w:bringing/leading/taking along) (d:<paipih>, take along, with the noun suffix <na>: the act of bringing; before a noun, the place to which one is brought, as in {kong paipihna gam}, the land I am bringing you to) (s:tunpihna) (b:paipih) (q:draft)
paipihpa = (i:1) (t:n) (w:the one who led/he who brought) (d:<paipih>, take along or lead, with <pa>, the male one: he who led, said of God who led his people) (b:paipih) (q:draft)
paipihsak = (i:1) (t:v) (w:have someone bring/let bring/let carry) (d:<paipih>, bring along, with the causative <sak>: make or let someone bring or carry a person or thing) (b:paipih) (q:draft)
paipihsuk = (i:1) (t:v) (w:bring down/take down) (d:<paipih>, take along, with <suk>, downward: take someone down to a place; in Acts, bring a man down before the council) (s:puaksuk/paisukpih) (a:paipihto) (b:paipih) (r:45.10.7) (q:draft)
paipihto = (i:1) (t:v) (w:take up/bring up/lead up) (d:<paipih>, take along, with <to>, upward: take or lead someone up, or bring a thing up to a higher place) (s:puato) (a:paipihsuk) (b:paipih) (r:14.1.4) (q:draft)
paipihtoh = (i:1) (t:v) (w:bring up/take up/lead up) (d:form of <paipihto>, bring up, used before words such as {a kipan} and <theih>) (b:paipihto) (q:draft)
paipite = (t:todo) (q:draft, follows <singhiang>, branch, in a list of leafy boughs; the meaning of <paipi> is not clear from one verse)
paisak = (i:1) (t:v) (w:send/let go/send away) (d:<pai>, go, with the causative <sak>: make someone go, send; or allow someone to go, let go) (s:sawl) (b:pai) (r:2.9.17) (q:draft)
paisakin = (i:1) (t:v) (w:sending/letting go) (d:<paisak>, send or let go, with the linking ending <in>: sending, and then; {hong paisakin} is letting me go) (b:paisak) (q:draft)
paisakkik = (i:1) (t:v) (w:send back/send again/let come again) (d:<paisak>, send or let go, with <kik>, again or back) (b:paisak) (q:draft)
paisakna = (i:1) (t:n) (w:sending/letting go) (d:<paisak>, send or let go, with the noun suffix <na>: the act of sending or of letting go) (b:paisak) (q:draft)
paisan = (i:1) (t:v) (w:depart/go away/leave) (d:<pai>, go, with <san>, away from: go away from a person or place and leave it behind) (s:nusia)
Paisan = (i:1) (t:n) (w:Passover) (d:the yearly feast that recalls how the Lord passed over the houses of Israel in Egypt; often {Paisan pawi}, the Passover feast) (s:Paisan Pawi/Paisanna)
Paisan Pawi = (i:1) (t:n) (w:Passover) (d:<Paisan>, Passover, with <pawi>, feast: the Passover feast, kept on the fourteenth day of the first month) (s:Paisan/Paisanna)
paisanin = (i:1) (t:v) (w:leaving/going away from/going off) (d:<paisan>, go away from, with the linking ending <in>: leaving a person, place or thing and then doing the next action) (s:taisanin) (b:paisan) (q:draft)
paisanna = (i:1) (t:n) (w:departure) (d:<paisan>, go away from or pass by, with the noun suffix <na>) (b:paisan)
Paisanna = (i:1) (t:n) (w:Passover/passing over) (d:<paisan> pass over with the noun suffix <na>; {Topa’ Paisanna} is the Lord's Passover) (s:Paisan/Paisan Pawi) (b:Paisan) (q:draft)
paisawm = (i:1) (t:v) (w:intend to go/plan to go) (d:<pai>, go, with <sawm>, intend) (q:draft)
paisim = (i:1) (t:v) (w:go secretly/go in secret) (d:<pai> go, with <sim>, secretly, without being seen) (s:simpai) (q:draft)
paisuak = (i:1) (t:adj) (w:nonstop) (d:going on without a break; after a verb, keep on doing it without stopping) (s:tawntung)
paisuak = (i:2) (t:adv) (w:forever) (d:after a verb: on and on without end; with <lo>, not forever) (s:ngitnget/tawntunga/atawntungin)
paisuakah = (i:1) (t:adv) (w:all the way along/right around) (d:<paisuak>, going straight on, with <ah>, at; in the verse, along the whole circuit of the city) (b:paisuak) (q:draft, low confidence)
paisuakin = (i:1) (t:adv) (w:forever/for good/continually) (d:<paisuak>, on without end, with the linking ending <in>; after a verb: forever, for good, without turning back) (s:ngitnget/atawntungin) (b:paisuak) (q:draft)
paisuakin = (i:2) (t:v) (w:going on/passing on/continuing on) (d:<paisuak>, go straight on, with the linking ending <in>: going on through or beyond a place and then doing the next action) (b:paisuak) (r:6.18.18) (q:draft)
paisuaknop = (i:1) (t:v) (w:want to go straight on) (d:<paisuak>, go straight on, with <nop>, want, the form of <nuam> used before {uh hangin}) (q:draft)
paisuakpah = (i:1) (t:v) (w:go straight at once/go directly) (d:<pai>, go, with <suak>, right through, and <pah>, at once: go straight there without delay) (q:draft)
paisuaksak = (i:1) (t:v) (w:let through/make pass through/let pass) (d:<paisuak>, go right through, with the causative <sak>: let someone pass through, or make a thing reach from one end to the other) (b:paisuak) (q:draft)
paisuaksak = (i:2) (t:v) (w:make continue/make last) (d:<paisuak>, go on without end, with the causative <sak>: make a state last, keep someone in it for good) (b:paisuak) (q:draft, low confidence)
paisuakzawh = (i:1) (t:v) (w:be able to continue/manage to go on) (d:<paisuak>, right on or continuing, with <zawh>, be able; placed after another verb, as {thuak paisuakzawh}, be able to go on enduring) (q:draft)
paisuakzo = (i:1) (t:v) (w:be able to get through/be able to carry on) (d:<paisuak> go right through, go on without stopping, with <zo>, be able; after another verb, manage to keep on doing it to the end) (b:paisuak) (q:draft)
paisuk = (i:1) (t:v) (w:go down/come down/descend) (d:<pai>, go, with <suk>, downward: go or come down to a lower place) (s:kumsuk/tuaksuk/kuansuk) (a:paito/kahto) (b:pai) (r:1.11.5) (q:draft)
paisukin = (i:1) (t:v) (w:going down/go down) (d:<paisuk>, go down, with the linking ending <in>, used when another verb follows: going down and then) (b:paisuk) (q:draft)
paisukna = (i:1) (t:n) (w:way down/descent/slope) (d:<paisuk>, go down, with the noun suffix <na>: the place where a road goes down, a descent) (a:paitohna) (b:paisuk) (q:draft)
paisukpa = (i:1) (t:n) (w:one who goes down) (d:<paisuk>, go down, with <pa>, the one who) (b:paisuk) (q:draft)
paisukpih = (i:1) (t:v) (w:bring down/take down) (d:<paisuk>, go down, with <pih>, together with) (s:paipihsuk) (b:paisuk) (q:draft)
paisuksak = (i:1) (t:v) (w:let go down/make go down/bring down) (d:<paisuk>, go down, with the causative <sak>: make or let someone go or come down) (a:paitosak) (b:paisuk) (q:draft)
paisukte = (i:1) (t:n) (w:those who go down) (d:<paisuk>, go down, with the plural <te>: those who go down, often of the dead who go down to the pit) (b:paisuk) (r:23.14.19) (q:draft)
paita = (i:1) (t:v) (w:come now/be coming/have come) (d:<pai>, come, with <ta>, marking that the coming has now begun or happened; {hong paita in} is an urgent request to come) (b:pai) (q:draft)
paitawm = (i:1) (t:v) (w:come on one's own/come of one's own accord) (d:<pai>, go or come, with <tawm>, by oneself; come without being sent by another) (q:draft)
paite = (i:1) (t:n) (w:those who come/those who go) (d:<pai> with the plural ending {-te}, the people who come or go; with <hong> before it, those coming this way) (b:pai) (q:draft)
paithei = (i:1) (t:v) (w:can go/can come/be able to walk) (d:<pai>, go, with <thei>, can or may: be able or allowed to go or come; {lam paithei} is be able to walk) (b:pai) (r:40.11.5) (q:draft)
paitheih = (i:1) (t:v) (w:be able to come/be able to go) (d:<pai> go or come with <theih> can; mostly in {paitheih nading}, so that one may come) (s:paizo) (b:pai) (q:draft)
paitheihna = (i:1) (t:n) (w:ability to walk/being able to go) (d:<paitheih>, be able to go, with the noun suffix <na>; {lam a paitheihna ding a hilh} is teach to walk) (b:paitheih) (q:draft)
paito = (i:1) (t:v) (w:go up/ascend) (d:<pai>, go, with <to>, upward: go up to a higher place; of God or Christ, ascend) (s:kahto/kuanto) (a:paisuk/kumsuk) (b:pai) (q:draft)
paitoh = (i:1) (t:v) (w:go up/come up/ascend) (d:form of <paito> used before words such as <ciangin> and <leh>) (s:kahtoh) (b:paito) (q:draft)
paitohna = (i:1) (t:n) (w:ascent/way up/going up) (d:<paitoh>, go up, with the noun suffix <na>: the act of going up or the place where a road goes up, as in {Bethhoron paitohna lampi}, the road going up to Beth Horon) (s:kahtohna) (a:paisukna) (b:paitoh) (r:19.122.3) (q:draft)
paitosak = (i:1) (t:v) (w:bring up/let go up/make go up) (d:<paito> go up, with <sak>, cause or allow) (a:paisuksak) (b:paito) (q:draft)
paizaw = (i:1) (t:v) (w:go rather/go instead) (d:<pai>, go, with <zaw>, rather) (b:pai) (q:draft)
paizia = (i:1) (t:n) (w:way/course) (d:<pai>, go, with <zia>, manner: the way someone goes or acts; {thu paizia} is the course of a matter and {biakna paizia} the way of religion) (s:zia) (q:draft)
paiziate = (i:1) (t:n) (w:ways/courses) (d:<paizia>, way, with the plural ending <te>; {Pasian thu paiziate} is the ways of God) (s:ziate) (b:paizia) (r:23.55.9) (q:draft)
paizo = (i:1) (t:v) (w:be able to come/get in) (d:<pai>, come or go, with <zo>, be able) (s:paitheih) (b:pai) (q:draft)
paizo = (i:2) (t:v) (w:have come) (d:<pai>, come, with <zo> marking the action as done) (b:pai) (q:draft, low confidence)
pak = (i:1) (t:n) (w:flower/blossom) (d:the flower of a plant; {lopa pak} is the flower of the grass) (s:paak/pakpalh) (q:draft)
pak = (i:2) (t:adv) (w:quickly/at once/soon) (d:placed after a verb, the action is done quickly, at once or for a short while) (s:pah/mengmeng) (a:damdamin) (q:draft)
pak = (i:3) (t:v) (w:bloom/blossom/bud) (d:of a plant or tree: come into flower) (s:palh) (a:vul) (q:draft)
pakan = (i:1) (t:n) (w:dish/plate) (d:small dish or bowl; in Numbers a gold dish holding incense) (r:4.7.20/4.7.26) (q:draft)
pakante = (i:1) (t:n) (w:dishes/plates) (d:small dishes or ladles among the temple vessels, in these verses for incense) (b:pakan) (r:2.37.16) (q:draft)
pakin = (i:1) (t:adv) (w:quickly/suddenly/at once) (d:<pak> with the ending <in>, after a verb: happening fast or all at once) (s:thakhatin/pah/mengmeng) (a:damdamin) (b:pak) (q:draft)
pakkhia = (i:1) (t:v) (w:blossom/bloom/come into flower) (d:<pak>, bloom, with <khia>, out) (s:palhkhia) (b:pak) (q:draft)
pakkual = (i:1) (t:n) (w:wreath/garland) (d:<pak>, flower, with <kual>, ring; a ring of flowers, in the verses a carved or cast ornament) (q:draft)
pakkualte = (i:1) (t:n) (w:wreaths/garlands) (d:<pakkual>, wreath, with the plural ending <te>) (b:pakkual) (q:draft)
pakna = (i:1) (t:n) (d:<pak>, quickly or for a short while, with the noun suffix <na>; after a verb it names the doing of it quickly or briefly, as in {hauh pakna}, getting rich quickly, and {ten’ pakna}, staying for a while) (b:pak) (q:draft)
paknamtui = (i:1) (t:n) (w:incense/perfume/spice) (d:<pak>, flower, with <namtui>, fragrant: a sweet-smelling substance, burned as incense or used as perfume) (r:4.7.44) (q:draft)
paknamtuite = (i:1) (t:n) (w:spices/perfumes/incense) (d:<paknamtui>, incense or perfume, with the plural ending <te>: spices, perfumes, kinds of incense) (b:paknamtui) (q:draft)
pakpak = (i:1) (t:adv) (w:quickly/easily/readily) (d:<pak>, quickly, doubled; placed after a verb, be quick to do it, as in {heh pakpak}, be easily angered) (s:pahpah) (q:draft)
pakpalh = (i:1) (t:n) (w:open flower/blossom/flower in bloom) (d:<pak>, flower, with <palh>, open out) (s:pak/paak) (q:draft)
pakpalhte = (i:1) (t:n) (w:flowers/blossoms/open flowers) (d:<pakpalh>, open flower, with the plural ending <te>) (s:paakte/pakte) (b:pakpalh) (q:draft)
pakta = (i:1) (t:v) (w:praise/commend/admire/approve of) (d:think well of someone or of what he does and say so) (s:phat/pahtak) (a:simmawh/gensia/mitdong) (q:draft)
paktat = (i:1) (t:adj) (w:promiscuous/loose/immoral) (d:sexually immoral, placed after the noun; {numei paktat} is a prostitute or harlot, and {pasal paktat} a male prostitute) (q:draft)
paktat = (i:2) (t:v) (w:prostitute oneself/commit prostitution) (d:act as a prostitute or be sexually immoral; also said of Israel being unfaithful to God) (s:thangtat) (q:draft)
paktatin = (i:1) (t:v) (w:committing prostitution/acting immorally) (d:<paktat>, prostitute oneself, with <in> linking it to the next verb; {paktatin gamta} is behave as a prostitute) (b:paktat) (q:draft)
paktatna = (i:1) (t:n) (w:prostitution/promiscuity/sexual immorality) (d:<paktat>, be promiscuous, with the noun suffix <na>: prostitution or sexual immorality; also used of unfaithfulness to God through idol worship) (s:hukna) (b:paktat) (q:draft)
paktatnate = (i:1) (t:n) (w:prostitutions/immoral acts) (d:<paktatna>, prostitution, with the plural ending <te>; in the verse of Jezebel, where the English has idolatry) (b:paktatna) (q:draft)
paktatnu = (i:1) (t:n) (w:female prostitute/harlot) (d:<paktat>, promiscuous, with <nu>, marking a woman) (b:paktat) (q:draft)
paktatpa = (i:1) (t:n) (w:male prostitute) (d:<paktat>, promiscuous, with <pa>, marking a man) (b:paktat) (q:draft)
paktatsak = (i:1) (t:v) (w:lead into prostitution/make unfaithful) (d:<paktat>, prostitute oneself, with causative <sak>) (b:paktat) (q:draft)
paktatte = (i:1) (t:n) (w:prostitutes/promiscuous women) (d:<paktat> with the plural ending {-te}, usually as {numei paktatte}) (b:paktat) (r:20.23.27) (q:draft)
pakte = (i:1) (t:n) (w:flowers/blossoms) (d:<pak>, flower, with the plural ending <te>; also the flower ornaments of the lampstand) (s:paakte/pakpalhte) (b:pak) (q:draft)
pakzaw = (i:1) (t:adv) (w:all the sooner/rather quickly) (d:<pak>, quickly, with <zaw>, more or rather; follows a verb, in the verse <si>, die) (b:pak) (q:draft, low confidence)
palai = (i:1) (t:n) (w:envoy/mediator/go-between/ambassador) (d:one who goes between two sides to speak for them or make peace; {palai sem} is to act as an envoy or mediator) (s:kamtai/tangmi) (q:draft)
palai = (i:2) (t:v) (w:intervene/mediate) (d:step in between two sides to settle a matter or make peace) (q:draft)
Palal = (i:1) (t:name) (c:male) (w:Palal) (d:son of Uzai, who helped repair the wall of Jerusalem in the time of Nehemiah) (r:16.3.25)
palepa = (i:1) (t:phrase) (w:man with man) (d:{pa le pa}, man and man; {palepa mawhna} is the sin of a man with a man, homosexual practice) (q:draft)
palh = (i:1) (t:v) (w:bloom/blossom/flourish) (d:of flowers, open; of people, thrive like a plant in flower) (s:pak) (a:vul) (q:draft)
palhin = (i:1) (t:v) (w:blooming/blossoming) (d:<palh>, open out in bloom, with the linking ending <in>) (b:palh) (q:draft)
palhkhia = (i:1) (t:v) (w:blossom/bloom/burst into bloom) (d:<palh>, open out in bloom, with <khia>, out) (s:pakkhia) (b:palh) (q:draft)
palhngulh = (i:1) (t:v) (w:be unfaithful to/commit adultery against) (d:break faith with a husband or wife by going with another) (q:draft)
palhngulhna = (i:1) (t:n) (w:unfaithfulness/adultery) (d:<palhngulh>, be unfaithful to, with the noun suffix <na>; in the verse of a people unfaithful to God) (s:angkawmna) (b:palhngulh) (q:draft)
palhte = (i:1) (t:n) (w:blooms/open flowers) (d:<palh>, bloom, with the plural ending <te>; {pak palhte} is flowers in bloom) (s:pakpalhte) (b:palh) (q:draft)
palik = (i:1) (t:n) (w:officer/guard/police) (d:loanword from English police: an officer who keeps order or guards; {palik bu} and {palik mang} are officers of the guard) (q:draft)
palikbute = (i:1) (t:n) (w:officers/police officers) (d:<palik> police, a loanword from English, with <bu> and the plural <te>; in Acts 16 the officers sent by the Roman magistrates) (r:44.16.38) (q:draft)
palikmangte = (i:1) (t:n) (w:officers/guard officers) (d:<palik>, police or guard, with <mang>, chief or officer, and the plural ending <te>; {biakinncing palikmangte} is the officers of the temple guard) (q:draft)
palikte = (i:1) (t:n) (w:guards/officers/police) (d:plural of <palik>, from English police; in the New Testament the temple guards and court officers) (b:palik) (q:draft)
Pallu = (i:1) (t:name) (c:male) (w:Pallu) (d:son of Reuben and father of Eliab, ancestor of the Palluite clan) (r:1.46.9/4.26.8)
palsat = (i:1) (t:v) (w:transgress/violate/break) (d:break a law, command or covenant) (s:peel) (a:zui/mang) (q:draft)
palsatin = (i:1) (t:v) (w:transgressing/violating/breaking) (d:<palsat>, break a law or covenant, with the linking ending <in>: breaking it and so doing the next thing) (b:palsat) (q:draft)
palsatkhak = (i:1) (t:v) (w:break/transgress/violate) (d:<palsat>, break or transgress, with <khak>, happen to: break a promise or command, even without meaning to; {na palsatkhak loh nadingun} is so that you do not break it) (a:zuih) (q:draft)
palsatna = (i:1) (t:n) (w:transgression/rebellion/offence) (d:<palsat>, transgress, with the noun suffix <na>: the breaking of a law or command, usually in the phrase {thu palsatna}) (s:thupalsatna/khialhna/mawhna) (b:palsat) (q:draft)
palsatnate = (i:1) (t:n) (w:transgressions/offenses) (d:plural of <palsatna>, transgression; usually in the phrase {thu palsatnate}, the acts by which a person breaks the law of God) (s:thupalsatnate/mawhnate) (b:palsatna) (q:draft)
palsatte = (i:1) (t:n) (w:transgressors/those who break) (d:<palsat> transgress, with the plural <te>: those who break a command; {thu palsatte} is transgressors) (s:thupalsatte) (b:palsat) (q:draft)
paltan = (i:1) (t:v) (w:pass through/go through/cross) (d:go across a land from one side to the other) (s:kantan) (q:draft)
paltanin = (i:1) (t:v) (w:pass through/go through) (d:<paltan> with the ending <in>, linking it to what follows: passing through) (b:paltan) (q:draft)
palte = (i:1) (t:n) (w:firstfruits/first ripe ones) (d:the first of a crop to ripen, {pal} with the plural <te>; {an palte} is the firstfruits of grain and {leenggah a palte} the first ripe grapes) (s:anpalte) (q:draft)
Palti = (i:1) (t:name) (c:male) (w:Palti) (d:name of two men: the son of Raphu, the spy sent from the tribe of Benjamin, and the son of Laish to whom Saul gave his daughter Michal, called Paltiel in the NIV) (r:4.13.9/9.25.44)
Paltiel = (i:1) (t:name) (c:male) (w:Paltiel) (d:name of two men: the son of Azzan, leader of the tribe of Issachar, and the son of Laish, the husband to whom Saul gave Michal) (r:4.34.26/10.3.15)
pam = (i:1) (t:n) (w:vicinity/side/surroundings/edge) (d:the place beside or close to something; {a kim a pam} and {ka kiim ka pam} mean all around) (s:gei/pang) (r:41.13.3) (q:draft)
pama = (i:1) (t:adv) (w:around/nearby/beside) (d:<pam> side or vicinity with the place ending <a>; usually paired with <kim> or <kiim>, {a kim a pama}, all around) (s:kimkotah/kimkot) (b:pam) (q:draft)
pamah = (i:1) (t:prep) (w:beside/alongside/around) (d:<pam>, side or edge, with <ah>: at or along the side of something; {a kiim a pamah} means all around, round about) (s:geiah/kiimah) (b:pam) (q:draft)
Pamfilia = (i:1) (t:name) (c:land) (w:Pamphylia) (d:Roman province on the south coast of Asia Minor, between Lycia and Cilicia, visited by Paul) (r:44.14.24/44.2.10/44.27.5)
pammaih = (i:1) (t:adj) (w:too precious to lose/dear/precious) (d:used with <sa>, feel: {pammaih sa} is to hold something dear, be unwilling to lose or give it up, spare it, or be zealous for it) (q:draft)
pammaihsa = (i:1) (t:v) (w:spare/hold dear/be zealous for) (d:<pammaih> too precious to lose, with <sa> feel: be unwilling to lose or give up; {pammaihsa loin} is without sparing) (b:pammaih) (q:draft)
pammaihsak = (i:1) (t:v) (w:be zealous for/hold dear) (d:<pammaih> with <sak>, the form of <sa>, feel, used before <bangin>) (b:pammaih) (q:draft)
pampaih = (i:1) (t:v) (w:forsake/reject/cast aside) (d:leave aside as of no account; {mite in a pampaih mite} is people rejected by others, outcasts) (s:nusiat/nolh) (a:saang/angvan) (q:draft)
pampam = (t:see) <pampam-in>
pampam-in = (i:1) (t:adv) (w:from side to side/glancing about) (d:describes eyes turned this way and that, in {mit hei pampam-in}) (q:draft, low confidence)
pampamin = (i:1) (t:adv) (w:from side to side/glancing about) (d:describes eyes turned this way and that, in {mit hei pampamin}) (q:draft, low confidence)
pamte = (i:1) (t:n) (w:neighbours/those around) (d:<pam> side, vicinity, with the plural <te>; used in the pairs {a veng a pamte} and {na kiim na pamte}, the people living all around) (s:gamvengte/vengte/innvengte) (b:pam) (q:draft)
pan = (i:1) (t:prep) (w:from/out of/by way of) (d:placed after a noun to show the starting point or the way through, short form of <panin>) (s:panin) (a:dong)
pan = (i:2) (t:v) (d:take a stand or act as, in {teci pan} bear witness)
pan'pihna = (i:1) (t:n) (w:support/help) (d:<panpih>, side with or support, with the noun suffix <na>) (s:panpihna/huhna) (q:draft)
pana = (i:1) (t:prep) (w:from) (d:<pan>, from, with the linking suffix <a>, joining the starting point or source to the word that follows) (s:panin/pan) (b:pan)
pana = (i:2) (t:prep) (w:within)
paneah = (t:see) <Zefenath-paneah>
pang = (i:1) (t:n) (w:side) (d:the side or flank of a thing, a place or the body; {lam pang} after a direction word is the side facing that way) (s:lampang/gei/lang) (r:2.37.5) (q:draft)
pang = (i:2) (t:v) (w:testify/bear witness) (d:take a stand as, in the fixed phrase <teci pang>, be a witness, testify) (q:draft)
pang = (i:3) (t:v) (w:take position/take a side/stand against) (d:take up a position, in battle or for or against someone; {lang khatah pang} is stand against and <lamah pang> is be on the side of) (q:draft, low confidence)
panga = (i:1) (t:prep) (w:on the side of/beside/along) (d:<pang> side with the suffix {-a}: at or on the side) (s:geiah) (b:pang) (q:draft)
pangah = (i:1) (t:adj) (w:aside/at the side/on the side) (d:<pang>, side, with <ah>, at: at or on the side of something, often after a direction word, as {leitaw lam pangah}, on the south side) (b:pang)
pangbetna = (i:1) (t:n) (w:discipline/chastening) (d:correction of a child, in the verse matching the rod of discipline) (q:draft, low confidence)
pangin = (i:1) (t:v) (w:taking sides/standing against/taking position) (d:<pang>, take a position, with the linking ending <in>; {lang pangin} is taking the opposite side, against, and {gal pangin} is drawn up for battle) (b:pang) (q:draft)
pangin = (i:2) (t:v) (w:testifying/bearing witness) (d:<pang> with the linking ending <in>, in the phrase {teci pangin}, acting as a witness, testifying) (b:pang) (q:draft)
pangkhat = (i:1) (t:n) (w:one side) (d:<pang>, side, with <khat>, one; set against {pang langkhat}, the other side) (s:langkhat) (q:draft)
pangkhatah = (i:1) (t:adv) (w:on one side) (d:<pangkhat>, one side, with <ah>, at or on) (b:pangkhat) (q:draft)
pangkhawm = (i:1) (t:v) (w:side with/stand with/join with) (d:<pang>, take a side, with <khawm>, together) (s:pawlpih/panpih) (b:pang) (q:draft)
pangkik = (i:1) (t:v) (w:take up position again) (d:<pang>, take position, with <kik>, again; {gal pangkik} is to line up again for battle) (b:pang) (q:draft)
pangpi = (i:1) (t:n) (w:side/flank) (d:the side of the body, <pang> with <pi>; said of the side of Jesus pierced by the spear) (b:pang) (q:draft)
pangsak = (i:1) (t:v) (w:deploy/station/post/appoint) (d:<pang>, take position, with the causative <sak>: make someone take up a position, as soldiers against an enemy or workers at their posts) (b:pang) (q:draft)
pangsakkik = (i:1) (t:v) (w:station again/put back in position) (d:<pangsak>, station, with <kik>, again) (b:pangsak) (q:draft)
pangsim = (i:1) (t:v) (w:ambush/lie in wait) (d:hide and wait in order to attack someone by surprise) (s:buksim)
pangsim = (i:2) (t:n) (w:lure/ambush)
pangsimin = (i:1) (t:v) (w:lie in wait/ambush) (d:<pangsim>, lie in wait for someone, with the linking ending <in>) (b:pangsim) (q:draft)
pangsimte = (i:1) (t:n) (w:men in ambush/ambushers) (d:<pangsim>, ambush, with the plural <te>; {a pangsimte}, those who lie in ambush) (s:buksimte) (b:pangsim) (q:draft)
pangsuk = (i:1) (t:n) (w:slope) (d:<pang>, side, with <suk>, downward; {mual pangsuk} is a mountain slope) (s:mualpang) (b:pang) (q:draft)
pangtat = (i:1) (t:adj) (w:adulterous/unfaithful) (d:perhaps a misprint of <paktat>) (q:draft, low confidence)
pangtatte = (i:1) (t:n) (w:prostitutes) (d:in {numei pangtatte}, immoral women; <pangtat> appears to be another spelling of <paktat>, with the plural <te>) (q:draft, low confidence)
pangte = (i:1) (t:n) (w:sides) (d:plural of <pang>, side: the sides of an object such as the altar or the lampstand) (b:pang) (q:draft)
pangte = (i:2) (t:n) (w:those who stand/those who take a position) (d:those who take up a position: {langah pangte}, those who stand against someone, and {teci pangte}, those who bear witness) (b:pang) (r:40.27.13) (q:draft)
pangzo = (i:1) (t:v) (w:be able to stand against) (d:<pang>, take position for or against, with <zo>, be able) (b:pang) (q:draft)
panin = (i:1) (t:prep) (w:from/out of) (d:placed after a noun to show the starting point, source or origin; the full form of <pan>) (s:pan/akipan) (a:dong) (b:pan) (r:15.10.38)
pankhia = (i:1) (t:v) (w:begin/start/set about) (d:<pan>, begin, with <khia>, out: start off a work, be the one to begin it) (s:kipan) (a:tawp) (b:pan) (q:draft)
pankik = (i:1) (t:v) (w:take up again/declare again) (d:<pan>, take a stand or begin, with <kik>, again; {teci pankik} is testify again, and of a thing given up, take it up again) (b:pan) (q:draft, low confidence)
panmun = (i:1) (t:n) (w:position/place/post) (d:the place where one stands to do a duty; {panmun la} or <len>, take one’s place) (q:draft)
panmunkip = (i:1) (t:n) (w:stronghold/fortress) (d:<panmun>, a position or post, with <kip>, firm) (s:munkip/kulhpi) (q:draft)
panmunkipte = (i:1) (t:n) (w:strongholds/fortresses) (d:plural of <panmunkip>, a firm position: fortified places; {gal panmunkipte} are strongholds of war) (s:kulhpite/phualpite) (b:panmunkip) (q:draft)
panmunte = (i:1) (t:n) (w:posts/positions/stations) (d:plural of <panmun>, the place where one stands to serve or fight: the duties of priests and Levites, and {gal panmunte}, defences or strongholds) (b:panmun) (q:draft)
panna = (i:1) (t:n) (w:testimony/witness) (d:noun from <pan>, used in {teci panna}, the bearing of witness) (s:tecipanna) (b:pan) (q:draft)
panna = (i:2) (t:n) (w:position/battle line/station) (d:noun from <pan>, take a stand: the place or line where fighters take their stand for battle) (s:panmun) (b:pan) (q:draft, low confidence)
pannate = (i:1) (t:n) (w:testimonies/statutes) (d:plural of <panna>, found only in {teci pannate}, the testimonies of God, what he has borne witness to as his will) (s:tecipannate) (b:panna) (q:draft)
pano = (i:2) (t:n) (w:young male/male calf) (d:after an animal name, a young male, as {bawng pano} bull calf) (b:pa) (q:draft, low confidence)
panpa = (i:1) (t:n) (w:one who began) (d:<pan>, begin, with <pa>, the one who) (b:pan) (q:draft)
panpihin = (i:1) (t:v) (w:siding with/supporting/favouring) (d:<panpih>, take the part of, with the linking ending <in>) (b:panpih) (q:draft)
panpihna = (i:1) (t:n) (w:support/upholding) (d:<panpih>, take the part of, with the noun suffix <na>: the taking of someone’s side, upholding of a cause) (s:pan'pihna/huhna) (b:panpih) (q:draft)
panpihpa = (i:1) (t:n) (w:defender/supporter) (d:<panpih>, side with, with <pa>, the one who; in the verse, one who pleads for others at the gate) (s:hupa) (b:panpih) (q:draft)
pansa = (t:todo) (q:draft, in {pansa kikin} with <amaute> as object; the single verse does not make the meaning clear)
pansimna = (i:1) (t:n) (w:ambush/hiding place) (d:a lying in wait and the place of it; {pansim}, lie in wait, with the noun suffix <na>) (s:buksimna) (q:draft)
pantah = (i:1) (t:v) (w:bring up/rear/raise/nurture) (d:raise a child or a young animal) (s:khoi) (q:draft)
panun = (i:1) (t:prep) (w:from/out of) (d:<pan>, from, with the plural ending <un>, used when those spoken of are many; placed after the noun) (s:panin/pan) (b:pan) (r:20.20.11) (q:draft)
pap = (i:1) (t:v) (w:swamp/sweep over/cover) (d:said of waves covering a boat) (q:draft, low confidence)
papi = (i:1) (t:n) (w:man/grown man/men) (d:grown men as a group, paired with <nupi>, women) (s:pasal) (a:nupi) (b:pa) (r:24.44.15) (q:draft)
papite = (i:1) (t:n) (w:grown men/older men/married men) (d:plural form of <papi>, a grown or married man; set beside <nupite>, married women, and beside <tangvalte>, young men, where English has old men) (a:nupite) (b:papi) (r:24.6.11) (q:draft)
Paradais = (i:1) (t:name) (c:place) (w:Paradise) (d:the place of blessedness with God, promised by Jesus to the criminal crucified beside him; the word means garden) (r:42.23.43/47.12.3)
Paradis = (i:1) (t:name) (c:place) (w:Paradise) (d:spelling of Paradise in the older translation: the place of blessedness with God, where the tree of life stands) (r:42.23.43/66.2.7/47.12.3)
Parah = (i:1) (t:name) (c:city) (w:Parah) (d:town in the territory of the tribe of Benjamin) (r:6.18.23)
paran = (t:see) <El-paran>
Paran = (i:1) (t:name) (c:place) (w:Paran) (d:desert region in the north of the Sinai peninsula, where Ishmael lived and where Israel camped after leaving Sinai; usually {Paran gamlak}, the Desert of Paran) (r:1.21.21/4.10.12) (q:draft)
Parmashta = (i:1) (t:name) (c:male) (w:Parmashta) (d:one of the ten sons of Haman killed by the Jews in Susa) (r:17.9.7)
Parmenas = (i:1) (t:name) (c:male) (w:Parmenas) (d:one of the seven men chosen in Jerusalem to oversee the daily distribution of food) (r:44.6.5)
Parnak = (i:1) (t:name) (c:male) (w:Parnak) (d:father of Elizaphan, the leader of the tribe of Zebulun at the division of Canaan) (r:4.34.25)
Parosh = (i:1) (t:name) (c:male) (w:Parosh) (d:ancestor of a large family that returned from exile with Zerubbabel and with Ezra; the name is also among the leaders who sealed the covenant with Nehemiah) (r:15.8.3/16.10.14/15.10.25)
Parshandatha = (i:1) (t:name) (c:male) (w:Parshandatha) (d:the first named of the ten sons of Haman killed by the Jews in Susa) (r:17.9.7)
Parsin = (i:1) (t:name) (w:Parsin) (d:last word of the writing on the wall at the feast of Belshazzar, explained by Daniel as divided; the NIV has Peres in the explanation) (r:27.5.25/27.5.28)
PARSIN = (i:1) (t:n) (w:Parsin/Peres) (d:word of the writing on the wall at the feast of Belshazzar, written in capitals and explained as your kingdom is divided) (r:27.5.28) (q:draft)
Parthia = (i:1) (t:name) (c:land) (w:Parthia) (d:land south-east of the Caspian Sea; Parthians were among those who heard the apostles at Pentecost) (r:44.2.9)
Paruah = (i:1) (t:name) (c:male) (w:Paruah) (d:father of Jehoshaphat, the district governor of Solomon in Issachar) (r:11.4.17)
Parvaim = (i:1) (t:name) (c:place) (w:Parvaim) (d:place from which the gold used in the temple of Solomon came; its location is not known) (r:14.3.6)
Pasak = (i:1) (t:name) (c:male) (w:Pasak) (d:son of Japhlet, of the tribe of Asher) (r:13.7.33)
pasal = (i:2) (t:n) (w:male) (a:numei) (r:1.1.27)
pasalin = (i:1) (t:n) (w:as husband) (d:<pasal>, man or husband, with <in>, as: {pasalin nei} is have as husband) (b:pasal) (q:draft)
pasalkhat = (i:1) (t:n) (w:a man/a husband) (d:<pasal>, man, with <khat>, one) (q:draft)
pasalnei = (i:1) (t:v) (w:take a husband/be married) (d:<pasal> man, husband, with <nei> have, said of a woman; paired with <zinei>, take a wife; {pasalnei thak} is a bride) (q:draft)
Pasalpa = (i:1) (t:n) (w:man) (d:<pasal> man, male, with <pa> marking a man; {Pasalpa Moses} is the man Moses) (q:draft)
pasalte = (i:1) (t:n) (w:husbands) (d:plural of <pasal> in the sense of husband, set beside <zite>, wives) (a:zite) (b:pasal) (r:49.5.25) (q:draft)
pasalte = (i:2) (t:n) (w:men/males) (d:{nasem pasalte} are male servants) (a:numeite) (b:pasal) (q:draft)
Pasdammim = (i:1) (t:name) (c:place) (w:Pas Dammim) (d:place in Judah where David and his mighty men stood against the Philistines, called Ephes Dammim in 1 Samuel) (r:13.11.13)
Pasdammin = (i:1) (t:name) (c:place) (w:Pas Dammim) (d:place in Judah where David and his mighty men stood against the Philistines; another spelling of <Pasdammim>) (r:13.11.13)
Paseah = (i:1) (t:name) (c:male) (w:Paseah) (d:name of several men, among them a son of Eshton of Judah and the father of Joiada who repaired the Jeshanah Gate; also the head of a family of temple servants) (r:13.4.12/16.3.6)
Pashhur = (i:1) (t:name) (c:male) (w:Pashhur) (d:name of several men, among them the priest, son of Immer, who had Jeremiah beaten and put in the stocks, and the head of a priestly family) (r:24.20.1/13.9.12)
pasian = (i:1) (t:n) (w:god) (d:a god or deity other than the one God, written without a capital; {pasian dang} is another god)
Pasian = (i:1) (t:n) (w:God) (d:the one true God, written with a capital; {Topa Pasian} is the Lord God) (r:41.11.22)
PASIAN = (i:1) (t:n) (w:God) (d:<Pasian> written in capitals after <Topa>: {Topa PASIAN}, Sovereign Lord in the NIV, where older English Bibles print Lord GOD) (r:2.23.17) (q:draft)
pasiannu = (i:1) (t:n) (w:goddess) (d:<pasian>, god, with <nu>, marking a female) (s:nusian) (b:pasian) (q:draft)
pasiante = (i:1) (t:n) (w:gods) (d:<pasian>, god, with the plural <te>: gods, also of household gods and idols) (b:pasian) (r:5.32.37)
pat = (i:1) (t:v) (w:begin/start) (d:form of <pan>, begin, used before <ciangin>, <lai> and <theih>; follows another verb for begin to) (s:kipat) (q:draft)
pata = (i:1) (t:n) (w:father and son/father and child) (d:<pa>, father, with <ta>, child; {pata bang} is like father and son) (b:pa) (q:draft)
Patara = (i:1) (t:name) (c:city) (w:Patara) (d:port city of Lycia in Asia Minor where Paul changed ships on his way to Jerusalem) (r:44.21.1)
patau = (i:1) (t:v) (w:be troubled/be alarmed/be dismayed) (d:be greatly disturbed in mind by fear, worry or anger; {patau kohna} is an alarm, a warning call) (s:lungmang/lungkham) (a:ngaihmuang) (q:draft)
patauh = (i:1) (t:v) (w:be alarmed/be dismayed) (d:form of <patau> used before <huai> and <nading>: {patauh huai}, alarming, shocking) (b:patau) (q:draft)
patauhhuai = (i:1) (t:adj) (w:shocking/alarming) (d:<patau>, be alarmed, with <huai>, causing such a feeling) (q:draft)
patauhna = (i:1) (t:n) (w:alarm/panic/terror) (d:state of being alarmed and thrown into confusion) (s:launa/lauthawngna) (a:lungnopna/lungmuanna) (b:patauh) (q:draft)
pataukoh = (i:1) (t:v) (w:sound the alarm/signal) (d:<patau>, alarm, with <koh>, call out: give the alarm call, as with trumpets in war) (q:draft)
pataukohna = (i:1) (t:n) (w:alarm/alarm call) (d:a loud signal of danger or war, sounded on a trumpet) (s:theihsakna) (b:pataukoh) (q:draft)
pataulua = (i:1) (t:v) (w:be greatly troubled/be very alarmed) (d:<patau>, be troubled, with <lua>, very much) (b:patau) (q:draft)
patausak = (i:1) (t:v) (w:alarm/frighten/disturb) (d:cause to be alarmed or to panic; <patau> with the causative <sak>) (s:lausak) (b:patau) (q:draft)
pate = (i:1) (t:n) (w:fathers/ancestors/parents) (d:<pa>, father, with the plural <te>: fathers; {pu leh pate} or {pute pate} means ancestors, and {nu leh pate} means parents) (s:pulepate) (a:nute) (b:pa) (r:20.30.11) (q:draft)
Pathahiah = (i:1) (t:name) (c:male) (w:Pethahiah) (d:one of the Levites who led the people in praise and confession in the time of Nehemiah) (r:16.9.5)
Pathros = (i:1) (t:name) (c:land) (w:Pathros/Upper Egypt) (d:Upper Egypt, the southern part of the land of Egypt) (r:23.11.11/26.29.14)
Pathru = (i:1) (t:name) (c:male/people) (w:Pathrusim/Pathrusites) (d:people descended from Mizraim son of Ham, the inhabitants of Pathros in Upper Egypt) (r:1.10.14)
Pathrus = (i:1) (t:name) (c:people) (w:Pathrusite/Pathrusites) (d:people descended from Mizraim son of Ham, the inhabitants of Pathros in Upper Egypt) (r:13.1.12)
patkhaute = (i:1) (t:n) (w:threads/strings) (d:<pat>, cotton, with <khau>, cord, and the plural <te>: cotton thread, a strand of tow) (q:draft)
patkhiat = (i:1) (t:v) (w:begin/lead off/start) (d:<pat>, begin, with <khiat>, out; form of {patkhia} used before <ding>: start off a prayer or song for others to follow) (b:pat) (q:draft)
patkhit = (i:1) (t:v) (w:have begun) (d:<pat>, begin, with <khit>, finished; {patkhit ciangin} is after beginning) (q:draft)
patlom = (i:1) (t:n) (w:tinder/tow) (d:a bunch of cotton or fibre that catches fire easily; <pat>, cotton, with <lom>, bundle) (q:draft)
Patmos = (i:1) (t:name) (c:place) (w:Patmos) (d:small island in the Aegean Sea where John was when he received the Revelation) (r:66.1.9)
patna = (i:1) (t:n) (w:beginning/start) (d:<pat>, begin, with the noun suffix <na>: the beginning; often in {a patna pan a tawpna dong}, from beginning to end) (s:kipatna/cilna) (a:tawpna/beina) (b:pat) (r:9.3.12) (q:draft)
patpuan = (i:1) (t:n) (w:linen/cotton cloth) (d:<pat>, cotton, with <puan>, cloth; the Bible uses it where English has linen) (s:saihadial) (q:draft)
Patrobas = (i:1) (t:name) (c:male) (w:Patrobas) (d:Christian in Rome to whom Paul sends greetings) (r:45.16.14)
patsa = (i:1) (t:adj) (w:begun/already started) (d:<pat>, begin, with <sa>, already done; {a patsa}, what has been begun) (b:pat) (q:draft)
pattahsa = (i:1) (t:v) (w:reared/brought up) (d:<pattah>, bring up or nurture a child, with <sa> marking the action as done: whom one has reared) (q:draft)
patun = (i:1) (t:v) (d:<pat>, begin, with the ending <un>; found in the pair {na pian’ na patun}, from birth and beginning, that is by birth) (b:pat) (q:draft, low confidence)
Pau = (i:1) (t:name) (c:city) (w:Pau) (d:city of Hadad, one of the kings who reigned in Edom) (r:1.36.39) (q:draft)
paubaan = (i:1) (t:v) (w:be at fault/be blameworthy) (d:form of <paubaang> used before <na>; {paubaan’na} is fault or blame, and {paubaan’na om lo} is blameless) (q:draft)
paubaang = (i:1) (t:v) (w:be free from/without)
paubaang = (i:2) (t:v) (w:keep away from/stay away from)
paubaang = (i:3) (t:v) (w:blame) (d:find fault with or hold to blame; mostly with <lo> or <kei>, not to be blamed, blameless) (s:genbaang/mawhsak) (a:phat)
paubaang lo = (i:1) (t:adj) (w:blameless) (d:<paubaang>, blame, with the negative <lo>: not to be blamed, without fault; of the heart, wholly devoted) (b:paubaang) (r:18.4.6)
paubaanna = (i:1) (t:n) (w:fault/blame/defect/blemish) (d:something to find fault with; {paubaanna om lo} is blameless or without defect) (s:pauban/paubanna/sitbaanna/kawkbaanna) (b:paubaan) (q:draft)
pauban = (i:1) (t:n) (w:blemish/defect/fault) (d:a flaw in body or character, mostly in the form {pauban’na} and with a negative: without blemish, blameless) (s:paubaanna/paubanna/sitbaanna/sit) (q:draft)
paubang = (i:1) (t:adj) (w:blameless) (d:used with <lo> or <kei>: {paubang lo} is blameless, not to be blamed; of the heart, wholly devoted)
paubanna = (i:1) (t:n) (w:blemish/defect) (d:<pauban>, blemish, with the noun suffix <na>; with {om lo}, without defect) (s:paubaanna/pauban/sitbaanna) (b:pauban) (q:draft)
paudang = (i:1) (t:n) (w:foreign language/strange tongue) (d:<pau>, language, with <dang>, other) (s:kamtuam) (q:draft)
paukha = (i:1) (t:v) (w:speak rashly/blurt out) (d:<pau>, speak, with <kha>, happen to: say something without meaning to) (q:draft)
paukhia = (i:1) (t:v) (w:speak out/speak up/utter) (d:<pau>, speak, with <khia>, out: break silence and say something aloud) (s:genkhia/pulakkhia) (a:daih) (b:pau) (q:draft)
paukhial = (i:1) (t:v) (w:blaspheme/speak wrongly) (d:<pau>, speak, with <khial>, wrongly; in the verse, against God) (s:kosia/gensia) (q:draft)
paukhialhna = (i:1) (t:n) (w:blasphemy) (d:<pau>, speak, with <khialh>, go wrong, and the noun suffix <na>; wrong speaking, in the verses speaking against God) (s:gensiatna) (q:draft)
paukhiat = (i:1) (t:v) (w:utter/speak out/say aloud) (d:form of <paukhia>, speak out, used before words such as <ma-in> and <ciangin>) (s:genkhiat) (b:paukhia) (q:draft)
paukhiatna = (i:1) (t:n) (w:utterance/speaking) (d:<paukhiat>, speak out, with the noun suffix <na>; the act of speaking a word aloud) (b:paukhiat) (q:draft)
Paul = (i:1) (t:name) (c:male) (w:Paul) (d:apostle to the Gentiles, earlier called Saul of Tarsus, who wrote many of the New Testament letters) (r:44.17.33/46.16.21) (q:draft)
paulam = (i:1) (t:n) (w:pretext/excuse) (d:a reason put forward to cover what one wants to do; {paulam zong} is to look for an excuse) (s:paulap) (q:draft)
paulamin = (i:1) (t:prep) (w:in the name of/on account of/with reference to) (d:placed after a noun: naming or appealing to that person or thing as the ground for what is said or done) (b:paulam) (q:draft, low confidence)
paulap = (i:1) (t:n) (w:pretext/excuse/occasion) (d:a reason looked for in order to do or to avoid something; {paulap zong} is to look for an excuse) (s:paulam) (q:draft)
Paulus = (i:1) (t:name) (c:male) (w:Paulus) (d:Sergius Paulus, the Roman proconsul of Cyprus who sent for Barnabas and Saul to hear the word of God) (r:44.13.7)
paumawl = (i:1) (t:adj) (w:hardly able to talk/speech-impaired) (d:<pau>, speak, with <mawl>, dull: speaking with difficulty) (q:draft)
pauna = (i:1) (t:n) (w:speech/words/speaking) (d:<pau>, speak, with the noun suffix <na>: what a person says, or the act of speaking) (s:kampau/thugenna/genna) (b:pau) (q:draft)
paunak = (i:1) (t:n) (w:proverb/saying/byword) (d:a short wise saying handed down among a people; also a person or nation that others make a byword; <Paunak> is the name of the book of Proverbs) (q:draft)
paunakte = (i:1) (t:n) (w:proverbs/sayings) (d:<paunak>, proverb, with the plural <te>) (b:paunak) (q:draft)
paunam = (i:1) (t:n) (w:language/language group) (d:<pau>, language, with <nam>, kind: a language, or the people who speak one language; {paunam tuamtuamte} is people of every language) (s:kampau/pau) (r:27.4.1) (q:draft)
paunasate = (i:1) (t:n) (w:things said/words spoken) (d:<pau>, speak, with the noun suffix <na>, <sa> for what is already done, and the plural <te>: the things one has said) (s:gensate) (q:draft)
paunate = (i:1) (t:n) (w:words/utterances) (d:<pauna>, speech, with the plural <te>: the things a person says) (s:kammalte/thugente/gennate) (b:pauna) (q:draft)
paupah = (i:1) (t:v) (w:begin to speak/speak at once) (d:<pau>, speak, with <pah>, straight away) (q:draft)
paupakna = (i:1) (t:n) (w:rash talk/hasty speech) (d:speaking out without thought; <pau>, speak, with <pak>, hastily, and the noun suffix <na>) (q:draft, low confidence)
paupau = (i:1) (t:v) (w:keep talking/babble/talk on) (d:<pau>, speak, said twice: talk on and on, often with <mawk> or <pheng>, without thought) (q:draft)
paupaute = (i:1) (t:n) (w:talkers/those who talk on) (d:<paupau>, keep talking, with <te>, those who: {kihisak-a paupaute}, those who talk on proudly) (b:paupau) (q:draft, low confidence)
paupeeng = (i:1) (t:adj) (w:stubborn/obstinate) (d:refusing to listen or give way; said together with {lungsim khauh}, hard of heart) (s:paupeng/lungkhauh/genhak) (q:draft)
paupeengin = (i:1) (t:adj) (w:stubborn/obstinate) (d:<paupeeng> with the ending <in>, linking it to what follows: being stubborn) (s:lungkhauhin) (b:paupeeng) (q:draft)
paupeengsak = (i:1) (t:v) (w:make stubborn/harden) (d:<paupeeng>, be stubborn or obstinate, with the causative <sak>) (s:paupeensak/lungkhauhsak/khauhsak) (q:draft)
paupeensak = (i:1) (t:v) (w:harden/make stubborn) (d:<paupeeng>, stubborn, with causative <sak>; written <paupeengsak> later in the same verse) (s:paupeengsak/lungkhauhsak) (q:draft)
paupeng = (i:1) (t:adj) (w:stubborn/obstinate/contentious) (d:of people who will not listen or give way) (s:paupeeng/lungkhauh/genhak) (q:draft)
paupih = (i:1) (t:v) (w:speak to/say to) (d:<pau>, speak, with <pih>, to or with: say something to someone, or with <ngam> and a negative, dare to speak against) (s:hopih/genpih) (b:pau) (q:draft)
pausak = (i:1) (t:v) (w:let speak/make speak/allow to speak) (d:<pau>, speak, with the causative <sak>: allow someone to speak, or make someone able to speak) (s:gensak) (b:pau) (q:draft)
pausia = (i:1) (t:n) (w:profane talk/evil speech) (d:<pau>, speak, with <sia>, bad; {pausia gen} is to speak profanely) (s:kamsia) (q:draft, low confidence)
paute = (i:1) (t:n) (w:languages/tongues/words) (d:<pau>, language or word, with the plural <te>: languages, tongues, or the words someone speaks) (b:pau) (q:draft)
paute = (i:2) (t:n) (w:talkers/those who speak) (d:<pau>, speak, with <te>, those who: people who talk; {pau lamdang a paute} is those who speak in tongues) (q:draft, low confidence)
pauthei = (i:1) (t:v) (w:be able to speak/can talk) (d:<pau>, speak, with <thei>, be able; {pauthei lo} means mute, unable to speak) (b:pau) (q:draft)
pautheih = (i:1) (t:v) (w:be able to speak/can speak) (d:form of <pauthei>, be able to speak, used before words such as <ding>, <nading> and <hangin>) (b:pauthei) (q:draft)
pautheikik = (i:1) (t:v) (w:be able to speak again) (d:<pauthei>, be able to speak, with <kik>, again) (b:pauthei) (q:draft)
pautheilote = (i:1) (t:n) (w:the mute/the dumb) (d:{pau thei lo}, not able to speak, with the plural <te>: people who cannot speak) (q:draft)
pautuam = (i:1) (t:n) (w:tongue/unknown tongue) (d:speech in another, unknown language, speaking in tongues; mostly as {pautuam dang}) (s:kamtuam) (r:46.13.8) (q:draft)
pauzaw = (i:1) (t:v) (w:speak rather/speak instead) (d:<pau>, speak, with <zaw>, more or rather: prefer to speak one thing instead of another) (s:genzaw) (b:pau) (q:draft)
pawh = (i:1) (t:part) (w:if only/oh that) (d:sentence-final word after <leng> or <leh>, expressing a strong wish) (q:draft)
Pawi = (i:1) (t:n) (w:festival/feast) (d:capitalised in the name of a feast; <Paisan Pawi> is the Passover) (s:pawikhamna/pawikhawmna) (b:pawi) (r:14.35.17) (q:draft)
pawibawl = (i:1) (t:v) (w:hold a festival/celebrate a feast) (d:<pawi>, festival, with <bawl>, make; {pawibawl ni} is a festival day) (s:pawikham) (b:pawi) (q:draft)
pawibawlna = (i:1) (t:n) (w:feasting/celebration) (d:<pawibawl>, hold a festival, with the noun suffix <na>) (s:pawikhamna/gualnopna) (b:pawibawl) (q:draft)
pawikham = (i:1) (t:v) (w:feast/celebrate a festival/hold a feast) (d:<pawi>, festival, and <kham>, keep: keep a feast or festival; also of the festival itself, as in {pawikham ni}, the feast day) (s:pawibawl) (q:draft)
pawikhamna = (i:1) (t:n) (w:feast/festival/celebration) (d:the keeping of a feast; {Paisan pawikhamna} is the Festival of the Passover) (s:pawi/pawikhawmna/pawibawlna) (b:pawikham) (q:draft)
pawikhawm = (i:1) (t:v) (w:sow together/mix) (d:<pawi>, sow, with <khawm>, together: sow two kinds of seed together in one field) (q:draft, low confidence)
pawikhawmna = (i:1) (t:n) (w:festival/feast) (d:<pawi>, festival, with <khawmna>, gathering) (s:pawikhamna/pawi) (q:draft)
pawina = (i:1) (t:n) (w:ceremony/observance) (d:<pawi> festival, with the noun suffix <na>: the keeping of a feast) (b:pawi) (q:draft, low confidence)
pawina = (i:2) (t:n) (w:sowing) (d:<pawi>, sow, with the noun suffix <na>: {a pawina leitang} is the land sown with a given measure of seed) (q:draft, low confidence)
pawipi = (i:1) (t:n) (w:great feast/banquet) (d:<pawi>, festival or feast, with <pi>, great) (s:lawmvakna/anvakna) (b:pawi) (q:draft)
pawipuan = (i:1) (t:n) (w:festal garment/set of clothes/change of clothes) (d:fine clothing worn at a feast, counted as a set; <pawi> feast with <puan> cloth) (q:draft)
pawipuante = (i:1) (t:n) (w:festal garments/fine robes/sets of clothes) (d:<pawipuan>, festal garment, with the plural <te>) (b:pawipuan) (q:draft)
pawisiim = (i:1) (t:v) (w:attend a feast/keep a festival) (d:<pawi>, festival, with <siim>, attend: go to a festival and take part in it) (q:draft)
Pawisimna = (i:1) (t:n) (w:feasting/keeping of a feast) (d:<pawi> festival, feast, with <sim> and the noun suffix <na>; set against <sigalna>, mourning for the dead) (s:pawibawlna) (a:sigalna) (q:draft, low confidence)
pawisimte = (i:1) (t:n) (w:wedding guests/guests) (d:those who attend a feast; <pawi>, feast, with <sim>, attend, and the plural <te>) (s:leenglate/kisamte) (q:draft)
pawite = (i:1) (t:n) (w:festivals/feasts) (d:<pawi>, festival, with the plural <te>: festivals or feasts, the appointed religious celebrations of the year) (b:pawi) (q:draft)
pawkhat = (i:1) (t:det) (w:some/a part of) (d:placed after a noun: some of them, a part of it) (s:kimkhat/khenkhat) (q:draft, low confidence)
pawl = (i:1) (t:n) (w:group/division/company/party) (d:a group of people, as a division of an army, a company or a party; {pawl khat}, one group, is also used for some) (s:hon) (q:draft)
Pawlas = (i:1) (t:name) (c:male) (w:Paulus) (d:Sergius Paulus, the Roman proconsul of Cyprus who sent for Barnabas and Saul to hear the word of God) (r:44.13.7)
pawlbawl = (i:1) (t:v) (w:welcome/accept/take in) (d:<pawl>, group or companion, with <bawl>, make; receive a person into one's company or service) (a:nolh) (b:pawl) (q:draft)
pawlcing = (i:1) (t:v) (w:become numerous/grow in number) (d:said of a people growing into a large body; apparently <pawl>, group, with <cing>, full) (s:pung) (a:kiam) (q:draft, low confidence)
pawldang = (i:1) (t:n) (w:other group/other company) (d:<pawl>, group, with <dang>, other) (q:draft)
pawlin = (i:1) (t:v) (w:join/side with) (d:<pawl> used as a verb with the linking ending <in>: joining someone or taking the side of someone) (s:pawlpih/kipawlin) (q:draft)
pawlin = (i:2) (t:adv) (w:in groups/by divisions) (d:in the doubled form {a pawl pawlin}, group by group) (s:pawlpawlin/honhonin) (b:pawl) (r:4.10.22) (q:draft)
pawlin = (i:3) (t:adv) (w:about/around) (d:about the time of, as in {nitum pawlin}, around sunset) (q:draft, low confidence)
pawlkhatah = (i:1) (t:v) (w:foregather) (d:<pawlkhat>, one group, with the place ending <ah>: in one group, to one group) (b:pawlkhat)
pawlkhatin = (i:1) (t:adv) (w:as one group/in fellowship/united) (d:<pawlkhat>, one group, with the ending <in>: being one company with someone, in fellowship; {pawlkhatin bawl} is make into one) (s:kikhatin) (b:pawlkhat) (q:draft)
pawlkhatte = (i:1) (t:pron) (w:some/others) (d:<pawlkhat>, some, with the plural <te>: some people, some of them; often after <mi> or the name of a people) (b:pawlkhat) (r:40.13.8) (q:draft)
pawlmat = (i:1) (t:v) (w:win over/enlist/make an ally of) (d:<pawl>, group, with <mat>, catch: get someone onto the side of a party, gather people as a party) (q:draft)
pawlpawl = (i:1) (t:adj) (w:various/of every kind/all kinds of) (d:<pawl>, group or kind, doubled: of many different kinds, in every way; often written {a pawlpawl} after the noun) (s:apawlpawl/namcin/atuamtuam) (q:draft)
pawlpawlin = (i:1) (t:adv) (w:in groups/by divisions/group by group) (d:<pawl>, group, doubled, with the ending <in>: group by group, each in its own division) (s:honhonin/pawlin/honin) (b:pawlpawl) (q:draft)
pawlpawlte = (i:1) (t:n) (w:all kinds/various groups) (d:<pawlpawl>, group by group, with the plural <te>; the various groups of people or kinds of a thing) (s:apawlpawlte) (b:pawlpawl) (q:draft)
Pawlpi = (i:1) (t:n) (w:church/congregation) (d:<pawlpi>, church, written with a capital letter at the start of a sentence or in a title; {Pawlpi siapa} is the overseer of the church) (b:pawlpi) (q:draft)
pawlpih = (i:1) (t:v) (w:join/side with/ally with) (d:<pawl>, group, with <pih>, together with: be of one party with someone, take the side of someone) (s:kipawlin/panpih/pawlin) (a:langpan) (b:pawl) (q:draft)
pawlpihna = (i:1) (t:n) (w:siding with/alliance) (d:<pawlpih>, side with, with the noun suffix <na>: the fact of having taken the side of someone) (s:kipawlna) (b:pawlpih) (q:draft)
pawlpite = (i:1) (t:n) (w:churches) (d:<pawlpi>, church, with the plural <te>) (b:pawlpi) (r:60.5.3) (q:draft)
pawlsung = (i:1) (t:n) (w:within the group/in the party) (d:<pawl>, group, with <sung>, inside: within a party, among its members) (q:draft)
pawlte = (i:1) (t:n) (w:companions/followers/company) (d:those who belong to one group or side; also bands or groups of people) (s:kipawlte) (b:pawl) (q:draft)
pawlthum = (i:1) (t:n) (w:three companies/three groups) (d:<pawl>, group, with <thum>, three) (s:honthum) (q:draft)
pawltuam = (i:1) (t:n) (w:faction/separate party) (d:<pawl>, group, with <tuam>, separate: {pawltuam lungsim} is a factious or party spirit) (q:draft)
pawm = (i:1) (t:v) (w:join/accompany/take part in) (d:go in with others, join a battle, a leader or a song) (s:pawlpih) (q:draft)
pawm = (i:2) (t:v) (w:swell/rise) (d:of the body swelling up, and of dough rising with yeast) (a:teem) (q:draft)
pawmin = (i:1) (t:v) (w:joining/siding with/rallying around) (d:<pawm>, join, with the linking ending <in>: taking the side of someone, gathering around a leader) (s:pawlin) (b:pawm) (q:draft)
pawmsak = (i:1) (t:v) (w:make swell/leaven/make rise) (d:<pawm>, swell, with the causative <sak>: said of yeast making dough rise and of a body made to swell) (b:pawm) (q:draft)
pawmsakin = (i:1) (t:v) (w:making swell) (d:<pawmsak> make swell, with the linking suffix <in>) (b:pawmsak) (q:draft)
pawn = (i:1) (t:n) (w:scar/mark) (d:the mark left by a boil, burn or wound) (s:meimapawn) (q:draft)
pawn = (i:2) (t:n) (w:wasteland/bare land) (d:open land that is bare or newly cut, often as {pawn lak}) (s:pawnlak/gamkhing) (q:draft)
pawnlak = (i:1) (t:n) (w:wasteland/desolate place) (d:paired with <gamlak>, wilderness, for a field laid waste) (s:pawn/gamkhing/gamsia) (q:draft, low confidence)
pawpite = (t:see) <pawpite-ah>
pawpite-ah = (i:1) (t:n) (w:in the churches) (d:apparently <pawlpite> churches with <ah> in; <pawpite> looks like a misprint of <pawlpite>) (q:draft, low confidence)
pawta = (i:1) (t:n) (w:measure/quart) (d:a small dry measure for grain) (q:draft, low confidence)
Pedahel = (i:1) (t:name) (c:male) (w:Pedahel) (d:son of Ammihud, the leader from the tribe of Naphtali chosen to help divide the land of Canaan) (r:4.34.28)
Pedahzur = (i:1) (t:name) (c:male) (w:Pedahzur) (d:father of Gamaliel, the leader of the tribe of Manasseh in the wilderness) (r:4.7.54/4.10.23)
Pedaiah = (i:1) (t:name) (c:male) (w:Pedaiah) (d:name of several men, among them a son of King Jehoiachin and father of Zerubbabel, and a Levite whom Nehemiah put in charge of the storerooms) (r:13.27.20/13.3.18)
peei = (i:1) (t:n) (w:wheel) (d:another spelling of <pei> wheel) (s:pei/leengpei) (q:draft)
peek = (i:1) (t:n) (w:piece/coin/leaf) (d:a flat piece; used as a counter for coins, tablets and door leaves) (q:draft)
peek = (i:2) (t:v) (w:swim) (d:move through water by swimming; {tui peek} is swim in water) (s:tuipeek) (q:draft)
peek = (i:3) (t:v) (w:kick/kick against) (d:strike back with the foot or heel) (r:44.9.5) (q:draft, low confidence)
peeka = (i:1) (t:v) (w:swimming) (d:<peek> swim with <a> linking it to the next verb: {tui peeka a taimang}, escape by swimming) (b:peek) (q:draft)
peekin = (i:1) (t:v) (w:swimming/swim) (d:<peek>, swim, with the linking ending <in>; {tui peekin}, by swimming) (b:peek) (q:draft)
peekkhat = (i:1) (t:n) (w:one coin/a coin) (d:<peek>, counter for coins, with <khat>, one: a single coin, a denarius) (q:draft)
peekpi = (i:1) (t:n) (w:expanse/sheet/broad flat surface) (d:<peek>, flat piece, with <pi>, great: {van peekpi} is the expanse of the sky, {limlang peekpi} a great sheet of glass, {sing peekpi} a large board) (b:peek) (q:draft, low confidence)
peeksat = (i:1) (t:v) (w:break apart/snap/tear apart) (d:break a chain or bond in pieces; also written <peksat>) (s:peksat/kuaitan) (q:draft)
peekte = (i:1) (t:n) (w:boards/planks/tablets) (d:<peek>, flat piece, with the plural <te>: boards or planks of wood, and the stone tablets of the law) (b:peek) (q:draft)
peekte = (i:2) (t:n) (w:palms) (d:with <khut>, hand: {khut peekte}, the palms, the flat of the hands) (b:peek) (q:draft)
peel = (i:1) (t:v) (w:avoid/shun/keep away from/beware of) (d:stay clear of a person or thing, turn away from) (s:pelh/pel/kipelh) (q:draft)
peel = (i:2) (t:v) (w:fail to keep/evade/break) (d:of a covenant or an appointed observance: evade it, not keep it; {peel loin} is without fail) (s:palsat/pelh) (a:zui) (q:draft, low confidence)
peelhem = (i:1) (t:v) (w:be missing/be lacking) (d:be absent from a counted number; also written <pelhem>) (s:pelhem/pelem) (q:draft)
peelin = (i:1) (t:v) (w:avoiding/passing by/turning from) (d:<peel>, avoid or go around, with the linking suffix <in>) (s:pelhin/pelin) (b:peel) (q:draft)
peem = (i:1) (t:v) (w:sojourn/reside as a foreigner/migrate/settle) (d:live in a place that is not home, as an incomer among another people) (q:draft)
peemin = (i:1) (t:v) (w:sojourning/residing as a foreigner) (d:<peem>, live in a place as an incomer, with the linking ending <in>) (b:peem) (q:draft)
peemna = (i:1) (t:n) (w:lodging/place of stay) (d:<peem>, live somewhere as an incomer, with the noun suffix <na>: where or with whom one is staying; {ka peemna meigongnu}, the widow I am staying with) (s:zintunna) (b:peem) (q:draft)
peempak = (i:1) (t:n) (w:sojourner/exile/temporary resident) (d:one who lives for a time in a place that is not home; <peem>, sojourn, with <pak>, for a short while) (s:peemta) (q:draft)
peemta = (i:1) (t:n) (w:foreigner/sojourner/stranger/temporary resident) (d:one who lives in a land that is not his own; {peemta-in om} is live as a foreigner) (s:khualmi/mikhual/gamdangmi) (a:tualsuak) (q:draft)
peemtate = (i:1) (t:n) (w:foreigners/sojourners/strangers) (d:<peemta>, sojourner, with the plural <te>: people living in a land that is not their own, often paired with <mikhualte>) (s:khualmite/mikhualte/pemtate/peemte) (b:peemta) (q:draft)
peemte = (i:1) (t:n) (w:foreigners/sojourners/resident aliens) (d:used after <mi> as {mi peemte}, people who have moved in and live in a land not their own) (s:peemtate/khualmite/mikhualte) (b:peem) (q:draft)
Peeng = (i:1) (t:n) (w:twin) (d:one of two born together; {Unau Peeng}, the Twin, is the byname of Thomas, Didymus, and {Ta Peeng milim} is the image of the twin gods Castor and Pollux) (b:peeng) (q:draft)
peengkhul = (i:1) (t:n) (w:trumpet) (d:apparently another spelling of <pengkul> trumpet) (s:peengkul/pengkul) (q:draft, low confidence)
peengkul = (i:1) (t:n) (w:trumpet) (d:a trumpet or horn blown as a signal in war and in worship; {peengkul tum} or {peengkul mut} is blow the trumpet) (s:pengkul/peengkhul)
peengkulte = (i:1) (t:n) (w:trumpets) (d:<peengkul>, trumpet, with the plural <te>) (s:Pengkulte) (b:peengkul) (q:draft)
peh = (i:1) (t:v) (w:graft/graft in) (d:join a branch or shoot onto another plant; {peh kik} is graft in again) (q:draft)
pehin = (i:1) (t:v) (w:grafting/grafted in) (d:<peh>, graft, with the linking ending <in>) (b:peh) (q:draft)
pehkik = (i:1) (t:v) (w:graft in again/graft back) (d:<peh>, graft, with <kik>, again or back) (b:peh) (q:draft)
pehsakin = (i:1) (t:v) (w:crossing) (d:of the hands or arms, laying one across the other; <pehsak> with the linking suffix <in>) (s:kipaihpehsakin) (q:draft, low confidence)
pehtum = (i:1) (t:v) (w:eat up/devour) (d:said of a worm eating cloth away completely) (s:nektum/netum) (q:draft, low confidence)
pei = (i:1) (t:n) (w:wheel) (d:wheel of a cart or chariot, as in <leengpei>) (s:leengpei/lengpei/peei) (q:draft)
pei = (i:2) (t:v) (w:shake/wag) (d:with <lu>, head: shake the head from side to side, in mockery) (q:draft)
peigawpin = (i:1) (t:v) (w:sweeping over/whirling upon) (d:<pei>, whirl as a whirlwind does, with the intensive <gawp> and the linking suffix <in>) (q:draft, low confidence)
peikalhna = (i:1) (t:n) (w:spoke) (d:the bars of a wheel between hub and rim; <pei>, wheel, with <kalhna>, crossbar) (q:draft, low confidence)
peikual = (i:1) (t:n) (w:rim) (d:the round outer part of a wheel; <pei>, wheel, with <kual>, circle) (q:draft, low confidence)
peisan = (i:1) (t:v) (w:shake at/toss at/wag at) (d:<pei>, shake, with <san>, at: used with <lu>, head; {lu peisan} is shake or toss the head at someone in scorn) (b:pei) (q:draft)
peisanin = (i:1) (t:v) (w:shaking at/wagging at) (d:<peisan> with the linking ending <in>; {lu peisanin}, shaking the head at someone in scorn) (b:peisan) (q:draft)
peite = (i:1) (t:n) (w:wheels) (d:<pei>, wheel, with the plural <te>) (s:leengpeite) (b:pei) (q:draft)
peizawl = (i:1) (t:n) (w:axle) (d:a part of a wheel, first in a list that the English gives as axles, rims, spokes and hubs) (q:draft, low confidence)
pek = (i:1) (t:adv) (w:far/long ago) (d:placed after a word of time or distance to stress how far off it is, as in {sawt pek} long ago, <tanglai pek> ancient times and {gamlapi pek} far away) (q:draft)
peka = (i:1) (t:adv) (w:far away/far off/long ago) (d:<pek>, far, with the ending <a>: far in place as {gam peka}, or far in time as {tanglai peka}, long ago) (b:pek) (q:draft)
pekah = (i:1) (t:adv) (w:far off/far away/to the farthest part) (d:<pek>, far, with the place ending <ah>: at or to a point far away, far above or deep within) (s:gamlapi) (b:pek) (q:draft)
Pekah = (i:1) (t:name) (c:male) (w:Pekah) (d:son of Remaliah, an officer who killed King Pekahiah and reigned over Israel in Samaria until he was killed by Hoshea) (r:12.15.31) (q:draft)
Pekahiah = (i:1) (t:name) (c:male) (w:Pekahiah) (d:son of Menahem, king of Israel in Samaria for two years, killed by his officer Pekah) (r:12.15.22/12.15.26)
pekin = (i:1) (t:adv) (w:long ago/long before/already) (d:<pek> with the adverb ending <in>; stresses how far back in time something was so, as in {ma pekin}, long before, and <lai pekin>, back when) (b:pek) (r:44.15.7) (q:draft)
Pekod = (i:1) (t:name) (c:place) (w:Pekod) (d:region of Babylonia and the people living there, named together with Shoa and Koa) (r:24.50.21/26.23.23)
pekpak = (i:1) (t:adv) (d:descriptive word used with <tuk>, fall: dropping down limp, as people who faint in the streets) (q:draft, low confidence)
pekpek = (i:1) (t:adv) (w:very far/by far/long ago) (d:<pek>, far, said twice for emphasis: after <lui>, old, very long ago or ancient; after a comparative with <zaw>, far more) (q:draft)
peksat = (i:1) (t:v) (w:break/snap/annul) (d:break a chain apart; of a covenant, break or set aside; also written <peeksat>) (s:peeksat) (q:draft)
peksatin = (i:1) (t:v) (w:breaking/annulling) (d:<peksat>, break or set aside, with the linking suffix <in>) (b:peksat) (q:draft)
pel = (i:1) (t:v) (w:avoid/shun/turn away from/dodge) (d:keep away from, turn aside from; {pel loin}, without avoiding, means without fail or surely) (s:peel/pelh/kipelh) (q:draft)
Pelaiah = (i:1) (t:name) (c:male) (w:Pelaiah) (d:name of two men: a descendant of David, son of Elioenai, and a Levite who explained the Law and sealed the covenant in the time of Nehemiah) (r:13.3.24/16.10.10)
Pelaih = (i:1) (t:name) (c:male) (w:Pelaliah) (d:priest in the ancestry of Adaiah, who served in the temple after the exile; the spelling <Pelaliah> is also used) (r:16.11.12)
Pelaliah = (i:1) (t:name) (c:male) (w:Pelaliah) (d:priest in the ancestry of Adaiah, who served in the temple after the exile) (r:16.11.12)
Pelatiah = (i:1) (t:name) (c:male) (w:Pelatiah) (d:name of several men, among them a grandson of Zerubbabel, a leader of the Simeonites who went to Seir, and a leader who sealed the covenant with Nehemiah) (r:13.3.21/16.10.22)
Pelatiahte = (i:1) (t:name) (c:male) (w:Pelatiah) (d:Pelatiah son of Benaiah, a leader of the people seen by Ezekiel at the temple gate; the plural <te> joins him with Jaazaniah, named just before) (b:Pelatiah) (r:26.11.1)
Peleg = (i:1) (t:name) (c:male) (w:Peleg) (d:son of Eber and father of Reu, a descendant of Shem in whose time the earth was divided) (r:1.11.18)
pelem = (i:1) (t:v) (w:be missing/be lacking/be lost) (d:be absent from a group or number, drop out or be lost; {pelem lo} is not missing, and {pelem sak} is let someone be missing) (s:pelhem/peelhem) (r:40.5.30) (q:draft)
pelemsak = (i:1) (t:v) (w:let be missing/leave out) (d:<pelem>, be missing, with the causative <sak>: let someone be missing; {kuamah pelemsak kei un} is see that no one is missing) (b:pelem) (q:draft)
Pelet = (i:1) (t:name) (c:male) (w:Pelet) (d:name of two men: a son of Jahdai in the family of Caleb of Judah, and a son of Azmaveth, a warrior of Benjamin who joined David at Ziklag) (r:13.2.47) (q:draft)
Peleth = (i:1) (t:name) (c:male) (w:Peleth) (d:name of two men, a descendant of Jerahmeel of Judah and the father of On of Reuben; {Peleth mite} are the Pelethites, the bodyguard of David led by Benaiah) (r:13.2.33)
pelh = (i:1) (t:v) (w:avoid/shun/keep away from/escape) (d:keep away from something bad or dangerous, or get out of its way; {siatna pelh} is shun evil) (s:pel/peel/kipelh) (q:draft)
pelh = (i:2) (t:v) (w:break/go back on/revoke/fail) (d:fail to keep a promise or covenant; with a negative, {pelh lo}, without fail or unfailingly) (s:palsat/peel) (q:draft)
pelhem = (i:1) (t:v) (w:be missing/be lacking) (d:be absent from a counted number; also written <peelhem>) (s:pelem/peelhem) (q:draft)
pelhin = (i:1) (t:v) (w:avoiding/escaping/turning away from) (d:<pelh>, avoid, with the linking ending <in>: avoiding or turning away from something, followed by what is done next) (s:pelin/peelin) (b:pelh) (q:draft)
pelhin = (i:2) (t:v) (w:breaking/violating) (d:going back on a covenant or promise) (b:pelh) (q:draft)
pelhna = (i:1) (t:n) (w:avoiding/shunning) (d:<pelh>, avoid, with the noun ending <na>: the act of keeping away from something) (s:kipelhna) (b:pelh) (q:draft)
pelhna = (i:2) (t:n) (w:breaking/breach) (d:going back on a covenant or promise) (b:pelh) (q:draft)
pelhsak = (i:1) (t:v) (w:cause to avoid/keep away) (d:<pelh>, avoid, with the causative <sak>: make someone keep away from another) (b:pelh) (q:draft)
pelhthei = (i:1) (t:v) (w:be able to escape/can avoid/elude) (d:<pelh>, avoid or escape, with <thei>, be able) (s:pengthei/suahtakzo) (b:pelh) (q:draft)
pelhzah = (i:1) (t:v) (w:break) (d:<pelh>, go back on a covenant, with <zah>, to the extent of: so far as to break it) (q:draft, low confidence)
pelin = (i:1) (t:v) (w:avoiding/shunning) (d:<pel>, avoid, with the linking ending <in>: keeping out of the way of someone) (s:pelhin/peelin) (b:pel) (q:draft)
pelmawh = (i:1) (t:adv) (w:surely/certainly/without fail) (d:placed after a verb, usually before <ding>: the thing will happen without fail and cannot be avoided) (s:hamtang/takpi) (q:draft)
Pelon = (i:1) (t:name) (c:city) (w:Pelon) (d:home of Helez and Ahijah, two of the mighty warriors of David, who are called Pelonites in the NIV) (r:13.11.27/13.11.36)
Pelusium = (i:1) (t:name) (c:city) (w:Pelusium) (d:fortress city on the eastern edge of the Nile delta, called the stronghold of Egypt by Ezekiel) (r:26.30.15/26.30.16)
pempam = (i:1) (t:adv) (w:brightly/radiantly) (d:describes a bright glow, after <taang> shine or <san> be red: shining all around, a face flushed red) (s:heuhau) (q:draft, low confidence)
pemtate = (i:1) (t:n) (w:foreigners/sojourners/strangers) (d:<pemta>, a person who has moved in from elsewhere and lives among another people, with the plural <te>; paired with <khualmite>) (s:peemtate/khualmite/peemte) (q:draft)
pen = (i:1) (t:ppm) (w:is) (d:marker placed after a noun or phrase to single it out as the topic of the sentence, the thing that is being spoken about; usually left untranslated) postpositional marker to indicate objective case
Pen = (i:1) (t:part) (w:most) (d:superlative marker placed after a describing word, written with a capital in titles of God such as {Sang Pen Pasian}, God Most High) (b:pen) (r:44.7.48) (q:draft)
pena = (i:1) (t:part) (d:<pen>, the marker of the superlative, most, with <a>: as the most; {a thutang pena kineite}, those counted the most upright) (q:draft, low confidence)
penah = (i:1) (t:ppm) (d:<pen>, marking the highest degree, with the place marker <ah>: at or in the most, as in {a tawpna penah}, last of all, and {lei hoihna penah}, in the best of the land) (b:pen) (q:draft)
peng = (i:1) (t:v) (w:be exempt/be free from/escape) (d:be clear of a duty, guilt or punishment; {nasep a peng} is to be off duty) (s:suakta) (q:draft)
pengin = (i:1) (t:v) (w:being exempt/being off duty) (d:<peng>, be free of a duty, with the linking ending <in>) (b:peng) (q:draft)
pengkul = (i:1) (t:n) (w:trumpet/horn) (d:a horn or trumpet blown as a signal or in worship; another spelling of <peengkul>) (s:peengkul/peengkhul) (q:draft)
Pengkulte = (i:1) (t:n) (w:trumpets) (d:<pengkul> trumpet, also written <peengkul>, with plural <te>) (s:peengkulte) (q:draft)
pengpelep = (i:1) (t:n) (c:animal) (w:night hawk/screech owl) (d:an unclean bird in the food laws, in the place where English versions have night hawk or screech owl) (r:5.14.15) (q:draft, low confidence)
pengsak = (i:1) (t:v) (w:deliver/spare/keep safe) (d:<peng>, be free from, with the causative <sak>: make someone escape harm, or get a burden free) (s:suaktasak/honkhia) (b:peng) (q:draft)
pengthei = (i:1) (t:v) (w:be able to escape/be exempt) (d:<peng>, be free from or escape, with <thei>, can) (s:pelhthei/suahtakzo) (b:peng) (q:draft)
Peniel = (i:1) (t:name) (c:land) (w:Peniel) (d:place by the Jabbok where Jacob wrestled with God and saw him face to face; the name means face of God, and it is also spelled <Penuel>) (r:1.32.30/1.32.31)
penin = (i:1) (t:part) (d:<pen>, most, with the ending {-in}, after a descriptive word: as the most, in the first or last place; {a masa penin}, first; {a nunung penin}, last) (q:draft)
Peninnah = (i:1) (t:name) (c:female) (w:Peninnah) (d:one of the two wives of Elkanah, who had children and provoked the childless Hannah) (r:9.1.2/9.1.4)
penna = (i:1) (t:part) (d:<pen>, most, with the ending {-na}: follows a describing word to mark the highest degree, as in {a gamla penna mun}, the farthest place) (q:draft, low confidence)
penpa = (i:1) (t:part) (d:<pen> marks the highest degree and <pa> a man: placed after a describing word it names the man who is most so, as {masa penpa} the first one, {lian penpa} the greatest one) (q:draft)
Penpa = (i:1) (t:n) (d:the one who is most, <pen> most with <pa> marking a male person; {Sang Penpa} is the Most High, a title of God) (b:Pen) (q:draft)
penpen = (i:1) (t:part) (w:the very most) (d:doubled <pen>, most, placed after a descriptive word for a strong superlative: the very best, the worst ever) (q:draft)
penpen = (i:2) (t:part) (d:placed after a verb phrase: whichever one, the very one that) (q:draft, low confidence)
penpente = (i:1) (t:part) (d:<penpen>, the very most, with the plural <te>, placed after a descriptive word: those who are the very strongest, wisest and so on) (b:penpen) (q:draft)
pente = (i:1) (t:part) (w:most) (d:superlative marker <pen> with the plural <te>, placed after a describing word, the most or the best ones) (b:pen) (r:1.27.15) (q:draft)
Pentekos = (i:1) (t:name) (w:Pentecost) (d:Jewish harvest feast held fifty days after Passover, the day on which the Holy Spirit came upon the believers in Jerusalem) (r:44.2.1/46.16.8)
Pentekost = (i:1) (t:name) (w:Pentecost) (d:spelling of <Pentekos> with a final t: the feast held fifty days after Passover, the day on which the Holy Spirit came upon the believers) (r:46.16.8/44.2.1)
penteng = (i:1) (t:part) (d:the superlative word <pen>, most, with <teng>, all: all of the most, as in {a limci penteng}, all the best) (q:draft, low confidence)
Penuel = (i:1) (t:name) (c:place/male) (w:Penuel) (d:town east of the Jordan whose tower Gideon tore down, the same place as Peniel; also the name of two men, a descendant of Judah and a son of Shashak of Benjamin) (r:7.8.8/13.8.25)
Peor = (i:1) (t:name) (c:mountain) (w:Peor) (d:mountain in Moab to whose top Balak took Balaam; also the place where Israel joined in the worship of the Baal of Peor) (r:4.23.28)
Perazim = (i:1) (t:name) (c:mountain) (w:Perazim) (d:mountain where the Lord broke out against the Philistines for David, the place also called Baal Perazim; found in {Perazim Mual}, Mount Perazim) (r:23.28.21) (q:draft)
Pere = (i:1) (t:name) (c:people) (w:Perizzite) (d:spelling of the name of the Perizzites in {Pere mite}, one of the peoples who lived in Canaan before Israel) (q:draft)
Peresh = (i:1) (t:name) (c:male) (w:Peresh) (d:son of Makir and Maakah in the tribe of Manasseh, brother of Sheresh) (r:13.7.16)
Perez = (i:1) (t:name) (c:land) (w:Rephaim)
Perez = (i:2) (t:name) (c:land/people) (w:Perizzites) (d:in {Perez mite}, the Perizzites, one of the peoples who lived in Canaan before Israel) (r:1.15.20)
Perez-uzza = (i:1) (t:name) (c:place) (w:Perez Uzzah) (d:place on the way to Jerusalem where Uzzah died after touching the ark; the name means outbreak against Uzzah) (q:draft)
Perez-uzzah = (i:1) (t:name) (c:place) (w:Perez Uzzah) (d:place on the way to Jerusalem where Uzzah died after touching the ark; the name means outbreak against Uzzah) (q:draft)
Perezuzza = (i:1) (t:name) (c:place) (w:Perez Uzzah) (d:spelling of <Perez-uzza> without the hyphen: the place where Uzzah died after touching the ark) (q:draft)
Perezuzzah = (i:1) (t:name) (c:place) (w:Perez Uzzah) (d:spelling of <Perez-uzzah> without the hyphen: the place where Uzzah died after touching the ark) (r:10.6.8)
Perga = (i:1) (t:name) (c:city) (w:Perga) (d:city in Pamphylia in Asia Minor, visited by Paul and Barnabas on their first journey, where John Mark left them) (r:44.14.25/44.13.14)
Pergamum = (i:1) (t:name) (c:city) (w:Pergamum) (d:city in Asia Minor, home of one of the seven churches addressed in Revelation) (r:66.2.12/66.1.11)
Perida = (i:1) (t:name) (c:male) (w:Perida) (d:head of a family of the servants of Solomon whose descendants returned from the exile; called Peruda in Ezra) (r:16.7.57)
Persia = (i:1) (t:name) (c:land) (w:Persia) (d:land and empire east of Babylonia, ruled by kings such as Cyrus and Darius, under whom the Jews returned from exile) (r:27.8.20/15.1.8)
Persian = (i:1) (t:name) (c:land) (w:Persian)
Persian = (i:2) (t:name) (c:people) (w:Persian) (d:a person of Persia, as Cyrus the Persian)
Persiate = (i:1) (t:name) (c:people) (w:Persians) (d:the people of Persia, usually named together with the Medes in {Mediate leh Persiate}, the Medes and Persians) (b:Persia) (r:27.6.15/27.5.28)
Persis = (i:1) (t:name) (c:female) (w:Persis) (d:Christian woman in Rome greeted by Paul, who had worked very hard in the Lord) (r:45.16.12)
Peruda = (i:1) (t:name) (c:male) (w:Peruda) (d:head of a family of the servants of Solomon whose descendants returned from the exile; called Perida in Nehemiah) (r:15.2.55)
pet = (i:1) (t:v) (w:bite/gnaw/sting) (d:bite, said of animals and insects; also of gnawing pain) (s:tuk) (r:5.32.24) (q:draft)
Peter = (i:1) (t:name) (c:male) (w:Peter) (d:Simon Peter, a fisherman from Bethsaida and brother of Andrew, one of the twelve apostles of Jesus and a leader of the first church) (r:40.10.2/43.18.27)
petgawp = (i:1) (t:v) (w:maul/tear/ravage) (d:<pet>, bite, with <gawp>, violently and all over) (s:balgawp) (b:pet) (q:draft)
Pethahiah = (i:1) (t:name) (c:male) (w:Pethahiah) (d:name of several men: the priest who headed the nineteenth division, a Levite who had married a foreign wife, and a man of Judah who was the agent of the king of Persia) (r:13.24.16/15.10.23)
Pethor = (i:1) (t:name) (c:city) (w:Pethor) (d:town near the Euphrates in Mesopotamia, the home of Balaam son of Beor) (r:5.23.4/4.22.5)
Pethuel = (i:1) (t:name) (c:male) (w:Pethuel) (d:father of the prophet Joel) (r:29.1.1)
petin = (i:1) (t:v) (w:biting) (d:<pet>, bite, with the linking ending <in>: biting, or holding something in the mouth or beak) (b:pet) (q:draft)
petin = (i:2) (t:adv) (d:in {tu pet petin}, at this very moment, now at last; <pet> marks the exact time) (q:draft, low confidence)
