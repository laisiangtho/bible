lamkikna = (i:1) (t:n) (w:rebuilding/restoration) (d:<lamkik> with the noun suffix <na>) (s:kilamkikna/puahkikna) (a:suksiatna) (b:lamkik) (q:draft)
lamkikpa = (i:1) (t:n) (w:rebuilder/one who rebuilds) (d:<lamkik>, rebuild, with <pa>, which marks a man: the man who rebuilds something) (b:lamkik) (q:draft)
lamkippa = (i:1) (t:n) (w:builder/one who establishes) (d:<lam>, build, and <kip>, firm, with <pa>, which marks a man: the one who builds up firmly, said of God as the Builder of Zion) (s:lampa) (q:draft, low confidence)
lamlah = (i:1) (t:v) (w:guide/counsel/direct) (d:show the way, give guidance or advice; the form of <lamlak> used before <na>, <ding> and <nading>; {lamlah khial} is to lead astray) (s:lamkaih/makaih) (q:draft)
lamlahna = (i:1) (t:n) (w:guidance/direction/counsel) (d:a showing of the way: <lam> way, <lah> show, with {-na}; {Topa tung panin lamlahna dong} is to inquire of the Lord) (s:makaihna) (b:lamlah) (q:draft)
lamlahnate = (i:1) (t:n) (w:instructions/directions/guideposts) (d:<lamlahna>, guidance, with plural <te>; on a road, the signs that show the way) (s:vaikhaknate) (b:lamlahna) (q:draft)
lamlak = (i:1) (t:v) (w:guide/counsel/advise/direct) (d:show the way; {thu lamlak} is to give counsel and {thu lamlak pa} a counselor) (s:lamkaih/makaih) (a:lampialsak/lakkhial) (q:draft)
lamlakin = (i:1) (t:v) (w:guiding/directing/instructing) (d:<lamlak>, guide, with the linking ending <in>) (b:lamlak) (q:draft)
lamlakpa = (i:1) (t:n) (w:counselor/adviser) (d:<lam> way and <lak> show, with <pa> for a man, one who shows the way; {thu lamlakpa} is a counselor) (s:thulamlakpa/vaihawmpa) (b:lamlak) (q:draft)
lamlakte = (i:1) (t:n) (w:advisers/counselors/guides) (d:those who show the way, <lamlak> with plural {-te}; {thu lamlakte} are advisers) (s:thulamlakte) (b:lamlak) (q:draft)
lamlam = (i:1) (t:adv) (d:descriptive word placed after <kot>, circle around, for birds hovering round and round overhead) (q:draft, low confidence)
lamlian = (i:1) (t:n) (w:main road/highway/street) (d:<lam> road with <lian> big; contrasted with <lamneu>, a lane or small path) (s:lamlianpi/kongzing) (a:lamneu) (q:draft)
Lamlian = (i:1) (t:name) (c:place) (w:Lamlian/Highway) (d:the Highway, in {Kumpipa' Lamlian} the King's Highway, the main road through Edom and the Amorite land east of the Jordan) (r:4.20.17/4.21.22)
lamlianpi = (i:1) (t:n) (w:main road/highway/street) (d:<lamlian> main road, with <pi> big; set against <lamneu>, small path) (s:lamlian) (a:lamneu) (b:lamlian) (q:draft)
lamliante = (i:1) (t:n) (w:main roads/highways/roads) (d:<lamlian>, main road, with the plural <te>; set against <lamneute>, lanes) (a:lamneute) (b:lamlian) (q:draft)
lammat = (i:1) (t:v) (w:seize/compel/press into service) (d:<lam> way with <mat> seize: lay hold of a passer-by and force him to do something) (q:draft)
lammatin = (i:1) (t:v) (w:seizing/compelling) (d:<lammat> with the linking suffix <in>) (b:lammat) (q:draft)
lamna = (i:1) (t:n) (w:building/construction) (d:the act of building a house, altar or temple) (s:innlamna/kilamna) (b:lam) (q:draft)
lamna = (i:2) (t:n) (w:dancing/dance) (d:the act of dancing, as a sign of joy and in praise; another spelling of <laamna>) (s:laamna) (q:draft)
lamnal = (i:1) (t:n) (w:slippery path/slippery way) (d:<lam> way with <nal> slippery) (q:draft)
lamnasa = (i:1) (t:adj) (d:<lam>, build or set up, with the endings <na> and <sa>: where something has been built or pitched; {a puanbuk lamnasa leitang} is the ground where he had pitched his tent) (b:lamna) (q:draft)
lamnawl = (i:1) (t:n) (w:roadside/side of the road) (d:<lam>, road, with <nawl>, edge; {lamnawl lam tawnin pai} is to pass by along the far side of the road) (q:draft)
lamneu = (i:1) (t:n) (w:lane/alley/small path) (d:<lam>, road, with <neu>, small; set against <lamlian>, main road) (a:lamlian/lamlianpi) (q:draft)
lamneute = (i:1) (t:n) (w:lanes/small paths) (d:<lamneu>, small path, with the plural <te>; set against <lamliante>, main roads) (a:lamliante) (b:lamneu) (q:draft)
lamnop = (i:1) (t:v) (w:want to build/wish to build) (d:<lam> build with <nop>, the form of <nuam> want; {a lamnop khempeuh} is all that he wished to build) (q:draft)
lamnopna = (i:1) (t:n) (w:desire to build/will to build) (d:<lamnop> want to build, with the noun suffix <na>) (b:lamnop) (q:draft)
lamnu = (i:1) (t:n) (w:builder) (d:<lam> build, with <nu>, the woman who built) (b:lam) (q:draft)
lampa = (i:1) (t:n) (w:builder) (d:<lam>, build, with <pa>, which marks a man: the man who builds; {inn lampa} is the builder of a house) (s:lamkippa) (b:lam) (q:draft)
lampaina = (i:1) (t:n) (w:marching/journey/way) (d:<lampai>, walk or travel, with <na>: the act of walking, or the way someone goes) (s:khualzinna) (b:lampai) (q:draft)
lampang = (i:1) (t:n) (w:side) (d:the side lying in a given direction, as in {leilu lampang}, north side) (s:pang) (r:26.48.10) (q:draft)
lampangah = (i:1) (t:n) (w:on the side/at the side) (d:<lampang> side with the place marker <ah>; with a direction word, on the south side, on the north side) (b:lampang) (q:draft)
lampangte = (t:see) <lampangte-ah>
lampangte-ah = (i:1) (t:adv) (w:on the sides) (d:<lampang> side, with the plural <te> and <ah> at) (q:draft)
lampangteng = (i:1) (t:n) (w:whole side/all of the side) (d:<lampang>, side, with <teng>, all of: the whole area on that side) (s:lamteng) (b:lampang) (q:draft)
lampha = (i:1) (t:v) (w:rebuild/build up/restore) (d:build again what was ruined, from <lam>, build) (s:lamkik/puahkik/bawlpha) (a:susia/phel) (q:draft)
lamphei = (t:see) <lamphei-ah>
lamphei-ah = (i:1) (t:n) (w:on a level path/on level ground) (d:<lamphei>, a level or even road, with the place marker <ah>) (q:draft)
lampi = (i:1) (t:n) (w:way) (d:the way to a place, and the way of life a person follows) (s:lam/lamzin) (b:lam) (r:1.3.24)
lampi = (i:2) (t:n) (w:footpath/path) (b:lam)
Lampi = (i:1) (t:n) (w:way/road/path) (d:<lampi> written with a capital, mostly at the start of a sentence, also as a title, the Way as a name for the Christian faith, and in {Lampi Siangtho}, the Way of Holiness) (b:lampi) (r:23.35.8) (q:draft)
lampial = (i:1) (t:v) (w:stray/turn aside/go astray) (d:leave the right way, <lam> way with <pial> turn off) (s:pial/pialkhia/gammang) (q:draft)
lampial = (i:2) (t:adj) (w:perverse/warped/wayward) (d:having left the right way, said of a perverse generation) (q:draft)
lampialgawp = (i:1) (t:v) (w:be thrown off course/go wildly astray) (d:<lampial> leave the way, with <gawp> marking violent action; here of the heavenly bodies) (b:lampial) (q:draft)
lampialin = (i:1) (t:v) (w:turning aside/going astray) (d:<lampial> turn aside, stray, with the linking ending <in>) (s:pialin) (b:lampial) (q:draft)
lampialna = (i:1) (t:n) (w:straying/going astray/fall) (d:<lampial>, stray, with the noun suffix <na>: a leaving of the right way, a fall from where one stood) (s:pialna) (b:lampial) (q:draft)
lampialsak = (i:1) (t:v) (w:lead astray/mislead) (d:<lampial>, go astray, with <sak>, cause) (s:pialsak/lakkhial/khialsak) (a:lamlak) (b:lampial) (q:draft)
lampialte = (i:1) (t:n) (w:strays/those who go astray) (d:<lampial> stray, with the plural <te>; of sheep that have strayed, and of people who have left the right way) (s:pialte/pialkhiate) (b:lampial) (r:66.21.8) (q:draft)
lampidung = (i:1) (t:n) (w:along the path/roadside) (d:<lampi> road with <dung> length, the stretch along a road) (s:lamdung) (q:draft)
lampih = (i:1) (t:v) (w:build with/help build) (d:<lam> build, with <pih> together with) (b:lam) (q:draft)
lampite = (i:1) (t:n) (w:ways/paths/roads) (d:<lampi>, way, with the plural <te>: roads and paths, also the ways of God, the conduct he asks for) (b:lampi) (r:23.41.3) (q:draft)
lampiteng = (i:1) (t:n) (w:the same way/the whole way) (d:<lampi> way with <teng>, all of it; {a tot lampiteng} is the way by which he came) (b:lampi) (q:draft, low confidence)
lamsa = (i:1) (t:adj) (w:built) (d:<lam> build with <sa>, already done: that someone has built, placed after the builder and before the thing built) (s:kilamsa) (q:draft)
lamsak = (i:1) (t:v) (w:build for) (d:<lam>, build, with <sak>: build something for someone) (r:42.7.5) (q:draft)
lamsakkik = (i:1) (t:v) (w:rebuild/have rebuilt) (d:<lamsak> with <kik>, again: have something built again, let it be rebuilt) (s:lamkik) (b:lamsak) (q:draft)
lamsang = (i:1) (t:n) (w:side/direction/respect) (d:with <ah>, on the side of, in the matter of, with regard to) (q:draft)
lamsangah = (i:1) (t:prep) (w:as regards/concerning/in respect of/according to) (d:<lamsang>, side or aspect, with <ah>; after a noun it means in the matter of) (s:tungtangah) (b:lamsang) (q:draft)
lamsate = (i:1) (t:n) (w:things built/buildings) (d:<lamsa> built, with the plural <te>: what someone has built) (b:lamsa) (q:draft)
lamtak = (i:1) (t:conj) (w:will be/that) (d:<lam> with <tak>, truly: placed after a clause and before <thei> or <phawk>, know, it marks what is known as a sure fact, as in {Topa ka hih lamtak}, that I am the Lord)
lamte = (i:1) (t:n) (w:builders) (d:those who build, <lam>, build, with the plural <te>; {inn lamte} are the builders of a house) (s:innlamte) (b:lam) (q:draft)
lamte = (i:2) (t:n) (w:possessions/belongings) (d:in {a neih a lamte}, what one has and owns) (s:neihsate) (q:draft, low confidence)
lamteng = (i:1) (t:n) (w:whole side/all the part toward) (d:<lam> side, direction, with <teng> all: the whole of the side that is named) (s:lampangteng) (b:lam) (q:draft)
lamteng = (i:2) (t:n) (w:possessions/goods) (d:in {a neih a lamteng}, all that one owns, property and goods) (s:neihsate) (q:draft, low confidence)
lamthuah = (i:1) (t:v) (w:build more/build in addition) (d:<lam> build, with <thuah> add) (q:draft, low confidence)
lamto = (i:1) (t:v) (w:lift up/raise) (d:lift something upward, said of raising the hand and of raising a person up from a low place) (s:domto/laamto) (q:draft)
lamun = (i:1) (t:adv) (d:<lam> way, direction, with <un>, the ending <in> as used with a plural subject: in the direction of, in the course of; {a nung leh lamun} is backwards, {an a zonna lamun} is while they looked for food) (b:lam) (q:draft, low confidence)
lamval = (i:1) (t:n) (w:surplus/abundance) (d:paired with <neihval>, what one has over and above one's need) (s:neihval) (q:draft, low confidence)
lamzan = (i:1) (t:v) (w:succeed/prosper) (d:go well on one's way, written with a final apostrophe before <theih>) (s:lawhcing) (q:draft)
lamzin = (i:1) (t:n) (w:path/way) (d:the road one travels, <lam>, road, with <zin>, travel; here set beside <lampi>) (s:lampi) (q:draft)
lamzingte = (i:1) (t:n) (w:streets) (d:the streets of a town, where people pass and gather) (s:kongzingte) (q:draft)
lamzo = (i:1) (t:v) (w:be able to build) (d:<lam> build, with <zo> be able) (b:lam) (q:draft)
lan = (i:1) (t:n) (w:banner/flag/signal) (d:a flag raised as a signal) (s:dial/dialkhai) (q:draft)
lan = (i:2) (t:adj) (w:lustful/oversexed) (d:of strong sexual desire, said of men and of a stallion; the NIV speaks of large genitals here) (q:draft, low confidence)
lang = (i:1) (t:n) (w:half) (d:one of the two equal parts of a thing; {a lang} is half of it) (s:alang/phelkhat) (q:draft)
lang = (i:2) (t:n) (w:side/opposing side) (d:one of two sides; {lang pang} is to take the side against someone, and {lang khatah} is against) (s:pang) (r:2.20.16) (q:draft)
langa = (i:1) (t:prep) (w:against/on the side opposite) (d:<lang> side with <a>; {langa pang} is to take a stand against someone) (s:langah/langkhatah) (b:lang) (q:draft)
langah = (i:1) (t:prep) (w:against) (d:on the opposing side of, after a possessive as in {ka langah} against me) (s:langkhatah/langpangin) (b:lang) (q:draft)
langaih = (i:1) (t:n) (w:melody/music/sweet song) (d:pleasing song, <la>, song, with <ngaih>, lovely; {langaih sa} is to make music) (q:draft)
langbawl = (i:1) (t:v) (w:turn against/oppose/be hostile to) (d:<lang> side with <bawl> make: set oneself against someone) (s:langpang/galbawl/langneih) (b:lang) (q:draft)
langbawlna = (i:1) (t:n) (w:opposition/hostility) (d:<langbawl> turn against, with the noun suffix <na>; in Proverbs 28:21 {mi langbawlna} is taking sides between people, partiality) (s:langpanna/kilangbawlna) (b:langbawl) (q:draft)
langgen = (i:1) (t:v) (w:show partiality/take the side of/favor) (d:<lang>, side, with <gen>, speak: speak for one side in a judgment) (s:angvan) (q:draft)
langkhat = (i:1) (t:n) (w:one side/other side/half) (d:one of two sides or of a pair, as in {khut langkhat}, one hand, and {gam langkhat}, half the kingdom) (q:draft)
langkhatah = (i:1) (t:prep) (w:against) (d:on the opposite side; {langkhatah pang} is stand against, {langkhatah teci pang} is testify against) (s:langah/langpangin) (r:23.14.22) (q:draft)
langkhiasak = (i:1) (t:v) (w:display/make known/reveal) (d:<lang>, appear, with <khia>, out, and <sak>, cause: bring something out into open view) (s:langsak/kilangsak) (q:draft)
langmuh = (t:see) <langmuh-a>
langmuh-a = (i:1) (t:adv) (w:with partiality/taking sides) (d:<lang> side and <muh> see, with <a>: looking to one side, showing favour) (q:draft)
langneih = (i:1) (t:v) (w:be against/oppose/take sides) (d:<lang> side with <neih> have: take a side about someone, mostly against; {na langneih mite} is your enemies; in Exodus 23:3 of taking sides over a poor man in a lawsuit) (s:langbawl) (q:draft, low confidence)
langnih = (i:1) (t:n) (w:both sides/two sides) (d:<lang>, side, with <nih>, two; {langnih a hiam} is sharp on both sides, double-edged; of a pair, as feet or parties, it means both) (q:draft)
langnihin = (i:1) (t:adv) (w:on both sides/both) (d:<langnih>, both sides, with <in>; of a sword, double-edged; of feet, both) (b:langnih) (q:draft)
langpa = (i:1) (t:n) (w:opponent/other party/adversary) (d:<lang>, opposing side, with <pa>, which marks a man: the man on the other side) (s:galpa) (b:lang) (q:draft)
langpan = (i:1) (t:v) (w:oppose/rise against/rebel against) (d:form of <langpang>, written {langpan’} before a following word) (s:langbawl/galbawl/lehdo) (q:draft)
langpang = (i:1) (t:v) (w:oppose/resist/rebel against) (d:take a stand against someone, <lang>, side, with <pang>, stand; the one opposed comes directly before it) (s:langbawl/galbawl/lehdo) (a:panpih) (q:draft)
langpang = (i:2) (t:n) (w:adversary/opponent) (d:one who stands against another, an opponent or enemy) (s:galpa/langpa) (q:draft)
langpanga = (i:1) (t:adv) (w:against/in opposition to) (d:<langpang> oppose, with <a>) (b:langpang) (q:draft)
langpangin = (i:1) (t:prep) (w:against) (d:<langpang>, oppose, with the linking suffix <in>; opposing, in opposition to) (s:langah/langkhatah) (b:langpang) (q:draft)
langpangte = (i:1) (t:n) (w:foes/adversaries/enemies/opponents) (d:<langpang>, oppose, with the plural <te>: those who stand against someone) (s:galte/demte) (a:lawmte) (b:langpang) (q:draft)
langpanin = (i:1) (t:v) (w:opposing/against/defying) (d:form of <langpan> with {-in}; after its object it can be translated against) (b:langpan) (q:draft)
langpanna = (i:1) (t:n) (w:opposition/rebellion/protest) (d:<langpan>, oppose, with the noun suffix <na>: the act of standing against someone, rebellion against God) (s:langbawlna/lehdona) (b:langpan) (q:draft)
langsak = (i:1) (t:v) (w:reveal/show/make known/bring to light) (d:cause to appear or be seen openly) (s:kilangsak/pulak) (a:seel) (r:55.1.10) (q:draft)
langsakin = (i:1) (t:v) (w:showing/revealing/making known) (d:<langsak> make known with the linking ending <in>; {a dikna langsakin} is showing him to be in the right) (s:theisakin) (b:langsak) (q:draft)
langsakkik = (i:1) (t:v) (w:show again/renew) (d:<langsak>, show, with <kik>, again: show once more, renew, as of concern for someone shown again after a long time) (b:langsak) (q:draft)
langsakpa = (i:1) (t:n) (w:vindicator/one who reveals) (d:<langsak>, show, with <pa>, the man who does it; {ka thumanna a langsakpa} is he who shows that I am in the right, my vindicator) (b:langsak) (q:draft)
langsakpah = (i:1) (t:v) (w:show at once/reveal immediately) (d:<langsak>, show, with <pah>, at once: let something be seen immediately) (q:draft)
langsakta = (i:1) (t:v) (w:have revealed/have shown) (d:<langsak>, show, with <ta> marking a state now reached: has now shown or revealed) (b:langsak) (q:draft)
langtang = (t:see) <langtang-a>
langtang-a = (i:1) (t:adv) (w:openly/in the open) (d:in an open way, not hidden; {a langtang-a taina} is open rebuke) (s:langtangin/kilangin) (a:simthamin/thusimin) (q:draft)
langtangin = (i:1) (t:adv) (w:openly/publicly/plainly) (d:<langtang>, open, with the ending <in>, used as {a langtangin}: openly, in plain view, without hiding) (s:langtang-a/kilangin) (a:simthamin/thusimin) (q:draft)
langte = (i:1) (t:n) (w:half) (d:one side or half of a group, as in {Manasseh minam a langte}, the half-tribe of Manasseh) (s:alangte) (b:lang) (q:draft)
langte = (i:2) (t:n) (w:enemies/foes/adversaries) (d:<lang>, opposing side, with the plural <te>: those on the other side, enemies) (s:galte/langpangte/mudahte/dote) (a:lawmte) (b:lang) (q:draft)
langtuakah = (i:1) (t:adv) (w:on each side/on both sides/on each) (d:<lang>, side, with <tuak>, each, and <ah>, at: on each of the two sides, as in {a khut langtuakah}, on each of his hands) (s:langnihin) (q:draft)
langva = (t:todo) (q:draft, part of a measure of oil in Luke 16:6, {sathau langva phel zakhat}, the meaning of {langva} alone is not clear)
lanlan = (i:1) (t:adv) (d:descriptive word placed after <pai>, walk, for the stately walk of a king before his people, beside <kuahkuah> for the rooster and <gangan> for the he-goat) (q:draft, low confidence)
lanluat = (i:1) (t:n) (w:lewdness/debauchery/excessive lust) (d:<lan>, lustful, with <luat>, too much: shameless excess in sexual behaviour; {lanluat khialhna} is a lewd offence) (s:lanna/hukna/thangtatna) (q:draft)
lanluatna = (i:1) (t:n) (w:lewdness/outrageous act) (d:<lanluat> with the noun suffix <na>) (s:lanna/hukna) (b:lanluat) (q:draft)
lanna = (i:1) (t:n) (w:lewdness/debauchery/lust) (d:<lan>, lustful, with the noun suffix <na>: shameless sexual behaviour, often paired with <hukna>) (s:hukna/lanluat/thangtatna) (b:lan) (q:draft)
lannate = (i:1) (t:n) (w:lewd acts/debauchery) (d:plural of <lanna>) (s:huknate) (b:lanna) (q:draft)
lano = (i:1) (t:n) (c:animal) (w:colt/young donkey/foal) (d:the young of a donkey: <la>, donkey, with <no>, young or little) (s:laano) (b:la) (q:draft)
Lano = (i:1) (t:n) (c:animal) (w:colt/young donkey) (d:<lano>, colt, written with a capital at the start of a sentence or a line of verse) (b:lano) (q:draft)
lante = (i:1) (t:n) (w:banners/flags) (d:<lan> banner with the plural <te>) (s:dialte/dialkhaite) (b:lan) (q:draft)
lante = (i:2) (t:n) (w:lusty ones) (d:<lan>, lustful, with the plural <te>; {sakol gilvah a lante} are well-fed, lusty stallions) (q:draft, low confidence)
lanu = (i:1) (t:n) (c:animal) (w:female donkey) (d:<la> donkey, with <nu> female) (s:lapi) (a:latal) (q:draft)
Laodikia = (i:1) (t:name) (c:city) (w:Laodicea) (d:city in the Lycus valley of Asia Minor near Colossae and Hierapolis, home of one of the seven churches of Revelation) (r:51.4.15/51.4.16)
Laodisia = (i:1) (t:name) (c:city) (w:Laodicea) (d:city in the Lycus valley of Asia Minor near Colossae and Hierapolis, home of one of the seven churches of Revelation) (r:51.4.15/51.4.16)
lap = (i:1) (t:v) (w:overtake/catch up with) (d:catch up with and come upon someone, as darkness overtaking a traveller) (q:draft, low confidence)
lapa = (i:1) (t:n) (w:one who takes/gatherer/taker) (d:<la>, take, with <pa>: the man who takes or gathers something, as {an lapa}, one who gathers food, and {thuciamna a lapa}, one who takes an oath) (b:la) (r:26.18.16) (q:draft)
laphuah = (i:1) (t:v) (w:compose songs/write poetry) (d:<la>, song, with <phuah>, compose; {laphuah siampa} is a poet, and {ama laphuah} is the songs he composed) (s:laphuak) (q:draft)
laphuak = (i:1) (t:v) (w:compose songs) (d:<la> song with <phuak> compose; {laphuak siampa} is a skilled maker of songs) (s:laphuah) (q:draft, low confidence)
lapi = (i:1) (t:n) (c:animal) (w:female donkey) (d:<la> donkey with <pi> female; the male is <latal>) (s:lanu) (a:latal) (q:draft)
Lapi = (i:1) (t:n) (c:animal) (w:donkey/female donkey) (d:{Lapi’ ta lano} is the foal of a donkey) (b:lapi) (q:draft)
laplap = (i:1) (t:adv) (w:more and more) (d:after a verb, apparently of something that keeps piling up; the sense is not certain from one verse) (q:draft, low confidence)
lapna = (i:1) (t:n) (w:raising/lifting) (d:<lap> raise, with the noun suffix <na>; {khut lapna} is the lifting of the hand) (s:laptohna) (q:draft, low confidence)
lapnuam = (i:1) (t:v) (w:want to reach in time/want to be in time for) (d:<lap> catch up with, with <nuam> want) (q:draft)
Lappidoth = (i:1) (t:name) (c:male) (w:Lappidoth) (d:husband of the prophetess Deborah) (r:7.4.4)
laptoh = (i:1) (t:v) (w:lift up/raise up) (d:<lap>, raise, with <toh>, upward: lift a person up, raise to honour) (s:domto/phongto/sangsak) (a:niamsak) (q:draft)
laptohna = (i:1) (t:n) (w:lifting up/raising) (d:<laptoh>, lift up, with <na>) (s:lapna) (b:laptoh) (q:draft)
lasa = (i:1) (t:n) (w:singer) (d:person who sings, especially one appointed to sing; {lasa pawl} is a group of singers) (s:lasiam) (q:draft)
lasak = (i:1) (t:v) (w:have brought/send for/let take) (d:<la>, take, with the causative <sak>: have something or someone fetched, or let someone take a thing) (r:17.6.8) (q:draft)
lasak = (i:2) (t:v) (w:sing) (d:<la>, song, and <sak>, sing: sing a song; also the act of singing, as in {lasak hun}, the time of singing) (s:lasa) (q:draft)
lasakin = (i:1) (t:v) (w:having brought/letting fetch) (d:<lasak> have something brought, with the linking suffix <in>) (b:lasak) (q:draft)
lasakna = (i:1) (t:n) (w:instrument/music/musical instrument/singing) (d:<lasak>, sing, with the noun suffix <na>: singing or music, and an instrument for making music; it follows the name of an instrument, as {harp lasakna}, the harp, and {laiza lasakna}, the lyre) (s:tumtheih) (b:lasak)
lasaknate = (i:1) (t:n) (w:musical instruments/instruments) (d:<lasakna>, instrument, with the plural <te>; often after the name of an instrument, as in {laiza lasaknate}, lyres) (s:tumtheihte) (b:lasakna) (r:14.20.28) (q:draft)
lasaknate = (i:2) (t:n) (w:songs/singing) (s:late) (b:lasakna) (q:draft, low confidence)
lasakolte = (i:1) (t:n) (c:animal) (w:mules) (d:<la> donkey and <sakol> horse, with the plural <te>) (q:draft)
lasate = (i:1) (t:n) (w:singers/musicians) (d:<lasa>, singer, with the plural <te>: the singers and musicians, especially those of the temple) (r:14.35.25) (q:draft)
Lasha = (i:1) (t:name) (c:land) (w:Lasha) (d:place on the border of the land of the Canaanites, named after Sodom, Gomorrah, Admah and Zeboyim) (r:1.10.19)
Lasharon = (i:1) (t:name) (c:place) (w:Lasharon) (d:Canaanite royal town whose king was defeated by Joshua) (r:6.12.18)
Lasia = (i:1) (t:name) (c:city) (w:Lasea) (d:town on the south coast of Crete near Fair Havens) (r:44.27.8) (q:draft)
lasiam = (i:1) (t:n) (w:singer/skilled singer) (d:<la>, song, with <siam>, skilled: one who is good at singing) (s:lasa) (q:draft)
