cipa = (i:2) (t:adv) (w:fast/tightly) (d:<cip>, tightly, joined to the linking <a>: {kikalh cipa a om} is being kept locked up) (b:cip) (q:draft, low confidence)
cipin = (i:1) (t:adv) (w:tightly/fast/firmly/for good) (d:placed after a verb: done tightly, held fast or left for good, and then the next action follows; <cip> with the linking suffix {-in}) (b:cip) (q:draft)
