kikhawm = (i:2) (t:n) (w:group) (s:pawl)
kikhawm = (i:3) (t:v) (w:attend church/gather for worship) (d:to go church)
kikhawmin = (i:1) (t:v) (w:gather/assemble/come together) (d:<kikhawm> with the linking ending {-in}: gathering, having assembled) (b:kikhawm) (q:draft)
