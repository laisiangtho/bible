luangsuk = (i:1) (t:v) (w:flow down/stream down) (d:<luang>, flow, with <suk>, downward: of water, flow down from a height or downstream to the sea) (b:luang) (q:draft)
luangsukin = (i:1) (t:v) (w:flow down) (d:<luangsuk> flow down with {-in}, linking it to the next verb) (b:luangsuk) (q:draft)
luangsukte = (i:1) (t:n) (w:those flowing down) (d:<luangsuk> flow down with the plural <te>: the waters that flow down) (b:luangsuk) (q:draft)
luangte = (i:1) (t:n) (w:bodies/corpses) (d:<luang>, dead body, with plural <te>) (s:siluangte/luanghawmte) (r:66.11.8) (q:draft)
luangte = (i:2) (t:adj) (w:flowing/running) (d:<luang>, flow, with plural <te>: those that flow, said of streams and rivers) (s:luanglai) (b:luang) (q:draft)
luanin = (i:1) (t:v) (w:flow) (d:<luan> flow with {-in}; {hawk luanin a luang} is flow in streams) (b:luan) (q:draft)
luankhiatna = (i:1) (t:n) (w:outflow/place of flowing out) (d:<luan> flow with <khiat> out and the noun suffix <na>: where something flows out) (q:draft)
luankik = (i:1) (t:v) (w:flow back) (d:<luan> flow with <kik> back, again) (s:luangkik) (b:luan) (q:draft)
luanna = (i:1) (t:n) (w:flowing/flow/shedding) (d:<luan>, flow, with the noun suffix <na>: the flowing of tears or blood, and the place where something flows, as in {bawngnawi le khuaizu a luanna gam}, the land flowing with milk and honey) (b:luan) (q:draft)
luannate = (i:1) (t:n) (w:flowing/shedding) (d:<luanna>, flowing, with the plural <te>; {khitui luannate} is the tears a person has shed) (b:luanna) (q:draft)
luantheihna = (i:1) (t:n) (w:being able to flow) (d:<luan> flow with <theih> can and the noun suffix <na>; with <ding>, so that it may flow) (q:draft)
luat = (i:1) (t:adv) (w:too/too much/so very) (d:form of <lua> used before <leh>, <manin>, {mah bangin} and <aw>) (b:lua) (q:draft)
luata = (i:1) (t:adv) (w:too/too much) (d:<lua> too, with <ta> marking a state that has now been reached) (b:lua) (q:draft)
luate = (i:1) (t:n) (d:<lua>, too or very, with plural {-te}; after a descriptive word it means those that are too much so, as in {a hat luate}, those who are too strong, and {a tom luate}, those that are too short) (b:lua) (q:draft, low confidence)
luatna = (i:1) (t:n) (w:excess/great intensity/zeal) (d:noun of <luat>, too much; after a feeling or action it names the great degree of it, as {heh luatna} great anger, {it luatna} great love or zeal) (b:luat) (r:20.25.27) (q:draft)
luatnate = (i:1) (t:n) (w:excess/great intensity) (d:<luatna> excess, with the plural <te>, after a verb: the great degree of it, as {hong mudah luatnate}, how greatly they hate me) (b:luatna) (r:47.12.21) (q:draft)
Lud = (i:1) (t:name) (c:male/people) (w:Ludim/Lud/Ludites) (d:name of a son of Shem, and of a people descended from Egypt, the Ludites; in the prophets {Lud mite} are archers, the men of Lydia) (r:1.10.13)
luguh = (i:1) (t:n) (w:skull) (d:<lu> head with <guh> bone) (q:draft)
luh = (i:1) (t:v) (w:raid/invade/break into/plunder) (d:enter a place by force to attack or rob it) (s:sut/buluh) (q:draft)
luha = (i:1) (t:v) (w:break in/raid) (d:<luh> break into with {-a}, linking it to the next verb: breaking in) (b:luh) (q:draft)
luhgawp = (i:1) (t:v) (w:plunder/pillage/raid) (d:<luh>, raid, with <gawp> marking a thorough or violent action) (s:sutgawp) (b:luh) (q:draft)
luhgawpin = (i:1) (t:v) (w:plunder/loot/raid) (d:<luhgawp> with the linking suffix <in>) (b:luhgawp) (q:draft)
luhgawpte = (i:1) (t:n) (w:plunderers/looters) (d:those who plunder, <luhgawp> with plural <te>) (b:luhgawp) (q:draft)
luhgawpzo = (i:1) (t:v) (w:plunder/be able to plunder) (d:<luhgawp> plunder with <zo>, be able or succeed) (b:luhgawp) (q:draft)
luhin = (i:1) (t:v) (w:raid/break into/invade/sack) (d:<luh> with {-in}, linking it to the next verb: raiding, having broken in) (b:luh) (r:28.11.6) (q:draft)
luhinna = (i:1) (t:n) (w:support/sustenance) (d:paired with <nuntakna> in the verse for what a people lives on, NIV supply and support; not the same as <luhin> raid) (q:draft, low confidence)
Luhith = (i:1) (t:name) (c:place) (w:Luhith) (d:place in Moab reached by an ascent, named with Horonaim in the laments over Moab) (r:24.48.5/23.15.5)
luhkhawm = (i:1) (t:v) (w:plunder together/raid together) (d:<luh> raid with <khawm> together) (b:luh) (q:draft)
luhkik = (i:1) (t:v) (w:raid again/invade again) (d:<luh> raid with <kik> again) (s:simkik) (b:luh) (q:draft)
luhna = (i:1) (t:n) (w:raid/attack/assault) (d:<luh> raid with the noun suffix <na>; {khuapi luhna ding} is for attacking the city) (b:luh) (q:draft)
luhngei = (i:1) (t:v) (w:have ever broken in) (d:<luh> break into with <ngei>, ever; negated in the verse: they never broke in) (q:draft)
luhsak = (i:1) (t:v) (w:plunder/raid/break into) (d:<luh> raid, break into, with <sak>; plunder a place that belongs to others, and in Luke 12:39 let a house be broken into) (b:luh) (q:draft)
luhzo = (i:1) (t:v) (w:capture/storm/break into) (d:<luh> raid with <zo>, be able: attack a stronghold and take it) (b:luh) (q:draft)
lui = (i:1) (t:n) (w:streamlet/brook/creek/stream) (d:a small river; also the valley in which it runs, as in {Kidron lui} and {Kherith lui}) (s:luitui)
Lui = (i:1) (t:n) (w:Wadi/stream/ravine/brook) (d:<lui>, stream, written with a capital as part of a place name or at the start of a sentence: {Izipt Lui} is the Wadi of Egypt and {Gialheek Lui} the Ravine of the Poplars) (b:lui) (q:draft)
luidung = (i:1) (t:n) (w:course of a stream/length of a stream) (d:<lui> stream with <dung> length: along the stream; NIV has the waters of En Shemesh) (q:draft, low confidence)
luihawm = (i:1) (t:n) (w:ravine/valley/stream bed) (d:the hollow in which a stream runs; <lui> stream with <hawm> hollow) (s:luitaw) (q:draft)
luiliante = (i:1) (t:n) (w:great rivers/mighty waters) (d:<lui> stream with <lian> great, plural) (q:draft)
luilui = (i:1) (t:v) (w:babble/keep on repeating) (d:say many empty words over and over) (q:draft, low confidence)
luimu = (i:1) (t:n) (c:animal) (w:osprey/vulture/falcon) (d:a large bird of prey that may not be eaten, <lui> is river and <mu> is a bird of prey, the English versions vary between osprey, black vulture and falcon) (r:3.11.13) (q:draft, low confidence)
luineu = (i:1) (t:n) (w:small stream/brook) (d:<lui> stream with <neu> small) (a:luipi) (q:draft)
luipi = (i:1) (t:n) (w:river/large stream/torrent) (d:<lui> stream with <pi> big; {Egypt luipi} is the Wadi of Egypt) (a:luineu) (b:lui) (q:draft)
Luipi = (i:1) (t:n) (w:river/wadi) (d:{Izipt Luipi} is the Wadi of Egypt) (b:luipi) (q:draft)
luisa = (i:1) (t:adj) (w:old/long-standing/outdated) (d:<lui> old with <sa>, which marks a state already reached; {a luisa} is what has grown old, and of a disease chronic) (a:thak) (b:lui) (q:draft)
luisak = (i:1) (t:v) (w:make old/make obsolete) (d:<lui> old, with the causative <sak>) (b:lui) (q:draft)
luisak = (i:2) (t:v) (w:set before/serve) (d:<lui>, set food before someone, with <sak>, let; {hong luisak in} is let me set it before you) (q:draft, low confidence)
luisate = (i:1) (t:n) (w:old things/former things) (d:plural of <luisa> old; {thu luisate} is the old order of things) (s:ngeisate) (b:luisa) (q:draft)
luisuak = (i:1) (t:v) (w:grow old/wear out) (d:<lui> old with <suak> become) (q:draft)
luitaw = (i:1) (t:n) (w:stream bed/valley) (d:<lui> stream with <taw>, bottom: the bed of a stream, a dry valley) (s:luihawm) (q:draft)
luite = (i:1) (t:n) (w:brooks/streams) (d:<lui>, stream, with the plural <te>) (s:luituite) (b:lui) (r:2.7.19)
Luite = (t:see) <Luite-ah>
Luite-ah = (i:1) (t:n) (w:streams/waters) (d:<lui> stream with plural <te> and the place marker <ah>, at the streams; {Neftoah Luite-ah} is at the waters of Nephtoah) (q:draft)
luiteng = (i:1) (t:adj) (w:old/all the old) (d:<lui> old with <teng>, all of; {i ngeina luiteng} is all our old way of life, NIV our old self) (b:lui) (q:draft, low confidence)
luitui = (i:1) (t:n) (w:stream/brook/stream water) (d:<lui> stream with <tui> water) (s:lui) (r:19.78.16) (q:draft)
luituite = (i:1) (t:n) (w:streams/brooks/springs) (d:<luitui> with plural {-te}, the running waters of streams) (s:luite) (b:luitui) (r:19.78.44) (q:draft)
luk = (i:1) (t:v) (w:have sex with) (d:in {taw luk}, of men forcing sexual intercourse on a man) (q:draft)
Luka = (i:1) (t:name) (c:male) (w:Luke) (d:the doctor, a companion and fellow worker of Paul; the third Gospel bears his name) (r:51.4.14)
lukham = (i:1) (t:n) (w:pillow/cushion) (d:what the head is laid on in sleep, from <lu>, head) (q:draft)
lukhamin = (i:1) (t:adv) (w:as a pillow/for a pillow) (d:<lukham> pillow, with the ending <in>: used as a pillow) (b:lukham) (q:draft)
lukhu = (i:1) (t:n) (w:crown/headdress/head covering) (d:a covering for the head; {kumpi lukhu} is a royal crown and {sik lukhu} a helmet) (r:49.6.17) (q:draft)
lukhung = (i:1) (t:n) (w:head of the bed/place by the head) (d:the spot at the head of a person who is lying down; {lukhung-a}, near his head) (q:draft)
lukhunga = (i:1) (t:adv) (w:at the head/near the head) (d:<lukhung>, the place by the head of one lying down, with the place marker {-a}) (s:lukhungah) (b:lukhung) (q:draft)
lukhungah = (i:1) (t:adv) (w:at the head/near the head) (d:<lukhung> with the place marker <ah>: at the head of a bed or of a person lying down) (s:lukhunga) (b:lukhung) (q:draft)
lukhute = (i:1) (t:n) (w:caps/headdresses/helmets) (d:plural of <lukhu>; {sik lukhute} are helmets) (b:lukhu) (q:draft)
Lukias = (i:1) (t:name) (c:male) (w:Lucius) (d:name of two men: Lucius of Cyrene, a teacher in the church at Antioch, and a companion of Paul who sends greetings in the letter to the Romans) (r:45.16.21/44.13.1)
lukolh = (i:1) (t:adj) (w:bald/bald-headed) (d:<lu> head with <kolh> bare; {lukolh pa} is baldhead, said in mockery) (s:tol/kolh) (q:draft)
lukolhpa = (i:1) (t:n) (w:baldhead/baldy) (d:<lukolh> bald-headed, with <pa> marking a man) (b:lukolh) (q:draft)
luktheih = (i:1) (t:v) (w:be able to have sex with) (d:<luk> with <theih> can; {ka luktheih nadingun} is so that we may have sex with him) (b:luk) (q:draft)
lulam = (i:1) (t:n) (w:bow/front/head end) (d:<lu> head with <lam>, side: the head end of a thing, the bow of a ship) (a:tawlam) (r:19.48.2) (q:draft)
lum = (i:1) (t:n) (w:shield) (d:a piece of armour carried on the arm to ward off blows; {lum lian} is a large shield and {lum neu} a small one, and God is called the shield of his people) (s:luum) (r:19.76.3) (q:draft)
lum = (i:2) (t:v) (w:lie down/lie/sleep) (d:lie down to rest or sleep, or lie in a place; {lum} with <tawh> or <kiangah>, of a man and a woman, is sleep with) (a:tho) (q:draft)
luma = (i:1) (t:v) (w:lie/lie down) (d:<lum> lie down with {-a}, linking it to the next verb: lying) (b:lum) (q:draft)
lumcip = (i:1) (t:v) (w:lie prostrate/be laid low) (d:<lum> lie down with <cip>, fast: lie helpless, overcome by distress) (b:lum) (q:draft, low confidence)
lumcipsak = (i:1) (t:v) (w:lay low/make lie prostrate) (d:<lumcip> lie prostrate with the causative <sak>: make someone lie down so as not to rise again) (b:lumcip) (q:draft)
lumgol = (i:1) (t:n) (w:large shield) (d:<lum> shield with <gol> big; contrasted with <lumneu> small shield) (s:lumpi) (a:lumneu) (q:draft)
lumin = (i:1) (t:v) (w:lying down/lying) (d:<lum> lie down with the linking suffix <in>) (b:lum) (q:draft)
lumkhawm = (i:1) (t:v) (w:sleep with/lie with/have sexual relations) (d:<lum>, lie down, with <khawm>, together: lie down together; of a man and a woman, have sexual relations) (s:lupkhawm/lupkhop) (b:lum) (q:draft)
lumkhawmin = (i:1) (t:v) (w:sleep with/lie with) (d:<lumkhawm> with the linking suffix <in>) (b:lumkhawm) (q:draft)
lumkhawmsa = (i:1) (t:adj) (w:having slept with) (d:<lumkhawm> lie with, with <sa> marking a completed act; before a noun, who has slept with someone) (b:lumkhawm) (r:28.3.1) (q:draft)
lumkhop = (i:1) (t:v) (w:be warm enough) (d:<lum> warm with <khop> enough; {a lumkhop ding} is enough to be warm) (q:draft)
lumkik = (i:1) (t:v) (w:lie down again/go back to sleep) (d:<lum> lie down with <kik> again) (b:lum) (q:draft)
lumlet = (i:1) (t:v) (w:overturn/overthrow/turn upside down) (d:turn something upside down: overturn a table or a dish, overthrow a city or a kingdom) (s:lawnthal) (q:draft)
lumlet = (i:2) (t:v) (w:pervert/distort/twist) (d:turn a message or a matter upside down so that it is no longer true; of a person, wrong him by deceit) (s:kawihei) (q:draft)
lumletgawp = (i:1) (t:v) (w:distort/pervert utterly) (d:<lumlet> turn upside down with <gawp>, which marks a thorough or violent action) (b:lumlet) (q:draft)
lumletin = (i:1) (t:v) (w:overturn/overthrow) (d:<lumlet> with the linking ending <in>: overturning) (b:lumlet) (q:draft)
lumletin = (i:2) (t:v) (w:distort/pervert/unsettle) (d:<lumlet> with the linking ending <in>: turning a teaching, justice or a mind upside down) (b:lumlet) (q:draft)
lumletsak = (i:1) (t:v) (w:overturn/overthrow/frustrate) (d:<lumlet> with <sak>: turn over tables, bring plans to nothing) (b:lumlet) (q:draft)
lumlum = (i:1) (t:v) (w:keep sleeping/lie around/keep lying down) (d:doubled form of <lum>, lie down, for an action that goes on and on) (q:draft)
lumna = (i:1) (t:n) (w:warmth/warming) (d:warmth, from <lum>, warm, with the noun suffix <na>; {khua lumna ding} means for getting warm) (a:votna) (b:lum) (q:draft)
lumneu = (i:1) (t:n) (w:small shield) (d:a small shield, from <lum>, shield, and <neu>, small; carried by archers) (a:lumpi/lumgol) (q:draft)
lumneute = (i:1) (t:n) (w:small shields) (d:plural of <lumneu>: small shields, named beside {lum lian}, large shields) (b:lumneu) (q:draft)
lumpa = (i:1) (t:n) (w:man who lies with/man who slept with) (d:<lum>, lie, with <pa>, which marks a man: the man who lay with a woman) (b:lum) (q:draft)
lumpi = (i:1) (t:n) (w:large shield) (d:a large shield, from <lum>, shield, and <pi>, big) (s:lumgol) (a:lumneu) (b:lum) (q:draft)
lumsa = (i:1) (t:adj) (w:lying dead/slain/laid low) (d:<lum>, lie, with <sa>, already: lying where it fell, said of one that has been killed, as in {a kigo lumsa} and {a kithat lumsa}) (b:lum) (q:draft)
lumsak = (i:1) (t:v) (w:make lie down/lay down) (d:<lum>, lie down, with the causative <sak>: make a person or an animal lie down, let someone sleep in a place) (b:lum) (q:draft)
lumsuk = (i:1) (t:v) (w:lie down/lay oneself down) (d:<lum>, lie, with <suk>, downward: lie down on the ground or in bed, said of people and animals) (s:lum/lup) (a:tho) (b:lum) (r:5.25.2) (q:draft)
lumsukin = (i:1) (t:v) (w:lie down/lying down) (d:<lumsuk>, lie down, with the ending <in>, which links it to the next verb: lying down, he did something else) (b:lumsuk) (q:draft)
lumsuksakin = (i:1) (t:v) (w:make lie down) (d:<lumsuk>, lie down, with the causative <sak> and the ending <in>, which links it to the next verb: having someone lie down) (b:lumsuk) (q:draft)
lumta = (i:1) (t:v) (w:lie down/have lain down) (d:<lum>, lie down, with <ta>, which shows that the state has now come about: they now lie there, said of the dead) (b:lum) (q:draft)
lumta = (i:2) (t:v) (w:be warm/have become warm) (d:<lum>, warm, with <ta>, which shows that the state has now come about; {ka khua lumta} means I am warm now) (b:lum) (q:draft)
lumte = (i:1) (t:n) (w:shields) (d:plural of <lum>, shield) (b:lum) (q:draft)
luna = (i:1) (t:n) (w:sickness/ailment) (d:sickness, used in the pair {cina, luna} for the sick and every kind of illness; literally <lu>, head, with <na>, be in pain) (b:lu) (q:draft, low confidence)
lunatna = (i:1) (t:n) (w:sickness/disease) (d:sickness, used in the pair {cinatna lunatna}, sicknesses and diseases) (s:cinatna/natna) (a:cidamna) (q:draft, low confidence)
lung = (i:1) (t:n) (w:heart/mind) (d:the heart or mind as the seat of feeling and thought, mostly in set expressions: {lung kham}, be troubled; {lung dam}, be glad; {lung muang}, be secure; {lung kituak}, be of one mind) (s:lungsim/lungtang) (r:42.21.19) (q:draft)
lung-amsak = (i:1) (t:v) (w:terrify/trouble/unsettle) (d:make the heart, <lung>, disturbed or afraid, with the causative <sak>; also written <lungamsak>) (s:lungamsak/lausak) (a:lungmuangsak) (q:draft)
lungam = (i:1) (t:v) (w:be humiliated/be dismayed) (d:be cast down in heart from shame; in the verse it follows {mai zum}, be ashamed; probably the same word as <lunggam>) (s:lunggam) (q:draft, low confidence)
lungamsak = (i:1) (t:v) (w:terrify/dismay) (d:<lungam>, be dismayed, with the causative <sak>: make someone lose courage, terrify; also written <lung-amsak>) (s:lung-amsak/lausak) (a:lungmuangsak) (b:lungam) (q:draft)
lungdahna = (i:1) (t:n) (w:sorrow/grief) (d:sorrow, from <lung>, heart, with <dah>, be sad, and the noun suffix <na>) (s:dahna/lungkhamna/lunggimna) (a:lungdamna) (q:draft)
lungdam = (i:2) (t:n) (w:joy/gladness) (d:joy or gladness, as in {lungdam la}, song of joy, and {lungdam ko}, express joy or give thanks) (s:lungdamna/kipahna) (a:dahna)
lungdam = (i:3) (t:v) (w:delight/rejoice/be glad) (d:be glad, rejoice, or take delight in someone or something) (s:kipak/nuam) (a:dah)
Lungdam = (i:1) (t:v) (w:rejoice/be glad) (d:<lungdam> written with a capital at the start of a sentence or in a title; {Lungdam nading Thu}, word for rejoicing, is the gospel, and {Lungdam kohna} is thanksgiving) (b:lungdam) (q:draft)
lungdamhuai = (i:1) (t:adj) (w:blessed/pleasing/gladdening) (d:<lungdam>, glad, with <huai>, causing or worthy of a feeling: bringing joy; it renders both blessed and pleasing) (a:dahhuai) (q:draft)
lungdamin = (i:1) (t:adv) (w:joyfully/gladly/with joy) (d:<lungdam>, be glad, with the adverb ending <in>: with joy, gladly) (s:kipakin/lungdamtakin) (a:dahin) (b:lungdam) (r:19.118.24) (q:draft)
lungdamkohna = (i:1) (t:n) (w:thanksgiving/thanks/gratitude) (d:the giving of thanks, from <lungdamkoh>, give thanks, with the noun suffix <na>; {lungdamkohna la} is a song of thanksgiving) (b:lungdamkoh) (r:47.1.11) (q:draft)
lungdamna = (i:1) (t:n) (w:joy/gladness) (d:joy or gladness, from <lungdam>, be glad, with the noun suffix <na>) (s:kipahna/kipakna/nuamna/lungnopna) (a:dahna/lungdahna) (b:lungdam) (r:19.51.8) (q:draft)
lungdamna = (i:2) (t:n) (w:thanksgiving/thanks) (d:thanks given to God, the same word as {lungdamna}, joy; {lungdamna ko} is to give thanks) (s:lungdamkohna) (b:lungdam) (q:draft, low confidence)
Lungdamna = (i:1) (t:n) (w:joy/good news) (d:<lungdamna>, joy, written with a capital at the start of a sentence or in {Lungdamna Thu}, the Good News or gospel) (b:lungdamna) (q:draft)
lungdamnate = (i:1) (t:n) (w:joys/pleasures) (d:plural of <lungdamna>: joys, also the pleasures of life) (a:dahnate) (b:lungdamna) (q:draft)
lungdampah = (i:1) (t:v) (w:be glad readily/be pleased) (d:<lungdam>, be glad, with <pah>, at once; in the verse it is negated: he takes no pleasure in doing so) (q:draft, low confidence)
lungdampih = (i:1) (t:v) (w:rejoice with/congratulate) (d:<lungdam>, be glad, with <pih>, together with: share someone’s joy, congratulate him on his good fortune) (a:dahpih) (b:lungdam) (q:draft)
lungdampih = (i:2) (t:v) (w:rejoice in/delight in/be glad about) (d:take pleasure in a thing; {lungdampih khuapi} is a city one delights in, a city of revelry) (b:lungdam) (q:draft, low confidence)
lungdampihna = (i:1) (t:n) (w:rejoicing with) (d:<lungdampih>, rejoice with someone, with the noun suffix <na>; with <ding> it means in order to rejoice together) (b:lungdampih) (q:draft)
lungdamsak = (i:1) (t:v) (w:make glad/please/gladden) (d:<lungdam>, be glad, with the causative <sak>: make someone glad, please someone) (s:kipaksak/nuamsak/lungkimsak/lungnuamsak) (a:dahsak/lungkhamsak) (b:lungdam) (r:19.51.8) (q:draft)
lungdamsakkik = (i:1) (t:v) (w:make glad again/restore joy) (d:<lungdamsak>, make glad, with <kik>, again: give someone back his joy) (b:lungdamsak) (q:draft)
lungdamsakna = (i:1) (t:n) (w:pleasing/making glad) (d:<lungdamsak>, make glad, with the noun suffix <na>; with <ding> it means in order to please, to seek the favor of) (b:lungdamsak) (q:draft)
lungdamsakpa = (i:1) (t:n) (w:the man who made glad) (d:<lungdamsak>, make glad, with <pa>, which marks a man: the man who made someone glad) (b:lungdamsak) (q:draft)
lungdamsakte = (i:1) (t:n) (w:those who please) (d:<lungdamsak>, make glad, with <te>, the people who do so; {amah a lungdamsakte} means those who please him) (b:lungdamsak) (q:draft)
lungdamtakin = (i:1) (t:adv) (w:gladly/joyfully) (d:<lungdam>, glad, with <takin>, which makes an adverb: gladly, most willingly) (s:lungdamin/kipakin) (a:dahin) (b:lungdam) (q:draft)
lungdamte = (i:1) (t:n) (w:those who rejoice/the joyful) (d:<lungdam>, be glad, with the plural <te>, used as a noun: people who rejoice) (s:gualnuamte) (a:dahte/kapte) (b:lungdam) (q:draft)
lungdamzaw = (i:1) (t:adj) (w:happier/more joyful) (d:<lungdam>, glad, with the comparative <zaw>, more; as a command with <un> it means rejoice rather, rejoice all the more) (b:lungdam) (q:draft)
lungduai = (i:1) (t:adj) (w:patient/slow to anger) (d:patient, slow to become angry, from <lung>, heart, and <duai>; {lungduai-in} is patiently) (s:duai) (a:lungtom/hehbaih) (r:19.37.7) (q:draft)
lungduaina = (i:1) (t:n) (w:patience/forbearance/longsuffering) (d:patience or forbearance, from <lungduai>, patient, with the noun suffix <na>) (s:thuakzawhna) (a:lungtomna) (b:lungduai) (r:48.5.22) (q:draft)
lungduaisak = (i:1) (t:v) (w:make patient) (d:<lungduai>, patient, with the causative <sak>: make someone patient) (b:lungduai) (q:draft)
lungduaitakin = (i:1) (t:adv) (w:patiently) (d:<lungduai>, patient, with <takin>, which makes an adverb: patiently) (b:lungduai) (q:draft)
lungduaite = (i:1) (t:n) (w:the patient/patient people) (d:<lungduai>, patient, with the plural <te>: those who are patient) (b:lungduai) (q:draft)
lungduaizo = (i:1) (t:v) (w:be able to be patient/bear with) (d:<lungduai>, patient, with <zo>, be able; in the verse it is negated: could no longer be patient with them) (b:lungduai) (q:draft)
lunggai = (i:1) (t:v) (w:consider/think about) (d:turn something over in the mind, consider; probably the same word as <lungngai>) (s:lungngai/ngaihsut) (q:draft, low confidence)
lunggam = (i:1) (t:v) (w:be disgraced/be dismayed) (d:be cast down in heart from shame; in the verse it follows <maizum>, be ashamed; probably the same word as <lungam>) (s:lungam) (q:draft, low confidence)
lunggim = (i:1) (t:v) (w:be troubled/be distressed/be weary/be in anguish) (d:be heavy or worn out in heart from worry, fear or grief, from <lung>, heart, and <gim>, be weary) (s:lungkham) (a:lungdam/lungnuam) (r:20.30.1) (q:draft)
lunggimhuai = (i:1) (t:adj) (w:wearisome/troubling/distressing) (d:<lunggim>, be troubled, with <huai>, which marks what causes a feeling: wearying or troubling to the heart) (s:lungkhamhuai) (a:lungdamhuai) (q:draft)
lunggimin = (i:1) (t:v) (w:be distressed/be in anguish) (d:<lunggim>, be distressed, with the linking ending <in>: in distress, in bitterness of heart) (s:lungkhamin) (b:lunggim) (q:draft)
lunggimna = (i:1) (t:n) (w:anguish/distress/grief) (d:anguish or distress of heart, from <lunggim>, be troubled, with the noun suffix <na>) (s:lungkhamna/dahna/lungdahna) (a:lungdamna/lungnopna) (b:lunggim) (q:draft)
Lunggimna = (i:1) (t:n) (w:distress/anguish/grief) (d:<lunggimna>, distress, written with a capital at the start of a sentence or in a section heading such as {Kikhen Man-a Lunggimna}, distress because of parting) (b:lunggimna) (q:draft, low confidence)
lunggimnate = (i:1) (t:n) (w:distresses/troubles/anguish) (d:plural of <lunggimna>: the distresses that someone suffers) (s:lungkhamnate) (b:lunggimna) (q:draft)
lunggimpih = (i:1) (t:v) (w:be anxious for/be distressed for/be in anguish over) (d:<lunggim>, be troubled, with <pih>, together with or for another person: be anxious or in anguish for someone) (b:lunggim) (q:draft)
lunggimsak = (i:1) (t:v) (w:weary/trouble/burden/dishearten) (d:<lunggim>, be troubled, with the causative <sak>: make someone weary or heavy in heart) (s:lungkhamsak/gimsak) (a:lungdamsak/lungnuamsak) (b:lunggim) (q:draft)
lunggimzaw = (i:1) (t:v) (w:be more distressed) (d:<lunggim>, be distressed, with <zaw>, more: be more distressed than someone else) (b:lunggim) (q:draft)
lunggulh = (i:1) (t:v) (w:desire/long for/lust after) (d:want something strongly, long for it; also used of sexual desire) (s:deih)
lunggulhgulh = (i:1) (t:v) (w:long for/crave) (d:<lunggulh>, long for, with the last part doubled: keep longing for, crave) (q:draft)
lunggulhin = (i:1) (t:v) (w:desire/long for/set the mind on) (d:<lunggulh>, long for, with the linking ending <in>: longing for something, with the mind set on it) (b:lunggulh) (q:draft)
lunggulhna = (i:1) (t:n) (w:longing/desire/lust) (d:strong desire, good or bad, from <lunggulh>, long for, with the noun suffix <na>) (s:deihna/utna) (b:lunggulh) (r:10.23.15) (q:draft)
lunggulhnate = (i:1) (t:n) (w:desires/longings/passions) (d:plural of <lunggulhna>: desires, longings) (s:deihnate) (b:lunggulhna) (q:draft)
lunggulhte = (i:1) (t:n) (w:lovers) (d:<lunggulh>, desire, with <te>: those whom one desires; {na lunggulhte} means your lovers) (s:ngaihte) (b:lunggulh) (q:draft)
lunggulhte = (i:2) (t:n) (w:those who desire) (d:<lunggulh>, desire, with <te>: the people who long for something) (b:lunggulh) (q:draft, low confidence)
lungham = (i:1) (t:v) (w:be angry/be furious/be enraged) (d:be very angry, a strong word used beside <heh>, be angry; {lungham mahmahna} is great wrath) (s:heh/sinso) (q:draft)
lunghamin = (i:1) (t:v) (w:be angry/be furious) (d:<lungham>, be angry, with the ending <in>, which links it to the next verb) (b:lungham) (q:draft)
lunghamna = (i:1) (t:n) (w:fierce anger/wrath/fury) (d:fierce anger, from <lungham>, be furious, with the noun suffix <na>) (s:hehna/sinsona/thangpaihna) (b:lungham) (q:draft)
lunghiang = (i:1) (t:adj) (w:stumbling/faltering/hesitant) (d:wavering or holding back in heart; {lunghiang loin} means without hesitating)
lunghianna = (i:1) (t:n) (w:grudging/reluctance) (d:an unwilling, grudging heart in giving; in the verse it is negated: you shall not give grudgingly) (q:draft, low confidence)
lunghih = (i:1) (t:v) (d:found only in {lunghih mawh}, be afraid or worried, the same word as <lunghihmawh> written apart) (q:draft, low confidence)
lunghihmawh = (i:1) (t:v) (w:worry/be anxious/be afraid) (d:be troubled in mind about what may happen, worry or fear that something will go wrong; also written <lunghimawh>) (s:lunghimawh/lungkham) (a:lungmuan) (q:draft)
lunghihmawhhuai = (i:1) (t:adj) (w:worrying/to be feared) (d:<lunghihmawh>, worry, with <huai>, which marks what causes or deserves a feeling: there is reason to fear that something will happen) (q:draft)
lunghihmawhin = (i:1) (t:v) (w:worry/be anxious) (d:<lunghihmawh>, worry, with the linking ending <in>; {lunghihmawhin nei kei un} means do not worry about it) (b:lunghihmawh) (q:draft)
lunghihmawhna = (i:1) (t:n) (w:anxiety/worry/concern/care) (d:anxiety or concern, from <lunghihmawh>, worry, with the noun suffix <na>; also written <lunghimawhna>) (s:lunghimawhna) (a:lungmuanna) (b:lunghihmawh) (q:draft)
lunghihmawhpih = (i:1) (t:v) (w:be concerned about/worry about/be afraid of) (d:<lunghihmawh>, worry, with <pih>, which adds the person or thing one is troubled about: be concerned for someone, be afraid of something) (b:lunghihmawh) (q:draft)
lunghihmawhsak = (i:1) (t:v) (w:be anxious about/fear for) (d:<lunghihmawh>, worry, with <sak>; in the verse Paul fears for the Galatians that his work for them may prove wasted) (b:lunghihmawh) (q:draft, low confidence)
lunghimawh = (i:1) (t:v) (w:fear/be afraid) (d:be afraid that something bad may happen; also written <lunghihmawh>) (s:lau/kihta)
lunghimawh = (i:2) (t:v) (w:worry/be anxious) (d:be anxious about something, keep thinking about what may go wrong; also written <lunghihmawh>) (s:lunghihmawh/lungkham)
lunghimawhin = (i:1) (t:v) (w:be anxious/worry/fear) (d:<lunghimawh>, worry or fear, with the linking ending <in>: being anxious, anxiously) (b:lunghimawh) (q:draft)
lunghimawhna = (i:1) (t:n) (w:worry/anxiety/vexation) (d:worry or anxiety, from <lunghimawh>, worry, with the noun suffix <na>; also written <lunghihmawhna>) (s:lunghihmawhna) (a:lungmuanna) (b:lunghimawh) (r:21.2.22) (q:draft)
lunghimawhsak = (i:1) (t:v) (w:make afraid/make anxious/worry) (d:<lunghimawh>, fear or worry, with the causative <sak>: make someone afraid or anxious) (a:lungmuangsak) (b:lunghimawh) (q:draft)
lungka = (i:1) (t:v) (w:hesitate/waver/falter) (d:be of two minds, be unsteady in heart, hesitate; {lungka loin} means without wavering) (a:lungkip) (q:draft)
lungkawi = (t:see) <lungkawi-a>
lungkawi-a = (i:1) (t:adj) (w:crooked/warped/perverse) (d:crooked in heart, from <lung>, heart, with <kawi>, crooked, and the ending <a>) (s:lungsimkawi) (q:draft)
lungkham = (i:1) (t:v) (w:be troubled/be distressed/worry/grieve) (d:be anxious, troubled or distressed in mind, from <lung>, heart, and <kham>; {a lungkham mite} are people in trouble) (s:lunggim/lunghimawh) (a:lungdam/lungnuam) (r:14.15.4) (q:draft)
lungkhamhuai = (i:1) (t:adj) (w:distressing/wretched/grievous) (d:causing worry or sorrow, from <lungkham>, be troubled, with <huai>, worthy of or causing a feeling) (s:dahhuai/lunggimhuai) (a:lungdamhuai) (q:draft)
lungkhamin = (i:1) (t:v) (w:be distressed/be in anguish/despair/grieve) (d:<lungkham>, be distressed, with the ending <in>, which links it to the following verb: being distressed, in anguish) (s:lunggimin) (b:lungkham) (r:9.1.10) (q:draft)
lungkhamna = (i:1) (t:n) (w:distress/trouble/anguish/sorrow) (d:distress, trouble or anguish, from <lungkham>, be troubled, with the noun suffix <na>) (s:lunggimna/dahna/haksatna) (a:lungdamna/lungnopna/lungmuanna) (b:lungkham) (q:draft)
Lungkhamna = (i:1) (t:n) (w:trouble/distress) (d:<lungkhamna>, trouble, written with a capital at the start of a sentence or in {Lungkhamna Kuam}, Valley of Trouble, the Valley of Achor) (b:lungkhamna) (q:draft)
lungkhamnate = (i:1) (t:n) (w:troubles/distresses/anxieties) (d:plural of <lungkhamna>: troubles, distresses) (s:lunggimnate) (b:lungkhamna) (q:draft)
lungkhampihin = (i:1) (t:v) (w:grieve with/be troubled with) (d:<lungkham>, be troubled, with <pih>, together with someone, and the linking ending <in>: sharing another person’s trouble) (b:lungkham) (q:draft)
lungkhamsak = (i:1) (t:v) (w:distress/trouble/grieve/cause sorrow) (d:<lungkham>, be troubled, with the causative <sak>: make someone troubled or sad, bring trouble on someone) (s:dahsak/lunggimsak) (a:lungdamsak/lungnuamsak/hehnem) (b:lungkham) (q:draft)
lungkhamsakna = (i:1) (t:n) (w:distressing/tormenting) (d:<lungkhamsak>, distress, with the noun suffix <na>: the distress caused to someone) (b:lungkhamsak) (q:draft)
lungkhamsakpa = (i:1) (t:n) (w:troubler) (d:<lungkhamsak>, trouble, with <pa>, which marks a man: the man who brings trouble) (b:lungkhamsak) (q:draft)
lungkhamsakte = (i:1) (t:n) (w:those who distress/troublers) (d:<lungkhamsak>, distress, with the plural <te>: those who bring distress on someone) (b:lungkhamsak) (q:draft)
lungkhamte = (i:1) (t:n) (w:the distressed/the troubled) (d:<lungkham>, be distressed, with the plural <te>: those who are in distress; the NIV has the needy) (b:lungkham) (q:draft)
lungkhauh = (i:1) (t:adj) (w:stubborn/stiff-necked/hard-hearted/harsh) (d:literally hard of heart: <lung> heart with <khauh> hard; said of people who will not listen, and in 1 Peter 2:18 of harsh masters) (s:paupeng) (a:lungnem/lungsimnem) (r:5.21.18) (q:draft)
lungkhauhin = (i:1) (t:adj) (w:stubborn/hard-hearted) (d:<lungkhauh> with the linking ending <in>, used when another verb follows) (b:lungkhauh) (q:draft)
lungkhauhna = (i:1) (t:n) (w:stubbornness/hardness of heart) (d:refusal to listen or believe; {lungkhauhna tawh gen} is to say something firmly, to insist) (s:khauhna) (a:lungnemna/lungneemna) (b:lungkhauh) (q:draft)
lungkhauhnate = (i:1) (t:n) (w:stubborn ways/stubbornness) (d:plural of <lungkhauhna>: the stubborn ways a people will not give up) (b:lungkhauhna) (q:draft)
lungkhauhsak = (i:1) (t:v) (w:harden) (d:<lungkhauh> with <sak>, cause: make someone hard-hearted) (b:lungkhauh) (q:draft)
lungkheel = (i:1) (t:adj) (w:fickle/changeable) (d:<lung> heart with <kheel> change: changing one's mind easily) (q:draft)
lungkhuah = (t:todo) (r:56.3.2) (q:draft, one verse only, {lungkhuah nei loin} is something of the heart that one should be without, between not quarrelling and being gentle, but which fault it names cannot be told)
lungkia = (i:1) (t:v) (w:be discouraged/lose heart/be dismayed) (d:<lung> heart with <kia> fall: lose courage or hope, be dismayed or discouraged) (s:lungsi/lungniam) (a:lungkip) (r:49.3.13) (q:draft)
lungkiagawp = (i:1) (t:v) (w:be utterly dismayed/be confounded) (d:<lungkia> lose heart with <gawp>, which marks a thorough or violent action) (b:lungkia) (q:draft)
lungkiasak = (i:1) (t:v) (w:discourage/dishearten) (d:<lungkia>, lose heart, with {-sak}, cause) (s:thazawsak) (a:lungkipsak/hansuah) (b:lungkia) (q:draft)
lungkiasakin = (i:1) (t:v) (w:discourage/dishearten) (d:<lungkiasak> discourage with {-in}, linking it to the next verb) (b:lungkiasak) (q:draft)
lungkiat = (i:1) (t:v) (w:lose heart/be discouraged/give up) (d:form of <lungkia> used before <nading>, <loh> and <ngei>) (b:lungkia) (q:draft)
lungkiatna = (i:1) (t:n) (w:discouragement/loss of heart/dismay) (d:<lungkiat> lose heart with the noun suffix <na>: the state of having lost courage or hope) (a:hanna) (b:lungkiat) (q:draft)
lungkim = (i:1) (t:v) (w:be satisfied/be pleased/be content) (d:<lung> heart with <kim> complete: be satisfied, pleased or content with someone or something; with <kei> or <lo>, be displeased) (s:nuamsa) (r:58.10.6) (q:draft)
lungkimhuai = (i:1) (t:adj) (w:pleasing/acceptable/satisfying) (d:<lungkim>, be satisfied, with <huai>, worthy of: such as pleases; with <lo>, displeasing) (s:lungdamhuai) (q:draft)
lungkimin = (i:1) (t:adv) (w:contentedly/with contentment/willingly/confidently) (d:form of <lungkim> with {-in}, being content or assured) (b:lungkim) (r:54.6.6) (q:draft)
lungkimlo = (i:1) (t:adj) (w:displeased/sullen/discontented) (d:<lungkim> be pleased with <lo>, not) (s:maigum) (b:lungkim) (q:draft)
lungkimlohna = (i:1) (t:n) (w:displeasure/indignation) (d:<lungkim> be pleased with <loh>, not, and the noun suffix <na>; in the verse beside <hehna> and <thangpaihna> for God's wrath) (a:lungkimna) (q:draft)
lungkimna = (i:1) (t:n) (w:pleasure/delight/favour/satisfaction) (d:being pleased with someone or something) (a:lungkimlohna) (b:lungkim) (r:19.147.10) (q:draft)
lungkimpih = (i:1) (t:v) (w:be pleased with/approve/consent to) (d:<lungkim> with <pih>: be pleased about a thing, agree to it) (s:thukimpih) (b:lungkim) (q:draft)
lungkimsak = (i:1) (t:v) (w:please/satisfy) (d:<lungkim> be satisfied with the causative <sak>: please someone, or give them all they need) (s:lungdamsak) (a:hehsak) (b:lungkim) (q:draft)
lungkimsakin = (i:1) (t:v) (w:please/satisfy) (d:<lungkimsak> with the linking suffix <in>) (b:lungkimsak) (q:draft)
lungkimte = (i:1) (t:n) (w:those who are satisfied/the complacent) (d:<lungkim> be satisfied, with the plural <te>) (s:lungmuangte) (b:lungkim) (q:draft)
lungkimthei = (i:1) (t:v) (w:be able to be content) (d:<lungkim> be content with <thei>, can) (b:lungkim) (q:draft)
lungkimzo = (i:1) (t:v) (w:be satisfied) (d:<lungkim> with <zo>, be able, in the verses always negated, {lungkimzo nai lo}, still not satisfied) (b:lungkim) (q:draft)
lungkip = (i:1) (t:v) (w:stand firm/be steadfast/be strong in heart) (d:<lung> heart with <kip> firm) (s:kip) (a:lungkia/lungsi) (q:draft)
lungkipin = (i:1) (t:adv) (w:steadfastly/firmly/with perseverance) (d:<lungkip> be steadfast, with the adverb ending <in>) (s:kipin/kiptakin) (b:lungkip) (q:draft)
lungkipna = (i:1) (t:n) (w:steadfastness/firmness/endurance) (d:<lungkip> firm of heart with the noun suffix <na>) (s:kipna) (a:lungkiatna) (b:lungkip) (q:draft)
lungkipsak = (i:1) (t:v) (w:encourage/strengthen/make steadfast) (d:<lungkip> be steadfast, with the causative <sak>) (s:hansuah) (a:lungkiasak) (b:lungkip) (q:draft)
lungli = (i:1) (t:n) (c:plant) (w:poplar/balsam tree/mulberry tree) (d:a kind of tree, named with <kung> as {lungli kung}; English versions differ on which tree is meant) (q:draft)
lungman = (i:1) (t:v) (w:be troubled/be perplexed/be amazed) (d:form of <lungmang> written with an apostrophe before <na>; {lungman’na} is trouble of heart, anxiety or amazement) (q:draft)
lungmang = (i:1) (t:v) (w:be troubled/be perplexed/be dismayed) (d:be upset or at a loss in the heart, from worry, fear or wonder) (s:lungkham/patau) (r:48.4.20) (q:draft)
Lungmang = (i:1) (t:v) (w:be troubled/be dismayed/be amazed/wonder) (d:<lungmang> written with a capital at the start of a sentence; {Lungmang kei in} is do not be troubled) (b:lungmang) (q:draft)
lungmangin = (i:1) (t:v) (w:be perplexed/be troubled/be in anguish) (d:form of <lungmang> with {-in}, being at a loss or deeply troubled) (b:lungmang) (q:draft)
lungmangsak = (i:1) (t:v) (w:unsettle/upset/trouble) (d:<lungmang> be troubled, perplexed, with the causative <sak>; in the verse of upsetting the faith of believers) (b:lungmang) (q:draft)
lungmanhuai = (i:1) (t:adj) (w:surprising/astonishing) (d:<lungmang> be amazed with <huai>, which marks what causes or deserves a feeling; negated in the verse: it is no wonder) (q:draft)
lungmuan = (i:1) (t:v) (w:be secure/be confident/be at peace) (d:form of <lungmuang> used before <na>; {lungmuan'na} is security, confidence, peace of mind) (q:draft)
lungmuang = (i:1) (t:adj) (w:secure/safe/at ease/confident) (d:free from fear or danger; {lungmuang takin} means safely, in safety) (s:bit/lungmuanhuai) (q:draft)
lungmuanga = (i:1) (t:adv) (w:securely/at ease/without care) (d:<lungmuang> with <a>, used before <om>: living in safety) (s:lungmuangin) (b:lungmuang) (q:draft)
lungmuangin = (i:1) (t:adv) (w:securely/safely/confidently) (d:with a mind at rest, without fear: <lungmuang> with the adverb ending {-in}) (s:lungmuanga) (b:lungmuang) (q:draft)
lungmuangsak = (i:1) (t:v) (w:make secure/keep safe/give confidence) (d:<lungmuang> secure, with the causative <sak>) (s:lungmuansak/lungmuanhuaisak) (a:lunghimawhsak) (b:lungmuang) (q:draft)
