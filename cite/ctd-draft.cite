tawldamsak = (i:1) (t:v) (w:refresh/give rest/ease) (d:<tawldam>, be rested, with the causative <sak>: give rest to someone, ease a trouble) (a:gimsak) (b:tawldam) (q:draft)
tawlette = (i:1) (t:n) (w:windows/openings/floodgates) (d:<tawlet>, window, with the plural <te>; {vantung tawlette}, the windows of heaven, where the English has floodgates) (b:tawlet) (r:11.6.4) (q:draft)
tawlkhat = (i:1) (t:adv) (w:a little while/for a while/briefly) (d:<tawl>, a while, with <khat>, one: for a short time; {tawlkhat sung} is for a while, {tawlkhat khit ciangin} after a little while) (a:sawtpi/sawtvei) (r:43.16.16) (q:draft)
Tawlkhatkhat = (i:1) (t:adv) (w:for a while/for a time) (d:<tawlkhat>, a little while, with <khat> repeated) (q:draft, low confidence)
tawllua = (i:1) (t:v) (w:be too weary/be very tired) (d:<tawl>, be weary, with <lua>, too much) (s:gimlua) (b:tawl) (q:draft)
tawlna = (i:1) (t:n) (w:weariness/hardship/trouble) (d:<tawl>, be weary, with the noun ending <na>; used in the pair {gimna tawlna}, suffering and hardship) (s:gimna) (a:tawldamna) (b:tawl) (q:draft)
tawlnga = (i:2) (t:v) (w:relax) (d:be at ease, free from work or trouble)
tawlnga = (i:3) (t:v) (w:pause/cease/stop) (d:stop for a time; {tawlnga loin} is without stopping, unceasingly)
Tawlnga = (i:1) (t:v) (w:rest/cease) (d:<tawlnga>, rest or cease, written with a capital in the text) (b:tawlnga) (q:draft)
tawlngak = (i:1) (t:v) (w:rest/take a rest/come to rest) (d:form of <tawlnga> used before words such as <khit>, <lai>, <theih> and <nading>) (b:tawlnga) (q:draft)
tawlngakna = (i:1) (t:n) (w:rest/resting place/repose) (d:<tawlngak>, rest, with the noun ending <na>: rest, or a time or place of rest; {tawlngakna mun} is a resting place, {tawlngakna sabbath} a sabbath of rest) (s:tawldamna/khawlna) (r:5.12.9) (q:draft)
tawlngasak = (i:1) (t:v) (w:make rest/give rest/let rest) (d:<tawlnga>, rest, with the causative <sak>; in Exodus 5:5 of making people stop their work) (s:tawldamsak) (b:tawlnga) (r:18.9.5) (q:draft)
tawlngasakin = (i:1) (t:v) (w:let rest/leave fallow) (d:<tawlngasak>, make rest, with the linking <in>; of land left unplowed) (b:tawlngasak) (q:draft)
tawlngate = (i:1) (t:n) (w:those who rest) (d:<tawlnga>, rest, with <te>, those who) (b:tawlnga) (q:draft)
Tawlno = (i:1) (t:n) (w:a little while/short time) (d:<tawl>, a while, with <no>, small; {Tawlno khat khit ciangin} is after a little while; written with a capital at the start of a sentence) (s:tawmvei) (q:draft)
tawm = (i:2) (t:part) (d:placed after a verb, often one that begins with <ki>, to show that the subject does the action himself, to himself or on his own: {kigawt tawm} is deny oneself) (r:4.30.3) (q:draft, low confidence)
tawm = (i:3) (t:v) (w:pick up/gather/glean) (d:pick up from the ground, gather what lies scattered; {ansang tawm} is glean ears of grain, {suang tawm} pick up stones) (s:tom/top) (a:paai) (r:41.8.19) (q:draft)
tawmbek = (i:1) (t:adj) (w:few/only a few) (d:<tawm>, few, with <bek>, only) (q:draft)
tawmcik = (i:1) (t:adj) (w:few/very few/little) (d:<tawm>, few, with <cik>, very small: very few, very little) (s:tawmno) (a:tampi) (q:draft)
tawmcikkhat = (i:1) (t:adj) (w:a few/a little/a very small amount) (d:<tawmcik>, very few, with <khat>, one: a very small number or amount) (s:tawmkhat) (q:draft)
tawmin = (i:1) (t:part) (d:<tawm> with the linking ending <in>, placed after a verb to show that the subject does the action himself, on his own: {hanciam tawmin}, making the effort oneself) (b:tawm) (q:draft, low confidence)
tawmin = (i:2) (t:v) (w:pick up/take up) (d:<tawm>, pick up, with the linking ending <in>, followed by another verb: picking up and then) (r:40.13.4) (q:draft)
tawmin = (i:3) (t:adj) (w:few/little) (d:<tawm>, few, with the linking ending <in>: being few; {tawm tawmin} is little by little) (b:tawm) (q:draft)
tawmkha = (i:1) (t:adj) (w:a few/a little/some) (d:a small number or amount, placed after the noun: {ni tawmkha}, a few days) (s:tawmkhat) (a:tampi) (q:draft)
tawmkha = (i:2) (t:adv) (w:sparingly/little) (d:in a small amount or degree) (q:draft)
tawmkhat = (i:1) (t:adj) (w:a little/a few/some) (d:<tawm>, few, with <khat>, one: a small amount or number, some of a thing; {tawmkhat sung} is for a little while) (s:tawmkha) (q:draft)
tawmkhate = (i:1) (t:adj) (w:a few/few) (d:<tawmkha> a few with the plural <te>, placed after the noun: {mi tawmkhate}, a few people) (b:tawmkha) (q:draft)
tawmkhatte = (i:1) (t:adj) (w:a few/few) (d:<tawmkhat> a few with the plural <te>, placed after the noun) (b:tawmkhat) (q:draft)
tawmkik = (i:1) (t:v) (w:pick up/gather up) (d:<tawm>, pick up, with <kik>, back or again; of gathering leftover pieces) (q:draft)
tawmlua = (i:1) (t:adj) (w:too little/too few) (d:<tawm> few, little, with <lua>, too much) (a:tamlua) (b:tawm) (r:21.12.3) (q:draft)
tawmluat = (i:1) (t:adj) (w:too few/too small) (d:form of <tawmlua> used before <leh>, if) (b:tawmlua) (q:draft)
tawmna = (i:1) (t:n) (d:the noun ending <na> on a verb followed by <tawm>, oneself: the act of doing something to oneself; {kikhih tawmna} is a pledge by which one binds oneself, {kinitsak tawmna} the defiling of oneself) (b:tawm) (r:4.30.7) (q:draft, low confidence)
tawmnate = (i:1) (t:n) (d:<tawmna>, the noun ending <na> on a verb followed by <tawm>, doing something to oneself, with the plural <te>; {kiniamsak tawmnate} are acts of humbling oneself) (b:tawmna) (q:draft, low confidence)
tawmno = (i:1) (t:adj) (w:few/little/small) (d:<tawm>, few, with the diminutive <no>: a very small number or amount; <tawmno khat> is a little, a few) (s:tawmcik) (a:tampi) (b:tawm) (q:draft)
tawmnote = (i:1) (t:adj) (w:little/few) (d:<tawmno> with the plural <te>; {tuuhon tawmnote}, little flock, in address) (b:tawmno) (q:draft)
tawmpen = (i:1) (t:adj) (w:fewest/smallest/least) (d:<tawm>, few, with <pen>, most: the smallest in number) (a:tampen) (b:tawm) (q:draft)
tawmsak = (i:1) (t:v) (w:decrease/reduce/make less) (d:<tawm>, few, with the causative <sak>: make less; {a man tawmsak} is lower the price) (s:kiamsak) (a:tamsak) (b:tawm) (q:draft)
tawmsak = (i:2) (t:part) (d:placed after a verb that begins with <ki>: do the action to oneself, make oneself so, as {kisiangtho tawmsak}, consecrate oneself; <tawm> self with causative <sak>) (b:tawm) (r:19.35.13) (q:draft)
tawmsakin = (i:1) (t:v) (w:let pick up/let glean) (d:<tawm>, pick up, with <sak>, let or cause, and the linking <in>) (q:draft, low confidence)
tawmtawm = (i:1) (t:adv) (w:a little/in small amounts) (d:<tawm>, little, doubled) (q:draft)
tawmte = (i:1) (t:adj) (w:few/smaller/fewer) (d:<tawm>, few, with plural <te>: the few, the smaller groups) (a:tamte) (b:tawm) (q:draft)
tawmte = (i:2) (t:part) (d:<tawm>, by itself, with plural <te>, after a verb: the things that do so of themselves, as in {piang tawmte}, what grows by itself without being sown) (b:tawm) (q:draft, low confidence)
tawmto = (i:1) (t:v) (w:pick up/lift up/take up) (d:<tawm> pick up, with <to>, upward) (s:domto/lato) (b:tawm) (q:draft)
tawmvei = (i:1) (t:n) (w:short while/short time/little while) (d:<tawm>, few, with <vei>, time: a short stretch of time, used with <sung>, within, or <ciangin>, after) (s:Tawlno/tomkha/khano) (a:hunsau) (q:draft)
tawmzo = (i:1) (t:part) (d:placed after a verb that begins with <ki>: be able to do the action for oneself; <tawm>, self, with <zo>, be able; {kitankhia tawmzo}, be able to redeem oneself) (b:tawm) (q:draft, low confidence)
tawn = (i:1) (t:v) (w:walk along/follow/go by way of) (d:travel along a path, and so follow a way of life; {khekhap tawn} is follow in the footsteps of someone) (s:zui) (r:12.21.22) (q:draft)
tawn = (i:2) (t:n) (d:counter for whole long objects such as a fish, a bar of gold or a scroll; {ngasa tawn nih} is two fish) (q:draft)
tawn = (i:3) (t:v) (w:threaten) (d:say that one will do harm; written {tawn’} with a final apostrophe, and {tawn’na} is a threat) (s:tawng) (q:draft)
tawna = (i:1) (t:prep) (w:through/by means of) (d:<tawn>, go by way of, with the ending <a>; {tung tawna}, that came through a person, placed before a noun) (b:tawn) (q:draft)
tawng = (i:1) (t:n) (w:inmost part/depth/bottom) (d:the deepest or innermost part: {sung tawng} is the inmost being, {lungsim tawng} the depth of the heart, {tuipi tawng} the bottom of the sea) (s:sungtawng) (q:draft)
tawng = (i:2) (t:v) (w:threaten/intimidate/frighten) (d:frighten someone with words of harm) (s:tawn/lausak) (q:draft)
tawngah = (i:1) (t:n) (w:in the depths/in the inmost part) (d:<tawng>, inmost part or bottom, with the place marker <ah>: {lungsim tawngah} is deep in the heart, {inn sung tawngah} in the inner part of the house, {dang tawngah} on the roof of the mouth) (b:tawng) (q:draft)
tawnggawp = (i:1) (t:v) (w:threaten) (d:<tawng>, threaten, with <gawp>, severely) (b:tawng) (q:draft)
tawngin = (i:1) (t:adv) (w:in detail/thoroughly) (d:in the phrase {a neng a tawngin}, down to the smallest part, in full detail) (b:tawng) (q:draft)
tawngin = (i:2) (t:v) (w:threatening/warning) (d:<tawng> threaten, with the linking ending <in>, with a threat) (b:tawng) (q:draft)
tawngkik = (i:1) (t:v) (w:threaten back/threaten in return) (d:<tawng>, threaten, with <kik>, back) (b:tawng) (q:draft)
tawngnung = (i:1) (t:n) (w:innermost part/inner part/far end) (d:the part furthest in, of a house, temple, prison or cave; often followed by <sungah>, inside) (s:sungnung) (a:pualam) (q:draft)
tawngnungah = (i:1) (t:adv) (w:in the innermost part/into the inner part) (d:<tawngnung>, innermost part, with the place ending <ah>) (b:tawngnung) (q:draft)
tawngtung = (i:1) (t:adv) (w:forever/continually) (d:after <kip>, firm: last forever; apparently the word <tawntung> written with ng) (q:draft, low confidence)
tawnin = (i:1) (t:prep) (w:through/by way of/along) (d:<tawn>, go by way of, with the linking ending <in>: {tung tawnin} is through a person as agent, {lam tawnin} by the road of, {khang tawnin} all through a lifetime) (s:tungtawnin) (b:tawn) (r:12.3.8) (q:draft)
tawnlang = (i:1) (t:n) (w:half/half the length) (d:of a furrow in a field: about half its length) (q:draft, low confidence)
tawnna = (i:1) (t:n) (w:threat/rebuke) (d:<tawn>, threaten, with the noun ending <na>) (b:tawn) (q:draft)
tawnnate = (i:1) (t:n) (w:threats/warnings) (d:<tawnna> threat with the plural <te>; in Jeremiah 17:15 of what the Lord has threatened) (b:tawnna) (q:draft)
tawnpuk = (i:1) (t:v) (w:fall full length/fall flat/fall prostrate) (d:fall down flat with the whole body on the ground; the second part is <puk>, fall) (s:puk) (q:draft)
tawnsak = (i:1) (t:v) (w:set on a path/make walk along/lead along) (d:<tawn>, walk along, with the causative <sak>: make someone walk along a path, as in {lampi man tawnsak}, start a child on the right way) (b:tawn) (q:draft)
tawnsuk = (i:1) (t:v) (w:go down along/flow down past) (d:<tawn>, go along, with <suk>, downward: run down along the side of something, said of water flowing down beside the altar) (b:tawn) (q:draft, low confidence)
tawntung = (i:2) (t:prep) (w:throughout) (d:placed after a word for a span of time: through the whole of it, as {nuntak sung tawntung}, all through life) (s:sungtengin)
Tawntung = (i:1) (t:adj) (w:everlasting/eternal) (d:<tawntung>, for ever, written with a capital in titles of God: {Tawntung Pa}, Everlasting Father, and {Tawntung Pasian}, the Eternal God) (b:tawntung) (q:draft)
tawntunga = (i:1) (t:adv) (w:always/forever/continually/throughout) (d:<tawntung> with the linking ending <a>, used before a verb or noun; {a tawntunga kipan} is from everlasting, {khang tawntunga} is throughout all generations) (s:ngitnget/den/gige) (b:tawntung) (r:19.90.2) (q:draft)
tawntungah = (i:1) (t:prep) (w:all along/throughout/along the whole of) (d:<tawntung>, throughout, with the place marker <ah>, placed after the noun: along the whole length of it, as {lam tawntungah}, all the way) (b:tawntung) (q:draft)
tawntungin = (i:1) (t:adj) (w:continuously/nonstop/always/forever) (d:<tawntung> with the ending <in>; {a tawntungin} is always or for ever, and {tu-a kipanin a tawntungin} is from now on and for evermore) (s:paisuak) (b:tawntung) (r:19.119.20)
tawntungna = (i:1) (t:n) (w:eternity/everlastingness/endlessness) (d:noun form of <tawntung>, always: the state of lasting for ever; after a verb it names what goes on without end, as <nuntak tawntungna>, eternal life, and {lungdam tawntungna}, everlasting joy) (b:tawntung) (r:23.55.13) (q:draft)
tawntungnate = (i:1) (t:n) (d:<tawntungna>, lasting for ever, with plural <te>; after a verb it names things that last for ever, as {nop tawntungnate}, eternal pleasures, and {thukhen tawntungnate}, eternal judgments) (b:tawntungna) (q:draft)
tawntungpa = (i:1) (t:n) (d:<tawntung>, always, with <pa>, the man who; after a verb, the man who keeps doing it, as {hong nawk tawntungpa}, the man who often passes by) (b:tawntung) (q:draft)
tawntungte = (i:1) (t:n) (d:<tawntung>, always, with plural <te>; after a verb, those who always do it, as {Topa a zahtak tawntungte}, those who always fear the Lord) (b:tawntung) (q:draft)
tawntungun = (i:1) (t:prep) (w:throughout/for all) (d:<tawntung>, throughout, with the plural ending <un>, used when several people are addressed; {na khang tawntungun} is throughout your generations) (b:tawntung) (q:draft)
tawnun = (i:1) (t:prep) (w:throughout/all through) (d:<tawn>, along, with the ending <un> used of several people; in {khan tawnun}, all through life, as long as one lives) (b:tawn) (q:draft)
tawnung = (i:1) (t:adv) (w:forever/always) (d:in {a nungta tawnung mipa}, the one who lives forever, the Ancient of Days; possibly the word <tawntung>) (q:draft, low confidence)
tawp = (i:1) (t:v) (w:end/stop/finish/cease) (d:come to an end or bring to an end: a boundary ends at a place, a person stops doing something, a storm stops) (s:bei) (a:kipan) (r:1.44.12) (q:draft)
tawp = (i:2) (t:adj) (w:last/final) (d:coming at the end, after all the others; {Ni tawp Ni} is the last day) (s:nunung/tawpkhak) (a:masa) (q:draft)
tawp = (i:3) (t:v) (w:kiss) (d:touch with the lips in love or greeting) (s:nap) (q:draft, low confidence)
tawpa = (i:1) (t:v) (w:stop/cease/die down) (d:<tawp>, stop, with the linking <a>, and) (b:tawp) (q:draft)
tawphah = (i:1) (t:n) (w:foundation) (d:the base on which a wall is built; <suangtawphah> is a foundation stone) (s:nuaiphah/innbul) (q:draft)
tawpin = (i:1) (t:adv) (w:to the utmost/as much as possible) (d:after <siam>, <hat> or another quality, to the very limit of it; {na siam tawpin} is as well as you can, doing your best, and {ka hat tawpin} is with all my strength) (b:tawp) (q:draft)
tawpin = (i:2) (t:v) (w:stop/cease) (d:<tawp> with the linking ending <in>, stopping and then the next thing follows) (b:tawp) (q:draft)
tawpkhak = (i:1) (t:adj) (w:last/latter/final) (d:the one at the end, set against {a masa}, the first) (s:nunung/tawp) (a:masa) (q:draft)
tawpkhakna = (i:1) (t:n) (w:end/conclusion/last) (d:the very end of a matter; {a tawpkhakna-ah}, at last, in the end, and {a tawpkhakna kam in}, finally) (s:tawpna/beina) (a:kipatna) (b:tawpkhak) (q:draft)
tawpkik = (i:1) (t:v) (w:fall away/turn back/give up again) (d:<tawp> stop with <kik> back: give up the faith after having begun in it) (b:tawp) (q:draft)
tawpkikpah = (i:1) (t:v) (w:fall away at once/give up quickly) (d:<tawp>, stop, with <kik>, back, and <pah>, immediately) (s:pukpah) (q:draft)
tawplam = (i:1) (t:n) (w:ceasing/coming to an end) (d:<tawp>, stop, with <lam>: the fact of having stopped; {ta neih a tawplam}, that she had stopped bearing children) (q:draft, low confidence)
tawpna = (i:1) (t:n) (w:end/last) (d:<tawp>, end, with the noun suffix <na>: the point where something finishes; {a tawpna ah} is in the end, finally) (s:beina/tawpkhakna) (a:kipatna) (b:tawp) (q:draft)
Tawpna = (i:1) (t:n) (w:end/last) (d:<tawpna>, end, written with a capital as a title of God, the End, beside <Kipatna>, the Beginning) (a:Kipatna) (b:tawpna) (q:draft)
tawpsak = (i:1) (t:v) (w:stop/bring to an end/dismiss) (d:<tawp>, stop, with <sak>, cause: make work stop, or put someone out of his work) (s:khawlsak) (b:tawp) (q:draft)
tawpta = (i:1) (t:v) (w:have ceased/have stopped/be over) (d:<tawp> end with <ta>, marking a change that has now taken place) (b:tawp) (q:draft)
tawptawp = (i:1) (t:v) (w:kiss) (d:<tawp>, kiss, said twice: kiss again and again) (s:nap) (q:draft)
tawpun = (i:1) (t:adv) (w:to the utmost/as much as possible) (d:placed after a word for strength or skill: to the limit of it, as in {na siam tawpun}, do your best; the subject is plural in all the verses) (b:tawp) (q:draft)
tawsak = (i:1) (t:v) (w:blind/make blind) (d:<taw>, blind, with the causative <sak>; used with <mit>, eye) (s:mittawsak) (b:taw) (q:draft)
tawsakin = (i:1) (t:v) (w:blind/make blind) (d:<tawsak>, make blind, with the linking ending <in>; said of the eyes, <mit>) (b:tawsak) (q:draft)
tawsaw = (i:1) (t:n) (c:plant) (w:oak) (d:a large strong tree; {tawsaw kung} is an oak tree) (q:draft)
Tawsaw = (i:1) (t:n) (c:plant) (w:oak/tree) (d:<tawsaw>, oak, written with a capital at the start of a sentence and in the place name {Aisaante’ Tawsaw}, the diviners’ tree) (b:tawsaw) (q:draft)
tawsawte = (i:1) (t:n) (c:plant) (w:oaks/great trees) (d:<tawsaw>, oak, with the plural <te>; {Mamre tawsawte} are the great trees of Mamre near Hebron) (b:tawsaw) (q:draft)
tawte = (i:1) (t:n) (w:bottoms/depths/beds) (d:plural of <taw>, bottom; {tuipi tawte}, the bed of the sea) (b:taw) (q:draft)
tawte = (i:2) (t:n) (w:the blind) (d:<taw>, blind, with plural <te>: {a mit a tawte}, those whose eyes are blind) (s:mittawte) (b:taw) (q:draft)
tazen = (i:1) (t:part) (d:placed after a verb, before <uh> or <hi>, to stress with surprise or reproach that something really is so: actually, indeed, even; {hi tazen leh} is if only it were) (q:draft, low confidence)
tazo = (i:1) (t:v) (w:hold/contain/have room for) (d:be large enough to take in an amount; contains <zo> be able) (q:draft)
te = (i:1) (t:part) (d:particle suffixes to nouns indicating plural form)
te = (i:2) (t:ppm) (d:word indicating nominative case)
Tebah = (i:1) (t:name) (c:male) (w:Tebah) (d:son of Nahor, the brother of Abraham, by his concubine Reumah) (r:1.22.24)
Tebaliah = (i:1) (t:name) (c:male) (w:Tabaliah) (d:Levite gatekeeper, the third son of Hosah of the clan of Merari) (r:13.26.11)
Tebeth = (i:1) (t:name) (w:Tebeth) (d:tenth month of the Hebrew calendar, the month in which Esther was taken to King Xerxes) (r:17.2.16)
teci = (i:1) (t:n) (w:witness/testimony) (d:a witness or what a witness says; <teci pang> and {teci pan} mean testify, {teci pan’na} means testimony) (r:42.21.13) (q:draft)
Teci = (i:1) (t:n) (w:witness) (d:<teci>, witness, written with a capital at the start of a sentence and as the name given to an altar) (b:teci) (q:draft)
tecipan = (t:see) <tecipan'na>
Tecipan = (t:see) <Tecipan'na>
tecipan'na = (i:1) (t:n) (w:testimony/witness) (d:the act or content of bearing witness; {tecipan’na singkuang} is the ark of the testimony, and in Deuteronomy 6:20 the plural sense is God's testimonies or stipulations) (s:tecipanna) (q:draft)
Tecipan'na = (i:1) (t:n) (w:Testimony/covenant law) (d:<tecipan>, bear witness, with the noun suffix <na>; here the Testimony, the tablets of the covenant law before which the manna was kept) (q:draft)
tecipan'nate = (i:1) (t:n) (w:testimonies/statutes/stipulations) (d:plural: the solemn declarations of God, listed together with his commands and decrees) (s:tecipannate) (r:12.23.3) (q:draft)
tecipanna = (i:1) (t:n) (w:testimony/witness) (d:<teci> witness with <pan> and the noun ending <na>; in the verses the testimony, the decrees of God given to the king and set up in Israel) (s:tecipan'na) (q:draft)
tecipannate = (i:1) (t:n) (w:testimonies/statutes) (d:<tecipanna> testimony with the plural <te>, named with the commands and decrees of God) (s:tecipan'nate) (b:tecipanna) (q:draft)
tecite = (i:1) (t:n) (w:witnesses) (d:<teci>, witness, with the plural <te>; {zuau tecite} are false witnesses) (b:teci) (q:draft)
tee = (i:1) (t:v) (w:shine/sparkle/flash/gleam) (d:give off bright light, as polished metal or a precious stone; {tee zalzal} and {tee daldal} describe flashing and gleaming) (s:taang) (r:27.2.31) (q:draft)
teei = (i:1) (t:part) (d:placed after a verb for emphasis, still or at least; apparently a spelling of the particle <tei>) (s:tei) (q:draft, low confidence)
teeiteei = (i:1) (t:adv) (w:hard/persistently/with all effort) (d:placed after a verb: keep on doing with effort; apparently the word <teitei> written with ee) (s:teitei) (q:draft, low confidence)
teekin = (i:1) (t:adj) (w:old/aged) (d:<teek> with the linking ending <in>: being old, having grown old) (b:teek) (q:draft)
teeklua = (i:1) (t:adj) (w:very old/too old) (d:<teek>, old, with <lua>, very or too much) (b:teek) (q:draft)
teeknu = (i:1) (t:n) (w:mother-in-law) (d:the mother of one's husband; <teek> old with <nu> marking a woman) (b:teek) (q:draft)
teeknute = (i:1) (t:n) (w:mothers-in-law) (b:teeknu) (q:draft)
teekpa = (i:1) (t:n) (w:master/owner/householder/landowner) (d:in {inn teekpa}, the master or owner of a house; <teek> with {-pa} for a man) (s:innteek) (b:teek) (q:draft)
teekpa = (i:2) (t:n) (w:father-in-law) (d:the father of a woman's husband) (b:teek) (q:draft)
teekpen = (i:1) (t:adj) (w:oldest/eldest) (d:<teek>, old, with <pen>, most: the oldest of a group, set against <khangnopen>, the youngest) (s:hampen) (a:khangnopen) (b:teek) (q:draft)
teeksak = (i:1) (t:v) (w:make old/age) (d:<teek>, old, with the causative <sak>) (b:teek) (q:draft)
teeksiate = (i:1) (t:n) (w:old people/old men/the aged) (d:contains <teek> old and the plural <te>; set against <naupangte>, children) (s:teekte/khanghamte/puteekte) (a:naupangte) (q:draft)
teeksih = (i:1) (t:v) (w:die of old age/die old) (d:<teek> old with <sih>, form of <si> die: die at a good old age) (q:draft)
teeksihsak = (i:1) (t:v) (w:let die of old age/give a full life span) (d:<teeksih>, die old, with the causative <sak>) (b:teeksih) (q:draft)
teekta = (i:1) (t:adj) (w:old/aged) (d:<teek>, old, with <ta>, showing a state now reached: be old by now) (b:teek) (q:draft)
teekte = (i:1) (t:n) (w:the old/old people/the aged) (d:<teek> old, with the plural <te>; {numei teekte} are old women) (s:khanghamte/puteekte) (a:khangnote) (b:teek) (q:draft)
teekteek = (i:1) (t:adv) (w:exactly/very/oneself) (d:emphasising word placed after another word: the very one, exactly so, in person) (s:mahmah) (q:draft)
teekteekin = (i:1) (t:adv) (w:exactly/precisely/just) (d:after <bang>, exactly as; {tua ni teekteekin} is on that very day) (b:teekteek) (q:draft)
teel = (i:1) (t:v) (w:choose/select/elect) (d:pick out one from among others: choose a person, a people, a place or the good; {Pasian’ teel mite} are those God has chosen) (s:teelkhia/tengkhia) (a:nial) (r:19.78.67) (q:draft)
teelin = (i:1) (t:v) (w:choose/select) (d:<teel> with the linking suffix <in>, choosing and then) (b:teel) (q:draft)
teelkhia = (i:1) (t:v) (w:choose/select/set apart) (d:<teel>, choose, with <khia>, out: pick out from among others and set apart) (s:tengkhia) (b:teel) (q:draft)
teelkhiat = (i:1) (t:v) (w:choose/choose out/select) (d:form of <teelkhia> used before a noun or in a dependent clause, as {a teelkhiat mite}, the people he chose) (b:teelkhia) (q:draft)
teelkhiatna = (i:1) (t:n) (w:election/choosing/selection) (d:<teelkhiat>, choose out, with the noun ending <na>) (s:teelna) (b:teelkhiat) (r:45.11.28) (q:draft)
teelkhin = (i:1) (t:v) (w:have chosen/choose already) (d:<teel>, choose, with <khin>, already done) (b:teel) (q:draft)
teelkholhsa = (i:1) (t:adj) (w:chosen beforehand/foreknown) (d:<teel>, choose, with <kholh>, beforehand, and <sa>, already done) (q:draft)
teelkik = (i:1) (t:v) (w:choose again) (d:<teel>, choose, with <kik>, again) (b:teel) (q:draft)
teello = (i:1) (t:v) (w:not choose) (d:<teel>, choose, written together with the negative <lo>: did not choose, has not chosen) (b:teel) (q:draft)
teelna = (i:1) (t:n) (w:choice/choosing/election) (d:<teel>, choose, with the noun suffix <na>: the act of choosing, and God’s election of his people; {a teelna mun} is the place he chooses) (s:teelkhiatna) (b:teel) (q:draft)
teelnasa = (i:1) (t:adj) (w:chosen) (d:<teel>, choose, with <na> and <sa>, already done; {ka teelnasa mun}, the place I have chosen) (b:teel) (q:draft)
teelpa = (i:1) (t:n) (w:chosen one) (d:the man whom someone has chosen; <pa> marks a man) (b:teel) (q:draft)
teelpa = (i:2) (t:n) (w:chooser) (d:the one who chooses, as in {note hong teelpa}, whoever chooses you) (b:teel) (q:draft, low confidence)
teelsa = (i:1) (t:adj) (w:chosen/elect) (d:already chosen; after a possessive also the chosen one of someone) (s:kiteelsa) (b:teel) (q:draft)
Teelsa = (i:1) (t:adj) (w:chosen) (d:<teelsa>, chosen, capitalised as a title of the Son) (b:teelsa) (q:draft)
teelsak = (i:1) (t:v) (w:choose for) (d:choose on behalf of someone) (b:teel) (q:draft)
teelsak = (i:2) (t:v) (w:let choose/allow to choose) (b:teel) (r:10.17.1) (q:draft)
teelsate = (i:1) (t:n) (w:chosen ones/elect) (d:the people who have been chosen, used of those God has chosen) (s:teeltuamte/teelte) (b:teelsa) (r:40.24.22) (q:draft)
teelsawn = (i:1) (t:v) (w:choose) (d:of choosing between two things; the force of <sawn> is not clear from the verse) (q:draft, low confidence)
teelte = (i:1) (t:n) (w:chosen ones/the choice/the best) (d:those who are chosen or picked out, as chosen disciples or choice rams) (s:teelsate) (b:teel) (q:draft)
teelte = (i:2) (t:n) (w:those who choose) (d:with <a> before it: the people who choose something) (b:teel) (q:draft)
teeltheih = (i:1) (t:v) (w:be able to choose) (d:<teel>, choose, with <theih>, form of <thei>, can, used before <nading>) (b:teel) (q:draft)
teeltuam = (i:1) (t:n) (w:distinction/partiality) (d:<teel>, choose, with <tuam>, separate: choosing one apart from another; {teeltuam nei lo}, make no distinction) (s:deidanna/khentelna) (q:draft)
Teeltuam = (i:1) (t:adj) (w:chosen/elect) (d:<teel>, choose, with <tuam>, apart: specially chosen, said in 2 John of the lady and the church chosen by God; written with a capital) (s:teelsa/kiteelsa) (b:teeltuam) (q:draft)
teeltuamte = (i:1) (t:n) (w:chosen ones) (d:<teel>, choose, with <tuam>, apart, and the plural <te>: those specially chosen, said of the people God has chosen) (s:teelsate/teelte) (b:teeltuam) (q:draft)
teelzaw = (i:1) (t:v) (w:prefer/choose rather/choose above) (d:<teel>, choose, with <zaw>, more: choose one thing or person rather than another; what is passed over takes <sangin>, than) (s:deihzaw) (b:teel) (q:draft)
teelzo = (i:1) (t:v) (w:have chosen/choose) (d:<teel>, choose, with <zo>, showing the action is accomplished) (b:teel) (q:draft)
teem = (i:1) (t:v) (w:waste away/shrink/wither) (d:of a part of the body, waste away or shrink; said of the thigh in the curse of Numbers 5, where the NIV has the womb miscarry and older English versions have rot or fall away) (a:pawm) (q:draft, low confidence)
teembaw = (i:1) (t:n) (w:ark) (d:the great boat that Noah built to escape the flood; the same word as ship)
teembaw = (i:2) (t:n) (w:ship) (d:a large vessel that sails on the sea; also written <tembaw>) (s:gunkuangpi/tembaw)
teembaw-ahhong = (i:1) (t:phrase) (w:to the ship/to the ark) (d:<teembaw>, ship, with <ah>, to, run together with <hong>, the verb prefix for motion toward the speaker, which belongs to the following verb; apparently a spacing misprint for {teembaw-ah hong}) (q:draft, low confidence)
teembawte = (i:1) (t:n) (w:ships) (d:plural of <teembaw>, ship) (s:gunkuangpite) (b:teembaw) (r:19.104.26) (q:draft)
teemsak = (i:1) (t:v) (w:make waste away/make miscarry) (d:<teem>, waste away, with the causative <sak>: make a part of the body waste away; said of the thigh or womb in the curse of Numbers 5) (b:teem) (q:draft, low confidence)
teemsakin = (i:1) (t:v) (w:make waste away/make miscarry) (d:<teemsak>, make waste away, with the linking ending <in>, which joins it to the following verb) (b:teemsak) (q:draft, low confidence)
teen = (i:1) (t:v) (w:dwell/live/reside) (d:form of <teng> written with an apostrophe before a suffix, as in {teen’na}, dwelling place) (s:ten) (q:draft)
teen'pihna = (i:1) (t:n) (w:marrying/living together with) (d:<teen>, form of <teng>, dwell, with <pih>, together with, and the noun suffix <na>; of taking foreign women as wives) (s:ten'pihna/tenpihna) (q:draft)
teeng = (i:1) (t:v) (w:dwell/live/settle/inhabit) (d:live in a place, make one’s home there; a spelling of <teng> with a long vowel) (s:teng) (q:draft)
teengin = (i:1) (t:v) (w:dwell/live/settle) (d:<teeng> with the ending <in>, which links it to the following verb: dwelling, living there and) (s:tengin) (b:teeng) (q:draft)
teengkhawm = (i:1) (t:v) (w:live together/live with/dwell with) (d:<teeng>, live, with <khawm>, together: live in the same place as someone; <tawh> marks the companion) (s:tengkhawm/omkhawm) (b:teeng) (q:draft)
teengmite = (i:1) (t:n) (w:inhabitants/residents/dwellers) (d:<teeng>, live, with <mi>, person, and the plural <te>: the people who live in a place) (s:teengte/khuamite/tengte) (q:draft)
teengpa = (i:1) (t:n) (w:dweller/he who dwells) (d:<teeng> dwell with <pa>, marking a man: the one who lives in a place; in both verses said of God) (s:tengpa) (b:teeng) (q:draft)
teengsak = (i:1) (t:v) (w:settle/cause to dwell/let live) (d:<teeng>, live, with the causative <sak>: make or allow someone to live in a place) (s:tengsak) (b:teeng) (q:draft)
teengsate = (i:1) (t:n) (w:inhabitants/those who were living) (d:<teeng>, dwell, with <sa>, already, and <te>, those who: those who had settled in the land) (s:tengsate) (q:draft, low confidence)
teengte = (i:1) (t:n) (w:inhabitants/dwellers/those who live) (d:<teeng>, live, with the plural <te>: the people living in a place) (s:tengte/teengmite/khuamite) (b:teeng) (q:draft)
teenna = (i:1) (t:n) (w:dwelling/dwelling place/home) (d:<teen>, dwell, with the noun suffix <na>: the place where someone lives; {teenna mun} is a dwelling place) (s:tenna) (b:teen) (q:draft)
teenpih = (i:1) (t:v) (w:marry/take as wife) (d:<teen>, live, with <pih>, together with: take a woman to live with as wife) (s:tenpih) (b:teen) (q:draft)
teep = (i:1) (t:n) (w:tassel/fringe/tip) (d:the hanging end or tip of something, as the tassel on the corner of a garment; {bil teep} is the lobe of the ear) (s:teepkai/mongteep/puanmongteep) (q:draft)
teep = (i:2) (t:v) (w:suck) (d:draw out with the mouth, as a baby at the breast; {nawi teep} is suck the breast, and {guhtui teep kang} is suck the marrow dry) (s:hup) (q:draft)
teepin = (i:1) (t:v) (w:sucking/nursing) (d:<teep>, suck, with the linking ending <in>; {nawi teepin} is sucking the breast) (b:teep) (q:draft)
teepkai = (i:1) (t:n) (w:tassel/fringe) (d:<teep>, tassel, with <kai>, hang: the tassel hanging at the edge of a garment) (s:teep/puanmongteep/mongteep) (q:draft)
teepkang = (i:1) (t:v) (w:dry up/suck dry) (d:<teep>, suck, with <kang>, dry up; of grief drying up the marrow) (s:teeptum) (q:draft)
teepsak = (i:1) (t:v) (w:suckle/nurse) (d:<teep>, suck, with the causative <sak>: give the breast to a baby) (b:teep) (q:draft)
teepte = (i:1) (t:n) (w:tips/lobes) (d:<teep>, tip, with the plural <te>; {bil teepte} are the lobes of the ears and {zangvun teepte} are foreskins) (b:teep) (q:draft)
teeptum = (i:1) (t:v) (w:suck dry/consume completely/sap) (d:<teep>, suck, with <tum>, completely: use up to the last, down to the bones or all the strength) (s:teepkang) (q:draft)
tegel = (i:1) (t:adv) (w:both/the two) (d:placed after a noun or pronoun: the two of them, both together) (r:3.16.21)
teh = (i:1) (t:v) (w:measure) (d:find the length, size or amount of something; {tawi teh} is weigh) (r:26.40.8) (q:draft)
teh = (i:2) (t:n) (w:leaf) (d:the leaf of a tree or plant) (s:singteh) (q:draft)
teh = (i:3) (t:part) (d:particle with no English equivalent: after the conditional <le-uh>, if you, it links the condition to its result, and at the end of an exclamation it adds force) (r:47.11.1) (q:draft, low confidence)
Teharsha = (i:1) (t:name) (c:city) (w:Tel Harsha) (d:town in Babylonia from which some exiles returned to Judah who could not show that their families were of Israel; also written <Telharsha>) (r:15.2.59)
tehin = (i:1) (t:v) (w:measure/weigh) (d:<teh>, measure, with the linking ending <in>: measuring, by measure; {tawi tehin} is weighing on scales, by weight) (b:teh) (r:11.7.11) (q:draft)
Tehinnah = (i:1) (t:name) (c:male) (w:Tehinnah) (d:man of the tribe of Judah, son of Eshton and founder of the town of Ir Nahash) (r:13.4.12)
tehkak = (i:1) (t:v) (w:compare/liken) (d:set one beside another to see whether they are alike; the one compared with takes <tawh>, with) (s:tehpih/genteh/enkak/saikak) (q:draft)
tehkhia = (i:1) (t:v) (w:weigh out/measure out) (d:<teh>, measure, with <khia>, out: weigh out silver in payment or measure out grain) (s:tawikhai) (b:teh) (q:draft)
tehkhiate = (i:1) (t:n) (w:those who weigh out) (d:<tehkhia>, weigh out, with the plural <te>: the people who weigh out silver) (b:tehkhia) (q:draft)
tehkik = (i:1) (t:v) (w:measure again) (d:<teh>, measure, with <kik>, again; of sounding the depth of water) (b:teh) (q:draft)
tehlop = (i:1) (t:n) (w:trap/snare) (d:a trap set to catch an animal or a person; often named together with <thangzak>, snare) (s:thang/thangzak) (q:draft)
tehna = (i:1) (t:n) (w:measure/measuring tool/scales) (d:<teh>, measure, with the noun suffix <na>: a thing used for measuring length, amount or weight; {tehna piciang} is a measuring rod and {tehna khau} a measuring line) (s:tawitehna) (b:teh) (q:draft)
tehnate = (i:1) (t:n) (w:measures/scales/balances) (d:plural of <tehna>, a thing or standard for measuring length, weight or amount) (s:tawitehnate) (b:tehna) (q:draft)
tehno = (i:1) (t:n) (w:young leaf/sprout/shoot/blade) (d:<teh>, leaf, with <no>, young: the first new leaves of a plant) (b:teh) (q:draft)
tehpa = (i:1) (t:n) (w:man who has an emission) (d:<teh> with <pa>, marking a man: in {a na tui a tehpa}, the man who has an emission of semen; <teh> is used of the same thing in Leviticus 15.16) (q:draft, low confidence)
tehpih = (i:1) (t:v) (w:compare/liken/match) (d:<teh>, measure, with <pih>, together with: set beside another to compare; {tehpih theih ding om lo} means nothing can be compared, without equal) (s:tehkak/genteh/enkak) (b:teh) (r:20.8.11) (q:draft)
tehpihtheih = (i:1) (t:v) (w:can be compared/be comparable) (d:<tehpih>, compare, with <theih>, form of <thei>, can) (b:tehpih) (q:draft)
tehsuk = (i:1) (t:v) (w:measure off/measure) (d:<teh>, measure, with <suk>, downward: measure off a distance while going down along something) (b:teh) (q:draft)
tehte = (i:1) (t:n) (w:leaves) (d:plural of <teh>, leaf) (s:singtehte) (b:teh) (q:draft)
tehteng = (i:1) (t:n) (w:all the leaves/leaves) (d:<teh>, leaf, with <teng>, all) (b:teh) (q:draft)
tehtheih = (i:1) (t:adj) (w:comparable) (d:<teh>, measure or compare, with <theih>, can be: mostly negative, as {tawh tehtheih hi lo}, cannot be compared with) (b:teh) (q:draft)
tehzawh = (i:1) (t:v) (w:be able to measure) (d:<teh>, measure, with <zawh>, be able; in the verses always {tehzawh loh}, that cannot be measured) (q:draft)
tei = (i:1) (t:n) (w:spear) (d:a long weapon with a pointed head; usually named together with <lum>, shield) (s:teipi) (q:draft)
tei = (i:2) (t:v) (w:copy/transcribe) (d:write out again from another writing) (q:draft, low confidence)
tei = (i:3) (t:part) (d:placed after a verb for emphasis, indeed or at least; often before <hangin>, though it is indeed so) (q:draft, low confidence)
tei = (i:4) (t:adj) (w:clever/shrewd/intelligent) (d:quick in mind, intelligent or shrewd; {lungsim tei lo} is senseless) (s:ngiansiam) (a:hai) (q:draft, low confidence)
teibul = (i:1) (t:n) (w:spear shaft/shaft) (d:<tei>, spear, with <bul>, base: the wooden shaft of a spear) (q:draft)
teikhawh = (i:1) (t:n) (w:javelin) (d:a light throwing spear, named beside <teipi>, the spear) (s:teitangzang) (q:draft)
teikhiat = (i:1) (t:v) (w:copy out/compile) (d:<tei>, copy, with <khiat>, form of <khia>, out) (b:tei) (q:draft)
teilote = (i:1) (t:n) (w:the senseless/the stupid) (d:<tei>, clever, with <lo>, not, and <te>, those who) (s:haite) (a:pilte) (q:draft)
teina = (i:1) (t:n) (w:intelligence/cleverness) (d:<tei>, clever, with the noun suffix <na>) (a:haina) (b:tei) (q:draft)
teipak = (i:1) (t:n) (w:spearhead/spear point) (d:the iron head of a spear; <tei> is spear) (q:draft)
teipi = (i:1) (t:n) (w:spear/javelin) (d:<tei>, spear, with <pi>, big: a spear or javelin) (s:tei) (q:draft)
teipite = (i:1) (t:n) (w:spears) (d:plural of <teipi>, spear) (s:teite) (b:teipi) (r:14.26.14) (q:draft)
teitangzang = (i:1) (t:n) (w:javelin) (d:a weapon named beside <teipi>, spear; <tei> is spear) (s:teikhawh) (q:draft)
teitawi = (i:1) (t:n) (w:spearman/spear bearer) (d:<tei>, spear, with <tawi>, carry; {teitawi galkap}, soldiers who carry spears) (q:draft)
teite = (i:1) (t:n) (w:spears/lances) (d:plural of <tei>, spear) (s:teipite) (b:tei) (q:draft)
teitei = (i:1) (t:adv) (w:insistently/persistently/determinedly) (d:placed after a verb: keep on doing in spite of opposition, insist on doing; {ci teitei} is keep saying, insist) (s:tentan/teeiteei) (q:draft)
teiteina = (i:1) (t:n) (w:persistence/insistence) (d:<teitei>, persistently, with the noun suffix <na>; {nget teiteina}, persistent asking) (b:teitei) (q:draft)
teiteite = (i:1) (t:n) (w:those who persist/those who insist) (d:<teitei>, persistently, with the plural <te>: after a verb, the people who keep on doing it stubbornly) (b:teitei) (r:50.3.2) (q:draft)
tek = (i:1) (t:adv) (w:each/every one/one by one) (d:placed after a number, noun or verb to show that it applies to each one separately, as {khat tek}, one each) (s:ciat) (q:draft)
tekah = (i:1) (t:adv) (w:in each/for each) (d:<tek>, each, with the place marker <ah>: in or about each one separately) (b:tek) (q:draft)
Tekel = (i:1) (t:name) (w:Tekel) (d:Aramaic word of the writing on the wall at the feast of Belshazzar, explained by Daniel as you have been weighed on the scales and found wanting) (r:27.5.25/27.5.27)
TEKEL = (i:1) (t:n) (w:Tekel) (d:word of the writing on the wall at the feast of Belshazzar, written in capitals and explained as you have been weighed) (q:draft)
tekin = (i:1) (t:adv) (w:each/at a time) (d:<tek>, each, with the adverb ending <in>; {nih tek, nih tekin} is two by two) (b:tek) (r:41.6.7) (q:draft)
Tekoa = (i:1) (t:name) (c:city) (w:Tekoa) (d:town in the hill country of Judah south of Bethlehem, home of the prophet Amos and of the wise woman whom Joab sent to David) (r:10.23.26/14.11.6)
tektek = (i:1) (t:adv) (w:more and more/steadily/step by step) (d:placed after a verb or describing word: the state increases or continues by degrees) (s:semsem) (q:draft, low confidence)
tektek = (i:2) (t:adv) (w:very/own) (d:emphasises the word before it: the very one, one's own, as {keima mit tektek tawh}, with my own eyes) (s:teekteek) (q:draft, low confidence)
tektekin = (i:1) (t:adv) (w:exactly/just as/precisely) (d:after <bang> or a verb: exactly as, in the very way; {muh tektekin} is before one's very eyes) (s:teekteekin) (b:tektek) (r:15.6.13) (q:draft)
tel = (i:2) (t:adv) (w:clearly/plainly) (d:mostly as {tel tak} or {tel takin}, clearly, plainly, for certain) (s:teltakin/kitel) (r:54.4.1) (q:draft)
Telabib = (i:1) (t:name) (c:place) (w:Tel Aviv) (d:place in Babylonia by the Kebar River where Ezekiel stayed among the Jewish exiles) (r:26.3.15)
Telah = (i:1) (t:name) (c:male) (w:Telah) (d:man of the tribe of Ephraim, son of Resheph and ancestor of Joshua) (r:13.7.25)
Telaim = (i:1) (t:name) (c:place) (w:Telaim) (d:place in the south of Judah where Saul gathered his army against the Amalekites) (r:9.15.4)
Telassar = (i:1) (t:name) (c:place) (w:Tel Assar) (d:place in Mesopotamia where the people of Eden lived, conquered by the kings of Assyria) (r:12.19.12/23.37.12)
telcianna = (i:1) (t:n) (w:assurance/certainty) (d:being clearly sure of something) (s:uphuaina) (q:draft)
teldot = (i:1) (t:v) (w:examine/question/inquire into) (d:<tel>, clearly, with <dot>, ask: question closely, look into; of a fault, call to account or rebuke) (s:kantel/sittel) (q:draft)
teldotna = (i:1) (t:n) (w:examination/questioning/calling to account) (d:<teldot>, examine, with the noun suffix <na>) (s:sittelna/thudotna) (b:teldot) (q:draft)
teldotte = (i:1) (t:n) (w:those who examine/those who question) (d:<teldot>, examine, with <te>, those who) (b:teldot) (q:draft)
Telem = (i:1) (t:name) (c:land) (w:Telem) (d:town in the far south of Judah; also the name of a gatekeeper in the time of Ezra) (r:6.15.24)
telh = (i:1) (t:v) (w:progress/advance/prosper) (d:of work or of a person’s way, go forward well; {ma telh} is make progress) (q:draft, low confidence)
telhak = (i:1) (t:adj) (w:hard to understand/difficult to grasp) (d:<tel>, understand, with <hak>, hard: difficult to understand) (s:theihhak/theihtelhak) (q:draft)
Telharsha = (i:1) (t:name) (c:city) (w:Tel Harsha) (d:town in Babylonia from which some exiles returned to Judah who could not show that their families were of Israel) (r:15.2.59/16.7.61)
telhsak = (i:1) (t:v) (w:make prosper/give success/cause to advance) (d:<telh>, progress, with the causative <sak>; {ma telhsak} is make someone go forward, give success) (s:daupaisak/tuahphasak) (b:telh) (q:draft)
telin = (i:1) (t:adv) (w:clearly/thoroughly/with understanding) (d:<tel> clearly, with the adverb ending <in>; after <en>, look, or <thei>, know, look into or know a thing thoroughly) (s:teltakin) (b:tel) (q:draft)
telkheh = (i:1) (t:v) (w:make plain/make clear/expose) (d:set a matter out openly so that it is clearly understood) (s:laktel/pholak) (q:draft)
telkhehna = (i:1) (t:n) (w:making plain/plain speaking) (d:<telkheh>, make plain, with the noun suffix <na>) (b:telkheh) (q:draft)
tellam = (i:1) (t:n) (w:understanding) (d:<tel>, understand, with <lam>: the fact that someone understands) (q:draft, low confidence)
Telmelah = (i:1) (t:name) (c:city) (w:Tel Melah) (d:place in Babylonia from which exiles returned to Judah who could not show that their families were of Israel) (r:15.2.59/16.7.61)
telmuh = (i:1) (t:v) (w:see clearly/see through) (d:<tel>, clearly, with <muh>, the form of <mu>, see: see something plainly, as God sees the thoughts of people) (s:muhtel/mutel) (q:draft)
telna = (i:1) (t:n) (w:understanding/discernment/insight) (d:<tel>, understand, with the noun suffix <na>: understanding or insight; {thu telna} is a good grasp of matters) (s:theihtelna/thutelna/teltheihna) (a:mawlna) (b:tel) (q:draft)
telna = (i:2) (t:n) (w:choosing/choice) (d:{a telna mun} is the place he chooses; the word is <teelna>, from <teel>, choose, written here with one e) (s:teelna) (q:draft, low confidence)
telnasa = (i:1) (t:adj) (w:chosen) (d:{ka telnasa mun}, the place I have chosen; apparently the word <teelnasa>, from <teel>, choose, written with one e) (s:teelnasa/teelsa) (b:telna) (q:draft, low confidence)
telnop = (i:1) (t:adj) (w:easy to understand/plain/clear) (d:<tel>, understand, with <nop>, easy or pleasant: easy to understand) (a:telhak/theihhak) (q:draft)
telsak = (i:1) (t:v) (w:make understand/show clearly) (d:<tel>, understand, with the causative <sak>; {theih telsak}, make someone know clearly) (s:theitelsak/laktel) (b:tel) (q:draft)
teltakin = (i:1) (t:adv) (w:clearly/plainly/for certain) (d:<tel>, clear, with <takin>: in a way that is plain and sure; used with <gen>, say, and <thei>, know) (s:kitelin/telin/ciantakin) (b:tel) (r:20.11.21) (q:draft)
teltakpi = (t:see) <teltakpi-in>
teltakpi-in = (i:1) (t:adv) (w:very clearly/for certain) (d:<tel>, clearly, with <takpi>, truly, and the ending <in>: quite clearly, beyond any doubt) (s:teltakin/ciantakin) (q:draft)
telthei = (i:1) (t:v) (w:be able to understand/can understand) (d:<tel>, understand, with <thei>, be able) (s:theithei/theizo) (b:tel) (q:draft)
teltheih = (i:1) (t:v) (w:understand/be able to understand) (d:<tel>, understand, with <theih>, can: the form of <telthei> used before <nading>, <ding> and <zawhna>) (s:theihtheih/theihtel) (b:tel) (q:draft)
teltheihna = (i:1) (t:n) (w:understanding/ability to understand/discernment) (d:<tel> understand, with <theih>, be able, and the noun suffix <na>, the ability to understand) (s:theihtelna/thutelna/telna) (b:teltheih) (q:draft)
telzaw = (i:1) (t:v) (w:understand better/understand more) (d:<tel> understand with the comparative <zaw>, used with <sangin> than) (b:tel) (q:draft)
telzawh = (i:1) (t:v) (w:be able to understand/can understand) (d:<tel> understand with <zawh>, form of <zo> be able) (s:telthei/theizo) (q:draft)
Tema = (i:1) (t:name) (c:male) (w:Tema) (d:son of Ishmael; also the people and the region of Arabia named after him) (r:1.25.15)
Temah = (i:1) (t:name) (c:male) (w:Temah) (d:ancestor of a family of temple servants who returned from the exile) (r:15.2.53/16.7.55)
Teman = (i:1) (t:name) (c:male) (w:Teman) (d:son of Eliphaz and grandson of Esau, a chief of Edom; also a region of Edom, the home of Eliphaz the friend of Job) (r:1.36.11/1.36.42)
tembaw = (i:1) (t:n) (w:ship/boat) (d:a ship or large boat that goes on the sea; also written <teembaw>) (s:teembaw/gunkuangpi) (q:draft)
Temelah = (i:1) (t:name) (c:city) (w:Tel Melah) (d:another spelling of <Telmelah>, a place in Babylonia from which exiles returned to Judah) (r:15.2.59/16.7.61)
Temeni = (i:1) (t:name) (c:male) (w:Temeni) (d:son of Ashhur and Naarah, of the tribe of Judah) (r:13.4.6)
temhiam = (i:1) (t:n) (w:sharp knife/sharp blade/razor) (d:<tem> knife with <hiam> sharp; {mulkiatna temhiam} is a sharpened razor) (q:draft)
temkawi = (i:1) (t:n) (w:pruning knife/pruning hook/curved knife) (d:<tem>, knife, with <kawi>, curved: a curved knife for pruning; {singhiang heuhna temkawi} is a pruning hook) (r:33.4.3) (q:draft)
temkawite = (i:1) (t:n) (w:pruning hooks/pruning knives) (d:<temkawi>, pruning knife, with the plural <te>) (b:temkawi) (q:draft)
ten = (i:1) (t:v) (w:dwell/live/settle) (d:form of <teng>, live, written {ten’} before words such as <lai>, <hun> and <khit> and before a suffix; {ten’na} is a dwelling place and {ten’pih} is live with or marry) (s:teen) (r:11.8.49) (q:draft)
ten'pihna = (i:1) (t:n) (w:marrying/marriage) (d:<ten>, dwell, with <pih>, together with, and the noun ending <na>: the taking of a woman to live with as wife) (s:tenpihna/teen'pihna/kitenna) (a:kimakna) (q:draft)
teng = (i:2) (t:v) (w:reside/stay/inhabit) (d:stay as a resident in a town, a land or a house)
tenga = (i:1) (t:adj) (w:all/throughout/whole) (d:<teng> all, the whole of, with the linking <a>; follows a noun phrase: {sung tenga} is throughout, in all of) (q:draft, low confidence)
tengah = (i:1) (t:prep) (w:throughout/all over/all round/in every part of/all through/right through) (d:<teng>, all, with the place marker <ah>: in every part of a land or place) (s:sungtengah) (r:41.1.39)
tengbek = (i:1) (t:adv) (w:only that much/only this/all) (d:<teng> all of it with <bek> only; {tua tengbek hi lo} is that is not all) (q:draft)
tengin = (i:1) (t:v) (w:dwell/dwelling) (d:<teng>, live, with the linking ending <in>: dwelling in a place, after which the next action follows) (s:teengin) (b:teng)
tengin = (i:2) (t:v) (w:live/living) (d:connective form of <teng>, live: living somewhere while something else is said of the same person) (b:teng)
tengkeek = (i:1) (t:part) (d:after a clause, <teng>, all that, with <keek>: {ka hih nop loh tengkeek}, the very things I do not want to do; the force of <keek> is not clear from the verse) (q:draft, low confidence)
tengkha = (i:1) (t:v) (w:live/happen to live/get to live) (d:<teng> live with <kha>, showing that the thing comes to happen; with <kei>, never get to live in) (q:draft)
tengkhawm = (i:1) (t:v) (w:live together/live with/dwell with) (d:<teng>, live, with <khawm>, together) (s:teengkhawm/omkhawm) (b:teng) (q:draft)
tengkhawmin = (i:1) (t:v) (w:live together with/dwell with) (d:<tengkhawm> live together with the linking ending <in>: living with someone, and) (s:omkhawmin) (b:tengkhawm) (q:draft)
tengkhia = (i:1) (t:v) (w:single out/pick out/select/separate) (d:choose and set apart from among others, for good or for punishment) (s:teelkhia/khenkhia) (q:draft)
tengkik = (i:1) (t:v) (w:live again/resettle/settle again) (d:<teng> live, dwell, with <kik>, again or back) (b:teng) (q:draft)
tengkikin = (i:1) (t:v) (w:live again/be inhabited again) (d:<tengkik>, settle again, with the linking <in>) (b:tengkik) (q:draft)
tenglai = (i:1) (t:v) (w:still live/go on living/remain) (d:<teng> live with <lai> still: continue to live or stay in a place) (s:omlai) (q:draft)
tengpa = (i:1) (t:n) (w:dweller/he who dwells) (d:<teng> live with <pa>, marking a man: the one who lives in a place; in both verses said of God) (s:teengpa) (b:teng) (q:draft)
tengsak = (i:1) (t:v) (w:settle/cause to live/make dwell) (d:<teng>, live, with the causative {-sak}: give someone a place to live) (s:teengsak/tensak) (a:hawlkhia) (b:teng) (q:draft)
tengsakin = (i:1) (t:v) (w:let live/settle) (d:<tengsak> let live or settle with the linking ending <in>: letting someone live there, and) (b:tengsak) (q:draft)
tengsakkik = (i:1) (t:v) (w:settle again/make dwell again) (d:<tengsak>, cause to live, with <kik>, again) (b:tengsak) (q:draft)
tengsakkikin = (i:1) (t:v) (w:resettle/make dwell again) (d:<tengsakkik> with the linking <in>) (b:tengsakkik) (q:draft)
tengsate = (i:1) (t:n) (w:settlers/inhabitants) (d:those who had already settled in a place: <teng> live, with <sa> already and the plural <te>) (s:teengsate) (q:draft)
tengsuak = (i:1) (t:v) (w:live on/dwell permanently) (d:<teng> live with <suak> through, onward: go on living in a place for good) (s:tensuak) (q:draft)
tengtawm = (i:1) (t:v) (w:live of one's own accord/settle voluntarily) (d:<teng> live with <tawm>, which shows that the subject acts on his own) (q:draft)
tengte = (i:1) (t:n) (w:inhabitants/those who live) (d:<teng> with plural {-te}, the people living in a place; the spelling of the 1932 text for <teengte>) (s:teengte/khuamite/teengmite) (b:teng) (r:13.8.13) (q:draft)
tengun = (i:1) (t:adv) (w:as long as/all the while) (d:<teng>, all, the whole of, with the ending <un> used with a plural subject; after <lai> or <sung>, during all the time that) (q:draft, low confidence)
tengzo = (i:1) (t:v) (w:manage to live/be able to dwell) (d:<teng> live with <zo> be able, succeed) (s:tentheih) (b:teng) (q:draft)
tenin = (i:1) (t:v) (w:living/dwelling) (d:<ten> live with the connective <in>: living, and then) (b:ten) (q:draft)
tenkhak = (i:1) (t:v) (w:live/happen to live) (d:form of <tengkha> used before <sangin>, than: <ten> is the form of <teng> live, <khak> is happen to) (q:draft)
tenkhop = (i:1) (t:v) (w:live together/live with/dwell together) (d:form of <tengkhawm>, live together, used before <ding>, <sangin> and <khit>) (q:draft)
tenma = (i:1) (t:v) (w:before living) (d:<ten> live with <ma> before: before he lived or settled) (q:draft)
tenna = (i:1) (t:n) (w:dwelling/dwelling place) (d:the place where one lives or has lived) (s:teenna) (b:ten) (r:1.37.1) (q:draft)
tennasa = (i:1) (t:n) (w:former dwelling/place once lived in) (d:<tenna>, dwelling place, with <sa>, already done: the place where one has lived) (b:tenna) (q:draft)
tennopna = (i:1) (t:n) (w:wish to live) (d:<ten> live, <nop> want, with the noun suffix <na>; {na tennopna mun} is the place where you want to live) (q:draft)
tenpakna = (i:1) (t:n) (w:temporary stay/sojourn) (d:<ten> live, <pak> for a short while, with the noun suffix <na>: staying for a time, as nomads do) (s:ompakna) (q:draft)
tenpih = (i:1) (t:v) (w:marry/take as wife) (d:live together with someone as husband and wife; <ten> with the ending <pih>, do together with) (s:teenpih/kiteng) (b:ten) (r:15.10.17) (q:draft)
tenpihin = (i:1) (t:v) (w:marrying/taking as wife) (d:<tenpih> marry, live with as spouse, with the linking suffix {-in}) (s:kitengin) (b:tenpih) (q:draft)
tenpihkim = (i:1) (t:v) (w:all marry) (d:<tenpih> live with, marry, with <kim> all, every one: each of them in turn married her) (q:draft)
tenpihna = (i:1) (t:n) (w:marrying/marriage) (d:<tenpih>, marry, with the noun suffix <na>: the act or fact of taking someone as wife) (s:kitenna/ten'pihna/teen'pihna) (a:kimakna/makna) (b:tenpih) (r:42.3.19) (q:draft)
tenpihte = (i:1) (t:n) (w:those who marry) (d:<tenpih> marry with the plural <te>: those who take someone as wife) (s:kiteengte) (b:tenpih) (q:draft)
tensak = (i:1) (t:v) (w:settle/cause to dwell) (d:<ten> dwell, with <sak>, cause, make someone or something live in a place; in Daniel 11.17 give in marriage) (s:tengsak/teengsak) (b:ten) (q:draft)
tensakna = (i:1) (t:n) (w:causing to live/settling) (d:<tensak> make live with the noun suffix <na>: the fact of having made someone live somewhere) (b:tensak) (q:draft)
tensuak = (i:1) (t:v) (w:live on/dwell permanently) (d:<ten> live with <suak> through, onward: go on living in a place; another form of <tengsuak>) (s:tengsuak) (q:draft, low confidence)
tentan = (i:1) (t:adv) (w:stubbornly/obstinately/persistently) (d:placed after a verb: keep on doing it in a hard, unyielding way, as in {zui tentan}, follow stubbornly) (s:teitei) (q:draft)
tentanin = (i:1) (t:adv) (w:persistently/firmly/stubbornly) (d:placed after a verb: keeping on with it without letting go, as following one's own will or holding oneself in) (b:tentan) (q:draft, low confidence)
tentheih = (i:1) (t:v) (w:be able to dwell/be able to live) (d:<ten>, dwell, with <theih>, be able; {na tentheih nadingun}, so that you may live) (s:tengzo) (b:ten) (q:draft)
tentheihna = (i:1) (t:n) (w:being able to stay) (d:<tentheih> be able to live with the noun suffix <na>; {a tentheihna ding mun} is a place where they can stay) (b:tentheih) (q:draft)
tep = (i:1) (t:v) (w:sap/drain/consume) (d:in {tep tum}, use up completely, said of foreigners who eat away a people's strength) (q:draft, low confidence)
tep = (i:2) (t:v) (w:join/couple) (d:in {tep nadingin singte}, timber for the joists or couplings that hold a building together) (q:draft, low confidence)
tepcip = (i:1) (t:v) (w:trap/catch fast/ensnare) (d:of a snare, close on and hold tight; contains <cip> tightly) (s:awksak) (q:draft)
Terah = (i:1) (t:name) (c:male) (w:Terah) (d:father of Abraham, Nahor and Haran; also a camping place of Israel in the wilderness) (r:1.11.26/1.11.27)
terebinth = (i:1) (t:n) (c:plant) (w:terebinth) (d:a tree, the English name kept in the text; {terebinth kung} is a terebinth tree) (q:draft)
Teresh = (i:1) (t:name) (c:male) (w:Teresh) (d:one of two officers of King Xerxes who guarded the doorway and plotted to kill the king) (r:17.2.21/17.6.2)
Tertias = (i:1) (t:name) (c:male) (w:Tertius) (d:the scribe who wrote down the letter to the Romans for Paul) (r:45.16.22)
Tertullas = (i:1) (t:name) (c:male) (w:Tertullus) (d:lawyer who presented the case against Paul before the governor Felix) (r:44.24.1/44.24.2)
tha = (i:1) (t:n) (w:strength/power/energy) (d:the strength or energy of the body; {tha neih khempeuh tawh} is with all the strength one has, and {tha neem} is lose strength) (s:thahatna/thatang/hatna) (a:thanemna) (q:draft)
thacial = (i:1) (t:n) (w:wages/hire/reward) (d:pay for labour; {thacial nasempa} is a hired labourer) (s:thaman) (q:draft)
thacialte = (i:1) (t:n) (w:hired men/hired workers) (d:<thacial> wages with the plural <te>: those who work for wages) (s:cialte) (b:thacial) (q:draft)
thacingin = (i:1) (t:adv) (w:courageously/vigorously) (d:{thacing}, full of strength, with the connective <in>: being vigorous as a man is) (q:draft, low confidence)
thacingzaw = (i:1) (t:adj) (w:stronger/sturdier) (d:{thacing}, full of strength, with <zaw> more: of better build or greater vigour) (s:thahatzaw/hatzaw) (q:draft, low confidence)
thadah = (i:1) (t:adj) (w:lazy/idle/slothful) (d:unwilling to work; {mi thadah} is a lazy person) (a:thanuam/kizen)
thadahhuai = (i:1) (t:adj) (w:wearisome/loathsome/detestable) (d:<thadah> lazy, unwilling, with <huai> causing: such that one has no wish for it; {zak thadahhuai sa} is find it loathsome to hear) (s:kihhuai/muhdahhuai) (q:draft)
thadahin = (i:1) (t:adv) (w:lazily/idly) (d:<thadah> lazy with the adverb ending <in>) (a:hahkatin) (b:thadah) (q:draft)
thadahna = (i:1) (t:n) (w:laziness/sloth/idleness) (d:<thadah>, lazy, with the noun suffix <na>: unwillingness to work) (a:thanuamna/hahkatna) (b:thadah) (q:draft)
thadahpa = (i:1) (t:n) (w:sluggard/lazy man) (d:<thadah>, lazy, with <pa> marking a man: a lazy man, mostly as {mi thadahpa}) (a:hahkatpa) (b:thadah)
thadahpa = (i:2) (t:n) (w:idle/idler) (d:a man who is idle and will not work) (b:thadah)
thadahte = (i:1) (t:n) (w:the lazy/sluggards/lazy people) (d:<thadah> lazy with <te>: those who are lazy) (a:thanuamte/thunuamte) (b:thadah) (q:draft)
Thaddeas = (i:1) (t:name) (c:male) (w:Thaddaeus) (d:one of the twelve apostles of Jesus) (r:41.3.18/40.10.3)
thadim = (i:1) (t:v) (w:be vigorous/be strong/be refreshed) (d:be full of strength; with <sak>, strengthen or refresh someone) (q:draft)
thadimsak = (i:1) (t:v) (w:strengthen/refresh/invigorate) (d:<thadim>, be full of strength, with <sak>, cause) (s:thahatsak/hatsak/thakhauhsak) (b:thadim) (q:draft)
thaginalote = (i:1) (t:n) (w:the weak/those who are feeble) (d:<tha> strength, <gina> adequate, <lo> not, with the plural <te>: those whose strength is not enough) (s:thanemte/zawngkhalte) (a:thahatte/mihatte) (q:draft)
thagol = (i:1) (t:adj) (w:huge/of great stature) (d:said of a very tall and big man) (s:thalian) (q:draft, low confidence)
thagolte = (i:1) (t:n) (w:giants) (d:plural of <thagol>, big and strong; {mi thagolte}, the giants, where the NIV has the name Rapha) (s:mithagolte) (b:thagol) (q:draft)
thagui = (i:1) (t:n) (w:sinew/tendon/muscle) (d:a sinew or tendon, the tough cord that joins muscle to bone; {khel thagui} is the tendon of the hip) (q:draft)
thaguite = (i:1) (t:n) (w:sinews/tendons) (d:<thagui>, sinew, with the plural <te>; {guh leh thaguite} is bones and sinews) (b:thagui) (q:draft)
Thagum = (i:1) (t:n) (w:might/force/strength) (d:bodily strength or force, from <tha>, strength; written with a capital at the start of a sentence, and paired in the verse with <vangliatna>, power) (s:thahatna/thatang) (q:draft)
thah = (i:1) (t:n) (w:kill) (d:form of <that>, kill, used before <ding>, <bangin>, <lai> and the noun endings) (b:that) (r:1.4.15)
thah = (i:2) (t:n) (w:killing) (d:the act of killing, in phrases such as {thah khitna}, the fact of having killed, and {thah lai-in}, while killing) (s:thahna/thatna) (b:that)
thahat = (i:1) (t:adj) (w:mighty) (d:<tha>, strength, with <hat>, strong: having great power, said of God and of warriors) (s:vanglian/hat) (a:thanem/thaneem) (r:1.6.4)
thahatin = (i:1) (t:adv) (w:strongly/with strength/firmly) (d:<thahat>, strong, with the adverb ending <in>: with strength, firmly; {thahatin om} is be strong) (s:khauhtakin) (b:thahat) (r:49.6.10) (q:draft)
thahatna = (i:1) (t:n) (w:strength/power/might) (d:<thahat>, strong, with the noun suffix <na>: the strength or power of God, a person or an animal) (s:hatna/vangliatna/thatang/tha) (a:thanemna/thaneemna) (b:thahat) (q:draft)
Thahatna = (i:1) (t:n) (w:strength) (d:<thahatna>, strength, written with a capital at the start of a sentence or as a name by which God is addressed, my Strength) (a:thanemna) (b:thahatna) (r:19.59.17) (q:draft)
thahatnate = (i:1) (t:n) (w:mighty deeds/achievements/strength) (d:<thahatna>, strength, with the plural <te>: deeds or displays of strength, as in {ama thahatnate khempeuh}, all his achievements) (s:hatnate/vangliatnate) (b:thahatna) (q:draft)
thahatnateng = (i:1) (t:n) (w:all the strength) (d:<thahatna>, strength, with <teng>, all of: the whole of the strength of someone) (b:thahatna) (q:draft)
thahatpa = (i:1) (t:n) (w:strong man/mighty man/warrior) (d:<thahat>, strong, with <pa>, marking a man: a strong or mighty man, mostly as {mi thahatpa}) (s:hatpa/galhangpa) (b:thahat) (r:7.14.14) (q:draft)
thahatpen = (i:1) (t:adj) (w:strongest/most powerful) (d:<thahat>, strong, with <pen>, most: strongest; {a thahatpen lai takin} is at the height of its power) (s:hatpen) (b:thahat) (q:draft)
thahatpente = (i:1) (t:n) (w:the strongest/the mightiest) (d:<thahatpen>, strongest, with plural <te>; {galkap thahatpente}, the best troops) (s:hatpente) (b:thahatpen) (q:draft)
thahatsak = (i:1) (t:v) (w:strengthen/make strong) (d:<thahat>, strong, with <sak>, cause: give strength to a person, a people or the churches) (s:hatsak/thakhauhsak/khauhsak) (a:thanemsak/thaneemsak) (b:thahat) (q:draft)
thahatsakin = (i:1) (t:v) (w:strengthening/making strong) (d:<thahatsak>, make strong, with the linking ending <in>: strengthening, and then) (s:thakhauhsakin) (b:thahatsak) (q:draft)
thahatsakna = (i:1) (t:n) (w:strengthening) (d:<thahatsak> make strong with the noun suffix <na>: the act of giving strength, also comforting) (s:thakhauhsakna/khauhsakna) (b:thahatsak) (q:draft)
thahatsakpa = (i:1) (t:n) (w:strengthener/one who gives strength) (d:<thahatsak> make strong with <pa> marking a male person: he who strengthens) (b:thahatsak) (q:draft)
thahatte = (i:1) (t:n) (w:the strong/the mighty/mighty men/warriors) (d:<thahat>, strong, with the plural <te>: strong or mighty people, also warriors; often {mi thahatte}) (s:hatte/mihatte/galhangte) (a:thanemte/thaneemte) (b:thahat) (q:draft)
thahatthu = (i:1) (t:n) (w:force/violence) (d:<thahat> strong with <thu> matter: the use of force; {thahatthu ciam} is try by force) (s:zawhthawh) (q:draft, low confidence)
thahatzaw = (i:1) (t:adj) (w:stronger/mightier) (d:<thahat>, strong, with <zaw>, more: stronger; the thing compared is followed by <sangin>, than) (s:hatzaw) (b:thahat) (q:draft)
thahatzawte = (i:1) (t:n) (w:the stronger ones) (d:<thahatzaw>, stronger, with the plural <te>: the stronger ones, in the verse the stronger animals of a flock) (b:thahatzaw) (q:draft)
thahin = (i:1) (t:v) (w:being killed/slain) (d:<thah> kill with the connective <in>; {thahin tuk} is fall slain) (b:thah) (q:draft)
thahkha = (i:1) (t:v) (w:to cause the death) see <thah> and <kha>
thahkhak = (i:1) (t:v) (w:to cause the death) (d:<thah>, kill, with <khak>, happen to: come to kill; mostly in {thahkhak loh nadingin}, so that he would not kill) see <thah> and <khak>
thahkhawm = (i:1) (t:v) (w:kill together with/put to death with) (d:<thah>, form of <that>, kill, with <khawm>, together: put to death together with others) (s:thatkhawm) (b:thah) (q:draft)
thahkhit = (i:1) (t:v) (w:have killed/finish killing) (d:<thah>, form of <that>, kill, with <khit>, finish; before <ciang> or <mateng>, after or until someone has been killed) (q:draft)
thahloh = (i:1) (t:v) (w:not kill) (d:<thah>, kill, with <loh>, not; {thahloh nading}, so as not to kill) (q:draft)
thahlohna = (i:1) (t:n) (w:not killing/sparing) (d:<thahloh> not kill with the noun ending <na>: the fact of not killing someone) (b:thahloh) (q:draft)
thahlup = (i:1) (t:v) (w:kill/put to death/slaughter) (d:form of <thatlum>, kill, used before <ding>, <khit>, <nang> and <sak>) (s:thatlum) (a:nungtasak) (r:40.26.66) (q:draft)
thahlupsak = (i:1) (t:v) (w:have killed/slaughter/kill) (d:<thahlup>, kill, with the causative <sak>: cause to be killed, as a king who has the sons of Zedekiah killed before his eyes) (s:thatlumsak/thatsak) (b:thahlup) (q:draft)
