sumbawm = (i:1) (t:n) (w:purse/money bag/bag) (d:a bag in which money or gold is carried) (s:khutkhai) (r:42.22.36) (q:draft)
Sumbuk = (i:1) (t:n) (w:market/marketplace/forum) (d:<sumbuk> written with a capital, at the start of a sentence and in the place name {Appias Sumbuk}, the Forum of Appius) (b:sumbuk) (q:draft)
sumbuka = (i:1) (t:n) (w:in the market/of the market) (d:<sumbuk> market with <a>, in or of) (b:sumbuk) (q:draft)
sumbukah = (i:1) (t:adv) (w:in the marketplace/at the market) (d:<sumbuk> marketplace with the place marker <ah>) (b:sumbuk) (q:draft)
sumbukte = (i:1) (t:n) (w:merchants/traders) (d:<sumbuk>, market, with the plural <te>: the people of the market, merchants) (s:sumbawlte) (b:sumbuk) (q:draft)
Sumdeihna = (i:1) (t:n) (w:love of money) (d:<sum> money with <deihna> desire) (q:draft)
sumdek = (i:1) (t:v) (w:bargain/haggle) (d:beat down a price; {sumdek siam} is good at bargaining) (q:draft, low confidence)
Sumduh = (i:1) (t:v) (w:crave money/love money) (d:<sum> money with <duh> crave; {sumduh luatna} is too great a love of money) (q:draft)
sumgolh = (i:1) (t:n) (w:bribe) (d:money or a gift given to turn a judgment) (s:golhguk) (q:draft)
sumgu = (i:1) (t:v) (w:steal money/steal) (d:<sum> money with <gu> steal; {mi sumgu mi} is a thief) (q:draft, low confidence)
sumgum = (i:1) (t:n) (w:treasure/money) (d:money or wealth that is laid up; in Deuteronomy 23.19 money that is lent) (q:draft, low confidence)
sumh = (i:1) (t:v) (w:lose/suffer loss) (d:be left without something one had, as animals that die or a slave who dies) (a:ngah) (q:draft)
sumhau = (i:1) (t:adj) (w:rich/wealthy) (d:having much money, from <sum> money and <hau> rich) (s:hau/sumnei) (a:zawng) (r:59.1.10) (q:draft)
sumhaupa = (i:1) (t:n) (w:rich/rich man) (d:<sumhau>, rich, with <pa> marking a man: a rich man) (s:mihaupa) (a:mizawngpa) (b:sumhau)
sumhaupa = (i:2) (t:n) (w:wealthy/wealthy man) (b:sumhau)
sumhaupa = (i:3) (t:n) (w:cash rich) (b:sumhau)
sumhaute = (i:1) (t:n) (w:the rich/rich people) (s:mihaute/haute) (a:mizawngte) (b:sumhau) (q:draft)
sumin = (i:1) (t:adv) (w:for money/with money) (d:<sum> money with the marker <in>) (b:sum) (q:draft)
sumit = (i:1) (t:v) (w:put out/extinguish/snuff out) (d:make a lamp or fire go out) (s:sukmit/mitsak/phelh) (a:kuangsak) (q:draft)
sumkeempa = (i:1) (t:n) (w:steward/foreman/paymaster) (d:<sum> money with <keem> keep and <pa> man, the man who keeps the money and pays the workers) (s:sumkempa) (q:draft)
sumkem = (i:1) (t:n) (w:treasurer/keeper of money) (d:one who keeps the money of a group, a king or a city; <sum>, money, with <kem>, keep) (s:sumkempa) (r:15.1.8/43.13.29) (q:draft)
sumkempa = (i:1) (t:n) (w:treasurer/steward/manager) (d:a man who keeps and manages the money or goods of his master; <pa> marks a man) (s:sumkeempa) (b:sumkem) (q:draft)
sumkep = (i:1) (t:n) (w:stewardship/management of money) (d:the keeping of another person's money and goods; <sum>, money, with <kep>, keep) (s:Sumkepna) (q:draft)
Sumkepna = (i:1) (t:n) (w:stewardship/management of money) (d:<sum> money with <kepna> keeping; {sumkepna za} is the post of manager) (s:sumkep) (q:draft)
sumkheekte = (i:1) (t:n) (w:money changers) (d:<sum> money with <kheek> exchange and the plural <te>) (s:sumkhekte) (q:draft)
sumkhek = (i:1) (t:v) (w:exchange/change money) (d:change money of one kind for another; {sumkhek nasem mite} are the money changers) of currency
Sumkhek = (i:1) (t:v) (w:exchange money) (d:<sum> money with <khek> change; {sumkhek nasem mite} are the money changers) (b:sumkhek) (q:draft)
sumkhekna = (i:1) (t:n) (w:exchange/money changing) (d:<sumkhek>, change money, with the noun suffix <na>: the changing of money; {sumkhekna sabuai} is the table of a money changer) (b:sumkhek) of currency
sumkhekte = (i:1) (t:n) (w:money changers) (d:<sumkhek>, change money, with the plural <te>: the people who change money for others, as in the temple courts) (s:sumkheekte) (b:sumkhek) (q:draft)
sumkholna = (i:1) (t:n) (w:treasury/storeroom/store of treasure) (d:<sum>, money, with <kholna>, a place for storing: the place where money or valuables are kept, as the temple treasury or a storeroom; also the store of good or evil in the heart) (s:sumkoihna/sumkuang) (q:draft)
sumkhotte = (i:1) (t:n) (w:money/proceeds) (d:the money a person has got, in this verse the money from selling possessions; a plural form with <te>) (s:sumte) (q:draft, low confidence)
sumkoihna = (i:1) (t:n) (w:treasury/storehouse) (d:<sum>, money, with <koihna>, a place for keeping: the treasury or storehouse where money and valuables are kept) (s:sumkholna/vankoihna/sumkuang) (q:draft)
sumkoihnate = (i:1) (t:n) (w:treasuries/storehouses) (d:<sumkoihna>, treasury, with the plural <te>: the places where money and valuables are kept) (s:vankoihnate) (b:sumkoihna) (q:draft)
sumkuang = (i:1) (t:n) (w:treasury/offering chest/money box) (d:<sum>, money, with <kuang>, chest or trough: the chest into which money offerings are put; {biakinn sumkuang} is the temple treasury) (s:sumkholna/sumkoihna) (q:draft)
sumkuangte = (i:1) (t:n) (c:animal) (w:doves/turtledoves) (d:a migrating bird, plural; named where the NIV has dove, swift and thrush, so the exact bird is not certain) (q:draft, low confidence)
sumlakte = (i:1) (t:n) (w:money received/money collected) (d:<sum> money with <lak> take and the plural <te>, the sums of money that someone takes in) (q:draft, low confidence)
