khasak = (i:2) (t:v) (w:let bid/allow to say) (d:with <mangpha>, farewell: {mangpha hong khasak} means let me say goodbye) (q:draft, low confidence)
khasawm = (i:1) (t:n) (w:ten months) (d:<kha> month with <sawm> ten; {khasawm leh khanih}, ten months and two, is twelve months) (q:draft)
khasia = (i:1) (t:v) (w:be dismayed/be troubled/grieve/be disheartened) (d:be troubled or saddened in spirit, from <kha> spirit and <sia> bad) (s:lungkham/lungkia) (q:draft)
khasiat = (i:1) (t:v) (w:pity/have compassion on/spare) (d:feel pity for someone and so spare them; {ka khasiat kei ding hi} is I will not pity) (s:hehpih/khasiatpih) (b:khasia) (q:draft)
khasiathuai = (i:1) (t:adj) (w:pitiable/pitiful) (d:<khasiat> pity with <huai>, worthy of: deserving pity; {khasiathuai sa} is feel pity for, be grieved over) (s:hehpihhuai) (q:draft)
khasiatpih = (i:1) (t:v) (w:pity/show mercy to/have compassion on) (d:<khasiat> pity with <pih>, toward someone) (s:hehpih/khasiat) (b:khasiat) (q:draft)
khasiatpihnate = (i:1) (t:n) (w:sympathies/condolences) (d:<khasiatpih> pity with the noun suffix <na> and the plural <te>: expressions of sympathy) (b:khasiatpih) (q:draft)
khasiatsak = (i:1) (t:v) (w:grieve/hurt/wrong) (d:<khasiat>, be sad, with <sak>, cause: make someone sad; the English has take advantage of) (b:khasiat) (q:draft, low confidence)
khasim = (i:1) (t:adj) (w:monthly/every month) (d:<kha>, month, with <sim>, each) (q:draft)
khasimin = (i:1) (t:adv) (w:every month/monthly) (d:<khasim> with the suffix <in>) (b:khasim) (q:draft)
khasuk = (i:1) (t:v) (w:take root downward/strike downward) (d:said of roots, {zung khasuk}: send roots down into the ground; <suk> is downward, set against <gahto>, bear fruit upward) (q:draft, low confidence)
khasum = (i:1) (t:n) (w:wages/pay/salary) (d:<kha> month with <sum> money: pay received by the month) (s:thaman) (q:draft)
khat = (i:1) (t:num) (w:one) (d:the number one; after a noun also a or an, as {mi khat}, a man; {khat leh khat} is one another)
khat = (i:2) (t:num) (w:first) (d:first, in counting the days of a month: {ni khat ni} is the first day) (s:khatna/masa)
Khat = (i:1) (t:num) (w:one) (d:<khat> written with a capital at the start of a line of verse, in a name such as {Mi Za Khat Tausang}, Tower of the Hundred, or for the One who judges) (b:khat) (r:16.12.39) (q:draft)
khata = (i:1) (t:num) (w:one) (d:<khat> one written together with a following <a>; {gal khata}, on the other side; {lang khata}, on one side or against) (b:khat) (r:30.3.1) (q:draft)
khataang = (i:1) (t:n) (w:moonlight/light of the moon/moon) (d:<kha>, moon, with <taang>, shining; paired with <nitaang>, sunlight) (r:22.6.10) (q:draft)
khatah = (i:1) (t:n) (w:site/spot) (d:<khat>, one, with the place ending <ah>: at or to one place; {gal khatah} is on the other side and {lang khatah} is against)
khatbeek = (i:1) (t:pron) (w:even one/a single one) (d:<khat>, one, with <beek>, even: with a negative, not even one, none at all) (s:khatzong) (q:draft)
khatciat = (i:1) (t:adv) (w:one each/each one) (d:<khat> one with <ciat>, each) (q:draft)
khate = (i:1) (t:n) (w:wings/feathers) (d:plural of <kha>, wing: the wings or feathers of a bird, a cherub or the wind) (b:kha) (q:draft)
khate = (i:2) (t:n) (w:spirits/souls) (d:plural of <kha>, spirit: spirits, also the spirits of the dead) (b:kha) (q:draft)
khate = (i:3) (t:n) (w:months) (d:plural of <kha>, month) (b:kha) (q:draft)
Khate = (i:1) (t:n) (w:souls/lives) (d:<khate> written with a capital; plural of <kha>, spirit or soul) (b:khate) (q:draft, low confidence)
khatguak = (i:1) (t:adj) (w:alone/solitary/single) (d:<khat> one with <guak>, only: one by itself) (s:guak) (q:draft)
khathum = (i:1) (t:n) (w:three months) (d:<kha> month with <thum> three, written as one word) (q:draft)
khatin = (i:1) (t:prep) (w:into) (d:<khat>, one, with <in>: into one, as in make into a woman or shape into another pot)
khatin = (i:2) (t:num) (w:single/solitary/sole) (d:<khat>, one, with <in>: with, on or in a single one, as {zawl khatin}, on a single pole, and {ni khatin}, for one day) (b:khat)
khatkhatin = (i:1) (t:adv) (w:one by one/in turn) (d:<khat> one, repeated, with <in>) (q:draft)
khatlekhat = (i:1) (t:pron) (w:each other/one another) (d:{khat le khat}, one and one, written as one word: each other; used with verbs that carry the reciprocal prefix <ki>) (r:1.37.19) (q:draft)
khatna = (i:1) (t:num) (w:first) (d:<khat>, one, with the ordinal suffix <na>: first; after {sawm-le} it forms eleventh, twenty-first and so on) (s:masa) (b:khat)
khatpa = (i:1) (t:pron) (w:the one/the other/one man) (d:<khat>, one, with <pa> marking a man: one of two men, or the other one) (b:khat) (q:draft)
khatpeuh = (i:1) (t:pron) (w:anyone) (d:<khat>, one, with <peuh>, any: anyone, or any one thing; {mi khatpeuh} is any person)
khatpeuhah = (i:1) (t:det) (w:in any/at any/at every) (d:<khatpeuh>, any one, with the place ending {-ah}, after a noun of place: in or at any such place; {mun khatpeuhah} means anywhere, wherever) (b:khatpeuh) (q:draft)
khatpeuhin = (i:1) (t:adv) (w:at any/at some) (d:<khatpeuh>, any one, with the time marker <in>: {ni hun khatpeuhin}, on some day and hour or other) (b:khatpeuh) (q:draft, low confidence)
khatpeuhpeuh = (i:1) (t:pron) (w:anyone/any one) (d:<khatpeuh> with <peuh> repeated: any one at all, of people, places or things) (b:khatpeuh)
khatte = (i:1) (t:pron) (w:some/certain ones) (d:<khat> with plural {-te}, in {pawl khatte} and {kim khatte}, some people, some of them) (s:pawlkhatte) (b:khat) (r:42.13.30) (q:draft)
khatte = (i:2) (t:num) (d:<khat> with plural {-te} at the end of a number that counts a group, as {za khatte}, the hundred, and {sawm-le-khatte}, the eleven) (b:khat) (r:7.7.19) (q:draft)
khatthu = (t:see) <khatthu-in>
khatthu-in = (i:1) (t:adv) (w:all at once/at one time) (d:<khat>, one, with <thu> and the ending <in>: all at one time; {ni khatthu-in} is in one single day) (q:draft)
khatvei = (i:1) (t:adv) (w:once/once more/again) (d:one time, from <khat>, one, and <vei>, time; with <kik> on the verb it means once more, and at the start of a story it means on one occasion) (r:41.14.39) (q:draft)
khatveina = (i:1) (t:n) (w:first time) (d:<khatvei>, once, with the ending <na>: the first time something is done) (b:khatvei) (q:draft)
khatveivei = (i:1) (t:adv) (w:sometimes/at times) (d:<khatvei> once, with <vei> repeated: now and then) (s:veivei) (q:draft)
khatzong = (i:1) (t:pron) (w:even one/a single one) (d:<khat>, one, with <zong>, even; with {om lo} it means there is not even one) (s:khatbeek) (q:draft)
khau = (i:1) (t:n) (w:rope/cord/string) (d:a rope, cord, string or thread of any thickness; {khau dum} is a blue cord and {sihna khau} the cords of death) (s:khauhual/khauzen) (q:draft)
khaudum = (i:1) (t:n) (w:blue cord) (d:<khau>, cord, with <dum>, blue: a blue cord or blue thread) (q:draft)
khauh = (i:1) (t:adj) (w:hard/stiff/unyielding/strong) (d:hard, firm or strong, not giving way; {lung khauh} and {lungsim khauh} mean stubborn or hard-hearted, and {khauh takin} means firmly or severely) (s:thakhauh) (a:nem/neem) (q:draft)
Khauh = (i:1) (t:adj) (w:strong/hard) (d:<khauh> written with a capital in a heading, {Itna in Sihna Zahin Khauh}, love is as strong as death) (b:khauh) (q:draft, low confidence)
khauhin = (i:1) (t:adv) (w:stubbornly/stiffly/firmly) (d:<khauh>, hard, with the ending <in>; after <lung> or <lungsim> it means stubbornly, with a hard heart) (b:khauh) (r:18.40.17) (q:draft)
khauhkik = (i:1) (t:v) (w:become strong again/regain strength) (d:<khauh>, strong, with <kik>, again: become strong again) (s:hatkik) (b:khauh) (q:draft)
khauhna = (i:1) (t:n) (w:hardness/stubbornness/firmness) (d:<khauh>, hard, with the ending <na>: the quality of being hard or unyielding; {lungsim khauhna} is stubbornness of heart, and in Philippians 3:6 it stands for zeal) (s:lungkhauhna) (a:nemna) (b:khauh) (q:draft)
khauhpa = (i:1) (t:n) (w:fierce man/tyrant) (d:<khauh>, hard, with <pa>, the man; {thu khauhpa} is the harsh, fierce man) (b:khauh) (q:draft)
khauhpah = (i:1) (t:v) (w:become strong at once) (d:<khauh> strong, with <pah>, at once) (q:draft)
khauhpente = (i:1) (t:adj) (w:strongest/stiffest) (d:<khauh> strong or stiff, <pen> most, with the plural <te>: the stiffest bows) (q:draft)
khauhsak = (i:1) (t:v) (w:harden/strengthen/make firm) (d:<khauh>, hard or strong, with <sak>, make: make hard or make strong; {lungsim khauhsak} means harden the heart, and {khut khauhsak} means strengthen the hands) (s:hatsak/thahatsak/thakhauhsak) (a:thanemsak/zawsak) (b:khauh) (q:draft)
khauhsakin = (i:1) (t:v) (w:hardening/making stubborn) (d:<khauhsak>, harden, with the linking suffix <in>) (b:khauhsak) (q:draft)
khauhsakkhak = (i:1) (t:v) (w:happen to harden/come to harden) (d:<khauhsak> harden, with <khak>, happen to; of hardening the heart) (q:draft)
khauhsakna = (i:1) (t:n) (w:strengthening) (d:<khauhsak> with the noun suffix <na>: the act of making weak hands strong) (s:thakhauhsakna/thahatsakna) (b:khauhsak) (q:draft)
khauhtakin = (i:1) (t:adv) (w:strongly/firmly/powerfully/strictly) (d:<khauh>, hard or firm, with <takin>, like English -ly: strongly, firmly or severely; of the Spirit of God coming on someone, powerfully) (b:khauh) (q:draft)
khauhtat = (i:1) (t:v) (w:be severe/deal harshly) (d:act in a hard way toward someone) (q:draft)
khauhte = (i:1) (t:adj) (w:strong/mighty) (d:<khauh> hard, strong, with the plural <te>; {lungsim khauhte} are the stout-hearted) (b:khauh) (q:draft)
khauhtuak = (i:1) (t:adj) (w:strong/sturdy) (d:of people compared to oak trees) (q:draft)
khauhual = (i:1) (t:n) (w:rope/cord) (d:a rope or cord made of twisted strands, used for tying and binding) (s:khau/khauzen) (q:draft)
khauhualpi = (i:1) (t:n) (w:rope/thick rope/cart rope) (d:<khauhual>, rope, with <pi>, large: a thick rope, such as a cart rope) (b:khauhual) (q:draft)
khauhualte = (i:1) (t:n) (w:ropes) (d:<khauhual>, rope, with the plural <te>) (s:khaute) (b:khauhual) (q:draft)
khauhzaw = (i:1) (t:adj) (w:stricter/more severe/stronger) (d:<khauh> hard or strict, with <zaw> more; with <in> it is used as an adverb, more strictly) (b:khauh) (q:draft)
khaukhai = (i:1) (t:n) (w:plumb line/measuring line) (d:a cord hung with a weight to test whether a wall stands upright; {khaukhai sikbawk} is the weighted plumb line) (q:draft)
khaumang = (i:1) (t:n) (w:thicket) (d:dense tangle of bushes or creepers, in which the ram was caught by its horns) (s:singkawm/sawlkawm) (q:draft)
khausai = (i:1) (t:n) (w:string/stringed instrument) (d:string of a musical instrument; {khausai lasakna} is an instrument with strings) (q:draft)
khausan = (i:1) (t:n) (w:scarlet thread/red thread) (d:<khau>, thread, with <san>, red: a red or scarlet thread) (b:khau) (q:draft)
khausante = (i:1) (t:n) (w:scarlet cloth/scarlet threads) (d:<khausan> with the plural <te>; in a list of costly cloth, where the English has scarlet cloth) (b:khausan) (q:draft, low confidence)
khautang = (i:1) (t:n) (w:sackcloth) (d:coarse cloth; {khautang puan} is a garment of sackcloth, worn in mourning or repentance) (s:puanham/puanhampi) (q:draft)
khaute = (i:1) (t:n) (w:cords/ropes/yarn/threads) (d:<khau>, cord, with the plural <te>: cords, ropes, or in lists of cloth, yarn) (s:khauhualte) (b:khau) (q:draft)
khauteep = (i:1) (t:n) (w:whip) (d:a whip made of cords, <khau>; the same verse in the other text has <khautep>) (s:khautep) (q:draft)
khautep = (i:1) (t:n) (w:whip) (d:a whip made of cords, <khau>; the same verse in the other text has <khauteep>) (s:khauteep) (q:draft)
khauzak = (i:1) (t:n) (w:noose/snare) (d:loop of cord set on the ground to catch something; <khau> is cord) (s:thangkhau/thangzak) (q:draft)
khauzang = (i:1) (t:n) (w:cord/measuring line) (d:a length of cord used for measuring) (s:pikhau) (q:draft)
khauzen = (i:1) (t:n) (w:cord/rope) (d:cord such as is used to lead an animal; set beside <khauhualpi>, a thick rope) (s:khau/khauhual) (q:draft)
khaveng = (i:1) (t:n) (w:plumage/feathers) (d:the feathers of a bird; of the great eagle, {khaveng hoih mahmah}, very fine plumage) (q:draft, low confidence)
khawdak = (i:1) (t:v) (w:look out/watch) (d:look out into the distance in hope of something coming) (s:khuadak) (q:draft)
khawdakdak = (i:1) (t:v) (w:keep looking out/keep watching) (d:<khawdak> with <dak> repeated, showing that the looking goes on) (q:draft)
khawh = (i:1) (t:v) (w:farm) (d:work a field to grow crops; {lo khawh} is farm a field and {lo khawh hun} is ploughing time) (s:kho) (b:kho)
khawh = (i:2) (t:v) (w:cultivate) (d:prepare and work land or plants so that they bear a crop) (s:ciin) (b:kho)
khawhcip = (i:1) (t:v) (w:pin/spear fast) (d:thrust a spear through someone so that he is fixed to the wall or the ground) (q:draft)
khawhcipsak = (i:1) (t:v) (w:let pin/pin) (d:<khawhcip>, pin with a spear, with <sak>; {hong khawhcipsak in}, let me pin him) (b:khawhcip) (q:draft)
khawhin = (i:1) (t:v) (w:throw at/hurl at) (d:<khawh>, throw or thrust something at a person, with the linking suffix <in>; a different word from <khawh>, farm) (q:draft, low confidence)
khawhkha = (i:1) (t:v) (w:hit/strike) (d:<khawh>, throw or thrust a spear, with <kha>, reach the mark: hit someone with a thrown spear) (q:draft)
khawhkik = (i:1) (t:v) (w:farm again/plough again) (d:<khawh> farm with <kik>, again: work the field again for the next crop; {lo khawhkik hun} is the time to plough again) (b:khawh) (q:draft)
khawhlawh = (i:1) (t:v) (w:farm as a tenant/work land for hire) (d:work the land of another man for a share of the crop; {lo khawhlawh} is a tenant farmer and {khawhlawh sak} is let land out to tenants) (r:42.20.9) (q:draft)
khawhlawhsak = (i:1) (t:v) (w:rent out/let out to tenants) (d:<khawhlawh>, farm as a tenant, with the causative <sak>: give land to others to farm) (s:lawhsak) (b:khawhlawh) (q:draft)
khawhlawhsakin = (i:1) (t:v) (w:rent out/let out to tenants) (d:<khawhlawhsak>, let land out to tenants, with the linking ending <in>: having let it out) (b:khawhlawhsak) (q:draft)
khawhlawhte = (i:1) (t:n) (w:tenants/tenant farmers/hired workers) (d:<khawhlawh>, one who works land for its owner, with the plural <te>; said after <lo>, field) (s:lawhte) (b:khawhlawh) (q:draft)
khawhlet = (i:1) (t:v) (w:pierce through/spear through) (d:<khawh> in the sense spear or stab, with <let>, right through: stab so that the weapon goes through) (s:sunlet) (q:draft)
khawhletzo = (i:1) (t:v) (w:be able to pierce through) (d:<khawhlet> pierce through with <zo>, be able) (s:sunletzo) (b:khawhlet) (q:draft)
khawhna = (i:1) (t:n) (w:cultivating/tilling/ploughing) (d:<khawh>, work the soil, with the ending {-na}; {lo khawhna tu} is the tool for tilling a field, a plowshare or hoe) (b:khawh) (q:draft)
khawhna = (i:2) (t:n) (w:spearing/piercing) (d:in {ngasa khawhna teipi}, a spear for spearing fish, a harpoon) (q:draft, low confidence)
khawhsa = (i:1) (t:n) (w:produce/crops/harvest) (d:<khawh> farm with <sa>, already done: what one has grown; {khawhsa tawh biakna}, offering of produce) (b:khawh) (q:draft)
khawhsak = (i:1) (t:v) (w:make plough/farm for) (d:<khawh>, farm or work the land, with <sak>: make an animal or person work the land, or in Luke 17:7 work the land for someone) (b:khawh) (q:draft)
khawhsakte = (i:1) (t:n) (w:field workers/those who work the land for) (d:<khawhsak>, work the land for someone, with the plural <te>; the English has the workers who mowed your fields) (b:khawhsak) (q:draft)
khawhsate = (i:1) (t:n) (w:produce/crops) (d:<khawhsa>, what one has grown, with the plural <te>) (b:khawhsa) (q:draft)
khawi = (i:1) (t:v) (w:spare/keep alive/let live) (d:keep and not kill, often as {hing khawi}, keep alive; in Ecclesiastes 3:3 it is the opposite of killing) (s:nungtasak) (a:that) (q:draft)
khawi = (i:2) (t:v) (w:keep/rear/raise) (d:keep and look after an animal or a person in one's charge: {vasa khawi} is a pet bird, {sila-in khawi} is keep as a slave; in Numbers 6:5 of letting the hair grow long) (s:khoi) (r:24.34.10) (q:draft, low confidence)
khawikik = (i:1) (t:v) (w:keep again/take back) (d:<khawi> keep, with <kik>, again; {sila-in khawikik}, keep as a slave again) (b:khawi) (q:draft)
khawilevulh = (i:1) (t:n) (w:nurture/rearing) (d:<khawi> rear, <le> and, <vulh> feed: the rearing and feeding of young; the English has blessings of the breast and womb) (q:draft, low confidence)
khawilo = (i:1) (t:v) (w:not spare) (d:<khawi>, keep alive, with <lo>, not; {hin’ khawilo}, did not keep alive) (b:khawi) (q:draft)
khawipa = (i:1) (t:n) (w:breeder/keeper) (d:<khawi>, keep or rear, with <pa> marking a man; {tuu khawipa} is a man who raises sheep) (b:khawi) (q:draft)
khawite = (i:1) (t:n) (w:domestic animals/livestock/pets) (d:<khawi>, rear or keep animals, with plural {-te}: animals that are kept; {gan khawite} is livestock and {ui khawite} are house dogs) (s:gankhawite/innsate) (b:khawi) (r:40.15.27) (q:draft)
khawk = (i:1) (t:n) (w:section/portion/plot/column) (d:one marked-off part of something longer or larger, as a stretch of wall, a plot of land or a column of writing) (q:draft)
khawkte = (i:1) (t:n) (w:sections/panels/compartments) (d:plural of <khawk>, a section or enclosed part; {tuu-khawkte} are sheep pens) (b:khawk) (q:draft)
khawl = (i:1) (t:v) (w:accompany)
khawlcip = (i:1) (t:v) (w:stand still/stop completely/come to a standstill) (d:<khawl>, stop or rest, with <cip>, firmly: stop completely and stay still, as the sun and moon in the sky or a work that is halted) (s:dinkhawl) (b:khawl) (q:draft)
khawlei = (i:1) (t:n) (d:see <khawlei-uikai>)
Khawlei = (i:1) (t:n) (c:star) (w:the Bear) (d:first part of {Khawlei-uikai}, the constellation of the Bear, also written as two words) (b:khawlei) (r:18.9.9) (q:draft)
khawlei uikai = (i:1) (t:n) (d:see <khawlei-uikai>)
khawlei-uikai = (i:1) (t:n) (c:star) (w:the Bear) (d:the constellation of the Bear, the Great Bear, named in the book of Job)
khawlin = (i:1) (t:v) (w:stop/cease/turn from) (d:<khawl> with the ending {-in}: stopping, leaving off, before the next action) (b:khawl) (q:draft)
khawlmun = (i:1) (t:n) (w:haven/resting place/harbour) (d:<khawl> stop or rest, with <mun> place; {teembaw khawlmun} is a place where ships stop) (s:khawlna) (q:draft)
Khawlmun = (i:1) (t:n) (w:haven/resting place/lodging place) (d:<khawlmun>, a place to stop and rest, capitalised in place names: {Khawlmun Nuam}, Fair Havens; {Khimham Khawlmun}, Geruth Kimham) (b:khawlmun) (q:draft)
khawlmunte = (i:1) (t:n) (w:harbours/resting places) (d:<khawlmun>, a place to stop and rest, with the plural <te>; of ships, a harbour) (b:khawlmun) (q:draft)
khawlna = (i:1) (t:n) (w:rest/resting place/stopping place/harbour) (d:<khawl>, stop or rest, with the ending <na>: the act of stopping, or a place to stop and rest; {teembaw khawlna mun} is a harbour and {teembaw khawlna sikkawi} is an anchor) (s:khawlmun/tawlngakna) (b:khawl) (r:20.26.2) (q:draft)
khawlpah = (i:1) (t:v) (w:stop at once/stop immediately) (d:<khawl> stop with <pah>, at once) (q:draft)
khawlpak = (i:1) (t:v) (w:stop/break off) (d:<khawl> stop, with <pak>, for a while or promptly: leave off a quarrel) (q:draft, low confidence)
khawlsak = (i:1) (t:v) (w:stop/halt/detain) (d:make someone or something stop or rest; <khawl> with <sak>, cause) (s:tawpsak) (b:khawl) (q:draft)
khawlsakin = (i:1) (t:v) (w:stopping/making rest) (d:<khawlsak>, make stop or rest, with the linking suffix <in>) (b:khawlsak) (q:draft)
khawlsakna = (i:1) (t:n) (w:stopping) (d:<khawlsak> make stop, with the noun suffix <na>; {teembaw khawlsakna sikkawipi}, the iron hook for stopping a ship, is an anchor) (b:khawlsak) (q:draft)
khawma = (i:1) (t:adv) (w:together) (d:<khawm> with the linking <a>; {ding khawma om}, be standing together with) (b:khawm) (q:draft)
khawmin = (i:1) (t:v) (w:gather/assemble/bring together) (d:<khawm>, gather, with the linking suffix <in>: gathering people or things together before a following action) (b:khawm) (r:2.35.1) (q:draft)
khawmin = (i:2) (t:adv) (w:together) (d:<khawm>, together, with the ending <in>, after another verb: doing it together with others) (s:khawm) (b:khawm) (q:draft)
khawmkhawm = (i:1) (t:v) (w:gather/gather together) (d:<khawm>, bring together, said twice: keep gathering; set against <kithehthangsak>, scatter) (a:kithehthangsak) (b:khawm) (r:42.11.23) (q:draft)
khawmkik = (i:1) (t:v) (w:gather again/gather up/collect) (d:<khawm> gather with <kik>, again or back) (s:kaikhawmkik) (b:khawm) (q:draft)
khawmkikin = (i:1) (t:v) (w:gather again/gather back) (d:<khawmkik> with the linking suffix <in>) (b:khawmkik) (q:draft)
khawmluzepna = (i:1) (t:n) (w:capital) (d:the ornamental top of a pillar; apparently another spelling of <khuamluzepna>, which stands in the same verse) (s:khuamluzepna) (q:draft, low confidence)
khawmna = (i:1) (t:n) (w:togetherness/fellowship) (d:<khawm>, together, with the noun suffix <na>, after a verb: the doing of something together, as {kipawl khawmna}, fellowship, and {gamtat khawmna}, acting together) (b:khawm) (q:draft)
khawmnate = (i:1) (t:n) (w:meetings/gatherings) (d:<khawmna>, doing together, with the plural <te>; {kikhop khawmnate} are the meetings together) (b:khawmna) (q:draft)
khawmpa = (i:1) (t:n) (w:fellow/companion/co-worker) (d:<khawm> together with <pa>, the man: after a verb, the man who does it together with someone; {nasem khawmpa} is a fellow worker) (b:khawm) (q:draft)
khawmpih = (i:1) (t:adv) (w:together with/along with/fellow) (d:<khawm>, together, with <pih>, with someone: after a verb, do it together with someone or share in it; after a noun, a fellow, as in {galkap khawmpih} fellow soldier) (s:khoppih) (b:khawm) (q:draft)
khawmpihpa = (i:1) (t:n) (w:one who shares with/fellow) (d:<khawmpih>, do together with someone, with <pa>, the man: the man with whom one does it, as the one who dips in the dish with me) (b:khawmpih) (q:draft)
khawmpihte = (i:1) (t:n) (w:companions/guests/those together with) (d:<khawmpih>, do together with someone, with the plural <te>: the people with whom one does it; {a tut khawmpihte}, those who sat at table with him, his guests) (b:khawmpih) (q:draft)
khawmsa = (i:1) (t:adj) (w:already together) (d:<khawm>, together, with <sa>, already done; {lum khawmsa} is having lain together with someone) (b:khawm) (q:draft)
khawmsak = (i:1) (t:v) (w:gather/assemble/bring together) (d:<khawm>, together, with the causative <sak>: make people or things come together, collect or assemble them) (s:kaikhawm/khopsak) (a:thehthang/khenthang) (b:khawm) (q:draft)
khawmsak = (i:2) (t:part) (d:placed after a verb: cause or allow someone to do the action together with others) (b:khawm) (r:47.4.14) (q:draft, low confidence)
khawmsate = (i:1) (t:n) (w:those joined together) (d:<khawmsa>, already together, with the plural <te>; {a gawm khawmsate} are those who have been joined together) (b:khawmsa) (q:draft)
khawmte = (i:1) (t:n) (w:those together with/companions/fellow) (d:<khawm>, together, with plural {-te}, placed after a verb: the people who do the action together, as {an ne khawmte}, those eating together) (s:omkhawmte) (b:khawm) (q:draft)
khawng = (i:1) (t:part) (w:about/or so/approximately) (d:placed after a number, a time or an item to make it approximate) (q:draft)
khawng = (i:2) (t:v) (w:charge/sell dear) (d:ask a high price for goods) (q:draft, low confidence)
khawngah = (i:1) (t:ppm) (w:on/around/among/somewhere at) (d:<khawng>, thereabouts, with the place marker {-ah}: at or on such places, here and there on, as {inn tung khawngah}, up on the houses) (b:khawng) (q:draft)
khawngai = (i:1) (t:adj) (w:desolate/forlorn/lonely) (d:sad and alone like one bereaved) (q:draft)
khawngin = (i:1) (t:part) (w:about/around) (d:<khawng>, approximately, with <in>, placed after a time: at about that time) (b:khawng) (q:draft)
khawngte = (i:1) (t:part) (w:and the like/such things as) (d:<khawng> placed after each item of a list of examples, with the plural <te> after the last item) (b:khawng) (q:draft)
khawphelep = (i:1) (t:n) (w:lightning/flash of lightning) (d:a flash of lightning; {khawphelep bangin tang} is shine like lightning) (s:khuaphialep/khuaphia/keek) (q:draft)
khazap = (i:1) (t:n) (w:wing) (d:the wings in motion; {khazap ging} is the sound of beating wings) (s:khaphung) (q:draft)
khazapna = (i:1) (t:n) (w:beating of wings/flapping) (d:<khazap>, wing, with the noun suffix <na>: the moving of the wings and its sound) (s:zapna) (b:khazap) (q:draft, low confidence)
khazel = (i:1) (t:part) (d:placed after a verb, <kha>, happen to, with <zel>, again or in turn: might also come to do) (q:draft, low confidence)
khazenzen = (i:1) (t:adv) (w:by any chance/ever) (d:<kha>, happen to, with <zenzen>, by chance; with <leh>, if it should ever happen that) (q:draft)
Khazih = (i:1) (t:name) (w:Christ) (d:the Christ, the Messiah, title of Jesus as the one anointed by God) (r:44.8.5/46.1.4)
khe = (i:1) (t:n) (w:foot/leg) (d:the foot or the whole leg of a person or an animal; {khe li} is four legs, and the leg of a table is also {khe}) (q:draft)
khe-baite = (i:1) (t:n) (w:the lame/lame people) (d:<khe>, foot, with <bai>, lame, and the plural <te>) (s:khebaite/khezawte/khelbaite) (q:draft)
khebai = (i:1) (t:adj) (w:lame/crippled) (d:<khe>, foot or leg, with <bai>, lame: unable to walk properly; also a lame foot or a lame person) (s:bai/khezaw/khelbai) (q:draft)
Khebaipa = (i:1) (t:n) (w:lame man) (d:<khebai> lame with <pa>, which marks a man) (q:draft)
khebaite = (i:1) (t:n) (w:the lame/lame people) (d:<khebai>, lame, with the plural <te>) (s:khe-baite/khezawte/khelbaite) (b:khebai) (q:draft)
Khebar = (i:1) (t:name) (c:river) (w:Kebar) (d:river or canal in Babylonia beside which Ezekiel lived among the exiles and saw his visions) (r:26.1.1/26.10.15)
khebom = (i:1) (t:n) (w:paw/leg of an animal) (d:the paw or lower leg of an animal; in Amos 3:12 the two legs of a sheep saved from a lion) (s:khecin) (q:draft)
khebuh = (i:1) (t:n) (w:anklet/bangle) (d:ornament worn by women on the foot or ankle; <khe> is foot) (q:draft)
khebui = (t:see) <khebui-in>
khebui-in = (i:1) (t:adj) (w:crippled/maimed in the foot) (d:<khe> foot with <bui> maimed and the linking ending <in>: being without a foot; paired with <khutbui>, maimed in the hand) (r:41.9.44) (q:draft)
khecin = (i:1) (t:n) (w:hoof/paw/claw) (d:the hoof or claws of an animal foot; {a khecin a ka} means it has a divided hoof) (s:khebom) (r:9.17.37) (q:draft)
khecinte = (i:1) (t:n) (w:hooves/hoofs/claws) (d:<khecin>, hoof or claw, with the plural <te>) (b:khecin) (q:draft)
khedapkaihte = (i:1) (t:n) (w:sandals) (d:<khedap>, sandal, with <kaih> and the plural <te>; apparently sandals that are strapped on) (s:khedapte) (q:draft)
khedapte = (i:1) (t:n) (w:sandals/shoes) (d:<khedap>, sandal, with the plural <te>) (s:khedapkaihte) (b:khedap) (q:draft)
Khedorla = (t:see) <Khedorla-omer>
Khedorla-omer = (i:1) (t:name) (c:male) (w:Kedorlaomer) (d:king of Elam who led the alliance of four kings that was defeated by Abram) (r:1.14.1) (q:draft)
Khedorlaomer = (i:1) (t:name) (c:land) (w:Chedorlaomer/Kedorlaomer) (d:spelling of <Khedorla-omer>, the king of Elam who led four kings and was defeated by Abram) (r:1.14.1)
kheek = (i:1) (t:v) (w:change/exchange) (d:put one thing in the place of another, as clothes; with <tawh>, exchange something for something else) (s:khek/kheel/khel/laih) (q:draft)
kheek = (i:2) (t:v) (w:spin/twist) (d:twist fibre into thread or cord) (r:42.12.27) (q:draft)
kheekin = (i:1) (t:v) (w:spinning/twisting) (d:<kheek>, spin thread, with <in>) (b:kheek) (q:draft)
kheekna = (i:1) (t:n) (w:exchange/substitute) (d:<kheek> exchange with the noun suffix <na>: the exchanging, or the thing given in exchange; {a kheekna ganhing} is the animal put in its place) (s:khekna) (b:kheek) (r:19.106.20) (q:draft)
kheekte = (i:1) (t:n) (w:changers/exchangers) (d:<kheek> change with the plural <te>: those who change; {dangka kheekte} are the money changers) (b:kheek) (r:41.11.15) (q:draft)
kheel = (i:1) (t:v) (w:change/alter) (d:{lungsim kheel} is to change the mind, to relent) (s:khel/khek/kheek) (q:draft)
kheelin = (i:1) (t:v) (w:changing/altering) (d:<kheel>, change, with the ending {-in}, linking to the next verb; {lungsim kheel} means change one's mind, relent) (s:khelin) (b:kheel) (q:draft)
kheelkik = (i:1) (t:v) (w:change back/relent/revoke) (d:<kheel> change with <kik>, back again; {lungsim kheelkik}, change one's mind) (s:khelkik) (b:kheel) (q:draft)
kheelsak = (i:1) (t:v) (w:change/transform) (d:<kheel>, change, with <sak>: make something change, as when a person is given a new name) (s:khelsak/kheksak) (b:kheel) (q:draft)
kheelzo = (i:1) (t:v) (w:be able to change/resist) (d:<kheel>, change, with <zo>, be able: be able to alter what was said or decided) (b:kheel) (q:draft)
kheem = (i:1) (t:v) (w:lie/deceive) (d:say what is false to someone, deceive or mislead; in the Gospels also tempt, as the devil does) (s:khem/zuau) (r:41.13.5/43.7.47)
kheem = (i:2) (t:n) (w:deceit) (d:deceiving, pretence; {mi kheem} is a deceiver and {it kheem} is love that is only pretended) (s:kheemna/khemna)
kheembawlin = (i:1) (t:v) (w:tricking/by deceit) (d:<kheem>, deceive, with <bawl>, do, and <in>: by using trickery) (q:draft)
kheemin = (i:1) (t:v) (w:deceiving/cheating) (d:<kheem>, deceive, with the ending {-in}, linking to the next verb) (s:khemin) (b:kheem) (q:draft)
kheemna = (i:1) (t:n) (w:deceit/deception/trickery/scheme) (d:<kheem>, deceive, with the noun suffix <na>: deceit, a trick or scheme used to mislead someone) (s:khemna/khemsiamna/ngian/zuautatna) (b:kheem) (q:draft)
kheemna = (i:2) (t:n) (w:temptation) (d:being enticed or tested to do wrong; {kheemna thuak} is to be tempted, as in the Lord's Prayer) (s:zolna/ze-etna) (b:kheem) (q:draft)
kheempa = (i:1) (t:n) (w:deceiver) (d:<kheem>, deceive, with <pa>: the man who deceives) (s:khempa) (b:kheem) (q:draft)
kheemte = (i:1) (t:n) (w:deceivers/deceitful people) (d:<kheem>, deceive, with the plural <te>; {mi kheemte} are people who deceive) (s:khemte/mikhemte/mikheemte) (b:kheem) (q:draft)
kheengcip = (i:1) (t:v) (w:be callous/be hardened/be closed up) (d:said of the heart that does not understand) (q:draft, low confidence)
Khefarammoni = (i:1) (t:name) (c:city) (w:Kephar Ammoni) (d:town in the land of the tribe of Benjamin) (r:6.18.24)
Khefirah = (i:1) (t:name) (c:city) (w:Kephirah) (d:Hivite town allied with Gibeon, later given to the tribe of Benjamin) (r:6.9.17/6.18.26)
kheging = (i:1) (t:n) (w:footsteps/sound of feet/sound of marching) (d:<khe>, foot, with <ging>, sound: the sound made by feet or hooves) (q:draft)
khegingte = (i:1) (t:n) (w:sound of hooves/footsteps/clatter) (d:<kheging>, the sound made by feet or hooves, with plural <te>) (b:kheging) (q:draft)
kheguak = (i:1) (t:adj) (w:barefoot) (d:<khe> foot with <guak> bare) (q:draft)
kheguakin = (i:1) (t:adv) (w:barefoot) (d:<kheguak> barefoot with the ending <in>; paired with <tangguak>, naked) (b:kheguak) (q:draft)
kheh = (i:1) (t:v) (w:peel/strip) (d:strip the bark from a stick so that the white wood shows) (q:draft)
khehsa = (i:1) (t:adj) (w:peeled/stripped) (d:<kheh> peel with <sa>, already done) (b:kheh) (q:draft)
khei = (i:1) (t:v) (w:pick out/extract) (d:dig out a thorn that is stuck in the flesh) (q:draft, low confidence)
khek = (i:1) (t:v) (w:change/exchange/substitute) (d:to put one thing in the place of another, as clothes, skin or an animal for offering) (s:kheek/kheel/khel/laih) (q:draft)
khekhap = (i:1) (t:n) (w:footstep/footprint/way) (d:footprint; used for the way of life of someone that another person follows) (s:sul) (q:draft)
khekhapte = (i:1) (t:n) (w:footprints/footsteps) (d:<khekhap> footprint with the plural <te>) (b:khekhap) (q:draft)
khekhapteng = (i:1) (t:n) (w:footsteps/ways) (d:<khekhap>, footstep, with <teng>, all: the whole way of life of someone that another follows) (b:khekhap) (q:draft)
khekhat = (i:1) (t:n) (w:one foot) (d:<khe> foot with <khat> one; found in {khekhat khai bangin}, as if lifting one foot, said of people who come together as one man) (q:draft, low confidence)
khekna = (i:1) (t:n) (w:exchange/substitute/substitution) (d:<khek>, put one thing in the place of another, with the ending {-na}: the act of exchanging or the thing given instead; {khekna-in} means in exchange for) (s:kheekna) (b:khek) (r:1.47.17) (q:draft)
kheksak = (i:1) (t:v) (w:change/alter) (d:<khek>, change, with the causative <sak>: make something change) (s:kheelsak/khelsak) (b:khek) (q:draft)
khel = (i:1) (t:v) (w:change/alter) (d:make different; {lungsim khel} is change one's mind, relent) (s:kheel/khek/kheek) (q:draft)
khel = (i:2) (t:n) (w:hip/thigh) (d:the hip; {khel thagui} is the tendon of the hip, <khelkom> the hip socket) (s:khelpi) (q:draft)
khel = (i:3) (t:v) (w:gouge out/pluck out) (d:dig or scoop out, as an eye; found with <khia>, out, written {khel khia} or as one word <khelkhia>) (s:khelkhia) (q:draft, low confidence)
Khelal = (i:1) (t:name) (c:male) (w:Kelal) (d:man of the family of Pahath-Moab who had married a foreign wife in the time of Ezra) (r:15.10.30)
khelbai = (i:1) (t:adj) (w:lame/crippled) (d:<khel> hip with <bai> lame: lame in the hip or leg) (s:bai/khebai/khezaw) (q:draft)
khelbaite = (i:1) (t:n) (w:the lame/lame people) (d:<khelbai>, lame, with the plural <te>) (s:khebaite/khe-baite/khezawte) (b:khelbai) (q:draft)
khelbawl = (i:1) (t:v) (w:mock/mistreat/abuse/trouble) (d:treat someone wrongly or with mockery, abuse; also trouble or unsettle someone) (s:zahko/bawlsia) (a:pahtawi) (q:draft)
khelguh = (i:1) (t:n) (w:hip bone/hip) (d:<khel> hip with <guh> bone) (q:draft)
khelin = (i:1) (t:v) (w:changing/relenting) (d:<khel>, change, with <in>; {lungsim khelin} is changing the mind, relenting) (s:kheelin) (b:khel) (q:draft)
khelkhia = (i:1) (t:v) (w:gouge out/pluck out/put out) (d:take out an eye by force) (q:draft)
khelkhiat = (i:1) (t:v) (w:gouge out/pluck out/put out) (d:form of <khelkhia> used before <sak> and other following words: take out an eye by force) (b:khelkhia) (q:draft)
khelkhiatsak = (i:1) (t:v) (w:gouge out/put out) (d:<khelkhiat> gouge out with <sak>: put out the eyes of someone) (s:khelsak) (b:khelkhiat) (r:24.52.11) (q:draft)
khelkhin = (i:1) (t:v) (w:have changed) (d:<khel>, change, with <khin>, already or completely) (b:khel) (q:draft)
khelkik = (i:1) (t:v) (w:change back/reverse/relent) (d:<khel>, change, with <kik>, back: change what was said or decided, change one's mind) (s:kheelkik) (b:khel) (q:draft)
khelkikin = (i:1) (t:v) (w:changing back/reversing) (d:<khelkik>, change back, with <in>; {lungsim khelkikin} is changing the mind again) (b:khelkik) (q:draft)
khelkikzaw = (i:1) (t:v) (w:relent instead/change back rather) (d:<khelkik>, change what was said, with <zaw>, rather) (b:khelkik) (q:draft)
khelkom = (i:1) (t:n) (w:hip socket/hip joint/hollow of the thigh) (d:the socket of the hip, where the thigh bone joins the body; <khel> is hip) (q:draft)
khelmang = (i:1) (t:v) (w:change/do away with) (d:<khel>, change, with <mang>, away: change something so that the old is gone) (q:draft)
khelpi = (i:1) (t:n) (w:hip/thigh) (d:<khel> hip with <pi>, big: the hip or upper thigh) (s:khel) (b:khel) (q:draft)
khelpilna = (i:1) (t:n) (w:wiles/trickery/cunning) (d:cunning used to mislead others; in Numbers 25:18 the tricks by which the Midianites deceived Israel) (s:khemsiamna/ngian) (q:draft, low confidence)
khelsak = (i:1) (t:v) (w:change/alter) (d:<khel> change with <sak>: change something for someone, as a name) (s:kheelsak/kheksak) (b:khel) (q:draft)
khelsak = (i:2) (t:v) (w:gouge out/put out) (d:<khel> gouge out with <sak>: put out the eyes of someone) (s:khelkhiatsak) (b:khel) (q:draft)
kheltat = (i:1) (t:adj) (w:insolent/lawless) (d:said of a person in a list of wrongdoers; the exact sense is not clear from the verse) (q:draft, low confidence)
kheltatna = (i:1) (t:n) (w:wickedness/lawlessness/iniquity) (d:<kheltat> with the noun suffix <na>) (s:gitlohna) (a:dikna) (b:kheltat) (q:draft, low confidence)
Khelub = (i:1) (t:name) (c:male) (w:Kelub) (d:name of two men: a man of Judah, brother of Shuhah and father of Mehir, and the father of Ezri, an officer of David) (r:13.27.26) (q:draft)
Khelubai = (i:1) (t:name) (c:male) (w:Caleb) (d:son of Hezron of the tribe of Judah, elsewhere called Caleb) (r:13.2.9)
Kheluhi = (i:1) (t:name) (c:male) (w:Keluhi) (d:descendant of Bani who had married a foreign wife in the time of Ezra) (r:15.10.35)
khem = (i:1) (t:v) (w:deceive/trick/mislead) (d:make someone believe what is not true; {hong khem} is deceive me or us, and {khem zo} is succeed in deceiving) (s:kheem/zuau/lehhek/khembawl)
khem = (i:2) (t:v) (w:cheat/defraud) (d:deceive someone in order to take what is his, as a trader does with false scales)
khem = (i:3) (t:v) (w:lie) (d:say what is not true; after another verb, do the action falsely, as {phat khem}, praise insincerely, and {tai khem}, pretend to flee) (s:zuau)
khembawl = (i:1) (t:v) (w:deceive/trick/use deception) (d:<khem>, deceive, with <bawl>, do or treat: deal deceitfully with someone, play a trick on them) (s:khem/lehhek) (b:khem) (q:draft)
kheme = (i:1) (t:n) (w:toe) (d:a toe of the foot, as <khutme> is a finger of the hand) (q:draft)
khemete = (i:1) (t:n) (w:toes) (d:<kheme>, toe, with the plural <te>) (b:kheme) (q:draft)
khemgawpin = (i:1) (t:v) (w:deceiving utterly/dealing treacherously) (d:<khem>, deceive, with <gawp>, thoroughly, and the linking suffix <in>: deceiving someone badly, and then doing the next thing) (s:lehheekin) (q:draft)
khemhat = (i:1) (t:v) (w:be deceitful/be given to deceiving) (d:<khem>, deceive, with <hat>, be given to: be in the habit of deceiving others) (q:draft)
khemin = (i:1) (t:v) (w:deceiving/cheating) (d:<khem>, deceive, with the linking suffix <in>: deceiving or having deceived someone, followed by another verb; {kei hong khemin} is deceiving me) (s:kheemin) (b:khem) (r:1.31.26) (q:draft)
khemkhem = (i:1) (t:v) (w:keep deceiving/betray) (d:<khem>, deceive, said twice: go on deceiving again and again) (q:draft)
khemkhemin = (i:1) (t:v) (w:deceiving) (d:<khemkhem>, go on deceiving, with the linking suffix <in>: deceiving others all the while) (b:khemkhem) (q:draft)
khemna = (i:1) (t:n) (w:deceit/deception/trickery) (d:<khem>, deceive, with the noun suffix <na>: deceit, a trick, the act of deceiving; {khemna tawh} is by deceit) (s:kheemna/khemsiamna) (a:thutak/cihtakna) (b:khem) (q:draft)
khemnateng = (i:1) (t:n) (w:deceits/lies) (d:<khemna>, deceit, with <teng>, all: all their deceits) (s:zuaupiteng) (b:khemna) (q:draft)
khemnop = (i:1) (t:v) (w:want to deceive) (d:<khem>, deceive, with <nop>, want to: want to deceive someone) (q:draft)
khemnop = (i:2) (t:adj) (w:easily deceived/gullible) (d:<khem> deceive with <nop> in the sense easy: easy to deceive; said of a silly dove) (q:draft, low confidence)
khemnopna = (i:1) (t:n) (w:deceitfulness/intent to deceive) (d:<khemnop> want to deceive with the noun suffix <na>; {khemnopna lungsim} is a mind bent on deceiving) (b:khemnop) (q:draft)
Khemosh = (i:1) (t:name) (w:Chemosh) (d:god of the Moabites, for whom Solomon built a place of worship near Jerusalem) (r:7.11.24/4.21.29)
Khemoshpasian = (i:1) (t:name) (w:Chemosh) (d:Chemosh, the god of the Moabites, written together with <pasian>, god) (r:24.48.13)
khempa = (i:1) (t:n) (w:deceiver/cheat) (d:<khem>, deceive, with <pa>, a man: a man who deceives, as in {mi khempa}) (s:kheempa) (b:khem) (q:draft)
khempeh = (i:1) (t:det) (w:all) (d:apparently a misprint or short form of <khempeuh>, all) (q:draft, low confidence)
khempeuh = (i:2) (t:adv) (w:entirely) (d:wholly, all of it without exception) (s:vek-in)
khempeuha = (i:1) (t:det) (w:every/all/throughout) (d:<khempeuh> with the ending <a>, in or of: {mun khempeuha} is in every place, everywhere) (b:khempeuh) (q:draft)
khempeuhah = (i:1) (t:adv) (w:entirely/throughout/everywhere) (d:<khempeuh>, all, with the place marker <ah>: in all of, throughout; {mun khempeuhah} is everywhere) (b:khempeuh)
khempeuhah = (i:2) (t:pron) (w:every/in all) (d:<khempeuh>, all, with the marker <ah>: in every, in all; {na khempeuhah} is in everything) (b:khempeuh)
Khempeuhah = (i:1) (t:adv) (w:everywhere/on every side) (d:<khempeuh> all with the place marker <ah>, written with a capital in the name {Mun Khempeuhah Launa}, Terror on Every Side) (b:khempeuhah) (q:draft)
khempeuhin = (i:1) (t:pron) (w:all/the whole) (d:<khempeuh> all with the ending <in>, which marks the group as the doer or the span as the setting: all of them, throughout all) (b:khempeuh) (q:draft)
khempeuhleh = (i:1) (t:phrase) (w:all and) (d:<khempeuh>, all, written together with <leh>, and) (q:draft, low confidence)
khempeuhte = (i:1) (t:pron) (w:every/all/everyone) (d:<khempeuh>, all, with the plural <te>: all of them, everyone) (b:khempeuh)
khemsa = (t:see) <khemsa-in>
khemsa-in = (i:1) (t:v) (w:being deceived/deceived) (d:<khem>, deceive, with <sa>, already done, and the connective <in>; after a possessor and before {om kei un} it means do not be deceived by) (q:draft)
khemsiamna = (i:1) (t:n) (w:craftiness/cunning/deceit) (d:<khem> deceive with <siam> skilled and the noun suffix <na>: skill in deceiving) (s:khemna/ngian) (q:draft)
khemte = (i:1) (t:n) (w:deceivers/those who deceive/the treacherous) (d:<khem>, deceive, with the plural ending {-te}; {mi khemte} are people who deceive others) (s:kheemte/mikhemte) (b:khem) (q:draft)
khemtheih = (i:1) (t:v) (w:be able to deceive/can deceive) (d:<khem>, deceive, with <theih>, the form of <thei>, can, used before another word: {a khemtheih nawn loh nadingin} is so that he can deceive no more) (b:khem) (q:draft)
khemul = (i:1) (t:n) (w:hair of the legs/leg hair) (d:<khe> foot or leg with <mul> body hair; renders the Hebrew hair of the feet, where the NIV has private parts) (q:draft)
khemzawh = (i:1) (t:v) (w:deceive/beguile/take in) (d:<khem>, deceive, with <zawh>, form of <zo>, manage: succeed in deceiving, take in) (s:khemzo) (q:draft)
khemzo = (i:1) (t:v) (w:deceive/succeed in deceiving/outwit) (d:<khem>, deceive, with <zo>, be able, succeed) (s:khemzawh/khem) (b:khem) (r:31.1.3) (q:draft)
khen = (i:1) (t:v) (w:divide/separate) (d:divide into parts or groups, or separate one thing from another) (s:khenkhia/hawm) (a:gawm/kaikhawm)
khen = (i:2) (t:v) (w:hammering/hammer/nail) (d:drive in with a hammer; {khen kip} is nail something firmly in place) (s:kilh)
Khen-anah = (i:1) (t:name) (c:male) (w:Kenaanah) (d:father of Zedekiah, the false prophet in the time of King Ahab) (q:draft)
Khena = (t:see) <Khena-anah>
Khena-anah = (i:1) (t:name) (c:male) (w:Kenaanah) (d:name of two men: the father of the false prophet Zedekiah, and a son of Bilhan in the tribe of Benjamin) (r:13.7.10) (q:draft)
Khenaanah = (i:1) (t:name) (c:male) (w:Kenaanah) (d:name of two men: the father of the false prophet Zedekiah, and a son of Bilhan in the tribe of Benjamin) (r:13.7.10/14.18.10)
Khenani = (i:1) (t:name) (c:male) (w:Kenani) (d:a Levite who led the people in prayer in the time of Nehemiah) (q:draft)
Khenaniah = (i:1) (t:name) (c:male) (w:Kenaniah) (d:chief of the Levites who led the singing when David brought up the ark; also an Izharite appointed with his sons as official and judge over Israel) (r:13.15.22/13.26.29)
khencip = (i:1) (t:v) (w:nail fast/crucify) (d:<khen>, hammer, with <cip>, firmly: nail fast, as on a cross) (s:kilhcip) (b:khen) (q:draft)
Khene = (i:1) (t:name) (w:Khene) (d:first part of the name <Khene-anah>, Kenaanah, the father of the false prophet Zedekiah)
Khene-anah = (i:1) (t:name) (c:male) (w:Kenaanah) (d:father of Zedekiah, the false prophet in the time of King Ahab) (q:draft)
kheng = (i:1) (t:v) (w:pass by/go past/go beyond) (d:go past a person, a place or a boundary) (s:khengsuak/nawkkha) (q:draft)
khengak = (i:1) (t:n) (w:footstool/footrest) (d:<khe> foot with <ngak>: a place to rest the feet; {khengak nading}, for a footstool) (s:khengakna) (q:draft)
khengakna = (i:1) (t:n) (w:footstool) (d:<khe>, foot, with <ngakna>, rest: the place where the feet rest) (s:khengak/sikna) (b:khengak) (q:draft)
khengin = (i:1) (t:v) (w:going beyond/passing/beyond) (d:<kheng>, pass, with the linking suffix <in>: going past a place or over a limit, and then doing the next thing; often translated beyond) (b:kheng) (r:42.3.13) (q:draft)
khengkhin = (i:1) (t:v) (w:have passed/be already past) (d:<kheng>, pass, with <khin>, already) (s:khengta) (b:kheng) (q:draft)
khenglah = (i:1) (t:v) (w:be captivated by/be taken in by) (d:used with {kei in}, do not; the exact sense is not clear from the verse) (q:draft, low confidence)
khenglahkha = (i:1) (t:v) (w:be captivated by/be taken in by) (d:<khenglah> with <kha>, happen to; used with {kei in}, do not; the exact sense is not clear from the verse) (q:draft, low confidence)
khengsuak = (i:1) (t:v) (w:pass by/go past) (d:<kheng>, pass, with <suak>, come out: go on past someone or something) (s:kheng) (q:draft)
khengsuakin = (i:1) (t:v) (w:passing over/passing by) (d:<khengsuak>, pass by, with <in>) (b:khengsuak) (q:draft)
khengta = (i:1) (t:v) (w:have passed/have come to pass) (d:<kheng>, pass, with <ta>, now or already) (s:khengkhin) (b:kheng) (q:draft, low confidence)
khengto = (t:see) <khengto-in>
khengto-in = (i:1) (t:v) (w:passing up beyond/going above) (d:<kheng>, pass, with <to>, upward, and <in>) (q:draft)
khengval = (i:1) (t:v) (w:go too far/overstep/be presumptuous) (d:go beyond what is right or allowed; {khengval lua}, go much too far) (q:draft)
Khengval = (i:1) (t:name) (w:Khengval) (d:the verb <khengval>, go too far, written with a capital at the start of a sentence: {Khengval lua uh teh}, you have gone too far)
khengvala = (i:1) (t:adv) (w:presumptuously/going too far) (d:<khengval>, overstep, with <a>, joining it to the next verb) (s:khengvalin) (b:khengval) (q:draft)
khengvalin = (i:1) (t:adv) (w:presumptuously/excessively/beyond the limit) (d:<khengval> go beyond with <in>; doing more than is right or allowed) (s:khengvala) (b:khengval) (q:draft)
khengvallua = (i:1) (t:v) (w:go much too far/overstep greatly) (d:<khengval>, go too far, with <lua>, too much) (b:khengval) (q:draft)
khenin = (i:1) (t:v) (w:dividing/separating) (d:<khen>, divide, with the linking suffix <in>: dividing or separating, and then doing the next action) (b:khen) (q:draft)
khenin = (i:2) (t:v) (w:judging/deciding) (d:<khen>, judge, with the linking suffix <in>; {thu khenin} is judging a matter, giving a verdict) (s:thukhenin) (b:khen) (q:draft)
khenin = (i:3) (t:adv) (w:in divisions/group by group) (d:in the doubled form {a khen khenin}, divided into groups, division by division) (b:khen) (r:14.26.11) (q:draft)
khenkhak = (i:1) (t:v) (w:judge/condemn) (d:{thu khen}, judge, with <khak>, happen to; {thu khenkhak loh nading} is so as not to come under judgment) (q:draft, low confidence)
khenkham = (i:1) (t:v) (w:divide/split/part) (d:split in two so that there is a way through; said of the sea) (s:phelkham/khenkhia) (q:draft)
khenkhamin = (i:1) (t:v) (w:dividing/splitting apart/breaking down) (d:<khenkham>, split apart or break <in> pieces, with the linking suffix in) (b:khenkham) (r:24.18.7) (q:draft)
khenkhat = (i:1) (t:det) (w:some/part of/partly) (d:a part of a whole; repeated, partly one thing and partly another) (s:kimkhat/pawkhat) (q:draft)
khenkhawm = (i:1) (t:v) (w:judge together/decide together) (d:<khen>, in {thu khen}, judge, with <khawm>, together) (b:khen) (q:draft)
khenkhenin = (i:1) (t:adv) (w:by divisions/group by group) (d:<khen>, divide, said twice, with <in>: each in its own division) (s:pawlpawlin/honhonin) (q:draft)
khenkhente = (i:1) (t:n) (w:divisions/groups) (d:<khen>, divide, said twice, with the plural <te>: the several divisions of a body of people) (s:khente/khennate) (q:draft)
khenkhia = (i:1) (t:v) (w:separate/split/set apart) (d:take one thing away from another so that they are apart; set people or things apart for a purpose) (s:tuamkoih/tengkhia) (a:gawm/koihkhawm) (b:khen)
khenkhia = (i:2) (t:v) (w:divide/part) (d:split something so that it opens, as God parted the sea) (s:khenkham/phelkham) (b:khen) (r:19.108.7)
khenkhia = (i:3) (t:v) (w:break up) (b:khen)
khenkhiasak = (i:1) (t:v) (w:separate out/remove/set apart) (d:<khenkhia>, separate, with <sak>, cause or let: have something separated out) (b:khenkhia) (q:draft)
khenkhiat = (i:1) (t:v) (w:set apart/separate/divide off) (d:form of <khenkhia> used before another word or before the command ending <un>) (s:tuamkoih) (b:khenkhia) (r:4.31.42) (q:draft)
khenkhiatna = (i:1) (t:n) (w:separation/setting apart) (d:<khenkhiat> set apart with the noun suffix <na>: the act of setting apart) (b:khenkhiat) (q:draft)
khenkhit = (i:1) (t:v) (w:have decided/have judged) (d:<khen> divide or decide, with <khit> finish; {thu a khenkhit uh ciangin}, when they had decided the matter or passed sentence) (s:khentatzo) (q:draft)
khenkhit = (i:2) (t:v) (w:have passed/pass through/get past) (d:leave a place behind after going past or through it: said of passing guard posts and of travelling through a region) (s:khengkhin) (q:draft, low confidence)
khenkip = (i:1) (t:v) (w:nail down/drive in firmly/fasten) (d:<khen> hammer with <kip> firm: fix in place with nails, or drive in as a peg) (s:kilh) (q:draft)
khenna = (i:1) (t:n) (w:judgment/decision/verdict) (d:the deciding of a matter, often as {thu khenna}) (s:thukhenna) (b:khen) (r:20.16.2) (q:draft)
khenna = (i:2) (t:n) (w:division/separation) (d:<khen>, divide, with the noun suffix <na>: a part or group into which people are divided, or a dividing into groups) (s:kikhenna) (b:khen) (q:draft)
khennate = (i:1) (t:n) (w:judgments/decisions) (d:plural of <khenna> in the sense of {thu khenna}, deciding a case) (s:thukhennate) (b:khenna) (q:draft)
khennate = (i:2) (t:n) (w:divisions/groups) (d:plural of <khenna>, a part into which people are divided) (s:khente/kikhennate) (b:khenna) (q:draft)
khennih = (i:1) (t:n) (w:two parts/two halves) (d:<khen>, divide, with <nih>, two; {khennih suah} is make into two parts) (s:phelnih) (q:draft)
khennihte = (i:1) (t:n) (w:two divisions/two companies) (d:<khennih>, two parts, with the plural <te>) (b:khennih) (q:draft)
khenpa = (i:1) (t:n) (w:judge/one who decides) (d:in {thu khenpa}, the one who decides a matter; <pa> marks a male person) (s:thukhenpa) (b:khen) (q:draft)
khensak = (i:1) (t:v) (w:judge/decide/settle) (d:with <thu>: decide a matter for someone, give judgement) (s:thukhen) (b:khen) (q:draft)
khensakin = (i:1) (t:v) (w:judge/decide) (d:<khensak>, decide a matter for someone, with the linking ending <in>: giving judgement, and then going on to the next action) (b:khensak) (q:draft)
khensakzaw = (i:1) (t:v) (w:judge rather/judge instead) (d:<khensak>, decide a matter for someone, with <zaw>, rather: be the one who judges instead of another) (b:khensak) (r:46.6.2) (q:draft, low confidence)
khensat = (i:1) (t:v) (w:decide/determine/resolve) (d:make up the mind firmly about what to do; {lungsim khensat} is resolve) (s:khentat)
khensatin = (i:1) (t:v) (w:deciding/having decided) (d:<khensat>, decide, with <in>; {thu khensatin} is having made a decision) (b:khensat) (q:draft)
khensatna = (i:1) (t:n) (w:decision) (d:<khensat>, decide, with the noun suffix <na>: what has been decided) (s:thukhensatna/khenna)
khensatsa = (i:1) (t:adj) (w:decided/determined) (d:<khensat> decide with <sa>, already done: what has been decided beforehand) (b:khensat) (q:draft)
khensuk = (i:1) (t:v) (w:drive down/hammer down) (d:<khen> hammer with <suk>, downward: drive a peg down into something) (b:khen) (q:draft)
khenta = (i:1) (t:v) (w:judge/decide) (d:<khen>, in {thu khen}, judge, with <ta>, now, in a command) (b:khen) (q:draft)
khentat = (i:1) (t:v) (w:determine/resolve) (d:settle firmly in the mind what will be done) (s:khensat)
khentat = (i:2) (t:v) (w:decide/make up the mind) (s:khensat)
khentatin = (i:1) (t:v) (w:deciding firmly/resolving) (d:<khentat>, decide, with <in>) (b:khentat) (q:draft)
khentatna = (i:1) (t:n) (w:determination/resolve/decision) (d:<khentat>, decide, with the noun suffix <na>: a firm decision; {lungsim khentatna} is what the mind has resolved) (s:khensatna) (b:khentat)
khentatzo = (i:1) (t:v) (w:have decided/have made up one's mind) (d:<khentat>, decide, with <zo>, which marks the act as completed; {lungsim khentatzo} is to have made up the mind) (b:khentat) (q:draft)
khentawm = (i:1) (t:v) (w:settle oneself/decide for oneself/judge for oneself) (d:<khen> judge with <tawm>, by oneself: settle a matter or pronounce a judgement oneself) (q:draft)
khente = (i:1) (t:n) (w:divisions/groups) (d:<khen>, divide, with plural {-te}: the groups into which people are divided, as the divisions of the priests or of the army) (b:khen) (r:13.27.1) (q:draft)
khentel = (i:1) (t:v) (w:discern/distinguish/tell apart/understand) (d:tell one thing clearly from another, and so understand or decide; {khentel theihna} is discernment or good judgment) (s:khenthei/theitel) (r:46.12.10) (q:draft)
khentelna = (i:1) (t:n) (w:distinction/telling apart) (d:<khentel> tell one from another, with the noun suffix <na>) (b:khentel) (q:draft)
khenthang = (i:1) (t:v) (w:scatter/divide/disperse) (d:<khen> divide with <thang>, abroad: divide and scatter among others; parallel to <thehthang>) (s:thehthang) (a:kaikhawm) (q:draft)
khenthei = (i:1) (t:v) (w:discern/distinguish/recognize/tell apart) (d:<khen> divide with <thei> know or be able, tell one thing from another; {thu khenthei} is be able to judge) (s:khentel/theitel) (b:khen) (q:draft)
khentheih = (i:1) (t:v) (w:be able to judge/be able to tell apart) (d:<khen> divide or judge, with <theih> can, the form used before <nading> and <ding>) (b:khen) (q:draft)
khentheita = (i:1) (t:v) (w:can now distinguish/be able to tell apart) (d:<khenthei>, distinguish, with <ta>, now or already) (b:khenthei) (q:draft)
khentuam = (i:1) (t:n) (w:partiality/favouritism) (d:<khen>, divide, with <tuam>, separate: treating people differently; {mi khentuam nei lo} is showing no partiality) (s:angvanna/deidanna) (q:draft)
khenuai = (i:1) (t:n) (w:sole of the foot/sole) (d:<khe>, foot, and <nuai>, under: the underside of the foot; with <ah>, under the feet) (s:khepeek) (q:draft)
khenzaw = (i:1) (t:v) (w:judge rather/judge instead) (d:<khen>, in {thu khen}, judge, with <zaw>, rather) (b:khen) (q:draft)
khenzia = (i:1) (t:n) (w:way of judging/manner of judging) (d:<khen>, in {thu khen}, judge, with <zia>, manner) (q:draft)
khenzo = (i:1) (t:v) (w:be able to separate/separate) (d:<khen>, divide, with <zo>, be able) (b:khen) (q:draft)
khenzo = (i:2) (t:v) (w:settle/decide/pass judgement/decree) (d:with <thu>, matter: {thu khenzo} means settle a case or give the verdict) (b:khen) (q:draft)
khep = (i:1) (t:v) (w:fold/fold up/roll up) (d:fold cloth over on itself) (q:draft)
khepeek = (i:1) (t:n) (w:foot/sole of the foot) (d:the flat part of the foot, from <khe> foot) (s:khenuai/khepek) (q:draft)
khepeekte = (i:1) (t:n) (w:feet/soles of the feet) (d:<khepeek>, sole of the foot, with the plural <te>) (s:khepekte) (b:khepeek) (q:draft)
khepek = (i:1) (t:n) (w:foot) (d:the foot itself, the part below the leg) (s:khepeek) (q:draft)
khepekte = (i:1) (t:n) (w:feet) (d:<khepek>, the foot below the ankle, with plural <te>; set beside <khete>, legs) (s:khepeekte) (b:khepek) (q:draft)
khephung = (i:1) (t:n) (w:feet/foot) (d:<khe> foot with <phung>: the place at the feet of someone, where a person bows down) (q:draft)
khephungah = (i:1) (t:n) (w:at the feet) (d:<khephung>, the place at the feet of someone, with <ah>, at) (b:khephung) (q:draft)
khepi = (i:1) (t:n) (w:big toe) (d:<khe> foot with <pi> great, as <khutpi> is the thumb) (b:khe) (q:draft)
khepite = (i:1) (t:n) (w:big toes/great toes) (d:<khepi>, big toe, with plural {-te}; paired with <khutpite>, thumbs) (b:khepi) (q:draft)
Kheran = (i:1) (t:name) (c:male) (w:Cheran/Keran) (d:son of Dishon, a descendant of Seir the Horite in Edom) (r:1.36.26/13.1.41)
Khereth = (i:1) (t:name) (c:people) (w:Kerethites) (d:people of the southern coast near the Philistines; with the Pelethites they formed the guard of David under Benaiah) (r:10.8.18/10.20.23)
Kherith = (i:1) (t:name) (c:river) (w:Kerith) (d:ravine with a brook east of the Jordan, where Elijah hid during the drought) (r:11.17.3/11.17.5)
kherub = (i:1) (t:n) (w:cherub/cherubim) (d:winged heavenly being; two golden cherubim stood on the cover of the ark and two of olive wood in the temple) (r:11.6.26) (q:draft)
Kherub = (i:1) (t:n) (w:cherub) (d:winged heavenly being, here written with a capital letter) (r:11.6.26)
kherubte = (i:1) (t:n) (w:cherubim/cherubs) (d:plural of <kherub>: the winged heavenly beings, and the figures of them in the tabernacle and temple) (b:kherub) (r:26.10.18) (q:draft)
Kherubte = (i:1) (t:n) (w:cherubim) (b:Kherub) (r:2.25.20) plural form of <Kherub>
Khesalon = (i:1) (t:name) (c:place) (w:Kesalon) (d:place on the northern border of Judah, another name for Mount Jearim) (r:6.15.10)
Khesed = (i:1) (t:name) (c:male) (w:Chesed/Kesed) (d:son of Nahor and Milkah, nephew of Abraham) (r:1.22.22)
khesikna = (i:1) (t:n) (w:foothold/footing) (d:<khe>, foot, with <sik>, tread, and the noun suffix <na>: where the foot treads; {khesikna mun} is a place to stand) (q:draft)
Khesil = (i:1) (t:name) (c:land) (w:Chesil/Kesil) (d:town in the far south of Judah) (r:6.15.30)
Khesulloth = (i:1) (t:name) (c:place) (w:Kesulloth) (d:town in the territory of Issachar, listed with Jezreel and Shunem) (r:6.19.18)
khet = (i:1) (t:v) (w:drive in/hammer in) (d:drive in a peg; probably the form of <khen>, hammer, used before <ding>) (q:draft, low confidence)
khetbuk = (i:1) (t:n) (w:hammer/mallet) (d:tool for driving in a peg, <khetphim>) (s:sek) (q:draft)
khete = (i:1) (t:n) (w:feet/legs) (d:plural of <khe>: the feet, and also the legs of a person or animal) (b:khe) (q:draft)
khetphim = (i:1) (t:n) (w:peg/tent peg/nail) (d:pin driven in with a hammer; {puanbuk khetphim} is a tent peg) (s:singzum) (r:2.38.31) (q:draft)
khetphimte = (i:1) (t:n) (w:tent pegs/pegs/stakes) (d:plural of <khetphim>, the pegs driven into the ground to hold a tent) (b:khetphim) (q:draft)
khetul = (i:1) (t:n) (w:heel) (d:the back part of the foot) (r:1.3.15)
khetulin = (i:1) (t:n) (w:by the heel) (d:<khetul>, heel, with <in>) (b:khetul) (q:draft)
kheuh = (i:1) (t:v) (w:strip/pick clean/tear off) (d:strip off what covers something, as flesh from bones or leaves from branches) (q:draft)
khezaw = (i:1) (t:adj) (w:lame/crippled) (d:<khe>, foot or leg, with <zaw>, weak: unable to walk; {khutzaw khezaw} are the paralyzed and the lame) (s:khebai/bai) (b:khe) (q:draft)
khezawte = (i:1) (t:n) (w:the crippled/the lame/cripples) (d:plural of <khezaw>, a person whose legs are weak or disabled) (s:khebaite) (b:khezaw) (q:draft)
Khezib = (i:1) (t:name) (c:land) (w:Chezib/Kezib) (d:town in the lowland of Judah where Shelah son of Judah was born) (r:1.38.5)
khi = (i:1) (t:n) (w:necklace/neck chain) (d:ornament worn round the neck) (s:khainiang) (q:draft)
khia = (i:1) (t:adv) (w:out) (d:placed after a verb of motion or action: out, outward) (r:7.9.39)
khia = (i:2) (t:adv) (w:away) (d:placed after a verb: away, off)
khiahlna = (i:1) (t:n) (w:sin/sexual immorality) (d:apparently a misprint of <khialhna>, sin; {numei tawh khiahlna} is sexual immorality) (s:khialhna) (q:draft, low confidence)
khiakhia = (i:1) (t:adv) (w:out again and again) (d:<khia>, out, said twice after a verb: doing it repeatedly) (b:khia) (q:draft, low confidence)
khiakhin = (i:1) (t:v) (w:put in completely/give all) (d:<khia>, drop or put in, as an offering, with <khin>, completely) (q:draft)
khiakik = (i:1) (t:v) (w:withdraw/take back) (d:said of punishment that will not be taken back again; another text has <khiamkik> in this place) (q:draft, low confidence)
khiakin = (i:1) (t:v) (w:cut off/break off) (d:with the linking ending <in>: having cut or broken off a stick, and then going on to the next action) (q:draft, low confidence)
khial = (i:2) (t:n) (w:regret) (d:in <khial kisa>, feel that one has done wrong: regret)
khialh = (i:1) (t:v) (w:sin/do wrong) (d:form of <khial> used before <loh>, <ding>, <hangin> and similar words) (s:mawh) (b:khial) (q:draft)
khialhkhak = (i:1) (t:v) (w:fall into sin/do wrong) (d:<khialh> sin, with <khak> happen to; found in {khialhkhak loh nading}, so as not to fall into sin) (q:draft)
khialhkhaknate = (i:1) (t:n) (w:sins/offences) (d:<khialhkhak>, fall into sin, with the noun suffix <na> and the plural <te>) (s:khialhnate/mawhnate) (b:khialhkhak) (q:draft)
khialhloh = (i:1) (t:v) (w:not sin/keep from sinning) (d:<khialh> sin with <loh>, not, written as one word before <nadingin>: so as not to sin) (q:draft)
khialhna = (i:1) (t:n) (w:sin/wrong/transgression) (d:<khialh>, do wrong, with the noun suffix <na>: a sin or wrong; {khialhna hanga biakna} is a sin offering) (s:mawhna/khialna) (a:dikna) (b:khialh) (q:draft)
khialhnapa = (i:1) (t:n) (w:wronged person) (d:<khialhna>, wrong, with <pa>, man: the man against whom the wrong was done) (b:khialhna) (q:draft)
khialhnasate = (i:1) (t:n) (w:past sins/sins already committed) (d:<khialhna> sin with <sa>, already done, and the plural <te>: the sins committed before) (q:draft)
khialhnate = (i:1) (t:n) (w:sins/wrongdoings/faults) (d:plural of <khialhna>: sins, wrong acts) (s:mawhnate) (b:khialhna) (q:draft)
khialhnateng = (i:1) (t:n) (w:all the sins/sins) (d:<khialhna> sin with <teng>, all of: the whole of the sins) (b:khialhna) (q:draft)
khialhpih = (i:1) (t:v) (w:lead astray/mislead) (d:cause others to go wrong along with oneself; used with <lam>, way, and after <makaih>, lead) (s:khialsak/khialhsak) (b:khialh) (q:draft)
khialhsa = (i:1) (t:adj) (w:committed/sinned) (d:<khialh> sin with <sa>, already done: {a khialhsa uh}, what they had done wrong) (b:khialh) (q:draft, low confidence)
khialhsak = (i:1) (t:v) (w:cause to sin/cause to stumble/lead astray) (d:<khialh>, do wrong, with <sak>: make someone do wrong) (s:khialsak/puksak) (b:khialh) (r:40.5.19) (q:draft)
khialhsakna = (i:1) (t:n) (w:causing to sin) (d:the act of making others do wrong, or the sin that someone led others into; <khialhsak> with <na>) (b:khialhsak) (q:draft)
khialin = (i:1) (t:v) (w:sin/do wrong/err) (d:form of <khial> with the linking suffix <in>, doing wrong and then going on to the next action) (b:khial) (q:draft)
khialin = (i:2) (t:adv) (w:wrongly) (d:as {a khialin} with <hei> or <heisak>, turn wrongly: pervert or distort what is right) (b:khial) (q:draft, low confidence)
khialkha = (i:1) (t:v) (w:sin/err/go astray) (d:<khial>, do wrong, with <kha>, happen to: fall into sin or make a mistake, often without meaning to) (q:draft)
khialkhawm = (i:1) (t:v) (w:sin together/share in sin) (d:<khial>, do wrong, with <khawm>, together) (b:khial) (q:draft)
khialkhin = (i:1) (t:v) (w:have sinned/have done wrong) (d:<khial>, do wrong, with <khin>, already) (b:khial) (q:draft)
khialna = (i:1) (t:n) (w:sin/wrongdoing/offence) (d:<khial>, do wrong, with the noun suffix <na>: sin or wrongdoing; {khialna hanga biakna} is a sin offering) (s:khialhna/mawhna) (b:khial) (q:draft)
khialnate = (i:1) (t:n) (w:faults/errors) (d:<khialna>, wrongdoing, with the plural <te>) (s:khialhnate) (b:khialna) (q:draft)
khialnu = (i:1) (t:n) (w:guilty woman/adulteress) (d:<khial> do wrong with <nu>, the woman: the woman who has done wrong; in Leviticus 20:10 the adulteress, beside <khialpa>, the man) (b:khial) (q:draft)
khialpa = (i:1) (t:n) (w:wrongdoer/sinner/guilty man) (d:the man who has done wrong; <pa> marks a man, the woman is <khialnu>) (s:mawhpa/mawhneipa) (b:khial) (q:draft)
khialsa = (i:1) (t:adj) (w:sinful/already in sin) (d:<khial> do wrong with <sa>, already: being in sin from before; parallel to <mawhsa>) (s:mawhsa) (b:khial) (q:draft)
khialsak = (i:1) (t:v) (w:cause to sin/lead astray/mislead) (d:<khial> with the causative <sak>: make someone go wrong; {lam khialsak} is to lead off the right way) (s:khialhsak/lampialsak/pialsak) (b:khial) (q:draft)
khialsakin = (i:1) (t:v) (w:leading astray/causing to sin) (d:<khialsak> cause to go wrong, with the linking ending <in>) (b:khialsak) (q:draft)
khialsakte = (i:1) (t:n) (w:those who cause to sin/those who lead astray) (d:<khialsak> cause to sin with the plural <te>: the people who led others into sin) (b:khialsak) (q:draft)
khialsakzo = (i:1) (t:v) (w:be able to lead into sin/succeed in leading astray) (d:<khialsak>, cause to sin, with <zo>, be able or have done) (b:khialsak) (q:draft)
khialtat = (i:1) (t:v) (w:do wrong/act violently) (d:said of a person who formerly did harm to others; the exact sense is not clear from the verse) (q:draft, low confidence)
khialte = (i:1) (t:n) (w:wrongdoers/sinners) (d:those who do wrong or sin; after another verb, those who do it wrongly, as in {zang khialte}, those who misuse) (s:mawhte/mimawhte) (b:khial) (q:draft)
khialthei = (i:1) (t:v) (w:be liable to err/can go wrong/stumble) (d:<khial>, do wrong, with <thei>, can) (b:khial) (q:draft)
khialthuah = (i:1) (t:v) (w:sin further/add sin to sin) (d:<khial>, do wrong, with <thuah>, in addition; with <semsem>, sin more and more) (q:draft)
khialzaw = (i:1) (t:v) (w:be in the wrong/be at fault) (d:<khial> be wrong with <zaw>, rather: be the one who is wrong and not the other) (b:khial) (q:draft)
khialzo = (i:1) (t:v) (w:have sinned/have done wrong) (d:<khial> do wrong with <zo>, which marks the act as carried through) (b:khial) (q:draft)
khiam = (i:1) (t:v) (w:reduce/diminish/subtract/take away) (d:make less; opposite of <behlap>, add to) (a:behlap) (q:draft)
khiamin = (i:1) (t:v) (w:weaken/slacken/diminish) (d:<khiam>, make or become less, with the linking ending <in>: of effort, growing less) (b:khiam) (q:draft)
khiamkik = (i:1) (t:v) (w:reduce again/lessen again) (d:<khiam>, reduce, with <kik>, back or again; said of punishment that will not be lessened again) (b:khiam) (q:draft, low confidence)
khiamsak = (i:1) (t:v) (w:slacken/slow down/reduce) (d:<khiam> reduce with the causative <sak>: make less; {a pai khiamsak} is slow the pace) (b:khiam) (q:draft)
khiamsuk = (i:1) (t:v) (w:decrease/reduce/bring down) (d:<khiam>, reduce, with <suk>, downward) (b:khiam) (q:draft)
khian = (i:1) (t:adv) (w:stealthily/secretly/quietly) (d:placed after a verb of coming or moving: without being noticed) (q:draft)
khiang = (i:1) (t:v) (w:bring back/turn back) (d:fetch back an animal that has strayed from the way) (q:draft, low confidence)
khiankhian = (i:1) (t:adv) (w:stealthily/creeping) (d:<khian> said twice, after a verb of moving: going about quietly and unseen; {a vak khiankhian pulnatna} is the pestilence that stalks about) (q:draft)
khiankhianin = (i:1) (t:adv) (w:stealthily/creeping) (d:<khiankhian> with <in>, after a verb of going: moving about quietly and unseen) (b:khiankhian) (q:draft)
khiapa = (i:1) (t:n) (d:the man who has done the action out or away; <khia> out, joined to the verb before it, with <pa> for a male person: {a zuak khiapa}, the one who sold it off, the seller) (b:khia) (q:draft)
khiapsak = (i:1) (t:v) (w:shorten/cut short) (d:<khiap> with the causative <sak>: make shorter, cut short, said of the days of a life) (s:tomsak) (a:sausak) (q:draft)
khiasak = (i:1) (t:v) (w:send out/drive out/let out) (d:<khia> out with the causative <sak>, placed after a verb: make someone or something go out or away, as {ciah khiasak} send on the way) (s:sawlkhia/khahkhia) (a:lutsak) (b:khia) (q:draft)
khiasakzo = (i:1) (t:v) (w:have brought out/have made manifest) (d:<khiasak>, make come out, with <zo>, have done; {kilang khiasakzo} is has made clearly seen) (b:khiasak) (q:draft, low confidence)
khiasuk = (i:1) (t:v) (w:let down/lower/throw down) (d:<khia>, let go, with <suk>, downward: let down, drop or throw something down, as a person by a rope, a boat into the sea or a staff on the ground) (s:khiatsuk/khaisuk/lawnsuk) (a:kaito) (b:khia) (q:draft)
khiasukin = (i:1) (t:v) (w:putting down/placing under) (d:<khiasuk>, put or let down, with the linking ending <in>: putting something down or under, and then going on to the next action) (s:khiatsukin) (b:khiasuk) (q:draft)
khiat = (i:1) (t:adv) (w:out/away) (d:form of <khia> used after a verb when another word such as <phetin>, <ciangin> or <ding> follows) (b:khia) (q:draft)
khiat = (i:2) (t:v) (w:throw in/put in/drop/cast) (d:let a thing fall or throw it into a place, as coins into a treasury or a person into the sea, a pit or a prison) (q:draft)
khiat = (i:3) (t:v) (w:interpret) (d:explain the meaning of a dream; {mang khiat} is interpret a dream, and {mang khiat siamna} is skill in interpreting dreams) (q:draft, low confidence)
khiate = (i:1) (t:n) (d:those who, or the things that, do the action out or away; <khia> out, joined to the verb before it, with the plural <te>: {a pusuak khiate}, the things that come out) (b:khia) (q:draft)
khiathei = (i:1) (t:v) (w:be able to interpret/can interpret) (d:<khiat>, interpret a dream, with <thei>, be able; {mang khiathei} is one who can interpret dreams) (q:draft)
khiathuah = (i:1) (t:v) (w:throw in besides/cast in as well) (d:<khia>, throw or drop, with <thuah>, in addition) (q:draft)
khiatin = (i:1) (t:adv) (w:off/away) (d:<khiat>, out or off, with <in>, after a verb; {sin khiatin} is shaking off) (b:khiat) (q:draft)
khiatna = (i:1) (t:n) (w:meaning/interpretation) (d:<khiat>, interpret, with the noun suffix <na>: the meaning of words or the interpretation of a dream) (s:cihnopna/gennopna)
khiatna = (i:2) (t:adj) (w:definition)
Khiatnate = (i:1) (t:n) (w:interpretations/meanings) (d:plural of <khiatna>, the meaning or interpretation of a dream) (q:draft)
khiato = (i:1) (t:adv) (w:up out/up and out) (d:<khia>, out, with <to>, up, placed after a verb for movement out and upward: {po khiato} is spring up, {kai khiato} is pull up out) (b:khia) (q:draft)
khiatpih = (i:1) (t:v) (w:bring out/lead out/take out) (d:<khiat>, out, with <pih>, together with: after <pai>, go out taking someone or something along) (s:paikhiatpih) (a:lutpih) (b:khiat) (q:draft)
khiatpihin = (i:1) (t:v) (w:leading out/bringing out/taking out) (d:<khiatpih> with the ending {-in}: after a verb of going such as <pai> or <kuan>, taking someone out along with oneself, linking to the next verb) (s:paikhiatpihin) (b:khiatpih) (q:draft)
khiatpihmang = (i:1) (t:v) (w:take away/carry off) (d:<khiatpih>, take out along, with <mang>, away or lost; {kipai khiatpihmang} is be taken away altogether) (q:draft, low confidence)
khiatpihna = (i:1) (t:n) (w:bringing out/leading out) (d:<khiatpih>, bring out, with the noun suffix <na>, after <pai>) (s:paikhiatpihna) (b:khiatpih) (q:draft)
khiatpihte = (i:1) (t:n) (w:those taken away/those led out) (d:<khiatpih>, take out along, with the plural <te>, after <pai>) (s:paikhiatpihte) (b:khiatpih) (q:draft)
khiatpihto = (i:1) (t:v) (w:bring up out/lead up) (d:<khiatpih>, bring out, with <to>, upward, after <pai>) (s:paikhiatpihto) (b:khiatpih) (q:draft)
khiatsa = (i:1) (t:adv) (d:out or away, of an action already done; <khiat> out, joined to the verb before it, with <sa> for a completed action: {ka gen khiatsa}, what I have spoken out) (b:khiat) (q:draft)
khiatsak = (i:1) (t:v) (w:take off/remove/take away) (d:placed after another verb such as <suah>, <paih>, <sat> or <hawk>: off or away, done to or for someone; <khiat> out with <sak>) (b:khiat) (q:draft)
khiatsak = (i:2) (t:v) (w:interpret/explain) (d:tell someone the meaning of a dream; <khiat>, interpret, with <sak>, for someone) (s:gentel/hilhtel) (b:khiat) (q:draft, low confidence)
khiatsakin = (i:1) (t:v) (w:taking off/removing/taking away) (d:<khiatsak> with the linking ending <in>; follows a verb for removing something from someone and leads on to the next action: {at khiatsakin}, cutting off; {lak khiatsakin}, taking out) (b:khiatsak) (q:draft)
khiatsakna = (i:1) (t:n) (w:cutting off/removal) (d:<khiatsak>, take off, with the noun suffix <na>; {at khiatsakna} is the cutting off of something) (s:atkhiatsakna) (b:khiatsak) (q:draft)
khiatsakpa = (i:1) (t:n) (w:the one who put) (d:<khiat>, put or drop, with <sak> and <pa>: the one who had something put in a place, here under someone) (q:draft, low confidence)
khiatsuk = (i:1) (t:v) (w:let down/lower/drop/throw down) (d:<khiat>, drop, with <suk>, downward: send, lower, swing or throw something down) (s:khiasuk/lawnsuk/khaisuk) (a:kaito) (b:khiat) (q:draft)
khiatsukin = (i:1) (t:v) (w:dropping/throwing down) (d:<khiatsuk>, let or throw down, with the linking ending <in>: dropping it down, and then going on to the next action) (s:khiasukin) (b:khiatsuk) (q:draft)
khiatsukna = (i:1) (t:n) (w:casting down/being thrown down) (d:<khiatsuk>, throw down, with the noun suffix <na>; {khiatsukna thuak} is be thrown down) (s:paihna) (b:khiatsuk) (q:draft)
khiatte = (i:1) (t:n) (w:those carried off) (d:<khiat>, out or away, with the plural <te>; {a puak khiatte} are the ones carried away) (b:khiat) (q:draft)
Khido = (i:1) (t:name) (w:Kidon) (d:name attached to the threshing floor where Uzzah touched the ark and died) (q:draft)
Khidon = (i:1) (t:name) (w:Kidon) (d:name attached to the threshing floor where Uzzah touched the ark and died) (r:13.13.9)
khih = (i:1) (t:v) (w:tie/bind/fasten) (d:tie or fasten something on or to something with a cord, as a thread on the wrist, a cap on the head or a sword at the side) (s:gak) (a:sut/phel) (q:draft)
khihcip = (i:1) (t:v) (w:tie fast/bind tightly/tie up) (d:<khih> tie with <cip>, firmly or shut in) (s:hencip) (a:sut) (b:khih) (q:draft)
khihcipna = (i:1) (t:n) (w:binding/bonds) (d:<khihcip>, tie fast, with the noun suffix <na>; {khihcipna thuak} is to be bound) (s:henna/kikhihna/khihna) (b:khihcip) (q:draft)
khihin = (i:1) (t:v) (w:tying/binding/fastening) (d:<khih> tie with <in>, the linking form before a following verb) (s:henin) (b:khih) (q:draft)
khihna = (i:1) (t:n) (w:binding/bond/chain/tether) (d:<khih> tie with <na>: the act of binding, or the rope or chain that binds; {sikkhau khihna}, being bound with a chain) (s:henna/kikhihna/khihcipna) (b:khih) (q:draft)
khihsa = (i:1) (t:adj) (w:tied/bound/tethered) (d:<khih> tie with <sa>, already done) (s:kikhihsa) (b:khih) (q:draft)
khihsakin = (i:1) (t:v) (w:having bound/causing to be tied) (d:<khih>, tie, with the causative <sak> and <in>: having someone tied) (b:khih) (q:draft)
khihsakna = (i:1) (t:n) (w:binding) (d:<khih>, tie, with the causative <sak> and the noun suffix <na>; {a khihsakna sikkhaute} are the chains he had someone bound with) (q:draft)
khihzo = (i:1) (t:v) (w:be able to tie/be able to bind) (d:<khih>, tie, with <zo>, be able) (s:henzo) (b:khih) (q:draft)
khiim = (i:1) (t:v) (w:charm/enchant) (d:bring a snake under control by a spell or by skill; {gul khiim} is charm a snake) (q:draft)
khiimte = (i:1) (t:n) (w:charmers/snake charmers) (d:<khiim> charm a snake with <te>: those who charm) (b:khiim) (q:draft)
khikcip = (i:1) (t:v) (w:be still/be numb/stiffen) (d:become stiff and unmoving, as people frozen with fear, or a heart that feels nothing) (s:hikcip) (q:draft, low confidence)
khikhe = (i:1) (t:adv) (w:quietly/silently/still) (d:after a verb: {om khikhe} keep silent, {ngak khikhe} wait quietly) (s:dide/khinkhian/daitakin) (q:draft)
Khileab = (i:1) (t:name) (c:male) (w:Kileab) (d:second son of David, born at Hebron to Abigail the widow of Nabal) (r:10.3.3)
Khilion = (i:1) (t:name) (c:male) (w:Kilion) (d:son of Elimelek and Naomi and husband of Orpah, who died in Moab) (r:8.1.2/8.1.5)
Khilmad = (i:1) (t:name) (c:city) (w:Kilmad) (d:place named with Asshur among the trading partners of Tyre) (r:26.27.23)
khilongte = (i:1) (t:n) (w:bells) (d:small bells hung on a horse; {khilong}, bell, with the plural <te>) (s:siklongte) (q:draft)
khim = (i:1) (t:n) (w:darkness/dark) (d:darkness, in the phrase {khim zing}, darkness falls or it grows dark over a place) (s:khuamial/mialna) (a:khuavak) (q:draft)
khim = (i:2) (t:v) (w:put on/wear) (d:put on or wear a headdress such as a turban; with <sak>, put it on someone else) (s:khu) (q:draft, low confidence)
Khimham = (i:1) (t:name) (c:male) (w:Kimham) (d:man whom Barzillai the Gileadite sent across the Jordan with King David in his place) (r:10.19.37)
khimin = (i:1) (t:v) (w:wearing on the head/putting on) (d:<khim>, put on a headdress, with the linking suffix <in>: having on the head) (s:khusa-in) (b:khim) (q:draft)
khimsakin = (i:1) (t:v) (w:putting on/wrapping on/dressing) (d:<khim>, wear a turban or a wrapped cloth, with the causative <sak> and the ending {-in}: putting a turban or cloth on someone, linking to the next verb) (q:draft)
khimthei = (i:1) (t:v) (w:be able to charm/can charm) (d:<khim>, charm a snake, with <thei>, can) (q:draft)
khimzin = (i:1) (t:n) (w:darkness/gloom) (d:form of <khimzing>, darkness, used before a following noun: {khimzin’ ni}, a day of darkness) (s:khuamial/khuazing) (a:khuavak) (q:draft)
khimzing = (i:1) (t:v) (w:be dark/grow dark) (d:<khim>, darkness, with <zing>: darkness covers a place; {khimzing sak} is make dark) (s:ziing) (q:draft)
khin = (i:2) (t:n) (w:smokehouse/drying rack) indigenous cultures, meat was often dried or smoked using wooden frames or tripods over slow-burning fires
khing = (i:1) (t:v) (w:be sad/be downcast/grow pale) (d:said of the face, <mai>: look sad, downcast or pale) (s:maikhing) (q:draft)
khing = (i:2) (t:n) (w:remainder/leftover) (d:what is left over, as food that remains until morning; {a khing} is the part left over) (s:valteng) (q:draft, low confidence)
khingin = (i:1) (t:v) (w:sadly/with a sad face) (d:<khing>, be downcast, with <in>; {mai khingin} is with a sad face) (b:khing) (q:draft)
khinin = (i:1) (t:adv) (w:already/completely) (d:<khin>, already, with the linking ending <in>: having done something, and then going on to the next action) (b:khin) (q:draft)
khinkhia = (i:1) (t:v) (w:remove/take away/expel/depose) (d:<khin>, move, with <khia>, out: move a person or thing out of its place, as idols from a land, a people from the sight of God or a ruler from office) (s:koihkhia/paaikhia/nilkhia/lakhia) (q:draft)
khinkhian = (i:1) (t:adv) (w:quietly/calmly/still) (d:after a verb for doing something silently and without moving; {om khinkhian}, keep calm; {im khinkhian}, keep hidden) (s:khikhe/dide/daitakin) (q:draft)
khinkhiat = (i:1) (t:v) (w:remove/take away) (d:form of <khinkhia>, remove, used before another word such as <bangin> or <khit>) (b:khinkhia) (q:draft)
khinkhiatna = (i:1) (t:n) (w:removal/removing) (d:<khinkhiat> remove with the noun ending <na>; {a khinkhiatna ding}, in order to remove) (s:lakkhiatna) (b:khinkhiat) (q:draft)
khinmang = (i:1) (t:adv) (w:completely/entirely/utterly) (d:placed after a verb: the action takes in the whole and nothing is left over) (s:mangkhin) (q:draft)
Khinnereth = (i:1) (t:name) (c:city) (w:Kinnereth) (d:fortified town of Naphtali on the Sea of Galilee, which is also called the Sea of Kinnereth) (r:6.19.35)
Khinneroth = (i:1) (t:name) (c:place) (w:Kinnereth) (d:another spelling of Kinnereth, the town and district by the Sea of Galilee) (r:6.11.2/11.15.20)
khinpa = (i:1) (t:n) (w:the man who has) (d:<khin>, already, with <pa>, man, after a verb: the man who has done or undergone it) (b:khin) (q:draft)
khinsa = (i:1) (t:adv) (w:already) (d:placed after a verb to show that the action is already done and its result remains, often before a noun: {a si khinsa mite}, those who have already died) (s:khinzo) (b:khin) (q:draft)
khinsate = (i:1) (t:part) (w:those who have already) (d:<khinsa>, already completed, with plural {-te}: placed after a verb, those who have already done it; {a si khinsate} are those who have already died) (b:khinsa) (q:draft)
khinsim = (i:1) (t:v) (w:move secretly/shift by stealth) (d:<khin> move with <sim> secretly: move a thing from its place without being seen, as a boundary stone) (q:draft)
khinta = (i:1) (t:v) (w:completed/finished) (d:<khin>, already, with <ta>: be finished, be fully done) (s:mankhin) (b:khin) (r:19.88.4)
khinta = (i:2) (t:adj) (w:finished) (s:kiman/zawhsa) (b:khin)
khinta = (i:3) (t:part) (d:particle suffixed to form verb past tense) (b:khin)
khinte = (i:1) (t:n) (d:those who have already done the action; <khin> already, joined to the verb before it, with the plural <te>: {a thokik khinte}, those who have risen again) (b:khin) (q:draft)
khinzo = (i:1) (t:adv) (w:already) (d:<khin>, already, with <zo>, have done: placed after a verb to mark the action as fully completed) (s:khin/khinsa) (b:khin) (q:draft)
Khios = (i:1) (t:name) (c:place) (w:Chios) (d:island in the Aegean Sea that Paul passed on his voyage to Miletus) (r:44.20.15)
khip = (i:1) (t:v) (w:put on the head/wear on the head) (d:form of <khim>, put on a headdress; {dial khip} is a turban, a cloth worn on the head) (q:draft)
khipkhep = (i:1) (t:adv) (w:completely/utterly) (d:after <dai>, be still: perfectly calm, dead silent) (q:draft, low confidence)
khipsak = (i:1) (t:v) (w:put on the head of) (d:<khip> put on the head with <sak> for another: put a turban or headdress on someone) (s:khusak/khuksak) (b:khip) (q:draft)
khipte = (i:1) (t:n) (w:veils/head coverings/kerchiefs) (d:<khip>, put on the head, with plural <te>: things worn over the head; here in {ai khipte}, where <ai> is divination) (b:khip) (q:draft)
Khirs = (i:1) (t:n) (w:Christ) (d:the Christ, title of Jesus; a rare spelling beside <Khazih> and <Khrih>)
khirsoprase = (i:1) (t:n) (c:stone) (w:chrysoprase) (d:precious stone, the tenth foundation stone of the new Jerusalem, where the NIV has turquoise) (q:draft)
Khislev = (i:1) (t:name) (w:Kislev) (d:ninth month of the Hebrew calendar, falling in November and December) (r:16.1.1/38.7.1)
Khislon = (i:1) (t:name) (c:male) (w:Kislon) (d:father of Elidad, the leader of Benjamin chosen to help divide the land of Canaan) (r:4.34.21)
Khisloth = (t:see) <Khisloth-tabor>
Khisloth-tabor = (i:1) (t:name) (c:place) (w:Kisloth Tabor) (d:town on the border of Zebulun near Mount Tabor) (q:draft)
Khislothtabor = (i:1) (t:name) (c:place) (w:Kisloth Tabor) (d:town on the border of Zebulun near Mount Tabor) (r:6.19.12)
Khisolait = (i:1) (t:name) (w:Khisolait/chrysolite) (d:chrysolite, a precious stone named among the stones that adorned the king of Tyre in Eden) (r:26.28.13)
khit = (i:1) (t:part) (d:particle suffixed to form verb past tense)
khit = (i:2) (t:conj) (w:after) (d:in {khit ciangin}, after: placed after a verb, a noun of time or <tua>, that) (s:khitzawh/tuzawh) (a:mapekin)
khit = (i:3) (t:adj) (w:later) (s:tuzawh)
khita = (i:1) (t:prep) (w:after) (d:<khit> after with the ending <a>: coming after a person in time, {ama khita a tate}, his children after him) (s:khitah/nunga/nungah) (a:ma) (b:khit) (q:draft)
khitah = (i:1) (t:prep) (w:after) (d:after a person in time or succession, <khit> with the place marker <ah>) (s:khita/nunga/nungah) (a:ma) (b:khit) (q:draft)
khite = (i:1) (t:n) (w:necklaces) (d:<khi>, necklace, with the plural <te>: necklaces, listed among gold ornaments with armlets, bracelets, rings and earrings) (b:khi) (q:draft)
khitin = (i:1) (t:conj) (w:after/once) (d:<khit>, finish, with the linking suffix <in>: after doing or becoming something; {a teek khitin} is after growing old, in old age) (s:khitzawh) (b:khit) (q:draft)
khitlam = (i:1) (t:n) (d:the fact that an action is already done: <khit>, finish, with <lam>, placed after a verb and before a word of seeing or knowing, as in {a sih khitlam a mu}, see that she has died) (q:draft)
Khitlish = (i:1) (t:name) (c:land) (w:Chitlish/Kitlish) (d:town in the western foothills of Judah, listed with Kabbon and Lahmas) (r:6.15.40)
khitna = (i:1) (t:n) (d:the fact of having already done something, <khit> with the noun suffix <na>; {a thah khitna thu} is the news that he had killed; {a khitna} also means the last one, as in {dangkasan a khitna}, the last penny) (b:khit) (q:draft)
khitphet = (i:1) (t:adv) (w:as soon as/just after) (d:<khit>, finished, with <phet>, just: the moment something is done; followed by <ciangin>) (q:draft)
khitsa = (i:1) (t:part) (w:already) (d:<khit>, finish, with <sa>: placed after a verb for something already done or completed beforehand; often describes a following noun) (b:khit) (q:draft)
khitsate = (i:1) (t:n) (w:things already done/finished work) (d:<khitsa>, already done, with the plural <te>: the things one has been doing; {ama sep khitsate} is the work he had been doing) (b:khitsa) (q:draft)
khitui = (i:1) (t:n) (w:tears/tear) (d:the water that runs from the eyes when one weeps; <khitui luang> is shed tears) (q:draft)
khituite = (i:1) (t:n) (w:tears) (d:<khitui>, tear, with the plural <te>) (b:khitui) (q:draft)
khitzawh = (i:1) (t:conj) (w:after) (d:<khit>, finish, with <zawh>: placed after a verb or after <tua>, once the action is over; {tua khitzawh phetin} is immediately after that) (s:khitin) (q:draft)
khiukheuna = (i:1) (t:n) (w:destitution/utter poverty) (d:follows <zawn>, poor: the state of being very poor; <khiukheu> seems to be a word that strengthens <zawng>, poor) (s:zawnna) (a:hauhna) (q:draft, low confidence)
Khlo = (t:see) <Khlo-e>
Khlo-e = (i:1) (t:name) (c:female) (w:Chloe) (d:woman whose household brought Paul news of the quarrels in the church at Corinth) (q:draft)
Khloe = (i:1) (t:name) (c:female) (w:Chloe) (d:woman whose household brought Paul news of the quarrels in the church at Corinth) (r:46.1.11)
kho = (i:1) (t:v) (w:farm/practise farming/plow/till) (d:work the land, plow or cultivate a field; almost always in {lo kho}, farm a field, and {lo khopa} is a farmer) (s:khawh)
kho = (i:2) (t:adj) (w:strong/well built/firm/secure) (d:firm, strong and lasting; {kho takin} is firmly and {kip kho} is stand firm, endure) (s:kip)
khoh = (i:1) (t:v) (w:urge/press/entreat) (d:press someone strongly to do or not to do something; also invite pressingly) (s:khosak/hanthawn) (q:draft)
khohsa = (i:1) (t:adj) (w:invited) (d:<khoh>, urge or invite, with <sa> for a completed action: already invited; {a khohsa mite} is those who have been invited) (s:khohsaksa) (b:khoh) (q:draft)
khohsaksa = (i:1) (t:adj) (w:invited) (d:<khoh>, urge or invite, with <sak> and <sa>, already done: {ka khohsaksa mite} is those I have invited) (s:khohsa) (q:draft, low confidence)
khohsate = (i:1) (t:n) (w:invited guests/those invited) (d:<khoh>, urge or invite, with <sa>, already done, and plural <te>: those who have been invited to a feast) (s:kisamte/sapsate) (b:khohsa) (q:draft)
khoi = (i:1) (t:v) (w:bring up/rear/nurture/care for) (d:look after and feed a child, a young animal or a person in need; often paired with <vaak>, feed) (s:khawi) (q:draft)
khoih = (i:1) (t:v) (w:touch/nudge) (d:touch someone with the hand, here as a secret sign) (q:draft, low confidence)
khoina = (i:1) (t:n) (w:care/support/help) (d:<khoi>, care for, with the noun suffix <na>: the care or support given to someone; here paired with <vaak>, feed) (s:kepna) (b:khoi) (q:draft)
khoisa = (i:1) (t:adj) (w:reared/brought up) (d:<khoi>, rear, with <sa>, already done: whom one has brought up) (b:khoi) (q:draft)
khoisak = (i:1) (t:v) (w:nurse for/bring up for) (d:<khoi>, rear, with <sak>, for someone: nurse or bring up a child on behalf of another) (b:khoi) (q:draft)
khokhawm = (i:1) (t:v) (w:plow together/farm together) (d:<kho>, farm, with <khawm>, together: plow a field with two animals yoked together) (b:kho) (q:draft)
khol = (i:1) (t:v) (w:store/store up/lay up) (d:put food or goods away to keep for later use) (s:koihkhol/kem)
khol = (i:2) (t:v) (w:save/save up/lay up) (d:put money or wealth aside for the future; {sum khol} is save money)
kholcipte = (i:1) (t:n) (w:hoarders/those who store up) (d:<khol>, store, with <cip>, tightly, and the plural <te>: those who hoard things for themselves) (q:draft)
kholh = (i:1) (t:adv) (w:beforehand/in advance/ahead) (d:placed after a verb for doing something ahead of time: {theih kholh} foreknow, {ngaihsut kholh} think out beforehand; a form of <khol>) (b:khol) (q:draft)
kholh = (i:2) (t:v) (w:send food to/share food with) (d:take or send a share of food to others who have none) (q:draft, low confidence)
kholhna = (i:1) (t:n) (d:noun form of <kholh>, beforehand, placed after a verb: an act done in advance, as {thupiak kholhna} revelation, {thugen kholhna} foretelling, {kisak kholhna} readiness) (b:kholh) (q:draft)
Kholhna = (i:1) (t:n) (d:<kholhna> written with a capital in a title; {Thugen Kholhna}, foretelling, is the prophecy of Ahijah) (b:kholhna) (q:draft)
kholhnate = (i:1) (t:n) (w:predictions/divinations/warnings) (d:<kholh> beforehand with <na> and the plural <te>, after a verb of speaking: things said in advance, as {thugen kholhnate} predictions and {hilh kholhnate} warnings) (s:genkholhnate) (b:kholhna) (q:draft)
kholhsa = (i:1) (t:adv) (w:beforehand/in advance/already) (d:<kholh>, beforehand, with <sa>: follows a verb and marks the action as already done ahead of time) (s:kholsa) (b:kholh) (q:draft)
kholhsak = (i:1) (t:adv) (w:beforehand for/in advance for) (d:<kholh> beforehand with <sak> for someone, after a verb: {koih kholhsak} is lay up or reserve for someone ahead of time) (b:kholh) (q:draft)
kholhsakna = (i:1) (t:n) (w:preparing beforehand/provision made in advance) (d:<kholhsak>, beforehand for someone, with the noun suffix <na>: {a bawl kholhsakna mun} is the place made ready in advance for her) (b:kholhsak) (q:draft)
kholhte = (i:1) (t:n) (w:things said beforehand/predictions) (d:<kholh>, beforehand, with the plural <te>, after a verb: {thugen kholhte} is the words spoken beforehand, predictions) (b:kholh) (q:draft)
kholin = (i:1) (t:adv) (w:beforehand/in advance) (d:<khol>, beforehand, with the linking suffix <in>: follows a verb whose action is done ahead of time, before a further action) (q:draft)
kholin = (i:2) (t:v) (w:store up/store) (d:<khol>, store, with the linking suffix <in>, before a further action) (b:khol) (q:draft)
khollo = (i:1) (t:adv) (w:not much/not very/hardly) (d:follows a verb or a describing word: not particularly, not to any great degree) (q:draft)
kholloh = (i:1) (t:adv) (w:not much/not very/hardly) (d:form of <khollo> used before <hangin>, <bang> and <te>) (b:khollo) (r:46.12.24) (q:draft)
khollohte = (i:1) (t:n) (d:<kholloh>, not much, with plural <te>, after a verb: the ones that are not much so; {thupi i sak khollohte}, the parts we do not think very important) (b:kholloh) (q:draft)
khollote = (i:1) (t:n) (w:those who hardly/those who do not much) (d:<khollo> not much with plural <te>: {a paupau khollote} is those who do not talk much) (b:khollo) (q:draft)
kholna = (i:1) (t:n) (w:storehouse/treasury/store) (d:<khol>, store, with the noun suffix <na>: the storing of something or the place where it is stored; {sum kholna} is a treasury or treasure) (s:sumkholna/vankoihna) (b:khol) (q:draft)
kholnapi = (i:1) (t:n) (w:great heap/heap) (d:<kholna> storing place with <pi> great: {nin kholnapi} is a great rubbish heap, where the NIV has heap of ruins) (b:kholna) (q:draft, low confidence)
kholpa = (i:1) (t:n) (w:one who does beforehand) (d:<khol>, beforehand, with <pa>, the man who, after a verb: {thu pia kholpa}, he who warns, {a om kholpa}, he who stands ready) (q:draft, low confidence)
kholsa = (i:1) (t:n) (w:stores/treasure/what is stored up) (d:<khol>, store, with <sa>, already done: things that have been laid up, stores or treasure) (b:khol) (q:draft)
kholsa = (i:2) (t:adv) (w:beforehand/in advance/already) (d:follows a verb: done or made ready ahead of time, as {kigelh kholsa} written beforehand and {kiseh kholsa} determined beforehand; {kholsa-a om} is be prepared) (s:kholhsa) (q:draft)
kholsak = (i:1) (t:adv) (w:beforehand/in advance) (d:<khol>, beforehand, with <sak>, for someone, after a verb: {hilh kholsak} is warn someone beforehand) (q:draft)
kholsate = (i:1) (t:n) (w:stores/things stored up) (d:<kholsa>, what is stored up, with the plural <te>) (s:kholte) (b:kholsa) (q:draft)
kholte = (i:1) (t:n) (w:things stored up/stores) (d:<khol> store with the plural <te>: the things that have been stored) (s:kholsate) (b:khol) (q:draft)
kholte = (i:2) (t:n) (w:those who store/those who gather in) (d:<khol> store with the plural <te>: the people who have gathered and stored the crop) (b:khol) (q:draft)
kholteng = (i:1) (t:n) (w:all that is stored up) (d:<khol>, store, with <teng>, all: the whole of what one has laid up) (b:khol) (q:draft)
kholzaw = (i:1) (t:v) (w:store up instead/store up) (d:<khol>, store, with <zaw>, rather: store up there instead) (b:khol) (q:draft)
kholzo = (i:1) (t:v) (w:manage to store/store up) (d:<khol>, store, with <zo>, be able: succeed in storing up) (b:khol) (q:draft)
khom = (i:1) (t:v) (w:last/be enough for) (d:of food or goods, be enough to last through a length of time) (q:draft)
Khomun = (i:1) (t:n) (w:bread) (d:<khomun> written with a capital at the start of a sentence or in the name {Silngo om lo Khomun}, the Unleavened Bread of the festival) (b:khomun) (r:40.16.12) (q:draft)
khomunte = (i:1) (t:n) (w:loaves/bread) (d:<khomun>, loaf, with the plural <te>; here the consecrated bread set before God) (s:anlumte) (b:khomun) (q:draft)
khon = (i:1) (t:v) (w:collect/levy) (d:collect money or a tax from people) (q:draft)
khong = (i:1) (t:n) (w:sorcery/soothsaying) (d:used with <khai>: {khong khai} means practise sorcery or soothsaying, and {khong khaite} are those who do so) (s:khongkhai) (q:draft, low confidence)
khong = (i:2) (t:adv) (w:just/merely) (d:after a verb: merely staying in that state without doing anything more, as in {bu khong}, stay hidden, and {en khong}, only look on) (q:draft, low confidence)
khongin = (i:1) (t:adv) (w:free of charge/for free/without paying) (d:always in {a khongin}: as a free gift, without payment or wages) (q:draft)
khongkhai = (i:1) (t:n) (w:astrology/sorcery/enchantment) (d:occult art; {khongkhai siamte} and {khongkhai theite}, those skilled in it, stand for the astrologers and enchanters of Babylon and Egypt) (s:khong) (r:27.2.10) (q:draft, low confidence, exact kind of art not clear from the verses)
khongkhaina = (i:1) (t:n) (w:witchcraft/sorcery) (d:<khongkhai> with the noun suffix <na>: the practice of the occult art) (s:bumna) (b:khongkhai) (q:draft)
khongkhaite = (i:1) (t:n) (w:sorcerers/soothsayers) (d:<khongkhai>, sorcery or soothsaying, with plural <te>: those who practise it, named beside <aisante>, diviners) (s:khongkhaitheite) (b:khongkhai) (q:draft)
khongkhaithei = (i:1) (t:n) (w:astrologer/enchanter/soothsayer) (d:<khongkhai>, occult art, with <thei>, know: one who knows that art) (b:khongkhai) (q:draft, low confidence, exact kind of art not clear from the verse)
khongkhaitheite = (i:1) (t:n) (w:astrologers/enchanters/soothsayers) (d:<khongkhaithei>, one who knows the occult art, with the plural <te>) (s:khongkhaite) (b:khongkhaithei) (q:draft, low confidence, exact kind of art not clear from the verse)
khongkhakah = (i:1) (t:n) (w:at the doorway/at the door) (d:door or doorway with the place marker <ah>; the same verse writes <kongkhak> for door) (s:kongkhakah) (q:draft, low confidence, perhaps a spelling of <kongkhak>)
khop = (i:1) (t:adv) (w:together/along with) (d:placed after a verb, the action is done together with someone; form of <khawm> used before words such as <ding>, <sangin> and <man>) (s:khawm) (a:tuamin) (q:draft)
khop = (i:2) (t:adv) (w:enough/sufficiently) (d:placed after a describing word or a verb: to a sufficient degree; {sauvei khop} is long enough and {kham khop} is enough to satisfy) (q:draft)
khop = (i:3) (t:v) (w:collect/gather) (d:bring together or gather in people, money or a harvest; the form of <khawm> used before words such as <uh>, <ding> and <nading>) (s:kaikhawm/khon) (q:draft, low confidence)
khopa = (i:1) (t:ppm) (d:postpositional marker to indicate objective case)
khopa = (i:2) (t:part) (d:particle suffixed to a noun to form verb past tense)
khopkhat = (i:1) (t:adv) (w:somewhat/to some extent/a fair way) (d:placed after a describing word: to some degree, a certain amount; {a gamla khopkhat}, some distance away) (s:deuh) (q:draft)
khopna = (i:1) (t:n) (w:being together/union) (d:<khop>, together, with {-na}, placed after a verb: the doing of it together, as {kipawl khopna}, an alliance, and {lup khopna}, lying together as man and wife) (b:khop) (q:draft)
khopna = (i:2) (t:n) (w:gathering/collecting) (d:<khop>, gather, with {-na}: the gathering in of a harvest) (s:kaihkhopna) (b:khop) (q:draft, low confidence)
khoppih = (i:1) (t:adv) (w:together with) (d:placed after a verb, the action is done together with someone or something: {lup khoppih} lie with, sleep with; {meek khoppih} mix with) (s:khawmpih) (b:khop) (q:draft)
khopsak = (i:1) (t:v) (w:gather/assemble/bring together) (d:<khop>, gather, with the causative <sak>: cause people to come together) (s:kaikhawm/khawmsak) (a:thehthang) (b:khop) (q:draft)
khopsakin = (i:1) (t:v) (w:gathering/assembling) (d:<khopsak>, gather, with the linking suffix <in>, before a further command) (s:kaikhawmin) (b:khopsak) (q:draft)
khopte = (i:1) (t:n) (w:those gathered/those assembled) (d:<khop>, gather, with the plural <te>: the ones whom someone has gathered together) (b:khop) (q:draft)
khopzah = (i:1) (t:n) (w:as much as/enough for) (d:<khop>, enough, with <zah>, amount: {khe a ta khopzah} is as much ground as a foot can stand on) (q:draft, low confidence)
Khorazin = (i:1) (t:name) (c:city) (w:Chorazin) (d:town in Galilee near Capernaum that Jesus rebuked for not repenting) (r:42.10.13/40.11.21)
khosak = (i:1) (t:v) (w:let farm/lease out) (d:<kho>, farm, with the causative <sak>: have someone else work a field or vineyard) (b:kho) (q:draft)
khosak = (i:2) (t:v) (w:urge/press/warn) (d:press someone strongly to do or not to do a thing) (s:khoh) (q:draft, low confidence)
khotakin = (i:1) (t:adv) (w:firmly/fast/steadfastly) (d:<kho>, firm, with <takin>, which makes an adverb: firmly; often with <len>, hold) (s:kiptakin/khauhtakin) (b:kho) (q:draft)
khote = (i:1) (t:n) (w:farmers/tillers/plowmen) (d:<kho>, farm, with the plural <te>: those who work the land, in {lo khote}, farmers or tenants) (s:lokhote) (b:kho) (q:draft)
khotte = (i:1) (t:n) (w:proceeds/money collected) (d:in {sum khotte}, the money got in, here from selling possessions; <khot> seems to be the form of <khon>, collect, used before <te>) (s:sumkhotte) (q:draft, low confidence)
khozo = (i:1) (t:v) (w:restrain/hold back/withstand) (d:manage to check or hold back someone, by urging or by force; <kho>, urge or restrain, with <zo>, be able) (s:khamzo) (q:draft, low confidence)
Khrih = (i:1) (t:name) (w:Christ) (d:Christ, the Messiah, title of Jesus as the one anointed by God; the spelling used beside <Khazih>) (r:46.1.6/44.8.5)
khrisolait = (i:1) (t:n) (c:stone) (w:chrysolite) (d:a precious stone, the seventh foundation stone of the new Jerusalem, counted among the <suangmanpha>, precious stones) (s:khrysolite) (q:draft)
khrisoprase = (i:1) (t:n) (c:stone) (w:chrysolite/chrysoprase/turquoise) (d:precious stone, the tenth foundation stone of the new Jerusalem; chrysoprase, where the NIV has turquoise)
Khristian = (i:1) (t:name) (w:Christian) (d:a follower of Christ, the name first given to the disciples at Antioch; also describes a thing as Christian, as in {Khristian mipih}, fellow Christian) (r:62.2.9/64.1.5)
Khristianpihte = (i:1) (t:n) (w:fellow Christians/brothers and sisters) (d:<Khristian> with <pih> fellow and <te> plural: those who are Christians together with one; stands where the NIV has brothers and sisters) (q:draft)
Khristiante = (i:1) (t:name) (c:people) (w:Christians) (d:<Khristian> with the plural <te>: Christians, believers in Christ; often stands where the English has brothers and sisters or in the Lord) (b:Khristian) (r:64.1.8) (q:draft)
khrysolite = (i:1) (t:n) (c:stone) (w:chrysolite) (d:precious stone, first of the fourth row on the breastpiece, where the NIV has topaz) (s:khrisolait) (q:draft)
khu = (i:1) (t:n) (w:smoke) (d:smoke rising from a fire or from incense; more often in the compound <meikhu>) (s:meikhu) (q:draft)
khu = (i:2) (t:v) (w:smoke/smolder) (d:give off smoke, smolder; said twice, {khu khu}, for smoldering on and on) (q:draft)
khua = (i:1) (t:ppm) (d:word indicating a particular mood of light or dark)
Khua = (i:1) (t:n) (w:town/city/village) (d:<khua> written with a capital, in a title or at the start of a sentence; {Shiloh Khua Mi} is the man of the town of Shiloh, the Shilonite) (b:khua) (q:draft)
khua niim = (i:1) (t:n) (w:gloom/overcast) (d:dull, overcast weather, when the sky is dark with cloud)
khua-ul = (i:1) (t:n) (w:sweat/perspiration) (d:the moisture that comes out of the skin in heat or hard work; {khua-ul kai} is to sweat) (q:draft)
Khuabul = (i:1) (t:name) (c:place) (w:Khuabul/Foundation) (d:the Foundation Gate in Jerusalem, {Khuabul Kulh kongpi}, where a third of the guards were posted when Joash was made king) (r:14.23.5)
khuacing = (i:1) (t:n) (w:guard/town guard/watchman) (d:<khua>, town, with <cing>, guard: one who keeps watch over a town or a post; {khuacing mite} are the men of an outpost) (s:galvil) (q:draft)
khuacingin = (i:1) (t:v) (w:guarding/keeping guard/defending) (d:<khuacing>, guard a town, with the linking ending <in>: keeping guard over a town, defending it) (b:khuacing) (q:draft)
khuacingte = (i:1) (t:n) (w:garrison/outpost/watchmen/guards) (d:plural of <khuacing>, those who guard a town; a body of soldiers stationed in a place) (s:galvilte/cingte) (b:khuacing) (q:draft)
khuadak = (i:1) (t:v) (w:look/look up/look around) (d:<khua>, the surroundings, with <dak>, look: raise the eyes and look around; {khuadak to} is look up and {khuadak kawikawi} is look all around) (s:dak/en) (q:draft)
khuadakdak = (i:1) (t:v) (w:keep looking/look and look) (d:<khuadak>, look, with <dak> repeated for an action that goes on: keep looking) (s:etet/enen) (q:draft)
khuadakin = (i:1) (t:v) (w:looking/looking up/looking around) (d:<khuadak>, look, with <in>, the linking form before a following verb: looking up or around and then doing something) (s:dakin/enin) (b:khuadak) (q:draft)
khuadakna = (i:1) (t:n) (w:watch/lookout/looking out) (d:<khuadak>, look around, with the noun ending <na>: keeping a lookout; {khuadakna tausang} is a watchtower) (s:galvilna) (b:khuadak) (q:draft)
khuadaksuk = (i:1) (t:v) (w:look down) (d:<khuadak>, look, with <suk>, downward: look down from a higher place) (s:ensuk/etsuk) (a:khuadakto) (b:khuadak) (q:draft)
khuadakto = (i:1) (t:v) (w:look up/lift the eyes) (d:<khuadak>, look around, with <to>, up) (s:dakto/ento/khuadaktoh) (a:khuadaksuk) (b:khuadak) (q:draft)
khuadaktoh = (i:1) (t:v) (w:look up) (d:<khuadak>, look, with <toh>, upward: the form of <khuadakto> used before <leh>) (s:ettoh/khuadakto) (a:khuadaksuk) (b:khuadakto) (q:draft)
khuadakzo = (i:1) (t:v) (w:be able to look) (d:<khuadak> look with <zo> be able; with {nawn lo}, no longer able to look) (b:khuadak) (q:draft)
khuadam = (i:1) (t:n) (w:cold/cold weather) (d:<khua>, the weather, with <dam>, cold: cold weather or the feeling of cold) (s:votna) (q:draft)
khuadampi = (i:1) (t:n) (w:great cold/bitter cold) (d:<khuadam>, cold, with <pi>, great: severe cold) (b:khuadam) (q:draft)
khuadang = (i:1) (t:n) (w:another town/other town) (d:<khua> town with <dang> other) (q:draft)
khuadangte = (t:see) <khuadangte-ah>
khuadangte-ah = (i:1) (t:n) (w:to the other towns/in the other villages) (d:<khuadang> other town with plural <te> and the place marker <ah>) (q:draft)
khuadon = (i:1) (t:v) (w:expect/watch/be on the lookout) (d:in the verse with <lo>: {khuadon lo} is not expecting, not watching) (q:draft, low confidence)
khuadum = (i:1) (t:n) (w:blue yarn/blue material) (d:the material of which the loops of the tabernacle curtains were made) (q:draft, low confidence, perhaps a misprint for {khau dum}, blue thread)
khuagei = (i:1) (t:n) (w:vicinity/outskirts/edge of town) (d:<khua>, town, with <gei>, edge or side: the area at the edge of a town) (s:khuanawl/khuakiim) (q:draft)
khuahek = (i:1) (t:n) (w:conduct/manner/behaviour) (d:paired with <gamtat>, way of living) (q:draft, low confidence, meaning taken from the pairing with <gamtat>)
khuahsak = (i:1) (t:v) (w:harden/strengthen) (d:make hard or strong: {lungsim khuahsak}, harden the heart, {tha khuahsak}, strengthen; the same in meaning as <khauhsak>) (s:khauhsak) (q:draft)
khuahun = (i:1) (t:n) (w:state/condition)
khuahun = (i:2) (t:n) (w:climate)
khuahun = (i:3) (t:n) (w:weather) (d:the state of the weather at a given time; {khuahun hoih} is good weather)
khuahunte = (i:1) (t:n) (w:seasons/times) (d:plural of <khuahun>: the seasons of the year, in {hun leh khuahunte}, times and seasons) (s:hunte) (b:khuahun) (q:draft)
khuai = (i:1) (t:n) (c:animal) (w:bee) (d:the honey bee; {khuai hon} is a swarm of bees and <khuaizu> is honey) (s:khuaipi) (q:draft)
khuaibu = (i:1) (t:n) (w:honeycomb/bees' nest) (d:<khuai>, bee, with <bu>, nest: the comb in which bees store honey) (s:khuailuzu) (q:draft)
khuailuzu = (i:1) (t:n) (w:honeycomb/honey from the comb) (d:honey still in the comb, named beside <khuaizu>, honey, as the sweetest of foods) (s:khuaibu/khuaipizu) (q:draft)
khuaimeivak = (i:1) (t:n) (w:candle/lamp) (d:<khuai> bee, wax, with <meivak> lamp: {khuaimeivak vakna khuam} is a lampstand) (q:draft, low confidence)
khuainun = (i:1) (t:n) (w:wax/beeswax) (d:the wax made by bees, which melts before the fire) (q:draft)
khuaipi = (i:1) (t:n) (c:animal) (w:bee) (d:a swarming, stinging bee; {khuaipi nam tunpi} is used for the hornet) (s:khuai) (b:khuai) (q:draft)
khuaipizu = (i:1) (t:n) (w:honey/honeycomb) (d:<khuaipi>, bee, with <zu>, liquid: honey, the honeycomb of the NIV) (s:khuaizu/khuailuzu) (q:draft)
khuaisuahna = (i:1) (t:n) (w:loss/bereavement) (d:the losing of a child by death, in {ta khuaisuahna}, loss of children) (q:draft)
khuaisuahte = (i:1) (t:n) (w:those bereaved/those who have lost) (d:{khuaisuah}, lose a child by death, with <te>: people who have lost a child) (q:draft)
khuaizu = (i:1) (t:n) (w:honey) (d:<khuai>, bee, with <zu>, liquid: honey; the promised land is described as flowing with {bawngnawi leh khuaizu}, milk and honey) (s:khuaipizu) (q:draft)
khuak = (i:1) (t:v) (w:hew/chisel/carve/cut out) (d:cut into rock or a hard surface, as a tomb in rock; {khuak-in at} is to engrave) (q:draft)
khuakehte = (i:1) (t:n) (w:hamlets/countryside/farms) (d:named after <khuapi> city and <khuaneu> village as the smallest kind of settlement) (q:draft, low confidence)
khuakhua = (t:see) <khuakhua-in>
khuakhua-in = (i:1) (t:adv) (w:town by town) (d:<khua> town repeated, with <in>) (q:draft)
khuakiim = (i:1) (t:n) (w:vicinity/surrounding area) (d:<khua> town with <kiim> around: the country round a town) (s:kiimnai/khuagei) (q:draft)
khuakin = (i:1) (t:v) (w:engraving/carving) (d:<khuak> carve with linking <in>: {khuakin ki-at} is be engraved) (b:khuak) (q:draft)
khuakongpi = (i:1) (t:n) (w:city gate/gate) (d:<khua>, town, with <kongpi>, main gate: the gate of a walled town) (s:kulhkongpi/kongpi) (q:draft)
khuakongpite = (i:1) (t:n) (w:city gates/gates) (d:plural of <khuakongpi>: the gates of a walled town) (s:kulhkongpite/kongpite) (b:khuakongpi) (q:draft)
khuakulh = (i:1) (t:n) (w:city wall/wall) (d:<khua>, town, with <kulh>, wall: the wall built round a town for its defence) (s:kulh/khuakulhpi/khuapikulh) (r:10.22.30) (q:draft)
khuakulhah = (i:1) (t:n) (w:on the city wall/at the wall) (d:<khuakulh> city wall with the place marker <ah>) (b:khuakulh) (q:draft)
khuakulhpi = (i:1) (t:n) (w:city wall) (d:<khuakulh>, city wall, with <pi>, great: the great wall round a town) (s:kulhpi/khuapikulh/khuakulh) (b:khuakulh) (q:draft)
khual = (i:1) (t:v) (w:journey) (d:away from home, on a journey: used with <zin>, travel, as in {khual gamlapi-ah zin}, go on a long journey) (s:zin)
khualkhal = (i:1) (t:n) (w:summer) (d:the dry season: {khualkhal hun} is summertime; written <khuakhal> elsewhere) (s:khuakhal) (a:phalbi) (q:draft, perhaps a misprint for <khuakhal>)
khualmi = (i:1) (t:n) (w:stranger/foreigner/sojourner) (d:<khual>, away from home, with <mi>, person: someone living in a place that is not his own) (s:peemta/mikhual/gamdangmi/khualmipa) (b:khual) (r:4.15.26) (q:draft)
khualmipa = (i:1) (t:n) (w:foreigner/sojourner/stranger) (d:<khualmi>, foreigner, with <pa>, which marks a man: a foreigner living among the people) (s:khualpa/khualmi) (b:khualmi) (q:draft)
khualmite = (i:1) (t:n) (w:strangers/foreigners/sojourners) (d:plural of <khualmi>: people from elsewhere who live among another people) (s:peemtate/mikhualte/khualte) (b:khualmi) (r:4.35.15/3.25.45) (q:draft)
khualna = (i:1) (t:n) (w:concern/regard/consideration/sake) (d:<khual>, have regard for, with the noun suffix <na>: care or regard for someone; {ka khualna-in} means for the sake of) (s:thukhualna/kikhualna) (r:19.122.8) (q:draft)
khualpa = (i:1) (t:n) (w:foreigner/stranger/sojourner) (d:<khual>, away from home, with <pa>, which marks a man: a man from elsewhere living among the people) (s:khualmipa/khualmi) (b:khual) (q:draft)
khualte = (i:1) (t:n) (w:strangers/foreigners/sojourners) (d:<khual> with the plural <te>; in {mi khualte}, people from elsewhere who live among another people) (s:khualmite/peemtate) (b:khual) (q:draft)
khualte = (i:2) (t:n) (w:those who have regard for/those who consider) (d:<khual>, have regard or concern for, with <te>, those who) (b:khual) (q:draft)
khualum = (i:1) (t:v) (w:be warm/keep warm) (d:<khua>, the weather or surroundings, with <lum> warm: feel warm) (q:draft)
khualutna = (i:1) (t:n) (w:town entrance/entrance to the town) (d:<khua> town with <lutna> entering: {Hamath khualutna} is the entrance of Hamath, the NIV Lebo Hamath) (q:draft)
khualzin = (i:1) (t:v) (w:travel) (d:<khual>, away from home, with <zin>, travel: go on a journey) (s:zin/lampai)
khualzin = (i:2) (t:v) (w:tour)
khualzin = (i:3) (t:v) (w:trip)
Khualzin = (i:1) (t:v) (w:travel) (d:<khualzin> written with a capital at the start of a sentence or in a place name, as {Khualzin Mite’ Kuam}, the valley of the travellers) (b:khualzin) (q:draft)
khualzinin = (i:1) (t:v) (w:travelling/on a journey) (d:<khualzin>, travel, with <in> joining it to the next verb: while travelling, on a journey) (s:zinin) (b:khualzin) (q:draft)
khualzinna = (i:1) (t:n) (w:journey/travel) (d:<khualzin>, travel, with the noun suffix <na>: a journey) (s:zinna/lampaina) (b:khualzin) (r:1.24.21) (q:draft)
khualzinpa = (i:1) (t:n) (w:traveler/wayfarer) (d:<khualzin> travel with <pa>, a man: a man on a journey) (b:khualzin) (q:draft)
khualzinpihte = (i:1) (t:n) (w:traveling companions/fellow travelers) (d:<khualzin> travel with <pih>, together with, and plural <te>) (q:draft)
khualzinte = (i:1) (t:n) (w:travelers/wayfarers/strangers) (d:<khualzin>, travel, with plural {-te}: people on a journey) (b:khualzin) (q:draft)
khualzinzin = (i:1) (t:v) (w:travel) (d:<khualzin> with the last part doubled: travel about, keep travelling) (b:khualzin)
Khualzinzin = (i:1) (t:v) (w:travel) (d:<khualzinzin> written with a capital at the start of a sentence; <khualzin> with the last part doubled, travel about) (b:khualzinzin) (q:draft)
khuam = (i:1) (t:n) (w:pillar/post/pole) (d:an upright post or pillar: a house post, a doorpost, a pole, or a stone set up as a memorial) (s:khuampi/innkhuam) (q:draft)
khuami = (i:1) (t:n) (w:townsman/inhabitant/citizen) (d:<khua>, town, with <mi>, person: a person of a town or village; after a place name it means a person from that place) (b:khua) (q:draft)
KHUAMI = (i:1) (t:n) (w:townsman/person of) (d:<khuami> written in capitals in the inscription on the cross; after a place name, a person from that town) (q:draft)
khuamial = (i:1) (t:n) (w:dark) (d:the state of being without light; {khuamial ding} is it will be dark) (s:khim) (a:khuavak) (r:1.1.4)
khuamial = (i:2) (t:n) (w:darkness) (d:<khua>, the surroundings, with <mial>, dark: darkness, the absence of light) (s:khuamialna/mialna/khim) (a:khuavak) (r:1.1.4)
khuamialna = (i:1) (t:n) (w:darkness) (d:<khuamial>, dark, with the noun suffix <na>: darkness, also as a picture of trouble and of not seeing) (s:khuamial/mialna) (a:khuavakna) (b:khuamial)
khuamialpi = (i:1) (t:n) (w:deep darkness/thick darkness) (d:<khuamial>, darkness, with <pi>, great: deep darkness) (s:khuazing) (b:khuamial) (q:draft)
khuamin = (i:1) (t:adv) (w:as a pillar) (d:<khuam> pillar with the marker <in>: set up as a pillar) (b:khuam) (q:draft)
khuamin = (i:2) (t:n) (w:name of the town) (d:<khua> town and <min> name written as one word) (q:draft)
