tulakte = (i:1) (t:n) (w:forests) (d:<tulak>, forest, with the plural <te>) (b:tulak) (q:draft)
tuleta = (i:1) (t:n) (w:children and grandchildren/descendants) (d:<tu>, grandchild, <le>, and, <ta>, child, written as one word: children and grandchildren, the descendants a person has) (s:suanlekhak) (q:draft)
tuletate = (i:1) (t:n) (w:offspring/descendants/children and grandchildren) (d:<tuleta>, children and grandchildren, with the plural <te>: the offspring or descendants of a person) (s:suanlekhakte/suante/khakte) (a:pulepate) (b:tuleta) (q:draft)
tulgiat = (i:1) (t:num) (w:eight thousand) (d:<tul>, thousand, with <giat>, eight; {tulsawm leh tulgiat} is eighteen thousand) (r:4.4.48) (q:draft)
tulguk = (i:1) (t:num) (w:six thousand) (d:<tul>, thousand, with <guk>, six; joined to other numbers with <leh>, as {tul sawmnih leh tulguk}, twenty-six thousand) (q:draft)
tulh = (i:1) (t:v) (w:give to drink/feed) (d:give someone something to drink, as milk to an infant or wine to a guest) (s:dawnsak) (q:draft)
tulin = (i:1) (t:adv) (w:by thousands/in thousands) (d:<tul>, thousand, with the ending <in>: {a tulin} is by the thousand, in thousands, and {a tul tulin} thousand upon thousand) (s:tultulin) (b:tul) (q:draft)
tulkhat = (i:1) (t:num) (w:one thousand/a thousand) (d:<tul>, thousand, with <khat>, one; it follows the thing counted, as {kum tulkhat}, a thousand years) (r:15.2.37) (q:draft)
tulkhatte = (i:1) (t:num) (w:a thousand) (d:<tulkhat>, one thousand, with the plural <te>: a group of a thousand men, the thousand of them) (b:tulkhat) (q:draft)
tulkua = (i:1) (t:num) (w:nine thousand) (d:<tul>, thousand, with <kua>, nine) (r:4.1.23) (q:draft)
tulli = (i:1) (t:num) (w:four thousand) (d:<tul>, thousand, with <li>, four; {tul sawmnih leh tulli} is twenty-four thousand) (q:draft)
tullite = (t:see) <thenli-tullite>
tulnga = (i:1) (t:num) (w:five thousand) (d:<tul>, thousand, with <nga>, five) (q:draft)
tulnih = (i:1) (t:num) (w:two thousand) (d:<tul>, thousand, with <nih>, two; it follows the higher number with <leh>, as in {tulsawm leh tulnih}, twelve thousand) (q:draft)
tulnihte = (i:1) (t:num) (w:two thousand) (d:<tulnih>, two thousand, with the plural <te>: a group of two thousand men, the two thousand of them) (b:tulnih) (q:draft)
tulpih = (t:todo) (q:draft, only in {nang zong hong tulpih lo ding numei paktat}, Hosea 1:2, perhaps be faithful to or stay with; meaning not clear from the verse)
tulsagih = (i:1) (t:num) (w:seven thousand) (d:<tul>, thousand, with <sagih>, seven) (q:draft)
tulsawm = (i:1) (t:num) (w:ten thousand) (d:<tul>, thousand, with <sawm>, ten; {tulsawm leh tulnih} is twelve thousand) (s:then/thenkhat) (q:draft)
tulsawmgiat = (i:1) (t:num) (w:eighty thousand) (d:<tul>, thousand, with <sawmgiat>, eighty; {tulza leh tulsawmgiat leh tulnga} is 185,000) (q:draft)
tulsawmguk = (i:1) (t:num) (w:sixty thousand) (d:<tul>, thousand, with <sawmguk>, sixty; {tulsawmguk leh tulkhat} is sixty-one thousand) (q:draft)
tulsawmin = (i:1) (t:adv) (w:by tens of thousands) (d:<tulsawm>, ten thousand, with the ending <in>: by tens of thousands; {a tulsawmin} that is killed his tens of thousands) (s:thenin/thenthenin) (b:tulsawm) (q:draft)
tulsawmli = (i:1) (t:num) (w:forty thousand) (d:<tul>, thousand, with <sawmli>, forty) (s:thenli) (q:draft)
tulsawmnih = (i:1) (t:num) (w:twenty thousand) (d:<tul>, thousand, with <sawmnih>, twenty) (s:thennih) (q:draft)
tulsawmthum = (i:1) (t:num) (w:thirty thousand) (d:<tul>, thousand, with <sawmthum>, thirty) (q:draft)
tulthum = (i:1) (t:num) (w:three thousand) (d:<tul>, thousand, with <thum>, three) (q:draft)
tultul = (i:1) (t:num) (w:thousands/by thousands) (d:<tul>, thousand, said twice: thousand by thousand, thousands; {a tultul a ukte} are commanders of thousands) (q:draft)
tultulin = (i:1) (t:adv) (w:by thousands) (d:<tultul>, thousands, with the ending <in>: in groups of a thousand; {a zaza a tultulin} is by hundreds and by thousands) (s:tulin) (b:tultul) (q:draft)
tulum = (i:1) (t:v) (w:bite to death/kill by biting) (d:<tu>, bite or strike, said of a snake, with <lum>, dead: kill by biting) (s:petlum) (q:draft)
tulza = (i:1) (t:num) (w:hundred thousand) (d:<tul>, thousand, with <za>, hundred: one hundred thousand; further numbers follow with <leh>, as {tulza leh tulgiat}, 108,000) (q:draft)
tulzagiat = (i:1) (t:num) (w:eight hundred thousand) (d:<tul>, thousand, with <zagiat>, eight hundred) (q:draft)
tulzanga = (i:1) (t:num) (w:five hundred thousand) (d:<tul>, thousand, with <zanga>, five hundred) (q:draft)
tulzanih = (i:1) (t:num) (w:two hundred thousand) (d:<tul>, thousand, with <zanih>, two hundred) (q:draft)
tulzum = (i:1) (t:n) (w:spade/digging tool) (d:a small tool for digging the ground, carried along with a soldier’s weapons) (q:draft)
tuma = (i:1) (t:adv) (w:ago/before/formerly/previously) (d:before now; <tuma kum> is years ago, {tuma lamin} some time ago, and {tuma-in} earlier, set against <tu-in>, now) (s:nidang/tumasiah) (q:draft)
tumahin = (i:1) (t:adv) (w:just now/right now/even now) (d:<tu>, now, with the emphatic <mah> and the ending <in>: at this very time) (s:tuhunin) (q:draft)
tumakuakte = (i:1) (t:n) (w:furrows) (d:the furrows cut in a field by a hoe or plough, with the plural <te>; also written {tu-ma-kuakte}) (q:draft, low confidence)
tumasiah = (i:1) (t:adv) (w:before/formerly/in the past) (d:<tuma> before now with <siah>: in the time up to now; {tumasiah-a bangin} is as before) (s:nidang/tuma) (q:draft)
tumbang = (i:1) (t:n) (w:stub/firebrand) (d:in {sing tumbang}, the burnt end of a piece of firewood) (q:draft, low confidence)
tumcip = (i:1) (t:v) (w:engulf/submerge/drown) (d:of water, close over someone completely; also sink someone in the sea; <tum> with <cip>, tightly or completely) (s:tuumcip/phumcip/tummang) (q:draft)
tumdang = (i:1) (t:adj) (w:strange/unusual/extraordinary) (d:different from the ordinary; paired with <lamdang>, strange, wonderful) (s:tuampian) (q:draft)
tumgawp = (i:1) (t:v) (w:pound/beat hard) (d:<tum> beat, with <gawp> violently) (b:tum) (q:draft)
tumin = (i:1) (t:v) (w:blowing/sounding/playing) (d:<tum> blow a trumpet or play an instrument, with the linking suffix <in>) (s:mutin) (b:tum) (q:draft)
tumin = (i:2) (t:v) (w:entering/going in) (d:<tum> enter or go down into, with the linking suffix <in>) (s:lutin/sungtumin) (a:pusuakin) (b:tum) (r:4.5.24) (q:draft)
tumkhawm = (i:1) (t:v) (w:enter together/go in together) (d:<tum>, enter, with <khawm>, together: go or come in together) (s:lutkhawm) (q:draft)
tumkhit = (i:1) (t:v) (w:have gone in/have entered) (d:<tum> go in with <khit>, finished: {innsungah a tumkhit ciangin} is after he had gone into the house) (s:lutkhit) (q:draft)
tumkhit = (i:2) (t:v) (w:have set) (d:of the sun, <tum> go down with <khit>, finished: {ni a tumkhit ciangin} is after sunset) (q:draft)
tumkik = (i:1) (t:v) (w:set again/go down again) (d:of the sun or moon) (q:draft)
tumkik = (i:2) (t:v) (w:enter again/come back in) (d:<tum>, enter, with <kik>, again: of an enemy coming into a land again) (q:draft)
Tumkung = (i:1) (t:n) (c:plant) (w:palm tree/palm) (d:a palm tree, with <kung>, tree; written with a capital at the start of a sentence) (s:nisuhkung) (q:draft)
tummang = (i:1) (t:v) (w:drown/engulf/sweep away/overwhelm) (d:of water, cover people so that they are lost; also be drowned, and of sorrow, overwhelm; <tum> with <mang>, out of sight) (s:tuummang/tumcip) (q:draft)
tumna = (i:1) (t:n) (w:setting/west) (d:the going down of the sun; {ni tumna lam} is the west side) (s:nitumna) (a:suahna/nisuahna) (b:tum) (r:5.34.2) (q:draft)
tumna = (i:2) (t:n) (w:entering/entrance/entry) (d:going in, as into a land, or the place of going in, as {kongpi tumna} the entrance of a gate) (s:lutna/sungtumna) (a:pusuahna) (b:tum) (r:6.20.4) (q:draft)
tumna = (i:3) (t:n) (w:blowing/blast) (d:<tum>, blow, with the noun suffix <na>: the sounding of a trumpet or horn) (s:mutna/kitumna) (b:tum) (q:draft)
tumpa = (i:1) (t:n) (w:striker/the one who struck) (d:<tum> strike with the fist, with <pa> marking a man: the man who struck the blow) (s:satpa) (q:draft)
tumpa = (i:2) (t:n) (w:trumpeter/player) (d:<tum> play or sound an instrument, with <pa> marking a man: {peengkul tumpa} is the man who sounds the trumpet) (b:tum) (q:draft)
tumpah = (i:1) (t:v) (w:enter at once/go in) (d:<tum> enter, with <pah> at once) (s:lutpah) (q:draft)
tumpih = (i:1) (t:v) (w:bring in/take in/lead in) (d:go in together with someone or something; <tum> enter with <pih>) (s:lutpih/lutsak) (b:tum) (q:draft)
tumpihin = (i:1) (t:v) (w:bringing in/taking in) (d:<tum>, enter, with <pih>, together with, and the linking ending <in>: go in taking someone or something along) (b:tumpih) (q:draft)
tumpihpa = (i:1) (t:n) (w:one who brings in/one who leads in) (d:<tumpih> bring in, with <pa>, the man who does it) (s:tumsakpa) (b:tumpih) (q:draft)
tumpihzaw = (i:1) (t:v) (w:lead into instead/bring in rather) (d:<tumpih> bring in, with <zaw> more, rather) (b:tumpih) (q:draft, low confidence)
tumsa = (i:1) (t:adj) (w:gone down/set) (d:<tum> go down, of the sun, with <sa> already done; of the shadow that had already moved down the steps) (q:draft, low confidence)
tumsa = (i:2) (t:adj) (w:burned up/consumed) (d:after <khul> throw into the fire: already thrown in and consumed) (q:draft, low confidence)
tumsak = (i:1) (t:v) (w:bring in/make enter/let in) (d:<tum> enter with <sak>, cause or allow) (s:lutsak/tumpih/lutpih) (b:tum) (q:draft)
tumsak = (i:2) (t:v) (w:bring upon/submerge/make go down) (d:<tum>, go down or under, with the causative <sak>: bring water over a place or people, sink something in the sea, or make the sun set) (b:tum) (q:draft, low confidence)
tumsak = (i:3) (t:v) (w:sound/have blown) (d:<tum> play or blow a wind instrument with <sak>: have a trumpet sounded) (s:gingsak) (b:tum) (q:draft)
tumsakpa = (i:1) (t:n) (w:one who brings in/one who causes to enter) (d:<tumsak> cause to enter, with <pa>, the male one who does it) (b:tumsak) (q:draft)
tumsan = (i:1) (t:v) (w:set on/go down on) (d:of the sun, <tum>, set, with <san>, leaving behind: set on someone and leave them in the dark) (q:draft, low confidence)
tumsiam = (i:1) (t:adj) (w:skilled in playing) (d:<tum> play an instrument with <siam> skilled; {a tumsiam} is a skilled player, a musician) (q:draft)
tumsim = (i:1) (t:v) (w:enter secretly/infiltrate/sneak in) (d:<tum> enter, with <sim> secretly) (s:lutsim/simlut) (q:draft)
tumsuak = (i:1) (t:v) (w:keep blowing/blow continually) (d:<tum> blow an instrument, with <suak>, go on doing) (q:draft)
tumsuk = (i:1) (t:v) (w:go down/descend/sink into) (d:go down into something, as food into the stomach or people into the grave) (s:paisuk/kumsuk) (a:kahto/paito) (q:draft)
tumsukin = (i:1) (t:v) (w:sinking/going down) (d:<tumsuk> sink down, with the connective ending <in>) (b:tumsuk) (q:draft)
tumsukna = (i:1) (t:n) (w:sinking/going down) (d:<tumsuk> go down or sink, with the noun suffix <na>) (b:tumsuk) (q:draft)
tumsukte = (i:1) (t:n) (w:things that go down/things that enter) (d:<tumsuk> go down into, with plural <te>: the things that go down, here what goes into the mouth) (b:tumsuk) (q:draft)
tumtakin = (i:1) (t:adv) (w:complacently/self-contentedly) (d:in {nomau’ tumtakin a lungkim}, said of women who feel secure and are satisfied with themselves; the part <tum> is not clear) (q:draft, low confidence)
tumte = (i:1) (t:n) (w:instrument) (d:<tum>, play an instrument, with the plural <te>; in the verses it follows the name of an instrument and means those who play it, as {peengkul tumte}, trumpeters) (b:tum)
tumtheih = (i:1) (t:n) (w:musical instrument/instrument) (d:something that can be played or sounded, from <tum> play and <theih> can; used for instruments of all kinds) (s:lasakna) (b:tum) (q:draft)
tumtheih = (i:2) (t:v) (w:be able to enter/can come in) (d:<tum> enter with <theih> can; {hong tumtheih nadingin}, so that he may come in) (s:luttheih) (r:19.24.9) (q:draft)
tumtheihte = (i:1) (t:n) (w:musical instruments/instruments) (d:plural of <tumtheih>, things that can be played) (s:lasaknate) (b:tumtheih) (q:draft)
tumzaw = (t:see) <tumzaw-in>
tumzaw-in = (i:1) (t:adv) (w:deeper/more deeply) (d:<tum> go in, with <zaw> more and the linking ending <in>: going in further, of a sore that looks deeper than the skin) (q:draft, low confidence)
tumzel = (i:1) (t:v) (w:set again/keep setting) (d:<tum>, of the sun go down, with <zel> again and again; the NIV has hurries back) (q:draft, low confidence)
tun = (i:1) (t:v) (w:arrive/reach/come) (d:form of <tung>, arrive, used before <ciangin>, <ma> and other dependent endings; often written with a final apostrophe) (r:16.2.11) (q:draft)
tun = (i:2) (t:v) (w:come/come to pass/be fulfilled) (d:of a time, a word or a promise: come, come about; the form of <tung> used before <ciangin>, <ma> and <matengin>) (s:tangtung) (q:draft, low confidence)
tunai = (i:1) (t:adj) (w:near/soon/close at hand) (d:of time, near to now, <tu>, now, with <nai>, near; {tunai hun hi lo} is it is not a near time) (q:draft, low confidence)
tunbaih = (i:1) (t:v) (w:come soon/arrive quickly) (d:<tun> arrive with <baih> early, quickly) (s:hawhbaih) (q:draft)
tuncip = (i:1) (t:v) (w:wrap up/bundle up) (d:wrap something tightly in a cloth) (s:vialcip) (q:draft)
tuncipsak = (i:1) (t:v) (w:blindfold/cover up) (d:<tuncip> wrap tightly, with the causative <sak>; {mit tuncipsak} is cover the eyes) (s:tuamsak) (b:tuncip) (q:draft)
tung = (i:1) (t:v) (w:arrive/reach/come) (d:come to a place or person, arrive; also of a time, a word or a feeling that comes upon someone; before <ciangin> the form is <tun>) (a:paikhiat) (r:15.7.8/43.20.8)
tung = (i:2) (t:prep) (w:over/on/upon) (d:the top or upper side of something, placed after the noun, alone or with <ah> or <a>: {mual tung} is on the mountain, the hill country) (r:1.1.2/1.1.26)
tung-ua = (i:1) (t:ppm) (d:<tung> in the sense at the time of, with plural <uh> and the linking <a>; {na neu tung-ua kipan} is from the time you were young) (q:draft, low confidence)
tunga = (i:1) (t:adv) (w:over) (d:<tung> with the linking <a>: over, in authority over, placed after the people who are ruled) (s:tungah) (b:tung)
tunga = (i:2) (t:prep) (w:above/on top of/on) (d:<tung>, top, with the linking <a>: on, upon or above, placed after the noun and before what is there) (s:tungah) (a:nuaiah) (b:tung) (r:1.1.7)
tungah = (i:1) (t:adv) (w:over) (d:<tung> with the place marker <ah>: over, in authority over, placed after the people or land that is ruled) (s:tunga) (b:tung)
tungah = (i:2) (t:prep) (w:above/on top of/on/upon) (d:<tung>, top, with the place marker <ah>: on, upon or above, placed after the noun) (s:tunga/dawnah) (a:nuaiah) (b:tung)
tungdap = (i:1) (t:n) (w:rafter/roof beam) (d:the sloping timbers that carry the roof of a house; {inn tungdap} is the rafters of the house) (s:innkam) (q:draft)
tunghak = (i:1) (t:v) (w:be late in coming/be delayed/be a long time coming) (d:<tung>, arrive, with <hak>, slow or hard: be a long time in arriving) (s:zekai) (q:draft)
tungin = (i:1) (t:adv) (w:early/at the start of) (d:at the very start of something: {zingsang tungin} is early in the morning, and after a verb it means when something has only just begun, as in {kumpi a suah tungin}, early in his reign) (s:baihin/baih) (q:draft)
tungin = (i:2) (t:v) (w:arriving/reaching/coming) (d:<tung>, arrive or come, with the linking ending <in>, which joins it to the next action: having arrived, or coming and then) (b:tung) (q:draft)
tungkha = (i:1) (t:v) (w:fall into/end up in) (d:<tung>, arrive, with <kha>, happen to: end up in a bad state, as in {mawhna sungah tungkha}, fall into sin) (q:draft, low confidence)
tungkhawm = (i:1) (t:v) (w:arrive together/end up together/come to the same place) (d:<tung>, arrive, with <khawm>, together: come to the same place) (b:tung) (q:draft)
tungkhin = (i:1) (t:v) (w:have arrived/have come/have reached) (d:<tung>, arrive, with <khin> for an action already completed: has already come or reached) (s:tungzo/tungta) (b:tung) (q:draft)
tungkhuh = (i:1) (t:n) (w:awning/covering) (d:<tung>, above, with <khuh>, cover: a cloth cover spread overhead, such as the awning of a ship) (q:draft)
tungkhuhna = (i:1) (t:n) (w:covering/roof/canopy) (d:<tungkhuh>, cover over, with the noun suffix <na>: what covers something from above, such as the covering of a tent or an overhanging roof) (s:khuhna) (b:tungkhuh) (q:draft)
tungkhum = (i:1) (t:n) (w:roof) (d:the roof of a house, from <tung>, top, and <khum>, roof; {inn tungkhum} is the roof of the house) (s:innkhum/khum/innkhumzang) (q:draft)
tungkik = (i:1) (t:v) (w:return/arrive back/come back) (d:<tung>, arrive, with <kik>, again or back: reach a place again, come back to a person, or of a deed or a right, come back upon someone) (s:ciahkik/paikik) (b:tung) (r:27.4.34) (q:draft)
tungkikin = (i:1) (t:v) (w:come upon/come back upon) (d:<tungkik>, come back upon, with the linking ending <in>: coming upon someone and then, said here of the anger of God) (b:tungkik) (q:draft, low confidence)
tungkiksak = (i:1) (t:v) (w:bring back upon/make return upon) (d:<tungkik>, come back upon, with the causative <sak>: make a wrong fall back on the one who did it) (s:tungsakkik) (b:tungkik) (q:draft)
tungkim = (i:1) (t:v) (w:come upon all/reach everyone) (d:<tung>, come upon, with <kim>, all alike: come upon every one of a group) (q:draft, low confidence)
tunglam = (i:1) (t:adv) (w:above) (d:the upper side or the direction above, opposite of <nuailam>; {tunglam panin} is from above, and {tunglam mi} is one who is from above) (a:nuai/nuailam)
tunglamah = (i:1) (t:adv) (w:up on/on the upper part) (d:<tunglam>, the upper side, with the place marker <ah>; {mual tunglamah} is up on the mountainside) (b:tunglam) (q:draft)
tungman = (i:1) (t:n) (w:clay/baked clay) (d:clay or earthenware as a material, what a potter works and what is baked hard; often named beside <sik>, iron, and {tungman peek} is a clay tablet for writing on) (q:draft)
tungnak = (i:1) (t:v) (w:pant/gasp) (d:breathe hard with the mouth open, as a woman in labour does) (s:husam) (q:draft, low confidence)
tungnun = (t:see) <tungnun'na>
tungnun'na = (i:1) (t:n) (w:distinction/being set above) (d:what sets someone above or apart from others; spelling of <tungnunna> in the 1932 text) (q:draft, low confidence)
tungnung = (i:1) (t:adj) (w:upper/higher/upstairs) (d:the one above or on top, opposite of <nuainung>, lower: an upper room, gate, millstone or town) (a:nuainung) (q:draft)
tungnunga = (i:1) (t:adj) (w:upper/in the upper) (d:<tungnung> upper with the marker <a>: that is in the upper part) (b:tungnung) (q:draft, low confidence)
tungnungah = (i:1) (t:adj) (w:upper/upstairs) (d:<tungnung>, upper, with the place marker <ah>: in or on the upper, said of a room or floor) (b:tungnung) (q:draft)
tungnungte = (i:1) (t:n) (w:upper parts/upper ones/upper rooms) (d:<tungnung>, upper, with the plural <te>; after a noun, the upper ones: {tuikhuk tungnungte} is the upper springs, and {inn dawl tungnungte} the upper rooms) (a:nuainungte) (b:tungnung) (q:draft)
tungnunna = (i:1) (t:n) (w:distinction/being set above) (d:what sets someone above or apart from others) (q:draft, low confidence)
tungpah = (i:1) (t:v) (w:arrive at once/reach immediately) (d:<tung>, arrive, with <pah>, at once: reach a place straight away) (q:draft)
tungpan = (i:1) (t:prep) (w:from/from upon) (d:<tung> upon with <pan> from, written as one word) (q:draft)
tungpanin = (i:1) (t:prep) (w:from) (d:<tungpan> with the ending <in>; after a possessor, from that person) (b:tungpan) (q:draft)
tungsa = (i:1) (t:adj) (w:happened/come upon/befallen) (d:<tung> arrive, come upon, with <sa> already done: that has come upon someone) (b:tung) (q:draft)
tungsak = (i:1) (t:v) (w:establish/bring upon/bring about/cause to come) (d:<tung>, arrive, with the causative <sak>: make something come upon someone, as disaster, sickness or blessing, or make a thing come about) (b:tung)
tungsakin = (i:1) (t:v) (w:bring upon/send upon/cause to come) (d:<tungsak> with the linking ending <in>: bringing a thing such as famine, plague or war upon a land, followed by a further action) (b:tungsak) (q:draft)
tungsakkik = (i:1) (t:v) (w:bring back upon/bring upon again) (d:<tungsak>, bring upon, with <kik>, back or again: make a wrong fall back on the one who did it, or bring a thing on someone again) (s:tungkiksak) (b:tungsak) (q:draft)
tungsakkikin = (i:1) (t:v) (w:bring back upon/repay) (d:<tungsakkik> with the linking ending <in>: making wrongs come back on those who did them) (b:tungsakkik) (q:draft)
tungsakpa = (i:1) (t:n) (w:one who fulfills/one who brings about) (d:<tungsak> make come about, with <pa> for a male doer: he who has made the promise come true) (b:tungsak) (q:draft)
tungsakte = (i:1) (t:n) (w:those who receive/hosts) (d:<tungsak>, let arrive, with the plural <te>: those who take a traveller into their house) (b:tungsak) (q:draft, low confidence)
tungsakzo = (i:1) (t:v) (w:be able to bring about/be able to fulfil/have brought upon) (d:<tungsak> bring about with <zo>, be able, finish; in Malachi 2:2 said of a curse already brought) (b:tungsak) (q:draft, low confidence)
tungsan = (i:1) (t:prep) (w:above/right over) (d:above, directly over: {ama omna tungsan innkhum} is the roof above the place where he was) (s:tungah) (q:draft, low confidence)
tungsiah = (i:1) (t:adv) (w:upward/and above/or more) (d:from a stated age or number upward, usually after <panin> or <pan>: {kum sawmnih panin a tungsiah} is twenty years old or more) (a:nuaisiah) (r:4.3.22) (q:draft)
tungsiahte = (i:1) (t:n) (w:those above/those older) (d:<tungsiah> upward with the plural <te>: the people from a stated age upward) (b:tungsiah) (q:draft)
tungsilh = (i:1) (t:n) (w:outer garment/garment) (d:<tung>, over, with <silh>, wear: a garment worn on top of the others) (s:puantungsilh) (q:draft, low confidence)
tungsuk = (i:1) (t:v) (w:come down to/go down to/reach down to) (d:<tung>, arrive, with <suk> for movement downward: come down to a place or down upon someone) (a:tungto) (b:tung) (q:draft)
tungta = (i:1) (t:v) (w:has arrived/has come) (d:<tung>, arrive, with <ta>, showing that the time or event has now come; common in {hun hong tungta}, the time has come) (s:tungzo/tungkhin) (b:tung) (q:draft)
tungtang = (i:1) (t:n) (w:matter/concern) (d:the matter that concerns someone or something; with <ah> after a noun or pronoun it means concerning, over, about: {kei tungtang ah} is over me) (q:draft)
tungtangah = (i:1) (t:prep) (w:concerning/about/over/because of) (d:<tungtang>, matter, with the place marker <ah>, placed after the noun: in the matter of, over, because of) (s:tungtangin) (b:tungtang) (q:draft)
tungtangin = (i:1) (t:prep) (w:concerning/in connection with) (d:<tungtang>, matter, with the ending <in>, placed after the noun; {tua tungtangin} is in that connection) (s:tungtangah) (b:tungtang) (q:draft, low confidence)
tungtawn = (i:1) (t:prep) (w:through/by means of) (d:placed after a noun, through or by means of: {upna tungtawn} is through faith) (q:draft)
tungtawnin = (i:1) (t:prep) (w:through/by means of) (d:placed after the noun or a possessor, through, by the agency of a person: {Moses tungtawnin} is through Moses) (s:tawnin) (q:draft)
tungte = (i:1) (t:n) (w:tops/heights) (d:plural of <tung> in the sense top or upper surface; {mual tungte ah} is on the mountains) (b:tung) (q:draft)
tungte = (i:2) (t:n) (w:arrivals/those who arrive) (d:<tung> arrive with <te>, the people who arrive or have come) (b:tung) (q:draft)
tungteng = (i:1) (t:n) (w:every top/all the tops) (d:<tung> top with <teng> all; {mual sang tungteng} is on every high hill) (b:tung) (q:draft)
tungtham = (i:1) (t:n) (w:surface/outside/outward show) (d:what is only on the top or outside and not within; {tungtham bek-a thugenna} is talk that is only on the surface, flattery) (q:draft)
tungthama = (i:1) (t:adj) (w:outward/superficial/on the surface) (d:<tungtham> surface with the marker <a>: that is only on the outside; {tungthama phatna} is flattery, {a tungthama kimu nate} outward appearances) (s:puatham) (b:tungtham) (q:draft)
tungthamah = (i:1) (t:adv) (w:outwardly/on the surface) (d:<tungtham> surface with the place marker <ah>; {a tungthamah}, on the outside) (s:tungthamin) (b:tungtham) (q:draft)
tungthamin = (i:1) (t:adv) (w:outwardly/on the surface) (d:<tungtham> the outside, with the adverb ending <in>: looking only at the surface) (s:tungthamah) (b:tungtham) (q:draft)
tungthamun = (i:1) (t:adv) (w:outwardly) (d:<tungtham> the outside, with <un> for plural you: in your outward show, of hypocrites) (b:tungtham) (q:draft)
tungto = (i:1) (t:v) (w:come up/go up/arrive up) (d:<tung> arrive with <to> upward: reach a place by going up) (a:tungsuk) (b:tung) (q:draft)
tungtuan = (t:see) <tungtuan'na>
tungtuan'na = (i:1) (t:n) (w:excellence/pre-eminence) (d:being above others, with the noun suffix <na>; see <tungtuang>, excel) (q:draft, low confidence)
tungtuang = (i:1) (t:v) (w:excel/be foremost) (d:be above others) (q:draft, low confidence)
tunguh = (i:1) (t:prep) (w:on them/upon them) (d:<tung> upon with plural <uh> written as one word; {a tunguh ah} is on them) (b:tung) (q:draft, low confidence)
tungun = (i:1) (t:conj) (w:when/as soon as) (d:<tung>, at the moment of, after a verb, with the plural marker <un>: when they did so) (q:draft, low confidence)
tungvat = (i:1) (t:v) (w:come suddenly/arrive suddenly) (d:<tung> arrive, come upon, with <vat> suddenly) (q:draft)
tungzang = (i:1) (t:n) (w:top/upper surface/outside) (d:the top or outer side of a thing) (q:draft, low confidence)
tungzangah = (i:1) (t:prep) (w:on top of/above) (d:<tungzang> the top side, with the place marker <ah>) (s:tungah) (b:tungzang) (q:draft)
tungzaw = (i:1) (t:v) (w:come upon instead/fall on rather) (d:<tung> come upon with <zaw> rather, instead) (b:tung) (q:draft)
tungzo = (i:1) (t:v) (w:have come/have arrived) (d:<tung> arrive with <zo> marking completion: has already come, of people, a time or an event) (s:tungkhin/tungta) (b:tung) (q:draft)
Tuni = (t:see) <Tuni-in>
Tuni-in = (i:1) (t:adv) (w:today/this day) (d:<tuni>, today, with the time marker <in>, written with a capital at the start of a sentence) (q:draft)
tunin = (i:1) (t:v) (w:wrapping/wrapped/bundling) (d:<tun>, wrap in a cloth or cover, with the linking ending <in>, joining it to the next verb: wrapping a thing and then; not the <tun> that means arrive) (s:tuamin) (b:tun) (q:draft)
tunitak = (i:1) (t:adv) (w:tonight/this evening) (d:<tu>, this, with <nitak>, evening: this very evening) (s:tuzan) (q:draft, low confidence)
tunkhak = (i:1) (t:v) (w:happen to come/end up in) (d:<tun> arrive with <khak>, happen to: come to a place or state, usually an unwanted one) (q:draft, low confidence)
tunkhit = (i:1) (t:v) (w:have arrived/have come) (d:<tun> arrive with <khit>, finished: after arriving, after it has come) (q:draft)
tunkhitna = (i:1) (t:n) (w:arrival/having arrived) (d:<tunkhit> have arrived with the noun suffix <na>: the fact that someone or something has arrived; {tunkhitna thu} is the news that one has come) (b:tunkhit) (q:draft)
tunkik = (i:1) (t:v) (w:return/come back/arrive back) (d:<tun> arrive with <kik> again, back) (s:ciahkik/paikik) (b:tun) (q:draft)
tunkim = (i:1) (t:v) (w:all arrive/reach everywhere) (d:<tun> arrive with <kim>, all, complete: of people, all reach; of famine, reach every part) (q:draft, low confidence)
tunkuan = (i:1) (t:v) (w:be about to arrive/come near) (d:<tun> arrive with <kuan>, on the point of: just before reaching a place) (q:draft, low confidence)
tunlam = (i:1) (t:n) (w:arrival/time of coming) (d:<tun> arrive with <lam>, the fact or manner of: that or when someone arrives) (q:draft)
tunma = (i:1) (t:adv) (w:before coming/before arriving) (d:<tun>, arrive, with <ma>, before, usually followed by the time marker <in>: {hong tunma-in} is before someone or something came) (r:44.2.20) (q:draft)
tunna = (i:1) (t:n) (w:arrival/coming) (d:<tun>, arrive, with the noun suffix <na>: the arriving of someone or something, or the place it reaches; {a tunna ding hun} is the time for it to come about, and {tunna lampi} the way that leads to a place) (b:tun) (q:draft)
tunna = (i:2) (t:n) (w:wrapping/covering) (d:<tun>, wrap, with the noun suffix <na>: what a thing is wrapped in; {lu tunna puan} is the cloth wrapped around the head) (s:tuamna) (q:draft, low confidence)
tunnasa = (i:1) (t:n) (w:place already reached) (d:<tunna> arriving, with <sa> already done; {a tunnasa munte} are the places it has come to) (b:tunna) (q:draft)
tunni = (i:1) (t:n) (w:day of arrival) (d:<tun> arrive with <ni> day; {a tunni zanin} is on the night of the day he arrived) (b:tun) (q:draft)
tunphetin = (i:1) (t:adv) (w:as soon as he arrived/on arriving) (d:<tun> arrive with <phetin> as soon as) (q:draft)
tunpi = (i:1) (t:n) (c:animal) (w:hornet) (d:a large stinging insect, called a kind of <khuaipi> in Deuteronomy 7:20) (q:draft)
tunpih = (i:1) (t:v) (w:bring/bring to/lead to) (d:<tun>, arrive, with <pih>, together with: bring or lead someone to a place or into a state) (s:paipih) (b:tun) (r:1.8.11) (q:draft)
tunpihin = (i:1) (t:v) (w:bringing/bringing to/having brought) (d:<tunpih> bring to a place, with the linking ending <in>: brought and then) (b:tunpih) (q:draft)
tunpihkik = (i:1) (t:v) (w:bring back/lead back) (d:<tunpih>, bring to a place, with <kik>, back: bring someone back to a place or a person) (s:ciahpihkik) (b:tunpih) (q:draft)
tunpihna = (i:1) (t:n) (w:bringing/leading to) (d:<tunpih> bring to a place, with the noun suffix <na>; {nong tunpihna} is your bringing me) (b:tunpih) (q:draft)
tunpihsuk = (i:1) (t:v) (w:bring down) (d:<tunpih>, bring to a place, with <suk>, downward) (s:paipihsuk) (b:tunpih) (q:draft)
tunpite = (i:1) (t:n) (c:animal) (w:hornets) (d:plural of <tunpi>) (b:tunpi) (q:draft)
tunsa = (t:see) <tunsa-in>
tunsa-in = (i:1) (t:adv) (w:covered/wrapped) (d:<tun> wrap with <sa>, already done, and the ending <in>; {mit tunsa-in}, with the eyes covered) (s:tuamsa-in) (q:draft, low confidence)
tunsak = (i:1) (t:v) (w:bring upon/cause to come) (d:<tun>, arrive, with the causative <sak>: make something, usually disaster or sickness, come upon someone) (b:tun) (q:draft)
tunsak = (i:2) (t:v) (w:fulfil/carry out/bring about) (d:make a vow or a promise come true; {thuciamna tunsak} is fulfil a vow) (s:tangtunsak) (b:tun) (q:draft)
tunsakin = (i:1) (t:v) (w:cover/blindfold) (d:<tun> wrap, cover, with the causative <sak> and the linking ending <in>; {mai tunsak} is cover the face) (q:draft)
tunsakkik = (i:1) (t:v) (w:bind up again/bind up) (d:of wounds: <tun> wrap with <sak> and <kik>, again or back) (s:tuamsak) (q:draft, low confidence)
tunsakkik = (i:2) (t:v) (w:bring again/cause to come again) (d:<tunsak> cause to come with <kik> again) (b:tunsak) (q:draft)
tunsakna = (i:1) (t:n) (w:fulfilment/bringing about) (d:<tunsak>, cause to arrive, with the noun suffix <na>: the bringing about of something; {thuciamna tunsakna} is the fulfilling of a vow) (s:tangtunna) (b:tunsak) (q:draft)
tunsaknop = (i:1) (t:v) (w:be willing to receive/be willing to welcome) (d:<tunsak>, let arrive, take in as a guest, with <nop>, want to) (r:40.10.14) (q:draft)
tunsate = (i:1) (t:n) (w:those wrapped up/things tucked away) (d:<tun>, wrap up or tuck in, with <sa>, already done, and the plural <te>: the things already tucked away, here the hairs kept in the fold of the garment) (q:draft, low confidence)
tunsuk = (i:1) (t:v) (w:come down/arrive down) (d:<tun>, arrive, with <suk>, downward: come down and arrive, as from a mountain) (s:kumsuk/paisuk) (a:tungto) (b:tun) (q:draft)
tuntheih = (i:1) (t:v) (w:be fulfilled/come to pass) (d:<tun>, arrive or come to pass, with <theih>, can: {a tuntheih nadingin} means so that it might be fulfilled, said of a word of Scripture or a prophecy) (s:tangtung) (b:tun) (r:43.18.32) (q:draft)
tuntheih = (i:2) (t:v) (w:be able to reach/can arrive/come upon) (d:<tun>, arrive, with <theih>, can: be able to get to a place; of a blessing or a punishment, be able to come upon someone) (s:tunzo/batzawh) (b:tun) (q:draft)
tuntom = (i:1) (t:adj) (w:short) (d:short in height, said of a person: {mi tuntom} is a short man) (s:tom) (a:sang) (q:draft)
tunu = (i:1) (t:n) (w:granddaughter) (d:<tu>, grandchild, with <nu>, female: the daughter of one’s son or daughter) (q:draft)
tunuam = (i:1) (t:v) (w:like to sit/love to sit/want to sit) (d:<tu>, sit, with <nuam>, want or like: be fond of sitting in a certain place, as in the seats of honour) (q:draft)
tunung = (i:1) (t:adv) (w:hereafter/in the future/from now on) (d:the time after now, usually as {tunung ciangin}, in time to come, from now on) (s:Mailamah/nungcianga) (a:nidang/nidangin/tumasiah) (q:draft)
tunvat = (i:1) (t:v) (w:come suddenly/arrive unexpectedly) (d:<tun>, arrive, with <vat>, suddenly: come upon someone without warning) (s:tungvat) (q:draft)
tunzaw = (i:1) (t:v) (w:succeed more/do better/get further ahead) (d:<tun>, arrive, with <zaw>, more: in the phrase {ma tunzaw}, get further ahead, be more successful than others) (q:draft, low confidence)
tunzawh = (i:1) (t:v) (w:have arrived/manage to reach) (d:<tun>, arrive, with <zawh>, the form of <zo>, finish or be able: {tunzawh ni thum ciangin} is three days after arriving, and {tunzawh nading} is so as to manage to reach) (s:tunkhit) (q:draft)
tunzo = (i:1) (t:v) (w:be able to reach/attain) (d:<tun>, reach, with <zo>, be able: {na ma na tunzo ding} is you will reach what lies before you, you will succeed) (s:batzawh/tuntheih) (b:tun) (q:draft, low confidence)
tup = (i:1) (t:v) (w:intend/aim/purpose) (d:set the mind on something: {tup lohpi} is without meaning to, unintentionally, and {a tup} is what a person aims at) (s:ngim) (q:draft)
tup = (i:2) (t:v) (w:knock/strike/hit) (d:strike, knock: {a ha a tup khiat}, with <khiat>, out, is knock out his tooth) (s:sat) (q:draft, low confidence)
tupa = (i:1) (t:n) (w:grandson) (d:<tu>, grandchild, with <pa>, male: the son of one’s son or daughter) (b:tu) (r:24.36.11) (q:draft)
tupa = (i:2) (t:n) (w:one who sits/the one seated/the one enthroned) (d:<tu>, sit, with <pa>, the male agent suffix: he who sits or is enthroned, written {a tupa}) (b:tu) (q:draft)
tupate = (i:1) (t:n) (w:grandsons) (d:<tupa>, grandson, with the plural <te>; the NIV has the singular here) (b:tupa) (q:draft)
tupcip = (i:1) (t:v) (w:engulf/overwhelm/sweep away) (d:of flood water, close over people and cover them completely; <cip> adds the sense of tightly or completely) (s:tumcip/tuumcip) (q:draft, low confidence)
tupeek = (i:1) (t:n) (w:hoe) (d:a hoe, the hand tool used for digging and breaking up the ground) (q:draft)
tupi = (i:1) (t:adj) (w:dense/thick) (d:thick, dense, said of forest: {gammang tupi} is the dense forest) (s:sah) (q:draft, low confidence)
tupkhiat = (i:1) (t:v) (w:knock out) (d:<tup>, strike, with <khiat>, out: knock out, said of a tooth) (s:betkhiatsak) (b:tup) (q:draft)
tupna = (i:1) (t:n) (w:purpose/aim/goal/intention) (d:<tup>, aim, with the noun suffix <na>: what a person sets out to do or reach, a purpose or goal) (s:ngimna/geelna) (b:tup) (q:draft)
tupna = (i:2) (t:n) (w:beating/blow) (d:<tup>, strike, with the noun suffix <na>: a blow; it occurs in the pair {satna tupna}, beatings) (s:satna/vuakna) (q:draft, low confidence)
tupsak = (i:1) (t:v) (w:wring/twist/press hard) (d:said of the nose, pressed, twisted or struck until it bleeds; probably <tup>, strike, with the causative <sak>) (q:draft, low confidence)
tuptup = (i:1) (t:n) (w:the very thing aimed at/just what was wanted) (d:<tup>, aim, said twice for emphasis: exactly what one was aiming at; {i tuptup tung ei} is we have got just what we wanted) (q:draft, low confidence)
tusak = (i:1) (t:v) (w:seat/make sit/install) (d:<tu>, sit, with the causative <sak>: make someone sit down; of a king, set him on the throne) (s:tutsak) (q:draft)
tusakin = (i:1) (t:v) (w:bringing down on/making rest on/laying on) (d:<tusak>, make sit, with the linking ending <in>: making a deed come down on the head of the one who did it) (b:tusak) (q:draft, low confidence)
tusakzaw = (i:1) (t:v) (w:seat instead/give the seat to) (d:<tusak>, make sit, with <zaw>, rather: seat this one in preference to another) (b:tusak) (q:draft)
tusawn = (i:1) (t:n) (w:great-grandson/great-grandchild) (d:the generation after <tu>, grandchild: a great-grandchild, the child of a grandchild) (q:draft)
tusawng = (i:1) (t:adv) (w:these days/recently/lately) (d:{tusawng tenga} means during these last days, in the days just past) (q:draft, low confidence)
tusawnte = (i:1) (t:n) (w:great-grandchildren) (d:<tusawn>, great-grandchild, with the plural <te>: the children of one’s grandchildren) (b:tusawn) (q:draft)
tusuk = (i:1) (t:v) (w:sit down) (d:<tu>, sit, with <suk>, downward: sit down, take a seat) (s:tucip) (a:tuto/dingto) (q:draft)
tusukin = (i:1) (t:v) (w:sitting down/sat down) (d:<tusuk>, sit down, with the linking ending <in>: sitting down, having sat down) (b:tusuk) (q:draft)
tut = (i:1) (t:v) (w:sit/be seated) (d:the form of <tu>, sit, used before endings and linking words such as <ciangin>, <khit>, <lai> and <nading>) (a:din) (b:tu) (q:draft)
tutak = (i:1) (t:v) (w:just now)
tutak = (i:2) (t:adv) (w:at the moment/at present/just now/right now/at the present time) (d:<tu>, now, with <tak>, exactly: at this very moment) (s:tumahin/tadihin)
tutakin = (i:1) (t:conj) (w:just now) (d:<tutak>, just now, with the ending <in>: at this moment, for the time being) (b:tutak)
Tutakin = (i:1) (t:adv) (w:now/at present/just now) (d:<tutakin>, at this moment, written with a capital at the start of a sentence) (s:tumahin/tadihin) (b:tutakin) (q:draft)
tutding = (i:1) (t:v) (w:to sit/sitting) (d:<tut>, sit, with <ding>, to or for: the act of sitting that is to be; here the sitting at the right hand and the left) (b:tut) (q:draft)
tute = (i:1) (t:n) (w:grandchildren) (d:<tu>, grandchild, with the plural <te>: the children of one’s sons and daughters) (q:draft)
tute = (i:2) (t:n) (w:those sitting/those seated) (d:<tu>, sit, with the plural <te>: the ones who sit, written {a tute}) (q:draft)
tutkhawm = (i:1) (t:v) (w:sit together/sit with) (d:<tut>, sit, with <khawm>, together: sit down together with others; also of people living together as one) (s:tukhawm/tutpih) (b:tut) (q:draft)
tutkhawmpih = (i:1) (t:v) (w:sit together with) (d:<tutkhawm>, sit together, with <pih>, along with: {a tutkhawmpih mite} are those sitting with him) (s:tutpih) (b:tutkhawm) (q:draft)
tutkho = (i:1) (t:v) (w:stay up late/sit long) (d:<tut>, sit, with <kho>, lasting long: sit on for a long time; {nitakin a tutkho mite} are those who stay up late at night) (q:draft, low confidence)
tutmawkna = (i:1) (t:n) (w:idle sitting/idleness) (d:<tut>, sit, with <mawk>, aimlessly, and the noun suffix <na>: sitting about doing nothing) (s:ommawkna) (a:thanuamna) (q:draft)
tutna = (i:1) (t:n) (w:seat/sitting place) (d:<tut>, sit, with the noun suffix <na>: a seat, a place or thing to sit on; {tutna mun} is the place where one sits or dwells) (s:tutphah/tokhom) (b:tut) (q:draft)
tutnasa = (i:1) (t:n) (w:place sat on/thing sat on/former seat) (d:<tutna>, seat, with <sa>, already: the thing or place where someone has been sitting) (b:tutna) (q:draft)
tutnate = (i:1) (t:n) (w:seats/benches) (d:<tutna>, seat, with the plural <te>: seats, benches) (s:tutphahte) (b:tutna) (q:draft)
tutnopna = (i:1) (t:n) (w:wish to sit/wanting to sit) (d:<tut>, sit, with <nop>, want, and the noun suffix <na>: the wish to sit somewhere, here the guests wanting the seats of honour) (q:draft)
tuto = (i:1) (t:v) (w:sit up/move up/sit higher) (d:<tu>, sit, with <to>, upward: sit up from lying down, or come up to sit in a higher place) (a:tusuk/lumsuk) (q:draft)
tutphahte = (i:1) (t:n) (w:seats/benches) (d:<tutphah>, seat, with the plural <te>) (s:tutnate) (b:tutphah) (r:40.21.12) (q:draft)
tutphat = (i:1) (t:n) (w:saddle/seat for riding) (d:the thing a rider sits on, a saddle; the other Tedim text has <tutphah> in this verse) (s:tutphah/tuanna) (q:draft, low confidence)
tutpih = (i:1) (t:v) (w:sit with/sit together with) (d:<tut>, sit, with <pih>, together with: {a tutpih mite} are those who sit with him) (s:tutkhawmpih/tukhawm/tutkhawm) (b:tut) (q:draft)
tutpihpa = (i:1) (t:n) (w:the man one sits with/table companion) (d:<tutpih>, sit with, with <pa> for a man: the man with whom one sits at table) (b:tutpih) (q:draft)
tutsak = (i:1) (t:v) (w:seat/make sit) (d:<tut>, sit, with the causative <sak>: give someone a seat, make him sit; {ama taklamah a tutsak} is seat him at his right hand) (s:tusak) (b:tut) (q:draft)
tutsukna = (i:1) (t:n) (w:sitting down/staying) (d:<tut>, sit, with <suk>, down, and the noun suffix <na>: sitting down, staying in a place; set beside <pusuahna>, going out, and <sungtumna>, coming in) (q:draft)
tutte = (i:1) (t:n) (w:revenues/things brought in) (d:what merchants and traders bring in or deliver: <tut>, bring in or deliver, as in <kitut>, with the plural <te>; not from <tut>, sit) (q:draft, low confidence)
tuttheih = (i:1) (t:v) (w:be able to bring/be able to deliver) (d:<tut>, bring or deliver, with <theih>, can, the form used before <nading>; not from <tut>, sit) (q:draft, low confidence)
tuttohkik = (i:1) (t:v) (w:bring back up/lift back) (d:<tut>, bring, with <toh>, upward, and <kik>, back: of the hand, bring it back up from the dish to the mouth) (q:draft, low confidence)
tutu = (i:1) (t:v) (w:keep sitting/sit on and on) (d:<tu>, sit, said twice to show that the sitting goes on or is a habit) (q:draft)
Tutung = (i:1) (t:adv) (w:this time/now) (d:<tu>, now, with <tung>: this time, at this point; {tutung peuhmahin} is this very time; written with a capital at the start of a sentence) (s:tuhunin) (q:draft, low confidence)
tutungin = (i:1) (t:adv) (w:this time) (d:{tutung}, this time, with the ending <in>: on this occasion, now) (s:tuhunin)
tuu = (i:1) (t:n) (c:animal) (w:sheep) (d:a sheep, the animal kept in flocks by a shepherd for its wool, milk and meat)
Tuu = (i:1) (t:n) (w:Sheep) (d:<tuu>, sheep, written with a capital in the name {Tuu Kongpi}, the Sheep Gate of Jerusalem, and at the start of a sentence) (b:tuu) (q:draft)
Tuubuk = (i:1) (t:n) (w:sheep pen/sheepfold/fold) (d:<tuu>, sheep, with <buk>, hut or shelter: an enclosure for sheep; written with a capital at the start of a sentence) (s:tuukhawk/tuukulh/tuukhumna) (q:draft)
tuubukte = (i:1) (t:n) (w:sheep pens/sheepfolds) (d:<tuu>, sheep, with <buk>, shelter, and the plural <te>) (s:tuukhawkte) (q:draft)
tuucin = (i:1) (t:n) (w:shepherd/shepherding) (d:short form of <tuucing>, shepherd or tend sheep, used before another word: {tuucin’ thung-ip} is a shepherd’s bag and {tuucin’ thaman} a shepherd’s pay) (s:tuucingpa) (q:draft)
tuucing = (i:1) (t:v) (w:shepherd) (d:<tuu>, sheep, with <cing>, keep or tend: one who tends sheep; {migi tuucing} is the good shepherd)
Tuucing = (i:1) (t:n) (w:Shepherd) (d:<tuucing>, shepherd, written with a capital as a title of Christ and at the start of a sentence; {Tuucing Ukpa} is the Chief Shepherd) (s:Tuucingpa) (b:tuucing) (q:draft)
tuucingpa = (i:1) (t:n) (w:shepherd) (d:<tuucing>, shepherd, with <pa>, the male suffix: a man who tends sheep) (s:gancingpa/cingpa) (b:tuucing)
Tuucingpa = (i:1) (t:n) (w:Shepherd) (d:<tuucingpa>, shepherd, written with a capital as a title of God or Christ and at the start of a sentence; <pa> marks a male person) (s:Tuucing) (b:tuucingpa) (q:draft)
tuucingte = (i:1) (t:n) (w:shepherds) (d:<tuucing>, shepherd, with the plural <te>) (s:gancingte) (b:tuucing) (r:42.2.18) (q:draft)
Tuucingte = (i:1) (t:n) (w:shepherds) (d:<tuucingte>, shepherds, written with a capital at the start of a sentence and in the place name {Tuucingte’ Buk}, Beth Eked of the Shepherds in the NIV) (b:tuucingte) (q:draft)
tuucinna = (i:1) (t:n) (w:tending sheep/shepherding/sheep pasture) (d:<tuucin>, tend sheep, with the noun suffix <na>: the work of a shepherd, or a place where sheep are kept) (b:tuucin) (q:draft)
tuuhon = (i:1) (t:n) (w:flock) (d:<tuu>, sheep, with <hon>, flock or herd) (s:ganhon) (b:tuu) of sheeps
tuuhonnote = (i:1) (t:n) (c:animal) (w:young of the flock/lambs) (d:<tuuhon>, flock of sheep, with <no>, young, and the plural <te>: the lambs of the flock) (s:tuunote) (q:draft)
tuuhonpi = (i:1) (t:n) (w:great flock/large flock of sheep) (d:<tuuhon>, flock of sheep, with <pi>, great) (b:tuuhon) (q:draft)
tuuhonte = (i:1) (t:n) (w:flocks) (d:<tuuhon>, flock of sheep, with the plural <te>) (s:ganhonte) (b:tuuhon) (q:draft)
tuukhawk = (i:1) (t:n) (w:sheep pen/sheepfold) (d:<tuu>, sheep, with <khawk>, pen: an enclosure where sheep are kept or lie down) (s:tuukulh/tuukhumna/Tuubuk) (q:draft)
tuukhawkte = (i:1) (t:n) (w:sheep pens/sheepfolds) (d:<tuukhawk>, sheep pen, with the plural <te>) (s:tuubukte) (b:tuukhawk) (q:draft)
tuukhumna = (i:1) (t:n) (w:sheep pen/sheepfold) (d:<tuu>, sheep, with <khum>, shut in, and the noun suffix <na>: the place where sheep are shut in) (s:tuukulh/tuukhawk/Tuubuk) (q:draft)
tuukong = (i:1) (t:n) (w:sheep gate/door of the sheepfold) (d:<tuu>, sheep, with <kong>, door: the gate of the sheepfold; {tuukong cing pa} is the gatekeeper) (q:draft)
tuukulh = (i:1) (t:n) (w:sheep pen/sheepfold) (d:<tuu>, sheep, with <kulh>, wall or enclosure: a walled pen for sheep) (s:tuukhawk/tuukhumna/Tuubuk) (r:43.10.1) (q:draft)
tuulak = (i:1) (t:n) (w:forest/thicket/woodland) (d:thick forest or undergrowth where wild animals live, as the thickets along the Jordan) (s:tulak/gamlak) (q:draft)
tuulebawngte = (i:1) (t:n) (c:animal) (w:flocks and herds/sheep and cattle) (d:<tuu>, sheep, <le>, and, <bawng>, cattle, with the plural <te>, written as one word) (q:draft)
tuulekeel = (i:1) (t:n) (c:animal) (w:sheep and goats/flock) (d:<tuu>, sheep, <le>, and, <keel>, goat, written as one word; {tuulekeel hon} is the flock, beside <bawnghon>, the herd) (q:draft)
tuulekeelno = (i:1) (t:n) (c:animal) (w:lambs and kids/young of the flock) (d:<tuulekeel>, sheep and goats, with <no>, young one) (s:tuuhonnote) (b:tuulekeel) (q:draft)
tuum = (i:1) (t:v) (w:cover over/submerge/overwhelm) (d:of water or a load: close over something and bury it) (s:tuumcip/vukcip/khuhcip) (q:draft)
tuumcip = (i:1) (t:v) (w:cover/submerge/overwhelm/flood over) (d:<tuum>, cover over, with <cip>, tightly or completely: of water, cover something completely) (s:tumcip/khuhcip/vukcip) (b:tuum) (q:draft)
tuummang = (i:1) (t:v) (w:engulf/swallow up/submerge) (d:<tuum>, cover over, with <mang>, out of sight: of water, cover something so that it is lost; also sink and be lost in the sea) (s:tummang/tumcip) (q:draft)
tuumsak = (i:1) (t:v) (w:make cover/cover/overwhelm) (d:<tuum>, cover over, with the causative <sak>: make water cover and bury someone) (b:tuum) (q:draft)
tuumsakin = (i:1) (t:v) (w:overwhelming/covering over) (d:<tuumsak>, make water cover, with the linking ending <in>: making water close over something) (b:tuumsak) (q:draft)
tuumsakkik = (i:1) (t:v) (w:bring back over/make cover again) (d:<tuumsak> make water cover, with <kik> back or again) (b:tuumsak) (q:draft)
tuumul = (i:1) (t:n) (w:wool/fleece) (d:<tuu>, sheep, with <mul>, hair: the wool of a sheep, a fleece) (s:ganmul/samul) (r:9.25.4) (q:draft)
tuumulte = (i:1) (t:n) (w:fleece/wool) (d:<tuumul>, wool or fleece, with the plural <te>) (b:tuumul) (q:draft)
tuumzo = (i:1) (t:v) (w:overwhelm/cover completely) (d:<tuum>, cover over, with <zo>, showing that the action is carried through: of guilt, rise right over the head) (s:tuumcip) (b:tuum) (q:draft)
tuunawi = (i:1) (t:n) (w:sheep's milk/milk of the flock) (d:<tuu>, sheep, with <nawi>, milk) (q:draft)
tuung = (i:1) (t:adv) (w:just beginning/very early) (d:just at the start, at the very first moment: {zingsang tuung} is very early in the morning, {ni suak tuung} the sun as it is just rising) (q:draft, low confidence)
tuuno = (i:1) (t:n) (c:animal) (w:lamb) (d:<tuu>, sheep, with <no>, young: a young sheep; {kum khat a pha tuuno} is a lamb a year old) (b:tuu) (q:draft)
Tuuno = (i:1) (t:n) (w:Lamb) (d:<tuuno>, lamb, written with a capital as a title of Christ, the Lamb of God, mostly in Revelation) (b:tuuno) (q:draft)
tuunote = (i:1) (t:n) (c:animal) (w:lambs) (d:<tuuno>, lamb, with the plural <te>) (s:tuuhonnote) (b:tuuno) (q:draft)
tuununo = (i:1) (t:n) (c:animal) (w:ewe lamb) (d:<tuu> sheep with <nu> female and <no> young: a young female sheep) (q:draft)
tuupi = (i:1) (t:n) (c:animal) (w:ewe/female sheep) (d:<tuu> sheep with <pi> marking the grown female, set beside <tuutal> ram) (a:tuutal) (b:tuu) (q:draft)
tuupite = (i:1) (t:n) (c:animal) (w:ewes) (d:<tuupi>, ewe, with the plural <te>; {no a nei tuupite} are ewes that have young) (a:tuutalte) (b:tuupi) (q:draft)
tuusa = (i:1) (t:n) (w:mutton/sheep meat) (d:<tuu> sheep with <sa> meat, flesh: what the owners sell after slaughtering their sheep) (b:tuu) (q:draft, low confidence)
tuusiah = (i:1) (t:n) (w:tribute of sheep) (d:<tuu> sheep with <siah> tribute, tax: the share of the sheep given as tribute) (q:draft)
tuutal = (i:1) (t:n) (c:animal) (w:ram) (d:<tuu>, sheep, with <tal>, male: a male sheep, often named among the animals for sacrifice) (a:tuupi) (q:draft)
tuutalte = (i:1) (t:n) (c:animal) (w:rams) (d:<tuutal>, ram, with the plural <te>) (a:tuupite) (b:tuutal) (q:draft)
tuute = (i:1) (t:n) (c:animal) (w:sheep/flock) (d:<tuu>, sheep, with the plural <te>; also a picture of people under the care of a shepherd) (b:tuu) (q:draft)
tuuvun = (i:1) (t:n) (w:sheepskin/sheep's clothing) (d:<tuu>, sheep, with <vun>, skin: the skin of a sheep, worn as clothing or used as a covering) (q:draft)
tuzan = (i:1) (t:adv) (w:tonight/this night) (d:<tu> now, this, with <zan> night; also used as a noun, the present night) (s:tunitak) (q:draft)
tuzanin = (i:1) (t:adv) (w:tonight/last night/this night) (d:<tuzan> with <in>: during this night, either the night now coming or the one just past) (s:tunitak) (b:tuzan) (q:draft)
tuzaw = (i:1) (t:v) (w:sit rather/take a seat) (d:<tu> sit with <zaw> rather, more: choose one seat rather than another, move to sit in a place) (b:tu) (q:draft, low confidence)
tuzawh = (i:1) (t:conj) (w:after) (d:counting from now: <tu>, now, with <zawh>, after; {tuzawh ni nih khit ciangin} is two days from now)
tuzawh = (i:2) (t:conj) (w:afterwards)
tuzawh = (i:3) (t:conj) (w:next) (d:the time that comes next, counted from now: {tuzawh ni sawmthum sungin} is during the next thirty days)
tuzawh = (i:4) (t:adj) (w:later) (s:khit)
tuzawh = (i:5) (t:prep) (w:following)
tuzum = (i:1) (t:n) (w:mattock) (d:a pointed digging tool, from <tu> hoe and <zum> pointed; named beside <tu> in a list of farm tools) (q:draft, low confidence)
tuzumte = (i:1) (t:n) (w:picks/iron picks) (d:<tuzum>, a pointed digging tool, with plural <te>) (b:tuzum) (r:10.12.31) (q:draft)
ua = (t:see) <sung-ua>
uang = (i:1) (t:v) (w:be excessive/go to excess/be wild) (d:go beyond measure in something; of living, be wild and unrestrained; {uang zat} is use lavishly) (q:draft)
uanglua = (t:see) <uanglua-in>
uanglua-in = (i:1) (t:adv) (w:too elaborately/excessively) (d:<uang> go to excess, with <lua> too much and the adverb ending <in>) (s:khengvalin) (q:draft)
uangtatna = (i:1) (t:n) (w:revelry/orgy/wild living) (d:<uang> be wild or excessive, with <tat> behave and the noun suffix <na>) (s:noptatna) (q:draft)
uap = (i:1) (t:v) (w:accompany/attend/escort) (d:go with or go out to someone as a companion, as the friends who attend a bridegroom) (q:draft)
uatsaknate = (t:see) <ki-uatsaknate>
uel = (t:see) <De-uel>
Uel = (i:1) (t:name) (c:male) (w:Uel) (d:one of the descendants of Bani who had married a foreign wife in the time of Ezra) (q:draft)
Ufaz = (i:1) (t:name) (c:place) (w:Uphaz) (d:place known for its gold, of unknown location) (r:24.10.9)
uh = (i:1) (t:ppm) (d:postpositional marker to indicate objective case)
uha = (i:1) (t:part) (d:the plural marker <uh> joined with {-a}, the short form of <ah>, at, in, on or of; it follows a noun that belongs to several people and links it to the next word, as {na mai uha om}, that are in front of you) (b:uh) (q:draft, low confidence)
uhah = (i:1) (t:ppm) (d:plural marker <uh> joined with the place marker <ah>, after a noun owned by several people, in or to their or your) (b:uh) (q:draft, low confidence)
uhahi = (i:1) (t:part) (d:plural marker <uh> and <ahi>, it is, written together at the end of a question) (q:draft, low confidence)
uhamte = (i:1) (t:n) (w:the old/elders/old people) (d:older people, set against <khangnote> the young) (s:khanghamte/teekte/teeksiate) (a:khangnote/khangmoite) (q:draft)
uhcin = (i:1) (t:det) (w:if you) (d:follows <le>, if, after a verb, written <le uhcin> or {le-uhcin}: if you do so, said to several people; <uh> marks the plural and <cin> the second person) (q:?)
uhleh = (i:1) (t:conj) (w:if/unless) (d:plural marker <uh> written together with <leh>, if, after a verb whose subject is plural; with <kei> before it, unless) (q:draft)
uhleh = (i:2) (t:conj) (w:and) (d:plural possessor marker <uh> written together with <leh>, and, joining two nouns) (q:draft, low confidence)
uhteh = (i:1) (t:part) (d:in {le uhteh}, also written {le-uhteh}, placed after a verb: if you do, when you do, said to several people; <uh> marks the plural and <le> with <teh> the condition) (q:draft)
uih = (i:1) (t:v) (w:stink/smell bad/reek) (d:give off a bad smell, as of rotting flesh or a festering wound) (s:ning) (q:draft)
uihgawp = (i:1) (t:v) (w:stink badly/reek) (d:<uih> stink with <gawp>, thoroughly, badly) (b:uih) (q:draft)
uihin = (i:1) (t:v) (w:stink/smell bad) (d:<uih> with the linking ending <in>) (b:uih) (q:draft)
uihna = (i:1) (t:n) (w:stench/stink/bad smell) (d:<uih> stink with the noun suffix <na>) (b:uih) (q:draft)
uihsak = (i:1) (t:v) (w:make stink/give a bad smell) (d:<uih> stink with the causative <sak>) (b:uih) (q:draft)
uihta = (i:1) (t:v) (w:stink already/have begun to smell) (d:<uih> stink with <ta>, marking a state already reached) (b:uih) (q:draft)
uihte = (i:1) (t:n) (w:those that stink/rotting ones) (d:<uih> stink with plural <te>; {misi a uihte} are the stinking dead) (b:uih) (q:draft)
uikai = (i:1) (t:n) (c:star) (w:the Bear) (d:second part of the star name {Khawlei-uikai}, the Bear, also written {Khawlei uikai} as two words) (q:draft, low confidence)
uili = (i:1) (t:n) (c:animal) (w:flea) (d:a tiny biting insect; David uses it as a picture of someone too small to be worth hunting) (q:draft)
uilut = (i:1) (t:n) (w:tumor/boil) (d:a swelling or boil on the body; {uilut vei} is to suffer from tumors) (s:meimatum) (q:draft)
uilutte = (i:1) (t:n) (w:tumors) (d:plural of <uilut>) (b:uilut) (q:draft)
uiphuk = (i:1) (t:n) (c:animal) (w:frog) (q:draft)
uiphukte = (i:1) (t:n) (c:animal) (w:frogs) (d:<uiphuk>, frog, with the plural <te>) (b:uiphuk) (q:draft)
uisan = (i:1) (t:adj) (w:gluttonous/greedy) (d:of a person greedy for food) (q:draft, low confidence)
uisante = (i:1) (t:n) (w:gluttons) (d:<uisan> greedy for food, with plural <te>: those who eat too much) (b:uisan) (q:draft)
uisi = (i:1) (t:n) (c:animal) (w:dead dog) (d:<ui> dog with <si> die; said of a person as a term of contempt) (q:draft)
uite = (i:1) (t:n) (c:animal) (w:dogs) (d:<ui>, dog, with the plural <te>; also said of evil people) (b:ui) (r:42.16.21) (q:draft)
uk = (i:1) (t:n) (w:dominion)
uk = (i:2) (t:n) (w:rule)
uk = (i:3) (t:n) (w:control)
uk = (i:4) (t:n) (w:govern)
Uk = (i:1) (t:n) (w:kingdom/reign/rule) (d:<uk>, rule, written with a capital for the reign of God: {Pasian’ Uk ding hun} is the time when God will rule, the kingdom of God) (s:Ukna/Gam/Kumpigam) (b:uk) (r:61.1.11) (q:draft)
ukcip = (i:1) (t:v) (w:subdue/control completely/hold in one's power) (d:<uk> rule with <cip> tightly: bring fully under one's rule or power) (s:nuaisiah/zogawp) (b:uk) (r:24.27.8) (q:draft)
ukcipsak = (i:1) (t:v) (w:make subdue completely/bring fully under rule) (d:<ukcip> bring fully under one's rule, with the causative <sak>) (b:ukcip) (q:draft, low confidence)
ukgawp = (i:1) (t:v) (w:rule harshly/rule over) (d:<uk> rule with <gawp>, done severely or with force) (b:uk) (q:draft)
ukin = (i:1) (t:v) (w:rule/be in charge of/command) (d:form of <uk> with the linking ending <in>; {a ukin koih} is put in charge of) (b:uk) (r:13.11.25) (q:draft)
ukkha = (i:1) (t:v) (w:get to rule/come to rule) (d:<uk> rule with <kha>, happen to: in the negative, not get to rule) (q:draft)
ukkhawm = (i:1) (t:v) (w:reign together/rule together) (d:<uk> rule with <khawm> together) (s:maangkhawm) (b:uk) (q:draft)
ukkhial = (i:1) (t:v) (w:misrule/manage wrongly) (d:<uk> rule with <khial> wrongly; of one who brings trouble on his own household) (q:draft)
ukkik = (i:1) (t:v) (w:rule again/rule in turn) (d:<uk> rule with <kik> again, back) (b:uk) (q:draft)
uklah = (i:1) (t:v) (w:consume/eat up) (d:used with <sak> of zeal that consumes the heart) (q:draft, low confidence)
uklam = (i:1) (t:n) (w:ruling/the fact of ruling) (d:<uk> rule with <lam>, the fact or manner of: that someone rules) (q:draft)
ukna = (i:1) (t:n) (w:dominion) (d:<uk>, rule, with the noun suffix <na>: rule, authority or dominion; {ukna gam} is the land that someone rules) (s:thuneihna/aana) (b:uk)
ukna = (i:2) (t:n) (w:dominance) (d:the authority one person has over another, as in {ukna nuai-ah}, under the authority of) (b:uk)
ukna = (i:3) (t:n) (w:domination) (b:uk)
ukna = (i:4) (t:v) (w:subdue) (d:used with <nei>, have: {ukna nei} is have dominion over, rule over) (b:uk)
Ukna = (i:1) (t:n) (w:kingdom/reign) (d:<ukna>, rule, written with a capital in {Pasian’ Ukna}, the kingdom of God) (s:Uk/Gam/Kumpigam) (b:ukna) (q:draft)
uknate = (i:1) (t:n) (w:dominions/powers/authorities) (d:<ukna> rule, dominion with plural <te>; in 1 Kings 14:19 {a gam uknate} is how he ruled the land) (s:vangliatnate/thuneite) (b:ukna) (q:draft)
ukpa = (i:1) (t:n) (w:ruler/commander/captain/governor) (d:the man who rules or is in charge; {siampi ukpa} is the high priest) (s:mangpa/makai/ulianpa) (b:uk) (q:draft)
Ukpa = (i:1) (t:n) (w:Ruler/Chief/Overseer/Prince) (d:capitalised form of <ukpa> as a title of Christ: {Siampi Ukpa} is the high priest, {Tuucing Ukpa} the Chief Shepherd) (b:ukpa) (q:draft)
Ukpi = (i:1) (t:n) (w:Prince/ruler/chief) (d:<ukpi>, chief, written with a capital as a title of Jesus, the Prince, and before the name of a chief) (b:ukpi) (q:draft)
ukpipa = (i:1) (t:n) (w:chief/ruler/chief officer) (d:<ukpi> with {-pa} for a man: the man who is head of or in charge of a group or place) (s:ukpi/makaipa) (b:ukpi) (q:draft)
ukpite = (i:1) (t:n) (w:chiefs/leaders/rulers) (d:<ukpi>, chief, with the plural <te>) (s:makaite/lutangte/uliante) (b:ukpi) (q:draft)
uksak = (i:1) (t:v) (w:let rule/make rule/put in control) (d:<uk>, rule, with causative <sak>: give someone or something control over) (b:uk) (q:draft)
uksakin = (i:1) (t:v) (w:make ruler over/put in charge of) (d:<uksak> let rule, with the linking ending <in>) (b:uksak) (q:draft)
uksakpa = (i:1) (t:n) (w:one who makes rule) (d:<uksak> make rule with <pa>, the male one who does it: he who set the sun to rule the day and the moon and stars to rule the night) (b:uksak) (q:draft)
uksawn = (i:1) (t:v) (w:govern/administer) (d:rule a province or region under a higher king; {a uksawn mite} are governors and {uksawn kumpi} is a tetrarch or regional ruler) (q:draft)
uksawnte = (i:1) (t:n) (w:governors/satraps) (d:<uk> rule with <sawn> in turn and plural <te>: those who rule a land under the king) (s:mangpite/mangliante) (b:uksawn) (q:draft)
uksung = (i:1) (t:n) (w:jurisdiction/realm) (d:the area under someone's rule, from <uk> rule and <sung> inside) (q:draft)
uktawm = (t:see) <ki-uktawm>
ukte = (i:1) (t:n) (w:commanders/captains/rulers/officers) (d:those who rule or are in charge of people or of a land) (s:mangte/uliante/thuneite) (b:uk) (r:13.13.1) (q:draft)
uktheih = (i:1) (t:v) (w:be able to rule/can rule) (d:<uk> rule with <theih> can) (b:uk) (q:draft)
ukzaw = (i:1) (t:v) (w:rule all the more/reign more) (d:<uk> rule with <zaw> more) (b:uk) (q:draft)
ukzawh = (i:1) (t:v) (w:reign/rule over) (d:rule as king; {a ukzawh kum} with a number is the year of a king's reign) (s:maang/maan) (b:ukzaw) (q:draft)
ukzawh = (i:2) (t:v) (w:control/master) (d:with {ki-} before it, control oneself, be self-controlled) (s:ukzo) (b:ukzaw) (q:draft)
ukzawhna = (i:1) (t:n) (w:control/mastery/rule) (d:the power to rule over something; {ki-ukzawhna} or {pumpi ki-ukzawhna} is self-control) (b:ukzawh) (q:draft)
ukzawhnate = (i:1) (t:n) (w:dominion/authority/power to rule) (d:<ukzawhna>, the power to rule, with <te>, which here closes a list of nouns: dominion and authority) (b:ukzawhna) (q:draft)
ukzia = (i:1) (t:n) (w:way of managing/way of ruling/how to manage) (d:<uk>, rule, with <zia>, manner: the way to rule or manage something; {ukzia ding a theih kei leh} is if he does not know how to manage) (q:draft)
ukzo = (i:1) (t:v) (w:rule/govern/manage/control) (d:<uk>, rule, with <zo>, be able: be able to rule or manage, have control over; {ki-ukzo} is to control oneself) (b:uk) (q:draft)
ukzote = (i:1) (t:n) (w:those who manage/those who rule) (d:<ukzo>, be able to rule, with the plural <te>: those who manage or rule well) (b:ukzo) (q:draft)
ul = (t:see) <khua-ul>
Ulai = (i:1) (t:name) (c:river) (w:Ulai) (d:river or canal beside the city of Susa in Elam, where Daniel saw a vision) (r:27.8.16) (q:draft)
Ulam = (i:1) (t:name) (c:male) (w:Ulam) (d:name of two men, a descendant of Manasseh and a Benjaminite who was the firstborn of Eshek) (r:13.7.16/13.8.39) (q:draft)
ulenau = (i:1) (t:n) (w:brothers/siblings/brother) (d:<u>, elder sibling, <le>, and, <nau>, younger sibling, written as one word: brothers and sisters, also the people close to one) (s:unau/sanggam) (q:draft)
ulenaute = (i:1) (t:n) (w:brothers and sisters/brothers) (d:<u> older sibling, <le> and, <nau> younger sibling, with plural <te>; used of fellow believers) (s:unaute/sanggamte/Khristianpihte) (b:ulenau) (q:draft)
ulian = (i:1) (t:n) (w:official/ruler/prince/leader) (d:a man of high rank who rules or who serves under a king: an official, a prince or a ruler) (s:makai/ukpa) (q:draft)
ulianin = (i:1) (t:n) (w:as ruler/as prince/as leader) (d:<ulian> ruler, official with the marker <in>: into or in the position of a ruler, after <bawl> make or <koih> appoint) (b:ulian) (q:draft)
ulianpa = (i:1) (t:n) (w:prince/ruler/commander) (d:<ulian>, official, with <pa>, which marks a man: a man of high rank who rules or commands, a prince, ruler or commander) (s:ukpa/mangpa/ukpipa) (b:ulian) (q:draft)
ulianpen = (i:1) (t:n) (w:highest official/most noble prince) (d:<ulian>, official, with <pen>, most: the highest in rank among the officials) (b:ulian) (q:draft)
ulianpi = (i:1) (t:n) (w:great official/great man/high official) (d:<ulian>, official, with <pi>, great: a man of very high rank) (s:milianpi) (b:ulian) (q:draft)
ulianpihte = (i:1) (t:n) (w:fellow officers/fellow officials/staff) (d:<ulian> official with <pih>, fellow, and plural <te>: the officers who serve together with someone) (q:draft)
ulianpipi = (i:1) (t:n) (w:high officials/men of high rank) (d:<ulianpi>, great official, with <pi> doubled to show that there are many: men of high rank) (s:ulianpite) (b:ulianpi) (q:draft)
ulianpite = (i:1) (t:n) (w:chief officials/chief officers/high officials) (d:plural of <ulianpi>, a senior official; <pi> marks the higher rank) (s:ulianpipi) (b:ulianpi) (q:draft)
uliante = (i:1) (t:n) (w:officials/princes/rulers/leaders) (d:plural of <ulian>: the officials, princes or rulers of a king or of a people) (s:makaite/ukte/miliante/mangliante) (b:ulian) (q:draft)
Uliante = (i:1) (t:n) (w:rulers/princes) (d:<uliante>, rulers, written with a capital at the start of a sentence or where rulers are addressed) (b:uliante) (q:draft)
ulianzaw = (i:1) (t:n) (w:higher official/more distinguished person) (d:<ulian>, person of rank, with <zaw>, more: someone of higher rank or more distinguished than another) (b:ulian) (q:draft)
Ulla = (i:1) (t:name) (c:male) (w:Ulla) (d:man of the tribe of Asher, father of Arah, Hanniel and Rizia) (q:draft)
um = (i:1) (t:v) (w:believe/have faith in/trust) (d:accept something as true, or put faith and trust in God, a person or a word; the form <up> is used before a suffix) (s:muang/taksang) (a:muanglah/muanlah) (r:41.11.22) (q:draft)
umcih = (i:1) (t:v) (w:besiege/surround) (d:close in on a person or place from all sides: surround someone, or besiege a city in war; also the siege itself, as in {galte’ umcih}) (s:uumcip/uum) (q:draft)
umcihin = (i:1) (t:v) (w:surrounding/besieging) (d:<umcih>, surround, with the linking ending <in>: surrounding or besieging, followed by a further action) (b:umcih) (r:6.10.31) (q:draft)
umcihna = (i:1) (t:n) (w:siege/siege works) (d:<umcih>, besiege, with the noun suffix <na>: the act of surrounding a city, or the works built for it) (s:kiumcihna) (b:umcih) (q:draft)
umcihte = (i:1) (t:n) (w:besiegers) (d:<umcih> besiege with plural <te>: those who besiege) (b:umcih) (q:draft)
umcip = (t:see) <ki-umcip>
umgah = (i:1) (t:n) (c:plant) (w:gourd) (d:<um>, gourd, with <gah>, fruit: the fruit of a gourd plant; {umgah lim} is a carved figure of a gourd) (q:draft)
umgui = (i:1) (t:n) (c:plant) (w:gourd vine/gourd plant) (d:climbing plant that bears gourds, from <um> gourd and <gui> vine; the plant that shaded Jonah) (q:draft)
umin = (i:1) (t:v) (w:believing/trusting) (d:<um> with the linking ending <in>, followed by another verb: believing, believed and) (s:muanin) (b:um) (q:draft)
umkha = (i:1) (t:v) (w:believe/be taken in) (d:<um>, believe, with <kha>, happen to: come to believe, be taken in; {umkha kei in} is do not believe it) (q:draft)
umkhawmin = (i:1) (t:v) (w:share/eat together) (d:with <ankuang> dish: sharing a dish, feasting together with someone) (q:draft, low confidence)
umkhialsak = (i:1) (t:v) (w:deceive/mislead) (d:<um> believe with <khial> wrongly and causative <sak>: make someone believe what is false) (s:khem/khialsak/pialsak) (q:draft)
Umlah = (i:1) (t:name) (w:Umlah)
umlebeel = (i:1) (t:n) (w:articles/vessels/utensils/containers) (d:<um> gourd, <le> and, <beel> pot: household vessels and containers in general; in the verses the articles of the temple and storage vats) (s:beellekuang) (q:draft)
umlebeelte = (i:1) (t:n) (w:articles/vessels/utensils) (d:plural of <umlebeel>, pots and containers of all kinds; in the verses the articles used in the temple) (s:beellekuangte/kuanglekeute/beelte) (b:umlebeel) (r:15.7.19) (q:draft)
umlote = (t:see) <thu-umlote>
Ummah = (i:1) (t:name) (c:city) (w:Ummah) (d:town in the territory of the tribe of Asher) (r:6.19.30)
ummawh = (i:1) (t:v) (w:suspect/sense/surmise) (d:think that something is so without knowing it for certain; {bangmah a ummawh lo mite}, people who suspect nothing) (s:upmawh) (q:draft)
ummawhin = (i:1) (t:v) (w:hoping/supposing/expecting) (d:<ummawh> suspect, surmise, with the linking ending <in>: thinking that something may happen) (s:lamenin) (b:ummawh) (q:draft)
umna = (i:1) (t:n) (w:enclosure/enclosing wall/surrounding wall) (d:<um> enclose with <na>: what surrounds a place; {khua umna kulh}, the wall enclosing a town) (q:draft)
umpihte = (i:1) (t:n) (w:table companions) (d:in {na ankuang umpihte}, those who share your dish, who eat with you; <pih> together with, plural <te>; the sense of <um> here is not confirmed) (q:draft, low confidence)
umsak = (i:1) (t:v) (w:persuade/convince/make believe) (d:<um>, believe, with the causative <sak>: make someone believe something, persuade or convince) (s:zol) (b:um) (q:draft)
umsakzo = (i:1) (t:v) (w:be able to convince/can persuade) (d:<umsak> make believe, with <zo> be able) (b:umsak) (q:draft)
umta = (i:1) (t:v) (w:believe now/have come to believe) (d:<um> believe with <ta>, marking a state now reached) (b:um) (q:draft)
umte = (i:1) (t:n) (w:believers/those who believe) (d:<um>, believe, with the plural <te>: those who believe; {thu umte} is the usual word for believers) (a:thu-umlote/lawkite) (b:um) (q:draft)
umzaw = (i:1) (t:v) (w:believe more/trust rather) (d:<um> believe with <zaw> more: believe one more than another) (b:um) (q:draft)
umzo = (i:1) (t:v) (w:be able to believe) (d:<um> believe with <zo>, be able; {umzo taktak lo} is could not really believe, doubted) (s:uptheih/upzawh) (b:um) (q:draft)
un = (i:1) (t:ppm) (d:postpositional marker to indicate nominative case) (r:19.128.4)
un = (i:2) (t:v) (w:let) (d:word that closes a command or wish addressed to more than one person)
unah = (t:see) <man-unah>
unau = (i:1) (t:n) (w:brothers/siblings/brothers and sisters) (d:older and younger siblings of one family taken together, from <u>, elder, and <nau>, younger; {unau numei} is sisters) (s:sanggam/ulenau) (r:26.23.2) (q:draft)
Unau = (i:1) (t:n) (w:siblings) (d:<unau>, siblings, capitalised in {Unau Peeng}, twin siblings, the Twin, the byname of Thomas that the NIV gives as Didymus) (b:unau) (r:43.21.2) (q:draft)
unaute = (i:1) (t:n) (w:brothers/siblings/brothers and sisters) (d:plural of <unau>; also used for fellow believers and fellow countrymen) (s:sanggamte/ulenaute) (b:unau) (r:44.14.2) (q:draft)
ung = (i:1) (t:part) (w:we) (d:verb-final marker for a first person plural subject that excludes the hearer, as in {hi ung}, we are; {le ung} is if we) (q:draft)
unla = (i:1) (t:ppm) (d:postpositional marker to indicate nominative case) (r:65.1.22)
Unni = (i:1) (t:name) (c:male) (w:Unni) (d:name of two Levites, a musician in the time of David and one who returned from exile with Zerubbabel) (r:16.12.9/13.15.20)
Unno = (i:1) (t:name) (c:male) (w:Unni) (d:Levite who returned from exile with Zerubbabel; the NIV spells the name Unni) (r:16.12.9)
unok = (i:1) (t:n) (c:plant) (w:lily) (d:lily; {unok pak} or <paak> is the lily flower) (q:draft)
unu = (i:1) (t:n) (w:older sister/elder sister) (d:<u>, elder sibling, with <nu>, which marks a woman: an older sister) (a:naunu) (q:draft)
up = (i:1) (t:v) (w:believe/trust) (d:form of <um>, believe, used before a suffix or another word such as <nading>, <loh> or <beh>; also think or suppose; {a up loh manun} is because of their unbelief) (s:muan) (r:58.3.19) (q:draft)
Upa = (i:1) (t:adj) (w:firstborn/elder) (d:<upa>, elder, capitalised in {ta Upa}, the firstborn child, said of the Son) (b:upa) (q:draft)
upadi = (i:1) (t:n) (w:law/statute/legal code) (d:law of a state or ruler, a word taken from Burmese; in the verses the law of the Medes and Persians and matters of law) (s:thukham) (q:draft)
upapen = (i:1) (t:adj) (w:eldest/oldest/firstborn) (d:<upa> elder with <pen> most: the oldest of the brothers or sons) (s:upen) (a:neupen) (b:upa) (q:draft)
upapente = (i:1) (t:n) (w:firstborn/eldest sons) (d:<upapen>, eldest, with the plural <te>: in {tapa upapente}, firstborn sons) (s:cilte) (b:upapen) (q:draft)
upate = (i:1) (t:n) (w:elders) (d:plural of <upa>: the elders of a people, a town or a church) (b:upa) (q:draft)
upen = (i:1) (t:adj) (w:oldest/eldest) (d:<u>, older sibling, with <pen>, most: the oldest of the brothers and sisters) (s:upapen) (a:neupen) (q:draft)
Uphaz = (i:1) (t:name) (c:city) (w:Uphaz) (d:place from which gold was brought, its location unknown) (r:24.10.9)
uphuai = (i:1) (t:adj) (w:trustworthy/worthy of belief/credible) (d:<up>, believe, with <huai>, worthy of: deserving to be believed) (s:muanhuai/muantaak) (q:draft)
uphuaina = (i:1) (t:n) (w:assurance/confidence/certainty) (d:<uphuai> trustworthy with the noun suffix <na>; {uphuaina tawh ci} is say with assurance, assert) (s:telcianna) (b:uphuai) (q:draft, low confidence)
upin = (i:1) (t:v) (w:trust/believe) (d:<up> believe with the suffix <in>; {thu upin nei} is hold what someone says as trustworthy, put trust in) (s:muanin) (b:up) (q:draft)
Upkhialh = (i:1) (t:n) (w:wrong belief/doubt) (d:<up>, believe, with <khialh>, err; {upkhialh lungsim} is apparently a doubting or mistaken mind) (q:draft, low confidence)
upkhialhna = (i:1) (t:n) (w:doubt/unbelief/wavering) (d:<up>, believe, with <khialh>, go wrong, and the noun suffix <na>: doubt, wavering or lack of faith) (s:uplahna) (a:upna) (q:draft)
uplahna = (i:1) (t:n) (w:doubt/unbelief) (d:the state of doubting or not believing, the opposite of <upna> faith; {uplahna lungsim} is an unbelieving heart) (s:upkhialhna) (a:upna) (q:draft)
uploh = (i:1) (t:v) (w:not believe/disbelieve/not expect) (d:<up>, the form of <um> believe used before a suffix, with <loh> not: not believing, unbelief; {a uploh manin} is because they did not believe, and {uploh hun} is a time that is not expected) (q:draft)
upmanin = (i:1) (t:adv) (w:because of believing/through faith) (d:<up> believe with <man>, reason, and <in>: because one believes) (q:draft)
upmawh = (i:1) (t:v) (w:suppose/expect/suspect/think) (d:believe something to be so without being sure) (s:ummawh) (q:draft)
upmawhna = (i:1) (t:n) (w:suspicion/jealousy) (d:suspicion of wrongdoing, in the verses a husband's jealous suspicion of his wife) (b:upmawh) (q:draft)
upmawhnate = (t:see) <ki-upmawhnate>
upmawhzah = (i:1) (t:n) (w:as much as expected/amount supposed) (d:<upmawh> suppose or expect with <zah>, amount; {na upmawhzah sangun} is than you expected) (q:draft, low confidence)
upna = (i:1) (t:n) (w:faith/belief) (d:<up>, believe, with the noun suffix <na>: faith or belief, trust in God; {upna tawh} is by faith) (a:uplahna/upkhialhna) (b:up) (r:58.11.2) (q:draft)
upnate = (i:1) (t:n) (w:beliefs/faith) (d:<upna> belief with the plural <te>; {a thu upnate uh} is the things they believe, their faith) (b:upna) (q:draft)
upnop = (i:1) (t:v) (w:be willing to believe/be willing to accept) (d:<up> believe with <nop>, be willing) (q:draft)
uppa = (i:1) (t:n) (w:the one believed/the one trusted) (d:<up> believe with <pa>, male person: he in whom one believes) (s:muanpa) (b:up) (q:draft)
uppih = (i:1) (t:v) (w:believe together with/share faith with) (d:<up> believe with <pih> together with; {thu uppih mi}, fellow believer) (b:up) (q:draft)
upsa = (i:1) (t:v) (w:believed/convinced of) (d:<up> believe with <sa> already: what one has come to believe) (b:up) (q:draft)
uptheih = (i:1) (t:v) (w:be able to believe/can believe/may believe) (d:<up> believe with <theih> can; mostly as {uptheih nading}, so that someone may believe) (s:umzo/upzawh) (b:up) (r:44.15.7) (q:draft)
upzawh = (i:1) (t:v) (w:be able to believe/come to believe) (d:<up> believe with <zawh>, form of <zo> be able, used before <nading>) (s:uptheih/umzo) (q:draft)
Ur = (i:1) (t:name) (c:city) (w:Ur) (d:city of the Chaldeans in Mesopotamia, the home of Abram before he set out for Canaan) (r:1.11.28) (q:draft)
Ur = (i:2) (t:name) (c:male) (w:Ur) (d:father of Eliphal, one of David's warriors) (r:13.11.35) (q:draft)
Urbanas = (i:1) (t:name) (c:male) (w:Urbanus) (d:Christian in Rome whom Paul greets as a fellow worker in Christ) (r:45.16.9)
Uri = (i:1) (t:name) (c:male) (w:Uri) (d:name of several men, among them the son of Hur and father of Bezalel, of the tribe of Judah) (r:13.2.20) (q:draft)
Uriah = (i:1) (t:name) (c:male) (w:Uriah) (d:Hittite, one of the mighty warriors of David and husband of Bathsheba, whom David had killed in battle; also the name of other men) (r:10.23.39/13.11.41)
Uriel = (i:1) (t:name) (c:male) (w:Uriel) (d:name of two men, a leader of the Kohathite Levites in the time of David and a man of Gibeah, grandfather of King Abijah) (r:13.15.5/14.13.2) (q:draft)
Urijah = (i:1) (t:name) (c:male) (w:Uriah) (d:priest in Jerusalem who built an altar for King Ahaz after the pattern of the one in Damascus) (r:12.16.16/12.16.10)
Urim = (i:1) (t:name) (c:male) (w:Urim) (d:sacred object kept with the Thummim in the breastpiece of the high priest and used to ask the will of God) (r:3.8.8/9.28.6)
ut = (i:1) (t:n) (w:desire) (s:utna/deihna/lunggulhna)
ut = (i:2) (t:n) (w:wish) (s:utna/deihna)
ut = (i:3) (t:n) (w:want)
utbang = (i:1) (t:n) (w:own wish/own way/what one wants) (d:<ut>, want, with <bang>, as: what a person wants, his own way; {a utbang peuhin gamta} is he does just as he pleases) (s:utthu) (q:draft)
utbangin = (i:1) (t:adv) (w:as one wishes/as one likes) (d:<utbang>, what one wants, with the ending <in>: according to one's own wish) (s:ututin/thuthu-in) (b:utbang) (q:draft)
ute = (i:1) (t:n) (w:elder siblings/elder brothers/brothers) (d:<u>, elder sibling, with the plural <te>; <ute naute>, older and younger siblings, is the usual way of addressing fellow believers as brothers and sisters) (r:58.13.1) (q:draft)
Uthai = (i:1) (t:name) (c:male) (w:Uthai) (d:name of two men: a descendant of Judah who lived in Jerusalem after the exile, and a descendant of Bigvai who returned with Ezra) (r:13.9.4/15.8.14)
utin = (i:1) (t:v) (w:to desire) (d:<ut>, want, with the linking ending <in>; mostly doubled as {ut utin}, as one pleases, freely) (b:ut)
utluatna = (i:1) (t:n) (w:lust/excessive desire) (d:<ut>, desire, with <luat>, too much, and the noun suffix <na>: desire that goes too far, lust) (s:duhluatna/deihgawhna) (q:draft)
utna = (i:1) (t:n) (w:willingness/desire/wish) (d:<ut>, want, with the noun suffix <na>: willingness or wish; {utna tawh} means willingly, of one's own free will, and {utna lungsim} is a willing mind) (s:deihna) (b:ut) (q:draft)
utok = (i:1) (t:n) (w:lobe of the liver) (d:the lobe attached to the liver of a sacrificed animal, in {a sin tunga a utok}) (q:draft)
utong = (i:1) (t:n) (c:animal) (w:peacock) (d:bird brought by the ships of Tarshish with gold, silver, ivory and apes; the NIV has baboons here, older English versions peacocks) (q:draft, low confidence)
utongte = (i:1) (t:n) (c:animal) (w:peacocks) (d:animals brought by the ships of Tarshish together with apes; the NIV has baboons at this place) (b:utong) (q:draft)
utpi = (i:1) (t:n) (w:great desire/chief wish) (d:<ut> desire with <pi>, great or chief: what one wants most) (b:ut) (q:draft)
utsak = (i:1) (t:v) (w:make willing/prompt/move) (d:<ut> desire with the causative <sak>: cause to want, said of the heart) (b:ut) (q:draft)
uttawmna = (i:1) (t:n) (w:free will/own choice/willingness) (d:<ut> want with <tawm>, of oneself, and the noun suffix <na>: what one wants of one's own accord, not forced) (s:utthu) (q:draft)
utte = (i:1) (t:n) (w:those who want/those who love) (d:with <a> before it: people who are willing or who like to do something) (s:deihte/nuamte) (b:ut) (q:draft)
utthu = (i:1) (t:n) (w:own will/free will/own accord) (d:what one oneself wishes; {utthu-a biakpiakna} is a freewill offering) (s:uttawmna) (r:30.4.5) (q:draft)
utun = (i:1) (t:adv) (w:as they please) (d:in {a ut utun}, however they wish: <ut> want, said twice, with <un>, the plural form of the linking ending <in>) (s:ututun) (b:ut) (q:draft)
utut = (i:1) (t:adv) (w:whatever one wants/as one pleases) (d:<ut> want, doubled: {ka utut} is whatever I wish) (q:draft, low confidence)
ututin = (i:1) (t:adv) (w:as one pleases/freely/at will) (d:doing whatever one wants, without restraint or hindrance) (s:ututun/thuthu-in) (b:utut) (q:draft)
ututna = (t:see) <ututna-ah>
ututna-ah = (i:1) (t:adv) (w:wherever one wishes/where one likes) (d:<ut> wish doubled, with the noun suffix <na> and <ah>, at: in whatever place one chooses) (q:draft, low confidence)
ututun = (i:1) (t:adv) (w:as one pleases/at will/freely) (d:{a ututun} is just as they wish, said of more than one person) (s:ututin/thuthu-in) (b:utut) (q:draft)
utzaw = (i:1) (t:v) (w:prefer/would rather/want more) (d:<ut>, want, with <zaw>, more: want one thing more than another) (s:deihzaw/nuamzaw/teelzaw) (b:ut) (q:draft)
uuk = (i:1) (t:v) (w:be keen on/be devoted to/delight in/love) (d:be eager for or given over to something; {uuk delh}, pursue eagerly, hunt down) (a:cimtak) (q:draft, low confidence)
uuklua = (i:1) (t:v) (w:be too devoted to/be too keen on) (d:<uuk> be devoted to with <lua>, too much) (b:uuk) (q:draft)
uukna = (i:1) (t:n) (w:love of/devotion/passion) (d:<uuk> be keen on with the noun suffix <na>; {gualnop uukna} is love of pleasure) (b:uuk) (q:draft)
uuksak = (i:1) (t:v) (w:win over/make keen) (d:<uuk> be devoted to with the causative <sak>: cause people to take to something, said after <zol> persuade) (b:uuk) (q:draft, low confidence)
uum = (i:1) (t:v) (w:surround/encircle/crowd around/fence in) (d:be all around a person or place, or put a wall or fence around it; {ki-uum} is walled, enclosed) (s:umcih/kiimkot) (q:draft)
uumcip = (i:1) (t:v) (w:surround/besiege/hem in) (d:<uum> surround with <cip> tightly: close in on all sides) (s:umcih) (b:uum) (q:draft)
uumin = (i:1) (t:v) (w:surrounding/standing around) (d:<uum> surround with the linking ending <in>; {ki-uumin}, with <kulh> wall, is being walled around, fortified) (b:uum) (q:draft)
uun = (t:see) <aw-uun>
Uz = (i:1) (t:name) (c:male) (w:Uz) (d:name of three men: the firstborn son of Nahor, a son of Aram, and a son of Dishan the Horite) (r:1.10.23) (q:draft)
Uz = (i:2) (t:name) (c:land) (w:Uz) (d:land where Job lived, east of Israel and linked with Edom) (q:draft)
Uzai = (i:1) (t:name) (c:male) (w:Uzai) (d:father of Palal, who helped repair the wall of Jerusalem) (q:draft)
Uzal = (i:1) (t:name) (c:male) (w:Uzal) (d:son of Joktan, a descendant of Shem) (r:1.10.27)
uzaw = (i:1) (t:adj) (w:older/elder) (d:older of two, or older than another person, the opposite is <nauzaw>) (s:upa) (a:khangnozaw) (r:1.25.23) (q:draft)
Uzmite = (i:1) (t:name) (c:people) (w:Uz) (d:the people of the land of Uz, named together with Edom) (b:Uz) (r:25.4.21)
uzza = (t:see) <Perez-uzza>
Uzza = (i:1) (t:name) (c:male) (w:Uzzah/Uzza) (d:name of several men, among them the son of Abinadab who died when he touched the ark, a Merarite Levite and the head of a family of temple servants) (r:15.2.49) (q:draft)
uzzah = (t:see) <Perez-uzzah>
Uzzah = (i:1) (t:name) (c:male) (w:Uzzah) (d:son of Abinadab who drove the cart carrying the ark and died when he took hold of it) (r:10.6.3/10.6.6)
Uzzenerah = (i:1) (t:name) (c:city) (w:Uzzen Sheerah) (d:town built by Sheerah, a daughter of the family of Ephraim) (r:13.7.24)
Uzzensheerah = (i:1) (t:name) (c:city) (w:Uzzen Sheerah) (d:town built by Sheerah, a daughter of the family of Ephraim) (r:13.7.24)
Uzzi = (i:1) (t:name) (c:male) (w:Uzzi) (d:name of several men, among them a priest, son of Bukki and descendant of Aaron, and an overseer of the Levites in Jerusalem) (r:13.6.5/15.7.4)
Uzzia = (i:1) (t:name) (c:male) (w:Uzzia) (d:the Ashterathite, one of the mighty warriors of David) (q:draft)
Uzziah = (i:1) (t:name) (c:male) (w:Uzziah) (d:king of Judah, son of Amaziah and father of Jotham, also called Azariah; also the name of several other men) (r:40.1.9/40.1.8)
Uzziel = (i:1) (t:name) (c:male) (w:Uzziel) (d:name of several men, among them a son of Kohath and grandson of Levi, uncle of Moses and Aaron) (r:2.6.22)
va = (i:1) (t:part) (w:go and) (d:placed before a verb to show that the doer goes to another place to do the action: {va pai} is go there, {va dong} is go and ask) (r:7.11.5) (q:draft)
va = (i:2) (t:n) (c:animal) (w:bird) (d:first part of bird names such as <va-ak> raven) (q:draft, low confidence)
va-aknote = (i:1) (t:n) (c:animal) (w:young ravens) (d:<va-ak> raven with <no>, young, and the plural <te>) (q:draft)
va-akte = (i:1) (t:n) (c:animal) (w:ravens/crows) (d:<va-ak>, raven, with the plural <te>) (q:draft)
vaak = (i:1) (t:v) (w:feed/nourish/provide for/support) (d:give food and care to someone, supply what a person needs to live; also written <vak>) (s:nesak) (q:draft)
vaak = (i:2) (t:v) (w:light/shine/be bright) (d:light a lamp, or be full of light) (q:draft, low confidence)
vaakin = (i:1) (t:v) (w:serving/providing for) (d:<vaak> feed, provide for, serve, with the suffix <in>) (b:vaak) (q:draft)
vaakna = (i:1) (t:n) (w:feeding/provision of food/sustenance) (d:<vaak>, feed, with the noun suffix <na>: the act of feeding or supplying someone with food; {vaakna ngah} is to be fed, to be filled) (s:vakna) (b:vaak) (q:draft)
vaakpa = (i:1) (t:n) (w:feeder/provider) (d:<vaak> feed with <pa>, male person: the one who feeds) (s:vakpa) (b:vaak) (q:draft)
vaaksak = (i:1) (t:v) (w:light up/give light to/make bright) (d:<vaak>, be bright, with the causative <sak>: turn darkness into light, give light to the eyes) (s:khuavaksak/tangsak) (a:mialsak) (b:vaak) (q:draft)
vaan = (i:1) (t:v) (w:explore/spy out/survey) (d:go through a land and look it over, as the men sent into Canaan did: {gam vaan}) (s:ensim/kansim/thukansim) (q:draft)
vaan = (i:2) (t:v) (w:have charge of/oversee/supervise/take care of) (d:keep watch over things or work entrusted to one) (q:draft)
vaang = (i:1) (t:n) (w:might/power/strength) (d:written with a long vowel; the same word as <vang>, power) (s:vang/vangliatna/thahatna) (a:thanemna) (q:draft)
vaanin = (i:1) (t:v) (w:waving/swinging/motioning) (d:move the hand or a tool held in it through the air, with the linking ending <in>; also written <vanin>) (s:vanin) (q:draft)
vaanin = (i:2) (t:v) (w:having charge of/taking care of) (d:<vaan> have charge of, with the linking ending <in>) (b:vaan) (q:draft)
vaanna = (i:1) (t:n) (w:exploring/spying out) (d:<vaan> explore with the noun suffix <na>; {gam vaanna} is the exploring of the land) (b:vaan) (q:draft)
vaanpa = (i:1) (t:n) (w:overseer/officer in charge) (d:<vaan> oversee, have charge of, with <pa>, male person: the man in charge) (b:vaan) (q:draft)
vaansa = (i:1) (t:v) (w:explored) (d:<vaan> explore with <sa> already: {amau’ vaansa gam} is the land they had explored) (b:vaan) (q:draft)
vaante = (i:1) (t:n) (w:supervisors/overseers) (d:<vaan> have charge of, with plural <te>: those who oversee work) (s:mapite) (b:vaan) (q:draft)
vaante = (i:2) (t:n) (w:explorers/spies) (d:<vaan> explore, with plural <te>: those who went to look over the land) (s:kansimte/thukante) (b:vaan) (q:draft)
vah = (i:1) (t:v) (w:be full/be satisfied) (d:have eaten enough, usually with <gil> stomach: {gil vah}; {vah sak} is satisfy, feed until full) (s:gilvah) (a:kial/gilkial) (r:29.2.26) (q:draft)
vahsak = (i:1) (t:v) (w:satisfy/fill) (d:<vah> be full with <sak> cause: satisfy hunger) (b:vah) (q:draft)
vahui = (i:1) (t:n) (c:animal) (w:dove) (s:vakhu) (q:draft)
vahuite = (i:1) (t:n) (c:animal) (w:doves) (s:vakhute) (b:vahui) (q:draft)
vai = (i:1) (t:n) (w:width/breadth) (d:the measure of a thing from side to side, paired with <dung>, length) (s:vailam/zaina/zailam) (a:dung/dunglam/sauna) (q:draft)
vai = (i:2) (t:n) (w:affair/matter/cause/business) (d:what concerns a person or what he has to deal with; {leitung vai} is the affairs of this world, and {vai huh} is uphold the cause of someone) (q:draft)
vaiciah = (i:1) (t:v) (w:return home/come back from work) (d:said of the son coming back to the house from the field; exact force of <vai> not confirmed) (q:draft, low confidence)
vaihawm = (i:1) (t:v) (w:manage/see to) (d:look after a matter or the needs of a household, see to it oneself) (s:sai)
vaihawm = (i:2) (t:v) (w:organize/arrange/plan) (d:think out and settle what is to be done, alone or together with others; also plan something against someone) (s:geel/ngim)
vaihawmin = (i:1) (t:v) (w:planning/devising/plotting/arranging) (d:<vaihawm>, plan or arrange, with the linking ending <in>; with <siatna> or <gitlohna>, plotting evil) (s:geelin) (b:vaihawm) (q:draft)
vaihawmkhol = (i:1) (t:v) (w:arrange beforehand/provide in advance) (d:<vaihawm> arrange with <khol>, beforehand) (q:draft)
vaihawmna = (i:1) (t:n) (w:council/counsel/plan/plot) (d:a deliberating together or what is decided by it; also the body that meets, the council) (s:geelna/ngimna) (b:vaihawm) (r:44.4.15) (q:draft)
vaihawmnate = (i:1) (t:n) (w:plans/counsels/schemes) (d:<vaihawmna>, plan or counsel, with the plural <te>) (s:geelnate/ngimnate) (b:vaihawmna) (q:draft)
vaihawmpa = (i:1) (t:n) (w:adviser/planner/plotter) (d:<vaihawm> plan, arrange with <pa>, the man who does it: the one who advised or plotted something) (s:geelpa) (b:vaihawm) (q:draft)
vaihawmpi = (i:1) (t:n) (w:administrator/chief administrator/president) (d:a high official who directs affairs, here set over the {gam ukpi}, the governors) (s:saipa) (b:vaihawm) (q:draft)
vaihawmpipa = (i:1) (t:n) (w:chief official/chamberlain/administrator) (d:<vaihawmpi> chief administrator with <pa>, male person; in Acts 12:20 the trusted official of the king) (b:vaihawmpi) (q:draft)
vaihawmpite = (i:1) (t:n) (w:administrators/presidents) (d:<vaihawmpi>, chief administrator, with the plural <te>) (b:vaihawmpi) (q:draft)
vaihawmsa = (i:1) (t:adj) (w:arranged/assigned/planned) (d:<vaihawm> arrange with <sa> already done: that someone has already arranged or provided for) (s:geelsa/sehsa) (b:vaihawm) (q:draft)
vaihawmsak = (i:1) (t:v) (w:arrange for/make provision for/prepare for) (d:plan or arrange something on behalf of someone; <vaihawm> with <sak>) (b:vaihawm) (r:47.5.5) (q:draft)
vaihawmsakna = (i:1) (t:n) (w:arranging for/providing for) (d:<vaihawmsak> arrange on behalf of someone with the noun suffix <na>) (b:vaihawmsak) (q:draft)
vaihawmsaksate = (i:1) (t:n) (w:those for whom it has been prepared) (d:<vaihawm> arrange with <sak>, for someone, <sa>, already done, and the plural <te>) (q:draft)
vaihawmtawm = (i:1) (t:v) (w:decide for oneself/arrange for oneself) (d:<vaihawm> plan, arrange with <tawm>, by oneself, on one's own) (q:draft)
vaihawmte = (i:1) (t:n) (w:council/councillors) (d:those who deliberate and manage affairs; {upa vaihawmte} is the council of elders, the Sanhedrin) (s:thuvaihawm) (b:vaihawm) (q:draft)
vaihawmzo = (i:1) (t:v) (w:be able to govern/be able to manage) (d:<vaihawm> manage with <zo>, be able) (b:vaihawm) (q:draft)
vaikhak = (i:1) (t:v) (w:command/instruct/give orders/charge) (d:give instructions that are to be carried out) (s:thupia/sawl) (q:draft)
vaikhak = (i:2) (t:n) (w:order/instruction/command) (d:what someone has told another to do; after a possessive with <bangin>: as he instructed) (s:vaikhakna/thupiakna) (q:draft)
vaikhak = (i:3) (t:v) (w:send for/summon/send word) (d:send a message to someone or call someone to come) (s:samsak) (q:draft, low confidence)
vaikhakin = (i:1) (t:v) (w:charging/instructing/sending word) (d:<vaikhak> with <in>, linking to the next verb: giving a charge or sending a word; {kam vaikhakin}, leaving a parting word, saying goodbye) (b:vaikhak) (q:draft)
vaikhakna = (i:1) (t:n) (w:instruction/order/direction) (d:what someone is told or charged to do; {vaikhakna lai}, a letter of instruction) (s:thupiakna) (b:vaikhak) (q:draft)
vaikhaknate = (i:1) (t:n) (w:instructions/orders) (d:<vaikhakna> instruction with the plural <te>) (s:thupiaknate) (b:vaikhakna) (q:draft)
vaikhakte = (i:1) (t:n) (w:messages/instructions) (d:<vaikhak> instruction with the plural <te>; {a kam vaikhakte} is the things he said to be passed on) (b:vaikhak) (q:draft)
vailam = (i:1) (t:n) (w:width/breadth) (d:the measure across, set against the height or length) (s:vai/zailam/zaina) (a:dunglam) (q:draft)
vaite = (i:1) (t:n) (w:affairs/matters/ways) (d:<vai>, affair, with the plural <te>: the things that concern a person or belong to a way of life) (b:vai) (q:draft)
vaite = (i:2) (t:n) (w:chaff/husks) (d:in {an vaite}, the husks of grain that are winnowed away) (s:anvaite) (q:draft, low confidence)
vaitong = (i:1) (t:n) (w:cubits wide/width in cubits) (d:<vai>, width, written together with <tong>, cubit: the width of something measured in cubits; {a vaitong li} is four cubits wide, beside {a dung tong}, its length in cubits) (q:draft, low confidence)
Vaizatha = (i:1) (t:name) (c:male) (w:Vaizatha) (d:one of the ten sons of Haman, killed by the Jews in Susa) (r:17.9.7)
vak = (i:1) (t:v) (w:light/shine/grow light) (d:become light or give light; {khua vak} is the day grows light, dawn comes, and {mei vak} is to light a lamp) (s:vaak) (a:mit)
vak = (i:2) (t:v) (w:open/see) (d:of the eyes: be opened, be able to see; {mit vak} is the eyes see, and with <sak> it means give sight)
vaka = (i:1) (t:n) (c:animal) (w:partridge) (d:a partridge, a wild bird that is hunted in the hills) (q:draft)
vakang = (i:1) (t:n) (c:animal) (d:a bird in the list of unclean birds, in {gun vakang}, river {vakang}; the NIV has great owl at this place, the exact bird is not confirmed) (q:draft, low confidence)
vakhu = (i:1) (t:n) (c:animal) (w:dove/pigeon) (d:a dove; {kawl vakhu} is a pigeon, and two doves or two young pigeons were brought as an offering) (s:vahui) (r:4.6.10) (q:draft)
vakhuno = (i:1) (t:n) (c:animal) (w:young pigeon/young dove) (d:<vakhu>, dove, with <no>, young: a young dove; in the offerings always {kawl vakhuno}, a young pigeon) (b:vakhu) (q:draft)
vakhute = (i:1) (t:n) (c:animal) (w:doves/pigeons) (d:plural of <vakhu>, dove; {kawl vakhute} are pigeons) (s:vahuite) (b:vakhu) (q:draft)
vakin = (i:1) (t:v) (w:feeding/tending/nourishing) (d:form of <vak>, also written <vaak>, feed, with the linking suffix <in>: giving food to people or animals, often as {an vakin}, feeding with food) (s:nesakin) (q:draft)
vakin = (i:2) (t:v) (w:wandering/roaming/going about) (d:form of <vak>, walk about, with the linking suffix <in>: going about from place to place) (q:draft)
vakin = (i:3) (t:v) (w:lighting/growing light) (d:form of <vak>, light, with the linking suffix <in>: lighting a lamp, or of the day growing light) (s:tawhin) (b:vak) (q:draft, low confidence)
vakkhia = (i:1) (t:v) (w:go out/walk out/wander off) (d:<vak>, walk about, with <khia>, out: go out and walk about outside, or wander away from someone) (s:kuankhia/pusuak) (a:lut) (q:draft)
vakkhiat = (i:1) (t:v) (w:go out/come out/prowl) (d:form of <vakkhia>, go out, used before a noun such as <hun>, time: {a vakkhiat hun} is the time when they come out) (s:kuankhiat) (b:vakkhia) (q:draft)
vakkhiatkik = (i:1) (t:v) (w:walk about outside again/go out again) (d:<vakkhiat>, go out, with <kik>, again: be up and walking about outside again, as after an injury) (b:vakkhiat) (q:draft)
vakkhit = (i:1) (t:v) (w:finish lighting/have lit) (d:<vak>, light, with <khit>, finish: {a vakkhit ciangin} is after he has lit it) (q:draft)
vakmang = (i:1) (t:v) (w:wander off/stray/go astray) (d:<vak>, wander, with <mang>, away, lost: wander off and be lost, as sheep without a shepherd) (s:gammang/zauvak) (q:draft)
vakmawk = (i:1) (t:v) (w:go about idly/roam aimlessly) (d:<vak> go about with <mawk>, idly, for nothing) (q:draft)
vakna = (i:1) (t:n) (w:feeding/provision/relief) (d:noun of <vak>, feed: the giving of food or support; {an vakna} is a meal or provisions, and {misiangthote vakna} the service of supplying the saints) (s:vaakna/anvakna) (r:42.12.36) (q:draft, low confidence)
vakna = (i:2) (t:n) (w:light/lighting) (d:noun of <vak>, give light: the giving of light; {mei vakna} is lighting by a lamp) (b:vak) (q:draft)
vakpa = (i:1) (t:n) (w:sustainer/nourisher/provider) (d:<vak>, also written <vaak>, feed, with <pa>, male person: the one who feeds and provides) (s:vaakpa) (q:draft)
vakpih = (i:1) (t:v) (w:lead about/walk about with) (d:<vak> walk about with <pih>, together with: take someone along while walking about) (q:draft)
vaksa = (t:see) <vaksa-in>
vaksa-in = (i:1) (t:adv) (w:lit/burning) (d:<vak> light with <sa>, already done, and <in>: with the lamp already lit) (q:draft)
vaksak = (i:1) (t:v) (w:be light/give light/light up) (d:<vak>, be light, with the causative <sak>: make light, give light to a place, a lamp or the eyes; {mit vaksak} is to give sight) (a:mialsak) (b:vak)
vaksakkikin = (i:1) (t:v) (w:giving light again/brightening again) (d:<vaksak> give light with <kik>, again, and the suffix <in>; said of the eyes) (q:draft)
vaksakpa = (i:1) (t:n) (w:the one who opened/the one who gave sight) (d:<vaksak> give light with <pa>, male person; with <mit>, the man who made the eyes see) (b:vaksak) (q:draft)
vaksuk = (i:1) (t:v) (w:go about/go to and fro) (d:<vak>, walk, with <suk>, downward; used in the pair {vaksuk vakto}, walk down and up, meaning go here and there through a place) (q:draft)
vakthap = (i:1) (t:v) (w:wander/roam/go about) (d:go about from place to place; in 2 Thessalonians 3:11 of idle people who go about meddling in the affairs of others) (s:kawivak) (a:kibilhcip) (q:draft)
vakto = (i:1) (t:v) (w:go up/go about) (d:<vak>, walk, with <to>, upward; used in the pair {vaksuk vakto}, walk down and up, meaning go to and fro or travel all over a place) (q:draft)
vaktohna = (i:1) (t:n) (w:going up/going about) (d:<vakto>, walk up, in its form <vaktoh> with the noun suffix <na>; used in the pair {na vaksuk na vaktohna}, your going down and going up, all your coming and going) (q:draft)
vakvai = (i:1) (t:n) (w:wanderer) (d:a person with no settled home who goes from place to place)
vakvai = (i:2) (t:n) (w:traveller)
vakvaisak = (i:1) (t:v) (w:make wander/cause to wander) (d:<vakvai>, wander, with the causative <sak>: make someone wander without a path) (s:kawikawisak) (b:vakvai) (q:draft)
vakzau = (t:see) <vakzau-in>
vakzau-in = (i:1) (t:v) (w:roam about/go around freely) (d:<vak> go about with <zau> and the suffix <in>; here of going about with other men, the Zolai text differs from the NIV; force of <zau> not confirmed) (q:draft, low confidence)
vakzaw = (i:1) (t:v) (w:feed rather/nourish instead) (d:<vak>, also written <vaak>, feed, with <zaw>, rather, more) (q:draft)
vakzo = (i:1) (t:v) (w:be able to feed) (d:<vak>, also written <vaak>, feed, with <zo>, be able) (q:draft)
val = (i:1) (t:v) (w:exceed/be more than/be left over) (d:be more than a number or amount, or be left over as a surplus; after a number it means more than, as {sawmli val}, more than forty) (s:vallai) (a:dimlah/kitasam) (q:draft)
valh = (i:1) (t:v) (w:swallow/devour) (d:take food or drink down the throat; also of the earth, fire or an enemy that swallows people up; {valh tum} is swallow whole) (s:valhtum/nawmvalh) (a:luakhia) (r:4.16.32) (q:draft)
valhcip = (i:1) (t:v) (w:swallow up/engulf/hold captive) (d:<valh> swallow with <cip>, tightly, completely: hold fast as if swallowed) (b:valh) (q:draft)
valhtum = (i:1) (t:v) (w:swallow/swallow up/devour) (d:<valh>, swallow, with <tum>, go in: swallow whole, so that nothing is left) (s:valh/nawmvalh/netum) (a:luakhia) (r:23.49.19) (q:draft)
valhtumin = (i:1) (t:v) (w:swallowing/swallowing up/devouring) (d:<valhtum> swallow up with the linking ending <in>) (s:netumin) (b:valhtum) (q:draft)
valin = (i:1) (t:adv) (w:extra/in excess/beyond) (d:<val>, be over, with the adverb ending <in>; {a valin} is more than what is asked or needed) (b:val) (q:draft)
valkhia = (i:1) (t:v) (w:extend beyond/be left over/overhang) (d:<val> exceed with <khia>, out: the part that goes beyond) (b:val) (q:draft)
valkhong = (i:1) (t:adv) (w:for nothing/to no purpose) (d:in {a valkhong a, namsau tawi ahi kei hi}: he does not carry the sword for nothing; the parts of the word are not confirmed) (s:mawk) (q:draft, low confidence)
valkhongsak = (i:1) (t:v) (w:neglect/let go to waste) (d:let something lie unused; with <kei>, do not neglect a gift or an opportunity) (b:valkhong) (q:draft)
vallai = (i:1) (t:v) (w:be left over/remain/exceed) (d:<val>, be over, with <lai>, still: be still left when the rest is used or counted; {a vallai teng} is the rest, what is left) (s:val/omlai) (a:dimlah) (r:23.44.17) (q:draft)
valmawk = (i:1) (t:v) (w:be void/be of no effect) (d:with <sak>, make void, nullify, set aside) (q:draft, low confidence)
valsak = (i:1) (t:v) (w:waste/make void/nullify) (d:with <mawk>, for nothing: let something be left over to no purpose, make it of no effect) (b:val) (q:draft)
valte = (i:1) (t:n) (w:those more than/those over) (d:<val> exceed with the plural <te>; {mi zanga valte} is the more than five hundred people) (b:val) (q:draft)
valteng = (i:1) (t:n) (w:rest/remainder/what is left) (d:<val>, be left over, with <teng>, all of: all that remains after a part is taken) (s:omlaiteng/laiteng) (b:val) (r:3.2.3) (q:draft)
valun = (i:1) (t:v) (w:exceeding/going beyond) (d:<val> exceed with <un>, the suffix <in> for more than one person; {zah valun} is beyond the measure) (b:val) (q:draft)
valzaw = (i:1) (t:v) (w:be more than enough/be in excess) (d:<val> exceed with <zaw>, more) (b:val) (q:draft)
vamimte = (i:1) (t:n) (c:animal) (w:quails) (d:plural form: quails, the birds God sent as food for Israel in the wilderness) (q:draft)
van = (i:1) (t:n) (w:heaven/sky) (d:the sky and heaven above the earth; {van leh lei} is heaven and earth) (s:vantung/vanpi) (a:lei/leitung)
van = (i:2) (t:n) (w:point)
Van = (i:1) (t:n) (w:heaven/sky) (d:<van>, heaven, at the start of a clause; {van nuai} is under heaven) (s:Vantung/vanpi) (a:leitung) (b:van) (q:draft)
vana = (i:1) (t:n) (w:heaven/of the sky) (d:<van>, heaven or sky, with the ending <a>, of or in: of the sky, as in {vana vasate}, the birds of the air, and {vana aksi}, the stars of the sky) (b:van) from heaven
vanah = (i:1) (t:adv) (w:in heaven/in the sky) (d:<van>, heaven or sky, with the place marker <ah>; {vanah vasate} are the birds of the air) (s:vantunga) (a:leitunga) (b:van) (q:draft)
vandaituite = (i:1) (t:n) (w:dew of heaven) (d:<van> heaven with <daitui> dew and the plural <te>) (q:draft)
vandak = (i:1) (t:v) (w:look upward/look up to the sky) (d:<van> sky with <dak>, look up) (s:ento) (q:draft)
vang = (i:1) (t:n) (w:opening/hole/gap) (d:an opening, hole or gap; {kong vang} is a gate or doorway, {han vang} the mouth of a tomb, and {kulh vang} a gap in a wall) (s:kuavang/gong) (q:draft)
vang = (i:2) (t:n) (w:power/might/glory) (d:power or might, and the shining glory of God; {minthanna vang} is glorious splendour, and {a vang lian} means he is powerful) (s:vangliatna/vaang/thahatna) (a:thanemna) (q:draft)
vang = (i:3) (t:v) (w:prosper/succeed) (d:used after <ma> or <maa>, the way ahead: {ma vang} is to go forward well, to succeed in what one does) (s:maavang/mavang) (q:draft)
vangah = (i:1) (t:n) (w:in the hole/at the opening) (d:<vang> opening with <ah>, at or into the opening; {phim vangah} is through the eye of a needle and {han kong vangah} at the mouth of the tomb) (s:gongah) (b:vang) (q:draft)
vangik = (i:1) (t:n) (w:burden/load/weight) (d:a heavy load that is carried; also a person or task that is hard to bear) (r:19.81.6) (q:draft)
vangikpi = (i:1) (t:n) (w:heavy burden/burden/heavy load) (d:<vangik>, burden, with <pi>, great: a heavy burden; with <suan>, lay a heavy burden on someone) (b:vangik) (q:draft)
vangiksak = (i:1) (t:v) (w:burden/weigh down) (d:<vangik>, burden, with the causative <sak>: lay a burden on someone, weigh someone down) (s:gimsak) (b:vangik) (q:draft)
vangikte = (i:1) (t:n) (w:burdens/loads) (d:plural of <vangik>, burden) (b:vangik) (q:draft)
vangin = (i:1) (t:v) (w:thunder/rumble) (d:<van> sky with <gin> sound; written {vangin’na}, with the noun suffix <na>, for thunder) (q:draft, low confidence)
vangin = (i:2) (t:n) (w:might/power) (d:<vang> power with the marker <in>: {vaihawmna le vangin ngaihsun} is to count something as counsel and might) (b:vang) (q:draft, low confidence)
vanging = (i:1) (t:n) (w:thunder) (d:thunder, the loud sound from the sky in a storm; from <van>, sky, and <ging>, sound) (q:draft)
vangingte = (i:1) (t:n) (w:thunders/thunder/peals of thunder) (d:plural of <vanging>, thunder: peals of thunder, often named together with <khuaphialepte>, flashes of lightning) (b:vanging) (q:draft)
vanglian = (i:1) (t:adj) (w:mighty/powerful/almighty) (d:<vang>, power, with <lian>, great: having great power; {a vanglian Topa} is the Lord Almighty) (s:thahat/hat) (a:thanem/zawngkhal)
Vanglian = (i:1) (t:adj) (w:Almighty/Mighty) (d:capitalised as a title of God: <Vanglian Pasian>, God Almighty) (s:Vanglianpen) (b:vanglian) (q:draft)
vanglianin = (i:1) (t:adv) (w:powerfully/mightily/with power) (d:<vanglian>, mighty, with the ending <in>: being mighty, in a mighty way) (b:vanglian) (q:draft)
vanglianpa = (i:1) (t:n) (w:mighty one) (d:<vanglian>, mighty, with <pa>, male person: a mighty man, a warrior or hero) (s:hatpa) (b:vanglian) (r:10.1.25)
Vanglianpa = (i:1) (t:n) (w:Almighty/Mighty One) (d:<vanglianpa> written with a capital, title of God) (b:vanglianpa) (q:draft)
Vanglianpen = (i:1) (t:adj) (w:Almighty/most powerful) (d:title of God, literally the most powerful; {Vanglianpen Topa} renders the Lord Almighty or the Lord of hosts) (s:Vanglian) (b:Vanglian) (q:draft)
vanglianpi = (i:1) (t:n) (w:great power/might/majesty) (d:<vanglian>, mighty, with <pi>, great: {vanglianpi tawh} is with great power; in Hebrews 8:1 the Majesty in heaven) (s:vangpi) (b:vanglian) (q:draft)
vangliante = (i:1) (t:adj) (w:mighty) (d:plural form of <vanglian>, the mighty ones, or after a plural noun as in {kumpi vangliante}, mighty kings) (b:vanglian) (q:draft)
vanglianzaw = (i:1) (t:adj) (w:mightier/stronger/more powerful) (d:<vanglian> mighty with <zaw> more) (s:hatzaw/thahatzaw) (b:vanglian) (q:draft)
vangliat = (i:1) (t:adj) (w:powerful/mighty/glorious) (d:form of <vanglian> used before <zawk>, <nading>, <mahmahna> and the like) (q:draft)
vangliatna = (i:1) (t:n) (w:power/might/strength) (d:<vangliat>, the form of <vanglian>, mighty, with the noun suffix <na>: great power or might, above all the power of God) (s:thahatna/hatna/vang) (a:thanemna) (q:draft)
vangliatna = (i:2) (t:n) (w:glory/majesty) (d:the greatness and splendour of God that is shown to people) (s:minthanna) (q:draft, low confidence)
vangliatnate = (i:1) (t:n) (w:powers/authorities) (d:plural of <vangliatna>, power; beings or forces that hold power, in heaven or on earth) (s:vangneite) (b:vangliatna) (q:draft)
vangliatnate = (i:2) (t:n) (w:miracles/mighty works) (d:plural of <vangliatna>, power: deeds that show the power of God, miracles) (s:nalamdangte) (b:vangliatna) (q:draft)
vangneite = (i:1) (t:n) (w:powers/powerful ones) (d:<vang> power with <nei> have and the plural <te>: those who have power; in Galatians 4:3 of the spiritual powers ruling the air) (s:vangliatnate) (q:draft)
vangneu = (i:1) (t:n) (w:small opening/narrow window) (d:<vang> opening with <neu> small; {khua-etna vangneu} is a narrow window to look out through) (q:draft)
vangneute = (i:1) (t:n) (w:small openings/narrow windows) (d:<vangneu> small opening with the plural <te>) (b:vangneu) (q:draft)
vangpi = (i:1) (t:n) (w:great power/great might) (d:<vang> power with <pi> great) (s:vanglianpi) (b:vang) (q:draft)
vangsak = (i:1) (t:v) (w:make successful/prosper/grant success) (d:used with <ma> or <lampi>, the way ahead: make a journey or undertaking succeed) (s:mavangsak) (b:vang) (q:draft)
vangsung = (i:1) (t:n) (w:inner width/diameter) (d:<vang> opening with <sung>, inside: the measure across the inside of a basin) (q:draft, low confidence)
vangtaang = (i:1) (t:n) (w:glory/splendour/radiance) (d:shining glory, usually after <minthanna>; {a vangtaang} is glorious) (s:minthanna) (q:draft)
vangte = (i:1) (t:n) (w:openings/gaps/breaches) (d:plural of <vang>, opening; {kong vangte} is gates, {tawlet vangte} is windows) (b:vang) (q:draft)
vangtung = (i:1) (t:n) (w:heaven) (d:another spelling of <vantung>, heaven, the dwelling place of God) (s:vantung/van) (a:leitung)
vangtungah = (i:1) (t:n) (w:on heaven/in heaven/in the sky) (d:<vangtung>, heaven, with the place marker <ah>: in the sky, in heaven) (b:vangtung)
vangtungmi = (i:1) (t:n) (w:angel) (d:<vangtung>, heaven, with <mi>, person: an angel, a messenger from heaven; another spelling of <vantungmi>) (s:vantungmi) (b:vangtung) (q:draft)
vangvang = (i:1) (t:adv) (w:bitterly/intensely) (d:placed after a verb to show that the action is done strongly or without letting go; {kap vangvang} is wail bitterly) (q:draft, low confidence)
Vaniah = (i:1) (t:name) (c:male) (w:Vaniah) (d:one of the descendants of Bani who had married a foreign wife in the time of Ezra) (r:15.10.36)
vanin = (i:1) (t:v) (w:waving/motioning/gesturing) (d:move the hand through the air as a sign, with the linking ending <in>; {a khut vanin} is waving or motioning with the hand; also written <vaanin>) (s:vaanin) (q:draft)
vankah = (i:1) (t:n) (w:medium) (d:a person who calls up the spirits of the dead; often as {vankah thei}, one who is able to do this) (s:vankahthei)
vankahna = (i:1) (t:n) (w:divination/spiritism/consulting of mediums) (d:<vankah>, medium, with the noun suffix <na>: the practice of seeking word from the spirits of the dead) (s:aisan) (b:vankah) (q:draft)
vankahte = (i:1) (t:n) (c:animal) (w:gecko)
vankahte = (i:2) (t:n) (w:medium/mediums) (d:<vankah>, medium, with the plural <te>) (s:vankahtheite) (b:vankah)
vankahthei = (i:1) (t:n) (w:medium/spiritist) (d:<vankah>, medium, with <thei>, be able: a person who is able to call up the spirits of the dead) (s:vankah) (b:vankah) (q:draft)
vankahtheite = (i:1) (t:n) (w:mediums/spiritists) (d:<vankahthei>, medium, with the plural <te>) (s:vankahte) (b:vankahthei) (q:draft)
vankemte = (i:1) (t:n) (w:treasurers) (d:<van>, goods, with <kem>, keep, and the plural <te>: the officials who keep the stores and money of a king) (q:draft)
vankhai = (i:1) (t:n) (w:peg/hook) (d:<van>, thing, with <khai>, hang: a peg or hook on which things are hung) (s:khaina) (q:draft)
vankhaina = (i:1) (t:n) (w:peg/hook/hanger) (d:<van>, things, with <khai>, hang, and the noun suffix <na>: a peg or hook to hang things on) (s:khaina) (b:vankhai) (q:draft)
vankhainate = (i:1) (t:n) (w:hooks/clasps) (d:plural of <vankhaina>, a thing on which something is hung or fastened, as the hooks and clasps of the tabernacle) (s:kilhnate) (b:vankhaina) (q:draft)
vankia = (i:1) (t:n) (w:plunder/spoil) (d:goods taken in war; the other text has <vankila> in the same verse, so this may be a misprint of it) (s:vankila) (q:draft, low confidence)
vankiate = (i:1) (t:n) (w:plunder/spoil/loot) (d:goods taken by enemies, set beside {mat ding mi}, people to be captured) (s:vankinusiate/vankisutte) (b:vankia) (q:draft)
vankila = (i:1) (t:n) (w:plunder/spoil) (d:<van>, goods, with <kila>, taken: goods taken in war) (s:vankia) (q:draft)
vankim = (i:1) (t:n) (w:midair/middle of the sky/air) (d:the middle of the sky, the open air above the earth; used with <lai-ah>: {vankim lai-ah} is in midair) (r:6.10.13) (q:draft)
Vankim = (i:1) (t:name) (w:Vankim) (d:<vankim>, the middle of the sky, written with a capital at the start of a sentence) (r:6.10.13)
vankinusia = (i:1) (t:n) (w:spoil/plunder) (d:<van>, goods, with <kinusia>, left behind: goods left by a defeated enemy) (s:vankila) (r:19.119.162) (q:draft)
vankinusiate = (i:1) (t:n) (w:plunder/spoils/loot) (d:goods left behind by a defeated enemy and taken by the victors) (s:vankisutte/vanlakte/kisutte) (b:vankinusia) (q:draft)
vankisutte = (i:1) (t:n) (w:plunder/spoils/loot) (d:<van>, goods, with <kisut>, be plundered, and the plural <te>: goods taken by force) (s:vankinusiate/vanlakte/kisutte) (q:draft)
vankoihna = (i:1) (t:n) (w:storehouse/storeroom/treasury) (d:<van>, goods, with <koihna>, place of keeping: a storehouse or storeroom, often as {vankoihna inn}) (s:sumkoihna/kholna/koihna) (r:12.16.8) (q:draft)
vankoihnate = (i:1) (t:n) (w:storehouses/storerooms/treasuries) (d:<vankoihna>, storehouse, with the plural <te>) (s:sumkoihnate/koihnate) (b:vankoihna) (q:draft)
vankuumpi = (i:1) (t:n) (w:vault of the sky/dome of heaven) (d:<van> sky with <kuum>, arch or vault, and <pi>, great: the sky seen as a great cover over the earth) (q:draft, low confidence)
vanlakte = (i:1) (t:n) (w:plunder/spoils) (d:<van>, goods, with <lak>, taken, and the plural <te>: the things taken in war) (s:vankinusiate/vankisutte) (q:draft)
vanlei = (i:1) (t:v) (w:buy/buy goods) (d:<van>, goods, with <lei>, buy; <vanlei vanzuak> is buying and selling, trade) (s:sumlei) (a:vanzuak) (q:draft)
Vanleipa = (i:1) (t:n) (w:buyer) (d:<van>, goods, with <lei>, buy, and <pa> marking a male person; set against <vanzuakpa>, the seller) (s:leipa) (a:vanzuakpa) (q:draft)
vanleite = (i:1) (t:n) (w:buyers) (d:<vanlei>, buy goods, with the plural <te>: those who buy) (s:leite) (a:zuakte) (b:vanlei) (q:draft)
vanlelei = (i:1) (t:n) (w:sky and earth/heaven and earth) (d:<van>, sky, <le>, and, <lei>, earth, written as one word; {vanlelei kikalah} is between sky and earth, in midair) (q:draft)
vanmanpha = (i:1) (t:n) (w:treasure/valuables/precious things) (d:<van>, goods, with <manpha>, precious; {vanmanpha koihna} is the treasury, the place where valuables are kept) (r:13.26.22) (q:draft)
vanmanphate = (i:1) (t:n) (w:treasures/valuables/precious things) (d:<vanmanpha>, valuable thing, with the plural <te>: the treasures of a temple or a palace) (b:vanmanpha) (q:draft)
vanmite = (i:1) (t:n) (w:heavenly beings/celestial beings/angels) (d:<van>, heaven, with <mi>, person, and plural <te>) (s:vantungmite) (q:draft)
vanmong = (i:1) (t:n) (w:end of the heavens/horizon) (d:<van>, sky, with <mong>, end or edge: the farthest edge of the sky) (q:draft)
vanna = (i:1) (t:n) (w:hole/opening) (d:{kulh a vanna mun} is a place where the wall has a hole; probably related to <vang>, opening) (q:draft, low confidence)
vannuai = (t:todo) (q:draft, {mi vannuai khempeuh} stands where the NIV has all the rest of the people; meaning of {vannuai} not clear from one verse)
vannusiatte = (i:1) (t:n) (w:spoils/goods left behind) (d:<van> goods with <nusiat>, leave behind, and the plural <te>: what a defeated king left) (s:vankinusiate) (q:draft)
vanpi = (i:1) (t:n) (w:heavens/sky) (d:<van>, sky, with <pi>, great: the great expanse of the sky, the heavens; paired with <leipi>, the earth) (s:vantung) (a:leipi) (b:van) (q:draft)
vanpite = (i:1) (t:n) (w:heavens/skies) (d:<vanpi>, the heavens, with the plural <te>) (s:vantungte/vante) (b:vanpi) (q:draft)
vanpua = (i:1) (t:adj) (w:load-carrying/goods-carrying) (d:<van>, goods, with <pua>, carry; {vanpua leeng} is a wagon and {vanpua mi} a carrier, a porter) (q:draft)
vanpuakte = (i:1) (t:n) (w:cargo/goods carried/baggage) (d:<van>, goods, with <puak>, carry, and the plural <te>: the things a ship or a traveller carries) (q:draft)
vansak = (i:1) (t:v) (w:make successful/prosper) (d:in {maa vansak}, make a journey or undertaking go well; probably <vang> succeed with the causative <sak>) (s:vangsak) (q:draft, low confidence)
vante = (i:1) (t:n) (w:goods/wares/cargo/merchandise) (d:<van>, goods, with the plural <te>: goods for trade, the cargo of a ship) (b:van) (q:draft)
vante = (i:2) (t:n) (w:heavens/skies) (d:<van>, heaven, with the plural <te>) (s:vantungte/vanpite) (b:van) (q:draft)
vantumgmi = (i:1) (t:n) (w:angel) (d:apparently a misprint of <vantungmi>, angel) (s:vantungmi) (q:draft)
vantung = (i:1) (t:n) (w:heaven) (d:the dwelling place of God and the angels) (s:van) (a:leitung) the promised land
vantung = (i:2) (t:n) (w:sky) (d:the sky above the earth, where the birds fly and from which the rain falls) (s:vanpi) (r:1.1.20) the upper atmosphere
Vantung = (i:1) (t:n) (w:heaven/sky) (d:<vantung> written with a capital, mostly in {Vantung Gam}, the kingdom of heaven) (b:vantung) (q:draft)
vantunga = (i:1) (t:adv) (w:in heaven) (d:<vantung>, heaven, with the place ending <a>: in heaven, in the sky; {vantunga om} is that is in heaven) (s:vanah) (a:leitunga) (b:vantung) (r:25.3.41) (q:draft)
vantungah = (i:1) (t:phrase) (w:in heaven/in the sky) (d:<vantung>, heaven, with the place marker <ah>) (a:leitungah) (b:vantung)
Vantungah = (i:1) (t:phrase) (w:in heaven) (d:<Vantung>, heaven, with the place marker <ah>) (b:Vantung) (q:draft)
vantunggam = (i:1) (t:n) (w:heavenly realm/heaven) (d:<vantung> heaven with <gam>, land or kingdom) (q:draft)
vantungmi = (i:1) (t:n) (w:angel) (d:<vantung>, heaven, with <mi>, person: a messenger from heaven, an angel) (s:vangtungmi) (b:vantung) (r:1.22.15) (q:draft)
Vantungmi = (i:1) (t:n) (w:angel) (d:<vantungmi>, angel, written with a capital at the start of a sentence or in a title such as {Mi That Vantungmi}, the destroying angel) (b:vantungmi) (q:draft)
vantungmite = (i:1) (t:n) (w:angels/heavenly beings) (d:<vantungmi>, angel, with the plural <te>: angels, literally people of heaven; also those who belong to heaven) (s:vanmite) (a:leitungmite) (b:vantungmi) (r:42.12.9) (q:draft)
vantungte = (i:1) (t:n) (w:heavens) (s:vanpite/vante) (b:vantung) plural form of <vantung>
vantungte = (i:2) (t:n) (w:skies) (s:vanpite) (b:vantung) plural form of <vantung>
vanvan = (i:1) (t:adv) (w:rushing/pounding) (d:placed after a verb for hurried, restless or rushing movement: rushing, pounding) (q:draft, low confidence)
vanvan = (i:2) (t:v) (w:stretch out/spread out) (d:doubled form of <van>, stretch out the hands, again and again) (q:draft, low confidence)
vanzatte = (i:1) (t:n) (w:equipment/gear/tackle) (d:<van>, goods, with <zat>, use, and the plural <te>: things in use; {teembaw vanzatte} is the tackle of a ship) (s:nazatte) (q:draft)
vanzuak = (i:1) (t:v) (w:sell goods/trade) (d:<van>, goods, with <zuak>, sell; {sumzuak vanzuak} is selling and trading) (s:sumzuak) (a:vanlei) (q:draft)
vanzuakin = (i:1) (t:v) (w:selling/trading) (d:<vanzuak> sell goods with the suffix <in>) (b:vanzuak) (q:draft)
vanzuakna = (i:1) (t:n) (w:market/selling of goods) (d:<vanzuak>, sell goods, with the noun suffix <na>; {vanzuakna phual} is a marketplace) (s:sumbuk) (b:vanzuak) (q:draft)
vanzuakpa = (i:1) (t:n) (w:seller) (d:<vanzuak>, sell goods, with <pa>, marking a man: the seller, set against <Vanleipa>, the buyer) (s:zuakpa) (a:Vanleipa/leipa) (b:vanzuak) (q:draft)
vapai = (i:1) (t:v) (w:go/go there) (d:<pai> go with <va> before it, marking movement away to another place) (q:draft)
vapi = (i:1) (t:n) (c:animal) (w:stork) (d:<va> bird with <pi> big: large bird; in the verses always {gun vapi}, river big bird, for the stork) (b:va) (r:5.14.18) (q:draft)
vapite = (i:1) (t:n) (c:animal) (w:storks/large birds) (d:plural of <vapi>, large bird; {gun vapite} and {tui vapite}, large water birds, are used for the stork and the ibis) (s:gunvapite) (b:vapi) (q:draft)
vasa = (i:1) (t:n) (c:animal) (w:bird) (d:a bird of any kind)
vasabu = (i:1) (t:n) (w:nest/bird's nest) (d:<vasa>, bird, with <bu>, nest)
Vasabu = (i:1) (t:n) (w:nest/bird's nest) (d:<vasabu>, nest, at the start of a sentence) (b:vasabu) (q:draft)
vasam = (i:1) (t:v) (w:go and call/call) (d:<sam> call with <va> before it, marking going over to do it) (q:draft)
vasapi = (t:see) <kalaoh-vasapi>
vasate = (i:1) (t:n) (c:animal) (w:birds) (d:<vasa>, bird, with the plural <te>) (b:vasa) (r:1.1.20)
vasateng = (i:1) (t:n) (c:animal) (w:all the birds/birds) (d:<vasa> bird with <teng>, all of them) (b:vasa) (q:draft)
Vashti = (i:1) (t:name) (c:female) (w:Vashti) (d:queen of Persia, wife of King Xerxes, who lost her place as queen when she refused to come before the king) (r:17.1.9/17.2.4)
vat = (i:1) (t:v) (w:strike/strike down/attack/smite) (d:strike a person or attack a place, of God, a fighter or an army; {namsau tawh vat} is strike with the sword) (s:sat) (r:2.17.13) (q:draft)
vatak = (t:see) <vatak-um>
vatak-um = (i:1) (t:n) (c:plant) (w:wild gourd) (d:a wild plant with a vine, <gui>, and gourds, <umgah>, not fit to eat) (q:draft)
vatawt = (i:1) (t:n) (c:animal) (w:duck/water bird) (d:kind of bird; in the lists of unclean birds {gam vatawt} and {tui vatawt} stand where English has owl, swan, pelican or gull) (r:3.11.18) (q:draft, low confidence, the English bird names differ from verse to verse)
vatgawp = (i:1) (t:v) (w:strike down/smite/defeat) (d:<vat>, strike, with <gawp>, thoroughly: strike down or defeat completely) (s:vatmai) (b:vat) (q:draft)
vatgawpin = (i:1) (t:v) (w:striking down/attacking/defeating) (d:<vatgawp>, strike down, with the linking ending {-in}) (b:vatgawp) (r:6.15.16) (q:draft)
vatin = (i:1) (t:v) (w:striking/attacking/striking down) (d:<vat>, strike, with the linking ending <in>: striking or having struck; often {namsau tawh vatin}, with the sword) (b:vat) (q:draft)
vatin = (i:2) (t:adv) (w:suddenly/all at once) (d:after a verb, of something that comes on abruptly; {khuamial hong suak vatin}, darkness came suddenly) (s:thakhatin) (q:draft, low confidence)
vatkhia = (t:see) <vatkhia-in>
vatkhia-in = (i:1) (t:v) (w:sweeping away/striking off) (d:<vat> strike with <khia>, out, away, and the suffix <in>) (q:draft)
vatlum = (i:1) (t:v) (w:strike dead/kill/slay) (d:strike so that the person dies, often with the sword) (s:thatlum/that) (q:draft)
vatmai = (i:1) (t:v) (w:strike down/smite/cut down/defeat) (d:kill or defeat in great numbers, as with a sword) (s:vatgawp) (q:draft)
vatmaipa = (i:1) (t:n) (w:one who struck down/slayer) (d:<vatmai>, strike down, with <pa>, the male one who does it: a {vatmaipa} is he who struck down) (b:vatmai) (q:draft)
vatmaisak = (i:1) (t:v) (w:strike down/destroy) (d:<vatmai> strike down with <sak>, done to what belongs to someone: cut down all that he has built) (b:vatmai) (q:draft, low confidence)
vatmang = (i:1) (t:v) (w:cut off/strike down/sweep away) (d:<vat> strike with <mang>, away, gone: strike so that the person is no more; of death taking the children from the streets) (q:draft)
vattansak = (i:1) (t:v) (w:strike down/cut down) (d:<vat> strike with <tan> cut off and <sak>: strike vines and trees so that they break off) (q:draft)
vattuk = (i:1) (t:v) (w:strike down/cut down/fell) (d:<vat>, strike, with <tuk>, fall: strike so that the person falls) (q:draft)
vattum = (i:1) (t:v) (w:cut down/slay) (d:<vat> strike with <tum>, completely; said of the sword) (q:draft)
vawh = (i:1) (t:v) (w:call/title/name) (d:give a name, with <min>, name: {min vawh} is to name a person, an animal or a place) (s:phuak)
vawh = (i:2) (t:v) (w:sow) (d:scatter seed on the ground; {khaici vawh} is to sow seed) (s:tuh) (a:at) (r:40.13.24)
vawhin = (i:1) (t:v) (w:saddle/load) (d:form of <vawh> with the linking suffix <in>, putting a saddle or load on a pack animal) (q:draft)
vawhin = (i:2) (t:v) (w:sow/plant) (d:form of <vawh> with the linking suffix <in>, sowing seed) (s:tuhin) (b:vawh) (q:draft)
vawhpa = (i:1) (t:n) (w:sower/farmer) (d:<vawh>, sow, with <pa>, marking a man: the man who sows, in {khaici vawhpa}) (s:khaivawhpa) (b:vawh) (q:draft)
vawhsa = (i:1) (t:adj) (w:sown/planted) (d:<vawh> sow with <sa>, already done; {na vawhsa an} is the crop you have sown) (b:vawh) (q:draft)
vawhsak = (i:1) (t:v) (w:saddle) (d:in {laa van vawhsak}, put the gear on a donkey for someone, saddle it) (q:draft)
vawhsakin = (i:1) (t:v) (w:saddling/having saddled) (d:<vawhsak> saddle for someone with the linking ending <in>) (b:vawhsak) (q:draft)
vawhte = (i:1) (t:n) (w:sowers/those who sow) (d:<vawh>, sow, with the plural <te>: the people who sow seed) (s:tuhte) (a:atte) (b:vawh) (q:draft)
vawhzo = (i:1) (t:v) (w:be able to put through/be able to thread) (d:<vawh>, thread or put a cord through, with <zo>, be able: be able to pass a cord through, as through the nose of an animal; not from <vawh> call or sow) (r:18.41.2) (q:draft, low confidence)
vazonei = (i:1) (t:n) (c:animal) (w:heron) (d:in {gun vazonei}, a river bird in the list of unclean birds) (r:5.14.18) (q:draft)
ve = (i:1) (t:part) (d:sentence-final particle of emphasis or urging; after a command, often as {dih ve}, it presses the hearer to go ahead, and after <hi>, as {hi ve’n}, it stresses a statement) (q:draft, low confidence)
ve'ng = (i:1) (t:part) (d:sentence-final words after <hi> in the speech of one person about himself, here I would surely have given; apparently an emphatic <ve> with a shortened first person ending) (q:draft, low confidence)
veeng = (i:1) (t:n) (w:quarter/neighbourhood) (d:a part of a town or village; {Naioth veeng} is the Naioth quarter of Ramah) (s:veng) (q:draft)
veengah = (i:1) (t:n) (w:in the quarter/in the neighbourhood) (d:<veeng>, a quarter or neighbourhood of a town, with the place marker <ah>, in or to: {Naioth veengah} is in Naioth, a quarter of Ramah; <veeng> is the long-vowel spelling of <veng>) (s:vengah) (b:veeng) (q:draft)
veengte = (i:1) (t:n) (w:neighbors) (d:plural of <veeng>; {inn veengte} is those who live in the houses nearby) (s:vengte/innvengte) (b:veeng) (q:draft)
veh = (i:1) (t:v) (w:visit/look after/care for) (d:go to see someone who is sick or in need and care for them; said also of God coming to help his people) (s:hawh) (q:draft)
veh = (i:2) (t:part) (d:sentence-final word of exclamation that calls attention to something happening now, as in listen, people are crying out) (q:draft, low confidence)
veii = (i:1) (t:v) (w:wave) (d:move an offering to and fro before the Lord; {veii-a biakna} is a wave offering) (r:3.9.21) (q:draft)
veikhoi = (i:1) (t:adj) (w:left-handed) (d:using the left hand rather than the right; said of Ehud and of the slingers of Benjamin) (q:draft)
veilam = (i:1) (t:n) (w:left/left side) (d:the left-hand side; before a noun it means left, as in {veilam khut}, left hand) (a:taklam/ziatlam) (q:draft)
veilama = (i:1) (t:n) (w:on the left/at the left side) (d:<veilam>, left side, with the place ending <a>, at or on: {ka veilama} is on my left) (a:taklama) (b:veilam) (q:draft)
veilamah = (i:1) (t:adv) (w:on the left/to the left) (d:<veilam>, the left side, with the place ending {-ah}; often paired with <taklam>, the right) (a:taklamah/ziatlamah) (r:23.54.3) (q:draft)
veilamin = (i:1) (t:adv) (w:with the left/on the left) (d:<veilam> left side with the suffix <in>; {a khut veilamin} is with his left hand) (a:taklamin) (b:veilam) (q:draft)
veina = (i:1) (t:n) (w:version)
veina = (i:2) (t:n) (w:time) (d:<vei>, time, with <na>: after a number word it gives the order of an occasion, {a nih veina} is the second time) (b:vei)
veina = (i:3) (t:part) (d:particle showing number of times) (b:vei) (r:1.22.15)
veipa = (i:1) (t:n) (w:sufferer/affected person) (d:<vei>, suffer from a disease, with <pa>, the man who does so: the person who has the disease) (q:draft)
veipi = (i:1) (t:adv) (w:a long time/for long) (d:<vei>, time, with the intensive <pi>: after <sau> or <sawt>, long, it means for a very long time) (s:sawtpi) (a:tawlkhat) (b:vei) (q:draft)
veipi = (i:2) (t:adv) (w:many times/often) (d:<vei>, time, with the intensive <pi>: after <tam>, many, it means many times, again and again) (s:tamveipi/tamvei) (a:khatvei) (b:vei) (q:draft)
veisak = (i:1) (t:v) (w:afflict with/make suffer) (d:<vei>, suffer from a sickness, with the causative <sak>: make someone suffer from a disease, as Satan afflicted Job with sores; not from <vei> time) (q:draft)
veite = (i:1) (t:n) (w:the sick/those who suffer) (d:<vei>, suffer from a sickness, with the plural <te>: those who have a disease) (s:cinate/micinate) (q:draft)
veivei = (i:1) (t:adv) (w:sometimes/at times) (d:used after <khat>: {khat veivei}, sometimes, now and then; said twice for sometimes this, sometimes that) (s:khatveivei) (q:draft)
veizaw = (i:1) (t:adv) (w:more times/more often) (d:<vei> time with <zaw>, more; {nihvei sangin a tam veizaw} is more than twice) (b:vei) (q:draft)
vek = (t:see) <vek-a>
vek-a = (i:1) (t:adv) (w:all/altogether) (d:{a vek-a} is all of it, the whole together) (s:vekin/vek-in) (q:draft, low confidence)
vek-in = (i:1) (t:adv) (w:all/entirely/altogether) (d:{a vek-in} follows a list and sums it up: all of them, the whole) (s:vekin/vek-a) (q:draft)
vekin = (i:1) (t:adv) (w:all/altogether/in all) (d:the whole of it, used after <a> or <i>, as in {a vekin} all of it, all of them, {i vekin} all of us) (s:vekpi/vekun/vek-in/vek-a) (r:18.27.14) (q:draft)
vekpite = (i:1) (t:n) (w:all/all the people) (d:<vekpi> all with plural <te>: {ko mi vekpite} is all of us the people) (b:vekpi) (q:draft)
vekpiun = (i:1) (t:adv) (w:all of them/all together) (d:<vekpi> all with <un>, usually written {vekpi-un}) (s:vekun) (b:vekpi) (q:draft)
vekun = (i:1) (t:adv) (w:all/all of them/altogether) (d:used as {a vekun}, all of them together, with a plural subject) (s:vekin/vekpiun) (q:draft)
vel = (i:1) (t:v) (w:examine/inspect/look over) (d:look at something closely to find out its condition, as a priest examines a disease or scouts look over a land) (s:entel/kantel) (q:draft)
velin = (i:1) (t:v) (w:examining/inspecting/looking over) (d:<vel>, examine, with the linking ending <in>, joining it to the next verb) (s:entelin) (b:vel) (r:3.13.53) (q:draft)
velkik = (i:1) (t:v) (w:examine again/re-examine) (d:<vel> examine with <kik>, again) (b:vel) (q:draft)
velval = (i:1) (t:adv) (w:bitterly/severely) (d:follows <na> pain, {na sa} feel pain, {na sak} cause pain or <kha> bitter: with intense, sharp suffering) (q:draft)
velvalna = (i:1) (t:n) (w:anguish/severe pain/writhing) (d:<velval>, bitterly, with the noun suffix <na>; {nat velvalna} is sharp, severe pain) (b:velval) (q:draft, low confidence)
velvalsak = (i:1) (t:v) (w:make sharply bitter/make sour) (d:<velval>, bitterly, severely, with the causative <sak>; {thuk velvalsak} is turn sharply sour, of the stomach) (b:velval) (q:draft, low confidence)
velvel = (i:1) (t:adv) (d:reduplicated adverb placed after a verb; with <phe> it describes hair waving or flowing loosely) (r:22.4.1) (q:draft, low confidence)
ven = (i:1) (t:v) (w:cease/stop/subside/be over) (d:written {ven’} before <ciangin> or <theih>, of a plague or a time of mourning coming to an end) (q:draft)
ven = (i:2) (t:part) (d:sentence-final word after a command with <dih>, urging the hearer to do it) (q:draft, low confidence)
veng = (i:1) (t:v) (w:cease/stop/pass away/depart) (d:of a plague, trouble or season, to come to an end and be gone) (r:4.16.48) (q:draft)
Veng = (i:1) (t:n) (w:Quarter/district) (d:capitalised form of <veng>, a quarter or section of a town, in {Veng Nihna}, the Second or New Quarter of Jerusalem) (b:veng) (q:draft)
vengah = (i:1) (t:n) (w:in the quarter/in the neighbourhood) (d:<veng>, a quarter or neighbourhood of a town, with the place marker <ah>, in or to: {Naioth vengah} is in Naioth, a quarter of Ramah) (s:veengah) (b:veng) (q:draft)
vengin = (i:1) (t:v) (w:being over/having ended) (d:<veng> cease, come to an end, with the suffix <in>; {pawi vengin} is when the feast was over) (b:veng) (q:draft)
vengpa = (i:1) (t:n) (w:neighbour/neighbor) (d:a male neighbour, or a fellow man) (q:draft)
vengte = (i:1) (t:n) (w:neighbors/neighbor) (d:the people living near someone; also used of a single neighbor) (s:veengte/innvengte) (q:draft)
vengvangna = (i:1) (t:n) (w:groaning/moaning) (d:in {kut vengvangna}, the loud groaning of the wounded; the other text has <vengvengna> in the same verse) (s:vengvengna/tauna) (q:draft, low confidence)
vengvengna = (i:1) (t:n) (w:groaning/moaning) (d:in {kut vengvengna}, the loud groaning of the wounded; the other text has <vengvangna> in the same verse) (s:vengvangna/tauna) (q:draft, low confidence)
venvan = (i:1) (t:adv) (w:abundantly/in heaps) (d:after a verb, shows a great amount or degree: piled up, laden, intensely) (q:draft, low confidence)
vet = (i:1) (t:part) (d:emphatic word after a verb: at all, even, just; with <lo> or <kei>, not at all; with <leh>, expresses a wish, if only) (q:draft, low confidence)
veva = (i:1) (t:adv) (d:placed after a verb to show that the action goes on with great force or intensity, as of running fast, glowing hot or the sun beating down) (q:draft, low confidence)
veve = (i:1) (t:adv) (w:still/nevertheless/anyway) (d:all the same, in spite of that; placed after a verb, often following a clause with <hangin>, although) (q:draft)
vevena = (i:1) (t:n) (d:<veve> still, all the same, with the noun suffix <na>: the fact of doing something nevertheless; {amah a phat vevena uh} is that they went on praising him all the same) (b:veve) (q:draft, low confidence)
vevete = (i:1) (t:n) (d:<veve> still, all the same, with plural <te>: those who do so all the same, in {a zuau vevete}, those who lie even after swearing an oath) (b:veve) (q:draft, low confidence)
vial = (i:1) (t:v) (w:bind around/encircle/coil around) (d:put a band or ring around something; of a snake, coil around) (q:draft, low confidence)
vial = (i:2) (t:adv) (d:after a verb of speaking or acting against someone, as <ci> say, <phih> spit or <peek> kick: do it with scorn or insolence; exact force not confirmed) (r:19.12.3) (q:draft, low confidence)
vial = (i:3) (t:adj) (w:round/circular) (d:going round in a circle, said of a band or rim) (q:draft, low confidence)
vialcip = (i:1) (t:v) (w:wrap around/wrap up/enfold) (d:<vial>, bind around, with <cip>, tightly: wrap closely all round) (s:tuamcip) (b:vial) (q:draft)
vialcippa = (i:1) (t:n) (w:the one who wrapped it round) (d:<vialcip> wrap around with <pa>, male person) (b:vialcip) (q:draft)
vialh = (i:1) (t:v) (w:bind/wind around) (d:of ropes, be wound around someone) (b:vial) (q:draft)
vialin = (i:1) (t:v) (w:winding/twisting/coiling) (d:<vial>, wind or twist something round, with the linking marker <in>; said of ropes round the head and of thorns twisted into a crown) (b:vial) (q:draft)
vialna = (i:1) (t:n) (d:<vial>, used after <ci> say of mocking or repeated speech, with the noun suffix <na>: {a cih vialna} is what they kept crying out) (b:vial) (q:draft, low confidence)
vialte = (i:1) (t:n) (w:those who keep saying) (d:<vial> after <ci> say, of mocking speech, with the plural <te>: those who say it tauntingly; exact force of <vial> not confirmed) (b:vial) (q:draft, low confidence)
viauviau = (i:1) (t:adv) (d:after <namtui> fragrant: with the sweet smell spreading strongly) (q:draft, low confidence)
viik = (i:1) (t:v) (w:brandish/swing/wave) (d:swing a sword or the arm in order to strike; {viik suk} is swing down) (s:vik) (q:draft)
vik = (i:1) (t:v) (w:swing/wield) (d:move the arm or a staff with a sweep; {vik to} is swing up and {vik suk} bring down) (s:viik) (q:draft, low confidence)
vikin = (i:1) (t:v) (w:swinging/wielding) (d:<vik> swing with the suffix <in>; {a khut vikin} is swinging his arm) (b:vik) (q:draft, low confidence)
vil = (i:1) (t:v) (w:watch/guard/keep watch) (d:keep watch over a place or a person, look out for an enemy, or watch closely for a chance) (s:cing) (q:draft)
vilin = (i:1) (t:v) (w:watching/keeping watch) (d:<vil> watch, with the linking ending <in>) (b:vil) (q:draft)
vilna = (i:1) (t:n) (w:watch/vigil/guard duty) (d:noun of <vil>, watch over: keeping watch; with <mun>, the place of watching) (s:galvilna) (b:vil) (q:draft)
vilpa = (i:1) (t:n) (w:watchman/sentinel/lookout) (d:<vil>, watch, with <pa>, a man who does it; {gal vilpa} is the man who keeps watch for the enemy) (s:galvilpa/galvil) (b:vil) (r:23.21.12) (q:draft)
vilsim = (i:1) (t:v) (w:stalk/spy on/watch secretly) (d:keep watching someone's steps so as to catch him) (s:ensim) (q:draft)
vilte = (i:1) (t:n) (w:watchmen/guards) (d:<vil> watch with the plural <te>; {gal vilte} is those who keep watch for enemies) (s:galvilte) (b:vil) (q:draft)
vilvel = (t:see) <vilvel-in>
vilvel-in = (i:1) (t:adv) (w:specially/distinctly) (d:after {a tuam}, separate: {a tuam vilvel-in} is quite apart from the ordinary, as a special vow) (s:vilvelin) (q:draft, low confidence)
vilvelin = (i:1) (t:adv) (w:specially/particularly) (d:in {a tuam vilvelin}, quite separately, in a special way) (s:vilvel-in) (q:draft, low confidence)
vingveng = (i:1) (t:adv) (w:hurriedly/straight away) (d:after {ciah pah}, go home at once: describes hurrying off) (q:draft, low confidence)
vive = (i:1) (t:adv) (w:only/all/nothing but/entirely) (d:placed after a word to say that everything is of that kind) (r:19.119.69) (q:draft)
Vofsi = (i:1) (t:name) (c:male) (w:Vophsi) (d:father of Nahbi, the spy sent from the tribe of Naphtali) (r:4.13.14)
vok = (i:2) (t:n) (c:animal) (w:boar) (s:ngal)
vokcing = (i:1) (t:v) (w:tend pigs/feed pigs) (d:<vok> pig with <cing>, tend, look after) (q:draft)
vokcingte = (i:1) (t:n) (w:swineherds/pig keepers) (d:<vok>, pig, with <cing>, tend, and plural <te>: those tending the pigs) (b:vokcing) (r:42.8.34) (q:draft)
vokno = (i:1) (t:n) (c:animal) (w:piglet) (d:<vok>, pig, with <no>, young: a young pig)
vokpi = (i:1) (t:n) (c:animal) (w:pig) (d:<vok>, pig, with <pi>, big or female: a full-grown pig) (s:vok) (b:vok)
vokpi = (i:2) (t:n) (c:animal) (w:gilt/sow) (d:a female pig, a sow) (b:vok)
voksa = (i:1) (t:n) (c:animal) (w:pork) (d:<vok>, pig, with <sa>, meat: the flesh of pigs) (b:vok)
vokte = (i:1) (t:n) (w:pigs/swine) (d:plural of <vok>, pig) (b:vok) (q:draft)
vom = (i:2) (t:n) (c:animal) (w:bear) (d:a bear, named beside the lion as a dangerous wild animal) (s:vompi) (q:draft)
vom = (i:3) (t:v) (w:carry/keep/hold/harbor) (d:keep or carry something inside, as money in a belt, or a word, a teaching or a rebellious mind in the heart) (q:draft)
Vom = (i:1) (t:adj) (w:black) (d:<vom>, black, capitalised in {Mi Vom pa}, the Black man, for the byname Niger) (b:vom) (q:draft)
vomin = (i:1) (t:v) (w:turning black/growing black) (d:<vom>, black, with the linking ending <in>, which joins it to the following verb: turning black and then) (b:vom) (q:draft)
vomkhe = (i:1) (t:n) (w:bear's foot/bear's feet) (d:<vom> bear with <khe> foot) (q:draft)
vompi = (i:1) (t:n) (c:animal) (w:bear) (d:<vom> bear with <pi>, large or mother animal; in the verses often a she-bear robbed of her cubs) (s:vom) (b:vom) (q:draft)
vomsak = (i:1) (t:v) (w:make black/blacken) (d:<vom> black with the causative <sak>) (a:paaksak) (b:vom) (q:draft)
vomte = (i:1) (t:n) (c:animal) (w:bears) (d:<vom> bear with the plural suffix {-te}) (b:vom) (q:draft)
vomte = (i:2) (t:adj) (w:black/dark-colored) (d:the black ones, the colour word <vom> black with plural {-te}, placed after the noun it describes) (a:kangte) (b:vom) (q:draft)
votna = (i:1) (t:n) (w:cold/coldness/coolness) (d:<vot>, cold, with the noun suffix <na>: cold or coolness; {inndei a votna} is the cool room) (s:khuadam) (a:lumna) (b:vot) (q:draft)
votsak = (i:1) (t:v) (w:cool/make cool) (d:<vot>, cold, with the causative <sak>: make something cool, as water cools the tongue or shade lessens heat) (a:luumsak) (b:vot) (q:draft)
vu = (i:1) (t:n) (w:ashes/ash) (d:ashes left after burning; {bawngla vu} is the ashes of the heifer; the usual spelling is <vut>) (s:vut) (q:draft, low confidence)
vua = (i:1) (t:v) (w:beat/flog/strike) (d:beat or strike a person, as a punishment or in violence; <vuak> is the form used before some endings) (s:sat) (q:draft)
Vuahep = (i:1) (t:name) (c:city) (w:Vuahep/Zahab/Waheb) (d:town in Suphah near the Arnon, named in a line quoted from the Book of the Wars of the Lord) (r:4.21.14)
vuai = (i:1) (t:v) (w:wither/wilt) (d:of a tree or plant, dry up and droop) (q:draft)
vuak = (i:1) (t:v) (w:hit/strike/beat) (d:form of <vua>, beat or strike; {hong vuak} is they hit me, and in Isaiah 53:4 it is said of one struck by God) (s:sat) (b:vua) (q:draft)
vuakna = (i:1) (t:n) (w:beating/blow/scourge/flogging) (d:<vuak>, beat, with the noun suffix <na>: the act of beating or the blow received) (s:satna) (b:vuak) (q:draft)
vuakpih = (i:1) (t:v) (w:join in beating/join in attacking) (d:<vuak>, beat, with <pih>, together with: take part with others in beating someone) (b:vuak) (q:draft)
vuang = (i:1) (t:v) (w:sway/be shaken) (d:of a reed, <pumpeeng>, move to and fro when the wind blows on it) (q:draft, low confidence)
vuasak = (i:1) (t:v) (w:let strike/let beat) (d:<vua> beat, strike with <sak>, let or cause; with <hong>, let him strike me) (b:vua) (q:draft)
vuauvuau = (i:1) (t:adv) (d:after <nam> smell: with a sweet smell spreading all around) (q:draft, low confidence)
vuh = (i:1) (t:v) (w:cover/cover over) (d:of dust or earth, cover something poured on the ground) (s:vuk/khuh) (q:draft)
vuhlet = (i:1) (t:v) (w:break through/dig through/make an opening in) (d:open up a roof by breaking through its covering) (s:sulet) (q:draft)
vuhsak = (i:1) (t:v) (w:pierce/bore through) (d:pierce or bore through; said of a master who pierces the ear of his servant with an awl, <phimpi>) (s:vut) (q:draft)
vui = (i:1) (t:v) (w:bury) (d:put a dead person in a grave or tomb) (s:phum) (r:1.50.14) (q:draft)
vuih = (i:1) (t:v) (w:form heads/come into ear) (d:of grain, put out ears or heads) (q:draft)
vuikhawm = (i:1) (t:v) (w:bury together/bury with) (d:<vui>, bury, with <khawm>, together: bury someone with others in the same tomb) (b:vui) (q:draft)
vuikhia = (i:1) (t:v) (w:come out in ear/grow out) (d:of heads of grain, <buhvui>, come out on the stalk; <vui> as in <buhvui> with <khia> out, not from <vui> bury) (q:draft, low confidence)
vuina = (i:1) (t:n) (w:burial/burying) (d:<vui>, bury, with the noun suffix <na>: the act of burying, a burial; {vuina mun} is the place of burial) (s:kivuina) (b:vui) (q:draft)
vuisak = (i:1) (t:v) (w:let bury/allow to bury) (d:<vui>, bury, with <sak>, let or cause: let someone bury or be buried; {ka pa hong vuisak in} is let me bury my father) (b:vui) (q:draft)
vuite = (i:1) (t:n) (w:dust/powder) (d:{a vuite} is the dust or powder of something that has been burned, crushed or ground) (q:draft)
vuite = (i:2) (t:n) (w:buriers/those who bury) (d:<vui>, bury, with the plural <te>: the people who bury or have buried someone) (b:vui) (q:draft)
vuite = (i:3) (t:n) (w:ears of grain/heads of grain) (d:in {a vuite}, the ears of standing grain, which may be picked by hand; <vui> is the ear or head of a grain plant) (s:anvuite/buhvuite) (q:draft, low confidence)
vuk = (i:1) (t:n) (w:snow) (d:snow; {vuk bangin} is like snow, said of what is very white) (s:vuuk) (r:18.37.6) (q:draft)
vuk = (i:2) (t:v) (w:cover/bury) (d:cover something over completely, as with earth; {lei vuk} is fill in or cover with earth) (s:vuh/khuh) (q:draft)
vukcip = (i:1) (t:v) (w:overwhelm/bury/cover over) (d:<vuk>, cover, with <cip>, tightly: cover completely so that nothing shows, as earth or waves do; also of fear or sorrow that overwhelms a person) (s:khuhcip/tuumcip) (b:vuk) (q:draft)
vukkhal = (i:1) (t:n) (w:frost/ice/sleet) (d:frozen moisture: frost lying on the ground, or ice and sleet that damage crops) (q:draft)
vukkhalte = (i:1) (t:n) (w:melting snow/snow/ice) (d:<vukkhal>, frost or ice, with the plural <te>; in Job 24:19 the snow and ice that vanish in heat and drought) (b:vukkhal) (q:draft)
vukkia = (i:1) (t:n) (w:snowfall/falling snow) (d:<vuk>, snow, with <kia>, fall: snow that falls) (q:draft)
vukkiat = (i:1) (t:n) (w:snowfall/frost) (d:<vuk>, snow, with <kiat>, fall: falling snow or frost, listed with <khuadam>, cold) (b:vukkia) (q:draft)
vuknelh = (i:1) (t:v) (w:overwhelm/cover over/surpass/choke) (d:<vuk>, cover, with <nelh>, over: cover over completely; in 1 Kings 10:7 wisdom and wealth far exceed the report that was heard, in Matthew 13:22 worries and riches choke the word) (s:vukcip) (q:draft)
vuknelhin = (i:1) (t:v) (w:overwhelming/rising over) (d:<vuknelh>, cover over, with the linking ending <in>: said of sins piled higher than the head) (b:vuknelh) (q:draft)
vukngo = (i:1) (t:n) (w:frost) (d:the cold of the night that covers a body left outside, set against <nisa> the heat of the day) (q:draft)
vukpak = (i:1) (t:n) (w:frost/hoarfrost) (d:<vuk>, snow, with <pak>, flower: the white frost that is scattered on the ground) (s:vuukpaak) (q:draft)
vuksan = (i:1) (t:n) (w:frost) (d:used in the pair {vuksan vukngo} for the cold frost of the night) (b:vuk) (q:draft, low confidence)
vukte = (i:1) (t:n) (w:frost/snows) (d:<vuk>, snow, with the plural <te>; {van-a vukte} is the frost or snow of the sky) (b:vuk) (q:draft)
vul = (i:1) (t:v) (w:wither/fade/wilt) (d:of grass, leaves and flowers, dry up and lose life; also of glory or strength that fades) (s:vuai/keugaw/keutum) (a:palh) (r:42.8.6) (q:draft)
vulcip = (i:1) (t:v) (w:wither completely/wither away) (d:<vul>, wither, with <cip>, completely and for good) (b:vul) (q:draft)
vulgawp = (i:1) (t:v) (w:wither/wilt/languish) (d:<vul>, wither, with <gawp>, completely: dry up and droop, grow faint) (s:keugaw/keutum) (a:palh) (b:vul) (q:draft)
vulgawpin = (i:1) (t:v) (w:withering/wither) (d:<vulgawp>, wither completely, with the linking ending <in>) (b:vulgawp) (q:draft)
vulin = (i:1) (t:v) (w:wither/fade/wilt) (d:<vul>, wither, with the linking ending <in>: withering, and so) (b:vul) (q:draft)
