loin = (i:1) (t:conj) (w:without/none) (d:<lo>, not, with the linking ending <in>, placed after a verb to join it to what follows: without doing, not doing but)
loin = (i:2) (t:pron) (w:not one/not a one/no part/not a part/not a bit/not any) (d:used after {khat zong} or <kuamah> to say that not one of a group does something)
loin = (i:3) (t:adv) (w:not at all/not a bit/not the slightest bit/in no way/to no extent/by no means any/not for a moment) (d:used after <bangmah> and a verb: without doing anything at all)
loin = (i:4) (t:prep) (w:unaccompanied by/unescorted by/in the absence of) (d:used after <om>, be there: while someone or something is not present)
Lois = (i:1) (t:name) (c:female) (w:Lois) (d:grandmother of Timothy, remembered by Paul for her sincere faith) (r:55.1.5)
lok = (i:1) (t:v) (w:shake/stir) (d:shake something strongly, or stir water; {lok gawp} is shake violently, make tremble) (s:lingsak/liingsak) (q:draft)
lokgawp = (i:1) (t:v) (w:shake violently/shake) (d:<lok>, shake, with <gawp> marking a thorough or violent action) (s:lingsakgawp/linsakgawp) (b:lok) (q:draft)
lokha = (i:1) (t:v) (w:harvest/gather) (d:get to pick or harvest a crop, with <kha> marking that the action comes about; negated in the verse: you will not harvest its fruit) (q:draft, low confidence)
lokhawh = (i:1) (t:part) (d:particle prefixed to form nouns)
lokhawhna = (i:1) (t:n) (w:plowing/farming/cultivation) (d:<lokhawh>, work the fields, with the noun suffix <na>: farming, plowing; {lokhawhna leeng} is the plow and {lokhawhna tu} the plowshare) (b:lokhawh) (r:21.5.9) (q:draft)
lokho = (i:1) (t:v) (w:farming/farm/plow/till) (d:work the land to grow crops, from <lo>, field, and <kho>, till; {lokho mi} is a farmer) (r:24.52.16)
lokhote = (i:1) (t:n) (w:farmers) (d:<lokho>, farm, with the plural <te>: those who work the land) (s:khote) (b:lokho) (q:draft)
lokhul = (t:see) <lokhul-in>
lokhul-in = (i:1) (t:adv) (w:fallow/uncultivated/unused) (d:of land: left uncultivated for a time; {lokhul-in omsak} is to let a field lie fallow) (s:lokhulin) (q:draft, low confidence)
lokhulin = (i:1) (t:adv) (w:fallow/as wasteland) (d:<lokhul>, a field left uncultivated, with <in>: lying fallow, as a waste field; {lokhulin omsak} is let lie fallow and {lokhulin bawl} is make into a wasteland) (s:lokhul-in) (q:draft)
lokin = (i:1) (t:v) (w:shake) (d:<lok>, shake, with the linking suffix <in>: shaking someone or something, as shaking a sleeper by the shoulder to wake him) (b:lok) (q:draft)
lokung = (i:1) (t:n) (c:plant) (w:green plant/plant/herb) (d:<lo>, field, with <kung>, plant: a plant growing in the field; {lokung hing} is a green plant) (q:draft)
lolai = (i:1) (t:n) (w:field/open field) (d:<lo> field with <lai> middle: the cultivated field, the open field; <lolai-ah> is in the field) (r:41.13.16) (q:draft)
lolaite = (i:1) (t:n) (w:fields) (d:plural of <lolai>) (s:lote) (b:lolai) (q:draft)
lom = (i:1) (t:n) (w:lump/batch/bundle/heap) (d:a mass of something gathered into one: a lump of dough or clay, a lock or braid of hair, a pile) (q:draft)
lomcip = (i:1) (t:v) (w:gather up/hold tight) (d:<lom>, gather into a bundle, with <cip>, tightly: gather something up and hold it fast, as the wind in the hands) (b:lom) (q:draft)
lomhen = (i:1) (t:v) (w:tie in bundles/bundle) (d:<lom>, bundle, with <hen>, tie: tie things together in bundles, as weeds to be burned) (q:draft)
lomin = (i:1) (t:adv) (w:in heaps/in piles) (d:<lom> heap or bundle with <in>; {a lom lomin}, heap upon heap) (s:lomlomin) (b:lom) (q:draft)
lomin = (i:2) (t:v) (w:shape/mold/form) (d:connective form of <lom>, pressing something together into a lump, as clay is shaped) (b:lom) (q:draft, low confidence)
lomkhat = (i:1) (t:n) (w:one bunch/one lump/one bundle) (d:<lom> bunch, lump, with <khat> one) (q:draft)
lomkhatin = (i:1) (t:adv) (w:in one heap/in one mass) (d:<lomkhat>, one lump or heap, with the suffix <in>: in a single heap, said of water standing piled up) (b:lomkhat) (q:draft)
lomlomin = (i:1) (t:adv) (w:in heaps/in piles) (d:<lom> heap, doubled and with <in>: heap upon heap, in great numbers) (s:lomin) (q:draft)
lompi = (i:1) (t:n) (w:heap/mass/pile) (d:<lom>, a lump or heap, with {-pi}, great: a large heap or the whole mass, as of dough, water, smoke or stones) (b:lom) (q:draft)
lomtangin = (i:1) (t:adv) (w:in a column/in a thick mass) (d:said of smoke rising in one thick mass) (q:draft, low confidence)
lomtangte = (i:1) (t:n) (w:heaps/piles) (d:plural; {a sia lomtangte} is the heaps of ruins) (s:lomte) (q:draft, low confidence)
lomte = (i:1) (t:n) (w:heaps/piles) (d:plural of <lom>: heaps, piles of things gathered together) (s:lomtangte) (b:lom) (q:draft)
lona = (i:1) (t:n) (d:<lo>, not, with {-na}: the state or place of not being or not doing; {a kilang lona-ah}, where it does not show, means in secret or aside) (b:lo) (q:draft)
lonawl = (i:1) (t:n) (w:edge of a field) (d:<lo> field with <nawl> edge) (q:draft)
lonei = (i:1) (t:n) (w:owner of the field/landowner) (d:<lo>, field, with <nei>, have: one who owns a field or vineyard; {lonei pa} is used of a man) (q:draft)
long = (i:1) (t:n) (w:bell) (d:{kham long} is a gold bell on the hem of the priest's robe) (s:siklong) (q:draft, low confidence)
longal = (i:1) (t:prep) (w:except/besides/other than) (d:placed after the word it excludes, mostly in a question or a negative sentence: except, apart from) (s:simloh/lobuang) (q:draft)
longeek = (i:1) (t:n) (c:plant) (w:tender grass/new grass/young shoot) (d:young, newly sprouted grass or plants) (s:lopano) (q:draft)
longeekte = (i:1) (t:n) (c:plant) (w:tender shoots/young plants) (d:plural of <longeek>) (b:longeek) (q:draft)
lono = (i:1) (t:n) (w:pasture/meadow) (d:grassland where cattle feed; {lono etlawm} is the beauty of the pastures) (s:gankhahna) (q:draft, low confidence)
lonona = (i:1) (t:n) (w:pastureland/pasture/outskirts) (d:grazing land, especially the open land around a town where its animals feed) (s:gankhahna) (q:draft)
lononate = (i:1) (t:n) (w:pasturelands/pastures/outskirts) (d:plural of <lonona>: the grazing lands around a town) (s:lononte) (b:lonona) (q:draft)
lononte = (i:1) (t:n) (w:pasturelands/surrounding fields) (d:plural; the open land belonging to a town, said of the towns given to the Levites) (s:lononate) (q:draft, low confidence)
lop = (i:1) (t:v) (w:suck/savour) (d:hold and roll food in the mouth with the tongue) (q:draft, low confidence)
lopa = (i:1) (t:n) (c:plant) (w:grass) (d:grass and other low green plants of the field; {lopa bangin}, like grass, is said of what soon withers) (s:gampa) (r:24.14.5) (q:draft)
lopakungte = (i:1) (t:n) (c:plant) (w:reeds/stalks of grass) (d:<lopa> grass with <kung> stalk, plural) (q:draft)
lopano = (i:1) (t:n) (c:plant) (w:young grass/tender grass) (d:<lopa> grass with <no> young) (s:longeek) (b:lopa) (q:draft)
lopate = (i:1) (t:n) (w:grass/grasses/plants) (d:plural of <lopa>: grass, the plants of the field; {gamlak lopate} is the grass of the field) (b:lopa) (r:18.38.27) (q:draft)
lopawi = (i:1) (t:n) (w:sowing/planting/seedtime) (d:the sowing of the fields; {lopawi hun} is sowing time) (q:draft)
lopen = (i:1) (t:part) (w:least) (d:negative <lo> with <pen> most, after a descriptive word: the one that has least of that quality, as {a hat lopen}, the weakest, and {a gina lopen}, the lowliest) (b:lo) (q:draft)
lopi = (i:1) (t:part) (w:without) (d:negative <lo> with emphatic <pi>, used as <lopi-in> or {lopi-a} after a verb: without doing, while not, before) (s:lohin) (b:lo) (r:18.22.16) (q:draft)
lopipi = (i:1) (t:part) (d:stronger form of <lopi> after a verb, used as {lopipi-in}: even though not; {ut lopipi-in} means unwillingly, against the will, and {a kilawm lopipi-in} in a way that is not fitting at all) (b:lopi) (q:draft)
lopite = (i:1) (t:part) (d:<lo>, not, with <pi> and the plural ending <te>, after a verb phrase, those who are not or do not, as in {pasian ahi lopite}, those that are no gods) (b:lopi) (q:draft, low confidence)
lopthop = (i:1) (t:adj) (w:hasty/rash) (d:acting in a hurry without thought) (q:draft, low confidence)
Loruhamah = (i:1) (t:name) (c:female) (w:Lo-Ruhamah) (d:daughter of the prophet Hosea and Gomer; her name means not loved, not shown mercy) (r:28.1.6/28.1.8)
losak = (i:1) (t:part) (d:negative <lo> with causative <sak> after a verb: make someone not do or not be, as {lungkim losak} displease and {pau thei losak} make unable to speak) (b:lo) (q:draft)
losap = (i:1) (t:n) (w:duty/toll/tax) (d:a kind of tax named together with <siah> and <mangmu>) (r:15.7.24) (q:draft, low confidence)
losapte = (i:1) (t:n) (w:tenants/hired field workers) (d:<losap> with the plural <te>, those to whom a field, <lo>, is given out to work) (s:khawhlawhte) (b:losap) (q:draft, low confidence)
losapte = (i:2) (t:n) (w:duties/tolls) (d:a payment to the king, named after <siah> tax and <mangmu> in Ezra 4.20, where the English has taxes, tribute and duty) (b:losap) (q:draft, low confidence)
losia = (i:1) (t:n) (w:ruin/waste field) (d:used in the pair <innsia losia>, ruined houses and fields, a heap of ruins) (q:draft, low confidence)
losiang = (i:1) (t:v) (w:glean thoroughly/pick clean) (d:pick what is left until nothing remains, said of gleaning a vine) (q:draft, low confidence)
lot = (i:1) (t:v) (w:throw/fling/shoot) (d:throw something through the air or shoot an arrow; {suang lot khat} is a stone's throw) (s:lawn) (q:draft)
Lot = (i:1) (t:name) (c:male) (w:Lot) (d:nephew of Abraham, who settled in Sodom and escaped when the city was destroyed) (r:1.19.18)
Lotan = (i:1) (t:name) (c:male) (w:Lotan) (d:son of Seir the Horite and a Horite chief in the land of Edom) (r:1.36.20/1.36.29)
lote = (i:1) (t:part) (d:negative <lo> with plural <te>, after a verb or adjective: those who are not, those who do not, those without) (b:lo) (q:draft)
lote = (i:2) (t:n) (w:fields/farms) (d:plural of <lo>; {leenggui lote} means vineyards) (s:lolaite) (b:lo) (q:draft)
loteng = (i:1) (t:n) (w:fields) (d:<lo> field with <teng>, all: all the fields; NIV has terraces) (b:lo) (q:draft, low confidence)
