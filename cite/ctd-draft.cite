naupangte = (i:1) (t:n) (w:children) (d:plural of <naupang>, child) (a:teeksiate) (b:naupang)
nausawn = (i:1) (t:n) (w:next younger brother) (d:<nau>, younger sibling, with <sawn>, in turn: the brother next in age) (q:draft, low confidence)
nausia = (i:1) (t:v) (w:miscarry) (d:<nau> child with <sia> be spoiled: lose a child before birth; also of the woman to whom it happens) (s:tatolh) (q:draft)
nausuah = (i:1) (t:v) (w:give birth/bear a child) (d:<nau>, child, with <suah>, bring out: give birth; also names childbirth, as in {nausuah natna}, birth pains, and {nausuah hun}, the time of delivery) (s:tasuah) (q:draft)
nausuahna = (i:1) (t:n) (w:childbirth/childbearing/delivery) (d:<nausuah> give birth with the noun suffix <na>; {nausuahna tutphah} is the delivery stool) (s:nausuak) (b:nausuah) (q:draft)
nausuak = (i:1) (t:n) (w:labour/labor) (d:the labour of a woman giving birth; {numei nausuak} is a woman in labour)
nausuak = (i:2) (t:n) (w:childbirth) (s:nausuahna)
nausuakte = (i:1) (t:n) (w:women in labour/women giving birth) (d:<nausuak>, childbirth, with the plural <te>; {numei nausuakte}) (b:nausuak) (q:draft)
nauta = (i:1) (t:n) (w:pupil of the eye/apple of the eye) (d:found in {mit nauta}, the pupil of the eye, said of what is guarded as most precious) (q:draft)
nautang = (i:1) (t:n) (w:common people/lay people/ordinary people) (d:used after <mi> as {mi nautang}, the people at large as distinct from priests and leaders) (q:draft)
nautangte = (i:1) (t:n) (w:common people/lay people/ordinary people) (d:people without office or rank, often as {mi nautangte}) (s:minautangte) (b:nautang) (q:draft)
naute = (i:1) (t:n) (w:children) (b:nau)
nautum = (i:1) (t:n) (w:youngest/youngest child) (d:the last-born of the brothers; {a nautum pen} is the youngest) (q:draft)
nauzawpa = (i:1) (t:n) (w:younger son/younger brother/the younger) (d:<nauzaw> the younger with <pa>, a male) (s:naupa) (b:nauzaw) (q:draft)
nauzawte = (i:1) (t:n) (w:younger ones/younger men) (d:<nauzaw>, the younger, with the plural <te>) (s:khangnozawte) (b:nauzaw) (q:draft)
navak = (i:1) (t:adj) (w:quick-witted/bright/perceptive) (d:said of the mind, {lungsim navak}; {lungsim navak lo} is a dull or hardened heart) (r:27.1.4) (q:draft, low confidence)
navakna = (i:1) (t:n) (w:insight/intelligence/keenness) (d:<navak> quick-witted with the noun suffix <na>; {lungsim navakna} is brightness of mind) (b:navak) (q:draft)
navakte = (i:1) (t:n) (w:quick-witted ones/bright ones) (d:<navak>, quick of mind, with the plural <te>; {lungsim navakte}, those with a quick mind) (b:navak) (q:draft)
nawh = (i:1) (t:v) (w:hurry/hasten/rush) (d:placed before another verb to say the action is done quickly or in haste, as {nawh pai} go swiftly and {nawh nek} eat in haste; {ma-nawh} is to head for a place) (s:kinawh) (a:zekai) (q:draft)
nawh = (i:2) (t:v) (w:drive/drive out/chase) (d:make an animal or people move on or away; {nawh khia} is to drive out) (s:hawl) (q:draft, low confidence)
nawhdelh = (i:1) (t:v) (w:pursue/chase swiftly) (d:<nawh>, hurry or drive, with <delh> pursue) (q:draft)
nawhhawl = (i:1) (t:v) (w:drive fast/drive furiously) (d:<nawh> hurry with <hawl> drive) (q:draft)
nawhkeek = (i:1) (t:v) (w:scatter/drive apart) (d:<nawh> drive with <keek>, apart) (s:nawhkek/thehthang) (a:kaikhawm) (q:draft)
nawhkek = (i:1) (t:v) (w:scatter/drive apart) (d:<nawh> drive with <kek>, apart) (s:nawhkeek/thehthang) (a:kaikhawm) (q:draft)
nawhkhia = (i:1) (t:v) (w:drive out/chase out/expel) (d:<nawh>, drive, with <khia>, out: drive or throw people out of a place) (s:hawlkhia) (b:nawh) (q:draft)
nawhkhiat = (i:1) (t:v) (w:drive out/expel) (d:form of <nawhkhia> used before {khit ciangin} and other following words) (s:hawlkhiat) (b:nawhkhia) (q:draft)
nawhkhiatna = (i:1) (t:n) (w:driving out/expulsion) (d:<nawhkhiat>, drive out, with the noun suffix <na>) (s:hawlkhiatna) (b:nawhkhiat) (q:draft)
nawhkhiatnate = (i:1) (t:n) (w:things that drive away/acts of driving out) (d:<nawhkhiat> drive out with the noun suffix <na> and the plural <te>: the deeds that drive someone away) (b:nawhkhiatna) (q:draft)
nawhlen = (i:1) (t:v) (w:swoop/fly swiftly) (d:<nawh> hurry with <len>, fly: said of an eagle swooping on its prey) (q:draft, low confidence)
nawhpai = (i:1) (t:v) (w:hurry/go quickly/speed past) (d:<nawh>, hurry, with <pai>, go: go in haste, speed along) (s:nawhtai/kinawh) (q:draft)
nawhsa = (i:1) (t:adv) (w:hastily/hurriedly/quickly) (d:always as {nawhsa-in}, in haste) (a:damdamin) (b:nawh) (q:draft)
nawhsuk = (i:1) (t:v) (w:chase down/rush down upon) (d:<nawh>, drive or hurry, with <suk> downward) (b:nawh) (q:draft)
nawhtai = (i:1) (t:v) (w:hurry/hasten/run swiftly/be swift) (d:<nawh>, hurry, with <tai>, run: run or move in great haste) (s:nawhpai/nawhtat/kinawh) (a:zekai) (q:draft)
nawhtaina = (i:1) (t:n) (w:haste/hurried flight) (d:<nawhtai>, hurry, with the noun suffix <na>; {a nawhtaina lamin}, as she hurried away) (s:nawhtatna/kinawhna) (b:nawhtai) (q:draft)
nawhtat = (i:1) (t:v) (w:hurry/hasten/be urgent) (d:act in haste or press someone to make haste; of a task, be urgent) (s:nawhtai/kinawh) (a:zekai) (q:draft)
nawhtatna = (i:1) (t:n) (w:haste/hastiness/hurry) (d:<nawhtat> hurry with the noun suffix <na>; {mawk nawhtatna} is thoughtless haste) (s:kinawhna/nawhtaina) (b:nawhtat) (q:draft)
nawhzap = (i:1) (t:v) (w:flap fast/beat rapidly) (d:<nawh> hurry with <zap> flap, of wings) (q:draft)
nawi = (i:2) (t:n) (w:breast) (d:the breast of a mother; {nawi tawh kikhen}, to be parted from the breast, means to be weaned) (q:draft)
nawine = (i:1) (t:adj) (w:nursing/suckling) (d:feeding at the breast, <nawi> breast or milk with <ne> eat; {nawine naungeek} is a nursing baby) (q:draft)
nawine = (i:2) (t:n) (w:infant/suckling) (d:a child still at the breast) (s:naungek/naungeek) (q:draft)
nawisuk = (i:1) (t:adj) (w:milch/nursing) (d:of a female animal that is giving milk to her young, from <nawi> milk; {kalaoh nawisuk}, milch camels) (b:nawi) (q:draft, low confidence)
nawite = (i:1) (t:n) (w:breasts) (d:<nawi>, breast, with the plural <te>) (b:nawi) (r:22.7.3) (q:draft)
nawitui = (i:1) (t:n) (w:milk) (d:milk as a drink, from <nawi>, milk or breast, with <tui>, liquid; in the verse a picture of simple teaching for new believers) (s:nawizu/nawi) (q:draft)
nawizu = (i:1) (t:n) (w:milk) (d:milk of a mother or an animal, as what the breast gives and as food; also a picture of simple teaching for new believers) (s:nawitui/nawi) (q:draft)
nawk = (i:1) (t:v) (w:collide/strike/rush against) (d:strike or rush against something with force, as flood water against a house)
nawk = (i:2) (t:v) (w:bump/bang) (d:knock or strike against someone or something)
nawkgawp = (i:1) (t:v) (w:batter/beat against/lash/sweep over) (d:<nawk>, strike against, with <gawp>, violently: said of wind, flood, terror and anger that beat on someone or something) (b:nawk) (q:draft)
nawkgawpin = (i:1) (t:v) (w:batter/sweep over/overwhelm) (d:<nawkgawp>, beat violently against, with the ending <in>) (b:nawkgawp) (q:draft)
nawkin = (i:1) (t:prep) (w:through/past) (d:<nawk>, pass through or pass by, with the linking ending <in>: going through a land or past a person)
nawkkha = (i:1) (t:v) (w:pass by/go past/come past) (d:<nawk>, pass, with <kha>, happen to: come past a place or a person on the way) (s:paikha/kheng) (q:draft)
nawkna = (i:1) (t:n) (w:coming over/turning) (d:seen once beside <kiheina>, turning, of the Gentiles coming to God; <nawk>, go against or rush at, with the noun suffix <na>) (b:nawk) (q:draft, low confidence)
nawkpai = (t:see) <nawkpai-in>
nawkpai-in = (i:1) (t:v) (w:rush against/knock down) (d:<nawk>, bump against, with <pai> go and the ending <in>: pushing over someone while going) (q:draft, low confidence)
nawksak = (i:1) (t:v) (w:let pass through/allow to cross) (d:<nawk>, pass through, with <sak>: permit someone to go through a land) (s:kantansak) (b:nawk) (r:5.2.27) (q:draft)
nawksuak = (i:1) (t:v) (w:break through/press through/contend) (d:<nawk> push against with <suak> through: force a way through; {upna thu-ah nawksuak} is to struggle on for the faith) (q:draft)
nawkzawh = (i:1) (t:v) (w:be able to face/be able to go through) (d:<nawk>, go against, with <zawh>, form of <zo> be able) (q:draft, low confidence)
nawl = (i:1) (t:n) (w:edge/border/outskirts) (d:the outer edge of a place or the area just outside it; {khua nawl ah} is outside the town) (s:gei/mong/pam) (q:draft)
nawla = (i:1) (t:n) (w:outside/outskirts/edge) (d:<nawl>, edge or outskirts, with the ending <a>, at) (b:nawl) (q:draft)
nawlah = (i:1) (t:prep) (w:outside/at the edge of/beyond) (d:<nawl> edge with the place marker <ah>, at the edge or outside of a place) (s:geiah) (a:sungah) (b:nawl) (r:42.20.15) (q:draft)
nawlhui = (i:1) (t:n) (w:edge/edges) (d:the outer edge of the beard, {khamul nawlhui}; from <nawl> edge) (q:draft, low confidence)
nawlkhin = (i:1) (t:v) (w:reject/refuse/turn away from) (d:push aside a person or his word and have nothing more to do with him) (s:nial/nolh/nungngat) (a:saang) (q:draft)
nawlkhinin = (i:1) (t:v) (w:reject/let go/set aside) (d:<nawlkhin>, reject, with the ending <in> that links to the next verb) (s:nialin) (b:nawlkhin) (q:draft)
nawlkhinzia = (i:1) (t:n) (w:way of rejecting/way of setting aside) (d:<nawlkhin>, reject, with <zia> manner) (q:draft)
nawlnung = (i:1) (t:n) (w:far end/outer end/end) (d:the end or side furthest away; {nawlnung pen} is the outermost, said of the end curtain of a set) (q:draft)
nawm = (i:1) (t:adv) (w:whole/down) (d:seen with <valh> swallow: {nawm valh}, swallow whole, gulp down) (q:draft, low confidence)
nawmvalh = (i:1) (t:v) (w:swallow/swallow up) (d:swallow, take in whole: said of the earth, the deep, a great fish and of enemies who destroy) (s:valh/valhtum) (a:luakhia) (q:draft)
nawmvalhkha = (i:1) (t:v) (w:swallow/happen to swallow) (d:<nawmvalh>, swallow, with <kha>, happen to or by mistake) (q:draft)
nawmvalhna = (i:1) (t:n) (w:swallowing/swallowing up) (d:<nawmvalh> swallow with the noun suffix <na>: the event of the earth swallowing them) (b:nawmvalh) (q:draft)
nawmvalhsak = (i:1) (t:v) (w:let swallow/cause to swallow) (d:<nawmvalh>, swallow, with the causative <sak>) (b:nawmvalh) (q:draft)
nawmvalhtum = (i:1) (t:v) (w:swallow up/swallow whole) (d:<nawmvalh>, swallow, with <tum>, entirely) (s:valhtum) (q:draft)
nawn = (i:1) (t:adv) (w:long/any longer/any more) (d:placed after a verb and before a negative such as <lo> or <kei>: no longer, not any more, not again) no longer
nawn = (i:2) (t:v) (w:carry) (d:carry a load; seen in {na a nawn mite}, those who carried the building materials) (s:pua)
nawng = (i:1) (t:n) (w:marsh/swamp/mire) (d:wet, muddy ground where reeds grow) (s:ciknawng/nawngpi) (q:draft)
nawngkai = (i:1) (t:v) (w:be troubled/be disturbed/be hindered) (d:{nawngkai sa} is feel disturbed or annoyed; {nawngkai sak} is to trouble, stir up or hinder) (s:buai) (q:draft)
nawngkaina = (i:1) (t:n) (w:hindrance/disturbance/trouble) (d:<nawngkai> be troubled or hindered with the noun suffix <na>) (s:buaina) (b:nawngkai) (q:draft)
nawngkaisa = (i:1) (t:v) (w:be annoyed/feel troubled) (d:<nawngkai>, be troubled, with <sa> feel) (b:nawngkai) (q:draft)
nawngkaisak = (i:1) (t:v) (w:trouble/bother/disturb/hinder) (d:cause trouble or difficulty to someone: <nawngkai> with the causative <sak>) (s:buaisak/lungkhamsak) (b:nawngkai) (q:draft)
nawngkaisakin = (i:1) (t:v) (w:trouble/hinder/put obstacles before) (d:<nawngkaisak>, trouble or hinder, with the ending <in> that links to the next verb) (b:nawngkaisak) (q:draft)
nawngkaisakte = (i:1) (t:n) (w:troublers/those who trouble) (d:<nawngkaisak>, trouble or disturb, with the plural <te>: the ones who trouble) (s:lungkhamsakte) (b:nawngkaisak) (q:draft)
nawngkaisakzo = (i:1) (t:v) (w:be able to hinder/be able to trouble) (d:<nawngkaisak>, hinder, with <zo> be able) (b:nawngkaisak) (q:draft)
nawnglakte = (i:1) (t:n) (w:swamps/marshes) (d:<nawng> marsh with <lak>, among, and the plural <te>: marshy places) (q:draft)
nawngpi = (i:1) (t:n) (w:marsh/swamp/great marsh) (d:<nawng> marsh with <pi> great: wet ground where grass and reeds grow) (s:ciknawng/nawng) (b:nawng) (q:draft)
nawnkei = (i:1) (t:adv) (w:no longer/not any more/not again) (d:<nawn> any more with the negative <kei>, written as one word after a verb; usually written {nawn kei}) (s:nawnlo) (q:draft)
nawnkhia = (i:1) (t:v) (w:remove/carry out/take away) (d:<nawn>, carry, with <khia> out) (s:puakhia) (b:nawn) (q:draft)
nawnlo = (i:1) (t:adv) (w:no longer/no more/not any more) (d:<nawn> any longer with the negative <lo>, written as one word after a verb; usually written {nawn lo}) (s:nawnkei) (b:nawn) (q:draft)
nawnloin = (i:1) (t:adv) (w:no longer/without any more) (d:<nawnlo> no longer, with the linking ending <in>: no longer doing so, and) (b:nawnlo) (q:draft)
nawt = (i:1) (t:v) (w:gore/push/thrust) (d:push hard against something, as an ox with its horns; {nawt gawp} is treat roughly, assault) (s:pik/not) (q:draft)
nawt = (i:2) (t:v) (w:press forward/advance/march on) (d:with <mai> face: {mai nawt}, push ahead, go forward) (s:mainawt/maipai) (a:nungkik) (q:draft)
nawt = (i:3) (t:v) (w:wear away/rub off/scrape/wash away) (d:rub or scrape against a surface so that it wears off, usually with <khia> out; also shape wood with a scraping tool) (q:draft, low confidence)
nawtgawpin = (i:1) (t:v) (w:treat violently/assault/mistreat) (d:<nawt>, push or thrust, with <gawp>, violently, and the ending <in>) (q:draft)
nawtin = (i:1) (t:adv) (w:onward/forward/pressing on) (d:<nawt>, push on, with the linking ending <in>; {mai nawtin pai} is go forward) (b:nawt) (q:draft)
nawtkhia = (i:1) (t:v) (w:push out/drive out/thrust out/depose) (d:<nawt>, push, with <khia>, out) (s:hawlkhia/nawhkhia/delhkhia) (b:nawt) (q:draft)
nawtkhiat = (i:1) (t:v) (w:wear away/wash away) (d:<nawt>, rub or wear, with <khiat>, form of <khia> out, used before <bangin> and other following words) (s:sawpkhiat) (b:nawt) (q:draft)
nawtsakzaw = (i:1) (t:v) (w:advance further/cause to advance more) (d:<nawt>, press forward, with the causative <sak> and <zaw> more; {mai nawtsakzaw}, make something go forward all the more) (q:draft)
nawtsuak = (i:1) (t:v) (w:press on/go right through/march on) (d:<nawt> push forward with <suak> through to the end; {mai nawtsuak} is march on) (q:draft)
nawtsuakin = (i:1) (t:v) (w:press on/go right on) (d:<nawtsuak>, press on to the end, with the ending <in> that links to the next verb) (b:nawtsuak) (q:draft)
nawtsuk = (i:1) (t:v) (w:sweep down/push down into) (d:<nawt> push forward with <suk> downward: of flood water, press on down into a land) (b:nawt) (q:draft)
Nazareth = (i:1) (t:name) (c:city) (w:Nazareth) (d:town in Galilee where Jesus grew up) (r:42.1.26/42.18.37)
NAZARETH = (i:1) (t:name) (c:city) (w:Nazareth) (d:Nazareth, the home town of Jesus in Galilee, written in capitals in the notice on the cross) (r:43.19.19) (q:draft)
nazat = (i:1) (t:n) (w:equipment/utensils/furnishings/articles) (d:<na>, thing, with <zat>, use: the things used with something, such as the utensils of the altar and the furnishings of the tabernacle)
nazatte = (i:1) (t:n) (w:utensils/articles/accessories/furnishings) (d:<nazat>, equipment, with the plural <te>: the utensils and furnishings that belong to the altar, the table or the lampstand) (s:umlebeelte/vanzatte) (b:nazat) (q:draft)
nazaw = (i:1) (t:v) (w:hurt more/be harder) (d:<na>, be painful, with <zaw> more: it is the more painful or hard for someone) (q:draft, low confidence)
Nazereth = (i:1) (t:name) (c:city) (w:Nazareth) (d:spelling of <Nazareth> in one verse; {Nazereth mi} is a Nazarene, a person from Nazareth) (r:40.2.23)
Nazir = (i:1) (t:name) (w:Nazirite) (d:a person set apart for God by a special vow, who drinks no wine and does not cut the hair; {Nazir mi} is a Nazirite) (r:4.6.13/30.2.12)
nbsp = (t:todo) (q:draft, not a word, the HTML entity nbsp left in the Bible text)
Ne = (t:see) <Ne-i>
Ne-i = (i:1) (t:name) (c:city) (w:Neiel) (d:first part of {Ne-i-el}, Neiel, a town on the border of the territory of Asher) (r:6.19.27) (q:draft, low confidence)
Neah = (i:1) (t:name) (c:place) (w:Neah) (d:place on the border of the territory of Zebulun) (r:6.19.13) (q:draft)
Neapolis = (i:1) (t:name) (c:city) (w:Neapolis) (d:seaport in Macedonia where Paul landed on his way to Philippi) (r:44.16.11)
Neariah = (i:1) (t:name) (c:male) (w:Neariah) (d:name of two men: a descendant of David through Shekaniah, and a Simeonite leader, son of Ishi) (r:13.3.23/13.4.42)
Nebai = (i:1) (t:name) (c:male) (w:Nebai) (d:one of the leaders of the people who sealed the covenant in the time of Nehemiah) (r:16.10.19) (q:draft)
Nebaioth = (i:1) (t:name) (c:female) (w:Nebaioth) (d:firstborn son of Ishmael, brother of Mahalath and Basemath) (r:13.1.29)
Neballat = (i:1) (t:name) (c:place) (w:Neballat) (d:town where people of Benjamin lived after the exile) (r:16.11.34)
Nebat = (i:1) (t:name) (c:male) (w:Nebat) (d:father of Jeroboam, the first king of the northern kingdom of Israel) (r:14.13.6/11.15.1)
Nebo = (i:1) (t:name) (c:place) (w:Nebo) (d:name of a town east of the Jordan, of the mountain from which Moses saw the promised land, of a Babylonian god, and of an ancestor of some who returned from exile) (r:4.32.3)
Nebukhadezzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:spelling of <Nebukhadnezzar>, Nebuchadnezzar, the king of Babylon who destroyed Jerusalem) (r:27.3.7)
Nebukhadnazzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:spelling of <Nebukhadnezzar>, Nebuchadnezzar, the king of Babylon who destroyed Jerusalem) (r:27.3.24)
Nebukhadnezzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:king of Babylon who captured Jerusalem, destroyed the temple and took the people of Judah into exile) (r:12.24.1/27.4.28)
Nebukhadzezzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:spelling of <Nebukhadnezzar>, Nebuchadnezzar, the king of Babylon who destroyed Jerusalem) (r:24.25.9)
Nebukhadznezzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:spelling of <Nebukhadnezzar>, Nebuchadnezzar, the king of Babylon who destroyed Jerusalem) (r:24.51.34)
Nebukkhadnezzar = (i:1) (t:name) (c:male) (w:Nebuchadnezzar) (d:spelling of <Nebukhadnezzar>, Nebuchadnezzar, the king of Babylon who destroyed Jerusalem) (r:27.2.28)
Nebushazban = (i:1) (t:name) (c:male) (w:Nebushazban) (d:a chief officer of Nebuchadnezzar king of Babylon at the fall of Jerusalem) (r:24.39.13)
Nebuzaradan = (i:1) (t:name) (c:male) (w:Nebuzaradan) (d:commander of the guard of Nebuchadnezzar, who burned Jerusalem and the temple and carried the people into exile) (r:12.25.20/24.39.11)
Nedabia = (i:1) (t:name) (c:male) (w:Nedabiah) (d:spelling of <Nedabiah>, a son of King Jehoiachin of Judah) (r:13.3.18) (q:draft)
Nedabiah = (i:1) (t:name) (c:male) (w:Nedabiah) (d:a son of Jehoiachin, also called Jeconiah, king of Judah) (r:13.3.18)
neek = (i:1) (t:v) (w:eat) (d:form of <ne>, eat, used before <ding>, <theih> and <nading>; {neek ding} is something to eat, food) (q:draft)
neel = (i:1) (t:adj) (w:smooth/fine/soft) (d:smooth to the touch; of dust or cloth, fine) (s:nel) (a:tamkimlo/ham) (q:draft)
neellua = (i:1) (t:adj) (w:too delicate/very tender) (d:<neel>, smooth or soft, with <lua> too much; {a ci neellua}, her body is so delicate) (b:neel) (q:draft)
neelna = (i:1) (t:n) (w:smoothness) (d:<neel> smooth with the noun suffix <na>; {a neelna mun} is the smooth part, the place where it is smooth) (b:neel) (q:draft)
neelsak = (i:1) (t:v) (w:make smooth/make level) (d:<neel> smooth with the causative <sak>) (b:neel) (q:draft)
neelte = (i:1) (t:adj) (w:fine) (d:<neel>, fine, with the plural <te>; {an neelte} is fine flour) (b:neel) (q:draft, low confidence)
neem = (i:1) (t:adj) (w:soft/gentle/weak) (d:not hard or strong: {tha neem} is become weak, {kam neem} a gentle word, {mit-hah neem} weak eyes) (s:nem) (a:khauh/hat) (q:draft)
Nefeg = (i:1) (t:name) (c:male) (w:Nepheg) (d:name of two men: a son of Izhar of the tribe of Levi, and a son of David born in Jerusalem) (r:2.6.21)
Nefilim = (i:1) (t:name) (c:male) (w:Nephilim) (d:people of great size and strength who lived before the flood and were later seen in Canaan, from whom the descendants of Anak came) (r:1.6.4/4.13.33)
Nefisim = (i:1) (t:name) (c:people) (w:Nefisim/Nephusim) (d:family of temple servants who returned from the exile, called Nephusim in the NIV) (r:15.2.50)
Neftoah = (i:1) (t:name) (c:place) (w:Nephtoah) (d:spring, the waters of Nephtoah, on the border between Judah and Benjamin) (r:6.15.9/6.18.15)
Nefushesim = (i:1) (t:name) (c:people) (w:Nefushesim/Nephusim) (d:family of temple servants who returned from the exile, the same family as <Nefisim>, called Nephusim in the NIV) (r:16.7.52)
negawp = (i:1) (t:v) (w:devour/eat up) (d:<ne> eat with <gawp>, severely, completely) (s:netum/nemang) (b:ne) (q:draft)
Negeb = (i:1) (t:name) (c:land) (w:Negev) (d:the dry southern region of Judah, toward the desert) (r:6.15.21)
neh = (i:1) (t:v) (w:press hard/close in on/come near) (d:to push forward against someone or come up close, of an enemy, a battle or a crowd) (s:naih) (q:draft)
neh = (i:2) (t:v) (w:prevail/win/gain the upper hand) (d:to gain the upper hand in a battle, said of the side that is pressing the other back) (s:zo/gualzo) (a:lel/guallel) (q:draft, low confidence)
Nehamani = (i:1) (t:name) (c:male) (w:Nahamani) (d:one of the leaders who returned from the exile in Babylon with Zerubbabel) (r:16.7.6)
nehcih = (i:1) (t:v) (w:hem in/press in on/crowd) (d:<neh>, press close, with <cih>, tightly on every side: of enemies closing in around a city) (s:nehcip/uumcip) (q:draft)
nehcihlam = (i:1) (t:n) (w:crowding/pressing in) (d:<nehcih>, press in on, with <lam>, the fact or manner: that people are crowding in on someone) (q:draft)
nehcip = (i:1) (t:v) (w:crowd around/press upon/surround closely) (d:<neh>, press close, with <cip>, tightly: of a crowd pushing in around a person, or of trouble closing in) (s:nehcih/uum/umcih) (q:draft)
nehcipgawp = (i:1) (t:v) (w:crush/crowd hard) (d:<nehcip>, crowd around, with <gawp>, violently) (b:nehcip) (q:draft)
Nehelam = (i:1) (t:name) (c:place) (w:Nehelam) (d:home or clan of the false prophet Shemaiah, who is called the Nehelamite) (r:24.29.24/24.29.31)
Nehemiah = (i:1) (t:name) (c:male) (w:Nehemiah) (d:son of Hakaliah, cupbearer to the king of Persia and governor of Judah who rebuilt the wall of Jerusalem; also the name of two other men) (r:16.1.1/16.10.1)
nehin = (i:1) (t:v) (w:come near/approach/step forward) (d:<neh> come near with the linking ending <in>, used when another verb follows; {mai lam nehin pai} is step forward) (b:neh) (q:draft)
nehkawmin = (i:1) (t:adv) (w:keeping close/close along) (d:<neh>, come close, with <kawm>, while, and the ending <in>: staying close to something while going, as a ship along a shore) (q:draft, low confidence)
nehpen = (t:see) <nehpen-a>
nehpen-a = (i:1) (t:adj) (w:nearest) (d:seen once of the part of a gateway on the temple side; apparently <neh>, be close, with <pen> most and the ending <a>) (q:draft, low confidence)
nehphei = (i:1) (t:v) (w:lean against/lean over to) (d:<neh>, come close, with <phei> sideways) (q:draft)
nehpiksan = (i:1) (t:v) (w:sneer at/scorn/despise) (d:purse the lips at someone in contempt, from <neh>, lip, and {piksan}, purse: sneer at, treat with scorn) (s:simmawh) (a:zahtak) (q:draft)
nehta = (i:1) (t:v) (w:draw near/close in on) (d:<neh>, come close or press upon, with <ta>, now) (b:neh) (q:draft)
nehthawh = (i:1) (t:v) (w:confront/come against/attack) (d:<neh>, press upon, with <thawh>, rise) (q:draft)
Nehum = (i:1) (t:name) (c:male) (w:Nehum) (d:one of the leaders who returned from the exile in Babylon with Zerubbabel, called Rehum in Ezra) (r:16.7.6)
Nehushta = (i:1) (t:name) (c:female) (w:Nehushta) (d:mother of King Jehoiachin of Judah, daughter of Elnathan of Jerusalem) (r:12.24.8) (q:draft)
Nehushtan = (i:1) (t:name) (w:Nehushtan) (d:name given to the bronze snake that Moses had made, which King Hezekiah broke into pieces) (r:12.18.4)
Nehusta = (i:1) (t:name) (c:female) (w:Nehushta) (d:spelling of <Nehushta> in the older Tedim text: mother of King Jehoiachin of Judah) (r:12.24.8)
nei = (i:1) (t:v) (w:have) (d:have something or someone, as a child, a wife, a quality or a thought; with <tawh> it means have a child by someone) (a:tasam)
nei = (i:2) (t:v) (w:possess/own/hold) (d:have as one’s own property, as land, a house, animals or money)
nei = (i:3) (t:v) (w:experience/undergo) (d:have a state or feeling come upon one, as sickness, fear or trouble)
Neiel = (i:1) (t:name) (c:place) (w:Neiel) (d:town on the border of the territory of Asher) (r:6.19.27)
neih = (i:1) (t:v) (w:have/own/possess) (d:form of <nei>, have, used in relative and dependent clauses and before <loh>, <leh> and <hangin>) (b:nei) (q:draft)
neih = (i:2) (t:n) (w:possession/property) (d:what someone has or owns; {a neih khempeuh} is all that he has) (s:neihsa) (b:nei) (r:3.25.24) (q:draft)
neihdang = (i:1) (t:n) (w:other possession/anything else owned) (d:<neih> possession with <dang> other) (q:draft)
neihin = (i:1) (t:v) (w:having/holding as) (d:<neih>, have or hold, with the ending <in>; {ciamnuih-a neihin}, holding someone as an object of mockery) (b:neih) (q:draft, low confidence)
neihkhak = (i:1) (t:v) (w:have/happen to have) (d:<neih> have with <khak>, form of <kha>, happen to; {kisapna neihkhak loh nading}, so that they have no lack) (q:draft)
neihkhakna = (i:1) (t:n) (w:reliance/having) (d:<neihkhak>, happen to have, with the noun suffix <na>; {muanin neihkhakna}, having someone as one's trust) (b:neihkhak) (q:draft, low confidence)
neihkhawm = (i:1) (t:v) (w:share/have together/own jointly) (d:<neih> have with <khawm> together) (b:neih) (q:draft)
neihkik = (i:1) (t:v) (w:have again/take again/marry again) (d:<neih> have with <kik> again; {pasal neihkik} is to marry again) (b:neih) (q:draft)
neihkikna = (i:1) (t:n) (w:having again/taking again) (d:<neihkik>, have or take again, with the noun suffix <na>; of the Lord taking Jerusalem as his city again) (b:neihkik) (q:draft)
neihlai = (i:1) (t:v) (w:still have) (d:<neih>, form of <nei>, have, with <lai>, still) (q:draft)
neihlam = (i:1) (t:n) (d:the fact that someone has something; <neih>, the form of <nei> have, with <lam>, which turns the clause into the thing known or seen) (q:draft)
neihlelam = (i:1) (t:n) (w:wealth/possessions/property) (d:wealth and goods taken together, all that a person owns; also written {neih leh lam}) (s:neihsa/hauhna) (a:zawnna) (q:draft)
neihna = (i:1) (t:n) (w:having/possession) (d:the act or state of having; {thu neihna} is a lawsuit or dispute) (b:neih) (q:draft)
neihnate = (i:1) (t:n) (w:possessions/belongings) (d:also the plural noun form of <neih> have, as in {hazatna a neihnate}, the jealousy that one holds) (s:neihsate) (b:neihna) (q:draft)
neihnateng = (i:1) (t:n) (w:all that one has) (d:<neihna>, having, with <teng> all; {lungsim i neihnateng}, the whole of the mind we had) (b:neihna) (q:draft, low confidence)
neihsa = (i:1) (t:n) (w:property/possessions/wealth) (d:what a person owns) (s:neihlelam/hauhna) (b:neih) (q:draft)
neihsak = (i:1) (t:v) (w:let have/give/provide) (d:<neih> have with the causative <sak>: cause or allow someone to have) (s:ngahsak) (b:neih) (r:19.137.9) (q:draft)
neihsakpa = (i:1) (t:n) (w:one who deals out/one who makes have) (d:<neihsak>, cause to have, with <pa> marking a man: the man who does this to someone) (b:neihsak) (q:draft, low confidence)
neihsate = (i:1) (t:n) (w:possessions/wealth/property/goods) (d:<neihsa>, property, with the plural <te>: the things a person owns, his goods and wealth) (s:hauhnate) (b:neihsa) (q:draft)
neihsateng = (i:1) (t:n) (w:all possessions/all one has/whole property) (d:<neihsa> possessions with <teng> all) (b:neihsa) (q:draft)
neihse = (i:1) (t:v) (w:take/marry) (d:seen once in {pasal a neihse sangin}, rather than taking a husband; <neih> have with <se>, whose force is unclear) (q:draft, low confidence)
neihsuak = (i:1) (t:v) (w:own permanently/own outright) (d:<neih>, own, with <suak>, through to the end: have for good) (q:draft)
neihsun = (i:1) (t:adj) (w:only/sole) (d:the only one that a person has, as an only son; {a neihsun teng} is the little that one has) (r:20.19.4) (q:draft)
neihsunte = (i:1) (t:n) (w:only possessions/the little one has) (d:<neihsun> the only one that a person has, with plural <te>) (b:neihsun) (q:draft)
neihte = (i:1) (t:n) (w:possessions/what one has/things had) (d:the things someone has, of goods and also of plans or disputes; {thu neihte} are cases people have) (b:neih) (r:24.29.11) (q:draft)
neihteng = (i:1) (t:n) (w:all that one has/everything owned) (d:<neih> have with <teng> all of: the whole of what is had, placed after the thing owned) (s:neihzah) (b:neih) (q:draft)
neihtheih = (i:1) (t:v) (w:be able to have/can have) (d:<neih>, have, with <theih>, be able; often followed by <nading>, so that one may have) (b:neih) (q:draft)
neihtheihna = (i:1) (t:n) (d:<neihtheih>, be able to have, with the noun suffix <na>; with <ding> it means so that one may have) (b:neihtheih) (q:draft)
neihthuah = (i:1) (t:v) (w:have in addition/have more besides) (d:<neih> have with <thuah>, add on top) (q:draft)
neihtuam = (i:1) (t:n) (w:special possession/treasured possession/very own) (d:<neih> possess with <tuam> apart: what is owned specially and set apart as one's own) (q:draft)
neihval = (i:1) (t:n) (w:surplus/abundance/wealth) (d:what one has over and above one's needs, from <neih> have and <val> excess) (q:draft)
neihzah = (i:1) (t:n) (w:all that one has/as much as one has) (d:<neih>, form of <nei>, have, with <zah>, amount: the whole amount that one has; {a aw neihzah tawh} is at the top of his voice, {na tha neihzah tawh} with all your strength) (s:neihteng) (q:draft)
neihzawh = (i:1) (t:v) (w:attain/manage to have) (d:<neih> have with <zawh> be able, come to possess) (q:draft)
neikha = (i:1) (t:v) (w:have/have a share in) (d:<nei> have with <kha>, which marks that the act reaches its object; in the verses always negated, not have at all, and {ngaihsutin neikha lo} is not even have in mind) (q:draft)
neikhawm = (i:1) (t:v) (w:have together/share/hold in common) (d:have two or more things at once, or own something jointly with others) (b:nei) (q:draft)
neikhin = (i:1) (t:v) (w:already have/have already) (d:<nei> have with <khin> already) (b:nei) (q:draft)
neikik = (i:1) (t:v) (w:have again/get back/regain) (d:<nei> have with <kik> again) (s:ngahkik) (b:nei) (q:draft)
neikim = (i:1) (t:v) (w:have in full/have every one) (d:<nei> have with <kim> complete, have all of something) (q:draft)
neilai = (i:1) (t:v) (w:still have/have besides/also have) (d:<nei> have with <lai> still or more) (q:draft)
neilo = (i:1) (t:v) (w:not have/lack/be without) (d:<nei> have with the negative <lo>, written as one word; usually written {nei lo}) (s:tasam) (a:nei) (b:nei) (r:27.5.23) (q:draft)
neilote = (i:1) (t:n) (w:those who do not have/those without) (d:<neilo>, not have, with the plural <te>; {pa neilote} is the fatherless) (a:neisate) (b:neilo) (q:draft)
neinu = (i:1) (t:n) (w:woman who has) (d:<nei> have with the female suffix <nu>; {nin a neinu} is a woman who has uncleanness, a woman in her monthly period) (b:nei) (q:draft)
neipa = (i:1) (t:n) (w:owner/possessor) (d:the man who has or owns something; {ta a neipa} is the father of a child) (s:teekpa) (b:nei) (q:draft)
neipah = (i:1) (t:v) (w:have at once/hold immediately) (d:<nei> have or hold with <pah> at once, said here of holding a meeting) (q:draft)
neisa = (i:1) (t:adj) (w:having/possessing) (d:<nei> have with <sa> already; {pasal neisa numei} is a woman who has a husband, {zi neisa} a man who has a wife) (b:nei) (q:draft)
neisak = (i:1) (t:v) (w:given/give/grant) (d:<nei>, have, with the causative <sak>: cause someone to have, give; {ta neisak} is give a child) (b:nei) as in God has given
neisak = (i:2) (t:v) (w:have/let have/cause to have) (d:<nei>, have, with the causative <sak>: let or make someone have a thing, as power, hope or a desire) (b:nei) as in let them have
neisate = (i:1) (t:n) (w:those who have/the ones who have) (d:<nei> have with <sa> already and plural <te>; said of spouses it means the married) (a:neilote) (b:neisa) (q:draft)
neisun = (i:1) (t:v) (w:have/happen to have) (d:<nei>, have, with <sun>; in the verse, should one have any at all) (q:draft, low confidence)
neita = (i:1) (t:v) (w:got/be given/now have) (d:<nei>, have, with <ta>, which marks a new state: now have, have come to have) (b:nei) taken or given by someone
neita = (i:2) (t:v) (w:earn) (b:nei)
neitawm = (i:1) (t:v) (w:have of one's own accord) (d:<nei> have with <tawm> by oneself, have without being told) (q:draft)
neite = (i:1) (t:det) (w:those have got/those who have) (d:<nei>, have, with the plural <te>: those who have something; {mawh neite} is sinners) (b:nei)
neithakte = (i:1) (t:n) (w:newlyweds) (d:those who have newly taken, from <nei> have, <thak> new and plural <te>; {pasal neithakte} are brides, women who have newly taken a husband) (q:draft)
neithuah = (i:1) (t:v) (w:have in addition/have besides/have more) (d:<nei>, have, with <thuah>, in addition) (q:draft)
neizaw = (i:1) (t:v) (w:have more/have greater) (d:<nei> have with <zaw> more, used with <sangin> than) (b:nei) (q:draft)
neizo = (i:1) (t:v) (w:be able to have/manage to have/have obtained) (d:<nei> have with <zo>, which marks ability or completion; {thu neizo lo} is have no force) (b:nei) (q:draft)
nek = (i:1) (t:v) (w:to eat/eat) (d:form of <ne>, eat, used before <ding>, <theih> and <nading>) (b:ne)
nek = (i:2) (t:v) (w:ate/eaten) (d:form of <ne>, eat, used in relative and time clauses, as with {lai takin}, while, and {khit ciangin}, after) (b:ne)
nekbaang = (i:1) (t:n) (w:leavings/remains of a kill) (d:what is left from the eating of another, here an animal torn and partly eaten by wild beasts) (q:draft, low confidence)
nekha = (i:1) (t:v) (w:eat/get to eat) (d:<ne> eat with <kha>, which marks that the act reaches its object, eat any of something; {na nekha kei ding} is you will not get to eat it) (q:draft)
nekhawm = (i:1) (t:v) (w:eat together/eat with/dine with) (d:<ne> eat with <khawm> together) (s:nekpih) (b:ne) (r:20.23.1) (q:draft)
nekhawmin = (i:1) (t:v) (w:eating together) (d:<nekhawm>, eat together, with <in>, linking to the next verb; {an nekhawm} renders breaking bread) (b:nekhawm) (q:draft)
nekhawmte = (i:1) (t:n) (w:those eating together/dinner guests) (d:<nekhawm> eat together with plural <te>) (b:nekhawm) (q:draft)
nekik = (i:1) (t:v) (w:eat again/return to eat) (d:<ne> eat with <kik> again or back) (b:ne) (q:draft)
nekin = (i:1) (t:v) (w:eating/as food) (d:<nek>, form of <ne>, eat, with <in>: {note’ nekin} is as food for you, {uang nekin} is eating to excess) (b:nek) (q:draft, low confidence)
nekkhak = (i:1) (t:v) (w:eat by mistake/eat unintentionally/swallow by accident) (d:<nek>, form of <ne>, eat, with <khak>, happen to) (r:20.23.7) (q:draft)
nekkhawm = (i:1) (t:v) (w:eat together) (d:<nek> eat with <khawm> together) (s:nekpih) (b:nek) (q:draft)
nekkhawm = (i:2) (t:n) (w:shared meal/common meal) (d:a meal eaten together, used of the Lord's Supper) (s:nekkhawmna) (q:draft)
nekkhawmna = (i:1) (t:n) (w:shared meal/supper/communion) (d:eating together; {Topa’ Nekkhawmna} is the Lord's Supper) (b:nekkhawm) (q:draft)
Nekkhawmna = (i:1) (t:n) (w:Supper/shared meal) (d:eating together; {Topa’ Nekkhawmna} is the Lord's Supper) (b:nekkhawmna) (q:draft)
nekkhit = (i:1) (t:v) (w:finish eating/have eaten) (d:<nek> eat with <khit> finish; with <ciangin>, after eating) (r:42.22.20) (q:draft)
nekkhop = (i:1) (t:v) (w:eat together/eat with) (d:form of <nekhawm> used before <ding> and <ut>) (s:nekpih) (q:draft)
nekkhopna = (i:1) (t:n) (w:eating together) (d:<nekkhop> eat together with the noun suffix <na>) (b:nekkhop) (q:draft)
neklam = (i:1) (t:n) (w:eating/the fact of eating) (d:<nek> eat with <lam>, the fact or manner: that someone eats, as the object of a verb of seeing) (q:draft)
nekledawn = (i:1) (t:n) (w:eating and drinking/food and drink) (d:<nek> eat, <le> and, <dawn> drink, written as one word: eating and drinking, what a person eats and drinks) (q:draft)
nekloh = (i:1) (t:v) (w:not eat) (d:<nek>, the form of <ne> eat, with <loh>, the form of <lo> not: not eating; {nekloh nading} is so as not to eat, and {nekloh hangin} is even if one does not eat) (q:draft)
nekna = (i:1) (t:n) (w:eating/meal/feast) (d:<nek> eat with the noun suffix <na>: the act of eating, or a meal; {an nekna} is a meal and {sa nekna} the eating of meat) (s:annekna) (b:nek) (r:45.14.21) (q:draft)
neknekna = (t:see) <neknekna-in>
neknekna-in = (i:1) (t:n) (d:<nek>, eat or drink, doubled for a repeated action, with the noun suffix <na> and <in>: from continually drinking or eating) (q:draft, low confidence)
Neko = (i:1) (t:name) (c:male) (w:Necho) (d:Pharaoh Necho, king of Egypt, who killed King Josiah at Megiddo and made Jehoiakim king of Judah) (r:12.23.29/14.35.20)
Nekoda = (i:1) (t:name) (c:male) (w:Nekoda) (d:ancestor of a family of temple servants who returned from the exile, and of a family that could not prove its descent from Israel) (r:15.2.48/16.7.62)
nekpah = (i:1) (t:v) (w:eat at once/eat immediately) (d:<nek> eat with <pah> at once: eat something as soon as it is seen or picked) (q:draft)
nekpih = (i:1) (t:v) (w:eat with/share a meal with/eat together with) (d:<nek> eat with <pih>, together with someone: share a meal with a person; {an nekpih dingin sam} is invite someone to eat) (s:nekhawm/nekkhop) (b:nek) (q:draft)
nekpihin = (i:1) (t:v) (w:eating with) (d:<nekpih> eat with, with the linking ending <in>, eating with someone and then doing the next action) (b:nekpih) (q:draft)
neksa = (i:1) (t:v) (w:eaten/have eaten) (d:<nek>, form of <ne>, eat, with <sa>, already done: what has been eaten; {na neksa teng} is all that you have eaten) (b:nek) (q:draft)
neksak = (i:1) (t:v) (w:eat up/devour/consume) (d:<nek> eat with <sak>, here marking that another person is affected: eat or drink what belongs to someone else, to that person’s loss) (b:nek) (q:draft)
neksak = (i:2) (t:v) (w:let eat/let drink/serve) (d:<nek> eat or drink with the causative <sak>: allow or cause someone to eat or drink, serve food or drink to someone) (s:nesak) (b:nek) (q:draft, low confidence)
neksakna = (i:1) (t:n) (w:serving/letting eat or drink) (d:<neksak> let eat or drink with the noun suffix <na>) (b:neksak) (q:draft)
neksakte = (i:1) (t:n) (w:things eaten) (d:what has been eaten up, with plural <te>; the later text writes <neksate>) (s:neksate) (b:neksak) (q:draft, low confidence)
neksate = (i:1) (t:n) (w:things eaten) (d:<neksa> already eaten with plural <te>, what has been eaten) (s:neksakte) (b:neksa) (q:draft)
neksim = (i:1) (t:v) (w:eat in secret) (d:<nek> eat with <sim> secretly: eat something in secret, without others knowing) (s:nesim) (q:draft)
nektawm = (i:1) (t:n) (w:food/something to eat) (d:food to live on, what there is to eat; {nektawm ding nei lo} is having nothing to eat) (s:annektawm) (r:20.12.9) (q:draft)
nektawmzon = (i:1) (t:n) (w:earning one's own living) (d:seeking one's own food, from <nek> eat, <tawm> by oneself and <zon> seek; working for a living) (q:draft, low confidence)
nekte = (i:1) (t:n) (w:things eaten/food/what one eats) (d:<nek> eat with the plural <te>: the things that someone eats, food) (b:nek) (q:draft)
nektheih = (i:1) (t:adj) (w:edible/fit to eat/eatable) (d:that can be eaten, placed before the thing named; {nektheih ding} is something fit to eat) (b:nek) (q:draft)
nektheih = (i:2) (t:v) (w:can eat/may eat) (d:<nek> eat with <theih> can: be able or allowed to eat; {nektheih nading} is so that one may eat) (s:nethei) (b:nek) (q:draft)
nektum = (i:1) (t:v) (w:eat up/consume/devour) (d:<nek>, form of <ne>, eat, with <tum>, wholly: eat until nothing is left, said of moths, locusts and disease) (s:netum/nemang) (q:draft)
nektumsak = (i:1) (t:v) (w:eat up/devour/consume) (d:<nektum>, eat up, with <sak>: eat up what belongs to another, or cause to be eaten up) (b:nektum) (q:draft)
nekzah = (i:1) (t:n) (w:portion/food allowance/ration) (d:<nek> eat, with <zah> amount: the amount that one eats, a share of food) (q:draft)
nekzawh = (i:1) (t:v) (w:be able to eat/can eat) (d:<nek> eat, with <zawh>, the form of <zo> be able: be able to eat; {a nekzawh zahzah} is as much as one can eat, to the full) (s:nezo) (q:draft)
nel = (i:1) (t:adj) (w:fine/powdery/smooth) (d:ground or rubbed fine, as dust or flour; of skin or a surface, smooth; also written <neel>) (s:neel) (r:23.41.7) (q:draft)
nel = (i:2) (t:n) (w:flour/fine flour) (d:finely ground grain, as in {mangbuh nel} wheat flour and {an nel}) (s:annel/buhnel) (q:draft, low confidence)
nelh = (i:1) (t:adv) (w:over/upon/in) (d:follows a verb to show that the action covers, shuts in or falls upon someone or something, as {khup nelh} close over, {khak nelh} shut in and {hal nelh} burn down over) (q:draft, low confidence)
nelhin = (i:1) (t:adv) (w:over/upon) (d:<nelh> with the linking suffix <in>, after a verb to show that the action falls upon or shuts in someone; {kihal nelhin}, burning the house over himself) (b:nelh) (q:draft, low confidence)
nelhsak = (i:1) (t:v) (w:close over/shut in upon) (d:<nelh> over or upon with causative <sak>, after <khak> shut, make something close over someone) (b:nelh) (q:draft, low confidence)
nelzaw = (i:1) (t:adj) (w:smoother/softer) (d:<nel>, smooth, with <zaw>, more) (s:nipzaw) (b:nel) (q:draft)
nem = (i:1) (t:adj) (w:soft/gentle/weak/tender) (d:not hard or strong: of a voice or words, gentle; of a person, gentle and mild; of strength or eyes, weak; also written <neem>) (s:neem) (a:khauh/hat) (q:draft)
nemang = (i:1) (t:v) (w:devour/eat up/consume) (d:<ne> eat with <mang> gone, eat until nothing is left) (s:netum/nektum) (q:draft)
nemin = (i:1) (t:adj) (w:gentle/gently/soft/mild) (d:<nem> soft with the linking ending <in>, used when another word follows; {lungsim nemin} is being gentle and {kam nemin} with gentle words) (b:nem) (r:56.3.2) (q:draft)
nemna = (i:1) (t:n) (w:gentleness/softness) (d:<nem> soft with the noun suffix <na>; {lungsim nemna} is gentleness of heart) (s:lungnemna) (b:nem) (q:draft)
Nemuel = (i:1) (t:name) (c:male) (w:Nemuel) (d:name of two men: a son of Simeon, ancestor of the Nemuelite clan, and a Reubenite, son of Eliab and brother of Dathan and Abiram) (r:13.4.24/4.26.12)
nen = (i:1) (t:adv) (w:into pieces/small/fine) (d:into small pieces, after a verb of cutting, striking or breaking, as {sem nen}, {at nen} and {sat nen}) (s:nenin) (q:draft)
nen = (i:2) (t:v) (w:press down/crush) (d:first part of {nen’niam} oppress and {nen’niamna} oppression) (r:19.72.14) (q:draft, low confidence)
nencip = (i:1) (t:v) (w:weigh down/press down/overwhelm) (d:<nen> press down, with <cip> tightly: bear down heavily on someone, said of sin and wickedness) (s:nengcip) (b:nen) (q:draft)
nene = (i:1) (t:v) (w:keep eating/eat again and again/devour) (d:<ne>, eat or drink, said twice for repeated or continued action: eat or drink again and again, eat as a habit, or go on devouring) (r:27.7.7) (q:draft)
nenete = (i:1) (t:n) (w:drinkers/drunkards) (d:<nene> keep eating or drinking, with the plural <te>: those who drink habitually; {zu nenete} is drunkards) (s:zukhamte) (b:nene) (q:draft)
neng = (i:1) (t:n) (w:crumb/fragment/scrap/bit) (d:small broken pieces of food; {a neng a themte} is the scraps and leftovers) (s:anneng/them) (q:draft)
nengbaang = (i:1) (t:n) (w:speck/fine particle) (d:a tiny bit of something clinging to a surface, here dust on the scales) (q:draft, low confidence)
nengcip = (i:1) (t:v) (w:crush/press hard/squeeze) (d:<neng> press with <cip> tightly: press or crush something hard against a surface, or bear down heavily on someone) (s:nencip/netcip) (q:draft)
nengcipsuk = (i:1) (t:v) (w:crush down/press down) (d:<nengcip> press tightly with <suk> downward) (s:netcipsuk) (b:nengcip) (q:draft)
nengkia = (i:1) (t:n) (w:fallen crumbs/scraps) (d:<neng> crumb with <kia> fall, bits of food that have fallen from the table) (s:anneng) (q:draft)
nengneng = (i:1) (t:n) (w:equipment/small parts/accessories) (d:the small items that belong to something larger) (q:draft, low confidence)
nengnengte = (i:1) (t:n) (w:small parts/accessories) (d:<nengneng> with the plural <te>: the small items that belong to something larger) (b:nengneng) (q:draft, low confidence)
nengniam = (i:1) (t:v) (w:oppress/crush/treat cruelly) (d:press someone down by power or force, treat people cruelly and unjustly; said of enemies, rulers and the rich; also written <nenniam> and <netniam>) (s:nenniam/netniam/bawlsia) (q:draft)
nengniamin = (i:1) (t:v) (w:oppressing) (d:<nengniam>, oppress, with the linking suffix <in>: oppressing someone, followed by a further action) (s:nenniamin) (b:nengniam) (q:draft)
nengniampa = (i:1) (t:n) (w:oppressor) (d:<nengniam>, oppress, with <pa> marking a man: the one who oppresses) (s:bawlsiapa) (b:nengniam) (q:draft)
nengniamsak = (i:1) (t:v) (w:let oppress/allow to oppress) (d:<nengniam>, oppress, with the causative <sak>; let one person oppress another, mostly negated) (b:nengniam) (q:draft)
nengniamte = (i:1) (t:n) (w:oppressors) (d:<nengniam>, oppress, with the plural <te>: those who oppress others) (s:bawlsiate) (b:nengniam) (q:draft)
nengniamzo = (i:1) (t:v) (w:be able to oppress) (d:<nengniam> oppress with <zo> be able) (b:nengniam) (q:draft)
nenin = (i:1) (t:adv) (w:into pieces/in small pieces) (d:follows a verb of cutting or breaking: {sem nenin} cut into pieces, {bal nenin} crumble) (s:nen) (b:nen) (q:draft)
nenniam = (i:1) (t:v) (w:oppress/subdue/humble) (d:press down, bring low: oppress a people, or subdue enemies under someone; also written <nengniam> and <netniam>) (s:nengniam/netniam) (q:draft)
